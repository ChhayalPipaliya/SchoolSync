{
    "name": "schoolsync",
    "version": "1.0.0",
    "description": "Multi-role school management platform built with Express, EJS, and MySQL.",
    "license": "ISC",
    "author": "",
    "type": "commonjs",
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "start:dev": "nodemon app.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test src/tests/businessRules.test.js src/tests/securityRules.test.js src/tests/operationsSafety.test.js src/tests/razorpayMock.test.js src/tests/razorpayPaymentVerification.test.js",
    "test:integration": "node --test src/tests/smoke.test.js",
    "test:socket": "node scripts/runSocketIntegration.js",
    "test:authorization": "node --test src/tests/securityRules.test.js",
    "test:payments": "node --test src/tests/razorpayMock.test.js",
    "test:payments:mysql": "node --test --test-concurrency=1 src/tests/paymentIntegrity.mysql.test.js",
    "test:csrf": "node scripts/auditCsrfRoutes.js && node --test src/tests/securityRules.test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:authorization && npm run test:payments && npm run test:csrf && npm run test:socket",
    "audit:csrf": "node scripts/auditCsrfRoutes.js",
        "test:watch": "node --test --watch src/tests/*.test.js",
        "test:coverage": "node --test --experimental-test-coverage src/tests/*.test.js",
        "seed": "node seed.js",
        "migrate": "node src/config/runMigration.js",
        "routes:matrix": "node scripts/buildRouteMatrix.js",
        "fix:academic-core": "node src/config/runMigration.js",
        "zip:clean": "node zipClean.js"
    },
    "dependencies": {
        "@socket.io/redis-adapter": "^8.3.0",
        "bcryptjs": "^2.4.3",
        "connect-flash": "^0.1.1",
        "connect-redis": "^7.1.1",
        "cookie-parser": "^1.4.7",
        "csv-parser": "^3.2.1",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.10",
        "exceljs": "^4.4.0",
        "express": "^4.21.2",
        "express-ejs-layouts": "^2.5.1",
        "express-session": "^1.19.0",
        "express-validator": "^7.3.2",
        "fast-csv": "^5.0.7",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.11.0",
        "node-cron": "^3.0.0",
        "nodemailer": "^9.0.3",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "pdfkit": "^0.18.0",
        "qrcode": "^1.5.0",
        "razorpay": "^2.9.6",
        "redis": "^4.7.0",
        "sharp": "^0.35.2",
        "socket.io": "^4.7.0",
        "twilio": "^6.0.2",
        "uuid": "^14.0.1",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
    },
    "devDependencies": {
        "nodemon": "^3.1.14",
        "socket.io-client": "^4.8.3"
    },
    "overrides": {
        "uuid": "$uuid"
    }
}
