<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', {
    title: typeof title !== 'undefined' ? title + ' | SchoolSync' : 'School Admin | SchoolSync',
    needsCharts: typeof needsCharts !== 'undefined' ? needsCharts : false
  }) %>
</head>
<body class="schooladmin-theme">
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header') %>
    <% if (typeof impersonation !== 'undefined' && impersonation && impersonation.superAdminUser) { %>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin:16px 24px 0;padding:12px 16px;border:1px solid #bfdbfe;background:#eff6ff;color:#1e3a8a;border-radius:10px;font-size:13px;font-weight:700;">
        <span>You are impersonating this school as Super Admin.</span>
        <form action="/superadmin/impersonation/stop" method="POST" style="margin:0;">
          <button type="submit" class="btn btn-sm btn-primary" style="font-size:12px;font-weight:800;">Stop Impersonation</button>
        </form>
      </div>
    <% } %>
    <%- include('../partials/flashMessages') %>
    <div class="page-body">
      <%- body %>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>
</body>
</html>