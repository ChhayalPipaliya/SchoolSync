<%- include('../../partials/head', { title: `${lan.Edit_Student_Profile || 'Edit Student Profile'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex md:flex-row items-center justify-between gap-4 mb-6">
                <div class="flex-1 min-w-0">
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Edit_Student_Profile || 'Edit Student Profile' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Modify_Details_For || 'Modify details for' %> <%= student.first_name %> <%= student.last_name %></p>
                </div>
                <div>
                    <a href="/schooladmin/students/<%= student.id %>/view" class="btn btn-secondary text-xs inline-flex items-center justify-center gap-1.5 whitespace-nowrap">
                        <i class="fas fa-arrow-left"></i> <%- lan.Back_To_Profile || 'Back to Profile' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <form action="/schooladmin/students/<%= student.id %>/edit" method="POST" enctype="multipart/form-data" class="space-y-6">
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-user me-2"></i><%- lan.Basic_Information || 'Basic Information' %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.First_Name || 'First Name' %> *</label>
                            <input type="text" name="first_name" required value="<%= student.first_name %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Last_Name || 'Last Name' %> *</label>
                            <input type="text" name="last_name" required value="<%= student.last_name || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Email || 'Email' %> *</label>
                            <input type="email" name="email" required value="<%= student.email || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Phone || 'Phone' %></label>
                            <input type="tel" name="phone" value="<%= student.phone || '' %>" class="form-input">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Password || 'Password' %></label>
                            <input type="password" name="password" placeholder="<%- lan.Leave_Blank_Keep_Current || 'Leave blank to keep current' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Admission_No || 'Admission No' %> *</label>
                            <input type="text" name="admission_no" required value="<%= student.admission_no %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Roll_No || 'Roll No' %></label>
                            <input type="text" name="roll_no" value="<%= student.roll_no || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Admission_Date || 'Admission Date' %> *</label>
                            <input type="date" name="admission_date" required value="<%= student.admission_date ? new Date(student.admission_date).toISOString().split('T')[0] : '' %>" class="form-input">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Class || 'Class' %> <span id="classRequiredMark">*</span></label>
                            <select id="studentClassSelect" name="base_class_id" class="form-select">
                                <option value=""><%- lan.Select_Class || 'Select Class' %></option>
                                <% classes.forEach(cls => { %>
                                    <option value="<%= cls.id %>" <%= currentBaseClassId == cls.id ? 'selected' : '' %>><%= cls.display_name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Section || 'Section' %> <span id="sectionRequiredMark">*</span></label>
                            <select id="studentSectionSelect" name="class_id" class="form-select" <%= activeSections.length ? '' : 'disabled' %>>
                                <option value=""><%- lan.Select_Section || 'Select Section' %></option>
                                <% activeSections.forEach(sec => { %>
                                    <option value="<%= sec.id %>" <%= student.class_id == sec.id ? 'selected' : '' %>><%- lan.Section || 'Section' %> <%= sec.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Date_Of_Birth || 'Date of Birth' %> *</label>
                            <input type="date" name="dob" required value="<%= student.dob ? new Date(student.dob).toISOString().split('T')[0] : '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Gender || 'Gender' %></label>
                            <select name="gender" class="form-select">
                                <option value=""><%- lan.Select_Gender || 'Select' %></option>
                                <option value="male" <%= student.gender === 'male' ? 'selected' : '' %>><%- lan.Male || 'Male' %></option>
                                <option value="female" <%= student.gender === 'female' ? 'selected' : '' %>><%- lan.Female || 'Female' %></option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Blood_Group || 'Blood Group' %></label>
                            <select name="blood_group" class="form-select">
                                <option value=""><%- lan.Select_Blood_Group || 'Select' %></option>
                                <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(bg => { %>
                                    <option value="<%= bg %>" <%= student.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Aadhaar_No || 'Aadhaar No' %></label>
                            <input type="text" name="aadhaar_no" maxlength="12" value="<%= student.aadhaar_no || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Religion || 'Religion' %></label>
                            <input type="text" name="religion" value="<%= student.religion || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Category || 'Category' %></label>
                            <select name="category" class="form-select">
                                <option value=""><%- lan.Select_Category || 'Select' %></option>
                                <% ['General','OBC','SC','ST'].forEach(cat => { %>
                                    <option value="<%= cat %>" <%= student.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Status || 'Status' %></label>
                            <select name="status" class="form-select">
                                <option value="active" <%= student.status === 'active' ? 'selected' : '' %>><%- lan.Active || 'Active' %></option>
                                <option value="unassigned" <%= student.status === 'unassigned' ? 'selected' : '' %>><%- lan.Unassigned || 'Unassigned' %></option>
                                <option value="inactive" <%= student.status === 'inactive' ? 'selected' : '' %>><%- lan.Inactive || 'Inactive' %></option>
                                <option value="left" <%= student.status === 'left' ? 'selected' : '' %>><%- lan.Left || 'Left' %></option>
                                <option value="graduated" <%= student.status === 'graduated' ? 'selected' : '' %>><%- lan.Graduated || 'Graduated' %></option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group mb-0 mt-4">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Medical_Notes || 'Medical Notes' %></label>
                        <textarea name="medical_notes" rows="2" class="form-textarea"><%= student.medical_notes || '' %></textarea>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-people-roof me-2"></i><%- lan.Family_Details || 'Family Details' %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Fathers_Name || "Father's Name" %></label>
                            <input type="text" name="father_name" value="<%= student.father_name || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Fathers_Phone || "Father's Phone" %></label>
                            <input type="tel" name="father_phone" value="<%= student.father_phone || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Fathers_Email || "Father's Email" %></label>
                            <input type="email" name="father_email" value="<%= student.father_email || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Fathers_Occupation || "Father's Occupation" %></label>
                            <input type="text" name="father_occupation" value="<%= student.father_occupation || '' %>" class="form-input">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mothers_Name || "Mother's Name" %></label>
                            <input type="text" name="mother_name" value="<%= student.mother_name || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mothers_Phone || "Mother's Phone" %></label>
                            <input type="tel" name="mother_phone" value="<%= student.mother_phone || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mothers_Email || "Mother's Email" %></label>
                            <input type="email" name="mother_email" value="<%= student.mother_email || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mothers_Occupation || "Mother's Occupation" %></label>
                            <input type="text" name="mother_occupation" value="<%= student.mother_occupation || '' %>" class="form-input">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Guardian_Name || 'Guardian Name' %></label>
                            <input type="text" name="guardian_name" value="<%= student.guardian_name || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Relation || 'Relation' %></label>
                            <input type="text" name="guardian_relation" value="<%= student.guardian_relation || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Guardian_Phone || 'Guardian Phone' %></label>
                            <input type="tel" name="guardian_phone" value="<%= student.guardian_phone || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Guardian_Occupation || 'Guardian Occupation' %></label>
                            <input type="text" name="guardian_occupation" value="<%= student.guardian_occupation || '' %>" class="form-input">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-map-location-dot me-2"></i><%- lan.Address_Details || 'Address & Transport' %>
                    </h3>
                    <div class="grid grid-cols-1 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Permanent_Address || 'Permanent Address' %></label>
                            <textarea name="permanent_address" rows="2" class="form-textarea"><%= student.permanent_address || '' %></textarea>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.City || 'City' %></label>
                            <input type="text" name="permanent_city" value="<%= student.permanent_city || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.State || 'State' %></label>
                            <input type="text" name="permanent_state" value="<%= student.permanent_state || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Pincode || 'Pincode' %></label>
                            <input type="text" name="permanent_pincode" value="<%= student.permanent_pincode || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Country || 'Country' %></label>
                            <input type="text" name="permanent_country" value="India" readonly class="form-input bg-slate-50 text-gray-500">
                        </div>
                    </div>
                    <div class="mt-4 flex items-center">
                        <label class="inline-flex items-center text-sm text-gray-700 cursor-pointer">
                            <input type="checkbox" name="current_address_same" value="1" <%= student.current_address_same == 1 ? 'checked' : '' %> class="rounded border-gray-300 mr-2 w-4 h-4" style="color: var(--primary);"> <%- lan.Same_As_Permanent_Address || 'Current address same as permanent' %>
                        </label>
                    </div>
                    <div class="grid grid-cols-1 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Emergency_Contact || 'Emergency Contact No' %></label>
                            <input type="tel" name="emergency_contact" value="<%= student.emergency_contact || '' %>" class="form-input">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4 pt-4 border-t border-slate-100">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Transport_Required || 'Transport Required' %></label>
                            <select name="transport_required" class="form-select">
                                <option value="0" <%= student.transport_required == 0 ? 'selected' : '' %>><%- lan.No || 'No' %></option>
                                <option value="1" <%= student.transport_required == 1 ? 'selected' : '' %>><%- lan.Yes || 'Yes' %></option>
                            </select>
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Transport_Mode || 'Transport Mode' %></label>
                            <select name="transport_mode" class="form-select">
                                <option value=""><%- lan.Select_Mode || 'Select' %></option>
                                <option value="School Bus" <%= student.transport_mode === 'School Bus' ? 'selected' : '' %>><%- lan.School_Bus || 'School Bus' %></option>
                                <option value="Private" <%= student.transport_mode === 'Private' ? 'selected' : '' %>><%- lan.Private || 'Private' %></option>
                                <option value="Self" <%= student.transport_mode === 'Self' ? 'selected' : '' %>><%- lan.Self || 'Self' %></option>
                                <option value="Other" <%= student.transport_mode === 'Other' ? 'selected' : '' %>><%- lan.Other || 'Other' %></option>
                            </select>
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Route || 'Route' %></label>
                            <input type="text" name="transport_route" value="<%= student.transport_route || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Vehicle_No || 'Vehicle No' %></label>
                            <input type="text" name="transport_vehicle_no" value="<%= student.transport_vehicle_no || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Pickup_Latitude || 'Pickup Latitude' %></label>
                            <input type="text" name="pickup_latitude" value="<%= student.pickup_latitude || '' %>" class="form-input" placeholder="23.0225">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Pickup_Longitude || 'Pickup Longitude' %></label>
                            <input type="text" name="pickup_longitude" value="<%= student.pickup_longitude || '' %>" class="form-input" placeholder="72.5714">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-file-pdf me-2"></i><%- lan.Documents_Upload || 'Documents & Photos' %>
                    </h3>
                    <% if(student.documents && student.documents.length > 0) { %>
                        <div class="mb-6 bg-slate-50 rounded-xl p-4 border border-slate-100">
                            <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3"><%- lan.Current_Uploaded_Documents || 'Current Uploaded Documents' %></h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <% student.documents.forEach(doc => { %>
                                    <div class="flex items-center justify-between bg-white rounded-lg p-3 border border-slate-100 shadow-sm">
                                        <div class="min-w-0">
                                            <div class="text-xs font-bold text-gray-800 truncate"><%= doc.document_name %></div>
                                            <div class="text-[10px] font-semibold uppercase mt-0.5" style="color: var(--primary);"><%= doc.document_type?.replace('_',' ') %></div>
                                        </div>
                                        <div class="flex items-center gap-1.5 ml-2">
                                            <a href="<%= doc.file_url %>" target="_blank" class="w-7 h-7 border rounded-lg flex items-center justify-center text-xs transition" style="background: var(--primary-light); border-color: rgba(5,150,105,0.15); color: var(--primary);">
                                                <i class="fa-solid fa-download"></i>
                                            </a>
                                            <button type="button" onclick="confirmDeleteDoc('<%= doc.id %>')" class="w-7 h-7 bg-rose-50 hover:bg-rose-100 border border-rose-100/50 rounded-lg flex items-center justify-center text-rose-600 text-xs transition">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Student_Photo || 'Student Photo' %></label>
                            <input type="file" name="student_image" accept="image/*" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Father_Photo || 'Father Photo' %></label>
                            <input type="file" name="father_image" accept="image/*" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mother_Photo || 'Mother Photo' %></label>
                            <input type="file" name="mother_image" accept="image/*" class="form-input">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Birth_Certificate || 'Birth Certificate' %></label>
                            <input type="file" name="birth_certificate" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Aadhaar_Card || 'Aadhaar Card' %></label>
                            <input type="file" name="aadhaar_card" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Leaving_Certificate || 'Leaving Certificate' %></label>
                            <input type="file" name="leaving_certificate" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Previous_Marksheet || 'Previous Marksheet' %></label>
                            <input type="file" name="previous_marksheet" class="form-input">
                        </div>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-3 pt-4">
                    <button type="submit" class="btn btn-primary px-8 py-3 w-full sm:w-auto justify-center">
                        <i class="fa-solid fa-floppy-disk me-1"></i> <%- lan.Save_Changes || 'Save Changes' %>
                    </button>
                    <a href="/schooladmin/students/<%= student.id %>/view" class="btn btn-secondary px-8 py-3 w-full sm:w-auto justify-center text-center">
                        <%- lan.Cancel || 'Cancel' %>
                    </a>
                </div>
            </form>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<form id="deleteDocForm" action="" method="POST" style="display:none;"></form>
<div id="i18n-edit-data" style="display:none;" 
     data-delete-confirm="<%- lan.Delete_Document_Confirm || 'Are you sure you want to delete this document? This cannot be undone.' %>"
     data-select-section="<%- lan.Select_Section || 'Select Section' %>"
     data-section="<%- lan.Section || 'Section' %>"
     data-loading="<%- lan.Loading || 'Loading...' %>"
     data-failed-load="<%- lan.Failed_Load_Sections || 'Failed to load sections' %>"
     data-error-load="<%- lan.Error_Loading_Sections || 'Error loading sections' %>"></div>
<script>
    const i18nEl = document.getElementById('i18n-edit-data');
    const i18n = i18nEl ? i18nEl.dataset : {};
    const msgDeleteConfirm = i18n.deleteConfirm || 'Are you sure you want to delete this document? This cannot be undone.';
    const strSelectSection = i18n.selectSection || 'Select Section';
    const strSection = i18n.section || 'Section';
    const strLoading = i18n.loading || 'Loading...';
    const strFailedLoadSections = i18n.failedLoad || 'Failed to load sections';
    const strErrorLoadingSections = i18n.errorLoad || 'Error loading sections';

    function confirmDeleteDoc(docId) {
        if (confirm(msgDeleteConfirm)) {
            const form = document.getElementById('deleteDocForm');
            form.action = `/schooladmin/students/delete-document/${docId}`;
            form.submit();
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const statusSelect = document.querySelector('select[name="status"]');
        const classSelect = document.getElementById('studentClassSelect');
        const sectionSelect = document.getElementById('studentSectionSelect');
        const classRequiredMark = document.getElementById('classRequiredMark');
        const sectionRequiredMark = document.getElementById('sectionRequiredMark');

        function syncAssignmentRequirement() {
            const requiresAssignment = statusSelect.value === 'active';
            classSelect.required = requiresAssignment;
            sectionSelect.required = requiresAssignment;
            classRequiredMark.style.display = requiresAssignment ? '' : 'none';
            sectionRequiredMark.style.display = requiresAssignment ? '' : 'none';
            if (!requiresAssignment) {
                classSelect.value = '';
                sectionSelect.innerHTML = '<option value="">' + strSelectSection + '</option>';
                sectionSelect.disabled = true;
            }
        }

        classSelect.addEventListener('change', () => {
            const classId = classSelect.value;
            if (!classId) {
                sectionSelect.innerHTML = '<option value="">' + strSelectSection + '</option>';
                sectionSelect.disabled = true;
                return;
            }

            sectionSelect.disabled = true;
            sectionSelect.innerHTML = '<option value="">' + strLoading + '</option>';
            fetch(`/schooladmin/sections/by-class/${classId}`)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        let html = '<option value="">' + strSelectSection + '</option>';
                        data.sections.forEach(sec => {
                            html += '<option value="' + sec.id + '">' + strSection + ' ' + sec.name + '</option>';
                        });
                        sectionSelect.innerHTML = html;
                        sectionSelect.disabled = false;
                    } else {
                        sectionSelect.innerHTML = '<option value="">' + strFailedLoadSections + '</option>';
                    }
                })
                .catch(err => {
                    console.error(err);
                    sectionSelect.innerHTML = '<option value="">' + strErrorLoadingSections + '</option>';
                });
        });

        statusSelect.addEventListener('change', syncAssignmentRequirement);
        syncAssignmentRequirement();

        const transportRequired = document.querySelector('[name="transport_required"]');
        const transportDetails = document.querySelectorAll('.transport-detail');
        function syncTransport() {
            if (!transportRequired) return;
            const enabled = String(transportRequired.value) === '1';
            transportDetails.forEach(group => {
                group.style.display = enabled ? '' : 'none';
                group.querySelectorAll('input, select').forEach(field => field.disabled = !enabled);
            });
        }
        if (transportRequired) {
            transportRequired.addEventListener('change', syncTransport);
            syncTransport();
        }
    });
</script>