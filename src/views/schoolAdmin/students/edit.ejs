<style>
    .student-form-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 12px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .student-form-section-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #059669;
        margin-bottom: 12px;
        padding-bottom: 6px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-group-compact {
        margin-bottom: 0;
    }

    .form-label-compact {
        font-size: 9px;
        font-weight: 700;
        color: #94A3B8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 4px;
    }

    .form-input-compact {
        width: 100%;
        height: 34px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 0 10px;
        font-size: 11px;
        background: #FFFFFF;
        color: #1E293B;
        outline: none;
        transition: border-color 0.15s;
    }

    .form-input-compact:focus {
        border-color: #059669;
    }

    .form-textarea-compact {
        width: 100%;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 11px;
        background: #FFFFFF;
        color: #1E293B;
        outline: none;
        resize: vertical;
        transition: border-color 0.15s;
    }

    .form-textarea-compact:focus {
        border-color: #059669;
    }

    [data-theme="dark"] .student-form-card,
    .light-mode-disabled .student-form-card {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .student-form-section-title,
    .light-mode-disabled .student-form-section-title {
        border-bottom-color: #242F4D !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .form-input-compact,
    [data-theme="dark"] .form-textarea-compact,
    .light-mode-disabled .form-input-compact,
    .light-mode-disabled .form-textarea-compact {
        background-color: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
</style>
<%- include('../../partials/head', { title: `${lan.Edit_Student_Profile || 'Edit Student Profile'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-user-pen"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Edit_Student_Profile || 'Edit Student Profile' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Modify_Details_For || 'Modify details for' %> <strong><%= student.first_name %> <%= student.last_name %></strong></p>
                        </div>
                    </div>
                    <a href="/schooladmin/students/<%= student.id %>/view" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                        <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Profile || 'Back to Profile' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <form action="/schooladmin/students/<%= student.id %>/edit" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="student-form-card">
                    <h3 class="student-form-section-title">
                        <i class="fa-solid fa-user"></i> <%- lan.Basic_Information || 'Basic Information' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.First_Name || 'First Name' %> <span style="color: #E11D48;">*</span></label>
                            <input type="text" name="first_name" required value="<%= student.first_name %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Last_Name || 'Last Name' %> <span style="color: #E11D48;">*</span></label>
                            <input type="text" name="last_name" required value="<%= student.last_name || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Email || 'Email' %> <span style="color: #E11D48;">*</span></label>
                            <input type="email" name="email" required value="<%= student.email || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Phone || 'Phone' %></label>
                            <input type="tel" name="phone" value="<%= student.phone || '' %>" class="form-input-compact">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Password || 'Password' %></label>
                            <input type="password" name="password" placeholder="<%- lan.Leave_Blank_Keep_Current || 'Leave blank to keep current' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Admission_No || 'Admission No' %> <span style="color: #E11D48;">*</span></label>
                            <input type="text" name="admission_no" required value="<%= student.admission_no %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Roll_No || 'Roll No' %></label>
                            <input type="text" name="roll_no" value="<%= student.roll_no || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Admission_Date || 'Admission Date' %> <span style="color: #E11D48;">*</span></label>
                            <input type="date" name="admission_date" required value="<%= student.admission_date ? new Date(student.admission_date).toISOString().split('T')[0] : '' %>" class="form-input-compact">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Class || 'Class' %> <span id="classRequiredMark" style="color: #E11D48;">*</span></label>
                            <select id="studentClassSelect" name="base_class_id" class="form-input-compact">
                                <option value=""><%- lan.Select_Class || 'Select Class' %></option>
                                <% classes.forEach(cls => { %>
                                    <option value="<%= cls.id %>" <%= currentBaseClassId == cls.id ? 'selected' : '' %>><%= cls.display_name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Section || 'Section' %> <span id="sectionRequiredMark" style="color: #E11D48;">*</span></label>
                            <select id="studentSectionSelect" name="class_id" class="form-input-compact" <%= activeSections.length ? '' : 'disabled' %>>
                                <option value=""><%- lan.Select_Section || 'Select Section' %></option>
                                <% activeSections.forEach(sec => { %>
                                    <option value="<%= sec.id %>" <%= student.class_id == sec.id ? 'selected' : '' %>><%- lan.Section || 'Section' %> <%= sec.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Date_Of_Birth || 'Date of Birth' %> <span style="color: #E11D48;">*</span></label>
                            <input type="date" name="dob" required value="<%= student.dob ? new Date(student.dob).toISOString().split('T')[0] : '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Gender || 'Gender' %></label>
                            <select name="gender" class="form-input-compact">
                                <option value=""><%- lan.Select_Gender || 'Select' %></option>
                                <option value="male" <%= student.gender === 'male' ? 'selected' : '' %>><%- lan.Male || 'Male' %></option>
                                <option value="female" <%= student.gender === 'female' ? 'selected' : '' %>><%- lan.Female || 'Female' %></option>
                            </select>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Blood_Group || 'Blood Group' %></label>
                            <select name="blood_group" class="form-input-compact">
                                <option value=""><%- lan.Select_Blood_Group || 'Select' %></option>
                                <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(bg => { %>
                                    <option value="<%= bg %>" <%= student.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Aadhaar_No || 'Aadhaar No' %></label>
                            <input type="text" name="aadhaar_no" maxlength="12" value="<%= student.aadhaar_no || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Religion || 'Religion' %></label>
                            <input type="text" name="religion" value="<%= student.religion || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Category || 'Category' %></label>
                            <select name="category" class="form-input-compact">
                                <option value=""><%- lan.Select_Category || 'Select' %></option>
                                <% ['General','OBC','SC','ST'].forEach(cat => { %>
                                    <option value="<%= cat %>" <%= student.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Status || 'Status' %></label>
                            <select name="status" class="form-input-compact">
                                <option value="active" <%= student.status === 'active' ? 'selected' : '' %>><%- lan.Active || 'Active' %></option>
                                <option value="unassigned" <%= student.status === 'unassigned' ? 'selected' : '' %>><%- lan.Unassigned || 'Unassigned' %></option>
                                <option value="inactive" <%= student.status === 'inactive' ? 'selected' : '' %>><%- lan.Inactive || 'Inactive' %></option>
                                <option value="left" <%= student.status === 'left' ? 'selected' : '' %>><%- lan.Left || 'Left' %></option>
                                <option value="graduated" <%= student.status === 'graduated' ? 'selected' : '' %>><%- lan.Graduated || 'Graduated' %></option>
                            </select>
                        </div>
                    </div>
                    <div style="margin-top: 10px;">
                        <label class="form-label-compact"><%- lan.Medical_Notes || 'Medical Notes' %></label>
                        <textarea name="medical_notes" rows="2" class="form-textarea-compact"><%= student.medical_notes || '' %></textarea>
                    </div>
                </div>
                <div class="student-form-card">
                    <h3 class="student-form-section-title">
                        <i class="fa-solid fa-people-roof"></i> <%- lan.Family_Details || 'Family Details' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Fathers_Name || "Father's Name" %></label>
                            <input type="text" name="father_name" value="<%= student.father_name || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Fathers_Phone || "Father's Phone" %></label>
                            <input type="tel" name="father_phone" value="<%= student.father_phone || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Fathers_Email || "Father's Email" %></label>
                            <input type="email" name="father_email" value="<%= student.father_email || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Fathers_Occupation || "Father's Occupation" %></label>
                            <input type="text" name="father_occupation" value="<%= student.father_occupation || '' %>" class="form-input-compact">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mothers_Name || "Mother's Name" %></label>
                            <input type="text" name="mother_name" value="<%= student.mother_name || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mothers_Phone || "Mother's Phone" %></label>
                            <input type="tel" name="mother_phone" value="<%= student.mother_phone || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mothers_Email || "Mother's Email" %></label>
                            <input type="email" name="mother_email" value="<%= student.mother_email || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mothers_Occupation || "Mother's Occupation" %></label>
                            <input type="text" name="mother_occupation" value="<%= student.mother_occupation || '' %>" class="form-input-compact">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Guardian_Name || 'Guardian Name' %></label>
                            <input type="text" name="guardian_name" value="<%= student.guardian_name || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Relation || 'Relation' %></label>
                            <input type="text" name="guardian_relation" value="<%= student.guardian_relation || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Guardian_Phone || 'Guardian Phone' %></label>
                            <input type="tel" name="guardian_phone" value="<%= student.guardian_phone || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Guardian_Aadhaar || 'Guardian Aadhaar' %></label>
                            <input type="text" name="guardian_aadhaar" maxlength="12" value="<%= student.guardian_aadhaar || '' %>" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div class="student-form-card">
                    <h3 class="student-form-section-title">
                        <i class="fa-solid fa-map-location-dot"></i> <%- lan.Address_Details || 'Address Details' %>
                    </h3>
                    <div class="form-group-compact">
                        <label class="form-label-compact"><%- lan.Permanent_Address || 'Permanent Address' %></label>
                        <textarea name="permanent_address" rows="2" class="form-textarea-compact"><%= student.permanent_address || '' %></textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.City || 'City' %></label>
                            <input type="text" name="permanent_city" value="<%= student.permanent_city || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.State || 'State' %></label>
                            <input type="text" name="permanent_state" value="<%= student.permanent_state || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Pincode || 'Pincode' %></label>
                            <input type="text" name="permanent_pincode" value="<%= student.permanent_pincode || '' %>" class="form-input-compact">
                        </div>
                    </div>
                    <div style="margin-top: 10px; display: flex; align-items: center;">
                        <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: #475569; cursor: pointer;">
                            <input type="checkbox" name="current_address_same" value="1" <%=student.current_address_same ? 'checked' : '' %>> <%- lan.Same_As_Permanent_Address || 'Same as permanent address' %>
                        </label>
                    </div>
                    <div id="currentAddressFields" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact" style="grid-column: 1 / -1;">
                            <label class="form-label-compact"><%- lan.Current_Address || 'Current Address' %></label>
                            <textarea name="current_address" rows="2" class="form-textarea-compact"><%= student.current_address || '' %></textarea>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Current_City || 'Current City' %></label>
                            <input type="text" name="current_city" value="<%= student.current_city || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Current_State || 'Current State' %></label>
                            <input type="text" name="current_state" value="<%= student.current_state || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Current_Pincode || 'Current Pincode' %></label>
                            <input type="text" name="current_pincode" value="<%= student.current_pincode || '' %>" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px;">
                    <div class="student-form-card">
                        <h3 class="student-form-section-title">
                            <i class="fa-solid fa-bus"></i> <%- lan.Transport_Details || 'Transport Details' %>
                        </h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Transport_Required || 'Transport Required' %></label>
                                <select name="transport_required" class="form-input-compact">
                                    <option value="0" <%= student.transport_required === '0' || !student.transport_required ? 'selected' : '' %>><%- lan.No || 'No' %></option>
                                    <option value="1" <%= student.transport_required === '1' ? 'selected' : '' %>><%- lan.Yes || 'Yes' %></option>
                                </select>
                            </div>
                            <div class="form-group-compact transport-detail">
                                <label class="form-label-compact"><%- lan.Transport_Mode || 'Transport Mode' %></label>
                                <select name="transport_mode" class="form-input-compact">
                                    <option value=""><%- lan.Select_Mode || 'Select Mode' %></option>
                                    <option value="School Bus" <%=student.transport_mode==='School Bus' ? 'selected' : '' %>><%- lan.School_Bus || 'School Bus' %></option>
                                    <option value="Private" <%=student.transport_mode==='Private' ? 'selected' : '' %>><%- lan.Private || 'Private' %></option>
                                    <option value="Self" <%=student.transport_mode==='Self' ? 'selected' : '' %>><%- lan.Self || 'Self' %></option>
                                    <option value="Other" <%=student.transport_mode==='Other' ? 'selected' : '' %>><%- lan.Other || 'Other' %></option>
                                </select>
                            </div>
                        </div>
                        <div class="transport-detail" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Route || 'Route' %></label>
                                <input type="text" name="transport_route" value="<%= student.transport_route || '' %>" class="form-input-compact">
                            </div>
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Vehicle_No || 'Vehicle No' %></label>
                                <input type="text" name="transport_vehicle_no" value="<%= student.transport_vehicle_no || '' %>" class="form-input-compact">
                            </div>
                        </div>
                    </div>
                    <div class="student-form-card">
                        <h3 class="student-form-section-title">
                            <i class="fa-solid fa-building-user"></i> <%- lan.Hostel_Details || 'Hostel Details' %>
                        </h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Hostel_Required || 'Hostel Required' %></label>
                                <select name="hostel_required" class="form-input-compact">
                                    <option value="0" <%= student.hostel_required === '0' || !student.hostel_required ? 'selected' : '' %>><%- lan.No || 'No' %></option>
                                    <option value="1" <%= student.hostel_required === '1' ? 'selected' : '' %>><%- lan.Yes || 'Yes' %></option>
                                </select>
                            </div>
                            <div class="form-group-compact hostel-detail">
                                <label class="form-label-compact"><%- lan.Hostel_Name || 'Hostel Name' %></label>
                                <input type="text" name="hostel_name" value="<%= student.hostel_name || '' %>" class="form-input-compact">
                            </div>
                        </div>
                        <div class="hostel-detail" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Room_No || 'Room No' %></label>
                                <input type="text" name="hostel_room_no" value="<%= student.hostel_room_no || '' %>" class="form-input-compact">
                            </div>
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Hostel_Phone || 'Hostel Phone' %></label>
                                <input type="tel" name="hostel_phone_number" value="<%= student.hostel_phone_number || '' %>" class="form-input-compact">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="student-form-card">
                    <h3 class="student-form-section-title">
                        <i class="fa-solid fa-file-pdf"></i> <%- lan.Documents_Upload || 'Documents Upload' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Student_Photo || 'Student Photo' %></label>
                            <input type="file" name="student_image" accept=".jpg,.jpeg,.png,.webp" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Father_Photo || 'Father Photo' %></label>
                            <input type="file" name="father_image" accept=".jpg,.jpeg,.png,.webp" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mother_Photo || 'Mother Photo' %></label>
                            <input type="file" name="mother_image" accept=".jpg,.jpeg,.png,.webp" class="form-input-compact">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Birth_Certificate || 'Birth Certificate' %></label>
                            <input type="file" name="birth_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Aadhaar_Card || 'Aadhaar Card' %></label>
                            <input type="file" name="aadhaar_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Leaving_Certificate || 'Leaving Certificate' %></label>
                            <input type="file" name="leaving_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Previous_Marksheet || 'Previous Marksheet' %></label>
                            <input type="file" name="previous_marksheet" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div style="display: flex; gap: 8px; margin-top: 14px; margin-bottom: 20px;">
                    <button type="submit" class="btn" style="background: #059669; color: #fff; height: 38px; padding: 0 20px; font-size: 12px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; border: none; cursor: pointer; box-shadow: 0 2px 6px rgba(5,150,105,0.2);">
                        <i class="fa-solid fa-floppy-disk"></i> <%- lan.Save_Changes || 'Save Changes' %>
                    </button>
                    <a href="/schooladmin/students/<%= student.id %>/view" class="btn" style="background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1; height: 38px; padding: 0 16px; font-size: 12px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; text-decoration: none;">
                        <%- lan.Cancel || 'Cancel' %>
                    </a>
                </div>
            </form>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sameAddress = document.querySelector('[name="current_address_same"]');
        const permanentAddress = document.querySelector('[name="permanent_address"]');
        const permanentCity = document.querySelector('[name="permanent_city"]');
        const permanentState = document.querySelector('[name="permanent_state"]');
        const permanentPincode = document.querySelector('[name="permanent_pincode"]');
        const currentAddress = document.querySelector('[name="current_address"]');
        const currentCity = document.querySelector('[name="current_city"]');
        const currentState = document.querySelector('[name="current_state"]');
        const currentPincode = document.querySelector('[name="current_pincode"]');
        const currentFields = [currentAddress, currentCity, currentState, currentPincode];
        const transportRequired = document.querySelector('[name="transport_required"]');
        const transportDetails = document.querySelectorAll('.transport-detail');
        const hostelRequired = document.querySelector('[name="hostel_required"]');
        const hostelDetails = document.querySelectorAll('.hostel-detail');

        function syncCurrentAddress() {
            if (sameAddress && sameAddress.checked) {
                if (currentAddress) currentAddress.value = permanentAddress.value;
                if (currentCity) currentCity.value = permanentCity.value;
                if (currentState) currentState.value = permanentState.value;
                if (currentPincode) currentPincode.value = permanentPincode.value;
            };
            currentFields.forEach(field => {
                if (field && sameAddress) field.disabled = sameAddress.checked;
            });
        };

        function syncTransport() {
            if (!transportRequired) return;
            const enabled = transportRequired.value === '1';
            transportDetails.forEach(group => {
                group.style.display = enabled ? '' : 'none';
                group.querySelectorAll('input, select').forEach(field => field.disabled = !enabled);
            });
        };

        function syncHostel() {
            if (!hostelRequired) return;
            const enabled = hostelRequired.value === '1';
            hostelDetails.forEach(group => {
                group.style.display = enabled ? '' : 'none';
                group.querySelectorAll('input').forEach(field => {
                    field.disabled = !enabled;
                    field.required = enabled;
                });
            });
        };

        [permanentAddress, permanentCity, permanentState, permanentPincode].forEach(field => {
            if (field) field.addEventListener('input', syncCurrentAddress);
        });
        if (sameAddress) sameAddress.addEventListener('change', syncCurrentAddress);
        if (transportRequired) transportRequired.addEventListener('change', syncTransport);
        if (hostelRequired) hostelRequired.addEventListener('change', syncHostel);
        syncCurrentAddress();
        syncTransport();
        syncHostel();

        const classSelect = document.getElementById('studentClassSelect');
        const sectionSelect = document.getElementById('studentSectionSelect');
        if (classSelect && sectionSelect) {
            classSelect.addEventListener('change', async function() {
                const baseClassId = this.value;
                sectionSelect.innerHTML = '<option value="">Select Section</option>';
                if (!baseClassId) {
                    sectionSelect.disabled = true;
                    return;
                };
                try {
                    const res = await fetch(`/schooladmin/students/api/classes/${baseClassId}/sections`);
                    const data = await res.json();
                    if (data.sections && data.sections.length > 0) {
                        data.sections.forEach(sec => {
                            const opt = document.createElement('option');
                            opt.value = sec.id;
                            opt.textContent = 'Section ' + sec.name;
                            sectionSelect.appendChild(opt);
                        });
                        sectionSelect.disabled = false;
                    } else {
                        sectionSelect.disabled = true;
                    };
                } catch (e) {
                    console.error(e);
                    sectionSelect.disabled = true;
                };
            });
        };
    });
</script>