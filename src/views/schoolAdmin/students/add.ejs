<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <style>
              .add-student-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                margin-bottom: 24px;
                flex-wrap: wrap;
              }
              .add-student-title {
                font-size: 22px;
                font-weight: 800;
                color: var(--text-primary, #1E293B);
                margin: 0;
                line-height: 1.2;
              }
              .add-student-subtitle {
                font-size: 12px;
                color: var(--text-muted);
                margin: 4px 0 0;
              }
              @media (max-width: 640px) {
                .add-student-header {
                  flex-direction: column;
                  align-items: flex-start;
                }
                .add-student-header .btn {
                  width: 100%;
                  justify-content: center;
                }
                .add-student-title { font-size: 20px; }
                .grid.grid-cols-1.md\:grid-cols-4 {
                  grid-template-columns: repeat(2, 1fr) !important;
                }
              }
              @media (max-width: 420px) {
                .grid.grid-cols-1.md\:grid-cols-4 {
                  grid-template-columns: 1fr !important;
                }
              }
            </style>
            <div class="add-student-header">
                <div>
                    <h2 class="add-student-title">Add New Student</h2>
                    <p class="add-student-subtitle">Register a new student profile in the school system</p>
                </div>
                <a href="/schooladmin/students" class="btn btn-secondary text-xs flex items-center gap-1">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <form action="/schooladmin/students/add" method="POST" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-user me-2"></i>Basic / Academic Details
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">First Name <span class="text-danger">*</span></label>
                            <input type="text" name="first_name" required value="<%= old.first_name || '' %>" class="form-input" placeholder="Enter first name">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Last Name <span class="text-danger">*</span></label>
                            <input type="text" name="last_name" required value="<%= old.last_name || '' %>" class="form-input" placeholder="Enter last name">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Email</label>
                            <input type="email" name="email" value="<%= old.email || '' %>" class="form-input" placeholder="student@example.com">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Phone <span class="text-danger">*</span></label>
                            <input type="tel" name="phone" required maxlength="10" value="<%= old.phone || '' %>" class="form-input" placeholder="98765 43210">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Password <span class="text-danger">*</span></label>
                            <input type="password" name="password" required class="form-input" placeholder="********">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Date of Birth <span class="text-danger">*</span></label>
                            <input type="date" name="dob" required value="<%= old.dob || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Standard <span class="text-danger">*</span></label>
                            <input type="text" name="standard" id="standard" required value="<%= old.standard || '' %>" placeholder="Enter standard e.g. Nursery, LKG, UKG, Class 1, Class 10" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Gender <span class="text-danger">*</span></label>
                            <select name="gender" required class="form-select">
                                <option value="">Select Gender</option>
                                <option value="male" <%=old.gender==='male' ? 'selected' : '' %>>Male</option>
                                <option value="female" <%=old.gender==='female' ? 'selected' : '' %>>Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Blood Group</label>
                            <select name="blood_group" class="form-select">
                                <option value="">Select Blood Group</option>
                                <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(bg=> { %>
                                    <option value="<%= bg %>" <%=old.blood_group===bg ? 'selected': '' %>><%= bg %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Aadhaar No</label>
                            <input type="text" name="aadhaar_no" maxlength="12" value="<%= old.aadhaar_no || '' %>" class="form-input" placeholder="1234 5678 9012">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Religion</label>
                            <input type="text" name="religion" value="<%= old.religion || '' %>" class="form-input" placeholder="Hindu / Muslim / Christian">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Category</label>
                            <select name="category" class="form-select">
                                <option value="">Select Category</option>
                                <% ['General','OBC','SC','ST'].forEach(cat=> { %>
                                    <option value="<%= cat %>" <%=old.category===cat ? 'selected' : '' %>><%= cat %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="form-group mt-4">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Medical Notes</label>
                        <textarea name="medical_notes" rows="3" class="form-textarea" placeholder="Any medical condition, allergy, etc. (optional)"><%= old.medical_notes || '' %></textarea>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-people-roof me-2"></i>Family Details
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Father's Name</label>
                            <input type="text" name="father_name" value="<%= old.father_name || '' %>" class="form-input" placeholder="Enter father's full name">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Father's Phone</label>
                            <input type="tel" name="father_phone" value="<%= old.father_phone || '' %>" class="form-input" placeholder="98765 43210">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Father's Email</label>
                            <input type="email" name="father_email" value="<%= old.father_email || '' %>" class="form-input" placeholder="father@example.com">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Father's Occupation</label>
                            <input type="text" name="father_occupation" value="<%= old.father_occupation || '' %>" class="form-input" placeholder="Business / Teacher / Doctor">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Mother's Name</label>
                            <input type="text" name="mother_name" value="<%= old.mother_name || '' %>" class="form-input" placeholder="Enter mother's full name">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Mother's Phone</label>
                            <input type="tel" name="mother_phone" value="<%= old.mother_phone || '' %>" class="form-input" placeholder="98765 43210">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Mother's Email</label>
                            <input type="email" name="mother_email" value="<%= old.mother_email || '' %>" class="form-input" placeholder="mother@example.com">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Mother's Occupation</label>
                            <input type="text" name="mother_occupation" value="<%= old.mother_occupation || '' %>" class="form-input" placeholder="Housewife / Teacher / Engineer">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Guardian Name</label>
                            <input type="text" name="guardian_name" value="<%= old.guardian_name || '' %>" class="form-input" placeholder="Guardian full name">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Relation</label>
                            <input type="text" name="guardian_relation" value="<%= old.guardian_relation || '' %>" class="form-input" placeholder="Uncle / Aunt / Grandfather">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Guardian Phone</label>
                            <input type="tel" name="guardian_phone" value="<%= old.guardian_phone || '' %>" class="form-input" placeholder="98765 43210">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Guardian Occupation</label>
                            <input type="text" name="guardian_occupation" value="<%= old.guardian_occupation || '' %>" class="form-input" placeholder="Occupation">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Guardian Aadhaar</label>
                            <input type="text" name="guardian_aadhaar" maxlength="12" value="<%= old.guardian_aadhaar || '' %>" class="form-input" placeholder="123456789012">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-map-location-dot me-2"></i>Address Details
                    </h3>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Permanent Address</label>
                        <textarea name="permanent_address" rows="3" class="form-textarea" placeholder="House no, Street, Area..."><%= old.permanent_address || '' %></textarea>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">City</label>
                            <input type="text" name="permanent_city" value="<%= old.permanent_city || '' %>" class="form-input" placeholder="Ahmedabad / Surat / Vadodara">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">State</label>
                            <input type="text" name="permanent_state" value="<%= old.permanent_state || '' %>" class="form-input" placeholder="Gujarat">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Pincode</label>
                            <input type="text" name="permanent_pincode" value="<%= old.permanent_pincode || '' %>" class="form-input" placeholder="380015">
                        </div>
                    </div>
                    <div class="mt-4 flex items-center">
                        <label class="inline-flex items-center text-sm text-gray-700 cursor-pointer">
                            <input type="checkbox" name="current_address_same" class="rounded border-gray-300 mr-2 w-4 h-4 accent-[var(--primary)]" value="1" <%=old.current_address_same ? 'checked' : '' %> Same as permanent address
                        </label>
                    </div>
                    <div id="currentAddressFields" class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                        <div class="form-group mb-0 md:col-span-3">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Current Address</label>
                            <textarea name="current_address" rows="3" class="form-textarea" placeholder="House no, Street, Area..."><%= old.current_address || '' %></textarea>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Current City</label>
                            <input type="text" name="current_city" value="<%= old.current_city || '' %>" class="form-input" placeholder="Ahmedabad / Surat / Vadodara">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Current State</label>
                            <input type="text" name="current_state" value="<%= old.current_state || '' %>" class="form-input" placeholder="Gujarat">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Current Pincode</label>
                            <input type="text" name="current_pincode" value="<%= old.current_pincode || '' %>" class="form-input" placeholder="380015">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-bus me-2"></i>Transport Details
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Transport Required</label>
                            <select name="transport_required" class="form-select">
                                <option value="0" <%= old.transport_required === '0' || !old.transport_required ? 'selected' : '' %>>No</option>
                                <option value="1" <%= old.transport_required === '1' ? 'selected' : '' %>>Yes</option>
                            </select>
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Transport Mode</label>
                            <select name="transport_mode" class="form-select">
                                <option value="">Select Mode</option>
                                <option value="School Bus" <%=old.transport_mode==='School Bus' ? 'selected' : '' %>>School Bus</option>
                                <option value="Private" <%=old.transport_mode==='Private' ? 'selected' : '' %>>Private</option>
                                <option value="Self" <%=old.transport_mode==='Self' ? 'selected' : '' %>>Self</option>
                                <option value="Other" <%=old.transport_mode==='Other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Route</label>
                            <input type="text" name="transport_route" value="<%= old.transport_route || '' %>" class="form-input" placeholder="Route No / Area">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Vehicle No</label>
                            <input type="text" name="transport_vehicle_no" value="<%= old.transport_vehicle_no || '' %>" class="form-input" placeholder="GJ-01-AB-1234">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Pickup Latitude</label>
                            <input type="text" name="pickup_latitude" value="<%= old.pickup_latitude || '' %>" class="form-input" placeholder="23.0225">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Pickup Longitude</label>
                            <input type="text" name="pickup_longitude" value="<%= old.pickup_longitude || '' %>" class="form-input" placeholder="72.5714">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-building-user me-2"></i>Hostel Details
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Hostel Required</label>
                            <select name="hostel_required" class="form-select">
                                <option value="0" <%= old.hostel_required === '0' || !old.hostel_required ? 'selected' : '' %>>No</option>
                                <option value="1" <%= old.hostel_required === '1' ? 'selected' : '' %>>Yes</option>
                            </select>
                        </div>
                        <div class="form-group mb-0 hostel-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Hostel Name</label>
                            <input type="text" name="hostel_name" value="<%= old.hostel_name || '' %>" class="form-input" placeholder="Hostel Name">
                        </div>
                        <div class="form-group mb-0 hostel-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Room No</label>
                            <input type="text" name="hostel_room_no" value="<%= old.hostel_room_no || '' %>" class="form-input" placeholder="Room No">
                        </div>
                        <div class="form-group mb-0 hostel-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Hostel Phone</label>
                            <input type="tel" name="hostel_phone_number" value="<%= old.hostel_phone_number || '' %>" class="form-input" placeholder="Hostel Phone">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-file-pdf me-2"></i>Documents Upload
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Student Photo</label>
                            <input type="file" name="student_image" accept=".jpg,.jpeg,.png,.webp" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Father Photo</label>
                            <input type="file" name="father_image" accept=".jpg,.jpeg,.png,.webp" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Mother Photo</label>
                            <input type="file" name="mother_image" accept=".jpg,.jpeg,.png,.webp" class="form-input">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Birth Certificate</label>
                            <input type="file" name="birth_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Aadhaar Card</label>
                            <input type="file" name="aadhaar_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Leaving Certificate</label>
                            <input type="file" name="leaving_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Previous Marksheet</label>
                            <input type="file" name="previous_marksheet" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                    </div>
                </div>
                <div class="flex gap-4 pt-4">
                    <button type="submit" class="btn btn-primary px-8 py-3">
                        <i class="fa-solid fa-floppy-disk me-2"></i> Save Student
                    </button>
                    <a href="/schooladmin/students" class="btn btn-secondary px-8 py-3"> Cancel</a>
                </div>
            </form>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sameAddress = document.querySelector('[name="current_address_same"]');
            const permanentAddress = document.querySelector('[name="permanent_address"]');
            const permanentCity = document.querySelector('[name="permanent_city"]');
            const permanentState = document.querySelector('[name="permanent_state"]');
            const permanentPincode = document.querySelector('[name="permanent_pincode"]');
            const currentAddress = document.querySelector('[name="current_address"]');
            const currentCity = document.querySelector('[name="current_city"]');
            const currentState = document.querySelector('[name="current_state"]');
            const currentPincode = document.querySelector('[name="current_pincode"]');
            const currentFields = [currentAddress, currentCity, currentState, currentPincode];
            const transportRequired = document.querySelector('[name="transport_required"]');
            const transportDetails = document.querySelectorAll('.transport-detail');
            const hostelRequired = document.querySelector('[name="hostel_required"]');
            const hostelDetails = document.querySelectorAll('.hostel-detail');

            function syncCurrentAddress() {
                if (sameAddress.checked) {
                    currentAddress.value = permanentAddress.value;
                    currentCity.value = permanentCity.value;
                    currentState.value = permanentState.value;
                    currentPincode.value = permanentPincode.value;
                }
                currentFields.forEach(field => field.disabled = sameAddress.checked);
            }

            function syncTransport() {
                const enabled = transportRequired.value === '1';
                transportDetails.forEach(group => {
                    group.style.display = enabled ? '' : 'none';
                    group.querySelectorAll('input, select').forEach(field => field.disabled = !enabled);
                });
            }

            function syncHostel() {
                const enabled = hostelRequired.value === '1';
                hostelDetails.forEach(group => {
                    group.style.display = enabled ? '' : 'none';
                    group.querySelectorAll('input').forEach(field => {
                        field.disabled = !enabled;
                        field.required = enabled;
                    });
                });
            }

            [permanentAddress, permanentCity, permanentState, permanentPincode].forEach(field => {
                field.addEventListener('input', syncCurrentAddress);
            });
            sameAddress.addEventListener('change', syncCurrentAddress);
            transportRequired.addEventListener('change', syncTransport);
            hostelRequired.addEventListener('change', syncHostel);
            syncCurrentAddress();
            syncTransport();
            syncHostel();
        });
    </script>
</div>
