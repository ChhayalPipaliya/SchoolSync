<style>
    .student-form-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 12px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .student-form-section-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #059669;
        margin-bottom: 12px;
        padding-bottom: 6px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-group-compact {
        margin-bottom: 0;
    }

    .form-label-compact {
        font-size: 9px;
        font-weight: 700;
        color: #94A3B8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 4px;
    }

    .form-input-compact {
        width: 100%;
        height: 34px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 0 10px;
        font-size: 11px;
        background: #FFFFFF;
        color: #1E293B;
        outline: none;
        transition: border-color 0.15s;
    }

    .form-input-compact:focus {
        border-color: #059669;
    }

    .form-textarea-compact {
        width: 100%;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 11px;
        background: #FFFFFF;
        color: #1E293B;
        outline: none;
        resize: vertical;
        transition: border-color 0.15s;
    }

    .form-textarea-compact:focus {
        border-color: #059669;
    }

    [data-theme="dark"] .student-form-card,
    .light-mode-disabled .student-form-card {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .student-form-section-title,
    .light-mode-disabled .student-form-section-title {
        border-bottom-color: #242F4D !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .form-input-compact,
    [data-theme="dark"] .form-textarea-compact,
    .light-mode-disabled .form-input-compact,
    .light-mode-disabled .form-textarea-compact {
        background-color: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
</style>
<%- include('../../partials/head', { title: `${lan.Add_New_Student || 'Add New Student'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Add_New_Student || 'Add New Student' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Add_Student_Subtitle || 'Register a new student profile in the school system' %></p>
                        </div>
                    </div>
                    <a href="/schooladmin/students" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                        <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_List || 'Back to List' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <form action="/schooladmin/students/add" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="student-form-card">
                    <h3 class="student-form-section-title">
                        <i class="fa-solid fa-user"></i> <%- lan.Basic_Academic_Details || 'Basic / Academic Details' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.First_Name || 'First Name' %> <span style="color: #E11D48;">*</span></label>
                            <input type="text" name="first_name" required value="<%= old.first_name || '' %>" class="form-input-compact" placeholder="<%- lan.Enter_First_Name || 'Enter first name' %>">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Last_Name || 'Last Name' %> <span style="color: #E11D48;">*</span></label>
                            <input type="text" name="last_name" required value="<%= old.last_name || '' %>" class="form-input-compact" placeholder="<%- lan.Enter_Last_Name || 'Enter last name' %>">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Email || 'Email' %></label>
                            <input type="email" name="email" value="<%= old.email || '' %>" class="form-input-compact" placeholder="student@example.com">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Phone || 'Phone' %> <span style="color: #E11D48;">*</span></label>
                            <input type="tel" name="phone" required maxlength="10" value="<%= old.phone || '' %>" class="form-input-compact" placeholder="98765 43210">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Password || 'Password' %> <span style="color: #E11D48;">*</span></label>
                            <input type="password" name="password" required class="form-input-compact" placeholder="********">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Date_Of_Birth || 'Date of Birth' %> <span style="color: #E11D48;">*</span></label>
                            <input type="date" name="dob" required value="<%= old.dob || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Standard || 'Standard' %> <span style="color: #E11D48;">*</span></label>
                            <input type="text" name="standard" id="standard" required value="<%= old.standard || '' %>" placeholder="<%- lan.Enter_Standard_Placeholder || 'Enter standard e.g. Nursery, LKG, Class 1, Class 10' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Gender || 'Gender' %> <span style="color: #E11D48;">*</span></label>
                            <select name="gender" required class="form-input-compact">
                                <option value=""><%- lan.Select_Gender || 'Select Gender' %></option>
                                <option value="male" <%=old.gender==='male' ? 'selected' : '' %>><%- lan.Male || 'Male' %></option>
                                <option value="female" <%=old.gender==='female' ? 'selected' : '' %>><%- lan.Female || 'Female' %></option>
                            </select>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Blood_Group || 'Blood Group' %></label>
                            <select name="blood_group" class="form-input-compact">
                                <option value=""><%- lan.Select_Blood_Group || 'Select Blood Group' %></option>
                                <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(bg=> { %>
                                    <option value="<%= bg %>" <%=old.blood_group===bg ? 'selected': '' %>><%= bg %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Aadhaar_No || 'Aadhaar No' %></label>
                            <input type="text" name="aadhaar_no" maxlength="12" value="<%= old.aadhaar_no || '' %>" class="form-input-compact" placeholder="1234 5678 9012">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Religion || 'Religion' %></label>
                            <input type="text" name="religion" value="<%= old.religion || '' %>" class="form-input-compact" placeholder="Hindu / Muslim / Christian">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Category || 'Category' %></label>
                            <select name="category" class="form-input-compact">
                                <option value=""><%- lan.Select_Category || 'Select Category' %></option>
                                <% ['General','OBC','SC','ST'].forEach(cat=> { %>
                                    <option value="<%= cat %>" <%=old.category===cat ? 'selected' : '' %>><%= cat %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div style="margin-top: 10px;">
                        <label class="form-label-compact"><%- lan.Medical_Notes || 'Medical Notes' %></label>
                        <textarea name="medical_notes" rows="2" class="form-textarea-compact" placeholder="<%- lan.Medical_Notes_Placeholder || 'Any medical condition, allergy, etc. (optional)' %>"><%= old.medical_notes || '' %></textarea>
                    </div>
                </div>
                <div class="student-form-card">
                    <h3 class="student-form-section-title">
                        <i class="fa-solid fa-people-roof"></i> <%- lan.Family_Details || 'Family Details' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Fathers_Name || "Father's Name" %></label>
                            <input type="text" name="father_name" value="<%= old.father_name || '' %>" class="form-input-compact" placeholder="<%- lan.Enter_Fathers_Name || "Enter father's full name" %>">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Fathers_Phone || "Father's Phone" %></label>
                            <input type="tel" name="father_phone" value="<%= old.father_phone || '' %>" class="form-input-compact" placeholder="98765 43210">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Fathers_Email || "Father's Email" %></label>
                            <input type="email" name="father_email" value="<%= old.father_email || '' %>" class="form-input-compact" placeholder="father@example.com">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Fathers_Occupation || "Father's Occupation" %></label>
                            <input type="text" name="father_occupation" value="<%= old.father_occupation || '' %>" class="form-input-compact" placeholder="Business / Teacher / Doctor">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mothers_Name || "Mother's Name" %></label>
                            <input type="text" name="mother_name" value="<%= old.mother_name || '' %>" class="form-input-compact" placeholder="<%- lan.Enter_Mothers_Name || "Enter mother's full name" %>">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mothers_Phone || "Mother's Phone" %></label>
                            <input type="tel" name="mother_phone" value="<%= old.mother_phone || '' %>" class="form-input-compact" placeholder="98765 43210">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mothers_Email || "Mother's Email" %></label>
                            <input type="email" name="mother_email" value="<%= old.mother_email || '' %>" class="form-input-compact" placeholder="mother@example.com">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mothers_Occupation || "Mother's Occupation" %></label>
                            <input type="text" name="mother_occupation" value="<%= old.mother_occupation || '' %>" class="form-input-compact" placeholder="Housewife / Teacher / Engineer">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Guardian_Name || 'Guardian Name' %></label>
                            <input type="text" name="guardian_name" value="<%= old.guardian_name || '' %>" class="form-input-compact" placeholder="<%- lan.Enter_Guardian_Name || 'Guardian full name' %>">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Relation || 'Relation' %></label>
                            <input type="text" name="guardian_relation" value="<%= old.guardian_relation || '' %>" class="form-input-compact" placeholder="Uncle / Aunt / Grandfather">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Guardian_Phone || 'Guardian Phone' %></label>
                            <input type="tel" name="guardian_phone" value="<%= old.guardian_phone || '' %>" class="form-input-compact" placeholder="98765 43210">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Guardian_Aadhaar || 'Guardian Aadhaar' %></label>
                            <input type="text" name="guardian_aadhaar" maxlength="12" value="<%= old.guardian_aadhaar || '' %>" class="form-input-compact" placeholder="123456789012">
                        </div>
                    </div>
                </div>
                <div class="student-form-card">
                    <h3 class="student-form-section-title">
                        <i class="fa-solid fa-map-location-dot"></i> <%- lan.Address_Details || 'Address Details' %>
                    </h3>
                    <div class="form-group-compact">
                        <label class="form-label-compact"><%- lan.Permanent_Address || 'Permanent Address' %></label>
                        <textarea name="permanent_address" rows="2" class="form-textarea-compact" placeholder="House no, Street, Area..."><%= old.permanent_address || '' %></textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.City || 'City' %></label>
                            <input type="text" name="permanent_city" value="<%= old.permanent_city || '' %>" class="form-input-compact" placeholder="Ahmedabad / Surat / Vadodara">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.State || 'State' %></label>
                            <input type="text" name="permanent_state" value="<%= old.permanent_state || '' %>" class="form-input-compact" placeholder="Gujarat">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Pincode || 'Pincode' %></label>
                            <input type="text" name="permanent_pincode" value="<%= old.permanent_pincode || '' %>" class="form-input-compact" placeholder="380015">
                        </div>
                    </div>
                    <div style="margin-top: 10px; display: flex; align-items: center;">
                        <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: #475569; cursor: pointer;">
                            <input type="checkbox" name="current_address_same" value="1" <%=old.current_address_same ? 'checked' : '' %>> <%- lan.Same_As_Permanent_Address || 'Same as permanent address' %>
                        </label>
                    </div>
                    <div id="currentAddressFields" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact" style="grid-column: 1 / -1;">
                            <label class="form-label-compact"><%- lan.Current_Address || 'Current Address' %></label>
                            <textarea name="current_address" rows="2" class="form-textarea-compact" placeholder="House no, Street, Area..."><%= old.current_address || '' %></textarea>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Current_City || 'Current City' %></label>
                            <input type="text" name="current_city" value="<%= old.current_city || '' %>" class="form-input-compact" placeholder="Ahmedabad / Surat / Vadodara">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Current_State || 'Current State' %></label>
                            <input type="text" name="current_state" value="<%= old.current_state || '' %>" class="form-input-compact" placeholder="Gujarat">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Current_Pincode || 'Current Pincode' %></label>
                            <input type="text" name="current_pincode" value="<%= old.current_pincode || '' %>" class="form-input-compact" placeholder="380015">
                        </div>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px;">
                    <div class="student-form-card">
                        <h3 class="student-form-section-title">
                            <i class="fa-solid fa-bus"></i> <%- lan.Transport_Details || 'Transport Details' %>
                        </h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Transport_Required || 'Transport Required' %></label>
                                <select name="transport_required" class="form-input-compact">
                                    <option value="0" <%= old.transport_required === '0' || !old.transport_required ? 'selected' : '' %>><%- lan.No || 'No' %></option>
                                    <option value="1" <%= old.transport_required === '1' ? 'selected' : '' %>><%- lan.Yes || 'Yes' %></option>
                                </select>
                            </div>
                            <div class="form-group-compact transport-detail">
                                <label class="form-label-compact"><%- lan.Transport_Mode || 'Transport Mode' %></label>
                                <select name="transport_mode" class="form-input-compact">
                                    <option value=""><%- lan.Select_Mode || 'Select Mode' %></option>
                                    <option value="School Bus" <%=old.transport_mode==='School Bus' ? 'selected' : '' %>><%- lan.School_Bus || 'School Bus' %></option>
                                    <option value="Private" <%=old.transport_mode==='Private' ? 'selected' : '' %>><%- lan.Private || 'Private' %></option>
                                    <option value="Self" <%=old.transport_mode==='Self' ? 'selected' : '' %>><%- lan.Self || 'Self' %></option>
                                    <option value="Other" <%=old.transport_mode==='Other' ? 'selected' : '' %>><%- lan.Other || 'Other' %></option>
                                </select>
                            </div>
                        </div>
                        <div class="transport-detail" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Route || 'Route' %></label>
                                <input type="text" name="transport_route" value="<%= old.transport_route || '' %>" class="form-input-compact" placeholder="Route No / Area">
                            </div>
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Vehicle_No || 'Vehicle No' %></label>
                                <input type="text" name="transport_vehicle_no" value="<%= old.transport_vehicle_no || '' %>" class="form-input-compact" placeholder="GJ-01-AB-1234">
                            </div>
                        </div>
                    </div>
                    <div class="student-form-card">
                        <h3 class="student-form-section-title">
                            <i class="fa-solid fa-building-user"></i> <%- lan.Hostel_Details || 'Hostel Details' %>
                        </h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Hostel_Required || 'Hostel Required' %></label>
                                <select name="hostel_required" class="form-input-compact">
                                    <option value="0" <%= old.hostel_required === '0' || !old.hostel_required ? 'selected' : '' %>><%- lan.No || 'No' %></option>
                                    <option value="1" <%= old.hostel_required === '1' ? 'selected' : '' %>><%- lan.Yes || 'Yes' %></option>
                                </select>
                            </div>
                            <div class="form-group-compact hostel-detail">
                                <label class="form-label-compact"><%- lan.Hostel_Name || 'Hostel Name' %></label>
                                <input type="text" name="hostel_name" value="<%= old.hostel_name || '' %>" class="form-input-compact" placeholder="Hostel Name">
                            </div>
                        </div>
                        <div class="hostel-detail" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Room_No || 'Room No' %></label>
                                <input type="text" name="hostel_room_no" value="<%= old.hostel_room_no || '' %>" class="form-input-compact" placeholder="Room No">
                            </div>
                            <div class="form-group-compact">
                                <label class="form-label-compact"><%- lan.Hostel_Phone || 'Hostel Phone' %></label>
                                <input type="tel" name="hostel_phone_number" value="<%= old.hostel_phone_number || '' %>" class="form-input-compact" placeholder="Hostel Phone">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="student-form-card">
                    <h3 class="student-form-section-title">
                        <i class="fa-solid fa-file-pdf"></i> <%- lan.Documents_Upload || 'Documents Upload' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Student_Photo || 'Student Photo' %></label>
                            <input type="file" name="student_image" accept=".jpg,.jpeg,.png,.webp" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Father_Photo || 'Father Photo' %></label>
                            <input type="file" name="father_image" accept=".jpg,.jpeg,.png,.webp" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mother_Photo || 'Mother Photo' %></label>
                            <input type="file" name="mother_image" accept=".jpg,.jpeg,.png,.webp" class="form-input-compact">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Birth_Certificate || 'Birth Certificate' %></label>
                            <input type="file" name="birth_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Aadhaar_Card || 'Aadhaar Card' %></label>
                            <input type="file" name="aadhaar_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Leaving_Certificate || 'Leaving Certificate' %></label>
                            <input type="file" name="leaving_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Previous_Marksheet || 'Previous Marksheet' %></label>
                            <input type="file" name="previous_marksheet" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div style="display: flex; gap: 8px; margin-top: 14px; margin-bottom: 20px;">
                    <button type="submit" class="btn" style="background: #059669; color: #fff; height: 38px; padding: 0 20px; font-size: 12px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; border: none; cursor: pointer; box-shadow: 0 2px 6px rgba(5,150,105,0.2);">
                        <i class="fa-solid fa-floppy-disk"></i> <%- lan.Save_Student || 'Save Student' %>
                    </button>
                    <a href="/schooladmin/students" class="btn" style="background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1; height: 38px; padding: 0 16px; font-size: 12px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; text-decoration: none;">
                        <%- lan.Cancel || 'Cancel' %>
                    </a>
                </div>
            </form>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sameAddress = document.querySelector('[name="current_address_same"]');
        const permanentAddress = document.querySelector('[name="permanent_address"]');
        const permanentCity = document.querySelector('[name="permanent_city"]');
        const permanentState = document.querySelector('[name="permanent_state"]');
        const permanentPincode = document.querySelector('[name="permanent_pincode"]');
        const currentAddress = document.querySelector('[name="current_address"]');
        const currentCity = document.querySelector('[name="current_city"]');
        const currentState = document.querySelector('[name="current_state"]');
        const currentPincode = document.querySelector('[name="current_pincode"]');
        const currentFields = [currentAddress, currentCity, currentState, currentPincode];
        const transportRequired = document.querySelector('[name="transport_required"]');
        const transportDetails = document.querySelectorAll('.transport-detail');
        const hostelRequired = document.querySelector('[name="hostel_required"]');
        const hostelDetails = document.querySelectorAll('.hostel-detail');

        function syncCurrentAddress() {
            if (sameAddress.checked) {
                currentAddress.value = permanentAddress.value;
                currentCity.value = permanentCity.value;
                currentState.value = permanentState.value;
                currentPincode.value = permanentPincode.value;
            };
            currentFields.forEach(field => field.disabled = sameAddress.checked);
        };

        function syncTransport() {
            const enabled = transportRequired.value === '1';
            transportDetails.forEach(group => {
                group.style.display = enabled ? '' : 'none';
                group.querySelectorAll('input, select').forEach(field => field.disabled = !enabled);
            });
        };

        function syncHostel() {
            const enabled = hostelRequired.value === '1';
            hostelDetails.forEach(group => {
                group.style.display = enabled ? '' : 'none';
                group.querySelectorAll('input').forEach(field => {
                    field.disabled = !enabled;
                    field.required = enabled;
                });
            });
        };

        [permanentAddress, permanentCity, permanentState, permanentPincode].forEach(field => {
            field.addEventListener('input', syncCurrentAddress);
        });
        if (sameAddress) sameAddress.addEventListener('change', syncCurrentAddress);
        if (transportRequired) transportRequired.addEventListener('change', syncTransport);
        if (hostelRequired) hostelRequired.addEventListener('change', syncHostel);
        syncCurrentAddress();
        syncTransport();
        syncHostel();
    });
</script>