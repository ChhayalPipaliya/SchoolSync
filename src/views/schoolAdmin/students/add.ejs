<%- include('../../partials/head', { title: `${lan.Add_New_Student || 'Add New Student'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <style>
              .add-student-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                margin-bottom: 24px;
                flex-wrap: wrap;
              }
              .add-student-title {
                font-size: 22px;
                font-weight: 800;
                color: var(--text-primary, #1E293B);
                margin: 0;
                line-height: 1.2;
              }
              .add-student-subtitle {
                font-size: 12px;
                color: var(--text-muted);
                margin: 4px 0 0;
              }
              @media (max-width: 640px) {
                .add-student-header {
                  flex-direction: column;
                  align-items: flex-start;
                }
                .add-student-header .btn {
                  width: 100%;
                  justify-content: center;
                }
                .add-student-title { font-size: 20px; }
                .grid.grid-cols-1.md\:grid-cols-4 {
                  grid-template-columns: repeat(2, 1fr) !important;
                }
              }
              @media (max-width: 420px) {
                .grid.grid-cols-1.md\:grid-cols-4 {
                  grid-template-columns: 1fr !important;
                }
              }
            </style>
            <div class="add-student-header">
                <div>
                    <h2 class="add-student-title"><%- lan.Add_New_Student || 'Add New Student' %></h2>
                    <p class="add-student-subtitle"><%- lan.Add_Student_Subtitle || 'Register a new student profile in the school system' %></p>
                </div>
                <a href="/schooladmin/students" class="btn btn-secondary text-xs flex items-center gap-1">
                    <i class="fas fa-arrow-left"></i> <%- lan.Back_To_List || 'Back to List' %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <form action="/schooladmin/students/add" method="POST" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-user me-2"></i><%- lan.Basic_Academic_Details || 'Basic / Academic Details' %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.First_Name || 'First Name' %> <span class="text-danger">*</span></label>
                            <input type="text" name="first_name" required value="<%= old.first_name || '' %>" class="form-input" placeholder="<%- lan.Enter_First_Name || 'Enter first name' %>">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Last_Name || 'Last Name' %> <span class="text-danger">*</span></label>
                            <input type="text" name="last_name" required value="<%= old.last_name || '' %>" class="form-input" placeholder="<%- lan.Enter_Last_Name || 'Enter last name' %>">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Email || 'Email' %></label>
                            <input type="email" name="email" value="<%= old.email || '' %>" class="form-input" placeholder="student@example.com">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Phone || 'Phone' %> <span class="text-danger">*</span></label>
                            <input type="tel" name="phone" required maxlength="10" value="<%= old.phone || '' %>" class="form-input" placeholder="98765 43210">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Password || 'Password' %> <span class="text-danger">*</span></label>
                            <input type="password" name="password" required class="form-input" placeholder="********">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Date_Of_Birth || 'Date of Birth' %> <span class="text-danger">*</span></label>
                            <input type="date" name="dob" required value="<%= old.dob || '' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Standard || 'Standard' %> <span class="text-danger">*</span></label>
                            <input type="text" name="standard" id="standard" required value="<%= old.standard || '' %>" placeholder="<%- lan.Enter_Standard_Placeholder || 'Enter standard e.g. Nursery, LKG, UKG, Class 1, Class 10' %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Gender || 'Gender' %> <span class="text-danger">*</span></label>
                            <select name="gender" required class="form-select">
                                <option value=""><%- lan.Select_Gender || 'Select Gender' %></option>
                                <option value="male" <%=old.gender==='male' ? 'selected' : '' %>><%- lan.Male || 'Male' %></option>
                                <option value="female" <%=old.gender==='female' ? 'selected' : '' %>><%- lan.Female || 'Female' %></option>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Blood_Group || 'Blood Group' %></label>
                            <select name="blood_group" class="form-select">
                                <option value=""><%- lan.Select_Blood_Group || 'Select Blood Group' %></option>
                                <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(bg=> { %>
                                    <option value="<%= bg %>" <%=old.blood_group===bg ? 'selected': '' %>><%= bg %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Aadhaar_No || 'Aadhaar No' %></label>
                            <input type="text" name="aadhaar_no" maxlength="12" value="<%= old.aadhaar_no || '' %>" class="form-input" placeholder="1234 5678 9012">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Religion || 'Religion' %></label>
                            <input type="text" name="religion" value="<%= old.religion || '' %>" class="form-input" placeholder="Hindu / Muslim / Christian">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Category || 'Category' %></label>
                            <select name="category" class="form-select">
                                <option value=""><%- lan.Select_Category || 'Select Category' %></option>
                                <% ['General','OBC','SC','ST'].forEach(cat=> { %>
                                    <option value="<%= cat %>" <%=old.category===cat ? 'selected' : '' %>><%= cat %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="form-group mt-4">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Medical_Notes || 'Medical Notes' %></label>
                        <textarea name="medical_notes" rows="3" class="form-textarea" placeholder="<%- lan.Medical_Notes_Placeholder || 'Any medical condition, allergy, etc. (optional)' %>"><%= old.medical_notes || '' %></textarea>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-people-roof me-2"></i><%- lan.Family_Details || 'Family Details' %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Fathers_Name || "Father's Name" %></label>
                            <input type="text" name="father_name" value="<%= old.father_name || '' %>" class="form-input" placeholder="<%- lan.Enter_Fathers_Name || "Enter father's full name" %>">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Fathers_Phone || "Father's Phone" %></label>
                            <input type="tel" name="father_phone" value="<%= old.father_phone || '' %>" class="form-input" placeholder="98765 43210">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Fathers_Email || "Father's Email" %></label>
                            <input type="email" name="father_email" value="<%= old.father_email || '' %>" class="form-input" placeholder="father@example.com">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Fathers_Occupation || "Father's Occupation" %></label>
                            <input type="text" name="father_occupation" value="<%= old.father_occupation || '' %>" class="form-input" placeholder="Business / Teacher / Doctor">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mothers_Name || "Mother's Name" %></label>
                            <input type="text" name="mother_name" value="<%= old.mother_name || '' %>" class="form-input" placeholder="<%- lan.Enter_Mothers_Name || "Enter mother's full name" %>">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mothers_Phone || "Mother's Phone" %></label>
                            <input type="tel" name="mother_phone" value="<%= old.mother_phone || '' %>" class="form-input" placeholder="98765 43210">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mothers_Email || "Mother's Email" %></label>
                            <input type="email" name="mother_email" value="<%= old.mother_email || '' %>" class="form-input" placeholder="mother@example.com">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mothers_Occupation || "Mother's Occupation" %></label>
                            <input type="text" name="mother_occupation" value="<%= old.mother_occupation || '' %>" class="form-input" placeholder="Housewife / Teacher / Engineer">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Guardian_Name || 'Guardian Name' %></label>
                            <input type="text" name="guardian_name" value="<%= old.guardian_name || '' %>" class="form-input" placeholder="<%- lan.Enter_Guardian_Name || 'Guardian full name' %>">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Relation || 'Relation' %></label>
                            <input type="text" name="guardian_relation" value="<%= old.guardian_relation || '' %>" class="form-input" placeholder="Uncle / Aunt / Grandfather">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Guardian_Phone || 'Guardian Phone' %></label>
                            <input type="tel" name="guardian_phone" value="<%= old.guardian_phone || '' %>" class="form-input" placeholder="98765 43210">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Guardian_Occupation || 'Guardian Occupation' %></label>
                            <input type="text" name="guardian_occupation" value="<%= old.guardian_occupation || '' %>" class="form-input" placeholder="Occupation">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Guardian_Aadhaar || 'Guardian Aadhaar' %></label>
                            <input type="text" name="guardian_aadhaar" maxlength="12" value="<%= old.guardian_aadhaar || '' %>" class="form-input" placeholder="123456789012">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-map-location-dot me-2"></i><%- lan.Address_Details || 'Address Details' %>
                    </h3>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Permanent_Address || 'Permanent Address' %></label>
                        <textarea name="permanent_address" rows="3" class="form-textarea" placeholder="House no, Street, Area..."><%= old.permanent_address || '' %></textarea>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.City || 'City' %></label>
                            <input type="text" name="permanent_city" value="<%= old.permanent_city || '' %>" class="form-input" placeholder="Ahmedabad / Surat / Vadodara">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.State || 'State' %></label>
                            <input type="text" name="permanent_state" value="<%= old.permanent_state || '' %>" class="form-input" placeholder="Gujarat">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Pincode || 'Pincode' %></label>
                            <input type="text" name="permanent_pincode" value="<%= old.permanent_pincode || '' %>" class="form-input" placeholder="380015">
                        </div>
                    </div>
                    <div class="mt-4 flex items-center">
                        <label class="inline-flex items-center text-sm text-gray-700 cursor-pointer">
                            <input type="checkbox" name="current_address_same" class="rounded border-gray-300 mr-2 w-4 h-4 accent-[var(--primary)]" value="1" <%=old.current_address_same ? 'checked' : '' %>> <%- lan.Same_As_Permanent_Address || 'Same as permanent address' %>
                        </label>
                    </div>
                    <div id="currentAddressFields" class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                        <div class="form-group mb-0 md:col-span-3">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Current_Address || 'Current Address' %></label>
                            <textarea name="current_address" rows="3" class="form-textarea" placeholder="House no, Street, Area..."><%= old.current_address || '' %></textarea>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Current_City || 'Current City' %></label>
                            <input type="text" name="current_city" value="<%= old.current_city || '' %>" class="form-input" placeholder="Ahmedabad / Surat / Vadodara">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Current_State || 'Current State' %></label>
                            <input type="text" name="current_state" value="<%= old.current_state || '' %>" class="form-input" placeholder="Gujarat">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Current_Pincode || 'Current Pincode' %></label>
                            <input type="text" name="current_pincode" value="<%= old.current_pincode || '' %>" class="form-input" placeholder="380015">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-bus me-2"></i><%- lan.Transport_Details || 'Transport Details' %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Transport_Required || 'Transport Required' %></label>
                            <select name="transport_required" class="form-select">
                                <option value="0" <%= old.transport_required === '0' || !old.transport_required ? 'selected' : '' %>><%- lan.No || 'No' %></option>
                                <option value="1" <%= old.transport_required === '1' ? 'selected' : '' %>><%- lan.Yes || 'Yes' %></option>
                            </select>
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Transport_Mode || 'Transport Mode' %></label>
                            <select name="transport_mode" class="form-select">
                                <option value=""><%- lan.Select_Mode || 'Select Mode' %></option>
                                <option value="School Bus" <%=old.transport_mode==='School Bus' ? 'selected' : '' %>><%- lan.School_Bus || 'School Bus' %></option>
                                <option value="Private" <%=old.transport_mode==='Private' ? 'selected' : '' %>><%- lan.Private || 'Private' %></option>
                                <option value="Self" <%=old.transport_mode==='Self' ? 'selected' : '' %>><%- lan.Self || 'Self' %></option>
                                <option value="Other" <%=old.transport_mode==='Other' ? 'selected' : '' %>><%- lan.Other || 'Other' %></option>
                            </select>
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Route || 'Route' %></label>
                            <input type="text" name="transport_route" value="<%= old.transport_route || '' %>" class="form-input" placeholder="Route No / Area">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Vehicle_No || 'Vehicle No' %></label>
                            <input type="text" name="transport_vehicle_no" value="<%= old.transport_vehicle_no || '' %>" class="form-input" placeholder="GJ-01-AB-1234">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Pickup_Latitude || 'Pickup Latitude' %></label>
                            <input type="text" name="pickup_latitude" value="<%= old.pickup_latitude || '' %>" class="form-input" placeholder="23.0225">
                        </div>
                        <div class="form-group mb-0 transport-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Pickup_Longitude || 'Pickup Longitude' %></label>
                            <input type="text" name="pickup_longitude" value="<%= old.pickup_longitude || '' %>" class="form-input" placeholder="72.5714">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-building-user me-2"></i><%- lan.Hostel_Details || 'Hostel Details' %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Hostel_Required || 'Hostel Required' %></label>
                            <select name="hostel_required" class="form-select">
                                <option value="0" <%= old.hostel_required === '0' || !old.hostel_required ? 'selected' : '' %>><%- lan.No || 'No' %></option>
                                <option value="1" <%= old.hostel_required === '1' ? 'selected' : '' %>><%- lan.Yes || 'Yes' %></option>
                            </select>
                        </div>
                        <div class="form-group mb-0 hostel-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Hostel_Name || 'Hostel Name' %></label>
                            <input type="text" name="hostel_name" value="<%= old.hostel_name || '' %>" class="form-input" placeholder="Hostel Name">
                        </div>
                        <div class="form-group mb-0 hostel-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Room_No || 'Room No' %></label>
                            <input type="text" name="hostel_room_no" value="<%= old.hostel_room_no || '' %>" class="form-input" placeholder="Room No">
                        </div>
                        <div class="form-group mb-0 hostel-detail">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Hostel_Phone || 'Hostel Phone' %></label>
                            <input type="tel" name="hostel_phone_number" value="<%= old.hostel_phone_number || '' %>" class="form-input" placeholder="Hostel Phone">
                        </div>
                    </div>
                </div>
                <div class="card p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                        <i class="fa-solid fa-file-pdf me-2"></i><%- lan.Documents_Upload || 'Documents Upload' %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Student_Photo || 'Student Photo' %></label>
                            <input type="file" name="student_image" accept=".jpg,.jpeg,.png,.webp" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Father_Photo || 'Father Photo' %></label>
                            <input type="file" name="father_image" accept=".jpg,.jpeg,.png,.webp" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Mother_Photo || 'Mother Photo' %></label>
                            <input type="file" name="mother_image" accept=".jpg,.jpeg,.png,.webp" class="form-input">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Birth_Certificate || 'Birth Certificate' %></label>
                            <input type="file" name="birth_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Aadhaar_Card || 'Aadhaar Card' %></label>
                            <input type="file" name="aadhaar_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Leaving_Certificate || 'Leaving Certificate' %></label>
                            <input type="file" name="leaving_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Previous_Marksheet || 'Previous Marksheet' %></label>
                            <input type="file" name="previous_marksheet" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                    </div>
                </div>
                <div class="flex gap-4 pt-4">
                    <button type="submit" class="btn btn-primary px-8 py-3">
                        <i class="fa-solid fa-floppy-disk me-2"></i> <%- lan.Save_Student || 'Save Student' %>
                    </button>
                    <a href="/schooladmin/students" class="btn btn-secondary px-8 py-3"><%- lan.Cancel || 'Cancel' %></a>
                </div>
            </form>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sameAddress = document.querySelector('[name="current_address_same"]');
            const permanentAddress = document.querySelector('[name="permanent_address"]');
            const permanentCity = document.querySelector('[name="permanent_city"]');
            const permanentState = document.querySelector('[name="permanent_state"]');
            const permanentPincode = document.querySelector('[name="permanent_pincode"]');
            const currentAddress = document.querySelector('[name="current_address"]');
            const currentCity = document.querySelector('[name="current_city"]');
            const currentState = document.querySelector('[name="current_state"]');
            const currentPincode = document.querySelector('[name="current_pincode"]');
            const currentFields = [currentAddress, currentCity, currentState, currentPincode];
            const transportRequired = document.querySelector('[name="transport_required"]');
            const transportDetails = document.querySelectorAll('.transport-detail');
            const hostelRequired = document.querySelector('[name="hostel_required"]');
            const hostelDetails = document.querySelectorAll('.hostel-detail');

            function syncCurrentAddress() {
                if (sameAddress.checked) {
                    currentAddress.value = permanentAddress.value;
                    currentCity.value = permanentCity.value;
                    currentState.value = permanentState.value;
                    currentPincode.value = permanentPincode.value;
                }
                currentFields.forEach(field => field.disabled = sameAddress.checked);
            }

            function syncTransport() {
                const enabled = transportRequired.value === '1';
                transportDetails.forEach(group => {
                    group.style.display = enabled ? '' : 'none';
                    group.querySelectorAll('input, select').forEach(field => field.disabled = !enabled);
                });
            }

            function syncHostel() {
                const enabled = hostelRequired.value === '1';
                hostelDetails.forEach(group => {
                    group.style.display = enabled ? '' : 'none';
                    group.querySelectorAll('input').forEach(field => {
                        field.disabled = !enabled;
                        field.required = enabled;
                    });
                });
            }

            [permanentAddress, permanentCity, permanentState, permanentPincode].forEach(field => {
                field.addEventListener('input', syncCurrentAddress);
            });
            sameAddress.addEventListener('change', syncCurrentAddress);
            transportRequired.addEventListener('change', syncTransport);
            hostelRequired.addEventListener('change', syncHostel);
            syncCurrentAddress();
            syncTransport();
            syncHostel();
        });
    </script>
</div>
<%- include('../../partials/footer') %>