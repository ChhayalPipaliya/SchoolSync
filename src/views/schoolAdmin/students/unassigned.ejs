<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">

      <style>
        .page-hero {
          display: flex;
          align-items: center;
          justify-content: space-between;
          margin-bottom: 24px;
          flex-wrap: wrap;
          gap: 12px;
        }
        .hero-left h2 { font-size: 22px; font-weight: 800; color: var(--text-primary); margin: 0; }
        .hero-left p  { font-size: 12px; color: var(--text-muted); margin: 4px 0 0; }
        .badge-count {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          background: linear-gradient(135deg, #f97316, #ef4444);
          color: white;
          font-size: 11px;
          font-weight: 800;
          border-radius: 20px;
          padding: 3px 10px;
          margin-left: 8px;
        }
        .filter-bar {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 14px;
          padding: 18px 22px;
          margin-bottom: 22px;
          display: flex;
          gap: 14px;
          align-items: flex-end;
          flex-wrap: wrap;
        }
        .filter-bar .filter-field { flex: 1; min-width: 160px; }
        .filter-bar label { font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.7px; display: block; margin-bottom: 6px; }
        .assign-table { width: 100%; border-collapse: collapse; }
        .assign-table th {
          padding: 11px 14px;
          text-align: left;
          font-size: 10px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.7px;
          color: var(--text-muted);
          background: var(--surface-hover);
          border-bottom: 1px solid var(--border);
        }
        .assign-table td {
          padding: 13px 14px;
          border-bottom: 1px solid var(--border);
          vertical-align: middle;
          font-size: 13px;
          color: var(--text-primary);
        }
        .assign-table tr:last-child td { border-bottom: none; }
        .assign-table tr:hover td { background: var(--surface-hover); }
        .student-cell { display: flex; align-items: center; gap: 10px; }
        .student-avatar {
          width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
          display: flex; align-items: center; justify-content: center;
          font-weight: 800; font-size: 14px; color: white;
          background: linear-gradient(135deg, #667eea, #764ba2);
        }
        .student-avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
        .student-name { font-weight: 700; font-size: 13.5px; }
        .student-email { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
        .std-pill {
          display: inline-block;
          background: #ede9fe;
          color: #7c3aed;
          border: 1.5px solid #c4b5fd;
          font-size: 11px;
          font-weight: 700;
          border-radius: 20px;
          padding: 2px 10px;
        }
        .std-pill.empty { background: #f1f5f9; color: #94a3b8; border-color: #e2e8f0; }
        .assign-form-row {
          display: flex;
          gap: 8px;
          align-items: center;
          flex-wrap: nowrap;
        }
        @media (max-width: 640px) {
          .assign-form-row {
            flex-wrap: wrap;
          }
          .assign-form-row select {
            flex: 1;
            min-width: 120px;
          }
          .assign-form-row input[type="text"] {
            width: 70px;
          }
          .assign-form-row .btn-assign {
            width: 100%;
            justify-content: center;
          }
        }
        .assign-form-row select,
        .assign-form-row input[type="text"] {
          border: 1.5px solid var(--border);
          border-radius: 8px;
          padding: 7px 10px;
          font-size: 12px;
          background: var(--surface);
          color: var(--text-primary);
          outline: none;
          transition: border-color 0.2s;
        }
        .assign-form-row select { min-width: 160px; }
        .assign-form-row input[type="text"] { width: 80px; }
        .assign-form-row select:focus,
        .assign-form-row input:focus { border-color: #667eea; }
        .btn-assign {
          background: linear-gradient(135deg, #667eea, #764ba2);
          color: white;
          border: none;
          border-radius: 8px;
          padding: 7px 16px;
          font-size: 12px;
          font-weight: 700;
          cursor: pointer;
          white-space: nowrap;
          transition: all 0.2s;
          display: flex;
          align-items: center;
          gap: 5px;
        }
        .btn-assign:hover { opacity: 0.88; transform: translateY(-1px); }
        .empty-state-box {
          text-align: center;
          padding: 60px 20px;
          color: var(--text-muted);
        }
        .empty-state-box i { font-size: 48px; color: #a3e635; margin-bottom: 16px; display: block; }
        .empty-state-box h3 { font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
        .empty-state-box p { font-size: 13px; }
        .section-heading {
          font-size: 11px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.8px;
          color: var(--text-muted);
          padding: 10px 14px;
          background: linear-gradient(to right, #f8fafc, var(--surface));
          border-bottom: 1px solid var(--border);
          display: flex;
          align-items: center;
          gap: 6px;
        }
        .section-heading i { color: #7c3aed; }
      </style>

      <%- include('../../partials/flashMessages') %>

      <!-- Hero -->
      <div class="page-hero">
        <div class="hero-left">
          <h2>
            <i class="fas fa-user-clock" style="color:#7c3aed;margin-right:8px;"></i>
            Unassigned Students
            <span class="badge-count"><%= unassignedCount %></span>
          </h2>
          <p>Students admitted but not yet assigned to a class/section. Assign them below.</p>
        </div>
        <a href="/schooladmin/students" class="btn btn-secondary btn-sm">
          <i class="fas fa-arrow-left"></i> All Students
        </a>
      </div>

      <!-- Filter Bar -->
      <form method="GET" action="/schooladmin/students/unassigned" class="filter-bar">
        <div class="filter-field">
          <label>Search</label>
          <input type="text" name="search" value="<%= search %>" placeholder="Name, admission no..." class="form-input" style="height:38px;">
        </div>
        <div class="filter-field" style="flex:0 0 160px;">
          <label>Standard</label>
          <select name="standard" class="form-select" style="height:38px;">
            <option value="">All Standards</option>
            <% standards.forEach(s => { %>
              <option value="<%= s.standard %>" <%= stdFilter === s.standard ? 'selected' : '' %>><%= s.standard %></option>
            <% }) %>
          </select>
        </div>
        <div style="display:flex;gap:8px;align-items:flex-end;">
          <button type="submit" class="btn btn-primary btn-sm" style="height:38px;">
            <i class="fas fa-filter"></i> Filter
          </button>
          <a href="/schooladmin/students/unassigned" class="btn btn-secondary btn-sm" style="height:38px;">Reset</a>
        </div>
      </form>

      <!-- Table Card -->
      <div class="table-card">
        <div class="table-header-row" style="display:flex;align-items:center;justify-content:space-between;">
          <h3 class="table-heading">
            <i class="fas fa-list-check" style="margin-right:6px;color:#7c3aed;"></i>
            Pending Class Assignment
          </h3>
          <span style="font-size:12px;color:var(--text-muted);">
            Select class & roll number for each student, then click Assign
          </span>
        </div>

        <div class="table-container">
          <% if (!students || students.length === 0) { %>
            <div class="empty-state-box">
              <i class="fas fa-check-circle" style="color:#22c55e;"></i>
              <h3>All students are assigned!</h3>
              <p>No students are pending class assignment right now.</p>
              <a href="/schooladmin/students/add" class="btn btn-primary btn-sm mt-4">
                <i class="fas fa-plus"></i> Add New Student
              </a>
            </div>
          <% } else { %>
            <%
              // Group students by standard
              const grouped = {};
              students.forEach(s => {
                const key = s.standard || 'No Standard';
                if (!grouped[key]) grouped[key] = [];
                grouped[key].push(s);
              });
              const sortedKeys = Object.keys(grouped).sort((a,b) => {
                if (a === 'No Standard') return 1;
                if (b === 'No Standard') return -1;
                return a.localeCompare(b, undefined, { numeric: true });
              });
            %>

            <table class="assign-table">
              <thead>
                <tr>
                  <th style="width:34%;">Student</th>
                  <th>Std.</th>
                  <th>Adm. No</th>
                  <th>Adm. Date</th>
                  <th>Father / Phone</th>
                  <th style="width:36%;">Assign Class & Roll</th>
                </tr>
              </thead>
              <tbody>
                <% sortedKeys.forEach(stdKey => { %>
                  <tr>
                    <td colspan="6" class="section-heading">
                      <i class="fas fa-layer-group"></i>
                      Standard: <%= stdKey %>
                      <span style="margin-left:8px;font-weight:400;color:var(--text-muted);">(<%= grouped[stdKey].length %> student<%= grouped[stdKey].length > 1 ? 's' : '' %>)</span>
                    </td>
                  </tr>
                  <% grouped[stdKey].forEach(s => { %>
                    <tr>
                      <!-- Student Info -->
                      <td>
                        <div class="student-cell">
                          <div class="student-avatar">
                            <% if (s.image) { %>
                              <img src="<%= s.image %>" alt="">
                            <% } else { %>
                              <%= (s.first_name || '?').charAt(0).toUpperCase() %>
                            <% } %>
                          </div>
                          <div>
                            <div class="student-name"><%= s.first_name %> <%= s.last_name %></div>
                            <div class="student-email"><%= s.email || '' %></div>
                          </div>
                        </div>
                      </td>

                      <!-- Standard -->
                      <td>
                        <% if (s.standard) { %>
                          <span class="std-pill"><%= s.standard %></span>
                        <% } else { %>
                          <span class="std-pill empty">—</span>
                        <% } %>
                      </td>

                      <!-- Admission No -->
                      <td>
                        <span style="font-size:12px;font-weight:600;font-family:monospace;color:#667eea;">
                          <%= s.admission_no %>
                        </span>
                      </td>

                      <!-- Admission Date -->
                      <td style="font-size:12px;color:var(--text-muted);">
                        <%= s.admission_date ? new Date(s.admission_date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %>
                      </td>

                      <!-- Father / Phone -->
                      <td>
                        <div style="font-weight:600;font-size:12px;"><%= s.father_name || '—' %></div>
                        <div style="font-size:11px;color:var(--text-muted);"><%= s.father_phone || '' %></div>
                      </td>

                      <!-- Assign Form -->
                      <td>
                        <form method="POST" action="/schooladmin/students/<%= s.id %>/assign-class" id="assignForm_<%= s.id %>">
                          <div class="assign-form-row">
                            <select name="class_id" required
                              onchange="filterByStandard(this, '<%= (s.standard||'').replace(/'/g, '\\\'') %>')"
                              id="classSelect_<%= s.id %>">
                              <option value="">— Select Class —</option>
                              <% classes.forEach(cls => {
                                const clsLabel = cls.class_name + (cls.section ? ' - ' + cls.section : '');
                                const stdMatch = s.standard && cls.class_name.toLowerCase().includes((s.standard+'').toLowerCase());
                              %>
                                <option value="<%= cls.id %>"
                                  data-class="<%= cls.class_name %>"
                                  class="class-option-<%= s.id %>"
                                  style="<%= stdMatch ? '' : 'color:#94a3b8;' %>"
                                  <%= stdMatch ? '' : '' %>>
                                  <%= clsLabel %> <%= stdMatch ? '✓' : '' %>
                                </option>
                              <% }) %>
                            </select>
                            <input type="text" name="roll_no" placeholder="Roll No"
                              title="Roll Number (optional)">
                            <button type="submit" class="btn-assign"
                              onclick="return confirm('Assign class to <%= (s.first_name+' '+s.last_name).replace(/'/g,'\\\'') %>?')">
                              <i class="fas fa-check"></i> Assign
                            </button>
                          </div>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>

    </div>
    <%- include('../../partials/footer') %>
  </div>
</div>

<script>
// Highlight matching classes when page loads
document.addEventListener('DOMContentLoaded', () => {
    // Move matched options to top of each select
    document.querySelectorAll('select[id^="classSelect_"]').forEach(sel => {
        const options = Array.from(sel.querySelectorAll('option[value]'));
        const matched = options.filter(o => o.textContent.includes('✓'));
        const unmatched = options.filter(o => !o.textContent.includes('✓'));
        // Rebuild: placeholder + matched + divider + unmatched
        while (sel.children.length > 1) sel.removeChild(sel.lastChild);
        if (matched.length) {
            const grpMatch = document.createElement('optgroup');
            grpMatch.label = '— Suggested (same standard) —';
            matched.forEach(o => grpMatch.appendChild(o));
            sel.appendChild(grpMatch);
        }
        if (unmatched.length) {
            const grpOther = document.createElement('optgroup');
            grpOther.label = '— All Classes —';
            unmatched.forEach(o => grpOther.appendChild(o));
            sel.appendChild(grpOther);
        }
    });
});
</script>
