<%- include('../../partials/head', { title: `${lan.Student_Profile || 'Student Profile'} | SchoolSync` }) %>
<%
    let profileImg = '/images/default-avatar.png';
    if(student.photo) {
        profileImg = student.photo.startsWith('/uploads/') ? student.photo : '/uploads/students/' + student.photo;
    }
%>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Student_Profile || 'Student Profile' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Student_Profile_Subtitle || "Detailed view of the student's records" %></p>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <a href="/schooladmin/students" class="btn btn-secondary text-xs flex items-center gap-1.5 shadow-xs">
                        <i class="fa-solid fa-arrow-left text-slate-500"></i> <%- lan.Back || 'Back' %>
                    </a>
                    <a href="/schooladmin/students/<%= student.id %>/id-card" target="_blank" class="btn btn-secondary text-xs flex items-center gap-1.5 shadow-xs">
                        <i class="fa-solid fa-id-card text-slate-500"></i> <%- lan.ID_Card || 'ID Card' %>
                    </a>
                    <a href="/schooladmin/students/<%= student.id %>/edit" class="btn btn-primary text-xs flex items-center gap-1.5 shadow-xs">
                        <i class="fa-solid fa-pen-to-square"></i> <%- lan.Edit_Profile || 'Edit Profile' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-1 space-y-6">
                    <div class="card p-6 text-center">
                        <img src="<%= profileImg %>" class="w-32 h-32 rounded-full mx-auto mb-4 object-cover border border-slate-100 shadow-sm" style="width: 128px; height: 128px; border-radius: 50%; object-fit: cover;">
                        <h3 class="text-xl font-bold text-gray-800">
                            <%= student.first_name %> <%= student.last_name %>
                        </h3>
                        <p class="text-xs text-gray-500 mt-1">
                            <%= student.class_name %> <%= student.section_name ? '- ' + student.section_name : '' %>
                        </p>
                        <p class="text-[11px] text-gray-400 mt-1"><%- lan.Roll_No || 'Roll No' %>: <%= student.roll_number || '—' %></p>
                        <div class="mt-4 flex justify-center">
                            <span class="badge badge-<%= student.status === 'active' ? 'success' : 'danger' %> capitalize">
                                <%= student.status %>
                            </span>
                        </div>
                    </div>
                    <div class="card p-6">
                        <h4 class="font-bold text-gray-700 text-sm mb-4"><%- lan.Attendance_Stats || 'Attendance Stats' %></h4>
                        <div class="space-y-4">
                            <div class="flex justify-between text-xs text-gray-500">
                                <span><%- lan.Total_Days || 'Total Days' %></span>
                                <span class="font-bold text-gray-800"><%= (typeof attendance !== 'undefined' && attendance) ? (attendance.total_days || 0) : 0 %></span>
                            </div>
                            <div class="flex justify-between text-xs text-gray-500">
                                <span style="color: var(--primary);"><%- lan.Present_Days || 'Present Days' %></span>
                                <span class="font-bold" style="color: var(--primary);"><%= (typeof attendance !== 'undefined' && attendance) ? (attendance.present_days || 0) : 0 %></span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <% 
                                    let attendancePct = '0';
                                    if (typeof attendance !== 'undefined' && attendance && attendance.total_days > 0) {
                                        attendancePct = (attendance.present_days / attendance.total_days * 100).toFixed(1);
                                    }
                                %>
                                <div id="studentAttendanceBar" class="h-full rounded-full bg-emerald-600 transition-all duration-500" style="width: 0%;"></div>
                            </div>
                            <p class="text-center text-lg font-bold text-gray-800"><%= attendancePct %>%</p>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-2 space-y-6">
                    <div class="card p-6">
                        <h4 class="font-bold text-gray-700 text-sm mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                            <i class="fa-solid fa-user me-2"></i><%- lan.Personal_Details || 'Personal Details' %>
                        </h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-6 text-sm">
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Admission_No || 'Admission No' %></span>
                                <span class="font-bold text-gray-800"><%= student.admission_number || student.admission_no %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Gender || 'Gender' %></span>
                                <span class="font-bold text-gray-800 capitalize"><%= student.gender || '—' %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Date_Of_Birth || 'Date of Birth' %></span>
                                <span class="font-bold text-gray-800"><%= student.dob ? new Date(student.dob).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '—' %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Blood_Group || 'Blood Group' %></span>
                                <span class="font-bold text-gray-800"><%= student.blood_group || '—' %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Aadhaar_Card_No || 'Aadhaar Card No' %></span>
                                <span class="font-bold text-gray-800"><%= student.aadhaar_number || student.aadhaar_no || '—' %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Category || 'Category' %></span>
                                <span class="font-bold text-gray-800 capitalize"><%= student.category || '—' %></span>
                            </div>
                        </div>
                    </div>
                    <div class="card p-6">
                        <h4 class="font-bold text-gray-700 text-sm mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                            <i class="fa-solid fa-people-roof me-2"></i><%- lan.Parent_Details || 'Parent Details' %>
                        </h4>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-6 text-sm">
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Fathers_Name || "Father's Name" %></span>
                                <span class="font-bold text-gray-800"><%= student.father_name || '—' %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Fathers_Phone || "Father's Phone" %></span>
                                <span class="font-bold text-gray-800"><%= student.father_phone || '—' %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Mothers_Name || "Mother's Name" %></span>
                                <span class="font-bold text-gray-800"><%= student.mother_name || '—' %></span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-400 block font-semibold uppercase tracking-wider"><%- lan.Mothers_Phone || "Mother's Phone" %></span>
                                <span class="font-bold text-gray-800"><%= student.mother_phone || '—' %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-card mt-6">
                <div class="table-header-row">
                    <h3 class="table-heading"><%- lan.Fee_Status || 'Fee Status' %></h3>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th><%- lan.Fee_Name || 'Fee Name' %></th>
                                <th class="text-center"><%- lan.Amount || 'Amount' %></th>
                                <th class="text-center"><%- lan.Status || 'Status' %></th>
                                <th class="text-center"><%- lan.Due_Date || 'Due Date' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(!fees || fees.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center py-4">
                                        <div class="empty-state">
                                            <div class="empty-state-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
                                            <h4 class="empty-state-title"><%- lan.No_Fee_Records || 'No fee records' %></h4>
                                            <p class="empty-state-text"><%- lan.No_Fee_Assigned_Student || 'No fee items assigned to this student' %></p>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% fees.forEach(f=> { %>
                                    <tr>
                                        <td><strong><%= f.fee_name %></strong></td>
                                        <td class="text-center">₹<%= f.total_amount %></td>
                                        <td class="text-center">
                                            <span class="badge badge-<%= f.status === 'paid' ? 'success' : 'danger' %> capitalize">
                                                <%= f.status %>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <%= f.due_date ? new Date(f.due_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '—' %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<script>
    (function() {
        const bar = document.getElementById('studentAttendanceBar');
        if (bar) bar.style.width = '<%= attendancePct %>%';
    })();
</script>