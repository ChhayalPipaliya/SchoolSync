<style>
    .page-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .hero-left h2 { font-size: 22px; font-weight: 800; color: var(--text-primary); margin: 0; }
    .hero-left p  { font-size: 12px; color: var(--text-muted); margin: 4px 0 0; }
    .filter-bar {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 22px;
        display: flex;
        gap: 14px;
        align-items: flex-end;
        flex-wrap: wrap;
    }
    .filter-bar .filter-field { flex: 1; min-width: 200px; }
    .filter-bar label { font-size: 10px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.7px; display: block; margin-bottom: 6px; }
    .assign-table { width: 100%; border-collapse: collapse; }
    .assign-table th {
        padding: 11px 14px;
        text-align: left;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: var(--text-muted);
        background: var(--surface-hover);
        border-bottom: 1px solid var(--border);
    }
    .assign-table td {
        padding: 13px 14px;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
        font-size: 13px;
        color: var(--text-primary);
    }
    .assign-table tr:last-child td { border-bottom: none; }
    .assign-table tr:hover td { background: var(--surface-hover); }
    .student-cell { display: flex; align-items: center; gap: 10px; }
    .student-name { font-weight: 700; font-size: 13.5px; }
    .roll-input {
        border: 1.5px solid var(--border);
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 12px;
        background: var(--surface);
        color: var(--text-primary);
        outline: none;
        width: 100px;
        transition: border-color 0.2s;
    }
    .roll-input:focus { border-color: #667eea; }
    .empty-state-box {
        text-align: center;
        padding: 60px 20px;
        color: var(--text-muted);
    }
    .empty-state-box i { font-size: 48px; color: #7c3aed; margin-bottom: 16px; display: block; }
    .empty-state-box h3 { font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
    .empty-state-box p { font-size: 13px; }
</style>
<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <%- include('../../partials/flashMessages') %>
            <div class="page-hero">
                <div class="hero-left">
                    <h2><i class="fas fa-list-ol" style="color:#7c3aed;margin-right:8px;"></i>Assign Roll Numbers</h2>
                    <p>Select a class and bulk-assign roll numbers for active students.</p>
                </div>
                <a href="/schooladmin/students" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> All Students</a>
            </div>
            <form method="GET" action="/schooladmin/students/roll-assignment" class="filter-bar">
                <div class="filter-field">
                    <label>Select Class</label>
                    <select name="class_id" class="form-select" style="height:38px;" onchange="this.form.submit()">
                        <option value="">— Select a Class —</option>
                        <% classes.forEach(cls => { %>
                            <option value="<%= cls.id %>" <%= String(selectedClassId) === String(cls.id) ? 'selected' : '' %>>
                                <%= cls.display_name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
            </form>
            <% if (!selectedClassId) { %>
                <div class="table-card">
                    <div class="empty-state-box">
                        <i class="fas fa-chalkboard"></i>
                        <h3>Please select a class</h3>
                        <p>Choose a class from the dropdown above to view and assign roll numbers.</p>
                    </div>
                </div>
            <% } else { %>
                <form method="POST" action="/schooladmin/students/roll-assignment">
                    <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                    <div class="table-card">
                        <div class="table-header-row" style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border);">
                            <h3 class="table-heading" style="margin:0;">
                                <i class="fas fa-users" style="margin-right:6px;color:#7c3aed;"></i>
                                Student Roll Numbers (<%= students.length %>)
                            </h3>
                            <% if (students && students.length > 0) { %>
                                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-save"></i> Save Roll Numbers</button>
                            <% } %>
                        </div>
                        <div class="table-container">
                            <% if (!students || students.length === 0) { %>
                                <div class="empty-state-box">
                                    <i class="fas fa-user-slash" style="color:#94a3b8;"></i>
                                    <h3>No Active Students Found</h3>
                                    <p>There are no active students assigned to this class.</p>
                                </div>
                            <% } else { %>
                                <table class="assign-table">
                                    <thead>
                                        <tr>
                                            <th style="width:40%;">Student Name</th>
                                            <th style="width:30%;">Admission No</th>
                                            <th style="width:30%;">Roll Number</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% students.forEach(s => { %>
                                            <tr>
                                                <td>
                                                    <div class="student-cell">
                                                        <div class="student-name"><%= s.first_name %> <%= s.last_name || '' %></div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span style="font-size:12px;font-weight:600;font-family:monospace;color:#667eea;">
                                                        <%= s.admission_no %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <input type="text" name="roll_numbers[sid_<%= s.id %>]" value="<%= s.roll_no || '' %>" placeholder="Roll No" class="roll-input">
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                                <div style="padding:16px 20px;display:flex;justify-content:flex-end;border-top:1px solid var(--border);">
                                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Roll Numbers</button>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </form>
            <% } %>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>