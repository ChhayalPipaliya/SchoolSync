        [data-theme="dark"] .insight-box,
        [data-theme="dark"] .ts-circ,
        [data-theme="dark"] .ac-block,
        [data-theme="dark"] .qa-btn,
        [data-theme="dark"] .adm-kpi,
        [data-theme="dark"] .att-prog-stat,
