            .pv2-header-badges { width: 100% !important; display: flex !important; gap: 6px !important; }
            .rev-badge-v2 { flex: 1 !important; padding: 4px 8px !important; text-align: center !important; }

            .dash-dual { grid-template-columns: 1fr; gap: 16px; margin-bottom: 16px; }
            .dash-bottom-grid { grid-template-columns: 1fr; gap: 16px; }
            .fin-three-col { grid-template-columns: 1fr; gap: 8px; }
            .fin-col { padding: 10px 12px; }
            .fc-val { font-size: 16px; }
            .dash-tables-row { grid-template-columns: 1fr; gap: 12px; margin-top: 12px; }
            .dt-half { width: 100%; overflow-x: auto; }
            .dash-tbl { font-size: 11px; }
            .dash-tbl thead th, .dash-tbl tbody td { padding: 6px 8px; }

            .adm-stats-row { grid-template-columns: repeat(2, 1fr); gap: 8px; }
            .adm-kpi { padding: 10px 8px; }
            .adv-val { font-size: 18px; }

            .att-cards-row { grid-template-columns: 1fr !important; gap: 12px !important; margin-bottom: 16px !important; }
            .att-card { padding: 16px 14px !important; }
            .att-donut-wrap { gap: 14px !important; }
            .att-charts-row { grid-template-columns: 1fr !important; gap: 12px !important; }
            .att-modal-stats { grid-template-columns: repeat(2, 1fr) !important; }

            .dash-triple { grid-template-columns: 1fr; gap: 14px; }
            .dash-double { grid-template-columns: 1fr; gap: 14px; }
            .ac-grid-4 { grid-template-columns: repeat(2, 1fr); gap: 8px; }
            .qa-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
            .transport-circles { flex-direction: row; gap: 8px; }
            .ts-circ { padding: 12px 10px; }
            .ts-val { font-size: 18px; }
        }
        @media (max-width:480px){
            .dash-hero { padding: 14px 12px; border-radius: 14px; }
            .dash-greeting { font-size: 18px; }
            .action-row { grid-template-columns: 1fr; gap: 8px; }
            .kpi-row { grid-template-columns: repeat(2, 1fr) !important; gap: 8px !important; }
            .kpi-tile { padding: 12px 8px !important; }
            .kpi-num { font-size: 16px !important; }
            .ac-grid-4 { grid-template-columns: repeat(2, 1fr); gap: 6px; }
            .qa-grid { grid-template-columns: repeat(2, 1fr); gap: 6px; }
            .adm-stats-row { grid-template-columns: repeat(2, 1fr); gap: 6px; }
            .att-prog-stats { grid-template-columns: repeat(3, 1fr); gap: 4px; }
            .att-prog-stat { padding: 8px 4px; }
            .att-prog-stat-val { font-size: 14px; }
            .att-donut-pos { width: 96px; height: 96px; }
            .att-donut-pos svg { width: 96px; height: 96px; }
        }
    </style>
</head>
<body class="schooladmin-theme">
    <div class="app-wrapper">
        <%- include('../partials/sidebar', { currentPath: '/schooladmin/dashboard' }) %>
        <main class="main-panel" id="mainPanel">
            <%- include('../partials/header') %>
            <%- include('../partials/flashMessages') %>
            <div class="content dash-v2">
                <% if (typeof subscriptionBannerMessage !== 'undefined' && subscriptionBannerMessage) { %>
                    <div class="sub-alert-bar <%= subscriptionState && subscriptionState.subscriptionLocked ? 'locked' : '' %>">
                        <div class="sub-alert-left">
                            <i class="fas fa-<%= subscriptionState && subscriptionState.subscriptionLocked ? 'lock' : 'bell' %>"></i>
                            <div>
                                <strong><%= subscriptionState && subscriptionState.subscriptionLocked ? 'Subscription Required' : 'Demo Reminder' %></strong>
                                <span><%= subscriptionBannerMessage %></span>
                            </div>
                        </div>
                        <a href="/schooladmin/subscription" class="sub-alert-cta">View Plans →</a>
                    </div>
                <% } %>
                <% if (typeof subscriptionState !== 'undefined' && subscriptionState && subscriptionState.subscriptionLocked) { %>
                    <div class="expired-demo-overlay" aria-modal="true" role="dialog">
                        <div class="expired-demo-modal">
                            <div class="expired-demo-header">
                                <span class="expired-demo-kicker">SchoolSync Subscription</span>
                                <h2>Your 7-Day Full Access Demo Has Expired</h2>
                                <p>Please choose a subscription plan to continue using SchoolSync.</p>
                                <div class="expired-demo-test-note">Test Mode: Use Netbanking for quick testing. Do not use 4242 card.</div>
                            </div>
                            <div class="billing-switch" role="group">
                                <button type="button" class="active" data-cycle="monthly">Monthly</button>
                                <button type="button" data-cycle="yearly">Yearly</button>
                            </div>
                            <div class="expired-plan-grid">
                                <% (publicPlans || []).filter(plan => ['basic','standard','premium'].includes(String(plan.plan_key||plan.name||'').toLowerCase())).forEach((plan) => { %>
                                    <div class="expired-plan-card">
                                        <% if (plan.is_popular) { %>
                                            <div class="expired-plan-badge">Popular</div>
                                        <% } %>
                                        <h3><%= plan.name %></h3>
                                        <p><%= plan.description || 'Complete school management subscription.' %></p>
                                        <div class="expired-price">
                                            <span class="price-monthly">₹<%= Math.round(Number(plan.monthly_price||0)) %><small>/mo</small></span>
                                            <span class="price-yearly" style="display:none;">₹<%= Math.round(Number(plan.yearly_price||0)) %><small>/yr</small></span>
                                        </div>
                                        <div class="expired-limits">
                                            <span><i class="fas fa-user-graduate"></i> <%= plan.display_student_limit||plan.max_students||plan.student_limit||'Unlimited' %> students</span>
                                            <span><i class="fas fa-chalkboard-teacher"></i> <%= plan.display_teacher_limit||plan.max_teachers||plan.teacher_limit||'Unlimited' %> staff</span>
                                        </div>
                                        <ul>
                                            <% (plan.featuresList||[]).slice(0,8).forEach(f => { %><li><i class="fas fa-check"></i> <%= String(f).replace(/_/g,' ') %></li><% }) %>
                                        </ul>
                                        <button type="button" class="pay-plan-btn" data-plan-id="<%= plan.id %>">Select Plan &amp; Pay</button>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                <% } %>
                <div class="dash-hero">
                    <div class="dash-hero-left">
                        <div class="dash-greeting-badge">
                            <i class="fas fa-calendar-alt"></i>
                            <span id="currentDate"></span>
                        </div>
                        <h1 class="dash-greeting">Welcome back, <%= user.first_name %>! 👋</h1>
                        <p class="dash-subtext">Here's what's happening at <strong><%= school.name %></strong> today.</p>
                        <div class="dash-hero-chips">
                            <div class="hero-chip <%= (typeof planStatus !== 'undefined' && planStatus.labelClass) ? planStatus.labelClass : 'chip-green' %>">
                                <i class="fas fa-shield-alt"></i>
                                <%= (typeof planStatus !== 'undefined' && planStatus.label) ? planStatus.label : '7-Day Full Demo' %>
                            </div>
                            <div class="hero-chip chip-yellow">
                                <i class="fas fa-clock"></i>
                                <%= (typeof planStatus !== 'undefined' && planStatus.daysValue) ? planStatus.daysValue : (daysRemaining + ' days') %> remaining
                            </div>
                        </div>
                    </div>
                    <%- include('../partials/hero-illustration', { illustrationSrc: '/illustrations/school_admin.png', illustrationAlt: 'School Admin Dashboard' }) %>
                </div>
                <section class="action-row" aria-label="Critical Actions">
                    <div class="act-card col-red">
                        <div class="act-icon"><i class="fas fa-rupee-sign"></i></div>
                        <div class="act-body">
                            <div class="act-label">Fee Defaulters</div>
                                <div class="act-count"><%= pendingStudents %> Outstanding</div>
                            </div>
                            <span class="act-badge high">High</span>
                            <a href="/schooladmin/fees/pending" class="act-arrow"><i class="fas fa-arrow-right"></i></a>
                        </div>
                        <div class="act-card col-orange">
                            <div class="act-icon"><i class="fas fa-user-plus"></i></div>
                            <div class="act-body">
                                <div class="act-label">Admission Requests</div>
                                <div class="act-count"><%= pendingAdmissionsCount %> Pending</div>
                            </div>
                            <span class="act-badge med">Review</span>
                            <a href="/schooladmin/admissions" class="act-arrow"><i class="fas fa-arrow-right"></i></a>
                        </div>
                        <div class="act-card col-amber">
                            <div class="act-icon"><i class="fas fa-book-reader"></i></div>
                            <div class="act-body">
                                <div class="act-label">Overdue Books</div>
                                <div class="act-count"><%= overdueLibraryCount %> Not Returned</div>
                            </div>
                            <span class="act-badge med">Library</span>
                            <a href="/schooladmin/library" class="act-arrow"><i class="fas fa-arrow-right"></i></a>
                        </div>
                        <div class="act-card col-blue">
                            <div class="act-icon"><i class="fas fa-plane-departure"></i></div>
                            <div class="act-body">
                                <div class="act-label">Leave Requests</div>
                                <div class="act-count"><%= pendingLeavesCount %> Pending</div>
                            </div>
                            <span class="act-badge low">Review</span>
                            <a href="/schooladmin/leaves" class="act-arrow"><i class="fas fa-arrow-right"></i></a>
                        </div>
                </section>
                <section class="kpi-row" aria-label="Key Metrics">
                    <div class="kpi-tile students-tile">
                        <div class="kpi-tile-header">
                            <div class="kpi-ico ico-green"><i class="fas fa-user-graduate"></i></div>
                        </div>
                        <div class="kpi-num counter" data-target="<%= totalStudents %>"><%= totalStudents %></div>
                        <div class="kpi-name">Total Students</div>
                        <div class="kpi-sub">
                            <span class="kpi-pill blue"><%= boys || 0 %> Boys</span> 
                            <span class="kpi-pill pink"><%= girls || 0 %> Girls</span>
                        </div>
                    </div>
                    <div class="kpi-tile teachers-tile">
                        <div class="kpi-tile-header">
                            <div class="kpi-ico ico-blue"><i class="fas fa-chalkboard-teacher"></i></div>
                        </div>
                        <div class="kpi-num counter" data-target="<%= totalTeachers %>"><%= totalTeachers %></div>
                        <div class="kpi-name">Teachers</div>
                        <div class="kpi-sub"><%= totalClasses %> Active Classes</div>
                    </div>
                    <div class="kpi-tile fees-tile">
                        <div class="kpi-tile-header">
                            <div class="kpi-ico ico-emerald"><i class="fas fa-wallet"></i></div>
                        </div>
                        <div class="kpi-num">₹<%= parseFloat(feesCollected||0).toLocaleString('en-IN') %></div>
                        <div class="kpi-name">Collected (YTD)</div>
                        <div class="kpi-sub">₹<%= parseFloat(feesPending||0).toLocaleString('en-IN') %> Pending</div>
                    </div>
                    <div class="kpi-tile att-tile">
                        <div class="kpi-tile-header">
                            <div class="kpi-ico ico-violet"><i class="fas fa-calendar-check"></i></div>
                        </div>
                        <div class="kpi-num"><%= todayAttendancePct %>%</div>
                        <div class="kpi-name">Today's Attendance</div>
                        <div class="kpi-sub"><%= presentCount %> Present · <%= absentCount %> Absent</div>
                    </div>
                    <div class="kpi-tile lib-tile">
                        <div class="kpi-tile-header">
                            <div class="kpi-ico ico-amber"><i class="fas fa-book-reader"></i></div>
                        </div>
                        <div class="kpi-num"><%= overdueLibraryCount %></div>
                        <div class="kpi-name">Overdue Books</div>
                        <div class="kpi-sub">₹<%= parseFloat(pendingLibraryFines||0).toLocaleString('en-IN') %> Fines Pending</div>
                    </div>
                    <div class="kpi-tile ptm-tile">
                        <div class="kpi-tile-header">
                            <div class="kpi-ico ico-indigo"><i class="fas fa-handshake"></i></div>
                         </div>
                        <div class="kpi-num"><%= upcomingPtmCount %></div>
                        <div class="kpi-name">Open PTM Slots</div>
                        <div class="kpi-sub"><%= bookedPtmCount %> Confirmed Meetings</div>
                    </div>
                </section>
                <div class="dash-dual">
                    <div class="dash-left">
                        <div class="panel-v2 mb-5">
                            <div class="panel-v2-header">
                                <div class="pv2-icon fees"><i class="fas fa-wallet"></i></div>
                                <div>
                                    <h4 class="pv2-title">Financial Health</h4>
                                    <span class="pv2-sub">Fee Collections &amp; Outstanding Balances</span>
                                </div>
                                <div class="pv2-header-badges">
                                    <div class="rev-badge-v2">
                                        <span class="rv2-lbl">Today</span>
                                        <span class="rv2-val green">₹<%= parseFloat(todayFees||0).toLocaleString('en-IN') %></span>
                                    </div>
                                    <div class="rev-badge-v2">
                                        <span class="rv2-lbl">This Month</span>
                                        <span class="rv2-val blue">₹<%= parseFloat(thisMonthCollected||0).toLocaleString('en-IN') %></span>
                                    </div>
                                </div>
                            </div>
                            <div class="fin-three-col">
                                <div class="fin-col collected">
                                    <span class="fc-lbl">Collected (YTD)</span>
                                    <span class="fc-val green">₹<%= parseFloat(feesCollected||0).toLocaleString('en-IN') %></span>
                                    <div class="fc-bar">
                                        <div class="fc-fill bg-emerald" data-width="<%= feeCollectionPct %>"></div>
                                    </div>
                                    <span class="fc-meta"><%= feeCollectionPct %>% Rate</span>
                                </div>
                                <div class="fin-col pending">
                                    <span class="fc-lbl">Pending Dues</span>
                                    <span class="fc-val amber">₹<%= parseFloat(feesPending||0).toLocaleString('en-IN') %></span>
                                    <span class="fc-meta amber"><%= pendingStudents %> Invoices Due (Total)</span>
                                </div>
                                <div class="fin-col overdue">
                                    <span class="fc-lbl">Overdue Balance</span>
                                    <span class="fc-val red">₹<%= parseFloat(overdueFees||0).toLocaleString('en-IN') %></span>
                                    <span class="fc-meta red">Immediate Action Required</span>
                                </div>
                            </div>
                            <div class="chart-box mt-4">
                                <h5 class="chart-label">Collection Trend (Past 6 Months)</h5>
                                <div style="height:200px;">
                                    <canvas id="feesChart" data-labels='<%- JSON.stringify(feeLabels) %>' data-collected='<%- JSON.stringify(feeCollectedData) %>' data-pending='<%- JSON.stringify(feePendingData) %>'></canvas>
                                </div>
                            </div>
                            <div class="dash-tables-row">
                                <div class="dt-half">
                                    <div class="dt-header">Class Breakdown</div>
                                    <table class="dash-tbl">
                                        <thead>
                                            <tr>
                                                <th>Class</th>
                                                <th class="tr">Collected</th>
                                                <th class="tr">Dues</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% classFeeBreakdown.slice(0,4).forEach(r => { %>
                                                <tr>
                                                    <td><strong><%= r.class_name %> (<%= r.section %>)</strong></td>
                                                    <td class="tr green">₹<%= parseFloat(r.collected).toLocaleString('en-IN') %></td>
                                                    <td class="tr amber">₹<%= parseFloat(r.total - r.collected).toLocaleString('en-IN') %></td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="dt-half">
                                    <div class="dt-header">Top Defaulters</div>
                                    <table class="dash-tbl">
                                        <thead>
                                            <tr>
                                                <th>Student</th>
                                                <th>Class</th>
                                                <th class="tr">Due</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (topDefaulters && topDefaulters.length > 0) { %>
                                                <% topDefaulters.slice(0,4).forEach(d => { %>
                                                    <tr>
                                                        <td><%= d.first_name %> <%= d.last_name %></td>
                                                        <td><%= d.class_name %>-<%= d.section %></td>
                                                        <td class="tr red">₹<%= parseFloat(d.balance).toLocaleString('en-IN') %></td>
                                                    </tr>
                                                <% }) %>
                                            <% } else { %>  
                                                <tr><td colspan="3" class="empty-cell">No defaulters found ✓</td></tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="panel-v2">
                            <div class="panel-v2-header">
                                <div class="pv2-icon admission"><i class="fas fa-user-plus"></i></div>
                                <div>
                                    <h4 class="pv2-title">Admissions Center</h4>
                                    <span class="pv2-sub">Requests &amp; Conversion Tracking</span>
                                </div>
                            </div>
                            <div class="adm-stats-row">
                                <div class="adm-kpi">
                                    <span class="adv-val"><%= admissionsStats.total %></span>
                                    <span class="adv-lbl">Total</span>
                                </div>
                                <div class="adm-kpi green">
                                    <span class="adv-val"><%= admissionsStats.approved %></span>
                                    <span class="adv-lbl">Approved</span>
                                </div>
                                <div class="adm-kpi amber">
                                    <span class="adv-val"><%= admissionsStats.pending %></span>
                                    <span class="adv-lbl">Pending</span>
                                </div>
                                <div class="adm-kpi blue">
                                    <span class="adv-val"><%= admissionsStats.total > 0 ? Math.round((admissionsStats.approved/admissionsStats.total)*100) : 0 %>%</span>
                                    <span class="adv-lbl">Rate</span>
                                </div>
                            </div>
                            <div style="height:160px;" class="mt-4">
                                <canvas id="admissionsChart" data-chart="line" data-color="green" data-label="Requests" data-labels='<%- JSON.stringify(admissionsTrend.map(t=>t.label)) %>' data-data='<%- JSON.stringify(admissionsTrend.map(t=>t.count)) %>'></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="dash-right">
                        <div class="panel-v2 mb-5">
                            <div class="panel-v2-header">
                                <div class="pv2-icon" style="background: linear-gradient(135deg, #ec4899, #f43f5e);"><i class="fas fa-birthday-cake"></i></div>
                                <div>
                                    <h4 class="pv2-title">Today's Birthdays</h4>
                                    <span class="pv2-sub">Celebrations & Wishes</span>
                                </div>
                            </div>
                            <div class="birthday-widget-body">
                                <% 
                                    const bdays = typeof todaysBirthdays !== 'undefined' && todaysBirthdays ? todaysBirthdays : { students: [], teachers: [], librarians: [], drivers: [] };
                                    const hasBirthdays = (bdays.students && bdays.students.length > 0) || (bdays.teachers && bdays.teachers.length > 0) || (bdays.librarians && bdays.librarians.length > 0) || (bdays.drivers && bdays.drivers.length > 0);
                                %>
                                <% if (!hasBirthdays) { %>
                                    <div class="empty-bday-box" style="text-align: center; padding: 24px 12px; font-size: 13px; border-radius: 12px; border: 1px dashed #e2e8f0;">
                                        <i class="fas fa-gift" style="font-size: 24px; color: #cbd5e1; margin-bottom: 6px; display: block;"></i>
                                        No birthdays today.
                                    </div>
                                <% } else { %>
                                    <div style="display: flex; flex-direction: column; gap: 14px;">
                                        <% if (bdays.students && bdays.students.length > 0) { %>
                                            <div>
                                                <div style="font-size: 12px; font-weight: 700; color: #ec4899; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">
                                                    🎓 Students (<%= bdays.students.length %>)
                                                </div>
                                                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px;">
                                                    <% bdays.students.forEach(st => { %>
                                                        <li class="bday-row" style="font-size: 13px; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; border: 1px solid #fbcfe8;">
                                                            <span style="color: #ec4899; font-weight: bold;">•</span>
                                                            <span><strong><%= st.name %></strong><% if (st.className) { %> <span style="color: #64748b; font-weight: normal;">- Class <%= st.className %><% if (st.section) { %><%= st.section %><% } %></span><% } %></span>
                                                        </li>
                                                    <% }) %>
                                                </ul>
                                            </div>
                                        <% } %>
                                        <% if (bdays.teachers && bdays.teachers.length > 0) { %>
                                            <div>
                                                <div style="font-size: 12px; font-weight: 700; color: #2563eb; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">
                                                    👨‍🏫 Teachers (<%= bdays.teachers.length %>)
                                                </div>
                                                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px;">
                                                    <% bdays.teachers.forEach(t => { %>
                                                        <li class="bday-row" style="font-size: 13px; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; border: 1px solid #bfdbfe;">
                                                            <span style="color: #2563eb; font-weight: bold;">•</span>
                                                            <span><strong><%= t.name %></strong></span>
                                                        </li>
                                                    <% }) %>
                                                </ul>
                                            </div>
                                        <% } %>
                                        <% if (bdays.librarians && bdays.librarians.length > 0) { %>
                                            <div>
                                                <div style="font-size: 12px; font-weight: 700; color: #7c3aed; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">
                                                    📚 Librarians (<%= bdays.librarians.length %>)
                                                </div>
                                                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px;">
                                                    <% bdays.librarians.forEach(l => { %>
                                                        <li class="bday-row" style="font-size: 13px; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; border: 1px solid #ddd6fe;">
                                                            <span style="color: #7c3aed; font-weight: bold;">•</span>
                                                            <span><strong><%= l.name %></strong></span>
                                                        </li>
                                                    <% }) %>
                                                </ul>
                                            </div>
                                        <% } %>
                                        <% if (bdays.drivers && bdays.drivers.length > 0) { %>
                                            <div>
                                                <div style="font-size: 12px; font-weight: 700; color: #d97706; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;">
                                                    🚌 Drivers (<%= bdays.drivers.length %>)
                                                </div>
                                                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px;">
                                                    <% bdays.drivers.forEach(d => { %>
                                                        <li class="bday-row" style="font-size: 13px; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; border: 1px solid #fde68a;">
                                                            <span style="color: #d97706; font-weight: bold;">•</span>
                                                            <span><strong><%= d.name %></strong></span>
                                                        </li>
                                                    <% }) %>
                                                </ul>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="panel-v2">
                            <div class="panel-v2-header">
                                <div class="pv2-icon notice"><i class="fas fa-stream"></i></div>
                                <div>
                                    <h4 class="pv2-title">Live Activity Feed</h4>
                                    <span class="pv2-sub">Latest School Events</span>
                                </div>
                            </div>
                            <hr style="margin:12px 0; border:none; border-top:1px solid #e2e8f0">
                            <div class="timeline-v2">
                                <% if (timelineEvents && timelineEvents.length > 0) { %>
