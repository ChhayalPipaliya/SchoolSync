<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'School Admin Dashboard | SchoolSync', needsCharts: true }) %>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    h1, h2, h3, h4, h5, h6, .brand-text, .panel-title, .bento-value, .hero-stat-value, .amount { font-family: 'Outfit', sans-serif !important;}
    .dash-v2{padding:0 2px;}
    .panel-v2{background:#fff;border-radius:16px;padding:22px;box-shadow:0 2px 18px rgba(15,23,42,.07);border:1px solid #f1f5f9;}
    .pv2-title{font-size:15px;font-weight:700;color:#1e293b;margin:0;}
    .pv2-sub{font-size:12px;color:#94a3b8;margin-top:2px;display:block;}
    .panel-v2-header{display:flex;align-items:flex-start;gap:14px;margin-bottom:18px;}
    .pv2-icon{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:17px;color:#fff;flex-shrink:0;}
    .pv2-icon.fees{background:linear-gradient(135deg,#059669,#10b981);}
    .pv2-icon.attendance{background:linear-gradient(135deg,#3b82f6,#6366f1);}
    .pv2-icon.admission{background:linear-gradient(135deg,#f59e0b,#fbbf24);}
    .pv2-icon.notice{background:linear-gradient(135deg,#8b5cf6,#a78bfa);}
    .pv2-header-badges{margin-left:auto;display:flex;gap:10px;flex-shrink:0;}
    .rev-badge-v2{display:flex;flex-direction:column;gap:2px;align-items:flex-end;}
    .rv2-lbl{font-size:11px;color:#94a3b8;}
    .rv2-val{font-size:14px;font-weight:700;}
    .rv2-val.green{color:#059669;}.rv2-val.blue{color:#3b82f6;}
    .mb-5{margin-bottom:20px!important;}.mb-6{margin-bottom:24px!important;}.mt-3{margin-top:12px!important;}.mt-4{margin-top:16px!important;}
    .sub-alert-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;border-radius:12px;background:#fffbeb;border:1px solid #fde68a;margin-bottom:20px;}
    .sub-alert-bar.locked{background:#fff1f2;border-color:#fecaca;}
    .sub-alert-left{display:flex;align-items:center;gap:12px;font-size:14px;color:#92400e;}
    .sub-alert-left i{font-size:18px;}
    .sub-alert-left strong{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:2px;}
    .sub-alert-cta{background:#111827;color:#fff;text-decoration:none;border-radius:8px;padding:8px 14px;font-size:13px;font-weight:700;white-space:nowrap;}
    .dash-hero{background: linear-gradient(135deg, #12715b 0%, #15693e 60%, #54645c 100%);border-radius:20px;padding:28px 32px;display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;overflow:hidden;position:relative;}
    .dash-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 80% 50%,rgba(59,130,246,.15),transparent 60%);pointer-events:none;}
    .dash-hero-left{flex:1;}
    .dash-greeting-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);color:rgba(255,255,255,.7);border-radius:999px;padding:6px 14px;font-size:12px;margin-bottom:12px;}
    .dash-greeting{font-size:26px;font-weight:800;color:#fff;margin:0 0 8px;}
    .dash-subtext{color:rgba(255,255,255,.6);font-size:14px;margin:0 0 16px;}
    .dash-hero-chips{display:flex;flex-wrap:wrap;gap:8px;}
    .hero-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:999px;font-size:12px;font-weight:600;background:rgba(255,255,255,.1);color:rgba(255,255,255,.85);}
    .hero-chip.chip-green{background:rgba(16,185,129,.2);color:#6ee7b7;}
    .hero-chip.chip-yellow{background:rgba(245,158,11,.2);color:#fde68a;}
    .hero-chip.chip-blue{background:rgba(59,130,246,.2);color:#93c5fd;}
    .hero-chip.text-emerald-200{background:rgba(16,185,129,.2);color:#6ee7b7;}
    .hero-chip.text-red-200{background:rgba(239,68,68,.2);color:#fca5a5;}
    .hero-chip.text-slate-100{background:rgba(255,255,255,.1);color:rgba(255,255,255,.7);}
    .dash-hero-right{flex-shrink:0;margin-left:24px;}
    .health-ring-wrap{position:relative;width:120px;height:120px;display:flex;align-items:center;justify-content:center;}
    .health-ring-inner{position:absolute;text-align:center;}
    .health-pct{font-size:22px;font-weight:800;color:#fff;display:block;}
    .health-lbl{font-size:11px;color:rgba(255,255,255,.5);}
    .action-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-bottom:20px;}
    .act-card{background:#fff;border-radius:14px;padding:16px 18px;display:flex;align-items:center;gap:12px;box-shadow:0 2px 12px rgba(15,23,42,.06);border:1px solid #f1f5f9;transition:transform .2s,box-shadow .2s;}
    .act-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(15,23,42,.1);}
    .act-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;color:#fff;flex-shrink:0;}
    .col-red .act-icon{background:#fee2e2;color:#ef4444;}
    .col-orange .act-icon{background:#ffedd5;color:#f97316;}
    .col-amber .act-icon{background:#fef3c7;color:#d97706;}
    .col-blue .act-icon{background:#dbeafe;color:#3b82f6;}
    .act-body{flex:1;}
    .act-label{font-size:12px;color:#64748b;font-weight:500;}
    .act-count{font-size:16px;font-weight:700;color:#1e293b;margin-top:2px;}
    .act-badge{font-size:10px;font-weight:700;padding:3px 8px;border-radius:999px;flex-shrink:0;}
    .act-badge.high{background:#fee2e2;color:#ef4444;}
    .act-badge.med{background:#fef3c7;color:#d97706;}
    .act-badge.low{background:#dbeafe;color:#3b82f6;}
    .act-arrow{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:#f8fafc;color:#64748b;text-decoration:none;transition:background .2s;}
    .act-arrow:hover{background:#e2e8f0;}
    .kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-bottom:22px;}
    .kpi-tile{background:#fff;border-radius:16px;padding:18px;box-shadow:0 2px 14px rgba(15,23,42,.06);border:1px solid #f1f5f9;transition:transform .2s;}
    .kpi-tile:hover{transform:translateY(-2px);}
    .kpi-tile-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
    .kpi-ico{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:15px;color:#fff;}
    .ico-green{background:linear-gradient(135deg,#059669,#10b981);}
    .ico-blue{background:linear-gradient(135deg,#2563eb,#3b82f6);}
    .ico-emerald{background:linear-gradient(135deg,#047857,#059669);}
    .ico-violet{background:linear-gradient(135deg,#6d28d9,#7c3aed);}
    .ico-amber{background:linear-gradient(135deg,#b45309,#d97706);}
    .ico-indigo{background:linear-gradient(135deg,#4338ca,#6366f1);}
    .kpi-trend{font-size:11px;font-weight:700;padding:4px 8px;border-radius:999px;}
    .kpi-trend.positive{background:#dcfce7;color:#16a34a;}
    .kpi-trend.negative{background:#fee2e2;color:#ef4444;}
    .kpi-num{font-size:24px;font-weight:800;color:#1e293b;margin-bottom:4px;line-height:1;}
    .kpi-name{font-size:12px;color:#64748b;font-weight:500;margin-bottom:8px;}
    .kpi-sub{font-size:11px;color:#94a3b8;}
    .kpi-pill{display:inline-block;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:600;margin-right:4px;}
    .kpi-pill.blue{background:#dbeafe;color:#1d4ed8;}
    .kpi-pill.pink{background:#fce7f3;color:#be185d;}
    .dash-dual{display:grid;grid-template-columns:1.3fr 1fr;gap:20px;margin-bottom:22px;}
    .dash-left,.dash-right{display:flex;flex-direction:column;}
    .fin-three-col{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
    .fin-col{background:#f8fafc;border-radius:12px;padding:14px;}
    .fc-lbl{font-size:11px;color:#94a3b8;font-weight:500;display:block;margin-bottom:6px;}
    .fc-val{font-size:17px;font-weight:800;display:block;margin-bottom:6px;}
    .fc-val.green{color:#059669;}.fc-val.amber{color:#d97706;}.fc-val.red{color:#ef4444;}
    .fc-bar{height:4px;background:#e2e8f0;border-radius:2px;margin-bottom:6px;}
    .fc-fill{height:4px;border-radius:2px;}
    .bg-emerald{background:#10b981;}
    .fc-meta{font-size:11px;font-weight:600;}
    .fc-meta.amber{color:#d97706;}.fc-meta.red{color:#ef4444;}
    .chart-label{font-size:12px;color:#64748b;font-weight:600;margin-bottom:8px;}
    .dash-tables-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:16px;}
    .dt-header{font-size:12px;font-weight:700;color:#374151;background:#f8fafc;padding:8px 12px;border-radius:8px 8px 0 0;border:1px solid #e5e7eb;border-bottom:none;}
    .dash-tbl{width:100%;border-collapse:collapse;font-size:12px;}
    .dash-tbl thead th{padding:8px 10px;text-align:left;font-weight:700;color:#374151;background:#f8fafc;border:1px solid #e5e7eb;font-size:11px;}
    .dash-tbl thead th.tr{text-align:right;}
    .dash-tbl tbody td{padding:8px 10px;border-bottom:1px solid #f1f5f9;color:#374151;}
    .dash-tbl tbody td.tr{text-align:right;}
    .dash-tbl tbody td.green{color:#059669;font-weight:600;}
    .dash-tbl tbody td.amber{color:#d97706;}
    .dash-tbl tbody td.red{color:#ef4444;font-weight:600;}
    .empty-cell{text-align:center;color:#94a3b8;padding:14px!important;}
    .adm-stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
    .adm-kpi{background:#f8fafc;border-radius:10px;padding:12px;text-align:center;}
    .adm-kpi.green .adv-val{color:#059669;}.adm-kpi.amber .adv-val{color:#d97706;}.adm-kpi.blue .adv-val{color:#2563eb;}
    .adv-val{font-size:20px;font-weight:800;color:#1e293b;display:block;}
    .adv-lbl{font-size:11px;color:#94a3b8;}
    .att-rings-row{display:flex;align-items:center;gap:16px;}
    .att-ring-box{display:flex;flex-direction:column;align-items:center;gap:6px;position:relative;}
    .att-ring-box svg{display:block;}
    .ring-inner{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);}
    .ring-value{font-size:13px;font-weight:800;color:#1e293b;}
    .ring-lbl{font-size:11px;color:#64748b;font-weight:500;}
    .ring-bg{fill:none;stroke:#f1f5f9;stroke-width:10;}
    .ring-progress{fill:none;stroke-width:10;stroke-linecap:round;transform-origin:center;transition:stroke-dashoffset 1s ease;}
    .att-breakdown{flex:1;display:flex;flex-direction:column;gap:8px;}
    .ab-row{display:flex;align-items:center;justify-content:space-between;font-size:13px;color:#374151;}
    .ab-row strong.green{color:#059669;}.ab-row strong.red{color:#ef4444;}.ab-row strong.amber{color:#d97706;}
    .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;}
    .dot.green{background:#10b981;}.dot.red{background:#ef4444;}.dot.amber{background:#f59e0b;}
    .ab-empty{color:#94a3b8;font-size:13px;}
    .risk-banner{background:#fef3c7;border:1px solid #fde68a;border-radius:10px;padding:12px 14px;display:flex;align-items:center;gap:10px;font-size:13px;color:#92400e;}
    .risk-banner i{color:#f59e0b;}
    .timeline-v2{display:flex;flex-direction:column;gap:14px;}
    .tv2-item{display:flex;gap:12px;align-items:flex-start;}
    .tv2-dot{width:10px;height:10px;border-radius:50%;background:#e2e8f0;margin-top:5px;flex-shrink:0;}
    .tv2-dot.fee_received{background:#10b981;}
    .tv2-dot.student_registered{background:#3b82f6;}
    .tv2-dot.notice_published{background:#8b5cf6;}
    .tv2-content{flex:1;}
    .tv2-title{font-size:13px;font-weight:600;color:#1e293b;margin-bottom:2px;}
    .tv2-text{font-size:12px;color:#64748b;}
    .tv2-time{font-size:11px;color:#94a3b8;margin-top:2px;}
    .empty-feed{text-align:center;color:#94a3b8;padding:20px;font-size:13px;}
    .dash-section{margin-bottom:0;}
    .ds-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
    .ds-title{font-size:15px;font-weight:700;color:#1e293b;margin:0;}
    .ds-link{font-size:13px;color:#3b82f6;text-decoration:none;font-weight:600;}
    .students-scroll{display:flex;gap:14px;overflow-x:auto;padding-bottom:6px;scrollbar-width:none;}
    .students-scroll::-webkit-scrollbar{display:none;}
    .stu-card{background:#fff;border-radius:14px;padding:16px;min-width:180px;box-shadow:0 2px 12px rgba(15,23,42,.06);border:1px solid #f1f5f9;flex-shrink:0;}
    .stu-avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#3b82f6);color:#fff;font-size:16px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-bottom:10px;}
    .stu-info h4{font-size:13px;font-weight:700;color:#1e293b;margin:0 0 4px;}
    .stu-class{font-size:11px;color:#94a3b8;display:block;margin-bottom:8px;}
    .stu-meta{display:flex;flex-direction:column;gap:3px;font-size:11px;color:#64748b;}
    .dash-triple{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
    .bday-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f1f5f9;}
    .bday-item:last-child{border-bottom:none;}
    .bday-avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#ec4899,#f9a8d4);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
    .bday-name{font-size:13px;font-weight:600;color:#1e293b;}
    .badge-role{font-size:10px;padding:2px 7px;border-radius:999px;font-weight:700;display:inline-block;}
    .badge-role.student{background:#dbeafe;color:#1d4ed8;}
    .badge-role.teacher{background:#dcfce7;color:#16a34a;}
    .empty-bday{text-align:center;padding:20px;color:#94a3b8;}
    .empty-bday i{font-size:28px;display:block;margin-bottom:8px;}
    .insight-list{display:flex;flex-direction:column;gap:10px;}
    .insight-box{background:#f8fafc;border-radius:10px;padding:12px;}
    .in-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.06em;font-weight:700;color:#94a3b8;display:block;margin-bottom:5px;}
    .insight-box p{font-size:13px;color:#374151;margin:0;}
    .insight-box .red{color:#ef4444;}
    .sub-stat-rows{display:flex;flex-direction:column;gap:10px;}
    .sub-row{display:flex;align-items:center;justify-content:space-between;font-size:13px;color:#64748b;}
    .sub-row strong.violet{color:#7c3aed;}.sub-row strong.green{color:#059669;}.sub-row strong.red{color:#ef4444;}
    .sp-row{display:flex;justify-content:space-between;font-size:11px;color:#64748b;margin-bottom:5px;}
    .sp-bar{height:6px;background:#f1f5f9;border-radius:3px;overflow:hidden;}
    .sp-fill{height:6px;border-radius:3px;}
    .sp-fill.violet{background:#7c3aed;}.sp-fill.indigo{background:#6366f1;}
    .sub-upgrade-btn{width:100%;border:0;border-radius:10px;background:linear-gradient(135deg,#4338ca,#7c3aed);color:#fff;padding:11px;font-weight:700;font-size:13px;cursor:pointer;transition:opacity .2s;}
    .sub-upgrade-btn:hover{opacity:.9;}
    .dash-double{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
    .dash-half{display:flex;flex-direction:column;}
    .transport-circles{display:flex;gap:12px;justify-content:center;}
    .ts-circ{background:#f8fafc;border-radius:14px;padding:16px 22px;text-align:center;flex:1;}
    .ts-val{font-size:22px;font-weight:800;color:#1e293b;display:block;}
    .ts-lbl{font-size:11px;color:#94a3b8;}
    .ac-grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
    .ac-block{background:#f8fafc;border-radius:10px;padding:12px;text-align:center;}
    .ac-val{font-size:20px;font-weight:800;color:#1e293b;display:block;}
    .ac-lbl{font-size:10px;color:#94a3b8;margin-top:3px;display:block;}
    .qa-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
    .qa-btn{background:#f8fafc;border:1px solid #e5e7eb;border-radius:10px;padding:12px 8px;text-align:center;text-decoration:none;display:flex;flex-direction:column;align-items:center;gap:7px;color:#374151;font-size:11px;font-weight:600;transition:background .15s,transform .15s;}
    .qa-btn:hover{background:#fff;transform:translateY(-1px);box-shadow:0 4px 12px rgba(15,23,42,.08);}
    .qa-btn i{font-size:16px;}
    .events-list{display:flex;flex-direction:column;gap:10px;}
    .ev-item{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f1f5f9;}
    .ev-item:last-child{border-bottom:none;}
    .ev-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
    .ev-details h5{font-size:13px;font-weight:600;color:#1e293b;margin:0 0 3px;}
    .ev-details span{font-size:11px;color:#94a3b8;}
    .empty-events{text-align:center;color:#94a3b8;font-size:13px;padding:16px;}
    .empty-state-inline{color:#94a3b8;font-size:13px;padding:20px;width:100%;text-align:center;}
    .expired-demo-overlay{position:fixed;inset:0;z-index:9999;background:rgba(15,23,42,.58);display:flex;align-items:center;justify-content:center;padding:24px;backdrop-filter:blur(4px);}
    .expired-demo-modal{width:min(1180px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:18px;box-shadow:0 32px 90px rgba(15,23,42,.34);padding:28px;border:1px solid #e5e7eb;}
    .expired-demo-header{text-align:center;max-width:680px;margin:0 auto 20px;}
    .expired-demo-kicker{display:inline-flex;padding:6px 10px;border-radius:999px;background:#eef2ff;color:#4338ca;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;}
    .expired-demo-header h2{margin:12px 0 8px;font-size:30px;color:#111827;}
    .expired-demo-header p{color:#64748b;font-size:15px;}
    .billing-switch{display:flex;justify-content:center;gap:8px;margin:18px auto 22px;}
    .billing-switch button{border:1px solid #dbe4f0;background:#f8fafc;color:#334155;border-radius:8px;padding:9px 16px;font-weight:800;}
    .billing-switch button.active{background:#4338ca;border-color:#4338ca;color:#fff;}
    .expired-plan-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;}
    .expired-plan-card{position:relative;border:1px solid #e5e7eb;border-radius:14px;padding:20px;background:#fff;box-shadow:0 12px 28px rgba(15,23,42,.08);}
    .expired-plan-badge{position:absolute;top:14px;right:14px;background:#f59e0b;color:#fff;border-radius:999px;padding:4px 8px;font-size:11px;font-weight:800;}
    .expired-plan-card h3{font-size:20px;color:#111827;margin:0 0 6px;}
    .expired-plan-card p{min-height:42px;color:#64748b;font-size:13px;margin:0 0 14px;}
    .expired-price{font-size:30px;font-weight:900;color:#111827;margin-bottom:12px;}
    .expired-price small{font-size:13px;color:#64748b;font-weight:700;}
    .expired-limits{display:flex;flex-direction:column;gap:6px;font-size:12px;color:#475569;margin-bottom:12px;}
    .expired-plan-card ul{list-style:none;padding:0;margin:0 0 18px;display:flex;flex-direction:column;gap:8px;font-size:13px;color:#334155;}
    .expired-plan-card li i{color:#059669;margin-right:7px;}
    .pay-plan-btn{width:100%;border:0;border-radius:10px;background:#4338ca;color:#fff;padding:12px 14px;font-weight:900;cursor:pointer;}
    @media (max-width:1100px){
        .dash-dual{grid-template-columns:1fr;}
        .dash-triple{grid-template-columns:1fr 1fr;}
    }
    @media (max-width:768px){
        .dash-hero{flex-direction:column;gap:20px;padding:22px;}
        .dash-hero-right{margin-left:0;}
        .kpi-row{grid-template-columns:repeat(2,1fr);}
        .action-row{grid-template-columns:1fr 1fr;}
        .dash-triple{grid-template-columns:1fr;}
        .dash-double{grid-template-columns:1fr;}
        .fin-three-col{grid-template-columns:1fr;}
        .dash-tables-row{grid-template-columns:1fr;}
        .ac-grid-4{grid-template-columns:repeat(2,1fr);}
        .qa-grid{grid-template-columns:repeat(2,1fr);}
        .adm-stats-row{grid-template-columns:repeat(2,1fr);}
    }
    @media (max-width:500px){
        .action-row{grid-template-columns:1fr;}
        .kpi-row{grid-template-columns:1fr;}
    }
</style>
</head>
<body class="schooladmin-theme">
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPath: '/schooladmin/dashboard' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header') %>
    <%- include('../partials/flashMessages') %>
    <div class="content dash-v2">
      <%- include('../partials/flashMessages') %>
      <% if (typeof subscriptionBannerMessage !== 'undefined' && subscriptionBannerMessage) { %>
        <div class="sub-alert-bar <%= subscriptionState && subscriptionState.subscriptionLocked ? 'locked' : '' %>">
          <div class="sub-alert-left">
            <i class="fas fa-<%= subscriptionState && subscriptionState.subscriptionLocked ? 'lock' : 'bell' %>"></i>
            <div>
              <strong><%= subscriptionState && subscriptionState.subscriptionLocked ? 'Subscription Required' : 'Demo Reminder' %></strong>
              <span><%= subscriptionBannerMessage %></span>
            </div>
          </div>
          <a href="/schooladmin/subscription" class="sub-alert-cta">View Plans →</a>
        </div>
      <% } %>
      <% if (typeof subscriptionState !== 'undefined' && subscriptionState && subscriptionState.subscriptionLocked) { %>
        <div class="expired-demo-overlay" aria-modal="true" role="dialog">
          <div class="expired-demo-modal">
            <div class="expired-demo-header">
              <span class="expired-demo-kicker">SchoolSync Subscription</span>
              <h2>Your 7-Day Full Access Demo Has Expired</h2>
              <p>Please choose a subscription plan to continue using SchoolSync.</p>
              <div style="background:rgba(251,191,36,.1);border:1px solid rgba(251,191,36,.2);border-radius:8px;padding:12px;margin-top:12px;font-size:12px;color:#d97706;line-height:1.5;">
                Test Mode: Use Netbanking for quick testing. Do not use 4242 card.
              </div>
            </div>
            <div class="billing-switch" role="group">
              <button type="button" class="active" data-cycle="monthly">Monthly</button>
              <button type="button" data-cycle="yearly">Yearly</button>
            </div>
            <div class="expired-plan-grid">
              <% (publicPlans || []).filter(plan => ['basic','standard','premium'].includes(String(plan.plan_key||plan.name||'').toLowerCase())).forEach((plan) => { %>
                <div class="expired-plan-card">
                  <% if (plan.is_popular) { %><div class="expired-plan-badge">Popular</div><% } %>
                  <h3><%= plan.name %></h3>
                  <p><%= plan.description || 'Complete school management subscription.' %></p>
                  <div class="expired-price">
                    <span class="price-monthly">₹<%= Math.round(Number(plan.monthly_price||0)) %><small>/mo</small></span>
                    <span class="price-yearly" style="display:none;">₹<%= Math.round(Number(plan.yearly_price||0)) %><small>/yr</small></span>
                  </div>
                  <div class="expired-limits">
                    <span><i class="fas fa-user-graduate"></i> <%= plan.display_student_limit||plan.max_students||plan.student_limit||'Unlimited' %> students</span>
                    <span><i class="fas fa-chalkboard-teacher"></i> <%= plan.display_teacher_limit||plan.max_teachers||plan.teacher_limit||'Unlimited' %> staff</span>
                  </div>
                  <ul>
                    <% (plan.featuresList||[]).slice(0,8).forEach(f => { %><li><i class="fas fa-check"></i> <%= String(f).replace(/_/g,' ') %></li><% }) %>
                  </ul>
                  <button type="button" class="pay-plan-btn" data-plan-id="<%= plan.id %>">Select Plan &amp; Pay</button>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
      <% } %>
      <div class="dash-hero">
        <div class="dash-hero-left">
          <div class="dash-greeting-badge">
            <i class="fas fa-calendar-alt"></i>
            <span id="currentDate"></span>
          </div>
          <h1 class="dash-greeting">Welcome back, <%= user.first_name %>! 👋</h1>
          <p class="dash-subtext">Here's what's happening at <strong><%= school.name %></strong> today.</p>
          <div class="dash-hero-chips">
            <div class="hero-chip <%= (typeof planStatus !== 'undefined' && planStatus.labelClass) ? planStatus.labelClass : 'chip-green' %>">
              <i class="fas fa-shield-alt"></i>
              <%= (typeof planStatus !== 'undefined' && planStatus.label) ? planStatus.label : '7-Day Full Demo' %>
            </div>
            <div class="hero-chip chip-yellow">
              <i class="fas fa-clock"></i>
              <%= (typeof planStatus !== 'undefined' && planStatus.daysValue) ? planStatus.daysValue : (daysRemaining + ' days') %> remaining
            </div>
          </div>
        </div>
      </div>
      <section class="action-row" aria-label="Critical Actions">
        <div class="act-card col-red">
          <div class="act-icon"><i class="fas fa-rupee-sign"></i></div>
          <div class="act-body">
            <div class="act-label">Fee Defaulters</div>
            <div class="act-count"><%= pendingStudents %> Outstanding</div>
          </div>
          <span class="act-badge high">High</span>
          <a href="/schooladmin/fees/pending" class="act-arrow"><i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="act-card col-orange">
          <div class="act-icon"><i class="fas fa-user-plus"></i></div>
          <div class="act-body">
            <div class="act-label">Admission Requests</div>
            <div class="act-count"><%= pendingAdmissionsCount %> Pending</div>
          </div>
          <span class="act-badge med">Review</span>
          <a href="/schooladmin/admissions" class="act-arrow"><i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="act-card col-amber">
          <div class="act-icon"><i class="fas fa-book-reader"></i></div>
          <div class="act-body">
            <div class="act-label">Overdue Books</div>
            <div class="act-count"><%= overdueLibraryCount %> Not Returned</div>
          </div>
          <span class="act-badge med">Library</span>
          <a href="/schooladmin/library" class="act-arrow"><i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="act-card col-blue">
          <div class="act-icon"><i class="fas fa-plane-departure"></i></div>
          <div class="act-body">
            <div class="act-label">Leave Requests</div>
            <div class="act-count"><%= pendingLeavesCount %> Pending</div>
          </div>
          <span class="act-badge low">Review</span>
          <a href="/schooladmin/leaves" class="act-arrow"><i class="fas fa-arrow-right"></i></a>
        </div>
      </section>
      <section class="kpi-row" aria-label="Key Metrics">
        <div class="kpi-tile students-tile">
          <div class="kpi-tile-header">
            <div class="kpi-ico ico-green"><i class="fas fa-user-graduate"></i></div>
            <span class="kpi-trend positive"><i class="fas fa-arrow-up"></i> +12%</span>
          </div>
          <div class="kpi-num counter" data-target="<%= totalStudents %>"><%= totalStudents %></div>
          <div class="kpi-name">Total Students</div>
          <div class="kpi-sub"><span class="kpi-pill blue"><%= boys || 0 %> Boys</span> <span class="kpi-pill pink"><%= girls || 0 %> Girls</span></div>
        </div>
        <div class="kpi-tile teachers-tile">
          <div class="kpi-tile-header">
            <div class="kpi-ico ico-blue"><i class="fas fa-chalkboard-teacher"></i></div>
            <span class="kpi-trend positive"><i class="fas fa-arrow-up"></i> +4%</span>
          </div>
          <div class="kpi-num counter" data-target="<%= totalTeachers %>"><%= totalTeachers %></div>
          <div class="kpi-name">Teachers</div>
          <div class="kpi-sub"><%= totalClasses %> Active Classes</div>
        </div>
        <div class="kpi-tile fees-tile">
          <div class="kpi-tile-header">
            <div class="kpi-ico ico-emerald"><i class="fas fa-wallet"></i></div>
            <span class="kpi-trend <%= feeCollectionPct >= 80 ? 'positive' : 'negative' %>">
              <i class="fas fa-<%= feeCollectionPct >= 80 ? 'arrow-up' : 'arrow-down' %>"></i> <%= feeCollectionPct %>%
            </span>
          </div>
          <div class="kpi-num">₹<%= parseFloat(feesCollected||0).toLocaleString('en-IN') %></div>
          <div class="kpi-name">Collected (YTD)</div>
          <div class="kpi-sub">₹<%= parseFloat(feesPending||0).toLocaleString('en-IN') %> Pending</div>
        </div>
        <div class="kpi-tile att-tile">
          <div class="kpi-tile-header">
            <div class="kpi-ico ico-violet"><i class="fas fa-calendar-check"></i></div>
            <span class="kpi-trend <%= todayAttendancePct >= 85 ? 'positive' : 'negative' %>">
              <i class="fas fa-<%= todayAttendancePct >= 85 ? 'check' : 'times' %>"></i>
            </span>
          </div>
          <div class="kpi-num"><%= todayAttendancePct %>%</div>
          <div class="kpi-name">Today's Attendance</div>
          <div class="kpi-sub"><%= presentCount %> Present · <%= absentCount %> Absent</div>
        </div>
        <div class="kpi-tile lib-tile">
          <div class="kpi-tile-header">
            <div class="kpi-ico ico-amber"><i class="fas fa-book-reader"></i></div>
            <span class="kpi-trend <%= overdueLibraryCount > 0 ? 'negative' : 'positive' %>">
              <i class="fas fa-<%= overdueLibraryCount > 0 ? 'exclamation' : 'check' %>"></i>
            </span>
          </div>
          <div class="kpi-num"><%= overdueLibraryCount %></div>
          <div class="kpi-name">Overdue Books</div>
          <div class="kpi-sub">₹<%= parseFloat(pendingLibraryFines||0).toLocaleString('en-IN') %> Fines Pending</div>
        </div>
        <div class="kpi-tile ptm-tile">
          <div class="kpi-tile-header">
            <div class="kpi-ico ico-indigo"><i class="fas fa-handshake"></i></div>
            <span class="kpi-trend positive"><i class="fas fa-calendar"></i></span>
          </div>
          <div class="kpi-num"><%= upcomingPtmCount %></div>
          <div class="kpi-name">Open PTM Slots</div>
          <div class="kpi-sub"><%= bookedPtmCount %> Confirmed Meetings</div>
        </div>
      </section>
      <div class="dash-dual">
        <div class="dash-left">
          <div class="panel-v2 mb-5">
            <div class="panel-v2-header">
              <div class="pv2-icon fees"><i class="fas fa-wallet"></i></div>
              <div>
                <h4 class="pv2-title">Financial Health</h4>
                <span class="pv2-sub">Fee Collections &amp; Outstanding Balances</span>
              </div>
              <div class="pv2-header-badges">
                <div class="rev-badge-v2">
                  <span class="rv2-lbl">Today</span>
                  <span class="rv2-val green">₹<%= parseFloat(todayFees||0).toLocaleString('en-IN') %></span>
                </div>
                <div class="rev-badge-v2">
                  <span class="rv2-lbl">This Month</span>
                  <span class="rv2-val blue">₹<%= parseFloat(thisMonthCollected||0).toLocaleString('en-IN') %></span>
                </div>
              </div>
            </div>
            <div class="fin-three-col">
              <div class="fin-col collected">
                <span class="fc-lbl">Collected (YTD)</span>
                <span class="fc-val green">₹<%= parseFloat(feesCollected||0).toLocaleString('en-IN') %></span>
                <div class="fc-bar"><div class="fc-fill bg-emerald" style="width:'<%= feeCollectionPct %>'"></div></div>
                <span class="fc-meta"><%= feeCollectionPct %>% Rate</span>
              </div>
              <div class="fin-col pending">
                <span class="fc-lbl">Pending Dues</span>
                <span class="fc-val amber">₹<%= parseFloat(feesPending||0).toLocaleString('en-IN') %></span>
                <span class="fc-meta amber"><%= pendingStudents %> Invoices Due</span>
              </div>
              <div class="fin-col overdue">
                <span class="fc-lbl">Overdue Balance</span>
                <span class="fc-val red">₹<%= parseFloat(overdueFees||0).toLocaleString('en-IN') %></span>
                <span class="fc-meta red">Immediate Action Required</span>
              </div>
            </div>
            <div class="chart-box mt-4">
              <h5 class="chart-label">Collection Trend (Past 6 Months)</h5>
              <div style="height:200px;">
                <canvas id="feesChart" data-labels='<%- JSON.stringify(feeLabels) %>' data-collected='<%- JSON.stringify(feeCollectedData) %>' data-pending='<%- JSON.stringify(feePendingData) %>'></canvas>
              </div>
            </div>
            <div class="dash-tables-row">
              <div class="dt-half">
                <div class="dt-header">Class Breakdown</div>
                <table class="dash-tbl">
                  <thead><tr><th>Class</th><th class="tr">Collected</th><th class="tr">Dues</th></tr></thead>
                  <tbody>
                    <% classFeeBreakdown.slice(0,4).forEach(r => { %>
                      <tr>
                        <td><strong><%= r.class_name %> (<%= r.section %>)</strong></td>
                        <td class="tr green">₹<%= parseFloat(r.collected).toLocaleString('en-IN') %></td>
                        <td class="tr amber">₹<%= parseFloat(r.total - r.collected).toLocaleString('en-IN') %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <div class="dt-half">
                <div class="dt-header">Top Defaulters</div>
                <table class="dash-tbl">
                  <thead><tr><th>Student</th><th>Class</th><th class="tr">Due</th></tr></thead>
                  <tbody>
                    <% if (topDefaulters && topDefaulters.length > 0) { %>
                      <% topDefaulters.slice(0,4).forEach(d => { %>
                        <tr>
                          <td><%= d.first_name %> <%= d.last_name %></td>
                          <td><%= d.class_name %>-<%= d.section %></td>
                          <td class="tr red">₹<%= parseFloat(d.balance).toLocaleString('en-IN') %></td>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr><td colspan="3" class="empty-cell">No defaulters found ✓</td></tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="panel-v2">
            <div class="panel-v2-header">
              <div class="pv2-icon admission"><i class="fas fa-user-plus"></i></div>
              <div>
                <h4 class="pv2-title">Admissions Center</h4>
                <span class="pv2-sub">Requests &amp; Conversion Tracking</span>
              </div>
            </div>
            <div class="adm-stats-row">
              <div class="adm-kpi"><span class="adv-val"><%= admissionsStats.total %></span><span class="adv-lbl">Total</span></div>
              <div class="adm-kpi green"><span class="adv-val"><%= admissionsStats.approved %></span><span class="adv-lbl">Approved</span></div>
              <div class="adm-kpi amber"><span class="adv-val"><%= admissionsStats.pending %></span><span class="adv-lbl">Pending</span></div>
              <div class="adm-kpi blue"><span class="adv-val"><%= admissionsStats.total > 0 ? Math.round((admissionsStats.approved/admissionsStats.total)*100) : 0 %>%</span><span class="adv-lbl">Rate</span></div>
            </div>
            <div style="height:160px;" class="mt-4">
              <canvas id="admissionsChart" data-chart="line" data-color="green" data-label="Requests" data-labels='<%- JSON.stringify(admissionsTrend.map(t=>t.label)) %>' data-data='<%- JSON.stringify(admissionsTrend.map(t=>t.count)) %>'></canvas>
            </div>
          </div>
        </div>
        <div class="dash-right">
          <div class="panel-v2 mb-5">
            <div class="panel-v2-header">
              <div class="pv2-icon attendance"><i class="fas fa-calendar-check"></i></div>
              <div>
                <h4 class="pv2-title">Attendance Center</h4>
                <span class="pv2-sub">Today's Presence &amp; Risks</span>
              </div>
            </div>
            <div class="att-rings-row">
              <div class="att-ring-box">
                <svg width="80" height="80" viewBox="0 0 100 100">
                  <circle class="ring-bg" cx="50" cy="50" r="42"/>
                  <circle id="attendanceRing" class="ring-progress" cx="50" cy="50" r="42" data-pct="<%= todayAttendancePct %>" stroke="#3B82F6" stroke-dasharray="263.8" stroke-dashoffset="263.8"/>
                </svg>
                <div class="ring-inner"><span class="ring-value"><%= todayAttendancePct %>%</span></div>
                <span class="ring-lbl">Students</span>
              </div>
              <div class="att-ring-box">
                <svg width="80" height="80" viewBox="0 0 100 100">
                  <circle class="ring-bg" cx="50" cy="50" r="42"/>
                  <circle id="teacherAttendanceRing" class="ring-progress" cx="50" cy="50" r="42" data-pct="<%= teacherAttendancePct %>" stroke="#10B981" stroke-dasharray="263.8" stroke-dashoffset="263.8"/>
                </svg>
                <div class="ring-inner"><span class="ring-value"><%= teacherAttendancePct %>%</span></div>
                <span class="ring-lbl">Teachers</span>
              </div>
              <div class="att-breakdown">
                <% const totalStudentMarked = presentCount + absentCount + lateCount; %>
                <% if (totalStudentMarked > 0) { %>
                  <div class="ab-row"><span><span class="dot green"></span> Present</span><strong class="green"><%= presentCount %></strong></div>
                  <div class="ab-row"><span><span class="dot red"></span> Absent</span><strong class="red"><%= absentCount %></strong></div>
                  <div class="ab-row"><span><span class="dot amber"></span> Late</span><strong class="amber"><%= lateCount %></strong></div>
                <% } else { %>
                  <div class="ab-empty">Not marked yet</div>
                <% } %>
              </div>
            </div>
            <% if (lowAttendanceClass) { %>
              <div class="risk-banner mt-3">
                <i class="fas fa-exclamation-triangle"></i>
                <div><strong>Risk Alert</strong> — <%= lowAttendanceClass.class_name %>-<%= lowAttendanceClass.section %> dropped to <%= lowAttendanceClass.rate %>%</div>
              </div>
            <% } %>
            <div style="height:130px;" class="mt-4">
              <canvas id="attendanceTrendChart" data-labels='<%- JSON.stringify(attLabels) %>' data-data='<%- JSON.stringify(attData) %>'></canvas>
            </div>
          </div>
          <div class="panel-v2">
            <div class="panel-v2-header">
              <div class="pv2-icon notice"><i class="fas fa-stream"></i></div>
              <div>
                <h4 class="pv2-title">Live Activity Feed</h4>
                <span class="pv2-sub">Latest School Events</span>
              </div>
            </div>
            <div class="timeline-v2">
              <% if (timelineEvents && timelineEvents.length > 0) { %>
                <% timelineEvents.forEach(ev => { %>
                  <div class="tv2-item">
                    <div class="tv2-dot <%= ev.type %>"></div>
                    <div class="tv2-content">
                      <div class="tv2-title"><%= ev.title %></div>
                      <div class="tv2-text"><%= ev.text %></div>
                      <div class="tv2-time"><%= new Date(ev.created_at).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}) %></div>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="empty-feed">No recent activity logged</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <section class="dash-section mb-5">
        <div class="ds-header">
          <h3 class="ds-title">Recently Registered Students</h3>
          <a href="/schooladmin/students" class="ds-link">View Registry →</a>
        </div>
        <div class="students-scroll">
          <% if (recentStudents && recentStudents.length > 0) { %>
            <% recentStudents.forEach(st => { %>
              <div class="stu-card">
                <div class="stu-avatar"><%= st.first_name.charAt(0).toUpperCase() %></div>
                <div class="stu-info">
                  <h4><%= st.first_name %> <%= st.last_name %></h4>
                  <span class="stu-class">Class <%= st.className || '—' %> (<%= st.section || '—' %>)</span>
                  <div class="stu-meta">
                    <span>Roll: <strong><%= st.roll_no || '—' %></strong></span>
                    <span><%= new Date(st.admission_date).toLocaleDateString('en-GB') %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state-inline">No students found</div>
          <% } %>
        </div>
      </section>
      <div class="dash-triple mb-5">
        <div class="panel-v2 widget-bday">
          <h4 class="pv2-title mb-3"><i class="fas fa-gift" style="color:#ec4899"></i> Today's Birthdays</h4>
          <% if (birthdaysToday && birthdaysToday.length > 0) { %>
            <% birthdaysToday.forEach(b => { %>
              <div class="bday-item">
                <div class="bday-avatar"><%= b.first_name.charAt(0).toUpperCase() %></div>
                <div>
                  <div class="bday-name"><%= b.first_name %> <%= b.last_name %></div>
                  <span class="badge-role <%= b.role %>"><%= b.role.toUpperCase() %></span>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-bday"><i class="fas fa-birthday-cake"></i><p>No birthdays today</p></div>
          <% } %>
        </div>
        <div class="panel-v2 widget-insights">
          <h4 class="pv2-title mb-3"><i class="fas fa-lightbulb" style="color:#f59e0b"></i> Smart Insights</h4>
          <div class="insight-list">
            <div class="insight-box">
              <span class="in-lbl">Attendance</span>
              <p>Student attendance is <strong><%= todayAttendancePct %>%</strong> today. Teacher: <strong><%= teacherAttendancePct %>%</strong>.</p>
            </div>
            <div class="insight-box">
              <span class="in-lbl">Library</span>
              <% if (overdueLibraryCount > 0) { %>
                <p><strong class="red"><%= overdueLibraryCount %> overdue books</strong> pending return. Fine: ₹<%= parseFloat(pendingLibraryFines||0).toLocaleString('en-IN') %>.</p>
              <% } else { %>
                <p>All library books returned on time.</p>
              <% } %>
            </div>
            <div class="insight-box">
              <span class="in-lbl">PTM</span>
              <p><strong><%= upcomingPtmCount %> open PTM slots</strong> available. <strong><%= bookedPtmCount %> meetings</strong> confirmed.</p>
            </div>
            <div class="insight-box">
              <span class="in-lbl">Admissions</span>
              <p>Conversion rate at <strong><%= admissionsStats.total > 0 ? Math.round((admissionsStats.approved/admissionsStats.total)*100) : 0 %>%</strong>. <%= admissionsStats.pending %> requests pending.</p>
            </div>
          </div>
        </div>
        <div class="panel-v2 widget-subscription">
          <h4 class="pv2-title mb-3"><i class="fas fa-shield-alt" style="color:#7c3aed"></i> Subscription Center</h4>
          <div class="sub-stat-rows">
            <div class="sub-row"><span>Active Plan</span><strong class="violet"><%= (school.plan||'basic').toUpperCase() %></strong></div>
            <div class="sub-row"><span>Days Left</span><strong class="<%= daysRemaining <= 3 ? 'red' : 'green' %>"><%= daysRemaining %> days</strong></div>
          </div>
          <div class="sub-progress mt-3">
            <% const studentLimit = planLimits.max_students || planLimits.student_limit || null; %>
            <% const stPercent = studentLimit ? Math.min(100, Math.round((totalStudents/studentLimit)*100)) : 0; %>
            <div class="sp-row">
              <span>Students (<%= totalStudents %> / <%= studentLimit || 'Unlimited' %>)</span>
              <span><%= studentLimit ? stPercent+'%' : '∞' %></span>
            </div>
            <div class="sp-bar"><div class="sp-fill violet" style="width:'<%= studentLimit ? stPercent : 0 %>'"></div></div>
          </div>
          <div class="sub-progress mt-2">
            <% const teacherLimit = planLimits.max_teachers || planLimits.teacher_limit || null; %>
            <% const teachPercent = teacherLimit ? Math.min(100, Math.round((totalTeachers/teacherLimit)*100)) : 0; %>
            <div class="sp-row">
              <span>Teachers (<%= totalTeachers %> / <%= teacherLimit || 'Unlimited' %>)</span>
              <span><%= teacherLimit ? teachPercent+'%' : '∞' %></span>
            </div>
            <div class="sp-bar"><div class="sp-fill indigo" style="width:'<%= teacherLimit ? teachPercent : 0 %>'"></div></div>
          </div>
          <button class="sub-upgrade-btn mt-4" onclick="showUpgradeDrawer()">Upgrade Plan</button>
        </div>
      </div>
      <div class="dash-double mb-6">
        <div class="dash-half">
          <div class="panel-v2 mb-5">
            <h4 class="pv2-title mb-3"><i class="fas fa-bus" style="color:#f59e0b"></i> Transport Fleet</h4>
            <div class="transport-circles">
              <div class="ts-circ"><span class="ts-val"><%= activeVehiclesCount %></span><span class="ts-lbl">Buses</span></div>
              <div class="ts-circ"><span class="ts-val"><%= driverCount %></span><span class="ts-lbl">Drivers</span></div>
              <div class="ts-circ"><span class="ts-val"><%= libraryMembersCount %></span><span class="ts-lbl">Library Members</span></div>
            </div>
          </div>
          <div class="panel-v2">
            <h4 class="pv2-title mb-3"><i class="fas fa-graduation-cap" style="color:#6366f1"></i> Academic Summary</h4>
            <div class="ac-grid-4">
              <div class="ac-block"><span class="ac-val"><%= homeworkCount %></span><span class="ac-lbl">Homework</span></div>
              <div class="ac-block"><span class="ac-val"><%= homeworkSubmissionCount %></span><span class="ac-lbl">Submissions</span></div>
              <div class="ac-block"><span class="ac-val"><%= examCount %></span><span class="ac-lbl">Upcoming Exams</span></div>
              <div class="ac-block"><span class="ac-val"><%= publishedResultsCount %></span><span class="ac-lbl">Results Published</span></div>
            </div>
          </div>
        </div>
        <div class="dash-half">
          <div class="panel-v2 mb-5">
            <h4 class="pv2-title mb-3"><i class="fas fa-bolt" style="color:#eab308"></i> Quick Actions</h4>
            <div class="qa-grid">
              <% if (typeof hasFeature !== 'function' || hasFeature('students')) { %><a href="/schooladmin/students/add" class="qa-btn"><i class="fas fa-user-plus" style="color:#10b981"></i><span>Add Student</span></a><% } %>
              <% if (typeof hasFeature !== 'function' || hasFeature('teachers')) { %><a href="/schooladmin/teachers/add" class="qa-btn"><i class="fas fa-chalkboard-teacher" style="color:#3b82f6"></i><span>Add Teacher</span></a><% } %>
              <% if (typeof hasFeature !== 'function' || hasFeature('fees')) { %><a href="/schooladmin/fees/collect" class="qa-btn"><i class="fas fa-rupee-sign" style="color:#10b981"></i><span>Collect Fee</span></a><% } %>
              <a href="/schooladmin/notices/add" class="qa-btn"><i class="fas fa-bullhorn" style="color:#f59e0b"></i><span>Create Notice</span></a>
              <% if (typeof hasFeature !== 'function' || hasFeature('attendance')) { %><a href="/schooladmin/attendance" class="qa-btn"><i class="fas fa-calendar-check" style="color:#6366f1"></i><span>Attendance</span></a><% } %>
              <% if (typeof hasFeature !== 'function' || hasFeature('timetable')) { %><a href="/schooladmin/timetable" class="qa-btn"><i class="fas fa-calendar-alt" style="color:#ec4899"></i><span>Timetable</span></a><% } %>
              <% if (typeof hasFeature !== 'function' || hasFeature('exams')) { %><a href="/schooladmin/exams" class="qa-btn"><i class="fas fa-clipboard-list" style="color:#ef4444"></i><span>Create Exam</span></a><% } %>
              <a href="/schooladmin/analytics" class="qa-btn"><i class="fas fa-chart-pie" style="color:#06b6d4"></i><span>Reports</span></a>
            </div>
          </div>
          <div class="panel-v2">
            <h4 class="pv2-title mb-3"><i class="fas fa-calendar-alt" style="color:#3b82f6"></i> Upcoming Events</h4>
            <div class="events-list">
              <% if (upcomingEvents && upcomingEvents.length > 0) { %>
                <% upcomingEvents.forEach(ev => { %>
                  <div class="ev-item">
                    <div class="ev-dot" style="background:'<%= ev.color||'#3B82F6' %>'"></div>
                    <div class="ev-details">
                      <h5><%= ev.title %></h5>
                      <span><%= new Date(ev.start_date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %> · <%= ev.target_audience %></span>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="empty-events">No upcoming events</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="upgradeDrawer" class="lateral-drawer">
      <div class="drawer-overlay" onclick="closeUpgradeDrawer()"></div>
      <div class="drawer-content">
        <div class="drawer-header">
          <h4>Upgrade Subscription Plan</h4>
          <button class="close-drawer-btn" onclick="closeUpgradeDrawer()"><i class="fas fa-times"></i></button>
        </div>
        <div class="drawer-body p-6">
          <p class="text-gray-500 mb-6 text-sm">Select the plan that best fits your school size.</p>
          <div class="plan-card-option mb-4 border border-violet-200">
            <div class="plan-o-header"><span class="plan-name font-bold">Pro Plan</span><span class="plan-cost">₹1,999/mo</span></div>
            <p class="text-xs text-gray-400 mt-2">1000 Students, 100 Teachers, SMS, Transport fleet, Analytics.</p>
            <button class="btn btn-primary bg-violet-600 w-full mt-4 btn-sm">Select Pro</button>
          </div>
          <div class="plan-card-option border">
            <div class="plan-o-header"><span class="plan-name font-bold">Enterprise Plan</span><span class="plan-cost">Custom</span></div>
            <p class="text-xs text-gray-400 mt-2">Unlimited, custom domains, 24/7 account manager.</p>
            <button class="btn btn-secondary w-full mt-4 btn-sm">Contact Sales</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
<script src="/js/charts.js"></script>
<script src="/js/schooladmin.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const el = document.getElementById("currentDate");
        if (el) el.textContent = new Date().toLocaleDateString("en-IN", { weekday:"long", year:"numeric", month:"long", day:"numeric" });

        document.querySelectorAll(".ring-progress").forEach(ring => {
            const pct = Number(ring.dataset.pct || 0);
            const circumference = parseFloat(ring.getAttribute("stroke-dasharray") || "263.8");
            const offset = circumference * (1 - pct / 100);
            setTimeout(() => { ring.style.strokeDashoffset = offset; }, 200);
        });

        document.querySelectorAll(".counter").forEach(el => {
            const target = parseInt(el.dataset.target || el.textContent || "0", 10);
            let count = 0;
            const step = Math.max(1, Math.ceil(target / 40));
            const timer = setInterval(() => {
                count = Math.min(count + step, target);
                el.textContent = count.toLocaleString();
                if (count >= target) clearInterval(timer);
            }, 25);
        });

        let billingCycle = "monthly";
        document.querySelectorAll(".billing-switch button").forEach(btn => {
            btn.addEventListener("click", () => {
                billingCycle = btn.dataset.cycle || "monthly";
                document.querySelectorAll(".billing-switch button").forEach(b => b.classList.toggle("active", b === btn));
                document.querySelectorAll(".price-monthly").forEach(el => el.style.display = billingCycle === "monthly" ? "" : "none");
                document.querySelectorAll(".price-yearly").forEach(el => el.style.display = billingCycle === "yearly" ? "" : "none");
            });
        });

        document.querySelectorAll(".pay-plan-btn").forEach(button => {
            button.addEventListener("click", async () => {
                button.disabled = true;
                button.textContent = "Creating order...";
                try {
                    const orderRes = await fetch("/schooladmin/subscription/create-order", {
                        method: "POST",
                        headers: { "Content-Type": "application/json", "Accept": "application/json" },
                        body: JSON.stringify({ plan_id: button.dataset.planId, billing_cycle: billingCycle })
                    });
                    const orderJson = await orderRes.json();
                    if (!orderJson.success) throw new Error(orderJson.message || "Unable to create order.");
                    const data = orderJson.data;
                    const checkout = new Razorpay({
                        key: data.key_id,
                        amount: data.amount,
                        currency: data.currency,
                        order_id: data.order_id,
                        name: "SchoolSync",
                        description: data.plan ? data.plan.name : "School subscription",
                        remember_card: false,
                        method: { netbanking: true, card: true, wallet: true, upi: true, paylater: true },
                        prefill: { ...(data.prefill || {}), method: "" },
                        theme: { color: "#4338ca" },
                        modal: {
                            escape: false,
                            backdropclose: false,
                            ondismiss: () => {
                                fetch("/schooladmin/subscription/payment-failed", {
                                    method: "POST",
                                    headers: { "Content-Type": "application/json", "Accept": "application/json" },
                                    body: JSON.stringify({ razorpay_order_id: data.order_id, reason: "Checkout dismissed" })
                                }).catch(() => {});
                                alert("Payment was not completed. Please try Netbanking test mode or enable UPI in Razorpay Dashboard.");
                                button.disabled = false;
                                button.textContent = "Select Plan & Pay";
                            }
                        },
                        handler: async (response) => {
                            const verifyRes = await fetch("/schooladmin/subscription/verify-payment", {
                                method: "POST",
                                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                                body: JSON.stringify({ ...response, plan_id: button.dataset.planId, billing_cycle: billingCycle })
                            });
                            const verifyJson = await verifyRes.json();
                            if (!verifyJson.success) throw new Error("Payment verification failed.");
                            window.location.href = "/schooladmin/dashboard?payment=success";
                        }
                    });
                    checkout.open();
                } catch (error) {
                    alert(error.message || "Payment failed. Please try again.");
                    button.disabled = false;
                    button.textContent = "Select Plan & Pay";
                }
            });
        });
    });
</script>
</body>
</html>