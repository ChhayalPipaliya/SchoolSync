<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'School Admin Dashboard | SchoolSync', needsCharts: true }) %>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        h1, h2, h3, h4, h5, h6, .brand-text, .panel-title, .bento-value, .hero-stat-value, .amount { font-family: 'Outfit', sans-serif !important;}
        .dash-v2,
        .content.dash-v2,
        .schooladmin-theme .content.dash-v2,
        .schooladmin-theme .dash-v2 {
            padding: 24px !important;
            box-sizing: border-box !important;
        }
        .panel-v2{background:#fff;border-radius:16px;padding:16px;box-shadow:0 2px 18px rgba(15,23,42,.07);border:1px solid #f1f5f9;}
        .pv2-title{font-size:15px;font-weight:700;color:#1e293b;margin:0;}

        [data-theme="dark"] .panel-v2,
        [data-theme="dark"] .act-card,
        [data-theme="dark"] .kpi-tile,
        [data-theme="dark"] .fin-col,
        [data-theme="dark"] .sub-alert-bar,
        [data-theme="dark"] .att-card,
        [data-theme="dark"] .att-chart-card,
        [data-theme="dark"] .stu-card,
        [data-theme="dark"] .att-modal,
        [data-theme="dark"] .expired-demo-modal {
            background: #151D30 !important;
            border-color: #242F4D !important;
            color: #F1F5F9 !important;
