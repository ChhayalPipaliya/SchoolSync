<%- include('../../partials/head') %>
    <style>
        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-card {
            width: 100%;
            max-width: 480px;
            background: #ffffff;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, 0.25);
            border: 1px solid #E2E8F0;
            position: relative;
        }

        [data-theme="dark"] .text-gray-800,
        .light-mode-disabled .text-gray-800 {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .text-gray-700,
        .light-mode-disabled .text-gray-700 {
            color: #E2E8F0 !important;
        }

        [data-theme="dark"] .text-gray-900,
        .light-mode-disabled .text-gray-900 {
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .card,
        .light-mode-disabled .card,
        [data-theme="dark"] .table-card,
        .light-mode-disabled .table-card {
            background: #151D30 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .table-header-row,
        .light-mode-disabled .table-header-row {
            background: #101726 !important;
            border-bottom-color: #242F4D !important;
        }

        [data-theme="dark"] .table-heading,
        .light-mode-disabled .table-heading {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .data-table thead th,
        .light-mode-disabled .data-table thead th {
            background: #1E293B !important;
            border-color: #242F4D !important;
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .data-table tbody td,
        .light-mode-disabled .data-table tbody td {
            border-color: #242F4D !important;
            color: #E2E8F0 !important;
        }

        [data-theme="dark"] .data-table tbody td strong,
        .light-mode-disabled .data-table tbody td strong {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .data-table tbody tr:hover,
        .light-mode-disabled .data-table tbody tr:hover {
            background: #1E293B !important;
        }

        [data-theme="dark"] .modal-backdrop,
        .light-mode-disabled .modal-backdrop {
            background: rgba(0, 0, 0, 0.75) !important;
        }

        [data-theme="dark"] .modal-card,
        .light-mode-disabled .modal-card {
            background: #151D30 !important;
            border: 1px solid #242F4D !important;
            color: #F1F5F9 !important;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5) !important;
        }

        [data-theme="dark"] .modal-card h3,
        .light-mode-disabled .modal-card h3 {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .modal-card .form-label,
        .light-mode-disabled .modal-card .form-label {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .modal-card .form-input,
        .light-mode-disabled .modal-card .form-input,
        [data-theme="dark"] .modal-card .form-select,
        .light-mode-disabled .modal-card .form-select {
            background-color: #101726 !important;
            border-color: #334155 !important;
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .btn-secondary,
        .light-mode-disabled .btn-secondary {
            background: #1E293B !important;
            border-color: #334155 !important;
            color: #CBD5E1 !important;
        }

        [data-theme="dark"] .btn-secondary:hover,
        .light-mode-disabled .btn-secondary:hover {
            background: #242F4D !important;
            color: #F1F5F9 !important;
            border-color: #475569 !important;
        }
    </style>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: '/schooladmin/timetable' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-user-gear"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%= lan.Daily_Teacher_Substitutions || 'Daily Teacher Substitutions' %>
                                        </h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;">
                                            <%= lan.Substitutions_Subtitle
                                                || 'Manage class coverages and assign substitute teachers for absent staff'
                                                %>
                                        </p>
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                    <a href="/schooladmin/timetable" class="btn"
                                        style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                                        <i class="fa-solid fa-arrow-left"></i>
                                        <%= lan.Back_To_Timetable || 'Back to Timetable' %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div class="card"
                                style="border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                                <form method="GET" action="/schooladmin/timetable/substitutions"
                                    class="flex flex-wrap items-center gap-4">
                                    <div class="form-group mb-0">
                                        <label
                                            class="form-label font-bold text-[10px] text-gray-400 uppercase tracking-wider mb-1.5 block">
                                            <%= lan.Select_Date || 'Select Date' %>
                                        </label>
                                        <input type="date" name="date" value="<%= selectedDate %>"
                                            onchange="this.form.submit()" class="form-input w-48"
                                            style="height: 34px; font-size: 11px; border-radius: 6px;">
                                    </div>
                                    <div class="text-xs text-gray-500 mt-4">
                                        <%= lan.Day_Of_Week || 'Day of week' %>: <strong>
                                                <%= lan[dayOfWeek] || dayOfWeek %>
                                            </strong>
                                    </div>
                                </form>
                            </div>
                            <div class="table-card">
                                <div class="table-header-row">
                                    <h5 class="table-heading">
                                        <%= lan.Schedule_And_Coverage_For %>
                                            <%= selectedDate %>
                                    </h5>
                                </div>
                                <div class="table-container">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <%= lan.Class %>
                                                </th>
                                                <th>
                                                    <%= lan.Period_Time_Col %>
                                                </th>
                                                <th>
                                                    <%= lan.Subject %>
                                                </th>
                                                <th>
                                                    <%= lan.Original_Teacher %>
                                                </th>
                                                <th>
                                                    <%= lan.Status_Coverage %>
                                                </th>
                                                <th class="text-center" style="width:180px;">
                                                    <%= lan.Action %>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (slots.length===0) { %>
                                                <tr>
                                                    <td colspan="6" class="text-center text-gray-400 py-6">
                                                        <%= lan.No_Active_Lectures_Scheduled %>
                                                    </td>
                                                </tr>
                                                <% } else { %>
                                                    <% slots.forEach(slot=> { %>
                                                        <tr class="<%= slot.leave_id ? 'bg-rose-50/30' : '' %>">
                                                            <td><strong>
                                                                    <%= slot.class_name %> - <%= slot.section %>
                                                                </strong></td>
                                                            <td>
                                                                <span class="font-semibold text-gray-700">
                                                                    <%= slot.period_label %>
                                                                </span>
                                                                <div class="text-[10px] text-gray-400">
                                                                    <%= slot.start_time.slice(0,5) %> - <%=
                                                                            slot.end_time.slice(0,5) %>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <%= slot.subject_name %>
                                                            </td>
                                                            <td>
                                                                <%= slot.teacher_first_name ? (slot.teacher_first_name
                                                                    + ' ' + slot.teacher_last_name) : lan.No_Teacher %>
                                                                    <% if (slot.leave_id) { %>
                                                                        <div
                                                                            class="text-[10px] text-rose-500 font-semibold mt-0.5">
                                                                            <i
                                                                                class="fa-solid fa-plane-departure me-1"></i>
                                                                            <%= lan.On_Approved_Leave %>
                                                                        </div>
                                                                        <% } %>
                                                            </td>
                                                            <td>
                                                                <% if (slot.substitution_id) { %>
                                                                    <span class="badge badge-success mb-1">
                                                                        <i class="fa-solid fa-circle-check me-1"></i>
                                                                        <%= lan.Covered %>
                                                                    </span>
                                                                    <div class="text-xs text-emerald-700 font-semibold">
                                                                        <%= lan.Substituted_By %>: <%=
                                                                                slot.sub_first_name %>
                                                                                <%= slot.sub_last_name %>
                                                                    </div>
                                                                    <% if (slot.sub_reason) { %>
                                                                        <div class="text-[10px] text-gray-400 italic">
                                                                            <%= lan.Note %>: <%= slot.sub_reason %>
                                                                        </div>
                                                                        <% } %>
                                                                            <% } else if (slot.leave_id) { %>
                                                                                <span class="badge badge-danger">
                                                                                    <i
                                                                                        class="fa-solid fa-triangle-exclamation me-1"></i>
                                                                                    <%= lan.Action_Required %>
                                                                                </span>
                                                                                <% } else { %>
                                                                                    <span class="text-gray-400 text-sm">
                                                                                        <%= lan.Normal_Schedule %>
                                                                                    </span>
                                                                                    <% } %>
                                                            </td>
                                                            <td class="text-center">
                                                                <% if (slot.substitution_id) { %>
                                                                    <button disabled
                                                                        class="btn btn-secondary btn-sm opacity-50 cursor-not-allowed w-full">
                                                                        <%= lan.Assigned %>
                                                                    </button>
                                                                    <% } else { %>
                                                                        <button type="button"
                                                                            class="btn <%= slot.leave_id ? 'btn-primary' : 'btn-secondary' %> btn-sm w-full btn-cover-slot"
                                                                            data-timetable-id="<%= slot.timetable_id %>"
                                                                            data-teacher-id="<%= slot.teacher_id || '' %>"
                                                                            data-period-slot-id="<%= slot.period_slot_id %>"
                                                                            data-period-label="<%= slot.period_label %>"
                                                                            data-class-label="<%= slot.class_name %> - <%= slot.section %>">
                                                                            <i class="fa-solid fa-user-plus me-1"></i>
                                                                            <%= lan.Cover_Slot %>
                                                                        </button>
                                                                        <% } %>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>
    <div id="sub-modal" class="modal-backdrop" style="display: none;">
        <div class="modal-card">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="text-lg font-bold text-gray-900">
                        <%= lan.Assign_Substitute_Teacher %>
                    </h3>
                    <p class="text-xs text-gray-500 mt-1" id="sub-modal-subtitle"></p>
                </div>
                <button type="button" class="text-gray-400 hover:text-gray-600 font-semibold text-xl"
                    onclick="closeSubModal()" style="border:none;background:none;cursor:pointer;">×</button>
            </div>
            <form action="/schooladmin/timetable/substitutions/save" method="POST">
                <input type="hidden" name="timetable_id" id="sub-timetable-id">
                <input type="hidden" name="original_teacher_id" id="sub-original-teacher-id">
                <input type="hidden" name="period_slot_id" id="sub-period-slot-id">
                <input type="hidden" name="date" value="<%= selectedDate %>">
                <div class="form-group mb-3">
                    <label class="form-label font-bold">
                        <%= lan.Select_Available_Substitute %>
                    </label>
                    <select name="substitute_teacher_id" id="sub-teacher-select" required class="form-select w-full">
                        <option value="">
                            <%= lan.Choose_Substitute_Teacher %>
                        </option>
                    </select>
                    <p id="sub-empty-message" class="text-[11px] text-rose-500 mt-1 hidden">
                        <%= lan.No_Available_Substitutes_Found %>
                    </p>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">
                        <%= lan.Reason_Substitution_Note %>
                    </label>
                    <input type="text" name="reason" placeholder="e.g. Teacher leave coverage"
                        class="form-input w-full">
                </div>
                <div class="flex gap-3 justify-end pt-2">
                    <button type="button" class="btn btn-secondary" onclick="closeSubModal()">
                        <%= lan.Cancel %>
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <%= lan.Assign_Substitute %>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <script>
        function openSubModal(timetableId, originalTeacherId, periodSlotId, periodLabel, classLabel) {
            document.getElementById('sub-timetable-id').value = timetableId;
            document.getElementById('sub-original-teacher-id').value = originalTeacherId;
            document.getElementById('sub-period-slot-id').value = periodSlotId;
            document.getElementById('sub-modal-subtitle').textContent = classLabel + ' | ' + periodLabel;

            loadAvailableSubstitutes(originalTeacherId, periodSlotId, timetableId);
            document.getElementById('sub-modal').style.display = 'flex';
        }

        function closeSubModal() {
            document.getElementById('sub-modal').style.display = 'none';
        }

        document.getElementById('sub-modal').addEventListener('click', function (e) {
            if (e.target === this) closeSubModal();
        });

        function loadAvailableSubstitutes(originalTeacherId, periodSlotId, timetableId) {
            const select = document.getElementById('sub-teacher-select');
            const emptyMsg = document.getElementById('sub-empty-message');
            const date = '<%= selectedDate %>';
            const dayOfWeek = '<%= dayOfWeek %>';

            select.innerHTML = '<option value=""><%= lan.Loading_Available_Teachers %></option>';
            emptyMsg.classList.add('hidden');

            fetch(`/schooladmin/timetable/substitutions/available-teachers?teacher_id=${originalTeacherId}&day_of_week=${dayOfWeek}&period_slot_id=${periodSlotId}&date=${date}&timetable_id=${timetableId}`)
                .then(r => r.json())
                .then(data => {
                    select.innerHTML = '<option value=""><%= lan.Choose_Substitute_Teacher %></option>';
                    if (!data.success || !data.teachers || data.teachers.length === 0) {
                        emptyMsg.classList.remove('hidden');
                        select.disabled = true;
                        return;
                    }
                    select.disabled = false;
                    data.teachers.forEach(t => {
                        const option = document.createElement('option');
                        option.value = t.id;
                        option.textContent = [t.first_name, t.last_name].filter(Boolean).join(' ');
                        select.appendChild(option);
                    });
                })
                .catch(() => {
                    select.innerHTML = '<option value=""><%= lan.Choose_Substitute_Teacher %></option>';
                    select.disabled = true;
                    emptyMsg.textContent = '<%= lan.Failed_To_Load_Substitutes %>';
                    emptyMsg.classList.remove('hidden');
                });
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.btn-cover-slot').forEach(btn => {
                btn.addEventListener('click', function () {
                    const timetableId = this.getAttribute('data-timetable-id');
                    const originalTeacherId = this.getAttribute('data-teacher-id');
                    const periodSlotId = this.getAttribute('data-period-slot-id');
                    const periodLabel = this.getAttribute('data-period-label');
                    const classLabel = this.getAttribute('data-class-label');
                    openSubModal(timetableId, originalTeacherId, periodSlotId, periodLabel, classLabel);
                });
            });
        });
    </script>