<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/timetable' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%= lan.Publish_Validation_Failed || 'Publish Validation' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%= lan.Publish_Blocked_Validation_Errors || 'Review validation warnings before publishing timetable' %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <a href="/schooladmin/timetable" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%= lan.Back_To_Timetable || 'Back to Timetable' %>
                        </a>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="card border border-rose-100 bg-rose-50/10 p-5 rounded-lg shadow-sm">
                    <div class="flex items-center gap-2 text-rose-700 font-bold mb-3">
                        <i class="fa-solid fa-circle-exclamation text-lg"></i>
                        <span><%= lan.Blocking_Errors %> (<%= validation.errors.length %>)</span>
                    </div>
                    <% if (validation.errors.length === 0) { %>
                        <p class="text-sm text-gray-500 italic"><%= lan.No_Blocking_Errors_Found %></p>
                    <% } else { %>
                        <ul class="space-y-2">
                            <% validation.errors.forEach(err => { %>
                                <li class="text-sm text-rose-700 bg-rose-50 border border-rose-100 px-3 py-2 rounded">
                                    <%= err %>
                                </li>
                            <% }) %>
                        </ul>
                    <% } %>
                </div>
                <div class="card border border-amber-100 bg-amber-50/10 p-5 rounded-lg shadow-sm">
                    <div class="flex items-center gap-2 text-amber-700 font-bold mb-3">
                        <i class="fa-solid fa-person-circle-exclamation text-lg"></i>
                        <span><%= lan.Teacher_Workload_Problems %> (<%= validation.teacherWorkloadProblems.length %>)</span>
                    </div>
                    <% if (validation.teacherWorkloadProblems.length === 0) { %>
                        <p class="text-sm text-gray-500 italic"><%= lan.No_Teacher_Workload_Issues %></p>
                    <% } else { %>
                        <ul class="space-y-2">
                            <% validation.teacherWorkloadProblems.forEach(prob => { %>
                                <li class="text-sm text-amber-700 bg-amber-50 border border-amber-100 px-3 py-2 rounded">
                                    <%= prob %>
                                </li>
                            <% }) %>
                        </ul>
                    <% } %>
                </div>
                <div class="card border border-yellow-100 bg-yellow-50/10 p-5 rounded-lg shadow-sm">
                    <div class="flex items-center gap-2 text-yellow-700 font-bold mb-3">
                        <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                        <span><%= lan.Warnings_Workload_Mismatches %> (<%= validation.warnings.length %>)</span>
                    </div>
                    <% if (validation.warnings.length === 0) { %>
                        <p class="text-sm text-gray-500 italic"><%= lan.No_Warnings_Found %></p>
                    <% } else { %>
                        <ul class="space-y-2">
                            <% validation.warnings.forEach(warn => { %>
                                <li class="text-sm text-yellow-800 bg-yellow-50/50 border border-yellow-100 px-3 py-2 rounded">
                                    <%= warn %>
                                </li>
                            <% }) %>
                        </ul>
                    <% } %>
                </div>
                <div class="card border border-gray-100 p-5 rounded-lg shadow-sm bg-white">
                    <div class="flex items-center gap-2 text-gray-800 font-bold mb-4">
                        <i class="fa-solid fa-school text-lg"></i>
                        <span><%= lan.Classes_Completion_Summary %></span>
                    </div>
                    <div class="mb-4">
                        <div class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-2"><%= lan.Incomplete_Classes %> (<%= validation.incompleteClasses.length %>)</div>
                        <% if (validation.incompleteClasses.length === 0) { %>
                            <p class="text-sm text-gray-500 italic"><%= lan.None %></p>
                        <% } else { %>
                            <div class="flex flex-wrap gap-2">
                                <% validation.incompleteClasses.forEach(cls => { %>
                                    <span class="badge badge-secondary px-3 py-1 rounded bg-gray-100 text-gray-700 font-medium border border-gray-200">
                                        <%= cls %>
                                    </span>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                    <div>
                        <div class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-2"><%= lan.Completed_Classes %> (<%= validation.completedClasses.length %>)</div>
                        <% if (validation.completedClasses.length === 0) { %>
                            <p class="text-sm text-gray-500 italic"><%= lan.None %></p>
                        <% } else { %>
                            <div class="flex flex-wrap gap-2">
                                <% validation.completedClasses.forEach(cls => { %>
                                    <span class="badge badge-success px-3 py-1 rounded bg-emerald-50 text-emerald-700 font-medium border border-emerald-100">
                                        <%= cls %>
                                    </span>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
