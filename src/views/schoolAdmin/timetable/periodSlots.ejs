<%- include('../../partials/head') %>
<style>
    [data-theme="dark"] .text-gray-800,
    .light-mode-disabled .text-gray-800 {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .text-gray-700,
    .light-mode-disabled .text-gray-700 {
        color: #E2E8F0 !important;
    }
    [data-theme="dark"] .table-card,
    .light-mode-disabled .table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table-header-row,
    .light-mode-disabled .table-header-row {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .table-heading,
    .light-mode-disabled .table-heading {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .data-table thead th,
    .light-mode-disabled .data-table thead th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .data-table tbody td,
    .light-mode-disabled .data-table tbody td {
        border-color: #242F4D !important;
        color: #E2E8F0 !important;
    }
    [data-theme="dark"] .btn-secondary,
    .light-mode-disabled .btn-secondary {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .btn-secondary:hover,
    .light-mode-disabled .btn-secondary:hover {
        background: #242F4D !important;
        color: #F1F5F9 !important;
        border-color: #475569 !important;
    }

    @media (max-width: 768px) {
        .content { padding: 12px 10px !important; }
        .table-container { overflow-x: auto; }
        .data-table { min-width: 580px; }
        .data-table th, .data-table td { padding: 8px 10px; font-size: 12px; }
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%= lan.Period_Slots || 'Period Slots' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%= lan.Configure_Period_Slots_Desc || 'Configure school timings, class durations, and breaks for Academic Year' %>: <strong><%= activeYear.code %></strong></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <a href="/schooladmin/timetable" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%= lan.Timetable || 'Timetable' %>
                        </a>
                        <a href="/schooladmin/timetable/period-slots/add" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fa-solid fa-plus"></i> <%= lan.Add_Period_Slot || 'Add Period Slot' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="table-card">
                <div class="table-header-row">
                    <div>
                        <h5 class="table-heading"><%= lan.All_Period_Slots %></h5>
                        <span style="font-size:12px;color:#94A3B8;"><%= periods.length %> <%= lan.Period_Slots_Configured_For %> <%= activeYear.code %></span>
                    </div>
                </div>
                <div class="table-container">
                    <% if (periods.length === 0) { %>
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                            <h6 class="empty-state-title"><%= lan.No_Period_Slots_Defined %></h6>
                            <p class="empty-state-text"><%= lan.Create_Class_Timings_Desc %></p>
                            <a href="/schooladmin/timetable/period-slots/add" class="btn btn-primary mt-3"><%= lan.Add_Period_Slot %></a>
                        </div>
                    <% } else { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th><%= lan.Period_No %></th>
                                    <th><%= lan.Label %></th>
                                    <th><%= lan.Time_Range %></th>
                                    <th><%= lan.Slot_Type %></th>
                                    <th><%= lan.Teaching_Period %></th>
                                    <th><%= lan.Sort_Order %></th>
                                    <th class="text-center" style="width:120px;"><%= lan.Actions %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% periods.forEach(period => { %>
                                    <tr>
                                        <td><strong><%= period.period_number %></strong></td>
                                        <td style="font-weight:600;"><%= period.label %></td>
                                        <td><%= period.start_time.slice(0, 5) %> - <%= period.end_time.slice(0, 5) %></td>
                                        <td>
                                            <span class="text-capitalize text-sm font-semibold text-gray-700">
                                                <%= (period.slot_type || 'teaching').replace('_', ' ') %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (period.is_teaching_period) { %>
                                                <span class="badge badge-success"><%= lan.Yes %></span>
                                            <% } else { %>
                                                <span class="badge badge-warning"><%= lan.No %></span>
                                            <% } %>
                                        </td>
                                        <td><%= period.sort_order %></td>
                                        <td class="text-center">
                                            <div class="flex items-center justify-center gap-2">
                                                <a href="/schooladmin/timetable/period-slots/edit/<%= period.id %>" class="btn-icon" title="<%= lan.Edit %>">
                                                    <i class="fa-solid fa-pencil"></i>
                                                </a>
                                                <form action="/schooladmin/timetable/period-slots/delete/<%= period.id %>" method="POST" style="display:inline;" onsubmit="return confirm('<%= lan.Delete_Period_Slot_Permanent_Confirm %>')">
                                                    <button type="submit" class="btn-icon btn-danger-icon" title="<%= lan.Delete %>">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
