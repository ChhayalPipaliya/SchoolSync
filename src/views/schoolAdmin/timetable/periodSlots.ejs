<%- include('../../partials/head') %>
<style>
    [data-theme="dark"] .text-gray-800,
    .light-mode-disabled .text-gray-800 {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .text-gray-700,
    .light-mode-disabled .text-gray-700 {
        color: #E2E8F0 !important;
    }
    [data-theme="dark"] .table-card,
    .light-mode-disabled .table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table-header-row,
    .light-mode-disabled .table-header-row {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .table-heading,
    .light-mode-disabled .table-heading {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .data-table thead th,
    .light-mode-disabled .data-table thead th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .data-table tbody td,
    .light-mode-disabled .data-table tbody td {
        border-color: #242F4D !important;
        color: #E2E8F0 !important;
    }
    [data-theme="dark"] .btn-secondary,
    .light-mode-disabled .btn-secondary {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .btn-secondary:hover,
    .light-mode-disabled .btn-secondary:hover {
        background: #242F4D !important;
        color: #F1F5F9 !important;
        border-color: #475569 !important;
    }

    @media (max-width: 768px) {
        .content { padding: 12px 10px !important; }
        .table-container { overflow-x: auto; }
        .data-table { min-width: 580px; }
        .data-table th, .data-table td { padding: 8px 10px; font-size: 12px; }
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Period Slots</h2>
                    <p class="text-xs text-gray-500 mt-1">Configure school timings, class durations, and breaks for Academic Year: <strong><%= activeYear.code %></strong></p>
                </div>
                <div class="flex gap-2">
                    <a href="/schooladmin/timetable" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> View Timetable
                    </a>
                    <a href="/schooladmin/timetable/period-slots/add" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> Add Period Slot
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="table-card">
                <div class="table-header-row">
                    <div>
                        <h5 class="table-heading">All Period Slots</h5>
                        <span style="font-size:12px;color:#94A3B8;"><%= periods.length %> period slots configured for <%= activeYear.code %></span>
                    </div>
                </div>
                <div class="table-container">
                    <% if (periods.length === 0) { %>
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                            <h6 class="empty-state-title">No period slots defined</h6>
                            <p class="empty-state-text">Create your class timings to start building the weekly timetable.</p>
                            <a href="/schooladmin/timetable/period-slots/add" class="btn btn-primary mt-3">Add Period Slot</a>
                        </div>
                    <% } else { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Period #</th>
                                    <th>Label</th>
                                    <th>Time Range</th>
                                    <th>Slot Type</th>
                                    <th>Teaching Period</th>
                                    <th>Sort Order</th>
                                    <th class="text-center" style="width:120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% periods.forEach(period => { %>
                                    <tr>
                                        <td><strong><%= period.period_number %></strong></td>
                                        <td style="font-weight:600;"><%= period.label %></td>
                                        <td><%= period.start_time.slice(0, 5) %> - <%= period.end_time.slice(0, 5) %></td>
                                        <td>
                                            <span class="text-capitalize text-sm font-semibold text-gray-700">
                                                <%= (period.slot_type || 'teaching').replace('_', ' ') %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (period.is_teaching_period) { %>
                                                <span class="badge badge-success">Yes</span>
                                            <% } else { %>
                                                <span class="badge badge-warning">No</span>
                                            <% } %>
                                        </td>
                                        <td><%= period.sort_order %></td>
                                        <td class="text-center">
                                            <div class="flex items-center justify-center gap-2">
                                                <a href="/schooladmin/timetable/period-slots/edit/<%= period.id %>" class="btn-icon" title="Edit">
                                                    <i class="fa-solid fa-pencil"></i>
                                                </a>
                                                <form action="/schooladmin/timetable/period-slots/delete/<%= period.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this period slot? This action cannot be undone.')">
                                                    <button type="submit" class="btn-icon btn-danger-icon" title="Delete">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>