<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= lan.Add_Period_Slot %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%= lan.Period_Slots_Subtitle %></p>
                </div>
                <a href="/schooladmin/timetable/period-slots" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> <%= lan.Back_To_Slots %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card">
                <div class="card-header border-b border-gray-100 pb-4">
                    <h3 class="card-title font-bold text-gray-800"><i class="fa-solid fa-plus-circle text-emerald-600 me-2"></i><%= lan.New_Period_Details %></h3>
                </div>
                <div class="card-body pt-6">
                    <form action="/schooladmin/timetable/period-slots" method="POST">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="form-group">
                                <label class="form-label form-label-required"><%= lan.Period_Number %></label>
                                <input type="number" name="period_number" min="1" max="20" required placeholder="e.g. 1" class="form-input">
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required"><%= lan.Label %></label>
                                <input type="text" name="label" required placeholder="e.g. Period 1, Lunch Break" class="form-input">
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required"><%= lan.Start_Time %></label>
                                <input type="time" name="start_time" required class="form-input">
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required"><%= lan.End_Time %></label>
                                <input type="time" name="end_time" required class="form-input">
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required"><%= lan.Slot_Type %></label>
                                <select name="slot_type" id="slot_type" required class="form-select w-full">
                                    <option value="teaching"><%= lan.Regular_Teaching_Period %></option>
                                    <option value="short_break"><%= lan.Short_Break %></option>
                                    <option value="lunch_break"><%= lan.Lunch_Break %></option>
                                    <option value="assembly"><%= lan.Assembly %></option>
                                    <option value="activity"><%= lan.Activity_Period %></option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label"><%= lan.Sort_Order %></label>
                                <input type="number" name="sort_order" placeholder="Defaults to period number" class="form-input">
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 mt-6 border-t border-gray-100 pt-5">
                            <a href="/schooladmin/timetable/period-slots" class="btn btn-secondary"><%= lan.Cancel %></a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-save me-1"></i> <%= lan.Save_Period_Slot %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
