<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Add Period Slot</h2>
                    <p class="text-xs text-gray-500 mt-1">Define school timings, breaks, and lecture periods</p>
                </div>
                <a href="/schooladmin/timetable/period-slots" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Slots
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card">
                <div class="card-header border-b border-gray-100 pb-4">
                    <h3 class="card-title font-bold text-gray-800"><i class="fa-solid fa-plus-circle text-emerald-600 me-2"></i>New Period Details</h3>
                </div>
                <div class="card-body pt-6">
                    <form action="/schooladmin/timetable/period-slots" method="POST">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="form-group">
                                <label class="form-label form-label-required">Period Number</label>
                                <input type="number" name="period_number" min="1" max="20" required placeholder="e.g. 1" class="form-input">
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required">Label</label>
                                <input type="text" name="label" required placeholder="e.g. Period 1, Lunch Break" class="form-input">
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required">Start Time</label>
                                <input type="time" name="start_time" required class="form-input">
                            </div>
                            <div class="form-group">
                                <label class="form-label form-label-required">End Time</label>
                                <input type="time" name="end_time" required class="form-input">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Sort Order</label>
                                <input type="number" name="sort_order" placeholder="Defaults to period number" class="form-input">
                            </div>
                            <div class="form-group flex items-center md:col-span-2 mt-2">
                                <label class="inline-flex items-center cursor-pointer select-none">
                                    <input type="checkbox" name="is_break" value="1" class="rounded border-gray-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                    <span class="ml-2 text-sm text-gray-600 font-medium">Mark this slot as break / lunch period</span>
                                </label>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 mt-6 border-t border-gray-100 pt-5">
                            <a href="/schooladmin/timetable/period-slots" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-save me-1"></i> Save Period Slot
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
