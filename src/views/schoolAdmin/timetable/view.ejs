<%- include('../../partials/head') %>
<style>
    .timetable-grid thead th {
        white-space: nowrap;
    }

    .today-highlight {
        background: var(--primary-light) !important;
        color: var(--primary) !important;
    }

    .today-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--primary);
        margin-top: 2px;
        text-transform: none;
    }

    .timetable-period-cell {
        min-width: 160px;
        background: #f8fafc;
        border-right: 1px solid #e2e8f0;
    }

    .timetable-day-cell {
        min-width: 150px;
        padding: 12px !important;
        vertical-align: top;
    }

    .timetable-cell {
        position: relative;
        min-height: 84px;
        border-radius: 12px;
        padding: 14px 12px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .timetable-cell.cell-empty {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
    }

    .timetable-cell.cell-empty:hover {
        background: var(--primary-light);
        border-color: var(--primary);
    }

    .timetable-cell.cell-filled {
        background: var(--primary-light);
        border: 1px solid rgba(5, 150, 105, 0.2);
        box-shadow: inset 0 0 0 1px rgba(5, 150, 105, 0.03);
    }

    .timetable-cell.cell-filled:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 22px var(--primary-glow, rgba(5, 150, 105, 0.15));
    }

    .timetable-cell.cell-readonly {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        cursor: default;
        opacity: 0.75;
    }

    .cell-empty-label {
        height: 100%;
        min-height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary);
        font-size: 12px;
        font-weight: 600;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .timetable-cell.cell-empty:hover .cell-empty-label {
        opacity: 1;
    }

    .cell-subject {
        color: var(--primary-dark);
        font-size: 12px;
        font-weight: 700;
        line-height: 1.4;
        margin-bottom: 4px;
        padding-right: 22px;
    }

    .cell-teacher {
        color: var(--primary);
        font-size: 12px;
        line-height: 1.4;
        margin-bottom: 0;
    }

    .clear-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 20px;
        height: 20px;
        border: none;
        border-radius: 999px;
        background: #fee2e2;
        color: #dc2626;
        display: none;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        cursor: pointer;
        padding: 0;
        line-height: 1;
    }

    .timetable-cell.cell-filled:hover .clear-btn {
        display: inline-flex;
    }

    .break-cell {
        min-height: 84px;
        border-radius: 12px;
        background: #fef3c7;
        border: 1px solid #fde68a;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #b45309;
        font-size: 12px;
        font-weight: 700;
    }

    .timetable-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(15, 23, 42, 0.42);
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .timetable-modal-card {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.20);
    }

    @media (max-width: 768px) {
        .timetable-grid {
            min-width: 920px;
        }
    }
</style>

<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">

            <!-- Page Heading -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Timetable</h2>
                    <p class="text-xs text-gray-500 mt-1">Create and manage class-wise timetables</p>
                </div>
                <div class="flex gap-2 flex-wrap">
                    <a href="/schooladmin/timetable/period-slots" class="btn btn-secondary">
                        <i class="fa-solid fa-clock me-1"></i> Period Slots
                    </a>
                    <a href="/schooladmin/timetable/working-days" class="btn btn-secondary">
                        <i class="fa-solid fa-gears me-1"></i> Settings
                    </a>
                    <a href="/schooladmin/timetable/substitutions" class="btn btn-secondary">
                        <i class="fa-solid fa-user-gear me-1"></i> Substitutions
                    </a>
                </div>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Class Selector + Info Row -->
            <div class="card p-5 mb-5">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-end">
                    <div class="lg:col-span-4">
                        <form method="GET" action="/schooladmin/timetable">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-1.5">Select Class</label>
                            <select name="class_id" onchange="this.form.submit()" class="form-select">
                                <option value="">-- Choose a class --</option>
                                <% classes.forEach(cls => { %>
                                    <option value="<%= cls.id %>" <%= selectedClassId == cls.id ? 'selected' : '' %>>
                                        <%= cls.label || (cls.class_name + (cls.section ? ' - Section ' + cls.section : '')) %>
                                    </option>
                                <% }) %>
                            </select>
                        </form>
                    </div>
                    <div class="lg:col-span-5">
                        <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1">Current View</div>
                        <div class="font-bold text-gray-800">
                            <%= selectedClass ? (selectedClass.label || selectedClass.class_name) : 'No class selected' %>
                            <% if (selectedClass && selectedClass.section) { %>
                                <span class="badge badge-role-success ml-2">Section <%= selectedClass.section %></span>
                            <% } %>
                            <% if (selectedVersion) { %>
                                <% if (selectedVersion.status === 'draft') { %>
                                    <span class="badge ml-2" style="background:#fffbeb;color:#b45309;border:1px solid #fcd34d;font-size:11px;">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Draft V<%= selectedVersion.version_number %>
                                    </span>
                                <% } else if (selectedVersion.status === 'published') { %>
                                    <span class="badge badge-success ml-2" style="font-size:11px;">
                                        <i class="fa-solid fa-circle-check me-1"></i> Published V<%= selectedVersion.version_number %>
                                    </span>
                                <% } %>
                            <% } %>
                        </div>
                        <div class="text-xs text-gray-400 mt-1">
                            <% if (selectedClassId) { %>
                                <% if (selectedVersion && selectedVersion.status === 'draft') { %>
                                    Click any cell below to assign subject and teacher.
                                <% } else if (selectedVersion && selectedVersion.status === 'published') { %>
                                    Published timetable &mdash; create a draft to make changes.
                                <% } else { %>
                                    Click any cell to start building the timetable.
                                <% } %>
                            <% } else { %>
                                Choose a class to start editing the timetable.
                            <% } %>
                        </div>
                    </div>
                    <div class="lg:col-span-3 flex gap-2 justify-end flex-wrap">
                        <% if (selectedClassId) { %>
                            <% if (!selectedVersion) { %>
                                <form action="/schooladmin/timetable/versions/create-draft" method="POST" style="display:inline;">
                                    <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                                    <input type="hidden" name="academic_year_id" value="<%= selectedAcademicYearId %>">
                                    <input type="hidden" name="term_id" value="<%= selectedTermId %>">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-plus"></i> Create Draft
                                    </button>
                                </form>
                            <% } else if (selectedVersion.status === 'draft') { %>
                                <form action="/schooladmin/timetable/versions/<%= selectedVersion.id %>/publish" method="POST" style="display:inline;" onsubmit="return confirm('Publish this timetable? It will become the active schedule for this class.')">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-circle-check"></i> Publish
                                    </button>
                                </form>
                            <% } else if (selectedVersion.status === 'published') { %>
                                <form action="/schooladmin/timetable/versions/create-draft" method="POST" style="display:inline;">
                                    <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                                    <input type="hidden" name="academic_year_id" value="<%= selectedAcademicYearId %>">
                                    <input type="hidden" name="term_id" value="<%= selectedTermId %>">
                                    <button type="submit" class="btn btn-secondary">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit (Draft)
                                    </button>
                                </form>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (!selectedClassId) { %>
                <div class="card text-center py-16">
                    <div class="empty-state">
                        <div class="empty-state-icon" style="background: var(--primary-light); color: var(--primary);">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                        <h3 class="empty-state-title">Select a class to view the timetable</h3>
                        <p class="empty-state-text">Once you choose a class, you can manage every period directly from the grid.</p>
                        <% if (periods.length === 0) { %>
                            <div class="mt-3 text-xs text-amber-600">
                                No period slots found.
                                <a href="/schooladmin/timetable/period-slots/add" class="text-emerald-600 font-semibold hover:underline ml-1">Add periods first</a>
                            </div>
                        <% } %>
                    </div>
                </div>

            <% } else if (periods.length === 0) { %>
                <div class="card text-center py-16">
                    <div class="empty-state">
                        <div class="empty-state-icon" style="background: #FFF7ED; color: #EA580C;">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                        <h3 class="empty-state-title">No period slots configured yet</h3>
                        <p class="empty-state-text">Add your school periods first, then the timetable grid will be ready.</p>
                        <a href="/schooladmin/timetable/period-slots/add" class="btn btn-primary btn-sm mt-3">
                            <i class="fa-solid fa-plus"></i> Add Period Slots
                        </a>
                    </div>
                </div>

            <% } else { %>
                <div class="table-card">
                    <div class="table-header-row">
                        <div>
                            <h3 class="table-heading">
                                <%= selectedClass ? (selectedClass.label || selectedClass.class_name) : 'Timetable Grid' %>
                                <% if (selectedClass && selectedClass.section) { %>
                                    <span class="text-gray-400 font-normal text-sm ml-1">Section <%= selectedClass.section %></span>
                                <% } %>
                            </h3>
                            <div class="text-xs text-gray-400 mt-1">
                                <%= periods.length %> periods across <%= days.length %> days
                            </div>
                        </div>
                        <div class="text-xs text-gray-400">
                            <% if (selectedVersion && selectedVersion.status === 'draft') { %>
                                Tap any timetable cell to assign or update a period.
                            <% } else if (selectedVersion && selectedVersion.status === 'published') { %>
                                <i class="fa-solid fa-lock me-1"></i> Published &mdash; create a draft to edit
                            <% } %>
                        </div>
                    </div>
                    <div class="table-container">
                        <table class="data-table timetable-grid">
                            <thead>
                                <tr>
                                    <th style="width:180px;">Period / Day</th>
                                    <% days.forEach(day => { %>
                                        <th class="text-center <%= (typeof todayName !== 'undefined' && day === todayName) ? 'today-highlight' : '' %>">
                                            <%= day %>
                                            <% if (typeof todayName !== 'undefined' && day === todayName) { %>
                                                <div class="today-label">Today</div>
                                            <% } %>
                                        </th>
                                    <% }) %>
                                </tr>
                            </thead>
                            <tbody>
                                <% const canEdit = selectedVersion && selectedVersion.status === 'draft'; %>
                                <% periods.forEach(period => { %>
                                    <tr>
                                        <td class="timetable-period-cell">
                                            <div style="font-size:13px;font-weight:700;color:#1E293B;"><%= period.label %></div>
                                            <div style="font-size:12px;color:#64748B;margin-top:4px;"><%= period.start_time.slice(0,5) %> - <%= period.end_time.slice(0,5) %></div>
                                            <% if (period.is_break || !period.is_teaching_period) { %>
                                                <div style="margin-top:8px;">
                                                    <span style="background:#FEF3C7;color:#B45309;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;">Break</span>
                                                </div>
                                            <% } %>
                                        </td>

                                        <% days.forEach(day => { %>
                                            <% const entry = timetableGrid[day] && timetableGrid[day][period.id]; %>
                                            <% const cellId = `cell-${day}-${period.id}`; %>
                                            <td class="timetable-day-cell">
                                                <% if (period.is_break || !period.is_teaching_period) { %>
                                                    <div class="break-cell">Break Time</div>
                                                <% } else { %>
                                                    <div
                                                        id="<%= cellId %>"
                                                        class="timetable-cell <%= entry ? 'cell-filled' : (canEdit ? 'cell-empty' : 'cell-readonly') %>"
                                                        data-entry-id="<%= entry ? entry.id : '' %>"
                                                        data-subject-id="<%= entry ? (entry.subject_id || '') : '' %>"
                                                        data-teacher-id="<%= entry ? (entry.teacher_id || '') : '' %>"
                                                        data-subject-name="<%= entry ? (entry.subject_name || '') : '' %>"
                                                        data-teacher-name="<%= entry ? ([entry.teacher_first_name, entry.teacher_last_name].filter(Boolean).join(' ')) : '' %>"
                                                        <% if (canEdit) { %>onclick="openCellModal('<%= day %>', '<%= period.id %>', '<%= period.label %>', '<%= selectedClassId %>', '<%= cellId %>')"<% } %>>

                                                        <% if (entry) { %>
                                                            <div class="cell-subject"><%= entry.subject_name || '—' %></div>
                                                            <div class="cell-teacher"><%= (entry.teacher_first_name ? entry.teacher_first_name + ' ' + (entry.teacher_last_name || '') : 'No teacher').trim() %></div>
                                                            <% if (canEdit) { %>
                                                                <button type="button" onclick="event.stopPropagation(); clearCell('<%= day %>','<%= period.id %>','<%= selectedClassId %>','<%= cellId %>', '<%= entry.id %>')" class="clear-btn">×</button>
                                                            <% } %>
                                                        <% } else if (canEdit) { %>
                                                            <div class="cell-empty-label">+ Add Period</div>
                                                        <% } else { %>
                                                            <div style="height:54px;display:flex;align-items:center;justify-content:center;color:#CBD5E1;font-size:18px;">—</div>
                                                        <% } %>
                                                    </div>
                                                <% } %>
                                            </td>
                                        <% }) %>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>

        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>

<!-- Assign / Edit Period Modal -->
<div id="cell-modal" class="timetable-modal-backdrop">
    <div class="timetable-modal-card">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <div id="modal-title" style="font-size:18px;font-weight:700;color:#1E293B;">Edit Period</div>
                <div id="modal-subtitle" style="font-size:12px;color:#94A3B8;margin-top:4px;"></div>
            </div>
            <button type="button" onclick="closeModal()" style="border:none;background:none;color:#94A3B8;font-size:20px;line-height:1;cursor:pointer;">&times;</button>
        </div>
        <form action="/schooladmin/timetable/save" method="POST" id="cell-form">
            <input type="hidden" name="class_id" id="modal-class-id">
            <input type="hidden" name="day_of_week" id="modal-day">
            <input type="hidden" name="period_slot_id" id="modal-period-id">
            <input type="hidden" name="version_id" value="<%= selectedVersionId %>">
            <input type="hidden" name="academic_year_id" value="<%= selectedAcademicYearId %>">
            <input type="hidden" name="term_id" value="<%= selectedTermId %>">
            <input type="hidden" name="id" id="modal-entry-id" value="">

            <div class="mb-3">
                <label class="form-label">Subject</label>
                <select id="modal-subject" name="subject_id" class="form-select">
                    <option value="">No subject</option>
                    <% subjects.forEach(sub => { %>
                        <option value="<%= sub.id %>"><%= sub.name || sub.subject_name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">Teacher</label>
                <select id="modal-teacher" name="teacher_id" class="form-select">
                    <option value="">No teacher</option>
                </select>
                <p id="modal-teacher-msg" class="text-[11px] text-gray-400 mt-1 hidden">No teacher assigned for this subject.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Save Changes</button>
                <button type="button" onclick="closeModal()" class="btn btn-secondary flex-fill">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    let _currentCellId = null;

    function openCellModal(day, periodId, periodLabel, classId, cellId) {
        _currentCellId = cellId;
        const cell = document.getElementById(cellId);

        document.getElementById('modal-title').textContent = periodLabel;
        document.getElementById('modal-subtitle').textContent = day + ' timetable slot';
        document.getElementById('modal-class-id').value = classId;
        document.getElementById('modal-day').value = day;
        document.getElementById('modal-period-id').value = periodId;
        document.getElementById('modal-entry-id').value = cell.dataset.entryId || '';

        const subjectId = cell.dataset.subjectId || '';
        const teacherId = cell.dataset.teacherId || '';

        document.getElementById('modal-subject').value = subjectId;
        loadTeachersForSubject(classId, subjectId, teacherId);

        document.getElementById('cell-modal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('cell-modal').style.display = 'none';
    }

    document.getElementById('cell-modal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });

    document.getElementById('modal-subject').addEventListener('change', function() {
        const classId = document.getElementById('modal-class-id').value;
        loadTeachersForSubject(classId, this.value, '');
    });

    function loadTeachersForSubject(classId, subjectId, selectedTeacherId) {
        const sel = document.getElementById('modal-teacher');
        const msg = document.getElementById('modal-teacher-msg');
        sel.innerHTML = '<option value="">Loading...</option>';

        if (!subjectId) {
            sel.innerHTML = '<option value="">No teacher</option>';
            msg.classList.add('hidden');
            return;
        }

        fetch('/schooladmin/timetable/classes/' + classId + '/subjects/' + subjectId + '/teachers')
            .then(r => r.json())
            .then(data => {
                sel.innerHTML = '<option value="">No teacher</option>';
                if (!data.success || !data.teachers || data.teachers.length === 0) {
                    msg.classList.remove('hidden');
                    return;
                }
                msg.classList.add('hidden');
                data.teachers.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = [t.first_name, t.last_name].filter(Boolean).join(' ');
                    sel.appendChild(opt);
                });
                sel.value = selectedTeacherId || '';
            })
            .catch(() => {
                sel.innerHTML = '<option value="">No teacher</option>';
            });
    }

    async function clearCell(day, periodId, classId, cellId, entryId) {
        if (!confirm('Clear this period?')) return;
        if (!entryId) return;

        try {
            const res = await fetch('/schooladmin/timetable/delete/' + entryId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                const cell = document.getElementById(cellId);
                cell.dataset.entryId = '';
                cell.dataset.subjectId = '';
                cell.dataset.teacherId = '';
                cell.classList.remove('cell-filled');
                cell.classList.add('cell-empty');
                cell.innerHTML = '<div class="cell-empty-label">+ Add Period</div>';
                // Restore click handler
                cell.onclick = () => openCellModal(day, periodId, cell.closest('tr').querySelector('.timetable-period-cell div').textContent.trim(), classId, cellId);
            } else {
                alert(data.message || 'Failed to clear entry.');
            }
        } catch (err) {
            alert('Error clearing cell. Try again.');
        }
    }
</script>
