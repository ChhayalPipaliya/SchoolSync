<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Add Timetable Entry</h2>
                    <p class="text-xs text-gray-500 mt-1">
                        <a href="/schooladmin/timetable" style="color: var(--primary); text-decoration: none; font-weight: 600;">Timetable</a>
                        &rarr; Add New Slot
                    </p>
                </div>
                <a href="/schooladmin/timetable" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div style="max-width:580px; margin: 0 auto;">
                <div class="card p-4">
                    <form action="/schooladmin/timetable/add" method="POST">
                        <div style="font-size:14px;font-weight:600;color:var(--primary);margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid #E2E8F0;">
                            <i class="fa-solid fa-calendar-days me-2"></i>Schedule Details
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label form-label-required">Class</label>
                            <select name="class_id" required class="form-select mt-1">
                                <option value="">-- Select Class --</option>
                                <% classes.forEach(function(c) { %>
                                    <option value="<%= c.id %>"><%= c.label || c.class_label || c.display_name || c.name %><%= c.section && !(c.label || c.class_label || c.display_name) ? ' - Section ' + c.section : '' %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label form-label-required">Subject</label>
                            <select name="subject_id" required class="form-select mt-1">
                                <option value="">-- Select Subject --</option>
                                <% subjects.forEach(function(s) { %>
                                    <option value="<%= s.id %>"><%= s.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label form-label-required">Teacher</label>
                            <select name="teacher_id" required class="form-select mt-1">
                                <option value="">-- Select Teacher --</option>
                                <% teachers.forEach(function(t) { %>
                                    <option value="<%= t.id %>"><%= t.first_name %> <%= t.last_name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label form-label-required">Day</label>
                            <select name="day" required class="form-select mt-1">
                                <option value="">-- Select Day --</option>
                                <option value="Monday">Monday</option>
                                <option value="Tuesday">Tuesday</option>
                                <option value="Wednesday">Wednesday</option>
                                <option value="Thursday">Thursday</option>
                                <option value="Friday">Friday</option>
                                <option value="Saturday">Saturday</option>
                            </select>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6 form-group">
                                <label class="form-label form-label-required">Start Time</label>
                                <input type="time" name="start_time" required class="form-input mt-1">
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label form-label-required">End Time</label>
                                <input type="time" name="end_time" required class="form-input mt-1">
                            </div>
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-label">Room No</label>
                            <input type="text" name="room_no" class="form-input mt-1" placeholder="e.g. Room 101">
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-plus me-1"></i> Add Entry
                            </button>
                            <a href="/schooladmin/timetable" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>