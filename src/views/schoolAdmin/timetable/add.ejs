<%- include('../../partials/head') %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800 tracking-tight">
                                    <%= lan.Add_Timetable_Entry %>
                                </h2>
                                <p class="text-xs text-gray-500 mt-1">
                                    <a href="/schooladmin/timetable"
                                        style="color: var(--primary); text-decoration: none; font-weight: 600;">
                                        <%= lan.Timetable %>
                                    </a>
                                    &rarr; <%= lan.Add_New_Slot %>
                                </p>
                            </div>
                            <a href="/schooladmin/timetable" class="btn btn-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i>
                                <%= lan.Back %>
                            </a>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div style="max-width:580px; margin: 0 auto;">
                                <div class="card p-4">
                                    <form action="/schooladmin/timetable/add" method="POST">
                                        <div
                                            style="font-size:14px;font-weight:600;color:var(--primary);margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid #E2E8F0;">
                                            <i class="fa-solid fa-calendar-days me-2"></i>
                                            <%= lan.Schedule_Details %>
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="form-label form-label-required">
                                                <%= lan.Class %>
                                            </label>
                                            <select name="class_id" required class="form-select mt-1">
                                                <option value="">
                                                    <%= lan.Select_Class_Prompt %>
                                                </option>
                                                <% classes.forEach(function(c) { %>
                                                    <option value="<%= c.id %>">
                                                        <%= c.label || c.class_label || c.display_name || c.name %>
                                                            <%= c.section && !(c.label || c.class_label ||
                                                                c.display_name) ? ' - ' + lan.Section + ' ' + c.section
                                                                : '' %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="form-label form-label-required">
                                                <%= lan.Subject %>
                                            </label>
                                            <select name="subject_id" required class="form-select mt-1">
                                                <option value="">
                                                    <%= lan.Select_Subject_Prompt %>
                                                </option>
                                                <% subjects.forEach(function(s) { %>
                                                    <option value="<%= s.id %>">
                                                        <%= s.name %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="form-label form-label-required">
                                                <%= lan.Teacher %>
                                            </label>
                                            <select name="teacher_id" required class="form-select mt-1">
                                                <option value="">
                                                    <%= lan.Select_Teacher_Prompt %>
                                                </option>
                                                <% teachers.forEach(function(t) { %>
                                                    <option value="<%= t.id %>">
                                                        <%= t.first_name %>
                                                            <%= t.last_name %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="form-label form-label-required">
                                                <%= lan.Day %>
                                            </label>
                                            <select name="day" required class="form-select mt-1">
                                                <option value="">
                                                    <%= lan.Select_Day_Prompt %>
                                                </option>
                                                <option value="Monday">
                                                    <%= lan.Monday %>
                                                </option>
                                                <option value="Tuesday">
                                                    <%= lan.Tuesday %>
                                                </option>
                                                <option value="Wednesday">
                                                    <%= lan.Wednesday %>
                                                </option>
                                                <option value="Thursday">
                                                    <%= lan.Thursday %>
                                                </option>
                                                <option value="Friday">
                                                    <%= lan.Friday %>
                                                </option>
                                                <option value="Saturday">
                                                    <%= lan.Saturday %>
                                                </option>
                                            </select>
                                        </div>
                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6 form-group">
                                                <label class="form-label form-label-required">
                                                    <%= lan.Start_Time %>
                                                </label>
                                                <input type="time" name="start_time" required class="form-input mt-1">
                                            </div>
                                            <div class="col-md-6 form-group">
                                                <label class="form-label form-label-required">
                                                    <%= lan.End_Time %>
                                                </label>
                                                <input type="time" name="end_time" required class="form-input mt-1">
                                            </div>
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="form-label">
                                                <%= lan.Room_No %>
                                            </label>
                                            <input type="text" name="room_no" class="form-input mt-1"
                                                placeholder="e.g. Room 101">
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fa-solid fa-plus me-1"></i>
                                                <%= lan.Add_Entry %>
                                            </button>
                                            <a href="/schooladmin/timetable" class="btn btn-secondary">
                                                <%= lan.Cancel %>
                                            </a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>