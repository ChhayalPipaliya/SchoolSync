<%- include('../../partials/head') %>
<style>
    .period-pill {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-light);
        color: var(--primary);
        font-size: 13px;
        font-weight: 700;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= lan.Period_Slots %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%= lan.Period_Slots_Subtitle %></p>
                </div>
                <a href="/schooladmin/timetable" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> <%= lan.Back_To_Timetable %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fa-solid fa-plus-circle text-emerald-600 me-2"></i><%= lan.Add_Period_Slot %></h3>
                        </div>
                        <div class="card-body">
                            <form action="/schooladmin/timetable/periods" method="POST">
                                <div class="row g-3">
                                    <div class="col-md-6 form-group">
                                        <label class="form-label form-label-required"><%= lan.Period_No %></label>
                                        <input type="number" name="period_number" min="1" max="20" required placeholder="1" class="form-input">
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label class="form-label form-label-required"><%= lan.Label %></label>
                                        <input type="text" name="label" required placeholder="1st Period" class="form-input">
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label class="form-label form-label-required"><%= lan.Start_Time %></label>
                                        <input type="time" name="start_time" required class="form-input">
                                    </div>
                                    <div class="col-md-6 form-group">
                                        <label class="form-label form-label-required"><%= lan.End_Time %></label>
                                        <input type="time" name="end_time" required class="form-input">
                                    </div>
                                    <div class="col-12 form-group">
                                        <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:12px;padding:12px 14px;">
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" name="is_break" id="is_break" value="1">
                                                <label class="form-check-label" for="is_break" style="font-size:14px;color:#475569;"><%= lan.Mark_As_Break_Lunch %></label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary w-100">
                                            <i class="fa-solid fa-plus me-1"></i> <%= lan.Add_Period_Btn %>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="table-card">
                        <div class="table-header-row">
                            <div>
                                <h5 class="table-heading"><%= lan.Configured_Period_Slots %></h5>
                                <span style="font-size:12px;color:#94A3B8;"><%= slots.length %> <%= lan.Total_Slots_Configured %></span>
                            </div>
                        </div>
                        <div class="table-container">
                            <% if (slots.length === 0) { %>
                                <div class="empty-state">
                                    <div class="empty-state-icon">
                                        <i class="fa-solid fa-clock"></i>
                                    </div>
                                    <h6 class="empty-state-title"><%= lan.No_Period_Slots_Added_Yet %></h6>
                                    <p class="empty-state-text"><%= lan.Use_Form_To_Create_First_Period %></p>
                                </div>
                            <% } else { %>
                                <table class="data-table table-no-min-width">
                                    <thead>
                                        <tr>
                                            <th><%= lan.No %></th>
                                            <th><%= lan.Label %></th>
                                            <th><%= lan.Time_Range %></th>
                                            <th><%= lan.Type %></th>
                                            <th class="text-center"><%= lan.Action %></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% slots.forEach(slot => { %>
                                            <tr>
                                                <td><span class="period-pill"><%= slot.period_number %></span></td>
                                                <td style="font-weight:600;color:#1E293B;"><%= slot.label %></td>
                                                <td style="color:#64748B;font-size:13px;"><%= slot.start_time %> - <%= slot.end_time %></td>
                                                <td>
                                                    <% if (slot.is_break) { %>
                                                        <span class="badge badge-warning"><%= lan.Break %></span>
                                                    <% } else { %>
                                                        <span class="badge badge-success"><%= lan.Teaching_Period %></span>
                                                    <% } %>
                                                </td>
                                                <td class="text-center">
                                                    <form action="/schooladmin/timetable/periods/<%= slot.id %>/delete" method="POST" style="display:inline-block;" onsubmit="return confirm('<%= lan.Delete_Period_Slot_Confirm %>')">
                                                        <button type="submit" class="btn-icon btn-danger-icon" title="<%= lan.Delete %>">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
