<%- include('../../partials/head', { title: `${lan.Teaching_Mediums || 'Teaching Mediums'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: '/schooladmin/settings' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <%- include('../../partials/flashMessages') %>
<div class="page-header mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/schooladmin/settings"><%- lan.Settings || 'Settings' %></a></li>
      <li class="breadcrumb-item active"><%- lan.Medium_Settings || 'Medium Settings' %></li>
    </ol>
  </nav>
  <h1 class="h3 fw-bold mb-1"><i class="fas fa-language me-2 text-primary"></i><%- lan.Teaching_Mediums || 'Teaching Mediums' %></h1>
  <p class="text-muted"><%- lan.Select_Teaching_Mediums_Desc || 'Select the teaching mediums your school offers. This affects class generation and student enrollment.' %></p>
</div>
<div class="d-flex gap-2 mb-4 flex-wrap">
  <a href="/schooladmin/settings" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-cog me-1"></i><%- lan.General_Info || 'General' %>
  </a>
  <a href="/schooladmin/settings/bank" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-university me-1"></i><%- lan.Bank_Details || 'Bank Details' %>
  </a>
  <a href="/schooladmin/settings/documents" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-file-alt me-1"></i><%- lan.Documents || 'Documents' %>
  </a>
  <a href="/schooladmin/settings/mediums" class="btn btn-primary btn-sm">
    <i class="fas fa-language me-1"></i><%- lan.Teaching_Mediums || 'Mediums' %>
  </a>
</div>
<div class="row g-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-bold"><i class="fas fa-check-square me-2 text-primary"></i><%- lan.Select_Mediums || 'Select Mediums' %></h6>
      </div>
      <div class="card-body">
        <form action="/schooladmin/settings/mediums" method="POST" id="mediumForm">
          <% if (allMediums.length === 0) { %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <%- lan.No_Mediums_Configured_SuperAdmin || 'No mediums configured by the Super Admin yet.' %>
            </div>
          <% } else { %>
          <p class="text-muted small mb-3"><%- lan.Check_All_School_Mediums_Desc || 'Check all mediums your school provides. At least one medium must be selected.' %></p>
          <div class="row g-3 mb-4">
            <% allMediums.forEach(medium => { %>
            <div class="col-md-6">
              <div class="medium-card card border-2 p-3 cursor-pointer position-relative
                          <%= selectedCodes.includes(medium.medium_code) ? 'border-primary bg-primary-subtle' : 'border-secondary-subtle' %>"
                   id="card-<%= medium.medium_code %>"
                   onclick="toggleMedium('<%= medium.medium_code %>')">
                <div class="form-check">
                  <input class="form-check-input medium-checkbox" type="checkbox"
                         name="mediums[]"
                         value="<%= medium.medium_code %>"
                         id="medium-<%= medium.medium_code %>"
                         <%= selectedCodes.includes(medium.medium_code) ? 'checked' : '' %>>
                  <label class="form-check-label fw-semibold cursor-pointer" for="medium-<%= medium.medium_code %>">
                    <i class="fas fa-language me-2 text-primary"></i>
                    <%= medium.medium_name %>
                  </label>
                </div>
                <p class="text-muted small mb-0 mt-1 ps-4"><%- lan.Code || 'Code' %>: <code><%= medium.medium_code %></code></p>
              </div>
            </div>
            <% }) %>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">
              <i class="fas fa-star me-2 text-warning"></i><%- lan.Primary_Teaching_Medium || 'Primary Teaching Medium' %>
            </label>
            <select name="primary_medium" class="form-select" id="primaryMediumSelect">
              <% allMediums.forEach(medium => { %>
                <% const schoolMed = schoolMediums.find(sm => sm.medium_code === medium.medium_code); %>
                <% if (selectedCodes.includes(medium.medium_code)) { %>
                <option value="<%= medium.medium_code %>"
                        <%= schoolMed && schoolMed.is_primary ? 'selected' : '' %>>
                  <%= medium.medium_name %>
                </option>
                <% } %>
              <% }) %>
            </select>
            <div class="form-text"><%- lan.Primary_Medium_Default_Note || 'The primary medium is shown first and used as the default in student enrollment' %></div>
          </div>
          <% } %>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" <%= allMediums.length === 0 ? 'disabled' : '' %>>
              <i class="fas fa-save me-2"></i><%- lan.Save_Medium_Settings || 'Save Medium Settings' %>
            </button>
            <a href="/schooladmin/settings" class="btn btn-outline-secondary"><%- lan.Cancel || 'Cancel' %></a>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2 text-info"></i><%- lan.Current_Mediums || 'Current Mediums' %></h6>
      </div>
      <div class="card-body">
        <% if (schoolMediums.length === 0) { %>
          <p class="text-muted small mb-0"><%- lan.No_Mediums_Selected_Yet || 'No mediums selected yet.' %></p>
        <% } else { %>
          <div class="d-flex flex-column gap-2">
            <% schoolMediums.forEach(sm => { %>
            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light">
              <span class="fw-semibold"><%= sm.medium_name %></span>
              <div class="d-flex align-items-center gap-2">
                <code class="small text-muted"><%= sm.medium_code %></code>
                <% if (sm.is_primary) { %>
                  <span class="badge bg-warning text-dark"><i class="fas fa-star me-1" style="font-size:10px"></i><%- lan.Primary || 'Primary' %></span>
                <% } %>
              </div>
            </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
    <div class="card border-0 shadow-sm border-start border-4 border-primary">
      <div class="card-body">
        <h6 class="fw-bold text-primary mb-2"><i class="fas fa-lightbulb me-2"></i><%- lan.How_Mediums_Work || 'How Mediums Work' %></h6>
        <ul class="small text-muted mb-0">
          <li class="mb-1"><%- lan.Medium_How_Point1 || 'Mediums define the language of instruction for classes' %></li>
          <li class="mb-1"><%- lan.Medium_How_Point2 || 'When auto-generating classes, each medium creates a separate class section' %></li>
          <li class="mb-1"><%- lan.Medium_How_Point3 || 'Example: Std 5-A (Gujarati) and Std 5-A (English) are separate classes' %></li>
          <li class="mb-1"><%- lan.Medium_How_Point4 || 'Students are enrolled in a class that matches their preferred medium' %></li>
          <li><%- lan.Medium_How_Point5 || 'The primary medium is pre-selected in all dropdowns' %></li>
        </ul>
      </div>
    </div>
  </div>
</div>
</div>
        <%- include('../../partials/footer') %>
    </div>
</div>
