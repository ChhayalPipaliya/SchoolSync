<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: '/schooladmin/settings' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <%- include('../../partials/flashMessages') %>
<div class="page-header mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/schooladmin/settings">Settings</a></li>
      <li class="breadcrumb-item active">Medium Settings</li>
    </ol>
  </nav>
  <h1 class="h3 fw-bold mb-1"><i class="fas fa-language me-2 text-primary"></i>Teaching Mediums</h1>
  <p class="text-muted">Select the teaching mediums your school offers. This affects class generation and student enrollment.</p>
</div>
<div class="d-flex gap-2 mb-4 flex-wrap">
  <a href="/schooladmin/settings" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-cog me-1"></i>General
  </a>
  <a href="/schooladmin/settings/bank" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-university me-1"></i>Bank Details
  </a>
  <a href="/schooladmin/settings/documents" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-file-alt me-1"></i>Documents
  </a>
  <a href="/schooladmin/settings/mediums" class="btn btn-primary btn-sm">
    <i class="fas fa-language me-1"></i>Mediums
  </a>
</div>
<div class="row g-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-bold"><i class="fas fa-check-square me-2 text-primary"></i>Select Mediums</h6>
      </div>
      <div class="card-body">
        <form action="/schooladmin/settings/mediums" method="POST" id="mediumForm">
          <% if (allMediums.length === 0) { %>
            <div class="alert alert-warning">
              <i class="fas fa-exclamation-triangle me-2"></i>
              No mediums configured by the Super Admin yet.
            </div>
          <% } else { %>
          <p class="text-muted small mb-3">Check all mediums your school provides. At least one medium must be selected.</p>
          <div class="row g-3 mb-4">
            <% allMediums.forEach(medium => { %>
            <div class="col-md-6">
              <div class="medium-card card border-2 p-3 cursor-pointer position-relative
                          <%= selectedCodes.includes(medium.medium_code) ? 'border-primary bg-primary-subtle' : 'border-secondary-subtle' %>"
                   id="card-<%= medium.medium_code %>"
                   onclick="toggleMedium('<%= medium.medium_code %>')">
                <div class="form-check">
                  <input class="form-check-input medium-checkbox" type="checkbox"
                         name="mediums[]"
                         value="<%= medium.medium_code %>"
                         id="medium-<%= medium.medium_code %>"
                         <%= selectedCodes.includes(medium.medium_code) ? 'checked' : '' %>>
                  <label class="form-check-label fw-semibold cursor-pointer" for="medium-<%= medium.medium_code %>">
                    <i class="fas fa-language me-2 text-primary"></i>
                    <%= medium.medium_name %>
                  </label>
                </div>
                <p class="text-muted small mb-0 mt-1 ps-4">Code: <code><%= medium.medium_code %></code></p>
              </div>
            </div>
            <% }) %>
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">
              <i class="fas fa-star me-2 text-warning"></i>Primary Teaching Medium
            </label>
            <select name="primary_medium" class="form-select" id="primaryMediumSelect">
              <% allMediums.forEach(medium => { %>
                <% const schoolMed = schoolMediums.find(sm => sm.medium_code === medium.medium_code); %>
                <% if (selectedCodes.includes(medium.medium_code)) { %>
                <option value="<%= medium.medium_code %>"
                        <%= schoolMed && schoolMed.is_primary ? 'selected' : '' %>>
                  <%= medium.medium_name %>
                </option>
                <% } %>
              <% }) %>
            </select>
            <div class="form-text">The primary medium is shown first and used as the default in student enrollment</div>
          </div>
          <% } %>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" <%= allMediums.length === 0 ? 'disabled' : '' %>>
              <i class="fas fa-save me-2"></i>Save Medium Settings
            </button>
            <a href="/schooladmin/settings" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2 text-info"></i>Current Mediums</h6>
      </div>
      <div class="card-body">
        <% if (schoolMediums.length === 0) { %>
          <p class="text-muted small mb-0">No mediums selected yet.</p>
        <% } else { %>
          <div class="d-flex flex-column gap-2">
            <% schoolMediums.forEach(sm => { %>
            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light">
              <span class="fw-semibold"><%= sm.medium_name %></span>
              <div class="d-flex align-items-center gap-2">
                <code class="small text-muted"><%= sm.medium_code %></code>
                <% if (sm.is_primary) { %>
                  <span class="badge bg-warning text-dark"><i class="fas fa-star me-1" style="font-size:10px"></i>Primary</span>
                <% } %>
              </div>
            </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
    <div class="card border-0 shadow-sm border-start border-4 border-primary">
      <div class="card-body">
        <h6 class="fw-bold text-primary mb-2"><i class="fas fa-lightbulb me-2"></i>How Mediums Work</h6>
        <ul class="small text-muted mb-0">
          <li class="mb-1">Mediums define the <strong>language of instruction</strong> for classes</li>
          <li class="mb-1">When auto-generating classes, each medium creates a separate class section</li>
          <li class="mb-1">Example: Std 5-A (Gujarati) and Std 5-A (English) are separate classes</li>
          <li class="mb-1">Students are enrolled in a class that matches their preferred medium</li>
          <li>The <strong>primary medium</strong> is pre-selected in all dropdowns</li>
        </ul>
      </div>
    </div>
  </div>
</div>
</div>
</div>
</div>
<%- include('../../partials/footer') %>
<style>
    .medium-card { transition: all 0.2s ease; cursor: pointer; }
    .medium-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1); }
    .medium-card.border-primary { box-shadow: 0 0 0 2px var(--bs-primary); }
    .cursor-pointer { cursor: pointer; }
</style>
<script>
    function toggleMedium(code) {
        const cb = document.getElementById('medium-' + code);
        const card = document.getElementById('card-' + code);
        cb.checked = !cb.checked;
            if (cb.checked) {
                card.classList.add('border-primary', 'bg-primary-subtle');
                card.classList.remove('border-secondary-subtle');
            } else {
                card.classList.remove('border-primary', 'bg-primary-subtle');
                card.classList.add('border-secondary-subtle');
            }
        updatePrimarySelect();
    }

    function updatePrimarySelect() {
        const sel = document.getElementById('primaryMediumSelect');
        if (!sel) return;
        const checked = [...document.querySelectorAll('.medium-checkbox:checked')].map(cb => cb.value);
        const current = sel.value;
        sel.innerHTML = '';
        checked.forEach(code => {
            const label = document.querySelector('#medium-' + code)?.nextElementSibling?.textContent?.trim() || code;
            const opt = new Option(label, code, false, code === current);
            sel.add(opt);
        });
        if (sel.options.length === 0) {
            sel.add(new Option('— Select a medium first —', ''));
        }
    }

    document.querySelectorAll('.medium-checkbox').forEach(cb => {
        cb.addEventListener('change', (e) => {
            e.stopPropagation();
            const code = cb.value;
            const card = document.getElementById('card-' + code);
            if (cb.checked) {
            card.classList.add('border-primary', 'bg-primary-subtle');
            card.classList.remove('border-secondary-subtle');
            } else {
            card.classList.remove('border-primary', 'bg-primary-subtle');
            card.classList.add('border-secondary-subtle');
            }
            updatePrimarySelect();
        });
    });
</script>