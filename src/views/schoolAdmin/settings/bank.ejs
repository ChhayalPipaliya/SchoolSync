<%- include('../../partials/head', { title: `${lan.Bank_Details || 'Bank Details'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/settings/bank' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Settings || 'Settings' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Bank_Details_Desc || 'Manage school bank details for fee collections and billing configuration' %></p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="flex border-b border-gray-200 mb-6 gap-2">
                <a href="/schooladmin/settings" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-school"></i> <%- lan.General_Info || 'General Info' %>
                </a>
                <a href="/schooladmin/settings/bank" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-emerald-600 text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-building-columns"></i> <%- lan.Bank_Details || 'Bank Details' %>
                </a>
                <a href="/schooladmin/settings/documents" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-file-shield"></i> <%- lan.Documents || 'Documents' %>
                </a>
                <a href="/schooladmin/settings/chat-permissions" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-comments"></i> <%- lan.Chat_Permissions || 'Chat Permissions' %>
                </a>
                <a href="/schooladmin/settings/upi-qr" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-qrcode"></i> <%- lan.UPI_QR_Payment || 'UPI QR Payment' %>
                </a>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-1">
                    <div class="card shadow-sm border border-slate-100">
                        <div class="card-header bg-slate-50/50">
                            <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700">
                                <i class="fa-solid fa-plus text-emerald-600"></i> <%- lan.Add_Bank_Account || 'Add Bank Account' %>
                            </h3>
                        </div>
                        <div class="card-body">
                            <form action="/schooladmin/settings/bank" method="POST" class="space-y-4">
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Account_Holder_Name || 'Account Holder Name' %> <span class="text-rose-500">*</span></label>
                                    <input type="text" name="account_holder_name" required placeholder="e.g. Greenwood School Admin" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Bank_Name || 'Bank Name' %> <span class="text-rose-500">*</span></label>
                                    <input type="text" name="bank_name" required placeholder="e.g. State Bank of India" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Account_Number || 'Account Number' %> <span class="text-rose-500">*</span></label>
                                    <input type="text" name="account_number" required placeholder="e.g. 50100123456789" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.IFSC_Code || 'IFSC Code' %> <span class="text-rose-500">*</span></label>
                                    <input type="text" name="ifsc_code" required placeholder="e.g. SBIN0001234" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Branch_Name || 'Branch Name' %></label>
                                    <input type="text" name="branch_name" placeholder="e.g. Main Branch, Ahmedabad" class="form-input">
                                </div>
                                <div class="form-check mt-3">
                                    <input type="checkbox" name="is_primary" id="is_primary" value="1" class="form-check-input">
                                    <label for="is_primary" class="form-check-label text-xs font-semibold text-gray-600"><%- lan.Set_As_Primary_Account || 'Set as primary payment account' %></label>
                                </div>

                                <button type="submit" class="btn btn-primary w-full mt-4 flex items-center justify-center gap-2 text-sm font-bold shadow-sm transition">
                                    <i class="fa-solid fa-plus"></i> <%- lan.Save_Bank_Details || 'Save Bank Details' %>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-2 space-y-4">
                    <div class="card shadow-sm border border-slate-100 h-full">
                        <div class="card-header bg-slate-50/50">
                            <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700">
                                <i class="fa-solid fa-list text-emerald-600"></i> <%- lan.Configured_Accounts || 'Configured Accounts' %>
                            </h3>
                        </div>
                        <div class="card-body">
                            <% if (banks && banks.length > 0) { %>
                                <div class="space-y-4">
                                    <% banks.forEach(bank => { %>
                                        <div class="p-4 rounded-xl border <%= bank.is_primary ? 'border-emerald-200 bg-emerald-50/20' : 'border-slate-100 bg-slate-50/30' %> flex flex-col md:flex-row md:items-center md:justify-between gap-4 transition hover:border-slate-200">
                                            <div class="space-y-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="font-bold text-slate-800 text-sm"><%= bank.bank_name %></span>
                                                    <% if (bank.is_primary) { %>
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold uppercase bg-emerald-100 text-emerald-800 border border-emerald-200">
                                                            <%- lan.Primary || 'Primary' %>
                                                        </span>
                                                    <% } %>
                                                </div>
                                                <div class="text-xs text-slate-500">
                                                    <%- lan.Account_Holder_Name || 'Account Holder' %>: <span class="font-medium text-slate-700"><%= bank.account_holder_name %></span>
                                                </div>
                                                <div class="text-xs text-slate-500">
                                                    <%- lan.Account_Number || 'Account No' %>: <span class="font-medium text-slate-700">•••• •••• <%= bank.account_number.slice(-4) %></span>
                                                </div>
                                                <% if (bank.branch_name) { %>
                                                    <div class="text-xs text-slate-400">
                                                        <%- lan.Branch_Name || 'Branch' %>: <span class="font-medium text-slate-600"><%= bank.branch_name %></span>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="flex flex-col items-start md:items-end gap-1">
                                                <div class="text-xs text-slate-400"><%- lan.IFSC_Code || 'IFSC Code' %></div>
                                                <div class="font-bold text-slate-700 text-xs tracking-wider uppercase"><%= bank.ifsc_code %></div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <div class="empty-state">
                                    <div class="empty-state-icon">
                                        <i class="fa-solid fa-building-columns"></i>
                                    </div>
                                    <h4 class="empty-state-title"><%- lan.No_Bank_Accounts_Configured || 'No bank accounts configured' %></h4>
                                    <p class="empty-state-text"><%- lan.Add_Bank_Account_Desc || 'Add your school\'s bank account details on the left to start collecting online fee payments.' %></p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
