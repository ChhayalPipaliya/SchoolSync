<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/settings/upi-qr' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding:24px;">
            <div style="background:linear-gradient(135deg, #059669, #047857); border-radius:12px; padding:24px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(5,150,105,0.15);">
                <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
                <div style="position:relative; z-index:1;">
                    <h1 style="font-size:24px; font-weight:700; margin:0;">UPI QR Payment Settings</h1>
                    <p style="font-size:13px; opacity:0.9; margin:4px 0 0;">Configure your school's static UPI QR code and UPI ID for parent fee payments</p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div style="display:flex; border-bottom:1px solid #e2e8f0; margin-bottom:24px; gap:8px; overflow-x:auto;">
                <a href="/schooladmin/settings" style="padding:10px 16px; font-size:14px; font-weight:600; border-bottom:2px solid transparent; color:#64748b; display:flex; align-items:center; gap:8px; text-decoration:none; white-space:nowrap;">
                    <i class="fa-solid fa-school"></i> General Info
                </a>
                <a href="/schooladmin/settings/bank" style="padding:10px 16px; font-size:14px; font-weight:600; border-bottom:2px solid transparent; color:#64748b; display:flex; align-items:center; gap:8px; text-decoration:none; white-space:nowrap;">
                    <i class="fa-solid fa-building-columns"></i> Bank Details
                </a>
                <a href="/schooladmin/settings/documents" style="padding:10px 16px; font-size:14px; font-weight:600; border-bottom:2px solid transparent; color:#64748b; display:flex; align-items:center; gap:8px; text-decoration:none; white-space:nowrap;">
                    <i class="fa-solid fa-file-shield"></i> Documents
                </a>
                <a href="/schooladmin/settings/chat-permissions" style="padding:10px 16px; font-size:14px; font-weight:600; border-bottom:2px solid transparent; color:#64748b; display:flex; align-items:center; gap:8px; text-decoration:none; white-space:nowrap;">
                    <i class="fa-solid fa-comments"></i> Chat Permissions
                </a>
                <a href="/schooladmin/settings/upi-qr" style="padding:10px 16px; font-size:14px; font-weight:600; border-bottom:2px solid #059669; color:#059669; display:flex; align-items:center; gap:8px; text-decoration:none; white-space:nowrap;">
                    <i class="fa-solid fa-qrcode"></i> UPI QR Payment
                </a>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2">
                    <div class="card shadow-sm border border-slate-100" style="border-radius:12px;">
                        <div class="card-header bg-slate-50/50" style="padding:16px 20px; border-bottom:1px solid #f1f5f9;">
                            <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700" style="margin:0;">
                                <i class="fa-solid fa-qrcode text-emerald-600"></i> Configure School UPI QR
                            </h3>
                        </div>
                        <div class="card-body" style="padding:20px;">
                            <% const safeSchool = typeof school !== 'undefined' && school ? school : {}; %>
                            <form action="/schooladmin/settings/upi-qr" method="POST" enctype="multipart/form-data" class="space-y-6">
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-600 uppercase tracking-wider text-[11px] block mb-2">
                                        QR Payment Status
                                    </label>
                                    <div class="flex items-center gap-4 p-3 bg-slate-50 rounded-lg border border-slate-200">
                                        <label class="inline-flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700">
                                            <input type="radio" name="upi_qr_enabled" value="1" <%= safeSchool.upi_qr_enabled ? 'checked' : '' %> class="w-4 h-4 text-emerald-600 focus:ring-emerald-500">
                                            <span class="text-emerald-700 font-bold"><i class="fa-solid fa-circle-check"></i> Enabled</span>
                                        </label>
                                        <label class="inline-flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700">
                                            <input type="radio" name="upi_qr_enabled" value="0" <%= !safeSchool.upi_qr_enabled ? 'checked' : '' %> class="w-4 h-4 text-slate-500 focus:ring-slate-400">
                                            <span class="text-slate-600"><i class="fa-solid fa-circle-xmark"></i> Disabled</span>
                                        </label>
                                    </div>
                                    <p class="text-xs text-slate-500 mt-1">When enabled, parents of this school will see the <strong>Pay via QR</strong> option on their fees portal.</p>
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-600 uppercase tracking-wider text-[11px] block mb-2">
                                        School UPI ID / VPA
                                    </label>
                                    <div class="relative">
                                        <input type="text" name="upi_id" value="<%= safeSchool.upi_id || '' %>" placeholder="e.g. greenwoodschool@upi" class="form-input w-full border-slate-300 rounded-lg p-2.5 text-sm font-medium">
                                    </div>
                                    <p class="text-xs text-slate-500 mt-1">Optional. Displayed alongside your QR code so parents can verify the recipient.</p>
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-600 uppercase tracking-wider text-[11px] block mb-2">
                                        <%= safeSchool.upi_qr_image ? 'Upload / Replace QR Image' : 'Upload QR Image' %>
                                    </label>
                                    <input type="file" name="upi_qr_image" accept="image/png, image/jpeg, image/jpg, image/webp" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                                    <p class="text-xs text-slate-500 mt-1">Accepted formats: PNG, JPG, JPEG, WEBP. Max file size: 5MB.</p>
                                </div>
                                <div class="flex items-center gap-3 pt-2">
                                    <button type="submit" class="btn btn-primary px-5 py-2.5 text-sm font-bold flex items-center gap-2 shadow-sm rounded-lg">
                                        <i class="fa-solid fa-floppy-disk"></i> Save Changes
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-1 space-y-6">
                    <div class="card shadow-sm border border-slate-100" style="border-radius:12px;">
                        <div class="card-header bg-slate-50/50" style="padding:16px 20px; border-bottom:1px solid #f1f5f9;">
                            <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700" style="margin:0;">
                                <i class="fa-solid fa-eye text-emerald-600"></i> QR Preview & Status
                            </h3>
                        </div>
                        <div class="card-body" style="padding:20px; text-align:center;">
                            <div class="mb-4">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= safeSchool.upi_qr_enabled && safeSchool.upi_qr_image ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : (safeSchool.upi_qr_image ? 'bg-amber-100 text-amber-800 border border-amber-200' : 'bg-slate-100 text-slate-600 border border-slate-200') %>">
                                    <span class="w-2 h-2 rounded-full mr-1.5 <%= safeSchool.upi_qr_enabled && safeSchool.upi_qr_image ? 'bg-emerald-500' : (safeSchool.upi_qr_image ? 'bg-amber-500' : 'bg-slate-400') %>"></span>
                                    <% if (safeSchool.upi_qr_enabled && safeSchool.upi_qr_image) { %>
                                        QR Payment Active
                                    <% } else if (safeSchool.upi_qr_image) { %>
                                        Disabled
                                    <% } else { %>
                                        Not Configured
                                    <% } %>
                                </span>
                            </div>
                            <% if (safeSchool.upi_qr_image) { %>
                                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 inline-block mb-4 shadow-inner">
                                    <img src="<%= safeSchool.upi_qr_image %>" alt="School UPI QR Code" class="w-48 h-48 object-contain rounded-lg mx-auto">
                                </div>
                                <% if (safeSchool.upi_id) { %>
                                    <p class="text-xs font-bold text-slate-700 mb-4 bg-slate-100 py-1.5 px-3 rounded-md inline-block">
                                        UPI ID: <%= safeSchool.upi_id %>
                                    </p>
                                <% } %>
                                <form action="/schooladmin/settings/upi-qr/delete" method="POST" onsubmit="return confirm('Are you sure you want to remove the school QR code? This will disable QR payment for parents.')">
                                    <button type="submit" class="text-xs font-semibold text-rose-600 hover:text-rose-700 underline flex items-center justify-center gap-1 mx-auto">
                                        <i class="fa-solid fa-trash-can"></i> Remove QR Code
                                    </button>
                                </form>
                            <% } else { %>
                                <div class="p-8 border-2 border-dashed border-slate-200 rounded-xl bg-slate-50/50 mb-4 text-slate-400">
                                    <i class="fa-solid fa-qrcode text-4xl mb-2 text-slate-300"></i>
                                    <p class="text-xs font-semibold">No UPI QR Code uploaded yet.</p>
                                </div>
                                <p class="text-xs text-slate-500">Upload a QR code to enable direct UPI QR fee payments for parents.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>