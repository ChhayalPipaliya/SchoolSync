<%- include('../../partials/head', { title: `${lan.UPI_QR_Payment || 'UPI QR Payment' } | SchoolSync` }) %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: '/schooladmin/settings/upi-qr' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-gears"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%- lan.Settings || 'Settings' %>
                                        </h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%-
                                                lan.UPI_QR_Payment_Desc
                                                || 'Configure school UPI ID and dynamic QR code image for direct parent fee payments'
                                                %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div class="flex border-b border-gray-200 mb-3 gap-2 overflow-x-auto">
                                <a href="/schooladmin/settings"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150 whitespace-nowrap">
                                    <i class="fa-solid fa-school"></i> <%- lan.General_Info || 'General Info' %>
                                </a>
                                <a href="/schooladmin/settings/bank"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150 whitespace-nowrap">
                                    <i class="fa-solid fa-building-columns"></i> <%- lan.Bank_Details || 'Bank Details'
                                        %>
                                </a>
                                <a href="/schooladmin/settings/documents"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150 whitespace-nowrap">
                                    <i class="fa-solid fa-file-shield"></i> <%- lan.Documents || 'Documents' %>
                                </a>
                                <a href="/schooladmin/settings/chat-permissions"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150 whitespace-nowrap">
                                    <i class="fa-solid fa-comments"></i> <%- lan.Chat_Permissions || 'Chat Permissions'
                                        %>
                                </a>
                                <a href="/schooladmin/settings/upi-qr"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-emerald-600 text-emerald-600 flex items-center gap-2 transition duration-150 whitespace-nowrap">
                                    <i class="fa-solid fa-qrcode"></i> <%- lan.UPI_QR_Payment || 'UPI QR Payment' %>
                                </a>
                            </div>
                            <% const safeSchool=typeof school !=='undefined' && school ? school : {}; %>
                                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                                    <div class="lg:col-span-2">
                                        <div class="card shadow-sm border border-slate-100" style="border-radius:12px;">
                                            <div class="card-header bg-slate-50/50"
                                                style="padding:16px 20px; border-bottom:1px solid #f1f5f9;">
                                                <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700"
                                                    style="margin:0;">
                                                    <i class="fa-solid fa-qrcode text-emerald-600"></i> <%-
                                                        lan.QR_Payment_Configuration || 'QR Payment Configuration' %>
                                                </h3>
                                            </div>
                                            <div class="card-body" style="padding:20px;">
                                                <form action="/schooladmin/settings/upi-qr" method="POST"
                                                    enctype="multipart/form-data" class="space-y-6">
                                                    <div class="form-group">
                                                        <label
                                                            class="form-label font-bold text-gray-600 uppercase tracking-wider text-[11px] block mb-2">
                                                            <%- lan.Payment_Status || 'Payment Status' %>
                                                        </label>
                                                        <div
                                                            class="flex items-center gap-4 p-3 bg-slate-50 rounded-lg border border-slate-200">
                                                            <label
                                                                class="inline-flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700">
                                                                <input type="radio" name="upi_qr_enabled" value="1"
                                                                    <%=safeSchool.upi_qr_enabled ? 'checked' : '' %>
                                                                class="w-4 h-4 text-emerald-600 focus:ring-emerald-500">
                                                                <span class="text-emerald-700 font-bold"><i
                                                                        class="fa-solid fa-circle-check"></i> <%-
                                                                        lan.Active || 'Enabled' %></span>
                                                            </label>
                                                            <label
                                                                class="inline-flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700">
                                                                <input type="radio" name="upi_qr_enabled" value="0"
                                                                    <%=!safeSchool.upi_qr_enabled ? 'checked' : '' %>
                                                                class="w-4 h-4 text-slate-500 focus:ring-slate-400">
                                                                <span class="text-slate-600"><i
                                                                        class="fa-solid fa-circle-xmark"></i> <%-
                                                                        lan.Disabled || 'Disabled' %></span>
                                                            </label>
                                                        </div>
                                                        <p class="text-xs text-slate-500 mt-1"><%-
                                                                lan.When_Enabled_QR_Desc
                                                                || 'When enabled, parents of this school will see the Pay via QR option on their fees portal.'
                                                                %></p>
                                                    </div>
                                                    <div class="form-group">
                                                        <label
                                                            class="form-label font-bold text-gray-600 uppercase tracking-wider text-[11px] block mb-2">
                                                            <%- lan.School_UPI_ID_VPA || 'School UPI ID / VPA' %>
                                                        </label>
                                                        <div class="relative">
                                                            <input type="text" name="upi_id"
                                                                value="<%= safeSchool.upi_id || '' %>"
                                                                placeholder="e.g. greenwoodschool@upi"
                                                                class="form-input w-full border-slate-300 rounded-lg p-2.5 text-sm font-medium">
                                                        </div>
                                                        <p class="text-xs text-slate-500 mt-1"><%-
                                                                lan.UPI_ID_Optional_Desc
                                                                || 'Optional. Displayed alongside your QR code so parents can verify the recipient.'
                                                                %></p>
                                                    </div>
                                                    <div class="form-group">
                                                        <label
                                                            class="form-label font-bold text-gray-600 uppercase tracking-wider text-[11px] block mb-2">
                                                            <%= safeSchool.upi_qr_image ? (lan.Upload_Replace_QR_Image
                                                                || 'Upload / Replace QR Image' ) :
                                                                (lan.Upload_QR_Code_Image || 'Upload QR Code Image' ) %>
                                                        </label>
                                                        <input type="file" name="upi_qr_image"
                                                            accept="image/png, image/jpeg, image/jpg, image/webp"
                                                            class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                                                        <p class="text-xs text-slate-500 mt-1"><%-
                                                                lan.Accepted_QR_Formats_Desc
                                                                || 'Accepted formats: PNG, JPG, JPEG, WEBP. Max file size: 5MB.'
                                                                %></p>
                                                    </div>
                                                    <div class="flex items-center gap-3 pt-2">
                                                        <button type="submit"
                                                            class="btn btn-primary px-5 py-2.5 text-sm font-bold flex items-center gap-2 shadow-sm rounded-lg">
                                                            <i class="fa-solid fa-floppy-disk"></i> <%-
                                                                lan.Save_QR_Settings || 'Save Changes' %>
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="lg:col-span-1 space-y-6">
                                        <div class="card shadow-sm border border-slate-100" style="border-radius:12px;">
                                            <div class="card-header bg-slate-50/50"
                                                style="padding:16px 20px; border-bottom:1px solid #f1f5f9;">
                                                <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700"
                                                    style="margin:0;">
                                                    <i class="fa-solid fa-eye text-emerald-600"></i> <%-
                                                        lan.Preview_Status || 'QR Preview & Status' %>
                                                </h3>
                                            </div>
                                            <div class="card-body" style="padding:20px; text-align:center;">
                                                <div class="mb-3">
                                                    <span
                                                        class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= safeSchool.upi_qr_enabled && safeSchool.upi_qr_image ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : (safeSchool.upi_qr_image ? 'bg-amber-100 text-amber-800 border border-amber-200' : 'bg-slate-100 text-slate-600 border border-slate-200') %>">
                                                        <span
                                                            class="w-2 h-2 rounded-full mr-1.5 <%= safeSchool.upi_qr_enabled && safeSchool.upi_qr_image ? 'bg-emerald-500' : (safeSchool.upi_qr_image ? 'bg-amber-500' : 'bg-slate-400') %>"></span>
                                                        <% if (safeSchool.upi_qr_enabled && safeSchool.upi_qr_image) {
                                                            %>
                                                            <%- lan.QR_Payment_Active || 'QR Payment Active' %>
                                                                <% } else if (safeSchool.upi_qr_image) { %>
                                                                    <%- lan.Disabled || 'Disabled' %>
                                                                        <% } else { %>
                                                                            <%- lan.Not_Configured || 'Not Configured'
                                                                                %>
                                                                                <% } %>
                                                    </span>
                                                </div>
                                                <% if (safeSchool.upi_qr_image) { %>
                                                    <% const qrImageSrc=safeSchool.upi_qr_image.startsWith('/') ?
                                                        safeSchool.upi_qr_image : ('/' + safeSchool.upi_qr_image); %>
                                                        <div
                                                            class="bg-white p-4 rounded-xl border border-slate-200 inline-block mb-3 shadow-sm">
                                                            <img src="<%= qrImageSrc %>" alt="School UPI QR Code"
                                                                class="w-48 h-48 object-contain rounded-lg mx-auto"
                                                                onerror="this.onerror=null; this.classList.add('opacity-50');">
                                                        </div>
                                                        <% if (safeSchool.upi_id) { %>
                                                            <p
                                                                class="text-xs font-bold text-slate-700 mb-3 bg-slate-100 py-1.5 px-3 rounded-md inline-block">
                                                                <%- lan.UPI_ID || 'UPI ID' %>: <%= safeSchool.upi_id %>
                                                            </p>
                                                            <% } %>
                                                                <form action="/schooladmin/settings/upi-qr/delete"
                                                                    method="POST" class="remove-qr-form"
                                                                    data-confirm="<%- lan.Remove_QR_Confirm || 'Are you sure you want to remove the school QR code? This will disable QR payment for parents.' %>">
                                                                    <button type="submit"
                                                                        class="text-xs font-semibold text-rose-600 hover:text-rose-700 underline flex items-center justify-center gap-1 mx-auto">
                                                                        <i class="fa-solid fa-trash-can"></i> <%-
                                                                            lan.Remove_QR_Code || 'Remove QR Code' %>
                                                                    </button>
                                                                </form>
                                                                <% } else { %>
                                                                    <div
                                                                        class="p-8 border-2 border-dashed border-slate-200 rounded-xl bg-slate-50/50 mb-3 text-slate-400">
                                                                        <i
                                                                            class="fa-solid fa-qrcode text-4xl mb-2 text-slate-300"></i>
                                                                        <p class="text-xs font-semibold"><%-
                                                                                lan.No_QR_Uploaded
                                                                                || 'No UPI QR Code uploaded yet.' %></p>
                                                                    </div>
                                                                    <p class="text-xs text-slate-500"><%-
                                                                            lan.Upload_QR_Code_Help
                                                                            || 'Upload a QR code to enable direct UPI QR fee payments for parents.'
                                                                            %></p>
                                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>
    <script>
        document.querySelectorAll('.remove-qr-form').forEach(form => {
            form.addEventListener('submit', function (e) {
                const msg = this.getAttribute('data-confirm') || 'Are you sure?';
                if (!confirm(msg)) {
                    e.preventDefault();
                }
            });
        });
    </script>