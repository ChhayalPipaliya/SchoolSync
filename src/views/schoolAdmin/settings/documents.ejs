<%- include('../../partials/head', { title: `${lan.Documents || 'Documents' } | SchoolSync` }) %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: '/schooladmin/settings/documents' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-gears"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%- lan.Settings || 'Settings' %></h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%-
                                                lan.Documents_Settings_Desc
                                                || 'Upload and manage school registration, affiliation, and compliance documents'
                                                %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div class="flex border-b border-gray-200 mb-3 gap-2">
                                <a href="/schooladmin/settings"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                                    <i class="fa-solid fa-school"></i> <%- lan.General_Info || 'General Info' %>
                                </a>
                                <a href="/schooladmin/settings/bank"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                                    <i class="fa-solid fa-building-columns"></i> <%- lan.Bank_Details || 'Bank Details'
                                        %>
                                </a>
                                <a href="/schooladmin/settings/documents"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-emerald-600 text-emerald-600 flex items-center gap-2 transition duration-150">
                                    <i class="fa-solid fa-file-shield"></i> <%- lan.Documents || 'Documents' %>
                                </a>
                                <a href="/schooladmin/settings/chat-permissions"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                                    <i class="fa-solid fa-comments"></i> <%- lan.Chat_Permissions || 'Chat Permissions'
                                        %>
                                </a>
                                <a href="/schooladmin/settings/upi-qr"
                                    class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                                    <i class="fa-solid fa-qrcode"></i> <%- lan.UPI_QR_Payment || 'UPI QR Payment' %>
                                </a>
                            </div>
                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                                <div class="lg:col-span-1">
                                    <div class="card shadow-sm border border-slate-100">
                                        <div class="card-header bg-slate-50/50">
                                            <h3
                                                class="card-title flex items-center gap-2 text-sm font-bold text-gray-700">
                                                <i class="fa-solid fa-cloud-arrow-up text-emerald-600"></i> <%-
                                                    lan.Upload_Document || 'Upload Document' %>
                                            </h3>
                                        </div>
                                        <div class="card-body">
                                            <form action="/schooladmin/settings/documents" method="POST"
                                                enctype="multipart/form-data" class="space-y-4">
                                                <div class="form-group">
                                                    <label
                                                        class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%-
                                                            lan.Document_Type || 'Document Type' %> <span
                                                                class="text-rose-500">*</span></label>
                                                    <select name="document_type" required class="form-select">
                                                        <option value="" disabled selected><%- lan.Select_Document_Type
                                                                || 'Select document type' %></option>
                                                        <option value="registration_certificate"><%-
                                                                lan.Registration_Certificate
                                                                || 'Registration Certificate' %></option>
                                                        <option value="affiliation_certificate"><%-
                                                                lan.Affiliation_Certificate || 'Affiliation Certificate'
                                                                %></option>
                                                        <option value="udise"><%- lan.UDISE_Certificate
                                                                || 'UDISE Certificate' %></option>
                                                        <option value="address_proof"><%- lan.Address_Proof
                                                                || 'Address Proof' %></option>
                                                        <option value="other"><%- lan.Other_Compliance_Document
                                                                || 'Other Compliance Document' %></option>
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label
                                                        class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%-
                                                            lan.File_Attachment || 'File Attachment' %> <span
                                                                class="text-rose-500">*</span></label>
                                                    <input type="file" name="documents" required
                                                        accept=".pdf,image/*,.doc,.docx,.xls,.xlsx"
                                                        class="form-input block w-full text-xs text-slate-500 file:mr-4 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
                                                    <p class="text-[10px] text-slate-400 mt-1"><%-
                                                            lan.Allowed_Document_Formats
                                                            || 'Allowed formats: PDF, Word, Excel, JPG, PNG, WEBP (Max 5MB)'
                                                            %></p>
                                                </div>

                                                <button type="submit"
                                                    class="btn btn-primary w-full mt-4 flex items-center justify-center gap-2 text-sm font-bold shadow-sm transition">
                                                    <i class="fa-solid fa-cloud-arrow-up"></i> <%- lan.Upload_Document
                                                        || 'Upload Document' %>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <div class="lg:col-span-2 space-y-4">
                                    <div class="card shadow-sm border border-slate-100 h-full">
                                        <div class="card-header bg-slate-50/50">
                                            <h3
                                                class="card-title flex items-center gap-2 text-sm font-bold text-gray-700">
                                                <i class="fa-solid fa-folder-open text-emerald-600"></i> <%-
                                                    lan.Verification_Documents || 'Verification Documents' %>
                                            </h3>
                                        </div>
                                        <div class="card-body">
                                            <% const docLabels={ registration_certificate: lan.Registration_Certificate
                                                || 'Registration Certificate' , affiliation_certificate:
                                                lan.Affiliation_Certificate || 'Affiliation Certificate' , udise:
                                                lan.UDISE_Copy || 'UDISE Copy' , address_proof: lan.Address_Proof
                                                || 'Address Proof' , other: lan.Other_Compliance_Attachment
                                                || 'Other Compliance Attachment' }; const docIcons={
                                                registration_certificate: 'fa-file-signature' ,
                                                affiliation_certificate: 'fa-certificate' , udise: 'fa-landmark' ,
                                                address_proof: 'fa-map-location-dot' , other: 'fa-file-shield' }; %>
                                                <% if (documents && documents.length> 0) { %>
                                                    <div
                                                        class="table-container border border-slate-100 rounded-lg overflow-hidden">
                                                        <table class="data-table mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th><%- lan.Document_Type || 'Document Type' %></th>
                                                                    <th><%- lan.File_Identifier || 'File Identifier' %>
                                                                    </th>
                                                                    <th><%- lan.Uploaded_Date || 'Uploaded Date' %></th>
                                                                    <th class="text-right"><%- lan.Actions || 'Actions'
                                                                            %></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% documents.forEach(doc=> { %>
                                                                    <tr>
                                                                        <td>
                                                                            <div class="flex items-center gap-2.5">
                                                                                <div
                                                                                    class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                                                                    <i
                                                                                        class="fa-solid <%= docIcons[doc.document_type] || 'fa-file' %>"></i>
                                                                                </div>
                                                                                <div
                                                                                    class="font-bold text-slate-800 text-xs">
                                                                                    <%= docLabels[doc.document_type] ||
                                                                                        doc.document_type %>
                                                                                </div>
                                                                            </div>
                                                                        </td>
                                                                        <td>
                                                                            <code
                                                                                class="text-[11px] text-slate-600"><%= doc.file_path.length > 25 ? doc.file_path.substring(0, 22) + '...' : doc.file_path %></code>
                                                                        </td>
                                                                        <td>
                                                                            <span
                                                                                class="text-xs text-slate-500 font-medium">
                                                                                <%= new
                                                                                    Date(doc.uploaded_at).toLocaleDateString('en-IN',
                                                                                    {day: 'numeric' , month: 'short' ,
                                                                                    year: 'numeric' }) %>
                                                                            </span>
                                                                        </td>
                                                                        <td class="text-right">
                                                                            <a href="/uploads/others/<%= doc.file_path %>"
                                                                                target="_blank"
                                                                                class="btn btn-secondary btn-sm inline-flex items-center gap-1 hover:border-emerald-500 hover:text-emerald-600 transition">
                                                                                <i
                                                                                    class="fa-solid fa-arrow-up-right-from-square"></i>
                                                                                <%- lan.Open || 'Open' %>
                                                                            </a>
                                                                        </td>
                                                                    </tr>
                                                                    <% }); %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <% } else { %>
                                                        <div class="empty-state">
                                                            <div class="empty-state-icon">
                                                                <i class="fa-solid fa-file-shield"></i>
                                                            </div>
                                                            <h4 class="empty-state-title"><%- lan.No_Documents_Uploaded
                                                                    || 'No documents uploaded' %></h4>
                                                            <p class="empty-state-text"><%-
                                                                    lan.Submit_Verification_Documents_Desc
                                                                    || 'Submit your verification documents (Registration Certificate, UDISE, Address Proof) to complete school verification.'
                                                                    %></p>
                                                        </div>
                                                        <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>