<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/settings/documents' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Settings</h2>
                    <p class="text-xs text-gray-500 mt-1">Upload and manage school registration, affiliation, and compliance documents</p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="flex border-b border-gray-200 mb-6 gap-2">
                <a href="/schooladmin/settings" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-school"></i> General Info
                </a>
                <a href="/schooladmin/settings/bank" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-building-columns"></i> Bank Details
                </a>
                <a href="/schooladmin/settings/documents" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-emerald-600 text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-file-shield"></i> Documents
                </a>
                <a href="/schooladmin/settings/chat-permissions" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-emerald-600 flex items-center gap-2 transition duration-150">
                    <i class="fa-solid fa-comments"></i> Chat Permissions
                </a>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-1">
                    <div class="card shadow-sm border border-slate-100">
                        <div class="card-header bg-slate-50/50">
                            <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700">
                                <i class="fa-solid fa-cloud-arrow-up text-emerald-600"></i> Upload Document
                            </h3>
                        </div>
                        <div class="card-body">
                            <form action="/schooladmin/settings/documents" method="POST" enctype="multipart/form-data" class="space-y-4">
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]">Document Type <span class="text-rose-500">*</span></label>
                                    <select name="document_type" required class="form-select">
                                        <option value="" disabled selected>Select document type</option>
                                        <option value="registration_certificate">Registration Certificate</option>
                                        <option value="affiliation_certificate">Affiliation Certificate</option>
                                        <option value="udise">UDISE Certificate</option>
                                        <option value="address_proof">Address Proof</option>
                                        <option value="other">Other Compliance Document</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]">File Attachment <span class="text-rose-500">*</span></label>
                                    <input type="file" name="documents" required accept=".pdf,image/*,.doc,.docx,.xls,.xlsx" class="form-input block w-full text-xs text-slate-500 file:mr-4 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
                                    <p class="text-[10px] text-slate-400 mt-1">Allowed formats: PDF, Word, Excel, JPG, PNG, WEBP (Max 5MB)</p>
                                </div>

                                <button type="submit" class="btn btn-primary w-full mt-4 flex items-center justify-center gap-2 text-sm font-bold shadow-sm transition">
                                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload Document
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-2 space-y-4">
                    <div class="card shadow-sm border border-slate-100 h-full">
                        <div class="card-header bg-slate-50/50">
                            <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700">
                                <i class="fa-solid fa-folder-open text-emerald-600"></i> Verification Documents
                            </h3>
                        </div>
                        <div class="card-body">
                            <% 
                            const docLabels = {
                                registration_certificate: 'Registration Certificate',
                                affiliation_certificate: 'Affiliation Certificate',
                                udise: 'UDISE Copy',
                                address_proof: 'Address Proof',
                                other: 'Other Compliance Attachment'
                            };

                            const docIcons = {
                                registration_certificate: 'fa-file-signature',
                                affiliation_certificate: 'fa-certificate',
                                udise: 'fa-landmark',
                                address_proof: 'fa-map-location-dot',
                                other: 'fa-file-shield'
                            };
                            %>
                            <% if (documents && documents.length > 0) { %>
                                <div class="table-container border border-slate-100 rounded-lg overflow-hidden">
                                    <table class="data-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Document Type</th>
                                                <th>File Identifier</th>
                                                <th>Uploaded Date</th>
                                                <th class="text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% documents.forEach(doc => { %>
                                                <tr>
                                                    <td>
                                                        <div class="flex items-center gap-2.5">
                                                            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                                                <i class="fa-solid <%= docIcons[doc.document_type] || 'fa-file' %>"></i>
                                                            </div>
                                                            <div class="font-bold text-slate-800 text-xs"><%= docLabels[doc.document_type] || doc.document_type %></div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <code class="text-[11px] text-slate-600"><%= doc.file_path.length > 25 ? doc.file_path.substring(0, 22) + '...' : doc.file_path %></code>
                                                    </td>
                                                    <td>
                                                        <span class="text-xs text-slate-500 font-medium"><%= new Date(doc.uploaded_at).toLocaleDateString('en-IN', {day: 'numeric', month: 'short', year: 'numeric'}) %></span>
                                                    </td>
                                                    <td class="text-right">
                                                        <a href="/uploads/others/<%= doc.file_path %>" target="_blank" class="btn btn-secondary btn-sm inline-flex items-center gap-1 hover:border-emerald-500 hover:text-emerald-600 transition">
                                                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Open
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="empty-state">
                                    <div class="empty-state-icon">
                                        <i class="fa-solid fa-file-shield"></i>
                                    </div>
                                    <h4 class="empty-state-title">No documents uploaded</h4>
                                    <p class="empty-state-text">Submit your verification documents (Registration Certificate, UDISE, Address Proof) to complete school verification.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>