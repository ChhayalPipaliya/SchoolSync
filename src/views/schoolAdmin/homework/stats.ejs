<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Homework Analytics</h2>
                    <p class="text-xs text-gray-500 mt-1">School-wide metrics, class completion metrics, and teacher assignment analysis</p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-4 mb-6">
                <a href="/schooladmin/homework" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-slate-600 hover:bg-slate-50">Homework Directory</a>
                <a href="/schooladmin/homework/stats" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= currentPath === '/schooladmin/homework' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Homework Analytics</a>
            </div>
            <%
                const totalSchoolHomeworks = classStats.reduce((sum, c) => sum + parseInt(c.totalHomeworks || 0), 0);
                const totalSchoolSubmissions = classStats.reduce((sum, c) => sum + parseInt(c.totalSubmissions || 0), 0);
                const totalSchoolLateSubmissions = classStats.reduce((sum, c) => sum + parseInt(c.lateSubmissions || 0), 0);
                const avgSubmissionsPerHomework = totalSchoolHomeworks > 0 ? (totalSchoolSubmissions / totalSchoolHomeworks).toFixed(1) : '0.0';
            %>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-5 mb-6">
                <div class="card p-4 flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <div class="text-left">
                        <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Total Assignments</div>
                        <div class="text-xl font-bold text-slate-800"><%= totalSchoolHomeworks %></div>
                    </div>
                </div>
                <div class="card p-4 flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-file-arrow-up"></i>
                    </div>
                    <div class="text-left">
                        <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Submissions Received</div>
                        <div class="text-xl font-bold text-slate-800"><%= totalSchoolSubmissions %></div>
                    </div>
                </div>
                <div class="card p-4 flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                    <div class="text-left">
                        <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Late Submissions</div>
                        <div class="text-xl font-bold text-slate-800"><%= totalSchoolLateSubmissions %></div>
                    </div>
                </div>
                <div class="card p-4 flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div class="text-left">
                        <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Submissions Ratio</div>
                        <div class="text-xl font-bold text-slate-800"><%= avgSubmissionsPerHomework %> <span class="text-xs font-semibold text-slate-400">/ hw</span></div>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="table-card">
                    <div class="table-header-row bg-slate-50/20">
                        <h4 class="table-heading uppercase tracking-wider">Class Homework Ratios</h4>
                    </div>
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Class & Section</th>
                                    <th class="text-center">Total Assigned</th>
                                    <th class="text-center">Total Submissions</th>
                                    <th class="text-center">Late Submissions</th>
                                    <th class="text-center">Avg Submissions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!classStats || classStats.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-8 text-gray-400 font-medium">No class statistics available.</td>
                                    </tr>
                                <% } %>
                                <% (classStats||[]).forEach(c => { %>
                                    <tr>
                                        <td>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide border bg-blue-50 text-blue-700 border-blue-100">
                                                Class <%= c.class_name %> - <%= c.section %>
                                            </span>
                                        </td>
                                        <td class="text-center font-semibold text-slate-700"><%= c.totalHomeworks %></td>
                                        <td class="text-center font-semibold text-slate-700"><%= c.totalSubmissions %></td>
                                        <td class="text-center font-semibold text-slate-600">
                                            <% if (c.lateSubmissions > 0) { %>
                                                <span class="text-amber-600 font-bold"><%= c.lateSubmissions %></span>
                                            <% } else { %>
                                                <span class="text-slate-400">0</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <div class="flex items-center justify-center gap-1.5">
                                                <span class="font-bold text-slate-800"><%= c.avgSubmissions || '0.0' %></span>
                                                <span class="text-[10px] text-slate-400">/ hw</span>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="table-card">
                    <div class="table-header-row bg-slate-50/20">
                        <h4 class="table-heading uppercase tracking-wider">Teacher Assignee Activity</h4>
                    </div>
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Teacher Name</th>
                                    <th>Email</th>
                                    <th class="text-center">Homeworks Created</th>
                                    <th class="text-center">Submissions Received</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!teacherStats || teacherStats.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-8 text-gray-400 font-medium">No teacher statistics available.</td>
                                    </tr>
                                <% } %>
                                <% (teacherStats||[]).forEach(t => { %>
                                    <tr>
                                        <td>
                                            <div class="font-bold text-gray-800 text-[13px]"><%= t.teacherName %></div>
                                        </td>
                                        <td class="font-mono text-[11px] text-slate-500"><%= t.teacherEmail %></td>
                                        <td class="text-center font-semibold text-slate-700"><%= t.totalHomeworks %></td>
                                        <td class="text-center font-semibold text-slate-700"><%= t.totalSubmissions %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>