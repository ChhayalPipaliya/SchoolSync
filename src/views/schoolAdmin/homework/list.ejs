<%- include('../../partials/head') %>
<style>
    .hw-nav-tabs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid #E2E8F0;
        padding-bottom: 12px;
        margin-bottom: 16px;
    }
    .hw-nav-tab {
        padding: 8px 16px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-radius: 8px;
        color: #64748B;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .hw-nav-tab:hover {
        background: #F1F5F9;
        color: #0F172A;
    }
    .hw-nav-tab.active {
        background: #ECFDF5;
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .hw-filter-form {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
        align-items: flex-end;
    }

    @media (max-width: 1024px) {
        .hw-filter-form {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 768px) {
        .schooladmin-theme .content {
            padding: 12px 10px !important;
        }
        .hw-nav-tabs {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 6px !important;
            margin-bottom: 14px !important;
        }
        .hw-nav-tab {
            text-align: center !important;
            padding: 8px 4px !important;
            font-size: 10.5px !important;
        }
        .hw-filter-form {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }
        .hw-filter-card {
            padding: 14px !important;
            border-radius: 12px !important;
            margin-bottom: 14px !important;
        }
        .hw-btn-group {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 8px !important;
            width: 100% !important;
        }
        .hw-btn-group .btn {
            height: 38px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 12px !important;
        }
        .table-card {
            border-radius: 12px !important;
        }
        .table-container {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
        }
        .data-table {
            min-width: 820px !important;
            width: 100% !important;
        }
        .data-table th,
        .data-table td {
            padding: 8px 10px !important;
            font-size: 12px !important;
        }
    }

    /* Dark Mode */
    [data-theme="dark"] .hw-nav-tab,
    .light-mode-disabled .hw-nav-tab {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .hw-nav-tab:hover,
    .light-mode-disabled .hw-nav-tab:hover {
        background: #1E293B !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .hw-nav-tab.active,
    .light-mode-disabled .hw-nav-tab.active {
        background: rgba(16, 185, 129, 0.15) !important;
        color: #34D399 !important;
        border-color: rgba(16, 185, 129, 0.3) !important;
    }
    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .card select,
    .light-mode-disabled .card select,
    [data-theme="dark"] .card input,
    .light-mode-disabled .card input {
        background: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .table-card,
    .light-mode-disabled .table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table-header-row,
    .light-mode-disabled .table-header-row {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .table-heading,
    .light-mode-disabled .table-heading {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .data-table thead th,
    .light-mode-disabled .data-table thead th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .data-table tbody td,
    .light-mode-disabled .data-table tbody td {
        border-color: #242F4D !important;
        color: #E2E8F0 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Homework Monitoring</h2>
                    <p class="text-xs text-gray-500 mt-1">Review homework assignments, track submission statuses, and analyze class progress</p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="hw-nav-tabs">
                <a href="/schooladmin/homework" class="hw-nav-tab active">Homework Directory</a>
                <a href="/schooladmin/homework/stats" class="hw-nav-tab">Homework Analytics</a>
            </div>
            <div class="card p-5 mb-4 hw-filter-card">
                <form method="GET" action="/schooladmin/homework" class="hw-filter-form">
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Class</label>
                        <select name="class_id" class="form-select text-xs">
                            <option value="">All Classes</option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>" <%= filters.class_id == c.id ? 'selected' : '' %>>
                                    Class <%= c.name %> - <%= c.section %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Subject</label>
                        <select name="subject_id" class="form-select text-xs">
                            <option value="">All Subjects</option>
                            <% subjects.forEach(s => { %>
                                <option value="<%= s.id %>" <%= filters.subject_id == s.id ? 'selected' : '' %>>
                                    <%= s.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Teacher</label>
                        <select name="teacher_id" class="form-select text-xs">
                            <option value="">All Teachers</option>
                            <% teachers.forEach(t => { %>
                                <option value="<%= t.id %>" <%= filters.teacher_id == t.id ? 'selected' : '' %>>
                                    <%= t.first_name %> <%= t.last_name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Status</label>
                        <select name="status" class="form-select text-xs">
                            <option value="">All Statuses</option>
                            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                            <option value="overdue" <%= filters.status === 'overdue' ? 'selected' : '' %>>Overdue</option>
                            <option value="closed" <%= filters.status === 'closed' ? 'selected' : '' %>>Closed</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Due From</label>
                        <input type="date" name="start_date" value="<%= filters.start_date || '' %>" class="form-input text-xs">
                    </div>
                    <div class="hw-btn-group flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-1 font-bold text-[11px]">
                            <i class="fas fa-filter mr-1"></i> Filter
                        </button>
                        <a href="/schooladmin/homework" class="btn btn-secondary btn-sm flex-1 text-center flex items-center justify-center font-bold text-[11px]">
                            Reset
                        </a>
                    </div>
                </form>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider">All Homework Assignments</h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Homework Title</th>
                                <th>Class</th>
                                <th>Subject</th>
                                <th>Assigned By</th>
                                <th>Due Date</th>
                                <th class="text-center">Submissions</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!homeworks || homeworks.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center py-12 text-gray-400 font-medium">No homework assignments found matching the active filters.</td>
                                </tr>
                            <% } %>
                            <% (homeworks||[]).forEach(h => { 
                                const submissionRate = h.totalStudents > 0 ? Math.round((h.submissionCount / h.totalStudents) * 100) : 0;
                                const now = new Date();
                                const dueDate = new Date(h.due_date);
                                const isOverdue = h.status === 'active' && dueDate < now;
                                let statusLabel = h.status;
                                let statusClass = 'bg-slate-50 text-slate-500 border-slate-100';
                                if (h.status === 'closed') {
                                    statusLabel = 'Closed';
                                    statusClass = 'bg-slate-50 text-slate-500 border-slate-100';
                                } else if (isOverdue) {
                                    statusLabel = 'Overdue';
                                    statusClass = 'bg-rose-50 text-rose-700 border-rose-100';
                                } else {
                                    statusLabel = 'Active';
                                    statusClass = 'bg-emerald-50 text-emerald-700 border-emerald-100';
                                }
                            %>
                                <tr>
                                    <td style="white-space: nowrap;">
                                        <div class="font-bold text-gray-800 text-[13px]"><%= h.title %></div>
                                        <% if (h.file_path) { %>
                                            <div class="text-[10px] text-emerald-600 mt-1"><i class="fa-solid fa-paperclip mr-1"></i>Attachment included</div>
                                        <% } %>
                                    </td>
                                    <td style="white-space: nowrap;">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide border bg-blue-50 text-blue-700 border-blue-100" style="white-space: nowrap;">
                                            Class <%= h.className %><%= h.stream && h.stream !== 'General' ? ' - ' + h.stream : '' %> - <%= h.section %>
                                        </span>
                                    </td>
                                    <td class="font-medium text-slate-700" style="white-space: nowrap;"><%= h.subjectName %></td>
                                    <td class="font-medium text-slate-600" style="white-space: nowrap;"><%= h.teacherName %></td>
                                    <td class="font-medium text-slate-600 text-xs" style="white-space: nowrap;">
                                        <span class="<%= isOverdue ? 'text-rose-600 font-bold' : '' %>">
                                            <%= new Date(h.due_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                        </span>
                                    </td>
                                    <td style="white-space: nowrap;">
                                        <div class="flex flex-col gap-1 items-center justify-center">
                                            <span class="font-bold text-slate-800"><%= h.submissionCount %> / <%= h.totalStudents %></span>
                                            <div class="w-16 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                                <div class="h-full bg-emerald-500 rounded-full hw-progress-bar" data-rate="<%= submissionRate %>"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center" style="white-space: nowrap;">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase border <%= statusClass %>" style="white-space: nowrap;">
                                            <%= statusLabel %>
                                        </span>
                                    </td>
                                    <td class="text-center" style="white-space: nowrap;">
                                        <div class="flex items-center justify-center gap-1.5" style="white-space: nowrap;">
                                            <a href="/schooladmin/homework/<%= h.id %>" class="btn btn-sm btn-secondary py-1 px-3 text-[11px] font-bold flex items-center gap-1 transition">
                                                <i class="fa-solid fa-eye"></i> Roster
                                            </a>
                                            <form method="POST" action="/schooladmin/homework/toggle-status/<%= h.id %>" class="inline-block m-0" onsubmit="return confirm('Change status of this homework?')">
                                                <button type="submit" class="btn btn-sm <%= h.status === 'active' ? 'btn-danger' : 'btn-primary' %> py-1 px-3 text-[11px] font-bold transition">
                                                    <%= h.status === 'active' ? 'Close' : 'Reopen' %>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.hw-progress-bar').forEach(function(el) {
            var rate = el.getAttribute('data-rate') || 0;
            el.style.width = rate + '%';
        });
    });
</script>
<%- include('../../partials/footer') %>