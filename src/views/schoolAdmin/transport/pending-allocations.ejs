<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Pending Transport Allocations</h2>
          <p class="text-xs text-gray-500 mt-1">Students admitted with transport requested who need route allocation</p>
        </div>
        <div class="flex items-center gap-2">
          <a href="/schooladmin/transport/allocations" class="btn btn-secondary flex items-center gap-2 text-xs font-bold">
            <i class="fa-solid fa-list"></i> View Operational Allocations
          </a>
        </div>
      </div>
      <%- include('../../partials/flashMessages') %>
      <%- include('_tabs', { currentPath: currentPath }) %>
      <div class="table-card mb-6">
        <div class="table-header-row bg-slate-50/20 flex items-center justify-between">
          <h4 class="table-heading uppercase tracking-wider">Unallocated Students Queue (<%= pendingList ? pendingList.length : 0 %>)</h4>
        </div>
        <div class="p-4 overflow-x-auto">
          <table class="data-table w-full">
            <thead>
              <tr>
                <th>Student Name</th>
                <th>Class & Section</th>
                <th>Roll No</th>
                <th>Requested Route (Admission)</th>
                <th>Pickup / Drop Point</th>
                <th>Assign Operational Route</th>
              </tr>
            </thead>
            <tbody>
              <% if (!pendingList || pendingList.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center py-8 text-emerald-600 font-medium">
                    <i class="fa-solid fa-circle-check text-xl mb-2 block"></i>
                    All students with transport requirements have active route allocations!
                  </td>
                </tr>
              <% } else { %>
                <% pendingList.forEach(student => { %>
                  <tr>
                    <td class="font-bold text-slate-800">
                      <%= student.first_name %> <%= student.last_name %>
                    </td>
                    <td>
                      <%= student.class_name ? (student.class_name + (student.section ? ' (' + student.section + ')' : '')) : 'N/A' %>
                    </td>
                    <td class="font-mono text-xs text-slate-600">
                      <%= student.roll_no || '-' %>
                    </td>
                    <td>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-50 text-amber-800 border border-amber-200">
                        <i class="fa-solid fa-pen-line mr-1 text-[10px]"></i>
                        <%= student.transport_route || 'Not specified' %>
                      </span>
                    </td>
                    <td class="text-xs text-slate-600">
                      <div><strong class="text-slate-500">P:</strong> <%= student.pickup_point || '-' %></div>
                      <div><strong class="text-slate-500">D:</strong> <%= student.drop_point || '-' %></div>
                    </td>
                    <td>
                      <a href="/schooladmin/transport/allocations/new?studentId=<%= student.studentId %>" class="btn btn-sm btn-primary text-xs flex items-center gap-1 whitespace-nowrap inline-flex">
                        Assign Route <i class="fa-solid fa-arrow-right text-[10px]"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>