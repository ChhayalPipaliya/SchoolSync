<%- include('../../partials/head', { title: title }) %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { active: 'transport', user: user }) %>
  <div class="main-panel">
    <%- include('../../partials/header', { user: user }) %>
    <div class="content">
      <%- include('../transport/_tabs', { active: 'export', currentPath: currentPath }) %>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-4 mb-6">
        <div>
          <h3 class="text-xl font-bold text-gray-800 tracking-tight">Transport Export Center</h3>
          <p class="text-xs text-gray-500 mt-1">
            Generate route and allocation excel reports for transport operations.
          </p>
        </div>
        <a href="/schooladmin/transport/reports"
           class="btn btn-outline text-xs flex items-center gap-2">
          <i class="fas fa-chart-line"></i> Transport Reports
        </a>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-6">
        <div class="card p-5 border-l-4 border-emerald-500 bg-emerald-50">
          <p class="text-[10px] uppercase tracking-wider font-bold text-emerald-700">Active Routes</p>
          <p class="text-3xl font-bold text-emerald-900 mt-2"><%= stats.activeRoutes %></p>
          <p class="text-xs text-slate-500 mt-1">Routes configured for your school</p>
        </div>
        <div class="card p-5 border-l-4 border-slate-500 bg-slate-50">
          <p class="text-[10px] uppercase tracking-wider font-bold text-slate-500">Active Vehicles</p>
          <p class="text-3xl font-bold text-slate-900 mt-2"><%= stats.activeVehicles %></p>
          <p class="text-xs text-slate-500 mt-1">Vehicles available for transport duty</p>
        </div>
        <div class="card p-5 border-l-4 border-cyan-500 bg-cyan-50">
          <p class="text-[10px] uppercase tracking-wider font-bold text-cyan-700">Active Allocations</p>
          <p class="text-3xl font-bold text-slate-900 mt-2"><%= stats.activeAllocations %></p>
          <p class="text-xs text-slate-500 mt-1">Students assigned to routes</p>
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
        <div class="card p-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h4 class="text-sm font-bold uppercase tracking-wider text-slate-500">Export Packages</h4>
              <p class="text-xs text-slate-400 mt-1">Download prepared transport datasets.</p>
            </div>
            <span class="inline-flex items-center text-[11px] uppercase tracking-wider text-emerald-700 bg-emerald-100 px-2 py-1 rounded-full">Excel</span>
          </div>
          <div class="space-y-3">
            <a href="/schooladmin/transport/reports/export?format=excel"
               class="block p-4 rounded-xl border border-slate-200 hover:border-emerald-300 transition bg-white">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-bold text-slate-800">Route & Allocation Report</p>
                  <p class="text-xs text-slate-500 mt-1">Export all routes and student allocations in one workbook.</p>
                </div>
                <i class="fas fa-file-excel text-emerald-500 text-xl"></i>
              </div>
            </a>
            <a href="/schooladmin/transport/reports/export?format=excel"
               class="block p-4 rounded-xl border border-slate-200 hover:border-emerald-300 transition bg-white">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-bold text-slate-800">Transport Operations Export</p>
                  <p class="text-xs text-slate-500 mt-1">Download the latest transport report package.</p>
                </div>
                <i class="fas fa-download text-slate-400 text-xl"></i>
              </div>
            </a>
          </div>
        </div>
        <div class="card p-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h4 class="text-sm font-bold uppercase tracking-wider text-slate-500">Quick Actions</h4>
              <p class="text-xs text-slate-400 mt-1">Use one-click exports for route and allocation summaries.</p>
            </div>
          </div>
          <div class="grid grid-cols-1 gap-3">
            <a href="/schooladmin/transport/reports/export?format=excel"
               class="btn btn-primary w-full text-xs font-bold py-3 flex items-center justify-center gap-2">
              <i class="fas fa-file-export"></i> Export Route Workbook
            </a>
            <a href="/schooladmin/transport/reports/export?format=csv"
               class="btn btn-secondary w-full text-xs font-bold py-3 flex items-center justify-center gap-2">
              <i class="fas fa-file-csv"></i> Export Allocation CSV
            </a>
          </div>
        </div>
      </div>
      <div class="table-card">
        <div class="table-header-row bg-slate-50/40">
          <h4 class="table-heading uppercase tracking-wider"><i class="fa-solid fa-clock-rotate-left mr-2 text-emerald-600"></i> Recent Exports</h4>
        </div>
        <div class="table-container">
          <table class="data-table">
            <thead>
              <tr>
                <th>When</th>
                <th>Report</th>
                <th>Status</th>
                <th class="text-right">Download</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td colspan="4" class="text-center py-12 text-gray-400">Recent export history is currently available from the bulk export dashboard.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
</div>
</div>
<%- include('../../partials/footer') %>