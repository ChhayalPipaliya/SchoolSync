<%- include('../../partials/head', { title: title }) %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { active: 'transport' , user: user }) %>
            <div class="main-panel">
                <%- include('../../partials/header', { user: user }) %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-file-excel"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%= lan.Transport_Export_Center || 'Transport Export Center' %>
                                        </h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;">
                                            <%= lan.Transport_Export_Subtitle
                                                || 'Download master workbooks, student route manifests, and transport logs'
                                                %>
                                        </p>
                                    </div>
                                </div>
                                <div>
                                    <a href="/schooladmin/transport/reports" class="btn"
                                        style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                                        <i class="fas fa-chart-line"></i>
                                        <%= lan.Transport_Reports || 'Transport Reports' %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <%- include('../transport/_tabs', { active: 'export' , currentPath: currentPath }) %>
                            <%- include('../../partials/flashMessages') %>
                                <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-3">
                                    <div class="card p-5 border-l-4 border-emerald-500 bg-emerald-50">
                                        <p class="text-[10px] uppercase tracking-wider font-bold text-emerald-700">
                                            <%= lan.Active_Routes %>
                                        </p>
                                        <p class="text-3xl font-bold text-emerald-900 mt-2">
                                            <%= stats.activeRoutes %>
                                        </p>
                                        <p class="text-xs text-slate-500 mt-1">
                                            <%= lan.Routes_Configured_School %>
                                        </p>
                                    </div>
                                    <div class="card p-5 border-l-4 border-slate-500 bg-slate-50">
                                        <p class="text-[10px] uppercase tracking-wider font-bold text-slate-500">
                                            <%= lan.Active_Vehicles %>
                                        </p>
                                        <p class="text-3xl font-bold text-slate-900 mt-2">
                                            <%= stats.activeVehicles %>
                                        </p>
                                        <p class="text-xs text-slate-500 mt-1">
                                            <%= lan.Vehicles_Available_Duty %>
                                        </p>
                                    </div>
                                    <div class="card p-5 border-l-4 border-cyan-500 bg-cyan-50">
                                        <p class="text-[10px] uppercase tracking-wider font-bold text-cyan-700">
                                            <%= lan.Active_Allocations %>
                                        </p>
                                        <p class="text-3xl font-bold text-slate-900 mt-2">
                                            <%= stats.activeAllocations %>
                                        </p>
                                        <p class="text-xs text-slate-500 mt-1">
                                            <%= lan.Students_Assigned_Routes %>
                                        </p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
                                    <div class="card p-6">
                                        <div class="flex items-center justify-between mb-3">
                                            <div>
                                                <h4 class="text-sm font-bold uppercase tracking-wider text-slate-500">
                                                    <%= lan.Export_Packages %>
                                                </h4>
                                                <p class="text-xs text-slate-400 mt-1">
                                                    <%= lan.Download_Transport_Datasets %>
                                                </p>
                                            </div>
                                            <span
                                                class="inline-flex items-center text-[11px] uppercase tracking-wider text-emerald-700 bg-emerald-100 px-2 py-1 rounded-full">Excel</span>
                                        </div>
                                        <div class="space-y-3">
                                            <a href="/schooladmin/transport/reports/export?format=excel"
                                                class="block p-4 rounded-xl border border-slate-200 hover:border-emerald-300 transition bg-white">
                                                <div class="flex items-center justify-between">
                                                    <div>
                                                        <p class="text-sm font-bold text-slate-800">
                                                            <%= lan.Route_Allocation_Report %>
                                                        </p>
                                                        <p class="text-xs text-slate-500 mt-1">
                                                            <%= lan.Export_Routes_Workbook_Desc %>
                                                        </p>
                                                    </div>
                                                    <i class="fas fa-file-excel text-emerald-500 text-xl"></i>
                                                </div>
                                            </a>
                                            <a href="/schooladmin/transport/reports/export?format=excel"
                                                class="block p-4 rounded-xl border border-slate-200 hover:border-emerald-300 transition bg-white">
                                                <div class="flex items-center justify-between">
                                                    <div>
                                                        <p class="text-sm font-bold text-slate-800">
                                                            <%= lan.Transport_Operations_Export %>
                                                        </p>
                                                        <p class="text-xs text-slate-500 mt-1">
                                                            <%= lan.Download_Latest_Transport_Report %>
                                                        </p>
                                                    </div>
                                                    <i class="fas fa-download text-slate-400 text-xl"></i>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="card p-6">
                                        <div class="flex items-center justify-between mb-3">
                                            <div>
                                                <h4 class="text-sm font-bold uppercase tracking-wider text-slate-500">
                                                    <%= lan.Quick_Actions %>
                                                </h4>
                                                <p class="text-xs text-slate-400 mt-1">
                                                    <%= lan.One_Click_Exports_Desc %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="grid grid-cols-1 gap-3">
                                            <a href="/schooladmin/transport/reports/export?format=excel"
                                                class="btn btn-primary w-full text-xs font-bold py-3 flex items-center justify-center gap-2">
                                                <i class="fas fa-file-export"></i>
                                                <%= lan.Export_Route_Workbook %>
                                            </a>
                                            <a href="/schooladmin/transport/reports/export?format=csv"
                                                class="btn btn-secondary w-full text-xs font-bold py-3 flex items-center justify-center gap-2">
                                                <i class="fas fa-file-csv"></i>
                                                <%= lan.Export_Allocation_CSV %>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-card">
                                    <div class="table-header-row bg-slate-50/40">
                                        <h4 class="table-heading uppercase tracking-wider"><i
                                                class="fa-solid fa-clock-rotate-left mr-2 text-emerald-600"></i>
                                            <%= lan.Recent_Exports %>
                                        </h4>
                                    </div>
                                    <div class="table-container">
                                        <table class="data-table">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        <%= lan.When %>
                                                    </th>
                                                    <th>
                                                        <%= lan.Report %>
                                                    </th>
                                                    <th>
                                                        <%= lan.Status %>
                                                    </th>
                                                    <th class="text-right">
                                                        <%= lan.Download %>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td colspan="4" class="text-center py-12 text-gray-400">
                                                        <%= lan.Recent_Export_History_Notice %>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>