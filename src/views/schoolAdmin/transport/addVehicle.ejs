<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= vehicle ? lan.Edit : lan.Add %> <%= lan.Fleet_Vehicle %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%= lan.Configure_Vehicle_Subtitle %></p>
                </div>
                <a href="/schooladmin/transport/vehicles" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-arrow-left"></i> <%= lan.Back_To_Fleet %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card p-5">
                <form method="POST" action="<%= vehicle ? '/schooladmin/transport/vehicles/edit/' + vehicle.id : '/schooladmin/transport/vehicles/add' %>" class="space-y-5">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="vehicleNumber" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Vehicle_Number %> *</label>
                            <input type="text" id="vehicleNumber" name="vehicleNumber" value="<%= vehicle ? vehicle.vehicleNumber : '' %>" required class="form-input w-full" placeholder="e.g., MH-12-AB-1234">
                        </div>
                        <div class="form-group">
                            <label for="busNumber" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Internal_Vehicle_ID %></label>
                            <input type="text" id="busNumber" name="busNumber" value="<%= vehicle ? vehicle.busNumber : '' %>" class="form-input w-full" placeholder="e.g., BUS-004">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="model" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Model_Name %></label>
                            <input type="text" id="model" name="model" value="<%= vehicle ? vehicle.model : '' %>" class="form-input w-full" placeholder="e.g., Tata Winger, Force Traveller">
                        </div>
                        <div class="form-group">
                            <label for="type" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Vehicle_Type %> *</label>
                            <select id="type" name="type" required class="form-select w-full">
                                <option value="mini_bus" <%= vehicle && vehicle.type === 'mini_bus' ? 'selected' : '' %>><%= lan.Mini_Bus %></option>
                                <option value="bus" <%= vehicle && vehicle.type === 'bus' ? 'selected' : '' %>><%= lan.Standard_Bus %></option>
                                <option value="van" <%= vehicle && vehicle.type === 'van' ? 'selected' : '' %>><%= lan.Van %></option>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="capacity" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Seating_Capacity %> *</label>
                            <input type="number" id="capacity" name="capacity" value="<%= vehicle ? vehicle.capacity : '' %>" min="1" required class="form-input w-full" placeholder="e.g., 25">
                        </div>
                        <div class="form-group">
                            <label for="ownershipType" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Ownership_Type %></label>
                            <select id="ownershipType" name="ownershipType" class="form-select w-full">
                                <option value=""><%= lan.Select_Ownership %></option>
                                <% ownershipOptions.forEach(option => { %>
                                    <option value="<%= option %>" <%= vehicle && vehicle.ownershipType === option ? 'selected' : '' %>><%= option.replace('_', ' ').replace(/\b\w/g, c => c.toUpperCase()) %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="fuelType" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Fuel_Type %></label>
                            <select id="fuelType" name="fuelType" class="form-select w-full">
                                <option value=""><%= lan.Select_Fuel_Type %></option>
                                <% fuelTypes.forEach(option => { %>
                                    <option value="<%= option %>" <%= vehicle && vehicle.fuelType === option ? 'selected' : '' %>><%= option.toUpperCase() %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="driver_id" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Assigned_Driver %></label>
                            <select id="driver_id" name="driver_id" class="form-select w-full">
                                <option value=""><%= lan.No_Driver_Assigned %></option>
                                <% drivers.forEach(d => { %>
                                    <option value="<%= d.id %>" <%= vehicle && vehicle.driverId === d.id ? 'selected' : '' %>><%= d.first_name %> <%= d.last_name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="gpsDeviceId" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.GPS_Device_ID %></label>
                            <input type="text" id="gpsDeviceId" name="gpsDeviceId" value="<%= vehicle ? vehicle.gpsDeviceId : '' %>" class="form-input w-full" placeholder="e.g., GPS-4571">
                        </div>
                        <div class="form-group">
                            <label for="vehiclePhoto" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Vehicle_Photo_URL %></label>
                            <input type="url" id="vehiclePhoto" name="vehiclePhoto" value="<%= vehicle ? vehicle.vehiclePhoto : '' %>" class="form-input w-full" placeholder="Optional image link">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="insuranceExpiry" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Insurance_Expiry %></label>
                            <input type="date" id="insuranceExpiry" name="insuranceExpiry" value="<%= vehicle ? vehicle.insuranceExpiry : '' %>" class="form-input w-full">
                        </div>
                        <div class="form-group">
                            <label for="permitExpiry" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Permit_Expiry %></label>
                            <input type="date" id="permitExpiry" name="permitExpiry" value="<%= vehicle ? vehicle.permitExpiry : '' %>" class="form-input w-full">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="fitnessExpiry" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Fitness_Expiry %></label>
                            <input type="date" id="fitnessExpiry" name="fitnessExpiry" value="<%= vehicle ? vehicle.fitnessExpiry : '' %>" class="form-input w-full">
                        </div>
                        <div class="form-group">
                            <label for="pucExpiry" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.PUC_Expiry %></label>
                            <input type="date" id="pucExpiry" name="pucExpiry" value="<%= vehicle ? vehicle.pucExpiry : '' %>" class="form-input w-full">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="lastServiceDate" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Last_Service_Date %></label>
                            <input type="date" id="lastServiceDate" name="lastServiceDate" value="<%= vehicle ? vehicle.lastServiceDate : '' %>" class="form-input w-full">
                        </div>
                        <div class="form-group">
                            <label for="nextServiceDate" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Next_Service_Date %></label>
                            <input type="date" id="nextServiceDate" name="nextServiceDate" value="<%= vehicle ? vehicle.nextServiceDate : '' %>" class="form-input w-full">
                        </div>
                    </div>
                    <% if (vehicle) { %>
                        <div class="form-group">
                            <label for="status" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Fleet_Status %> *</label>
                            <select id="status" name="status" required class="form-select w-full">
                                <option value="active" <%= vehicle.status === 'active' ? 'selected' : '' %>><%= lan.Active_In_Service %></option>
                                <option value="inactive" <%= vehicle.status === 'inactive' ? 'selected' : '' %>><%= lan.Inactive %></option>
                                <option value="maintenance" <%= vehicle.status === 'maintenance' ? 'selected' : '' %>><%= lan.Maintenance %></option>
                            </select>
                        </div>
                    <% } %>
                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1 py-2.5 font-semibold">
                            <i class="fa-solid fa-save mr-1.5"></i> <%= lan.Save_Vehicle %>
                        </button>
                        <a href="/schooladmin/transport/vehicles" class="btn btn-secondary flex-1 py-2.5 font-semibold text-center">
                            <%= lan.Cancel %>
                        </a>
                    </div>
                </form>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
