<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <!-- Header Section -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= vehicle ? 'Edit' : 'Add' %> Fleet Vehicle</h2>
                    <p class="text-xs text-gray-500 mt-1">Configure registration number, seating capacity, and model details</p>
                </div>
                <a href="/schooladmin/transport/vehicles" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-arrow-left"></i> Back to Fleet
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Form Card -->
            <div class="card max-w-xl mx-auto p-6">
                <form method="POST" action="<%= vehicle ? '/schooladmin/transport/vehicles/edit/' + vehicle.id : '/schooladmin/transport/vehicles/add' %>" class="space-y-5">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="vehicleNumber" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Vehicle Number *</label>
                            <input type="text" id="vehicleNumber" name="vehicleNumber" value="<%= vehicle ? vehicle.vehicleNumber : '' %>" required class="form-input w-full" placeholder="e.g., MH-12-AB-1234">
                        </div>

                        <div class="form-group">
                            <label for="busNumber" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Internal Vehicle ID</label>
                            <input type="text" id="busNumber" name="busNumber" value="<%= vehicle ? vehicle.busNumber : '' %>" class="form-input w-full" placeholder="e.g., BUS-004">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="model" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Model Name</label>
                            <input type="text" id="model" name="model" value="<%= vehicle ? vehicle.model : '' %>" class="form-input w-full" placeholder="e.g., Tata Winger, Force Traveller">
                        </div>

                        <div class="form-group">
                            <label for="type" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Vehicle Type *</label>
                            <select id="type" name="type" required class="form-select w-full">
                                <option value="mini_bus" <%= vehicle && vehicle.type === 'mini_bus' ? 'selected' : '' %>>Mini Bus</option>
                                <option value="bus" <%= vehicle && vehicle.type === 'bus' ? 'selected' : '' %>>Standard Bus</option>
                                <option value="van" <%= vehicle && vehicle.type === 'van' ? 'selected' : '' %>>Van</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="capacity" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Seating Capacity *</label>
                            <input type="number" id="capacity" name="capacity" value="<%= vehicle ? vehicle.capacity : '' %>" min="1" required class="form-input w-full" placeholder="e.g., 25">
                        </div>
                        <div class="form-group">
                            <label for="ownershipType" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Ownership Type</label>
                            <select id="ownershipType" name="ownershipType" class="form-select w-full">
                                <option value="">Select ownership</option>
                                <% ownershipOptions.forEach(option => { %>
                                    <option value="<%= option %>" <%= vehicle && vehicle.ownershipType === option ? 'selected' : '' %>><%= option.replace('_', ' ').replace(/\b\w/g, c => c.toUpperCase()) %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="fuelType" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Fuel Type</label>
                            <select id="fuelType" name="fuelType" class="form-select w-full">
                                <option value="">Select fuel type</option>
                                <% fuelTypes.forEach(option => { %>
                                    <option value="<%= option %>" <%= vehicle && vehicle.fuelType === option ? 'selected' : '' %>><%= option.toUpperCase() %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="driver_id" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Assigned Driver</label>
                            <select id="driver_id" name="driver_id" class="form-select w-full">
                                <option value="">No driver assigned</option>
                                <% drivers.forEach(d => { %>
                                    <option value="<%= d.id %>" <%= vehicle && vehicle.driverId === d.id ? 'selected' : '' %>><%= d.first_name %> <%= d.last_name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="gpsDeviceId" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">GPS Device ID</label>
                            <input type="text" id="gpsDeviceId" name="gpsDeviceId" value="<%= vehicle ? vehicle.gpsDeviceId : '' %>" class="form-input w-full" placeholder="e.g., GPS-4571">
                        </div>
                        <div class="form-group">
                            <label for="vehiclePhoto" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Vehicle Photo URL</label>
                            <input type="url" id="vehiclePhoto" name="vehiclePhoto" value="<%= vehicle ? vehicle.vehiclePhoto : '' %>" class="form-input w-full" placeholder="Optional image link">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="insuranceExpiry" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Insurance Expiry</label>
                            <input type="date" id="insuranceExpiry" name="insuranceExpiry" value="<%= vehicle ? vehicle.insuranceExpiry : '' %>" class="form-input w-full">
                        </div>
                        <div class="form-group">
                            <label for="permitExpiry" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Permit Expiry</label>
                            <input type="date" id="permitExpiry" name="permitExpiry" value="<%= vehicle ? vehicle.permitExpiry : '' %>" class="form-input w-full">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="fitnessExpiry" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Fitness Expiry</label>
                            <input type="date" id="fitnessExpiry" name="fitnessExpiry" value="<%= vehicle ? vehicle.fitnessExpiry : '' %>" class="form-input w-full">
                        </div>
                        <div class="form-group">
                            <label for="pucExpiry" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">PUC Expiry</label>
                            <input type="date" id="pucExpiry" name="pucExpiry" value="<%= vehicle ? vehicle.pucExpiry : '' %>" class="form-input w-full">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="lastServiceDate" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Last Service Date</label>
                            <input type="date" id="lastServiceDate" name="lastServiceDate" value="<%= vehicle ? vehicle.lastServiceDate : '' %>" class="form-input w-full">
                        </div>
                        <div class="form-group">
                            <label for="nextServiceDate" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Next Service Date</label>
                            <input type="date" id="nextServiceDate" name="nextServiceDate" value="<%= vehicle ? vehicle.nextServiceDate : '' %>" class="form-input w-full">
                        </div>
                    </div>

                    <% if (vehicle) { %>
                        <div class="form-group">
                            <label for="status" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Fleet Status *</label>
                            <select id="status" name="status" required class="form-select w-full">
                                <option value="active" <%= vehicle.status === 'active' ? 'selected' : '' %>>Active / In Service</option>
                                <option value="inactive" <%= vehicle.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                <option value="maintenance" <%= vehicle.status === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
                            </select>
                        </div>
                    <% } %>

                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1 py-2.5 font-semibold">
                            <i class="fa-solid fa-save mr-1.5"></i> Save Vehicle
                        </button>
                        <a href="/schooladmin/transport/vehicles" class="btn btn-secondary flex-1 py-2.5 font-semibold text-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
