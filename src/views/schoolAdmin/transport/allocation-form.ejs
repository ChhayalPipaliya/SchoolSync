<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content" style="padding: 14px 20px;">
      <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
              <i class="fa-solid fa-user-plus"></i>
            </div>
            <div>
              <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%= lan.New_Transport_Allocation || 'New Transport Allocation' %></h1>
              <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%= lan.New_Transport_Allocation_Subtitle || 'Assign a student to a Transport Pro route and pickup/drop stops' %></p>
            </div>
          </div>
          <div>
            <a href="/schooladmin/transport/allocations" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
              <i class="fa-solid fa-arrow-left"></i> <%= lan.Back %>
            </a>
          </div>
        </div>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="table-card">
        <div class="table-header-row bg-slate-50/20">
          <h4 class="table-heading uppercase tracking-wider"><%= lan.Allocation_Details %></h4>
        </div>
        <form method="POST" action="/schooladmin/transport/allocations" class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Student %></label>
            <select class="form-control" name="studentId" required>
              <option value=""><%= lan.Select_Student %></option>
              <% (students || []).forEach(s => { %>
                <option value="<%= s.id %>" <%= (typeof preselectedStudentId !== 'undefined' && Number(preselectedStudentId || 0) === Number(s.id)) ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %> <%= s.class_name ? '(' + s.class_name + (s.section ? ' - ' + s.section : '') + ')' : '' %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Route %></label>
            <select class="form-control" name="routeId" id="routeId" required>
              <option value=""><%= lan.Select_Route %></option>
              <% (routes || []).forEach(r => { %>
                <option value="<%= r.id %>" <%= (typeof selectedRouteId !== 'undefined' && Number(selectedRouteId || 0) === Number(r.id)) ? 'selected' : '' %>>
                  <%= r.routeName %><%= r.vehicleNumber ? ' • ' + r.vehicleNumber : '' %><%= r.capacity ? ' • ' + r.capacity + ' ' + lan.Seats : '' %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="md:col-span-2">
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Transport_Stop %></label>
            <select class="form-control" name="stopId" id="stopId">
              <option value=""><%= lan.Select_Stop %></option>
              <% (stops || []).forEach(stop => { %>
                <option value="<%= stop.id %>" data-route-id="<%= stop.routeId %>"><%= stop.stopName %></option>
              <% }) %>
            </select>
          </div>
          <div class="md:col-span-2">
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Pickup_Address %> <span class="text-slate-400 normal-case">(<%= lan.Recommended %>)</span></label>
            <input class="form-control" type="text" name="pickupAddress" placeholder="Pickup landmark or address">
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Pickup_Latitude %> <span class="text-slate-400 normal-case">(<%= lan.Optional %>)</span></label>
            <input class="form-control" type="number" step="0.0000001" name="pickupLatitude" placeholder="e.g. 21.170240">
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Pickup_Longitude %> <span class="text-slate-400 normal-case">(<%= lan.Optional %>)</span></label>
            <input class="form-control" type="number" step="0.0000001" name="pickupLongitude" placeholder="e.g. 72.831062">
          </div>
          <div class="md:col-span-2">
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Drop_Address %> <span class="text-slate-400 normal-case">(<%= lan.Recommended %>)</span></label>
            <input class="form-control" type="text" name="dropAddress" placeholder="Drop landmark or address">
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Drop_Latitude %> <span class="text-slate-400 normal-case">(<%= lan.Optional %>)</span></label>
            <input class="form-control" type="number" step="0.0000001" name="dropLatitude" placeholder="e.g. 21.170240">
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Drop_Longitude %> <span class="text-slate-400 normal-case">(<%= lan.Optional %>)</span></label>
            <input class="form-control" type="number" step="0.0000001" name="dropLongitude" placeholder="e.g. 72.831062">
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Fee_Plan %></label>
            <select class="form-control" name="feePlanId" id="feePlanId">
              <option value=""><%= lan.No_Fee_Plan %></option>
              <% (feePlans || []).forEach(plan => { %>
                <option value="<%= plan.id %>" data-route-id="<%= plan.routeId || '' %>" data-stop-id="<%= plan.stopId || '' %>"><%= plan.planName %> • ₹<%= plan.feeAmount %><%= plan.billingCycle ? ' • ' + plan.billingCycle.replace('_', ' ') : '' %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Status %></label>
            <select class="form-control" name="status">
              <option value="active"><%= lan.Active %></option>
              <option value="paused"><%= lan.Paused %></option>
              <option value="inactive"><%= lan.Inactive %></option>
            </select>
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Start_Date %></label>
            <input class="form-control" type="date" name="allocationStartDate" value="<%= new Date().toISOString().slice(0, 10) %>" required>
          </div>
          <div>
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.End_Date %></label>
            <input class="form-control" type="date" name="allocationEndDate">
          </div>
          <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
              <input type="checkbox" name="pickupRequired" value="1" checked> <%= lan.Pickup_Required %>
            </label>
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
              <input type="checkbox" name="dropRequired" value="1" checked> <%= lan.Drop_Required %>
            </label>
          </div>
          <div class="md:col-span-2">
            <label class="form-label text-xs font-bold uppercase text-slate-500"><%= lan.Notes %></label>
            <textarea class="form-control" name="notes" rows="3" placeholder="Optional notes"></textarea>
          </div>
          <div class="md:col-span-2 flex justify-end gap-3">
            <a href="/schooladmin/transport/allocations" class="btn btn-secondary"><%= lan.Cancel %></a>
            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-check mr-1"></i><%= lan.Create_Allocation %></button>
          </div>
        </form>
      </div>
    </div>
    <%- include('../../partials/footer') %>
  </div>
</div>

<script>
  const routeSelect = document.getElementById('routeId');
  const stopSelects = [document.getElementById('pickupStopId'), document.getElementById('dropStopId')];
  const feePlanSelect = document.getElementById('feePlanId');

  function filterStops() {
    const routeId = routeSelect.value;
    stopSelects.forEach((select) => {
      if (!select) return;
      Array.from(select.options).forEach((option) => {
        if (!option.value) {
          option.hidden = false;
          return;
        }
        option.hidden = routeId && option.dataset.routeId !== routeId;
        if (option.hidden && option.selected) select.value = '';
      });
    });
    suggestFeePlan();
  }

  function suggestFeePlan() {
    if (!feePlanSelect) return;
    const routeId = routeSelect.value;
    const stopIds = stopSelects.map((select) => select ? select.value : '').filter(Boolean);
    const plans = Array.from(feePlanSelect.options).filter((option) => option.value);
    const stopMatch = plans.find((option) => option.dataset.routeId === routeId && stopIds.includes(option.dataset.stopId));
    const routeMatch = plans.find((option) => option.dataset.routeId === routeId && !option.dataset.stopId);
    const globalMatch = plans.find((option) => !option.dataset.routeId && !option.dataset.stopId);
    const match = stopMatch || routeMatch || globalMatch;
    if (match && !feePlanSelect.value) feePlanSelect.value = match.value;
  }

  if (routeSelect) routeSelect.addEventListener('change', filterStops);
  stopSelects.forEach((select) => select && select.addEventListener('change', suggestFeePlan));
  filterStops();
</script>