<%- include('../../partials/head') %>
  <div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
      <div class="main-panel">
        <%- include('../../partials/header') %>
          <div class="content">
            <div class="mb-6">
              <h2 class="text-2xl font-bold text-gray-800">Driver Assignments</h2>
            </div>
            <div class="bg-white rounded-lg shadow overflow-hidden">
              <table class="w-full text-sm">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-3 text-left">Driver</th>
                    <th class="px-4 py-3">Phone</th>
                    <th class="px-4 py-3">License</th>
                    <th class="px-4 py-3">Vehicle</th>
                    <th class="px-4 py-3">Route</th>
                    <th class="px-4 py-3">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% assignments.forEach(a=> { %>
                    <tr class="border-b hover:bg-gray-50">
                      <td class="px-4 py-3 font-medium">
                        <%= a.first_name %>
                          <%= a.last_name %>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <%= a.phone || 'N/A' %>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <%= a.license_number || 'N/A' %>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <%= a.vehicle_number %> (<%= a.vehicle_type %>)
                      </td>
                      <td class="px-4 py-3 text-center">
                        <%= a.route_name || 'N/A' %>
                      </td>
                      <td class="px-4 py-3 text-center">
                        <span
                          class="px-2 py-1 rounded-full text-xs <%= a.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                          <%= a.status %>
                        </span>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
              <% if (assignments.length===0) { %>
                <div class="p-8 text-center text-gray-500">No driver assignments found</div>
                <% } %>
            </div>
          </div>
        </div>
    </div>
    <%- include('../../partials/footer') %>