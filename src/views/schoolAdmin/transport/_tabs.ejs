<% const activeTransportPath = typeof currentPath !== 'undefined' ? currentPath : ''; %>
<div class="flex flex-wrap items-center gap-1 border-b border-slate-200 pb-4 mb-6">
  <a href="/schooladmin/transport/dashboard" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/dashboard' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Dashboard</a>
  <a href="/schooladmin/transport/drivers" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/drivers' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Drivers</a>
  <a href="/schooladmin/transport/vehicles" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/vehicles' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Vehicles</a>
  <a href="/schooladmin/transport/routes" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/routes' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Routes</a>
  <a href="/schooladmin/transport/routes" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath.includes('/stops') ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Stops</a>
  <a href="/schooladmin/transport/allocations" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/allocations' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Allocations</a>
  <a href="/schooladmin/transport/tracking" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/tracking' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Live Tracking</a>
  <a href="/schooladmin/transport/maintenance" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/maintenance' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Maintenance</a>
  <a href="/schooladmin/transport/alerts" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/alerts' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Alerts</a>
  <a href="/schooladmin/transport/reports" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/reports' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Reports</a>

  <a href="/schooladmin/transport/vehicle-expiry"
     class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg transition
            <%= (typeof active !== 'undefined' && active === 'expiry')
              ? 'bg-red-50 text-red-600 border border-red-100'
              : 'text-slate-500 hover:bg-slate-50' %>">
    <i class="fas fa-exclamation-triangle mr-1
              <%= (typeof active !== 'undefined' && active === 'expiry') ? 'text-red-500' : '' %>"></i>
    Doc Expiry
  </a>

  <a href="/schooladmin/transport/export"
     class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg transition
            <%= (typeof active !== 'undefined' && active === 'export')
              ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50'
              : 'text-slate-500 hover:bg-slate-50' %>">
    <i class="fas fa-file-excel mr-1 text-green-500"></i>
    Export Excel
  </a>
</div>
