<% const activeTransportPath = typeof currentPath !== 'undefined' ? currentPath : ''; %>
<style>
  [data-theme="dark"] .transport-tabs-container,
  .light-mode-disabled .transport-tabs-container {
    border-bottom-color: #242F4D !important;
  }
  [data-theme="dark"] .transport-tab-item,
  .light-mode-disabled .transport-tab-item {
    color: #94A3B8 !important;
  }
  [data-theme="dark"] .transport-tab-item:hover,
  .light-mode-disabled .transport-tab-item:hover {
    background: #1E293B !important;
    color: #F1F5F9 !important;
  }
  [data-theme="dark"] .transport-tab-active,
  .light-mode-disabled .transport-tab-active {
    background: rgba(16, 185, 129, 0.15) !important;
    color: #34D399 !important;
    border-color: rgba(16, 185, 129, 0.35) !important;
  }
  [data-theme="dark"] .transport-tab-active-danger,
  .light-mode-disabled .transport-tab-active-danger {
    background: rgba(239, 68, 68, 0.15) !important;
    color: #F87171 !important;
    border-color: rgba(239, 68, 68, 0.35) !important;
  }
</style>
<div class="flex flex-wrap items-center gap-1 border-b border-slate-200 pb-3 mb-4 transport-tabs-container">
  <a href="/schooladmin/transport/dashboard" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/dashboard' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Dashboard</a>
  <a href="/schooladmin/transport/drivers" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/drivers' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Drivers</a>
  <a href="/schooladmin/transport/vehicles" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/vehicles' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Vehicles</a>
  <a href="/schooladmin/transport/routes" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/routes' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Routes</a>
  <a href="/schooladmin/transport/stops" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath.includes('/stops') ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Stops</a>
  <a href="/schooladmin/transport/allocations" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/allocations' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Allocations</a>
  <a href="/schooladmin/transport/pending-allocations" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/pending-allocations' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Pending Queue</a>
  <a href="/schooladmin/transport/tracking" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/tracking' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Live Tracking</a>
  <a href="/schooladmin/transport/maintenance" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/maintenance' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Maintenance</a>
  <a href="/schooladmin/transport/alerts" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/alerts' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Alerts</a>
  <a href="/schooladmin/transport/reports" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg <%= activeTransportPath === '/schooladmin/transport/reports' ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-600 hover:bg-slate-50' %>">Reports</a>
  <a href="/schooladmin/transport/vehicle-expiry" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg transition <%= (typeof active !== 'undefined' && active === 'expiry') ? 'transport-tab-active-danger bg-red-50 text-red-600 border border-red-100' : 'text-slate-500 hover:bg-slate-50' %>"><i class="fas fa-exclamation-triangle mr-1 <%= (typeof active !== 'undefined' && active === 'expiry') ? 'text-red-500' : '' %>"></i>Doc Expiry</a>
  <a href="/schooladmin/transport/export" class="transport-tab-item px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg transition <%= (typeof active !== 'undefined' && active === 'export') ? 'transport-tab-active bg-emerald-50 text-emerald-700 border border-emerald-100/50' : 'text-slate-500 hover:bg-slate-50' %>"> <i class="fas fa-file-excel mr-1 text-green-500"></i>Export Excel</a>
</div>