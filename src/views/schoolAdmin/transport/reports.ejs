<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight"><%= lan.Transport_Reports %></h2>
          <p class="text-xs text-slate-500 mt-1"><%= lan.Transport_Reports_Subtitle %></p>
        </div>
        <div class="grid grid-cols-2 sm:flex sm:items-center gap-2">
          <a href="/schooladmin/transport/reports/export"
             class="btn btn-outline text-xs flex items-center justify-center border border-slate-200 gap-2 whitespace-nowrap">
            <i class="fas fa-file-excel text-green-500"></i> <%= lan.Export_Report %>
          </a>
          <a href="/schooladmin/transport/reports?<%= new URLSearchParams({ ...filters, date_from: filters.dateFrom, date_to: filters.dateTo, route_id: filters.routeId || '', vehicle_id: filters.vehicleId || '', driver_id: filters.driverId || '', student_id: filters.studentId || '', trip_type: filters.tripType || '', export: 'csv' }).toString() %>" class="btn btn-secondary text-xs font-bold flex items-center justify-center whitespace-nowrap"><i class="fa-solid fa-download mr-1"></i><%= lan.CSV_Export %></a>
        </div>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="table-card mb-6">
        <div class="table-header-row bg-slate-50/40">
          <h4 class="table-heading uppercase tracking-wider"><%= lan.Filters %></h4>
        </div>
        <form method="GET" action="/schooladmin/transport/reports" class="p-5 grid grid-cols-1 md:grid-cols-3 xl:grid-cols-7 gap-4">
          <input class="form-control" type="date" name="date_from" value="<%= filters.dateFrom %>">
          <input class="form-control" type="date" name="date_to" value="<%= filters.dateTo %>">
          <select class="form-control" name="route_id"><option value=""><%= lan.All_Routes %></option><% (routes || []).forEach(r => { %><option value="<%= r.id %>" <%= Number(filters.routeId) === Number(r.id) ? 'selected' : '' %>><%= r.routeName %></option><% }) %></select>
          <select class="form-control" name="vehicle_id"><option value=""><%= lan.All_Vehicles || 'All vehicles' %></option><% (vehicles || []).forEach(v => { %><option value="<%= v.id %>" <%= Number(filters.vehicleId) === Number(v.id) ? 'selected' : '' %>><%= v.vehicleNumber %></option><% }) %></select>
          <select class="form-control" name="driver_id"><option value=""><%= lan.All_Drivers || 'All drivers' %></option><% (drivers || []).forEach(d => { %><option value="<%= d.id %>" <%= Number(filters.driverId) === Number(d.id) ? 'selected' : '' %>><%= d.first_name %> <%= d.last_name %></option><% }) %></select>
          <select class="form-control" name="student_id"><option value=""><%= lan.All_Students || 'All students' %></option><% (students || []).forEach(s => { %><option value="<%= s.id %>" <%= Number(filters.studentId) === Number(s.id) ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %></option><% }) %></select>
          <select class="form-control" name="trip_type"><option value=""><%= lan.Pickup %> + <%= lan.Drop %></option><option value="pickup" <%= filters.tripType === 'pickup' ? 'selected' : '' %>><%= lan.Pickup %></option><option value="drop" <%= filters.tripType === 'drop' ? 'selected' : '' %>><%= lan.Drop %></option></select>
          <button class="btn btn-primary md:col-span-3 xl:col-span-7" type="submit"><i class="fa-solid fa-filter mr-1"></i><%= lan.Apply_Filters || 'Apply Filters' %></button>
        </form>
      </div>
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <div class="table-card">
          <div class="table-header-row bg-slate-50/40"><h4 class="table-heading uppercase tracking-wider"><%= lan.Daily_Trip_Report %></h4></div>
          <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;"><table class="table" style="min-width: 480px; width: 100%;"><thead><tr><th style="white-space: nowrap;"><%= lan.Date %></th><th style="white-space: nowrap;"><%= lan.Type %></th><th style="white-space: nowrap;"><%= lan.Status %></th><th style="white-space: nowrap;"><%= lan.Trips || 'Trips' %></th></tr></thead><tbody>
            <% if ((dailyTrips || []).length) { dailyTrips.forEach(row => { %><tr><td style="white-space: nowrap;"><%= row.tripDate ? new Date(row.tripDate).toISOString().slice(0, 10) : '-' %></td><td style="white-space: nowrap;"><%= row.tripType %></td><td style="white-space: nowrap;"><%= row.status %></td><td style="white-space: nowrap;"><%= row.totalTrips %></td></tr><% }) } else { %><tr><td colspan="4" class="text-center text-slate-500 py-6"><%= lan.No_Trips_Found %></td></tr><% } %>
          </tbody></table></div>
        </div>
        <div class="table-card">
          <div class="table-header-row bg-slate-50/40"><h4 class="table-heading uppercase tracking-wider"><%= lan.Route_Occupancy %></h4></div>
          <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;"><table class="table" style="min-width: 480px; width: 100%;"><thead><tr><th style="white-space: nowrap;"><%= lan.Route %></th><th style="white-space: nowrap;"><%= lan.Vehicle %></th><th style="white-space: nowrap;"><%= lan.Assigned %></th><th style="white-space: nowrap;"><%= lan.Capacity %></th></tr></thead><tbody>
            <% if ((routeOccupancy || []).length) { routeOccupancy.forEach(row => { const overloaded = Number(row.capacity || 0) > 0 && Number(row.assignedStudents || 0) > Number(row.capacity || 0); %><tr><td style="white-space: nowrap;"><%= row.routeName %></td><td style="white-space: nowrap;"><%= row.vehicleNumber || '-' %></td><td style="white-space: nowrap;"><span class="<%= overloaded ? 'text-rose-700 font-black' : 'font-bold text-slate-800' %>"><%= row.assignedStudents %></span></td><td style="white-space: nowrap;"><%= row.capacity || 0 %></td></tr><% }) } else { %><tr><td colspan="4" class="text-center text-slate-500 py-6"><%= lan.No_Routes_Found %></td></tr><% } %>
          </tbody></table></div>
        </div>
        <div class="table-card xl:col-span-2">
          <div class="table-header-row bg-slate-50/40"><h4 class="table-heading uppercase tracking-wider"><%= lan.Student_Pickup_Drop_Report %></h4></div>
          <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;"><table class="table" style="min-width: 680px; width: 100%;"><thead><tr><th style="white-space: nowrap;"><%= lan.Date %></th><th style="white-space: nowrap;"><%= lan.Student %></th><th style="white-space: nowrap;"><%= lan.Route %></th><th style="white-space: nowrap;"><%= lan.Vehicle %></th><th style="white-space: nowrap;"><%= lan.Trip || 'Trip' %></th><th style="white-space: nowrap;"><%= lan.Status %></th><th style="white-space: nowrap;"><%= lan.Marked %></th></tr></thead><tbody>
            <% if ((studentRows || []).length) { studentRows.forEach(row => { %><tr><td style="white-space: nowrap;"><%= row.tripDate ? new Date(row.tripDate).toISOString().slice(0, 10) : '-' %></td><td style="white-space: nowrap;"><%= row.first_name %> <%= row.last_name %></td><td style="white-space: nowrap;"><%= row.routeName || '-' %></td><td style="white-space: nowrap;"><%= row.vehicleNumber || '-' %></td><td style="white-space: nowrap;"><%= row.tripType %></td><td style="white-space: nowrap;"><span class="inline-flex px-2 py-1 rounded-md bg-slate-100 text-slate-700 text-xs font-black"><%= row.studentStatus %></span></td><td style="white-space: nowrap;"><%= row.markedAt ? new Date(row.markedAt).toISOString().slice(0, 16).replace('T', ' ') : '-' %></td></tr><% }) } else { %><tr><td colspan="7" class="text-center text-slate-500 py-6"><%= lan.No_Student_Trip_Events_Found %></td></tr><% } %>
          </tbody></table></div>
        </div>
        <div class="table-card">
          <div class="table-header-row bg-slate-50/40"><h4 class="table-heading uppercase tracking-wider"><%= lan.Maintenance_Cost %></h4></div>
          <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;"><table class="table" style="min-width: 420px; width: 100%;"><thead><tr><th style="white-space: nowrap;"><%= lan.Vehicle %></th><th style="white-space: nowrap;"><%= lan.Records %></th><th style="white-space: nowrap;"><%= lan.Total_Cost %></th></tr></thead><tbody>
            <% if ((maintenanceCost || []).length) { maintenanceCost.forEach(row => { %><tr><td style="white-space: nowrap;"><%= row.vehicleNumber %></td><td style="white-space: nowrap;"><%= row.records %></td><td style="white-space: nowrap;">₹ <%= Number(row.totalAmount || 0).toFixed(2) %></td></tr><% }) } else { %><tr><td colspan="3" class="text-center text-slate-500 py-6"><%= lan.No_Maintenance_Cost_Range %></td></tr><% } %>
          </tbody></table></div>
        </div>
        <div class="table-card">
          <div class="table-header-row bg-slate-50/40"><h4 class="table-heading uppercase tracking-wider"><%= lan.Driver_Performance %></h4></div>
          <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;"><table class="table" style="min-width: 480px; width: 100%;"><thead><tr><th style="white-space: nowrap;"><%= lan.Driver %></th><th style="white-space: nowrap;"><%= lan.Trips || 'Trips' %></th><th style="white-space: nowrap;"><%= lan.Completed %></th><th style="white-space: nowrap;"><%= lan.Running %></th></tr></thead><tbody>
            <% if ((driverPerformance || []).length) { driverPerformance.forEach(row => { %><tr><td style="white-space: nowrap;"><%= row.first_name %> <%= row.last_name %></td><td style="white-space: nowrap;"><%= row.trips %></td><td style="white-space: nowrap;"><%= row.completedTrips || 0 %></td><td style="white-space: nowrap;"><%= row.runningTrips || 0 %></td></tr><% }) } else { %><tr><td colspan="4" class="text-center text-slate-500 py-6"><%= lan.No_Driver_Trips_Found %></td></tr><% } %>
          </tbody></table></div>
        </div>
        <div class="table-card">
          <div class="table-header-row bg-slate-50/40"><h4 class="table-heading uppercase tracking-wider"><%= lan.Missed_Absent_Students %></h4></div>
          <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;"><table class="table" style="min-width: 360px; width: 100%;"><thead><tr><th style="white-space: nowrap;"><%= lan.Status %></th><th style="white-space: nowrap;"><%= lan.Total || 'Total' %></th></tr></thead><tbody>
            <% if ((missedAbsent || []).length) { missedAbsent.forEach(row => { %><tr><td style="white-space: nowrap;"><%= row.studentStatus %></td><td style="white-space: nowrap;"><%= row.total %></td></tr><% }) } else { %><tr><td colspan="2" class="text-center text-slate-500 py-6"><%= lan.No_Missed_Absent_Records %></td></tr><% } %>
          </tbody></table></div>
        </div>
      </div>
      <div class="card p-6 mt-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center">
            <i class="fas fa-file-invoice text-emerald-600 text-sm"></i>
          </div>
          <div>
            <h3 class="font-bold text-gray-800 text-sm"><%= lan.Generate_Transport_Fee_Invoices %></h3>
            <p class="text-xs text-gray-400 mt-0.5">
              <%= lan.Bulk_Create_Fee_Records_Desc %>
            </p>
          </div>
        </div>
        <form method="POST" action="/schooladmin/transport/fee-invoice/generate" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div>
            <label class="form-label text-xs font-bold text-gray-400 uppercase tracking-wider mb-1"><%= lan.Route %></label>
            <select name="route_id" class="form-select text-sm" required>
              <option value=""><%= lan.Select_Route %></option>
              <% if (typeof routes !== 'undefined') { %>
                <% routes.forEach(r => { %>
                  <option value="<%= r.id %>"><%= r.routeName || r.route_name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div>
            <label class="form-label text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">
              <%= lan.Fee_Plan %>
            </label>
            <select name="fee_plan_id" class="form-select text-sm" required>
              <option value=""><%= lan.Select_Fee_Plan %></option>
              <% if (typeof feePlans !== 'undefined') { %>
                <% feePlans.forEach(fp => { %>
                  <option value="<%= fp.id %>">
                    <%= fp.plan_name %> — ₹<%= parseFloat(fp.amount).toLocaleString('en-IN') %>
                  </option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div>
            <label class="form-label text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">
              <%= lan.Month %>
            </label>
            <input type="month"  name="month" class="form-input text-sm" value="<%= new Date().toISOString().slice(0,7) %>" required>
          </div>
          <div>
            <button type="submit" class="btn btn-primary w-full text-xs flex items-center justify-center gap-2">
              <i class="fas fa-bolt"></i> <%= lan.Generate_Invoices %>
            </button>
          </div>
        </form>
      </div>
</div>
        <%- include('../../partials/footer') %>
    </div>
</div>
