<%- include('../../partials/head') %>
<style>
    @media print {
        .sidebar, 
        .sidebar-overlay, 
        .header, 
        .btn, 
        footer, 
        .flex.flex-col.sm\:flex-row, 
        .border-b.border-slate-200 {
            display: none !important;
        }
        
        .app-wrapper {
            padding: 0 !important;
            margin: 0 !important;
            background: #fff !important;
        }
        
        .main-panel {
            margin-left: 0 !important;
            width: 100% !important;
            padding: 0 !important;
        }
        
        .content {
            padding: 0 !important;
            margin: 0 !important;
        }
        
        .card, .table-card {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
            background: transparent !important;
        }
        
        .data-table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-top: 15px !important;
        }
        
        .data-table th {
            background-color: #f1f5f9 !important;
            color: #1e293b !important;
            border: 1px solid #cbd5e1 !important;
            font-size: 11px !important;
            padding: 8px !important;
        }
        
        .data-table td {
            border: 1px solid #cbd5e1 !important;
            padding: 8px !important;
            font-size: 11px !important;
            color: #0f172a !important;
        }
        
        .print-header {
            display: block !important;
            margin-bottom: 20px !important;
            border-bottom: 2px solid #0f172a !important;
            padding-bottom: 10px !important;
        }
    }
    
    .print-header {
        display: none;
    }
</style>

<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content print-section">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= lan.Passenger_Directory %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%= lan.Passenger_Directory_Subtitle %></p>
                </div>
                <div class="flex gap-2">
                    <button onclick="window.print()" class="btn btn-primary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                        <i class="fa-solid fa-print"></i> <%= lan.Print_Directory %>
                    </button>
                    <a href="/schooladmin/transport/routes" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                        <i class="fa-solid fa-arrow-left"></i> <%= lan.Back_To_Routes %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="print-header">
                <h1 style="font-size: 20px; font-weight: bold; margin: 0;"><%= user && user.schoolName ? user.schoolName : 'SchoolSync Academy' %></h1>
                <h2 style="font-size: 14px; font-weight: 600; color: #475569; margin: 5px 0 0 0;"><%= lan.Passenger_Directory %> & <%= lan.Route_Information %></h2>
                <div style="font-size: 10px; color: #94a3b8; margin-top: 5px;">Generated on: <%= new Date().toLocaleString('en-IN') %></div>
            </div>
            <div class="card p-5 mb-6">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3"><%= lan.Route_Information %></h3>
                <div class="grid grid-cols-1 md:grid-cols-5 gap-4 text-xs font-medium text-slate-600">
                    <div>
                        <span class="text-slate-400 block mb-0.5"><%= lan.Route_Name %></span>
                        <strong class="text-slate-800 text-[13px]"><%= route.routeName %></strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5"><%= lan.Route_Path %></span>
                        <strong class="text-slate-800"><%= route.startPoint %> <i class="fa-solid fa-arrow-right text-[10px] mx-1 text-slate-400"></i> <%= route.endPoint %></strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5"><%= lan.Assigned_Vehicle || 'Assigned Vehicle' %></span>
                        <strong class="text-slate-800 font-mono"><%= route.vehicleNumber || (lan.Unassigned || 'Unassigned') %></strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5"><%= lan.Shift %></span>
                        <% const routeShiftLabel = route.schoolShift === 'morning' ? lan.Morning_School : (route.schoolShift === 'evening' ? lan.Evening_School : lan.Full_Day_School); %>
                        <strong class="text-blue-700"><%= routeShiftLabel %></strong>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5"><%= lan.Total_Passengers %></span>
                        <strong class="text-emerald-700 text-sm font-bold"><%= students.length %> <%= lan.Students %></strong>
                    </div>
                </div>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider"><%= lan.Passenger_Directory_Roll %></h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th style="width: 60px;" class="text-center">#</th>
                                <th><%= lan.Student_Name %></th>
                                <th><%= lan.Class_Section %></th>
                                <th><%= lan.Residential_Address %></th>
                                <th><%= lan.Emergency_Contact %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!students || students.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center py-12 text-gray-400 font-medium"><%= lan.No_Students_Allocated_Route %></td>
                                </tr>
                            <% } %>
                            <% (students||[]).forEach((s, idx) => { %>
                                <tr>
                                    <td class="text-center font-bold text-slate-400 text-xs"><%= idx + 1 %></td>
                                    <td>
                                        <div class="font-bold text-gray-800 text-[13px]"><%= s.first_name %> <%= s.last_name %></div>
                                    </td>
                                    <td>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase border bg-blue-50 text-blue-700 border-blue-100">
                                            <%= lan.Class %> <%= s.class_name %> - <%= s.section %>
                                        </span>
                                    </td>
                                    <td class="font-medium text-gray-600 text-xs"><%= s.current_address || '—' %></td>
                                    <td class="font-mono text-xs font-semibold text-slate-700"><%= s.emergency_contact || '—' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
