<%- include('../../partials/head') %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-wrench"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%= lan.Maintenance || 'Maintenance & Fuel' %>
                                        </h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;">
                                            <%= lan.Maintenance_Subtitle
                                                || 'Track vehicle service logs, fuel consumption, vendor invoices, and compliance'
                                                %>
                                        </p>
                                    </div>
                                </div>
                                <div>
                                    <a href="/schooladmin/transport/dashboard" class="btn"
                                        style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                                        <i class="fa-solid fa-arrow-left"></i>
                                        <%= lan.Dashboard || 'Dashboard' %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <%- include('_tabs', { currentPath: currentPath }) %>
                                <% const today=new Date(); const inThirty=new Date(Date.now() + 30 * 24 * 60 * 60 *
                                    1000); %>
                                    <div class="grid grid-cols-1 xl:grid-cols-4 gap-4 mb-3">
                                        <div class="table-card p-5 xl:col-span-2">
                                            <div class="flex items-center justify-between mb-3">
                                                <h3 class="text-sm font-black text-slate-800 uppercase tracking-wider">
                                                    <%= lan.Upcoming_Service %>
                                                </h3>
                                                <span class="text-xs font-bold text-slate-500">
                                                    <%= lan.Next_30_Days %>
                                                </span>
                                            </div>
                                            <% if ((upcoming || []).length) { %>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                    <% upcoming.forEach(item=> { %>
                                                        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                                                            <p class="text-sm font-black text-amber-900">
                                                                <%= item.vehicleNumber %>
                                                            </p>
                                                            <p class="text-xs text-amber-700 mt-1">
                                                                <%= item.serviceType || 'Service' %>
                                                                    <%= lan.Due_On %>
                                                                        <%= item.nextServiceDate ? new
                                                                            Date(item.nextServiceDate).toISOString().slice(0,
                                                                            10) : '-' %>
                                                            </p>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <% } else { %>
                                                    <div
                                                        class="rounded-lg border border-slate-200 bg-slate-50 p-5 text-sm text-slate-600">
                                                        <%= lan.No_Service_Due_30_Days %>
                                                    </div>
                                                    <% } %>
                                        </div>
                                        <div class="table-card p-5 xl:col-span-2">
                                            <h3 class="text-sm font-black text-slate-800 uppercase tracking-wider mb-3">
                                                <%= lan.Doc_Expiry_Warnings %>
                                            </h3>
                                            <% const expiryRows=[]; (vehicles || []).forEach(function(v) {
                                                ['insuranceExpiry','pucExpiry','permitExpiry','fitnessExpiry'].forEach(function(key)
                                                { if (v[key]) { const d=new Date(v[key]); if (d <=inThirty) {
                                                expiryRows.push({ vehicle: v.vehicleNumber, label:
                                                key.replace('Expiry',' expiry').replace('puc','PUC'), date: d }); } }
                                                }); }); %>
                                                <% if (expiryRows.length) { %>
                                                    <div class="space-y-2">
                                                        <% expiryRows.slice(0, 8).forEach(row=> { %>
                                                            <div
                                                                class="flex items-center justify-between rounded-lg border border-rose-200 bg-rose-50 px-4 py-3">
                                                                <span class="text-sm font-bold text-rose-900">
                                                                    <%= row.vehicle %> <span class="font-semibold">
                                                                            <%= row.label %>
                                                                        </span>
                                                                </span>
                                                                <span class="text-xs font-black text-rose-700">
                                                                    <%= row.date.toISOString().slice(0, 10) %>
                                                                </span>
                                                            </div>
                                                            <% }) %>
                                                    </div>
                                                    <% } else { %>
                                                        <div
                                                            class="rounded-lg border border-slate-200 bg-slate-50 p-5 text-sm text-slate-600">
                                                            <%= lan.All_Docs_Clear_30_Days %>
                                                        </div>
                                                        <% } %>
                                        </div>
                                    </div>
                                    <div class="table-card mb-3">
                                        <div class="table-header-row bg-slate-50/40">
                                            <h4 class="table-heading uppercase tracking-wider">
                                                <%= lan.Add_Service_Record %>
                                            </h4>
                                        </div>
                                        <form method="POST" action="/schooladmin/transport/maintenance"
                                            class="p-5 grid grid-cols-1 md:grid-cols-3 xl:grid-cols-4 gap-4">
                                            <input type="hidden" name="_csrf"
                                                value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                            <select class="form-control" name="vehicleId" required>
                                                <option value="">
                                                    <%= lan.Vehicle %>
                                                </option>
                                                <% (vehicles || []).forEach(v=> { %><option value="<%= v.id %>">
                                                        <%= v.vehicleNumber %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <input class="form-control" type="text" name="serviceType"
                                                placeholder="<%= lan.Service_Type %>">
                                            <input class="form-control" type="date" name="serviceDate"
                                                value="<%= new Date().toISOString().slice(0, 10) %>" required>
                                            <input class="form-control" type="date" name="nextServiceDate"
                                                placeholder="<%= lan.Next_Service %>">
                                            <input class="form-control" type="number" min="0" step="0.01" name="amount"
                                                placeholder="<%= lan.Cost %>">
                                            <input class="form-control" type="text" name="vendorName"
                                                placeholder="<%= lan.Vendor_Name %>">
                                            <input class="form-control" type="text" name="invoiceNumber"
                                                placeholder="<%= lan.Invoice_Number %>">
                                            <input class="form-control" type="number" min="0" name="odometerReading"
                                                placeholder="<%= lan.Odometer %>">
                                            <select class="form-control" name="status">
                                                <option value="completed">
                                                    <%= lan.Completed %>
                                                </option>
                                                <option value="scheduled">
                                                    <%= lan.Scheduled %>
                                                </option>
                                                <option value="pending">
                                                    <%= lan.Pending %>
                                                </option>
                                            </select>
                                            <textarea class="form-control md:col-span-2" name="notes" rows="2"
                                                placeholder="<%= lan.Notes %>"></textarea>
                                            <button class="btn btn-primary" type="submit"><i
                                                    class="fa-solid fa-plus mr-1"></i>
                                                <%= lan.Add_Record %>
                                            </button>
                                        </form>
                                    </div>
                                    <div class="table-card">
                                        <div class="table-header-row bg-slate-50/40">
                                            <h4 class="table-heading uppercase tracking-wider">
                                                <%= lan.Service_History %>
                                            </h4>
                                        </div>
                                        <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;">
                                            <table class="table" style="min-width: 1080px; width: 100%;">
                                                <thead>
                                                    <tr>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Vehicle %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Type %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Service_Date %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Next_Date %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Cost %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Vendor %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Odometer %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Notes %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Action %>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if ((records || []).length) { records.forEach(record=> { %>
                                                        <% const maintFormId='maint-update-' + record.id; %>
                                                            <tr>
                                                                <td>
                                                                    <form id="<%= maintFormId %>" method="POST"
                                                                        action="/schooladmin/transport/maintenance/<%= record.id %>/update"
                                                                        class="hidden">
                                                                        <input type="hidden" name="_csrf"
                                                                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                                    </form>
                                                                    <select class="form-control min-w-[150px]"
                                                                        name="vehicleId" form="<%= maintFormId %>">
                                                                        <% (vehicles || []).forEach(v=> { %><option
                                                                                value="<%= v.id %>"
                                                                                <%=Number(v.id)===Number(record.vehicle_id)
                                                                                ? 'selected' : '' %>><%= v.vehicleNumber
                                                                                    %>
                                                                            </option>
                                                                            <% }) %>
                                                                    </select>
                                                                </td>
                                                                <td><input class="form-control min-w-[130px]"
                                                                        name="serviceType"
                                                                        value="<%= record.service_type || '' %>"
                                                                        form="<%= maintFormId %>"></td>
                                                                <td><input class="form-control min-w-[140px]"
                                                                        type="date" name="serviceDate"
                                                                        value="<%= record.service_date ? new Date(record.service_date).toISOString().slice(0, 10) : '' %>"
                                                                        form="<%= maintFormId %>"></td>
                                                                <td><input class="form-control min-w-[140px]"
                                                                        type="date" name="nextServiceDate"
                                                                        value="<%= record.next_service_date ? new Date(record.next_service_date).toISOString().slice(0, 10) : '' %>"
                                                                        form="<%= maintFormId %>"></td>
                                                                <td><input class="form-control min-w-[110px]"
                                                                        type="number" step="0.01" name="amount"
                                                                        value="<%= record.amount || 0 %>"
                                                                        form="<%= maintFormId %>"></td>
                                                                <td><input class="form-control min-w-[140px]"
                                                                        name="vendorName"
                                                                        value="<%= record.vendor_name || '' %>"
                                                                        form="<%= maintFormId %>"></td>
                                                                <td><input class="form-control min-w-[110px]"
                                                                        type="number" name="odometerReading"
                                                                        value="<%= record.odometer_reading || '' %>"
                                                                        form="<%= maintFormId %>"></td>
                                                                <td><textarea class="form-control min-w-[220px]"
                                                                        name="notes" rows="1"
                                                                        form="<%= maintFormId %>"><%= record.notes || '' %></textarea>
                                                                </td>
                                                                <td class="whitespace-nowrap flex items-center gap-2">
                                                                    <button class="btn btn-secondary btn-sm"
                                                                        type="submit" form="<%= maintFormId %>">
                                                                        <%= lan.Save %>
                                                                    </button>
                                                                    <form method="POST"
                                                                        action="/schooladmin/transport/maintenance/<%= record.id %>/delete"
                                                                        class="inline">
                                                                        <input type="hidden" name="_csrf"
                                                                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                                        <button class="btn btn-danger btn-sm"
                                                                            type="submit">
                                                                            <%= lan.Delete %>
                                                                        </button>
                                                                    </form>
                                                                </td>
                                                            </tr>
                                                            <% }) } else { %>
                                                                <tr>
                                                                    <td colspan="9"
                                                                        class="text-center text-slate-500 py-8">
                                                                        <%= lan.No_Maintenance_Records_Yet %>
                                                                    </td>
                                                                </tr>
                                                                <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>