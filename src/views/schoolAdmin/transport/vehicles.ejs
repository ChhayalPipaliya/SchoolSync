<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= lan.Transport_Management %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%= lan.Transport_Management_Subtitle %></p>
                </div>
                <a href="/schooladmin/transport/vehicles/add" class="btn btn-primary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-plus"></i> <%= lan.Add_Vehicle %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <%- include('_tabs', { currentPath: currentPath }) %>
            <div class="grid grid-cols-1 xl:grid-cols-[1fr_auto] gap-4 mb-6">
                <div class="card p-4">
                    <form method="GET" action="/schooladmin/transport/vehicles" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-4 gap-3">
                        <div>
                            <label class="form-label text-xs font-bold uppercase tracking-wider text-slate-500 mb-2"><%= lan.Search %></label>
                            <input type="search" name="search" value="<%= filters.search || '' %>" placeholder="Vehicle number, model, registration, driver" class="form-input w-full">
                        </div>
                        <div>
                            <label class="form-label text-xs font-bold uppercase tracking-wider text-slate-500 mb-2"><%= lan.Status %></label>
                            <select name="status" class="form-select w-full">
                                <option value=""><%= lan.All_Statuses %></option>
                                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= lan.Active %></option>
                                <option value="maintenance" <%= filters.status === 'maintenance' ? 'selected' : '' %>><%= lan.Maintenance %></option>
                                <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>><%= lan.Inactive %></option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label text-xs font-bold uppercase tracking-wider text-slate-500 mb-2"><%= lan.Ownership %></label>
                            <select name="ownership" class="form-select w-full">
                                <option value=""><%= lan.All_Ownership %></option>
                                <% ownershipOptions.forEach(option => { %>
                                    <option value="<%= option %>" <%= filters.ownership === option ? 'selected' : '' %>><%= option.replace('_', ' ').replace(/\b\w/g, c => c.toUpperCase()) %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="form-label text-xs font-bold uppercase tracking-wider text-slate-500 mb-2"><%= lan.Fuel_Type %></label>
                            <select name="fuelType" class="form-select w-full">
                                <option value=""><%= lan.All_Fuel_Types %></option>
                                <% fuelTypes.forEach(option => { %>
                                    <option value="<%= option %>" <%= filters.fuelType === option ? 'selected' : '' %>><%= option.toUpperCase() %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="xl:col-span-4 flex items-end justify-between gap-3">
                            <button type="submit" class="btn btn-primary px-4 py-2 text-xs font-bold uppercase tracking-wider"><%= lan.Apply_Filters || 'Apply Filters' %></button>
                            <a href="/schooladmin/transport/vehicles" class="btn btn-secondary px-4 py-2 text-xs font-bold uppercase tracking-wider"><%= lan.Reset || 'Reset' %></a>
                        </div>
                    </form>
                </div>
                <div class="card p-4 bg-emerald-50 border border-emerald-100">
                    <div class="text-sm font-bold text-emerald-700 uppercase tracking-wide mb-3"><%= lan.Fleet_Summary %></div>
                    <div class="grid grid-cols-2 gap-3 text-sm text-slate-700">
                        <div class="rounded-lg bg-white p-3 border border-slate-200">
                            <div class="text-slate-500"><%= lan.Total_Vehicles_Count %></div>
                            <div class="text-xl font-bold"><%= vehicles.length %></div>
                        </div>
                        <div class="rounded-lg bg-white p-3 border border-slate-200">
                            <div class="text-slate-500"><%= lan.Active %></div>
                            <div class="text-xl font-bold"><%= vehicles.filter(v => v.status === 'active').length %></div>
                        </div>
                        <div class="rounded-lg bg-white p-3 border border-slate-200">
                            <div class="text-slate-500"><%= lan.Under_Maintenance %></div>
                            <div class="text-xl font-bold"><%= vehicles.filter(v => v.status === 'maintenance').length %></div>
                        </div>
                        <div class="rounded-lg bg-white p-3 border border-slate-200">
                            <div class="text-slate-500"><%= lan.School_Owned %></div>
                            <div class="text-xl font-bold"><%= vehicles.filter(v => v.ownershipType === 'school_owned').length %></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider"><%= lan.School_Fleet_Vehicles %></h4>
                </div>
                <div class="table-container overflow-x-auto">
                    <table class="data-table min-w-[1080px]">
                        <thead>
                            <tr>
                                <th><%= lan.Vehicle_ID %></th>
                                <th><%= lan.Registration %></th>
                                <th><%= lan.Model %></th>
                                <th><%= lan.Type %></th>
                                <th><%= lan.Capacity %></th>
                                <th><%= lan.Ownership %></th>
                                <th><%= lan.Fuel %></th>
                                <th><%= lan.Driver %></th>
                                <th><%= lan.Status %></th>
                                <th class="text-center"><%= lan.Actions %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!vehicles || vehicles.length === 0) { %>
                                <tr>
                                    <td colspan="10" class="text-center py-12 text-gray-400 font-medium">
                                        <div class="flex flex-col items-center justify-center gap-2">
                                            <i class="fa-solid fa-bus fa-2x text-gray-200"></i>
                                            <span><%= lan.No_Vehicles_In_Fleet %></span>
                                            <a href="/schooladmin/transport/vehicles/add" class="text-emerald-600 font-bold hover:underline mt-1"><%= lan.Add_First_Vehicle %></a>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            <% (vehicles||[]).forEach(v => { %>
                                <tr>
                                    <td class="font-mono font-bold text-slate-800 text-[13px]"><%= v.busNumber %></td>
                                    <td class="font-medium text-gray-700"><%= v.vehicleNumber || '—' %></td>
                                    <td class="font-medium text-slate-700"><%= v.model || '—' %></td>
                                    <td>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide border bg-slate-100 text-slate-700 border-slate-200/50">
                                            <%= v.type ? v.type.replace('_', ' ') : '—' %>
                                        </span>
                                    </td>
                                    <td class="font-semibold text-slate-700"><%= v.capacity || 0 %></td>
                                    <td class="text-slate-600"><%= v.ownershipType ? v.ownershipType.replace('_', ' ') : '—' %></td>
                                    <td class="text-slate-600"><%= v.fuelType ? v.fuelType.toUpperCase() : '—' %></td>
                                    <td class="font-medium text-slate-700"><%= v.driverName || (lan.Unassigned || 'Unassigned') %></td>
                                    <td class="text-center">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase border
                                            <%= v.status === 'active' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 
                                               v.status === 'maintenance' ? 'bg-amber-50 text-amber-700 border-amber-100' : 
                                               'bg-slate-50 text-slate-500 border-slate-100' %>">
                                            <%= v.status === 'active' ? lan.Active : (v.status === 'maintenance' ? lan.Maintenance : lan.Inactive) %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <a href="/schooladmin/transport/vehicles/edit/<%= v.id %>" class="btn-icon btn-edit-icon" title="<%= lan.Edit %>">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form method="POST" action="/schooladmin/transport/vehicles/delete/<%= v.id %>" class="inline-block m-0" onsubmit="return confirm('<%= lan.Delete_Vehicle_Confirm %>')">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button type="submit" class="btn-icon btn-danger-icon" title="<%= lan.Delete %>">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
