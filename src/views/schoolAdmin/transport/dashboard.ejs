<%- include('../../partials/head') %>
    <style>
        @media (max-width: 640px) {
            .transport-dash-header {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 12px !important;
            }

            .transport-dash-actions {
                width: 100% !important;
                display: grid !important;
                grid-template-columns: 1fr 1fr !important;
                gap: 6px !important;
            }

            .transport-dash-actions .btn {
                width: 100% !important;
                justify-content: center !important;
                font-size: 11px !important;
                padding: 8px 6px !important;
                white-space: nowrap !important;
            }

            .transport-dash-actions .btn:first-child {
                grid-column: span 2 !important;
            }

            .transport-kpi-card {
                padding: 10px 12px !important;
            }

            .transport-kpi-card .kpi-num {
                font-size: 20px !important;
            }

            .transport-kpi-card .kpi-icon {
                width: 32px !important;
                height: 32px !important;
                font-size: 13px !important;
            }
        }
    </style>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-bus"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%= lan.Transport_Dashboard || 'Transport Pro Dashboard' %>
                                        </h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;">
                                            <%= lan.Transport_Dashboard_Subtitle
                                                || 'Fleet, route, allocation, trip, and capacity overview' %>
                                        </p>
                                    </div>
                                </div>
                                <div class="transport-dash-actions flex flex-wrap gap-2">
                                    <a href="/schooladmin/transport/pending-allocations" class="btn"
                                        style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                                        <i class="fa-solid fa-clock"></i>
                                        <%= lan.Pending_Allocations %>
                                            <% if (stats.pendingAllocationsCount> 0) { %>
                                                <span
                                                    class="ml-1 inline-flex items-center justify-center px-1.5 py-0.2 text-[10px] font-extrabold text-amber-900 bg-amber-300 rounded-full">
                                                    <%= stats.pendingAllocationsCount %>
                                                </span>
                                                <% } %>
                                    </a>
                                    <a href="/schooladmin/transport/allocations/new" class="btn"
                                        style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                                        <i class="fa-solid fa-user-plus"></i>
                                        <%= lan.New_Allocation %>
                                    </a>
                                    <a href="/schooladmin/transport/routes" class="btn"
                                        style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                                        <i class="fa-solid fa-route"></i>
                                        <%= lan.Routes %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <%- include('_tabs', { currentPath: currentPath }) %>
                                <div class="grid grid-cols-2 sm:grid-cols-2 xl:grid-cols-5 gap-2.5 sm:gap-4 mb-3">
                                    <% [ [lan.Total_Vehicles, stats.totalVehicles, 'fa-bus' , 'text-slate-700' ],
                                        [lan.Active_Vehicles, stats.activeVehicles, 'fa-circle-check'
                                        , 'text-emerald-700' ], [lan.Total_Routes, stats.totalRoutes, 'fa-route'
                                        , 'text-blue-700' ], [lan.Active_Routes, stats.activeRoutes, 'fa-toggle-on'
                                        , 'text-emerald-700' ], [lan.Total_Drivers,
                                        stats.totalDrivers, 'fa-id-card-clip' , 'text-indigo-700' ],
                                        [lan.Students_In_Bus, stats.studentsUsingTransport, 'fa-users' , 'text-cyan-700'
                                        ], [lan.Pending_Queue, stats.pendingAllocationsCount, 'fa-clock-rotate-left' ,
                                        stats.pendingAllocationsCount> 0 ? 'text-amber-700' : 'text-slate-700'],
                                        [lan.Running_Trips, stats.runningTripsToday, 'fa-location-arrow',
                                        'text-amber-700'],
                                        [lan.Completed_Trips, stats.completedTripsToday, 'fa-flag-checkered',
                                        'text-green-700'],
                                        [lan.Capacity_Warn, stats.capacityWarnings, 'fa-triangle-exclamation',
                                        stats.capacityWarnings > 0 ? 'text-rose-700' : 'text-slate-700']
                                        ].forEach(card => { %>
                                        <div
                                            class="transport-kpi-card bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
                                            <div class="flex items-start justify-between gap-2">
                                                <div class="min-w-0 flex-1">
                                                    <div
                                                        class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-slate-500 truncate">
                                                        <%= card[0] %>
                                                    </div>
                                                    <div
                                                        class="kpi-num text-xl sm:text-2xl font-extrabold text-slate-900 mt-1 sm:mt-2">
                                                        <%= card[1] || 0 %>
                                                    </div>
                                                </div>
                                                <div
                                                    class="kpi-icon w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-center shrink-0 <%= card[3] %>">
                                                    <i class="fa-solid <%= card[2] %>"></i>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <div class="grid grid-cols-1 xl:grid-cols-[1.4fr_1fr] gap-4 mb-3">
                                    <div class="table-card">
                                        <div class="table-header-row bg-slate-50/20 flex items-center justify-between">
                                            <h4 class="table-heading uppercase tracking-wider">
                                                <%= lan.Capacity_Warnings %>
                                            </h4>
                                        </div>
                                        <div class="table-container"
                                            style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
                                            <table class="data-table" style="min-width: 520px; width: 100%;">
                                                <thead>
                                                    <tr>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Route %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Vehicle %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Capacity %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Active_Students %>
                                                        </th>
                                                        <th style="white-space: nowrap;">
                                                            <%= lan.Over_By %>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (!capacityWarnings || capacityWarnings.length===0) { %>
                                                        <tr>
                                                            <td colspan="5"
                                                                class="text-center py-10 text-gray-400 font-medium">
                                                                <%= lan.No_Overloaded_Routes_Found %>
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                                            <% (capacityWarnings || []).forEach(w=> { %>
                                                                <tr>
                                                                    <td class="font-bold text-slate-800"
                                                                        style="white-space: nowrap;">
                                                                        <%= w.routeName %>
                                                                    </td>
                                                                    <td class="font-mono text-xs font-semibold"
                                                                        style="white-space: nowrap;">
                                                                        <%= w.vehicleNumber %>
                                                                    </td>
                                                                    <td style="white-space: nowrap;">
                                                                        <%= w.vehicleCapacity %>
                                                                    </td>
                                                                    <td style="white-space: nowrap;">
                                                                        <%= w.activeStudents %>
                                                                    </td>
                                                                    <td style="white-space: nowrap;"><span
                                                                            class="inline-flex px-2 py-1 rounded bg-rose-50 text-rose-700 text-xs font-bold"
                                                                            style="white-space: nowrap;">
                                                                            <%= Number(w.activeStudents) -
                                                                                Number(w.vehicleCapacity) %>
                                                                                <%= lan.Seats %>
                                                                        </span></td>
                                                                </tr>
                                                                <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="space-y-4">
                                        <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
                                            <div class="flex items-center justify-between mb-3">
                                                <div>
                                                    <h4
                                                        class="text-sm font-bold text-slate-900 uppercase tracking-wide">
                                                        <%= lan.Top_Routes_Today %>
                                                    </h4>
                                                    <p class="text-xs text-slate-500 mt-1">
                                                        <%= lan.Most_Active_Student_Assignments %>
                                                    </p>
                                                </div>
                                                <span class="text-xs font-semibold text-emerald-700">
                                                    <%= routePerformance.length %>
                                                        <%= lan.Shown %>
                                                </span>
                                            </div>
                                            <% if (routePerformance && routePerformance.length> 0) { %>
                                                <div class="space-y-3">
                                                    <% routePerformance.forEach(route=> { %>
                                                        <div class="rounded-lg bg-slate-50 p-3">
                                                            <div class="flex items-center justify-between gap-3">
                                                                <div>
                                                                    <div class="font-semibold text-slate-900">
                                                                        <%= route.routeName %>
                                                                    </div>
                                                                    <div class="text-xs text-slate-500">
                                                                        <%= route.vehicleNumber || (lan.No_Vehicle
                                                                            || 'No vehicle' ) %>
                                                                    </div>
                                                                </div>
                                                                <div class="text-right text-xs text-slate-500">
                                                                    <div><strong>
                                                                            <%= route.assignedStudents %>
                                                                        </strong>
                                                                        <%= lan.Students %>
                                                                    </div>
                                                                    <div>
                                                                        <%= route.stopCount %>
                                                                            <%= lan.Stops %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <% } else { %>
                                                    <div class="text-sm text-slate-500">
                                                        <%= lan.No_Route_Performance_Data %>
                                                    </div>
                                                    <% } %>
                                        </div>
                                        <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
                                            <div class="flex items-center justify-between mb-3">
                                                <div>
                                                    <h4
                                                        class="text-sm font-bold text-slate-900 uppercase tracking-wide">
                                                        <%= lan.Upcoming_Maintenance %>
                                                    </h4>
                                                    <p class="text-xs text-slate-500 mt-1">
                                                        <%= lan.Vehicles_Expiry_Service_Due %>
                                                    </p>
                                                </div>
                                                <span class="text-xs font-semibold text-emerald-700">
                                                    <%= maintenanceReminders.length %>
                                                        <%= lan.Items %>
                                                </span>
                                            </div>
                                            <% if (maintenanceReminders && maintenanceReminders.length> 0) { %>
                                                <div class="space-y-3">
                                                    <% maintenanceReminders.forEach(reminder=> { %>
                                                        <div class="rounded-lg bg-slate-50 p-3">
                                                            <div class="text-sm font-bold text-slate-900">
                                                                <%= reminder.busNumber %> <span
                                                                        class="text-xs text-slate-500">(<%=
                                                                            reminder.fuelType || 'n/a' %>)</span>
                                                            </div>
                                                            <div class="text-xs text-slate-600">
                                                                <%= reminder.reminderType %>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <% } else { %>
                                                    <div class="text-sm text-slate-500">
                                                        <%= lan.No_Maintenance_Reminders_Today %>
                                                    </div>
                                                    <% } %>
                                        </div>
                                        <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
                                            <div class="flex items-center justify-between mb-3">
                                                <div>
                                                    <h4
                                                        class="text-sm font-bold text-slate-900 uppercase tracking-wide">
                                                        <%= lan.Active_Trips %>
                                                    </h4>
                                                    <p class="text-xs text-slate-500 mt-1">
                                                        <%= lan.Trips_Running_Current_Day %>
                                                    </p>
                                                </div>
                                                <span class="text-xs font-semibold text-emerald-700">
                                                    <%= liveMapOverview.activeTrips.length %>
                                                </span>
                                            </div>
                                            <% if (liveMapOverview.activeTrips && liveMapOverview.activeTrips.length> 0)
                                                { %>
                                                <ul class="space-y-2 text-sm text-slate-700">
                                                    <% liveMapOverview.activeTrips.forEach(trip=> { %>
                                                        <li class="rounded-lg bg-slate-50 p-3">
                                                            <div class="font-semibold text-slate-900">
                                                                <%= trip.routeName %>
                                                            </div>
                                                            <div class="text-xs text-slate-600">
                                                                <%= trip.vehicleNumber %> · <%= trip.driverName %>
                                                            </div>
                                                        </li>
                                                        <% }) %>
                                                </ul>
                                                <% } else { %>
                                                    <div class="text-sm text-slate-500">
                                                        <%= lan.No_Active_Trips_Moment %>
                                                    </div>
                                                    <% } %>
                                        </div>
                                    </div>
                                </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>