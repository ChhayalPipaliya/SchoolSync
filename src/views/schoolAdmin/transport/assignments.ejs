<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= lan.Driver_Vehicle_Assignments %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%= lan.Driver_Vehicle_Assignments_Subtitle %></p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <%- include('_tabs', { currentPath: currentPath }) %>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2">
                    <div class="table-card">
                        <div class="table-header-row bg-slate-50/20">
                            <h4 class="table-heading uppercase tracking-wider"><%= lan.Assignment_History_Log %></h4>
                        </div>
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th><%= lan.Driver_Details %></th>
                                        <th><%= lan.Vehicle_Details %></th>
                                        <th><%= lan.Assigned_Date %></th>
                                        <th class="text-center"><%= lan.Status %></th>
                                        <th class="text-center"><%= lan.Actions %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!assignments || assignments.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-12 text-gray-400 font-medium"><%= lan.No_Driver_Assignments_Recorded %></td>
                                        </tr>
                                    <% } %>
                                    <% (assignments||[]).forEach(a => { %>
                                        <tr>
                                            <td>
                                                <div class="font-bold text-gray-800 text-[13px]"><%= a.driverFirst %> <%= a.driverLast %></div>
                                            </td>
                                            <td>
                                                <div class="font-bold text-slate-800 text-xs"><%= a.vehicleNumber %></div>
                                                <div class="text-[10px] text-gray-400 mt-0.5"><%= a.vehicleModel || '—' %></div>
                                            </td>
                                            <td class="font-medium text-slate-600 text-xs"><%= a.assignedDate ? new Date(a.assignedDate).toLocaleDateString('en-IN') : '—' %></td>
                                            <td class="text-center">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase border
                                                    <%= a.isActive ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-slate-50 text-slate-500 border-slate-100' %>">
                                                    <%= a.isActive ? lan.Active : lan.Inactive %>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <% if (a.isActive) { %>
                                                    <form method="POST" action="/schooladmin/transport/assignments/deactivate/<%= a.id %>" class="inline-block m-0" onsubmit="return confirm('<%= lan.Deactivate_Assignment_Confirm %>')">
                                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                        <button type="submit" class="btn btn-sm btn-secondary py-1 px-3 text-[10px] font-bold transition">
                                                            <i class="fa-solid fa-power-off text-rose-500 mr-1"></i> <%= lan.Deactivate %>
                                                        </button>
                                                    </form>
                                                <% } else { %>
                                                    <span class="text-[11px] text-gray-400 font-medium">—</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card p-6 sticky top-6">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4"><%= lan.Record_New_Assignment %></h3>
                        <form method="POST" action="/schooladmin/transport/assignments/add" class="space-y-4">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <div class="p-3 bg-amber-50 border border-amber-200/50 rounded-lg text-amber-800 text-[11px] leading-relaxed flex gap-2">
                                <i class="fa-solid fa-circle-exclamation mt-0.5 text-amber-600 flex-shrink-0"></i>
                                <span><%= lan.New_Assignment_Notice %></span>
                            </div>
                            <div class="form-group">
                                <label for="driver_id" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Driver %> *</label>
                                <select id="driver_id" name="driver_id" required class="form-select w-full">
                                    <option value=""><%= lan.Choose_Driver %></option>
                                    <% drivers.forEach(d => { %>
                                        <option value="<%= d.id %>"><%= d.first_name %> <%= d.last_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="vehicle_id" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Vehicle %> *</label>
                                <select id="vehicle_id" name="vehicle_id" required class="form-select w-full">
                                    <option value=""><%= lan.Choose_Vehicle %></option>
                                    <% vehicles.forEach(v => { %>
                                        <option value="<%= v.id %>"><%= v.vehicleNumber %> (<%= v.model || (lan.Standard || 'Standard') %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="assignedDate" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Assignment_Date %></label>
                                <input type="date" id="assignedDate" name="assignedDate" class="form-input w-full" value="<%= new Date().toISOString().slice(0, 10) %>">
                            </div>
                            <button type="submit" class="btn btn-primary w-full py-2.5 font-semibold text-xs tracking-wider uppercase mt-2">
                                <i class="fa-solid fa-link mr-1"></i> <%= lan.Confirm_Assignment %>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
