<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= route ? lan.Edit : lan.Add %> <%= lan.Transport_Route %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%= lan.Configure_Route_Subtitle %></p>
                </div>
                <a href="/schooladmin/transport/routes" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-arrow-left"></i> <%= lan.Back_To_Routes %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card p-6">
                <form method="POST" action="<%= route ? '/schooladmin/transport/routes/edit/' + route.id : '/schooladmin/transport/routes/add' %>" class="space-y-5">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div class="form-group">
                        <label for="routeName" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Route_Name %> *</label>
                        <input type="text" id="routeName" name="routeName" value="<%= route ? route.routeName : '' %>" required class="form-input w-full" placeholder="e.g., Route A - North Campus">
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="startPoint" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Start_Point_Auto %></label>
                            <input type="text" id="startPoint" name="startPoint" value="<%= route ? route.startPoint : (typeof defaultSchoolPoint !== 'undefined' ? defaultSchoolPoint : 'School (Auto)') %>" class="form-input w-full" placeholder="e.g., School Campus">
                        </div>
                        <div class="form-group">
                            <label for="endPoint" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.End_Point_Auto %></label>
                            <input type="text" id="endPoint" name="endPoint" value="<%= route ? route.endPoint : (typeof defaultSchoolPoint !== 'undefined' ? defaultSchoolPoint : 'School (Auto)') %>" class="form-input w-full" placeholder="e.g., School Campus">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label for="driver_id" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Designate_Driver %></label>
                            <select id="driver_id" name="driver_id" class="form-select w-full">
                                <option value=""><%= lan.Unassigned_None %></option>
                                <% drivers.forEach(d => { %>
                                    <option value="<%= d.id %>" <%= route && route.driver_id === d.id ? 'selected' : '' %>>
                                        <%= d.first_name %> <%= d.last_name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="vehicle_id" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Assign_Vehicle %></label>
                            <select id="vehicle_id" name="vehicle_id" class="form-select w-full">
                                <option value=""><%= lan.Unassigned_None %></option>
                                <% vehicles.forEach(v => { %>
                                    <option value="<%= v.id %>" <%= route && route.vehicle_id === v.id ? 'selected' : '' %>>
                                        <%= v.vehicleNumber %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <% const selectedSchoolShift = route ? route.schoolShift : (typeof schoolDefaultShift !== 'undefined' ? schoolDefaultShift : 'full_day'); %>
                    <div class="form-group">
                        <label for="school_shift" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.School_Shift_Trip_Set %> *</label>
                        <select id="school_shift" name="school_shift" required class="form-select w-full">
                            <option value="morning" <%= selectedSchoolShift === 'morning' ? 'selected' : '' %>><%= lan.Morning_School %></option>
                            <option value="evening" <%= selectedSchoolShift === 'evening' ? 'selected' : '' %>><%= lan.Evening_School %></option>
                            <option value="full_day" <%= selectedSchoolShift === 'full_day' ? 'selected' : '' %>><%= lan.Full_Day_School %></option>
                        </select>
                        <p class="text-[11px] text-slate-500 mt-1"><%= lan.School_Shift_Help_Text %></p>
                    </div>
                    <% if (zoneEnabled) { %>
                        <div class="form-group">
                            <label for="zone" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Route_Zone %></label>
                            <input type="text" id="zone" name="zone" value="<%= route ? route.zone : '' %>" class="form-input w-full" placeholder="e.g., North Sector, East Campus">
                        </div>
                    <% } %>
                    <% if (route) { %>
                        <div class="form-group">
                            <label for="status" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%= lan.Route_Status %> *</label>
                            <select id="status" name="status" required class="form-select w-full">
                                <option value="active" <%= route.status === 'active' ? 'selected' : '' %>><%= lan.Active %></option>
                                <option value="inactive" <%= route.status === 'inactive' ? 'selected' : '' %>><%= lan.Inactive %></option>
                            </select>
                        </div>
                    <% } %>
                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1 py-2.5 font-semibold">
                            <i class="fa-solid fa-save mr-1.5"></i> <%= lan.Save_Route %>
                        </button>
                        <a href="/schooladmin/transport/routes" class="btn btn-secondary flex-1 py-2.5 font-semibold text-center">
                            <%= lan.Cancel %>
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>