<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight"><%= lan.Fee_Plans %></h2>
          <p class="text-xs text-slate-500 mt-1"><%= lan.Fee_Plans_Subtitle %></p>
        </div>
        <a href="/schooladmin/transport/allocations/new" class="btn btn-primary text-xs font-bold"><i class="fa-solid fa-user-plus mr-1"></i><%= lan.New_Allocation %></a>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="table-card mb-6">
        <div class="table-header-row bg-slate-50/40">
          <h4 class="table-heading uppercase tracking-wider"><%= lan.Add_Fee_Plan %></h4>
        </div>
        <form method="POST" action="/schooladmin/transport/fee-plans" class="p-5 grid grid-cols-1 md:grid-cols-3 xl:grid-cols-4 gap-4 fee-plan-form">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input class="form-control" name="planName" placeholder="<%= lan.Plan_Name %>" required>
          <select class="form-control route-select" name="routeId">
            <option value=""><%= lan.All_Routes %></option>
            <% (routes || []).forEach(r => { %><option value="<%= r.id %>"><%= r.routeName %></option><% }) %>
          </select>
          <select class="form-control stop-select" name="stopId">
            <option value=""><%= lan.Stop_Optional %></option>
            <% (stops || []).forEach(stop => { %><option value="<%= stop.id %>" data-route-id="<%= stop.routeId %>"><%= stop.stopName %></option><% }) %>
          </select>
          <select class="form-control" name="billingCycle">
            <option value="monthly"><%= lan.Monthly %></option>
            <option value="quarterly"><%= lan.Quarterly %></option>
            <option value="half_yearly"><%= lan.Half_Yearly %></option>
            <option value="yearly"><%= lan.Yearly %></option>
          </select>
          <input class="form-control" type="number" min="0" step="0.01" name="feeAmount" placeholder="<%= lan.Amount %>" required>
          <input class="form-control" type="number" min="0" step="0.01" name="lateFee" placeholder="<%= lan.Late_Fee %>" <%= supportsAdvancedFeeFields ? '' : 'disabled' %>>
          <input class="form-control" type="number" min="1" max="31" name="dueDay" placeholder="<%= lan.Due_Day %>" <%= supportsAdvancedFeeFields ? '' : 'disabled' %>>
          <input class="form-control" type="date" name="effectiveFrom" value="<%= new Date().toISOString().slice(0, 10) %>" required>
          <input class="form-control" type="date" name="effectiveTo">
          <select class="form-control" name="status"><option value="active"><%= lan.Active %></option><option value="inactive"><%= lan.Inactive %></option></select>
          <% if (!supportsAdvancedFeeFields) { %>
            <div class="md:col-span-2 flex items-center text-xs font-semibold text-amber-700"><%= lan.Run_Migration_Late_Fee_Notice %></div>
          <% } %>
          <button class="btn btn-primary" type="submit"><i class="fa-solid fa-plus mr-1"></i><%= lan.Add_Plan %></button>
        </form>
      </div>
      <div class="table-card">
        <div class="table-header-row bg-slate-50/40">
          <h4 class="table-heading uppercase tracking-wider"><%= lan.Plans %></h4>
        </div>
        <div class="overflow-x-auto">
          <table class="table">
            <thead><tr><th><%= lan.Plan %></th><th><%= lan.Route %></th><th><%= lan.Transport_Stop %></th><th><%= lan.Cycle %></th><th><%= lan.Amount %></th><th><%= lan.Late_Fee %></th><th><%= lan.Due_Day %></th><th><%= lan.Effective %></th><th><%= lan.Status %></th><th><%= lan.Action %></th></tr></thead>
            <tbody>
              <% if ((plans || []).length) { plans.forEach(plan => { %>
                <% const planFormId = 'fee-plan-update-' + plan.id; %>
                <tr>
                  <td>
                    <form id="<%= planFormId %>" method="POST" action="/schooladmin/transport/fee-plans/<%= plan.id %>/update" class="hidden">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    </form>
                    <input class="form-control min-w-[160px]" name="planName" value="<%= plan.planName %>" required form="<%= planFormId %>">
                  </td>
                  <td><select class="form-control min-w-[160px] route-select" name="routeId" form="<%= planFormId %>"><option value=""><%= lan.All_Routes %></option><% (routes || []).forEach(r => { %><option value="<%= r.id %>" <%= Number(r.id) === Number(plan.routeId) ? 'selected' : '' %>><%= r.routeName %></option><% }) %></select></td>
                  <td><select class="form-control min-w-[160px] stop-select" name="stopId" form="<%= planFormId %>"><option value=""><%= lan.Stop_Optional %></option><% (stops || []).forEach(stop => { %><option value="<%= stop.id %>" data-route-id="<%= stop.routeId %>" <%= Number(stop.id) === Number(plan.stopId) ? 'selected' : '' %>><%= stop.stopName %></option><% }) %></select></td>
                  <td>
                    <select class="form-control min-w-[130px]" name="billingCycle" form="<%= planFormId %>">
                      <% 
                        const cycleLabels = {
                          monthly: lan.Monthly || 'Monthly',
                          quarterly: lan.Quarterly || 'Quarterly',
                          half_yearly: lan.Half_Yearly || 'Half yearly',
                          yearly: lan.Yearly || 'Yearly'
                        };
                        ['monthly','quarterly','half_yearly','yearly'].forEach(cycle => { 
                      %>
                        <option value="<%= cycle %>" <%= cycle === plan.billingCycle ? 'selected' : '' %>><%= cycleLabels[cycle] || cycle.replace('_', ' ') %></option>
                      <% }) %>
                    </select>
                  </td>
                  <td><input class="form-control min-w-[110px]" type="number" step="0.01" name="feeAmount" value="<%= plan.feeAmount || 0 %>" form="<%= planFormId %>"></td>
                  <td><input class="form-control min-w-[110px]" type="number" step="0.01" name="lateFee" value="<%= plan.lateFee || 0 %>" <%= supportsAdvancedFeeFields ? '' : 'disabled' %> form="<%= planFormId %>"></td>
                  <td><input class="form-control min-w-[90px]" type="number" min="1" max="31" name="dueDay" value="<%= plan.dueDay || '' %>" <%= supportsAdvancedFeeFields ? '' : 'disabled' %> form="<%= planFormId %>"></td>
                  <td class="min-w-[290px]"><div class="flex gap-2"><input class="form-control" type="date" name="effectiveFrom" value="<%= plan.effectiveFrom ? new Date(plan.effectiveFrom).toISOString().slice(0, 10) : '' %>" form="<%= planFormId %>"><input class="form-control" type="date" name="effectiveTo" value="<%= plan.effectiveTo ? new Date(plan.effectiveTo).toISOString().slice(0, 10) : '' %>" form="<%= planFormId %>"></div></td>
                  <td><select class="form-control min-w-[110px]" name="status" form="<%= planFormId %>"><option value="active" <%= plan.status === 'active' ? 'selected' : '' %>><%= lan.Active %></option><option value="inactive" <%= plan.status === 'inactive' ? 'selected' : '' %>><%= lan.Inactive %></option></select></td>
                  <td class="whitespace-nowrap flex items-center gap-2">
                    <button class="btn btn-secondary btn-sm" type="submit" form="<%= planFormId %>"><%= lan.Save %></button>
                    <form method="POST" action="/schooladmin/transport/fee-plans/<%= plan.id %>/delete" class="inline">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <button class="btn btn-danger btn-sm" type="submit"><%= lan.Deactivate %></button>
                    </form>
                  </td>
                </tr>
              <% }) } else { %>
                <tr><td colspan="10" class="text-center text-slate-500 py-8"><%= lan.No_Fee_Plans_Yet %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
</div>
        <%- include('../../partials/footer') %>
    </div>
</div>

<script>
  document.querySelectorAll('.fee-plan-form').forEach((form) => {
    const route = form.querySelector('.route-select');
    const stop = form.querySelector('.stop-select');
    function filterStops() {
      const routeId = route ? route.value : '';
      Array.from(stop.options).forEach((option) => {
        if (!option.value) return option.hidden = false;
        option.hidden = Boolean(routeId) && option.dataset.routeId !== routeId;
        if (option.hidden && option.selected) stop.value = '';
      });
    }
    if (route && stop) {
      route.addEventListener('change', filterStops);
      filterStops();
    }
  });
</script>