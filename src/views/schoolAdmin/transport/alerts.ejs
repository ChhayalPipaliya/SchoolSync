<%- include('../../partials/head') %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%= lan.Transport_Alerts || 'Transport Alerts & Incidents' %>
                                        </h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;">
                                            <%= lan.Transport_Alerts_Subtitle
                                                || 'Critical transport issues, delay warnings, emergency alerts, and document lapses'
                                                %>
                                        </p>
                                    </div>
                                </div>
                                <div>
                                    <a href="/schooladmin/transport/dashboard" class="btn"
                                        style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                                        <i class="fa-solid fa-arrow-left"></i>
                                        <%= lan.Dashboard || 'Dashboard' %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <%- include('_tabs', { currentPath: currentPath }) %>
                                <div class="grid grid-cols-2 sm:grid-cols-2 xl:grid-cols-4 gap-2.5 sm:gap-4 mb-3">
                                    <div class="table-card p-4 sm:p-5">
                                        <p class="text-[10px] sm:text-xs font-black uppercase text-slate-500">
                                            <%= lan.Open_Issues %>
                                        </p>
                                        <p class="text-2xl sm:text-3xl font-black text-slate-900 mt-1 sm:mt-2">
                                            <%= Number(summary.openCount || 0) %>
                                        </p>
                                    </div>
                                    <div class="table-card p-4 sm:p-5">
                                        <p class="text-[10px] sm:text-xs font-black uppercase text-slate-500">
                                            <%= lan.Vehicle_Issues %>
                                        </p>
                                        <p class="text-2xl sm:text-3xl font-black text-rose-700 mt-1 sm:mt-2">
                                            <%= Number(summary.vehicleIssues || 0) %>
                                        </p>
                                    </div>
                                    <div class="table-card p-4 sm:p-5">
                                        <p class="text-[10px] sm:text-xs font-black uppercase text-slate-500">
                                            <%= lan.Doc_Expiry %>
                                        </p>
                                        <p class="text-2xl sm:text-3xl font-black text-amber-700 mt-1 sm:mt-2">
                                            <%= Number(summary.documentExpiry || 0) %>
                                        </p>
                                    </div>
                                    <div class="table-card p-4 sm:p-5">
                                        <p class="text-[10px] sm:text-xs font-black uppercase text-slate-500">
                                            <%= lan.Maintenance %>
                                        </p>
                                        <p class="text-2xl sm:text-3xl font-black text-indigo-700 mt-1 sm:mt-2">
                                            <%= Number(summary.maintenanceDue || 0) %>
                                        </p>
                                    </div>
                                </div>
                                <div class="table-card">
                                    <div class="table-header-row bg-slate-50/40">
                                        <h4 class="table-heading uppercase tracking-wider">
                                            <%= lan.Alert_Inbox %>
                                        </h4>
                                    </div>
                                    <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;">
                                        <table class="table" style="min-width: 820px; width: 100%;">
                                            <thead>
                                                <tr>
                                                    <th style="white-space: nowrap;">
                                                        <%= lan.Issue %>
                                                    </th>
                                                    <th style="white-space: nowrap;">
                                                        <%= lan.Type %>
                                                    </th>
                                                    <th style="white-space: nowrap;">
                                                        <%= lan.Severity %>
                                                    </th>
                                                    <th style="white-space: nowrap;">
                                                        <%= lan.Related %>
                                                    </th>
                                                    <th style="white-space: nowrap;">
                                                        <%= lan.Status %>
                                                    </th>
                                                    <th style="white-space: nowrap;">
                                                        <%= lan.Created %>
                                                    </th>
                                                    <th style="white-space: nowrap;">
                                                        <%= lan.Action %>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% function severityFor(alert) { if
                                                    (['vehicle_issue','checklist_failure','document_expiry','maintenance_due'].includes(alert.alert_type))
                                                    return lan.High || 'High' ; if (alert.alert_type==='delay' ) return
                                                    lan.Medium || 'Medium' ; return lan.Normal || 'Normal' ; } %>
                                                    <% if ((alerts || []).length) { alerts.forEach(alert=> { const sev =
                                                        severityFor(alert); %>
                                                        <tr>
                                                            <td style="min-width: 240px; white-space: normal;">
                                                                <p class="text-sm font-black text-slate-900">
                                                                    <%= alert.title %>
                                                                </p>
                                                                <p class="text-xs text-slate-500 mt-1">
                                                                    <%= alert.message %>
                                                                </p>
                                                            </td>
                                                            <td style="white-space: nowrap;"><span
                                                                    class="inline-flex px-2 py-1 rounded-md bg-slate-100 text-slate-700 text-xs font-black"
                                                                    style="white-space: nowrap;">
                                                                    <%= String(alert.alert_type || 'general'
                                                                        ).replace('_', ' ' ) %>
                                                                </span></td>
                                                            <td style="white-space: nowrap;">
                                                                <span
                                                                    class="inline-flex px-2 py-1 rounded-md text-xs font-black <%= (sev === 'High' || sev === lan.High) ? 'bg-rose-100 text-rose-700' : (sev === 'Medium' || sev === lan.Medium) ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %>"
                                                                    style="white-space: nowrap;">
                                                                    <%= sev %>
                                                                </span>
                                                            </td>
                                                            <td class="text-xs text-slate-600"
                                                                style="white-space: nowrap;">
                                                                <%= alert.routeName ? (lan.Route || 'Route' ) + ': ' +
                                                                    alert.routeName : '' %>
                                                                    <%= alert.vehicleNumber ? (alert.routeName ? ' • '
                                                                        : '' ) + (lan.Vehicle || 'Vehicle' ) + ': ' +
                                                                        alert.vehicleNumber : '' %>
                                                                        <%= alert.studentName &&
                                                                            alert.studentName.trim() ? ' • ' +
                                                                            (lan.Student || 'Student' ) + ': ' +
                                                                            alert.studentName.trim() : '' %>
                                                            </td>
                                                            <td style="white-space: nowrap;"><span
                                                                    class="inline-flex px-2 py-1 rounded-md bg-white border border-slate-200 text-slate-700 text-xs font-black"
                                                                    style="white-space: nowrap;">
                                                                    <%= alert.status %>
                                                                </span></td>
                                                            <td class="text-xs text-slate-500"
                                                                style="white-space: nowrap;">
                                                                <%= alert.created_at ? new
                                                                    Date(alert.created_at).toISOString().slice(0,
                                                                    16).replace('T', ' ' ) : '-' %>
                                                            </td>
                                                            <td style="white-space: nowrap;">
                                                                <% if (alert.status==='open' &&
                                                                    alert.alert_type==='checklist_failure' ) { %>
                                                                    <form method="POST"
                                                                        action="/schooladmin/transport/alerts/<%= alert.id %>/override-checklist"
                                                                        class="inline">
                                                                        <input type="hidden" name="_csrf"
                                                                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                                        <button
                                                                            class="btn btn-warning btn-sm text-xs font-bold"
                                                                            type="submit"
                                                                            title="Override failed checklist & clear for trip start"
                                                                            style="white-space: nowrap;">
                                                                            <i
                                                                                class="fa-solid fa-shield-check mr-1"></i>
                                                                            <%= lan.Override %>
                                                                        </button>
                                                                    </form>
                                                                    <% } %>
                                                                        <% if (alert.status==='open' ) { %>
                                                                            <form method="POST"
                                                                                action="/schooladmin/transport/alerts/<%= alert.id %>/resolve"
                                                                                class="inline">
                                                                                <input type="hidden" name="_csrf"
                                                                                    value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                                                <button
                                                                                    class="btn btn-secondary btn-sm text-xs font-bold"
                                                                                    type="submit"
                                                                                    style="white-space: nowrap;">
                                                                                    <%= lan.Resolve %>
                                                                                </button>
                                                                            </form>
                                                                            <% } %>
                                                                                <% if (alert.status !=='dismissed' ) {
                                                                                    %>
                                                                                    <form method="POST"
                                                                                        action="/schooladmin/transport/alerts/<%= alert.id %>/dismiss"
                                                                                        class="inline">
                                                                                        <input type="hidden"
                                                                                            name="_csrf"
                                                                                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                                                        <button
                                                                                            class="btn btn-danger btn-sm text-xs font-bold"
                                                                                            type="submit"
                                                                                            style="white-space: nowrap;">
                                                                                            <%= lan.Dismiss %>
                                                                                        </button>
                                                                                    </form>
                                                                                    <% } %>
                                                            </td>
                                                        </tr>
                                                        <% }) } else { %>
                                                            <tr>
                                                                <td colspan="7" class="text-center text-slate-500 py-8">
                                                                    <%= lan.No_Transport_Alerts_Yet %>
                                                                </td>
                                                            </tr>
                                                            <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>