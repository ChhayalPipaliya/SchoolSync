<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Transport Alerts</h2>
          <p class="text-xs text-slate-500 mt-1">Driver reports, vehicle issues, document expiry, and maintenance notices</p>
        </div>
        <a href="/schooladmin/transport/dashboard" class="btn btn-secondary text-xs font-bold"><i class="fa-solid fa-arrow-left mr-1"></i>Dashboard</a>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
        <div class="table-card p-5"><p class="text-xs font-black uppercase text-slate-500">Open Issues</p><p class="text-3xl font-black text-slate-900 mt-2"><%= Number(summary.openCount || 0) %></p></div>
        <div class="table-card p-5"><p class="text-xs font-black uppercase text-slate-500">Vehicle Issues</p><p class="text-3xl font-black text-rose-700 mt-2"><%= Number(summary.vehicleIssues || 0) %></p></div>
        <div class="table-card p-5"><p class="text-xs font-black uppercase text-slate-500">Document Expiry</p><p class="text-3xl font-black text-amber-700 mt-2"><%= Number(summary.documentExpiry || 0) %></p></div>
        <div class="table-card p-5"><p class="text-xs font-black uppercase text-slate-500">Maintenance Due</p><p class="text-3xl font-black text-indigo-700 mt-2"><%= Number(summary.maintenanceDue || 0) %></p></div>
      </div>
      <div class="table-card">
        <div class="table-header-row bg-slate-50/40">
          <h4 class="table-heading uppercase tracking-wider">Alert Inbox</h4>
        </div>
        <div class="overflow-x-auto">
          <table class="table">
            <thead><tr><th>Issue</th><th>Type</th><th>Severity</th><th>Related</th><th>Status</th><th>Created</th><th>Action</th></tr></thead>
            <tbody>
              <% function severityFor(alert) { if (['vehicle_issue','document_expiry','maintenance_due'].includes(alert.alert_type)) return 'High'; if (alert.alert_type === 'delay') return 'Medium'; return 'Normal'; } %>
              <% if ((alerts || []).length) { alerts.forEach(alert => { const sev = severityFor(alert); %>
                <tr>
                  <td class="min-w-[260px]">
                    <p class="text-sm font-black text-slate-900"><%= alert.title %></p>
                    <p class="text-xs text-slate-500 mt-1"><%= alert.message %></p>
                  </td>
                  <td><span class="inline-flex px-2 py-1 rounded-md bg-slate-100 text-slate-700 text-xs font-black"><%= String(alert.alert_type || 'general').replace('_', ' ') %></span></td>
                  <td>
                    <span class="inline-flex px-2 py-1 rounded-md text-xs font-black <%= sev === 'High' ? 'bg-rose-100 text-rose-700' : sev === 'Medium' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %>"><%= sev %></span>
                  </td>
                  <td class="text-xs text-slate-600 min-w-[180px]">
                    <%= alert.routeName ? 'Route: ' + alert.routeName : '' %>
                    <%= alert.vehicleNumber ? (alert.routeName ? ' • ' : '') + 'Vehicle: ' + alert.vehicleNumber : '' %>
                    <%= alert.studentName && alert.studentName.trim() ? ' • Student: ' + alert.studentName.trim() : '' %>
                  </td>
                  <td><span class="inline-flex px-2 py-1 rounded-md bg-white border border-slate-200 text-slate-700 text-xs font-black"><%= alert.status %></span></td>
                  <td class="text-xs text-slate-500"><%= alert.created_at ? new Date(alert.created_at).toISOString().slice(0, 16).replace('T', ' ') : '-' %></td>
                  <td class="whitespace-nowrap">
                    <% if (alert.status === 'open') { %>
                      <form method="POST" action="/schooladmin/transport/alerts/<%= alert.id %>/resolve" class="inline"><button class="btn btn-secondary btn-sm" type="submit">Resolve</button></form>
                    <% } %>
                    <% if (alert.status !== 'dismissed') { %>
                      <form method="POST" action="/schooladmin/transport/alerts/<%= alert.id %>/dismiss" class="inline"><button class="btn btn-danger btn-sm" type="submit">Dismiss</button></form>
                    <% } %>
                  </td>
                </tr>
              <% }) } else { %>
                <tr><td colspan="7" class="text-center text-slate-500 py-8">No transport alerts yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
</div>
</div>
<%- include('../../partials/footer') %>