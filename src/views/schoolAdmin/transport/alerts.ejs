<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Transport Alerts</h2>
          <p class="text-xs text-slate-500 mt-1">Driver reports, vehicle issues, document expiry, and maintenance notices</p>
        </div>
        <a href="/schooladmin/transport/dashboard" class="btn btn-secondary text-xs font-bold"><i class="fa-solid fa-arrow-left mr-1"></i>Dashboard</a>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="grid grid-cols-2 sm:grid-cols-2 xl:grid-cols-4 gap-2.5 sm:gap-4 mb-6">
        <div class="table-card p-4 sm:p-5"><p class="text-[10px] sm:text-xs font-black uppercase text-slate-500">Open Issues</p><p class="text-2xl sm:text-3xl font-black text-slate-900 mt-1 sm:mt-2"><%= Number(summary.openCount || 0) %></p></div>
        <div class="table-card p-4 sm:p-5"><p class="text-[10px] sm:text-xs font-black uppercase text-slate-500">Vehicle Issues</p><p class="text-2xl sm:text-3xl font-black text-rose-700 mt-1 sm:mt-2"><%= Number(summary.vehicleIssues || 0) %></p></div>
        <div class="table-card p-4 sm:p-5"><p class="text-[10px] sm:text-xs font-black uppercase text-slate-500">Doc Expiry</p><p class="text-2xl sm:text-3xl font-black text-amber-700 mt-1 sm:mt-2"><%= Number(summary.documentExpiry || 0) %></p></div>
        <div class="table-card p-4 sm:p-5"><p class="text-[10px] sm:text-xs font-black uppercase text-slate-500">Maintenance</p><p class="text-2xl sm:text-3xl font-black text-indigo-700 mt-1 sm:mt-2"><%= Number(summary.maintenanceDue || 0) %></p></div>
      </div>
      <div class="table-card">
        <div class="table-header-row bg-slate-50/40">
          <h4 class="table-heading uppercase tracking-wider">Alert Inbox</h4>
        </div>
        <div class="overflow-x-auto" style="-webkit-overflow-scrolling: touch;">
          <table class="table" style="min-width: 820px; width: 100%;">
            <thead>
              <tr>
                <th style="white-space: nowrap;">Issue</th>
                <th style="white-space: nowrap;">Type</th>
                <th style="white-space: nowrap;">Severity</th>
                <th style="white-space: nowrap;">Related</th>
                <th style="white-space: nowrap;">Status</th>
                <th style="white-space: nowrap;">Created</th>
                <th style="white-space: nowrap;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% function severityFor(alert) { if (['vehicle_issue','checklist_failure','document_expiry','maintenance_due'].includes(alert.alert_type)) return 'High'; if (alert.alert_type === 'delay') return 'Medium'; return 'Normal'; } %>
              <% if ((alerts || []).length) { alerts.forEach(alert => { const sev = severityFor(alert); %>
                <tr>
                  <td style="min-width: 240px; white-space: normal;">
                    <p class="text-sm font-black text-slate-900"><%= alert.title %></p>
                    <p class="text-xs text-slate-500 mt-1"><%= alert.message %></p>
                  </td>
                  <td style="white-space: nowrap;"><span class="inline-flex px-2 py-1 rounded-md bg-slate-100 text-slate-700 text-xs font-black" style="white-space: nowrap;"><%= String(alert.alert_type || 'general').replace('_', ' ') %></span></td>
                  <td style="white-space: nowrap;">
                    <span class="inline-flex px-2 py-1 rounded-md text-xs font-black <%= sev === 'High' ? 'bg-rose-100 text-rose-700' : sev === 'Medium' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' %>" style="white-space: nowrap;"><%= sev %></span>
                  </td>
                  <td class="text-xs text-slate-600" style="white-space: nowrap;">
                    <%= alert.routeName ? 'Route: ' + alert.routeName : '' %>
                    <%= alert.vehicleNumber ? (alert.routeName ? ' • ' : '') + 'Vehicle: ' + alert.vehicleNumber : '' %>
                    <%= alert.studentName && alert.studentName.trim() ? ' • Student: ' + alert.studentName.trim() : '' %>
                  </td>
                  <td style="white-space: nowrap;"><span class="inline-flex px-2 py-1 rounded-md bg-white border border-slate-200 text-slate-700 text-xs font-black" style="white-space: nowrap;"><%= alert.status %></span></td>
                  <td class="text-xs text-slate-500" style="white-space: nowrap;"><%= alert.created_at ? new Date(alert.created_at).toISOString().slice(0, 16).replace('T', ' ') : '-' %></td>
                  <td style="white-space: nowrap;">
                    <% if (alert.status === 'open' && alert.alert_type === 'checklist_failure') { %>
                      <form method="POST" action="/schooladmin/transport/alerts/<%= alert.id %>/override-checklist" class="inline">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <button class="btn btn-warning btn-sm text-xs font-bold" type="submit" title="Override failed checklist & clear for trip start" style="white-space: nowrap;">
                          <i class="fa-solid fa-shield-check mr-1"></i>Override
                        </button>
                      </form>
                    <% } %>
                    <% if (alert.status === 'open') { %>
                      <form method="POST" action="/schooladmin/transport/alerts/<%= alert.id %>/resolve" class="inline">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <button class="btn btn-secondary btn-sm text-xs font-bold" type="submit" style="white-space: nowrap;">Resolve</button>
                      </form>
                    <% } %>
                    <% if (alert.status !== 'dismissed') { %>
                      <form method="POST" action="/schooladmin/transport/alerts/<%= alert.id %>/dismiss" class="inline">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <button class="btn btn-danger btn-sm text-xs font-bold" type="submit" style="white-space: nowrap;">Dismiss</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) } else { %>
                <tr><td colspan="7" class="text-center text-slate-500 py-8">No transport alerts yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
</div>
</div>
<%- include('../../partials/footer') %>