<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Transport Management</h2>
                    <p class="text-xs text-gray-500 mt-1">Manage vehicles, routes, driver assignments, and student transport mappings</p>
                </div>
                <a href="/schooladmin/transport/routes/add" class="btn btn-primary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-plus"></i> Add Route
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <%- include('_tabs', { currentPath: currentPath }) %>
            <div class="grid grid-cols-1 xl:grid-cols-[1fr_320px] gap-4 mb-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% [
                      ['Total Routes', routeSummary.totalRoutes, 'fa-route', 'text-slate-700'],
                      ['Active Routes', routeSummary.activeRoutes, 'fa-toggle-on', 'text-emerald-700'],
                      ['Assigned Students', routeSummary.studentsAssigned, 'fa-users', 'text-cyan-700'],
                      ['Total Stops', routeSummary.totalStops, 'fa-map-pin', 'text-slate-700']
                    ].forEach(card => { %>
                    <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500"><%= card[0] %></div>
                                <div class="text-2xl font-extrabold text-slate-900 mt-2"><%= card[1] || 0 %></div>
                            </div>
                            <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-center <%= card[3] %>">
                                <i class="fa-solid <%= card[2] %>"></i>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <div class="card p-4 bg-slate-50 border border-slate-200">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-base font-bold text-slate-900">Selected route preview</h3>
                            <p class="text-xs text-slate-500">Quick details for the highlighted route</p>
                        </div>
                        <% if (selectedRouteId) { %>
                          <a href="/schooladmin/transport/routes?selectedRouteId=<%= selectedRouteId %>" class="text-xs text-emerald-700 font-bold">Refresh</a>
                        <% } %>
                    </div>
                    <% if (selectedRoute) { %>
                        <div class="space-y-3">
                            <div class="text-sm font-semibold text-slate-700">Route name</div>
                            <div class="text-lg font-bold text-slate-900"><%= selectedRoute.routeName %></div>
                            <div class="grid grid-cols-1 gap-2 text-sm text-slate-600">
                                <div><strong>Path:</strong> <%= selectedRoute.startPoint %> → <%= selectedRoute.endPoint %></div>
                                <div><strong>Driver:</strong> <%= selectedRoute.driverName || 'Unassigned' %></div>
                                <div><strong>Vehicle:</strong> <%= selectedRoute.vehicleNumber || 'Unassigned' %></div>
                                <div><strong>Shift:</strong> <%= selectedRoute.schoolShift === 'morning' ? 'Morning' : selectedRoute.schoolShift === 'evening' ? 'Evening' : 'Full Day' %></div>
                                <% if (hasZone) { %>
                                    <div><strong>Zone:</strong> <%= selectedRoute.zone || 'Not specified' %></div>
                                <% } %>
                                <div><strong>Capacity:</strong> <%= selectedRoute.assignedStudents || 0 %> / <%= selectedRoute.vehicleCapacity || 0 %> seats assigned</div>
                            </div>
                            <div class="flex flex-wrap gap-2 pt-2">
                                <a href="/schooladmin/transport/routes/edit/<%= selectedRoute.id %>" class="btn btn-secondary px-3 py-2 text-xs font-bold uppercase tracking-wider">Edit Route</a>
                                <a href="/schooladmin/transport/routes/<%= selectedRoute.id %>/stops" class="btn btn-primary px-3 py-2 text-xs font-bold uppercase tracking-wider">Manage Stops</a>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="text-sm text-slate-500">Select or load a route to see a quick preview.</div>
                    <% } %>
                </div>
            </div>
            <div class="card p-4 mb-6">
                <form method="GET" action="/schooladmin/transport/routes" class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-3 items-end">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div>
                            <label class="form-label text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Search</label>
                            <input type="search" name="search" value="<%= filters.search || '' %>" placeholder="Route, start/end point, driver, vehicle" class="form-input w-full">
                        </div>
                        <div>
                            <label class="form-label text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Status</label>
                            <select name="status" class="form-select w-full">
                                <option value="">All</option>
                                <% statusOptions.forEach(opt => { %>
                                  <option value="<%= opt %>" <%= filters.status === opt ? 'selected' : '' %>><%= opt.charAt(0).toUpperCase() + opt.slice(1) %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="form-label text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Shift</label>
                            <select name="shift" class="form-select w-full">
                                <option value="">All Shifts</option>
                                <% shiftOptions.forEach(opt => { %>
                                  <option value="<%= opt %>" <%= filters.shift === opt ? 'selected' : '' %>><%= opt === 'full_day' ? 'Full Day' : opt.charAt(0).toUpperCase() + opt.slice(1) %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <% if (hasZone) { %>
                            <div>
                                <label class="form-label text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Zone</label>
                                <select name="zone" class="form-select w-full">
                                    <option value="">All Zones</option>
                                    <% zoneOptions.forEach(opt => { %>
                                      <option value="<%= opt %>" <%= filters.zone === opt ? 'selected' : '' %>><%= opt %></option>
                                    <% }) %>
                                </select>
                            </div>
                        <% } %>
                        <div class="flex gap-2">
                            <button type="submit" class="btn btn-primary px-4 py-2 text-xs font-bold uppercase tracking-wider">Filter</button>
                            <a href="/schooladmin/transport/routes" class="btn btn-secondary px-4 py-2 text-xs font-bold uppercase tracking-wider">Reset</a>
                        </div>
                    </div>
                </form>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <h4 class="table-heading uppercase tracking-wider">Configured Transport Routes</h4>
                    <a href="/schooladmin/transport/routes/add" class="btn btn-primary text-xs font-bold uppercase tracking-wider">Add Route</a>
                </div>
                <div class="table-container overflow-x-auto">
                    <table class="data-table min-w-[1100px]">
                        <thead>
                            <tr>
                                <th>Route Name</th>
                                <th>Path</th>
                                <th>Driver</th>
                                <th>Vehicle</th>
                                <th>Shift</th>
                                <% if (hasZone) { %><th>Zone</th><% } %>
                                <th class="text-center">Stops</th>
                                <th class="text-center">Students</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!routes || routes.length === 0) { %>
                                <tr>
                                    <td colspan="<%= 9 + (hasZone ? 1 : 0) %>" class="text-center py-12 text-gray-400 font-medium">
                                        <div class="flex flex-col items-center justify-center gap-2">
                                            <i class="fa-solid fa-route fa-2x text-gray-200"></i>
                                            <span>No routes configured.</span>
                                            <a href="/schooladmin/transport/routes/add" class="text-emerald-600 font-bold hover:underline mt-1">Add first route</a>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            <% (routes||[]).forEach(r => { %>
                                <tr class="<%= selectedRouteId === r.id ? 'bg-emerald-50/50' : '' %>">
                                    <td class="font-bold text-slate-800 text-[13px]"><%= r.routeName %></td>
                                    <td class="font-medium text-gray-700"><%= r.startPoint %> → <%= r.endPoint %></td>
                                    <td class="font-medium text-slate-700"><%= r.driverFirst ? `${r.driverFirst} ${r.driverLast}` : 'Unassigned' %></td>
                                    <td class="font-mono text-xs font-semibold text-slate-600"><%= r.vehicleNumber || 'Unassigned' %></td>
                                    <td class="text-slate-600"><%= r.schoolShift === 'morning' ? 'Morning' : r.schoolShift === 'evening' ? 'Evening' : 'Full Day' %></td>
                                    <% if (hasZone) { %><td><%= r.zone || '—' %></td><% } %>
                                    <td class="text-center"><%= r.stopsCount || 0 %></td>
                                    <td class="text-center"><%= r.studentCount || 0 %></td>
                                    <td class="text-center">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase border
                                            <%= r.status === 'active' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-slate-50 text-slate-500 border-slate-100' %>">
                                            <%= r.status %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="flex items-center justify-center gap-1.5 flex-wrap">
                                            <a href="/schooladmin/transport/routes/edit/<%= r.id %>" class="btn-icon btn-edit-icon" title="Edit">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form method="POST" action="/schooladmin/transport/routes/delete/<%= r.id %>" class="inline-block m-0" onsubmit="return confirm('Delete this route?')">
                                                <button type="submit" class="btn-icon btn-danger-icon" title="Delete">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>