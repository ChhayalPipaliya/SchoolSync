<%- include('../../partials/head') %>
    <style>
        .leaflet-div-icon-blue {
            background: #2563eb;
            border: 2px solid #ffffff;
            color: #ffffff;
            font-weight: 800;
            font-size: 11px;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
        }

        .leaflet-div-icon-school {
            background: #059669;
            border: 2px solid #ffffff;
            color: #ffffff;
            font-weight: 800;
            font-size: 13px;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px -1px rgba(5, 150, 105, 0.4), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
        }

        .leaflet-div-icon-orange {
            background: #f97316;
            border: 2px solid #ffffff;
            color: #ffffff;
            font-weight: 800;
            font-size: 11px;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.2);
            animation: pulseMarker 2s infinite;
            cursor: grab;
        }

        .leaflet-div-icon-orange:active {
            cursor: grabbing;
        }

        @keyframes pulseMarker {
            0% {
                box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.6);
            }

            70% {
                box-shadow: 0 0 0 12px rgba(249, 115, 22, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(249, 115, 22, 0);
            }
        }

        [data-theme="dark"] .text-slate-800,
        .light-mode-disabled .text-slate-800,
        [data-theme="dark"] .text-slate-700,
        .light-mode-disabled .text-slate-700 {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .text-slate-600,
        .light-mode-disabled .text-slate-600,
        [data-theme="dark"] .text-slate-500,
        .light-mode-disabled .text-slate-500 {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .bg-white,
        .light-mode-disabled .bg-white,
        [data-theme="dark"] .table-card,
        .light-mode-disabled .table-card {
            background-color: #151D30 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .border-slate-200,
        .light-mode-disabled .border-slate-200,
        [data-theme="dark"] .border-slate-100,
        .light-mode-disabled .border-slate-100 {
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .table-header-row,
        .light-mode-disabled .table-header-row,
        [data-theme="dark"] thead tr,
        .light-mode-disabled thead tr {
            background-color: #101726 !important;
            border-bottom-color: #242F4D !important;
        }

        [data-theme="dark"] .table-heading,
        .light-mode-disabled .table-heading,
        [data-theme="dark"] thead th,
        .light-mode-disabled thead th {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .data-table tbody tr,
        .light-mode-disabled .data-table tbody tr {
            border-bottom-color: #242F4D !important;
        }

        [data-theme="dark"] .data-table tbody tr:hover,
        .light-mode-disabled .data-table tbody tr:hover {
            background-color: #1E293B !important;
        }

        [data-theme="dark"] .data-table tbody td,
