<%- include('../../partials/head', { title: `${lan.Bulk_Export_Center || 'Bulk Export Center'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/exports' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>        
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-file-export"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Bulk_Export_Center || 'Bulk Export Center' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Bulk_Export_Desc || 'Select report types, apply filters, and download data in CSV, Excel, or PDF formats.' %></p>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card mb-8">
                <div class="card-body">
                    <form id="exportForm" onsubmit="triggerExport(event)" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Report_Type || 'Report Type' %></label>
                            <select id="entityType" class="form-select" onchange="toggleFilterFields(this.value)">
                                <optgroup label="<%- lan.Reports || 'REPORTS' %>">
                                    <option value="attendance"><%- lan.Attendance_Report || 'Attendance Report' %></option>
                                    <option value="fees"><%- lan.Fee_Collection_Report || 'Fee Collection Report' %></option>
                                    <option value="marks"><%- lan.Exam_Results_Report || 'Exam Results Report' %></option>
                                    <option value="defaulters"><%- lan.Defaulters_List || 'Defaulters List (Fee/Book)' %></option>
                                </optgroup>
                                <optgroup label="<%- lan.Data_Exports || 'DATA EXPORTS' %>">
                                    <option value="students" selected><%- lan.Students_List || 'Students List' %></option>
                                    <option value="teachers"><%- lan.Teachers_List || 'Teachers List' %></option>
                                    <option value="parents"><%- lan.Parents_Guardians || 'Parents / Guardians' %></option>
                                    <option value="classes_sections"><%- lan.Classes_Sections || 'Classes / Sections' %></option>
                                    <option value="subjects"><%- lan.Subjects || 'Subjects' %></option>
                                    <option value="student_class_allocation"><%- lan.Student_Class_Allocation || 'Student-Class Allocation' %></option>
                                    <option value="teacher_subject_assignment"><%- lan.Teacher_Subject_Assignment || 'Teacher-Subject Assignment' %></option>
                                    <option value="timetable"><%- lan.Timetable || 'Timetable' %></option>
                                    <option value="books"><%- lan.Library_Books_Inventory || 'Library Books Inventory' %></option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.File_Format || 'File Format' %></label>
                            <select id="fileFormat" class="form-select">
                                <option value="csv" selected>CSV (<%- lan.Comma_Separated_Values || 'Comma Separated Values' %>)</option>
                                <option value="xlsx">Excel Workbook (.xlsx)</option>
                                <option value="pdf">PDF Report (.pdf)</option>
                            </select>
                        </div>
                        <div id="filterClass" class="filter-field form-group mb-0">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Class_And_Section || 'Class & Section' %></label>
                            <select id="filterClassId" class="form-select">
                                <option value=""><%- lan.All_Classes || 'All Classes' %></option>
                                <% classes.forEach(cls => { %>
                                    <option value="<%= cls.id %>"><%= cls.class_name %><%= (cls.stream && cls.stream.trim() !== '' && cls.stream !== 'General') ? ' - ' + cls.stream : '' %> - <%= cls.section %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div id="filterExam" class="filter-field form-group mb-0 d-none">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Exam || 'Exam' %></label>
                            <select id="filterExamId" class="form-select">
                                <option value=""><%- lan.Select_Exam || 'Select Exam' %></option>
                                <% exams.forEach(ex => { %>
                                    <option value="<%= ex.id %>"><%= ex.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div id="filterCategory" class="filter-field form-group mb-0 d-none">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Library_Category || 'Library Category' %></label>
                            <select id="filterCategoryId" class="form-select">
                                <option value=""><%- lan.All_Categories || 'All Categories' %></option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>"><%= cat.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div id="filterTeacher" class="filter-field form-group mb-0 d-none">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Teacher || 'Teacher' %></label>
                            <select id="filterTeacherId" class="form-select">
                                <option value=""><%- lan.All_Teachers || 'All Teachers' %></option>
                                <% if (typeof teachers !== 'undefined') { %>
                                    <% teachers.forEach(t => { %>
                                        <option value="<%= t.id %>"><%= t.name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div id="filterDay" class="filter-field form-group mb-0 d-none">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Day_Of_Week || 'Day of Week' %></label>
                            <select id="filterDayVal" class="form-select">
                                <option value=""><%- lan.All_Days || 'All Days' %></option>
                                <option value="monday"><%- lan.Monday || 'Monday' %></option>
                                <option value="tuesday"><%- lan.Tuesday || 'Tuesday' %></option>
                                <option value="wednesday"><%- lan.Wednesday || 'Wednesday' %></option>
                                <option value="thursday"><%- lan.Thursday || 'Thursday' %></option>
                                <option value="friday"><%- lan.Friday || 'Friday' %></option>
                                <option value="saturday"><%- lan.Saturday || 'Saturday' %></option>
                                <option value="sunday"><%- lan.Sunday || 'Sunday' %></option>
                            </select>
                        </div>
                        <div id="filterRelationship" class="filter-field form-group mb-0 d-none">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Relationship || 'Relationship' %></label>
                            <select id="filterRelationshipVal" class="form-select">
                                <option value=""><%- lan.All_Relationships || 'All Relationships' %></option>
                                <option value="father"><%- lan.Father || 'Father' %></option>
                                <option value="mother"><%- lan.Mother || 'Mother' %></option>
                                <option value="guardian"><%- lan.Guardian || 'Guardian' %></option>
                            </select>
                        </div>
                        <div id="filterStatus" class="filter-field form-group mb-0">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Status || 'Status' %></label>
                            <select id="filterStatusVal" class="form-select">
                                <option value=""><%- lan.All_Statuses || 'All Statuses' %></option>
                                <option value="active"><%- lan.Active || 'Active' %></option>
                                <option value="inactive"><%- lan.Inactive || 'Inactive' %></option>
                            </select>
                        </div>
                        <div id="filterSubject" class="filter-field form-group mb-0 d-none">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Subject_Name || 'Subject Name' %></label>
                            <input type="text" id="filterSubjectName" placeholder="<%- lan.Eg_Maths || 'e.g. Maths' %>" class="form-input">
                        </div>
                        <div id="filterDateFrom" class="filter-field form-group mb-0">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Date_From || 'Date From' %></label>
                            <input type="date" id="filterDateFromVal" class="form-input">
                        </div>
                        <div id="filterDateTo" class="filter-field form-group mb-0">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px]"><%- lan.Date_To || 'Date To' %></label>
                            <input type="date" id="filterDateToVal" class="form-input">
                        </div>
                        <div class="md:col-span-3 flex justify-end">
                            <button type="submit" id="btnExport" class="btn btn-primary text-xs font-bold shadow-sm transition">
                                <span id="btnText"><i class="fa-solid fa-file-export mr-1"></i> <%- lan.Generate_Report || 'Generate Report' %></span>
                                <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider"><i class="fa-solid fa-clock-rotate-left mr-2 text-emerald-600"></i> <%- lan.Recent_Exports || 'Recent Exports' %></h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th><%- lan.Created_At || 'Created At' %></th>
                                <th><%- lan.Type || 'Type' %></th>
                                <th><%- lan.Filters || 'Filters' %></th>
                                <th><%- lan.Record_Count || 'Record Count' %></th>
                                <th><%- lan.File_Size || 'File Size' %></th>
                                <th><%- lan.Status || 'Status' %></th>
                                <th class="text-center"><%- lan.Action || 'Action' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!logs || logs.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center py-8 text-gray-400"><%- lan.No_Export_Logs_Found || 'No export logs found.' %></td>
                                </tr>
                            <% } else { %>
                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td class="font-mono text-xs"><%= new Date(log.created_at).toLocaleString('en-IN') %></td>
                                        <td class="font-semibold capitalize text-xs"><%= log.entity_type %></td>
                                        <td class="text-xs text-gray-500 max-w-[200px] truncate" title='<%= log.filters_applied ? JSON.stringify(log.filters_applied) : "None" %>'>
                                            <%= log.filters_applied ? JSON.stringify(log.filters_applied) : "None" %>
                                        </td>
                                        <td class="font-semibold text-xs"><%= log.record_count %></td>
                                        <td class="font-mono text-xs"><%= (log.file_size / 1024).toFixed(1) %> KB</td>
                                        <td>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase
                                                <%= log.status === 'completed' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : '' %>
                                                <%= log.status === 'failed' ? 'bg-red-50 text-red-700 border border-red-100' : '' %>
                                                <%= log.status === 'processing' ? 'bg-cyan-50 text-cyan-700 border border-cyan-100' : '' %>
                                            ">
                                                <%= log.status %>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <% if (log.status === 'completed') { %>
                                                <a href="/api/export/download/<%= log.file_name %>" class="btn btn-primary btn-sm py-1 px-2.5 text-[11px] font-bold"><i class="fa-solid fa-download mr-1"></i> <%- lan.Download || 'Download' %></a>
                                            <% } else { %>
                                                <span class="text-gray-300">—</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script>
    function toggleFilterFields(type) {
        document.querySelectorAll('.filter-field').forEach(el => el.classList.add('d-none'));
        if (type === 'students') {
            document.getElementById('filterClass').classList.remove('d-none');
            document.getElementById('filterStatus').classList.remove('d-none');
            document.getElementById('filterDateFrom').classList.remove('d-none');
            document.getElementById('filterDateTo').classList.remove('d-none');
        } else if (type === 'teachers') {
            document.getElementById('filterSubject').classList.remove('d-none');
            document.getElementById('filterStatus').classList.remove('d-none');
            document.getElementById('filterDateFrom').classList.remove('d-none');
            document.getElementById('filterDateTo').classList.remove('d-none');
        } else if (type === 'attendance') {
            document.getElementById('filterClass').classList.remove('d-none');
            document.getElementById('filterDateFrom').classList.remove('d-none');
            document.getElementById('filterDateTo').classList.remove('d-none');
        } else if (type === 'fees') {
            document.getElementById('filterClass').classList.remove('d-none');
            document.getElementById('filterStatus').classList.remove('d-none');
            document.getElementById('filterDateFrom').classList.remove('d-none');
            document.getElementById('filterDateTo').classList.remove('d-none');
        } else if (type === 'marks') {
            document.getElementById('filterExam').classList.remove('d-none');
            document.getElementById('filterClass').classList.remove('d-none');
        } else if (type === 'books') {
            document.getElementById('filterCategory').classList.remove('d-none');
            document.getElementById('filterStatus').classList.remove('d-none');
        } else if (type === 'defaulters') {
            document.getElementById('filterDateFrom').classList.remove('d-none');
            document.getElementById('filterDateTo').classList.remove('d-none');
        } else if (type === 'parents') {
            document.getElementById('filterClass').classList.remove('d-none');
            document.getElementById('filterRelationship').classList.remove('d-none');
        } else if (type === 'classes_sections') {
            document.getElementById('filterClass').classList.remove('d-none');
        } else if (type === 'subjects') {
            document.getElementById('filterClass').classList.remove('d-none');
            document.getElementById('filterSubject').classList.remove('d-none');
        } else if (type === 'student_class_allocation') {
            document.getElementById('filterClass').classList.remove('d-none');
            document.getElementById('filterStatus').classList.remove('d-none');
        } else if (type === 'teacher_subject_assignment') {
            document.getElementById('filterTeacher').classList.remove('d-none');
            document.getElementById('filterClass').classList.remove('d-none');
            document.getElementById('filterSubject').classList.remove('d-none');
        } else if (type === 'timetable') {
            document.getElementById('filterClass').classList.remove('d-none');
            document.getElementById('filterTeacher').classList.remove('d-none');
            document.getElementById('filterDay').classList.remove('d-none');
        };
    };

    async function triggerExport(e) {
        e.preventDefault();
        
        const type = document.getElementById('entityType').value;
        const format = document.getElementById('fileFormat').value;

        const params = new URLSearchParams();
        params.append('format', format);

        const classTypes = new Set(['students', 'attendance', 'fees', 'marks', 'parents', 'classes_sections', 'subjects', 'student_class_allocation', 'teacher_subject_assignment', 'timetable']);
        if (classTypes.has(type)) {
            const classId = document.getElementById('filterClassId').value;
            if (classId) params.append('class_id', classId);
        };

        if (type === 'teachers' || type === 'subjects' || type === 'teacher_subject_assignment') {
            const subject = document.getElementById('filterSubjectName').value;
            if (subject) params.append('subject', subject);
        };

        if (type === 'teacher_subject_assignment' || type === 'timetable') {
            const teacherId = document.getElementById('filterTeacherId').value;
            if (teacherId) params.append('teacher_id', teacherId);
        };

        if (type === 'timetable') {
            const day = document.getElementById('filterDayVal').value;
            if (day) params.append('day_of_week', day);
        };

        if (type === 'parents') {
            const rel = document.getElementById('filterRelationshipVal').value;
            if (rel) params.append('relationship', rel);
        };

        if (type === 'marks') {
            const examId = document.getElementById('filterExamId').value;
            if (examId) params.append('exam_id', examId);
        };

        if (type === 'books') {
            const catId = document.getElementById('filterCategoryId').value;
            if (catId) params.append('category_id', catId);
        };

        if (type === 'students' || type === 'teachers' || type === 'fees' || type === 'books' || type === 'student_class_allocation') {
            const status = document.getElementById('filterStatusVal').value;
            if (status) params.append('status', status);
        };

        if (type === 'students' || type === 'teachers' || type === 'attendance' || type === 'fees' || type === 'defaulters') {
            const dateFrom = document.getElementById('filterDateFromVal').value;
            const dateTo = document.getElementById('filterDateToVal').value;
            if (dateFrom) params.append('date_from', dateFrom);
            if (dateTo) params.append('date_to', dateTo);
        };

        document.getElementById('btnText').classList.add('d-none');
        document.getElementById('btnSpinner').classList.remove('d-none');
        document.getElementById('btnExport').setAttribute('disabled', 'true');

        try {
            const response = await fetch(`/api/export/${type}?${params.toString()}`, {
                method: 'POST'
            });
            const data = await response.json();

            if (data.success && data.download_url) {
                window.location.href = data.download_url;
                alert(data.message || 'Report generated successfully.');                
                setTimeout(() => {
                    location.reload();
                }, 2000);
            } else {
                alert(data.message || 'Failed to generate export file.');
            };
        } catch (err) {
            alert('Connection error occurred while exporting.');
        } finally {
            document.getElementById('btnText').classList.remove('d-none');
            document.getElementById('btnSpinner').classList.add('d-none');
            document.getElementById('btnExport').removeAttribute('disabled');
        };
    };
</script>