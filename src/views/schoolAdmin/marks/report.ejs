<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
<%- include('../../partials/flashMessages') %>
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
        <div style="display:none">
            <div>
                <div style="font-size:18px;font-weight:700;color:#1E293B;">Marks Report</div>
                <div style="font-size:12px;color:#94A3B8;">
                    <a href="/schooladmin/exams" style="color:#4F46E5;text-decoration:none;">Marks</a> → <%= exam.name %> Report
                </div>
            </div>
            <a href="/schooladmin/exams/<%= exam.id %>/entry" class="btn btn-sm text-white" style="background:#4F46E5;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;">
                <i class="fa-solid fa-pen me-1"></i> Edit Marks
            </a>
        </div>
        <div class="custom-table">
            <div class="p-4" style="border-bottom:1px solid #E2E8F0;">
                <div style="font-size:16px;font-weight:600;color:#1E293B;">
                    <%= exam.name %> — <%= exam.className %> <%= exam.section %>
                </div>
            </div>
            <div style="overflow-x:auto;">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Student</th>
                            <% subjects.forEach(function(sub) { %>
                                <th><%= sub.name %></th>
                            <% }); %>
                            <th>Total</th>
                            <th>%</th>
                            <th>Grade</th>
                            <th style="width: 80px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(function(s, i) { 
                            const percent = s.total > 0 ? Math.round((s.obtained / s.total) * 100) : 0;
                            let grade = 'F';
                            if (percent >= 90) grade = 'A+';
                            else if (percent >= 80) grade = 'A';
                            else if (percent >= 70) grade = 'B+';
                            else if (percent >= 60) grade = 'B';
                            else if (percent >= 50) grade = 'C';
                            else if (percent >= 40) grade = 'D';

                            const gradeColor = {
                                'A+': '#16A34A', 'A': '#16A34A', 'B+': '#4F46E5',
                                'B': '#4F46E5', 'C': '#CA8A04', 'D': '#EA580C', 'F': '#DC2626'
                            };
                        %>
                        <tr>
                            <td style="color:#94A3B8;"><%= i+1 %></td>
                            <td style="font-weight:600;color:#1E293B;"><%= s.first_name %> <%= s.last_name %></td>
                            <% subjects.forEach(function(sub) {  const m = s.subjects[sub.id];%>
                                <td style="font-size:13px;color:#374151;">
                                    <% if(m) { %>
                                    <%= m.obtained %>/<%= m.total %>
                                        <span style="color:#94A3B8;font-size:11px;">(<%= m.grade %>)</span>
                                    <% } else { %>
                                        <span style="color:#94A3B8;">—</span>
                                    <% } %>
                                </td>
                            <% }); %>
                            <td style="font-weight:600;color:#1E293B;"><%= s.obtained %>/<%= s.total %></td>
                            <td style="font-weight:600;color:#4F46E5;"><%= percent %>%</td>
                            <td>
                                <span style="background:<%= gradeColor[grade] %>20;color:<%= gradeColor[grade] %>;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:700;">
                                    <%= grade %>
                                </span>
                            </td>
                            <td>
                                <a href="/schooladmin/exams/<%= exam.id %>/student/<%= s.id %>/report" class="btn btn-sm" style="background:#EFF6FF;color:#4F46E5;border-radius:6px;font-size:12px;font-weight:600;" target="_blank">
                                    <i class="fa-solid fa-file-pdf me-1"></i> Card
                                </a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>
