<%- include('../../partials/head', { title: `${lan.Academic_Progress_Report || 'Academic Progress Report'} | SchoolSync` }) %>
<style>
    .grade-badge {
        padding: 3px 8px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 12px;
        display: inline-block;
    }
    .grade-badge-A1, .grade-badge-A2, .grade-badge-A, .grade-badge-A-plus, .grade-badge-A\+ { background: rgba(22, 163, 74, 0.15); color: #16A34A; }
    .grade-badge-B1, .grade-badge-B2, .grade-badge-B, .grade-badge-B-plus, .grade-badge-B\+ { background: rgba(79, 70, 229, 0.15); color: #4F46E5; }
    .grade-badge-C1, .grade-badge-C2, .grade-badge-C { background: rgba(202, 138, 4, 0.15); color: #CA8A04; }
    .grade-badge-D { background: rgba(234, 88, 12, 0.15); color: #EA580C; }
    .grade-badge-E, .grade-badge-F { background: rgba(220, 38, 38, 0.15); color: #DC2626; }
    
    .final-grade-A1, .final-grade-A2, .final-grade-A, .final-grade-A-plus, .final-grade-A\+ { color: #16A34A; }
    .final-grade-B1, .final-grade-B2, .final-grade-B, .final-grade-B-plus, .final-grade-B\+ { color: #4F46E5; }
    .final-grade-C1, .final-grade-C2, .final-grade-C { color: #CA8A04; }
    .final-grade-D { color: #EA580C; }
    .final-grade-E, .final-grade-F { color: #DC2626; }
    
    .result-pass { color: #16A34A; }
    .result-fail { color: #DC2626; }
</style>
<div class="wrapper">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="report-card-container">
                <div class="rc-header">
                    <% if(exam.schoolLogo) { let logoUrl=exam.schoolLogo; if(!logoUrl.startsWith('http') && !logoUrl.startsWith('/')) logoUrl='/' + logoUrl; %>
                        <img src="<%= logoUrl %>" alt="School Logo" class="school-logo">
                    <% } else { %>
                        <div style="width:80px;height:80px;background:#EEF2FF;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#4F46E5;font-size:32px;">
                            <i class="fa-solid fa-school"></i></div>
                    <% } %>
                    <div class="school-info">
                        <h1><%= exam.schoolName %></h1>
                        <p><i class="fa-solid fa-location-dot me-1"></i>
                            <%= exam.schoolAddress %>
                        </p>
                        <p><%- lan.Academic_Progress_Report || 'ACADEMIC PROGRESS REPORT' %></p>
                    </div>
                </div>
                <div class="exam-title">
                    <%= exam.name %>
                </div>
                <div class="rc-body">
                    <div class="student-profile">
                        <% let profileImg=null; if(student.image) { try { const
                        imgs=JSON.parse(student.image); if(imgs && imgs.length)
                        profileImg=imgs[0].startsWith('/uploads/') ? imgs[0] : '/uploads/' +
                        imgs[0].replace(/^\/+/,''); } catch(e) { if(student.image.startsWith('http')
                        || student.image.startsWith('/')) profileImg=student.image; } } %>
                        <% if(profileImg) { %>
                            <img src="<%= profileImg %>" alt="Student" class="student-photo">
                        <% } else { %>
                            <div class="student-photo-placeholder">
                                <i class="fa-solid fa-user"></i>
                            </div>
                        <% } %>
                        <div class="student-details">
                            <div class="detail-item">
                                <div class="detail-label"><%- lan.Student_Name || 'Student Name' %></div>
                                <div class="detail-value">
                                    <%= student.first_name %>
                                    <%= student.last_name %>
                                </div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label"><%- lan.Class_And_Section || 'Class & Section' %></div>
                                <div class="detail-value">
                                    <%= exam.className %> - <%= exam.section %>
                                </div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label"><%- lan.Roll_Number || 'Roll Number' %></div>
                                <div class="detail-value">
                                    <%= student.roll_no || (lan.Not_Available || 'N/A') %>
                                </div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label"><%- lan.Admission_No || 'Admission No' %></div>
                                <div class="detail-value">
                                    <%= student.admission_no || (lan.Not_Available || 'N/A') %>
                                </div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label"><%- lan.Date_Of_Birth || 'Date of Birth' %></div>
                                <div class="detail-value">
                                    <%= student.dob ? new Date(student.dob).toLocaleDateString('en-IN') : (lan.Not_Available || 'N/A') %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th><%- lan.Subject || 'Subject' %></th>
                                <th><%- lan.Max_Marks || 'Max Marks' %></th>
                                <th><%- lan.Marks_Obtained || 'Marks Obtained' %></th>
                                <th><%- lan.Grade || 'Grade' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let sno=1; (subjects||[]).forEach(sub=> {
                            const m = marksMap && marksMap[sub.id];
                            if(m) {
                            %>
                                <tr>
                                    <td><%= sno++ %></td>
                                    <td><%= sub.name %></td>
                                    <td><%= m.total_marks %></td>
                                    <td><%= m.obtained_marks %></td>
                                    <td>
                                        <span class="grade-badge grade-badge-<%= (m.grade || '').replace('+', '-plus') %>"><%= m.grade %></span>
                                    </td>
                                </tr>
                            <% } }); %>
                        </tbody>
                    </table>
                    <div class="summary-section">
                        <div class="summary-box">
                            <div class="summary-label"><%- lan.Total_Marks || 'Total Marks' %></div>
                            <div class="summary-value">
                                <%= totalObtained %> <span style="font-size:16px;color:#64748B;font-weight:600;">/ <%= totalMax %></span>
                            </div>
                        </div>
                        <div class="summary-box">
                            <div class="summary-label"><%- lan.Percentage || 'Percentage' %></div>
                            <div class="summary-value highlight">
                                <%= percent %>%
                            </div>
                        </div>
                        <div class="summary-box">
                            <div class="summary-label"><%- lan.Final_Grade || 'Final Grade' %></div>
                            <div class="summary-value final-grade-<%= (finalGrade || '').replace('+', '-plus') %>">
                                <%= finalGrade %>
                            </div>
                        </div>
                        <div class="summary-box">
                            <div class="summary-label"><%- lan.Result || 'Result' %></div>
                            <div class="summary-value <%= finalGrade === 'F' || finalGrade === 'E' ? 'result-fail' : 'result-pass' %>">
                                <%= finalGrade==='F' || finalGrade === 'E' ? (lan.Fail || 'FAIL') : (lan.Pass || 'PASS') %>
                            </div>
                        </div>
                    </div>
                    <div class="signatures">
                        <div class="sig-box">
                            <div class="sig-line"><%- lan.Class_Teacher || 'Class Teacher' %></div>
                        </div>
                        <div class="sig-box">
                            <div class="sig-line"><%- lan.Parent_Or_Guardian || 'Parent / Guardian' %></div>
                        </div>
                        <div class="sig-box">
                            <div class="sig-line"><%- lan.Principal || 'Principal' %></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="action-buttons">
                <a href="/schooladmin/exams/<%= exam.id %>/report" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Report || 'Back to Report' %>
                </a>
                <button onclick="window.print()" class="btn btn-primary">
                    <i class="fa-solid fa-print"></i> <%- lan.Print_Report_Card || 'Print Report Card' %>
                </button>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
