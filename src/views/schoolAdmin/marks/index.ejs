<%- include('../../partials/head', { title: `${lan.Marks_And_Exams || 'Marks & Exams'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
<%- include('../../partials/flashMessages') %>
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
        <div style="display:none">
            <div>
                <div style="font-size:18px;font-weight:700;color:#1E293B;"><%- lan.Marks_And_Exams || 'Marks & Exams' %></div>
                <div style="font-size:12px;color:#94A3B8;"><%- lan.Manage_Exams_And_Marks || 'Manage exams and marks' %></div>
            </div>
            <a href="/schooladmin/exams/add" class="btn btn-sm text-white" style="background:#4F46E5;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;">
                <i class="fa-solid fa-plus me-1"></i> <%- lan.Create_Exam || 'Create Exam' %>
            </a>
        </div>
        <div class="custom-table">
            <div class="d-flex justify-content-between align-items-center p-4" style="border-bottom:1px solid #E2E8F0;">
                <div style="font-size:16px;font-weight:600;color:#1E293B;"><%- lan.All_Exams || 'All Exams' %> <span style="color:#94A3B8;font-size:13px;">(<%= (exams||[]).length %> <%- lan.Total_Small || 'total' %>)</span></div>
            </div>
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th><%- lan.Exam_Name || 'Exam Name' %></th>
                        <th><%- lan.Class || 'Class' %></th>
                        <th><%- lan.Start_Date || 'Start Date' %></th>
                        <th><%- lan.End_Date || 'End Date' %></th>
                        <th><%- lan.Marks_Entered || 'Marks Entered' %></th>
                        <th><%- lan.Action || 'Action' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if(!exams || exams.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-5" style="color:#94A3B8;">
                                <i class="fa-solid fa-file-pen fa-2x mb-2 d-block"></i> <%- lan.No_Exams_Yet || 'No exams yet.' %> <a href="/schooladmin/exams/add" style="color:#4F46E5;"><%- lan.Create_First_Exam || 'Create first exam' %></a>
                            </td>
                        </tr>
                    <% } %>
                    <% (exams||[]).forEach(function(e, i) { %>
                        <tr>
                            <td style="color:#94A3B8;"><%= i+1 %></td>
                            <td style="font-weight:600;color:#1E293B;"><%= e.name %></td>
                            <td>
                                <span style="background:#EEF2FF;color:#4F46E5;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;">
                                    <%= e.className %> - <%= e.section %>
                                </span>
                            </td>
                            <td style="color:#64748B;font-size:13px;"><%= e.start_date ? new Date(e.start_date).toLocaleDateString('en-IN') : '—' %></td>
                            <td style="color:#64748B;font-size:13px;"><%= e.end_date ? new Date(e.end_date).toLocaleDateString('en-IN') : '—' %></td>
                            <td>
                                <span style="background:#DCFCE7;color:#16A34A;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;"><%= e.totalMarks %> <%- lan.Entries_Small || 'entries' %></span>
                            </td>
                            <td>
                                <a href="/schooladmin/exams/<%= e.id %>/entry" class="btn btn-sm" style="background:#EEF2FF;color:#4F46E5;border-radius:6px;font-size:12px;">
                                    <i class="fa-solid fa-pen"></i> <%- lan.Entry || 'Entry' %>
                                </a>
                                <a href="/schooladmin/exams/<%= e.id %>/report" class="btn btn-sm ms-1" style="background:#DCFCE7;color:#16A34A;border-radius:6px;font-size:12px;">
                                    <i class="fa-solid fa-chart-bar"></i> <%- lan.Report || 'Report' %>
                                </a>
                                <form action="/schooladmin/exams/<%= e.id %>/delete" method="POST" style="display:inline-block;" class="delete-exam-form m-0" data-confirm="<%- lan.Delete_Exam_Confirm || 'Delete this exam?' %>">
                                    <button type="submit" class="btn btn-sm ms-1" style="background:#FEE2E2;color:#DC2626;border-radius:6px;font-size:12px;border:none;">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<script>
    document.querySelectorAll('.delete-exam-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const confirmMsg = this.getAttribute('data-confirm');
            if (confirmMsg && !confirm(confirmMsg)) {
                e.preventDefault();
            }
        });
    });
</script>
