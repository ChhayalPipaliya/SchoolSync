<%- include('../../partials/head', { title: `${lan.Create_Exam || 'Create Exam'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/flashMessages') %>
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
        <div style="display:none">
            <div>
                <div style="font-size:18px;font-weight:700;color:#1E293B;"><%- lan.Create_Exam || 'Create Exam' %></div>
                <div style="font-size:12px;color:#94A3B8;">
                    <a href="/schooladmin/exams" style="color:#4F46E5;text-decoration:none;"><%- lan.Marks || 'Marks' %></a> → <%- lan.Create_Exam || 'Create Exam' %>
                </div>
            </div>
        </div>
        <div style="max-width:550px;">
            <div class="stat-card">
                <form action="/schooladmin/exams/add" method="POST">
                    <div style="font-size:14px;font-weight:600;color:#4F46E5;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid #E2E8F0;">
                        <i class="fa-solid fa-file-pen me-2"></i><%- lan.Exam_Information || 'Exam Information' %>
                    </div>
                    <div class="mb-3">
                        <label style="font-size:13px;font-weight:600;color:#374151;"><%- lan.Exam_Name || 'Exam Name' %> *</label>
                        <input type="text" name="name" required class="form-input mt-1" placeholder="<%- lan.Exam_Name_Placeholder || 'e.g. Mid Term, Final Exam' %>" style="border-radius:8px;font-size:14px;">
                    </div>
                    <div class="mb-3">
                        <label style="font-size:13px;font-weight:600;color:#374151;"><%- lan.Class || 'Class' %> *</label>
                        <select name="class_id" required class="form-select mt-1" style="border-radius:8px;font-size:14px;">
                            <option value="">-- <%- lan.Select_Class || 'Select Class' %> --</option>
                            <% (classes||[]).forEach(function(c) { %>
                                <option value="<%= c.id %>"><%= c.name %> - <%- lan.Section || 'Section' %> <%= c.section %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label style="font-size:13px;font-weight:600;color:#374151;"><%- lan.Start_Date || 'Start Date' %></label>
                            <input type="date" name="start_date" class="form-input mt-1" style="border-radius:8px;font-size:14px;">
                        </div>
                        <div class="col-md-6">
                            <label style="font-size:13px;font-weight:600;color:#374151;"><%- lan.End_Date || 'End Date' %></label>
                            <input type="date" name="end_date" class="form-input mt-1" style="border-radius:8px;font-size:14px;">
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn text-white" style="background:#4F46E5;border-radius:8px;padding:10px 24px;font-size:14px;font-weight:600;">
                            <i class="fa-solid fa-plus me-1"></i> <%- lan.Create_Exam || 'Create Exam' %>
                        </button>
                        <a href="/schooladmin/exams" class="btn" style="background:#F1F5F9;color:#64748B;border-radius:8px;padding:10px 24px;font-size:14px;font-weight:600;"><%- lan.Cancel || 'Cancel' %></a>
                    </div>
                </form>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

