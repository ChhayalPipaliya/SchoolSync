<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/flashMessages') %>
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
        <div style="display:none">
            <div>
                <div style="font-size:18px;font-weight:700;color:#1E293B;">Create Exam</div>
                <div style="font-size:12px;color:#94A3B8;">
                    <a href="/schooladmin/exams" style="color:#4F46E5;text-decoration:none;">Marks</a> → Create Exam
                </div>
            </div>
        </div>
        <div style="max-width:550px;">
            <div class="stat-card">
                <form action="/schooladmin/exams/add" method="POST">
                    <div style="font-size:14px;font-weight:600;color:#4F46E5;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid #E2E8F0;">
                        <i class="fa-solid fa-file-pen me-2"></i>Exam Information
                    </div>
                    <div class="mb-3">
                        <label style="font-size:13px;font-weight:600;color:#374151;">Exam Name *</label>
                        <input type="text" name="name" required class="form-input mt-1" placeholder="e.g. Mid Term, Final Exam" style="border-radius:8px;font-size:14px;">
                    </div>
                    <div class="mb-3">
                        <label style="font-size:13px;font-weight:600;color:#374151;">Class *</label>
                        <select name="class_id" required class="form-select mt-1" style="border-radius:8px;font-size:14px;">
                            <option value="">-- Select Class --</option>
                            <% classes.forEach(function(c) { %>
                                <option value="<%= c.id %>"><%= c.name %> - Section <%= c.section %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label style="font-size:13px;font-weight:600;color:#374151;">Start Date</label>
                            <input type="date" name="start_date" class="form-input mt-1" style="border-radius:8px;font-size:14px;">
                        </div>
                        <div class="col-md-6">
                            <label style="font-size:13px;font-weight:600;color:#374151;">End Date</label>
                            <input type="date" name="end_date" class="form-input mt-1" style="border-radius:8px;font-size:14px;">
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn text-white" style="background:#4F46E5;border-radius:8px;padding:10px 24px;font-size:14px;font-weight:600;">
                            <i class="fa-solid fa-plus me-1"></i> Create Exam
                        </button>
                        <a href="/schooladmin/exams" class="btn" style="background:#F1F5F9;color:#64748B;border-radius:8px;padding:10px 24px;font-size:14px;font-weight:600;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>  
<%- include('../../partials/footer') %>
