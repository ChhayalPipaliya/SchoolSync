<%- include('../../partials/head', { title: `${lan.Teacher_Monthly_Attendance || 'Teacher Monthly Attendance'} | SchoolSync` }) %>
<%- include('../../partials/attendanceCss') %>
<style>
    .btn-compact {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        white-space: nowrap !important;
        padding: 7px 14px !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
        line-height: 1.4 !important;
    }

    @media (max-width: 639.98px) {
        .monthly-header-actions {
            width: 100% !important;
        }
        .monthly-header-actions .btn-compact {
            flex: 1 !important;
            text-align: center !important;
        }
    }

    [data-theme="dark"] .table-header,
    .light-mode-disabled .table-header,
    html.dark .table-header {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .card,
    .light-mode-disabled .card,
    html.dark .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .text-gray-800,
    .light-mode-disabled .text-gray-800,
    html.dark .text-gray-800 {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .btn-secondary,
    .light-mode-disabled .btn-secondary,
    html.dark .btn-secondary {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .form-input,
    .light-mode-disabled .form-input,
    html.dark .form-input {
        background: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-6">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Teacher_Monthly_Attendance || 'Teacher Monthly Attendance' %></h2>
                    <p class="text-xs text-gray-500 mt-1 flex items-center gap-1.5">
                        <i class="fa-regular fa-calendar text-gray-400"></i>
                        <span><%= month %> — <%- lan.All_Teaching_Staff || 'All Teaching Staff' %></span>
                    </p>
                </div>
                <div class="flex items-center gap-2 monthly-header-actions">
                    <a href="/schooladmin/attendance/teachers/mark" class="btn btn-secondary btn-compact text-slate-700 shadow-xs">
                        <i class="fa-solid fa-pen-to-square text-emerald-600 mr-1.5"></i> <%- lan.Mark_Attendance || 'Mark Attendance' %>
                    </a>
                    <a href="/schooladmin/attendance" class="btn btn-secondary btn-compact text-slate-700 shadow-xs">
                        <i class="fa-solid fa-arrow-left text-slate-500 mr-1.5"></i> <%- lan.Back || 'Back' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card p-4 sm:p-5 mb-6 shadow-xs border border-slate-200 rounded-xl">
                <form method="GET" class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
                    <div class="form-group mb-0 sm:col-span-2">
                        <label class="form-label font-bold text-[11px] text-slate-400 uppercase tracking-wider mb-2 block">
                            <i class="fa-regular fa-calendar-days mr-1 text-slate-400"></i> <%- lan.Month || 'Month' %>
                        </label>
                        <input type="month" name="month" value="<%= month %>" class="form-input w-full rounded-lg border-slate-300 text-sm font-medium">
                    </div>
                    <button type="submit" class="btn btn-primary w-full shadow-xs border-0" style="background: #059669; padding: 9px 18px !important; font-weight: 700; border-radius: 8px;">
                        <i class="fa-solid fa-chart-simple mr-1.5"></i> <%- lan.View_Report || 'View Report' %>
                    </button>
                </form>
            </div>
            <div class="card p-0 overflow-hidden shadow-xs border border-slate-200 rounded-xl">
                <div class="table-header p-3.5 sm:p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 bg-slate-50/50 border-b border-slate-100">
                    <div>
                        <span class="font-bold text-gray-800 text-sm sm:text-base"><%- lan.All_Teachers || 'All Teachers' %></span>
                        <span class="text-xs text-gray-400 ml-2"><%= month %> — <%= (teachers||[]).length %> <%- lan.Staff || 'staff' %></span>
                    </div>
                    <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-[11px] font-bold text-gray-500">
                        <span class="inline-flex items-center gap-1.5"><span class="att-dot p">P</span> <%- lan.Present || 'Present' %></span>
                        <span class="inline-flex items-center gap-1.5"><span class="att-dot a">A</span> <%- lan.Absent || 'Absent' %></span>
                        <span class="inline-flex items-center gap-1.5"><span class="att-dot h">H</span> <%- lan.Half_Day || 'Half Day' %></span>
                        <span class="inline-flex items-center gap-1.5"><span class="att-dot lv">LV</span> <%- lan.Leave || 'Leave' %></span>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <%- include('../../partials/monthlyGrid', { people: teachers, attendanceMap, days, nameLabel: (lan.Teacher || 'Teacher') }) %>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
