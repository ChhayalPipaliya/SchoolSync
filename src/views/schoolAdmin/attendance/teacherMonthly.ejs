<%- include('../../partials/head', { title: `${lan.Teacher_Monthly_Attendance || 'Teacher Monthly Attendance'} | SchoolSync` }) %>
<%- include('../../partials/attendanceCss') %>
<style>
    .btn-compact {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        white-space: nowrap !important;
        padding: 7px 14px !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
        line-height: 1.4 !important;
    }

    @media (max-width: 639.98px) {
        .monthly-header-actions {
            width: 100% !important;
        }
        .monthly-header-actions .btn-compact {
            flex: 1 !important;
            text-align: center !important;
        }
    }

    [data-theme="dark"] .table-header,
    .light-mode-disabled .table-header,
    html.dark .table-header {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .card,
    .light-mode-disabled .card,
    html.dark .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .text-gray-800,
    .light-mode-disabled .text-gray-800,
    html.dark .text-gray-800 {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .btn-secondary,
    .light-mode-disabled .btn-secondary,
    html.dark .btn-secondary {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .form-input,
    .light-mode-disabled .form-input,
    html.dark .form-input {
        background: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Teacher_Monthly_Attendance || 'Teacher Monthly Attendance' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%= month %> &bull; <%- lan.All_Teaching_Staff || 'All Teaching Staff' %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <a href="/schooladmin/attendance/teachers/mark" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fa-solid fa-pen-to-square"></i> <%- lan.Mark_Attendance || 'Mark Attendance' %>
                        </a>
                        <a href="/schooladmin/attendance" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back || 'Back' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card" style="border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                <form method="GET" style="display: flex; align-items: flex-end; gap: 10px; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                            <%- lan.Month || 'Month' %>
                        </label>
                        <input type="month" name="month" value="<%= month %>" class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px; width: 100%;">
                    </div>
                    <button type="submit" class="btn" style="background: #059669; color: #fff; height: 34px; padding: 0 16px; font-size: 11px; font-weight: 700; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px; border: none; cursor: pointer;">
                        <i class="fa-solid fa-chart-simple"></i> <%- lan.View_Report || 'View Report' %>
                    </button>
                </form>
            </div>
            <div class="card p-0 overflow-hidden shadow-xs border border-slate-200 rounded-xl">
                <div class="table-header p-3.5 sm:p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 bg-slate-50/50 border-b border-slate-100">
                    <div>
                        <span class="font-bold text-gray-800 text-sm sm:text-base"><%- lan.All_Teachers || 'All Teachers' %></span>
                        <span class="text-xs text-gray-400 ml-2"><%= month %> — <%= (teachers||[]).length %> <%- lan.Staff || 'staff' %></span>
                    </div>
                    <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-[11px] font-bold text-gray-500">
                        <span class="inline-flex items-center gap-1.5"><span class="att-dot p">P</span> <%- lan.Present || 'Present' %></span>
                        <span class="inline-flex items-center gap-1.5"><span class="att-dot a">A</span> <%- lan.Absent || 'Absent' %></span>
                        <span class="inline-flex items-center gap-1.5"><span class="att-dot h">H</span> <%- lan.Half_Day || 'Half Day' %></span>
                        <span class="inline-flex items-center gap-1.5"><span class="att-dot lv">LV</span> <%- lan.Leave || 'Leave' %></span>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <%- include('../../partials/monthlyGrid', { people: teachers, attendanceMap, days, nameLabel: (lan.Teacher || 'Teacher') }) %>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>