<%- include('../../partials/head', { title: `${lan.Attendance_Report || 'Attendance Report'} | SchoolSync` }) %>
<style>
    @media (max-width: 768px) {
        .schooladmin-theme .content {
            padding: 12px 10px !important;
        }
        .att-report-header {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 12px !important;
        }
        .att-report-header a.btn {
            width: 100% !important;
            justify-content: center !important;
        }
        .att-report-form button[type="submit"] {
            width: 100% !important;
        }
        .table-container table {
            min-width: 680px !important;
        }
        .table-container th,
        .table-container td {
            padding: 10px 12px !important;
            font-size: 12px !important;
            white-space: nowrap !important;
        }
    }

    [data-theme="dark"] .table-card,
    .light-mode-disabled .table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table-header-row,
    .light-mode-disabled .table-header-row {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Attendance_Report || 'Attendance Report' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Attendance_Report_Desc || 'Generate and analyze student monthly attendance performance' %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <a href="/schooladmin/attendance/mark" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fa-solid fa-pen-to-square"></i> <%- lan.Mark_Attendance || 'Mark Attendance' %>
                        </a>
                        <a href="/schooladmin/attendance" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back || 'Back' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card" style="border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                <form method="GET" class="att-report-form grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Class_Room || 'Class Room' %> *</label>
                        <select name="class_id" required class="form-select" onchange="this.form.submit()">
                            <option value=""><%- lan.Select_Class || 'Select Class' %></option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>" <%= filters.class_id == c.id ? 'selected' : '' %>><%= c.label || (c.class_name + (c.stream && c.stream !== 'General' ? ' - ' + c.stream : '') + ' - ' + c.section) %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% if (typeof sections !== 'undefined' && sections && sections.length > 0) { %>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Section || 'Section' %></label>
                        <select name="section_id" class="form-select" onchange="this.form.submit()">
                            <option value=""><%- lan.All_Sections || 'All Sections' %></option>
                            <% sections.forEach(sec => { %>
                                <option value="<%= sec.id %>" <%= filters.section_id == sec.id ? 'selected' : '' %>><%= sec.section %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Month || 'Month' %></label>
                        <input type="number" name="month" value="<%= filters.month || new Date().getMonth() + 1 %>" min="1" max="12" class="form-input">
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Year || 'Year' %></label>
                        <input type="number" name="year" value="<%= filters.year || new Date().getFullYear() %>" class="form-input">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <%- lan.Generate || 'Generate' %>
                    </button>
                </form>
            </div>
            <% if (report && report.length > 0) { %>
                <div class="table-card">
                    <div class="table-header-row bg-slate-50/20">
                        <h4 class="table-heading uppercase tracking-wider"><%- lan.Student_Performance_Metrics || 'Student Performance metrics' %></h4>
                    </div>
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th style="width: 100px;"><%- lan.Roll_No || 'Roll No' %></th>
                                    <th><%- lan.Student || 'Student' %></th>
                                    <th class="text-center"><%- lan.Total_Days || 'Total Days' %></th>
                                    <th class="text-center"><%- lan.Present || 'Present' %></th>
                                    <th class="text-center"><%- lan.Absent || 'Absent' %></th>
                                    <th class="text-center"><%- lan.Percentage || 'Percentage' %></th>
                                    <th class="text-center"><%- lan.Status || 'Status' %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% report.forEach(r => { %>
                                    <tr>
                                        <td class="font-bold text-gray-800"><%= r.roll_number || '—' %></td>
                                        <td class="font-bold text-gray-800"><%= r.first_name %> <%= r.last_name %></td>
                                        <td class="text-center font-semibold text-gray-600"><%= r.total_days %></td>
                                        <td class="text-center font-bold text-emerald-600"><%= r.present_days %></td>
                                        <td class="text-center font-bold text-rose-600"><%= r.absent_days %></td>
                                        <td class="text-center font-bold text-gray-800"><%= r.percentage %>%</td>
                                        <td class="text-center">
                                            <% if (r.percentage >= 75) { %>
                                                <span class="badge badge-success"><%- lan.Good || 'Good' %></span>
                                            <% } else if (r.percentage >= 50) { %>
                                                <span class="badge badge-warning"><%- lan.Warning || 'Warning' %></span>
                                            <% } else { %>
                                                <span class="badge badge-danger"><%- lan.Critical || 'Critical' %></span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="card p-8 text-center text-gray-500">
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-chart-bar"></i></div>
                        <h4 class="empty-state-title"><%- lan.Select_Parameters || 'Select parameters' %></h4>
                        <p class="empty-state-text"><%- lan.Choose_Class_Month_Report_Desc || 'Choose class and month to generate and review the attendance report.' %></p>
                    </div>
                </div>
            <% } %>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>