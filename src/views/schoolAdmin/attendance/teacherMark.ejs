<%- include('../../partials/head', { title: `${lan.Teacher_Attendance || 'Teacher Attendance'} | SchoolSync` }) %>
<style>
    .attendance-options {
        display: flex;
        gap: 8px;
        justify-content: center;
        align-items: center;
        width: 100%;
        flex-wrap: wrap;
    }

    .attendance-option {
        cursor: pointer;
        user-select: none;
        position: relative;
        display: inline-flex;
        align-items: center;
        margin: 0;
    }

    .attendance-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
    }

    .attendance-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 82px;
        gap: 5px;
        padding: 7px 12px;
        border-radius: 9999px;
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #64748B;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.2;
        transition: all 0.15s ease-in-out;
        text-align: center;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        box-sizing: border-box;
    }

    .attendance-pill::before {
        content: "";
        width: 11px;
        height: 11px;
        border-radius: 9999px;
        border: 2px solid currentColor;
        background: transparent;
        flex-shrink: 0;
        transition: transform 0.15s ease;
    }

    .attendance-option:hover .attendance-pill {
        border-color: #94A3B8;
        color: #334155;
        background: #F8FAFC;
    }

    .attendance-option input:checked+.attendance-pill {
        color: #FFFFFF;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
    }

    .attendance-option input:checked+.attendance-pill::before {
        content: "\2713";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-color: rgba(255, 255, 255, 0.95);
        background: rgba(255, 255, 255, 0.25);
        font-size: 9px;
        font-weight: 900;
    }

    .attendance-option input[value="present"]:checked+.attendance-pill {
        background: #059669;
        border-color: #047857;
    }

    .attendance-option input[value="absent"]:checked+.attendance-pill {
        background: #E11D48;
        border-color: #BE123C;
    }

    .attendance-option input[value="half-day"]:checked+.attendance-pill {
        background: #D97706;
        border-color: #B45309;
    }

    .attendance-option input[value="leave"]:checked+.attendance-pill {
        background: #2563EB;
        border-color: #1D4ED8;
    }

    .attendance-option input[value="late"]:checked+.attendance-pill {
        background: #7C3AED;
        border-color: #6D28D9;
    }

    .btn-compact {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        white-space: nowrap !important;
        padding: 7px 14px !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
        line-height: 1.4 !important;
    }

    .teacher-meta-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        flex: 1;
    }

    .teacher-avatar {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        background: #F1F5F9;
        border: 1.5px solid #E2E8F0;
    }

    .teacher-info-text {
        min-width: 0;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .teacher-name-text {
        font-size: 14.5px;
        font-weight: 700;
        color: #1E293B;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .teacher-email-text {
        font-size: 12px;
        color: #64748B;
        line-height: 1.2;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .teacher-index-badge {
        padding: 4px 8px;
        border-radius: 8px;
        font-size: 11.5px;
        font-weight: 700;
        background: #F1F5F9;
        color: #475569;
        border: 1px solid #E2E8F0;
        flex-shrink: 0;
    }

    .attendance-save-desktop-bar {
        display: flex;
        justify-content: flex-end;
        margin-top: 16px;
    }

    @media (max-width: 767.98px) {
        .attendance-header-actions {
            width: 100% !important;
        }
        .attendance-header-actions .btn-compact {
            flex: 1 !important;
            text-align: center !important;
        }

        .attendance-bulk-bar {
            width: 100% !important;
            margin-bottom: 12px !important;
        }
        .attendance-bulk-left {
            display: flex !important;
            width: 100% !important;
            gap: 8px !important;
        }
        .attendance-bulk-left .btn-compact {
            flex: 1 !important;
            padding: 9px 10px !important;
            font-size: 12.5px !important;
        }

        .attendance-table-card,
        .attendance-table-card .table-container {
            overflow: visible !important;
            width: 100% !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }

        .table-container>table.attendance-responsive-table {
            min-width: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            display: flex !important;
            flex-direction: column !important;
            gap: 12px !important;
        }

        .attendance-responsive-table tbody {
            display: flex !important;
            flex-direction: column !important;
            gap: 12px !important;
            width: 100% !important;
            min-width: 0 !important;
        }

        .attendance-responsive-table thead,
        .attendance-responsive-table td.desktop-index-cell,
        .attendance-responsive-table td.desktop-email-cell {
            display: none !important;
        }

        .attendance-responsive-table tr.attendance-row-card {
            display: flex !important;
            flex-direction: column !important;
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            padding: 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
            gap: 12px;
            width: 100% !important;
            box-sizing: border-box !important;
            min-width: 0 !important;
        }

        .attendance-responsive-table td {
            display: block !important;
            padding: 0 !important;
            border: none !important;
            width: 100% !important;
            min-width: 0 !important;
        }

        .attendance-responsive-table td.staff-cell {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            gap: 10px !important;
            width: 100% !important;
        }

        .attendance-responsive-table td.status-cell {
            border-top: 1px dashed #E2E8F0 !important;
            padding-top: 12px !important;
            width: 100% !important;
        }

        .attendance-options {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 8px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        .attendance-option {
            display: flex !important;
            width: 100% !important;
            min-width: 0 !important;
            box-sizing: border-box !important;
        }

        .attendance-pill {
            width: 100% !important;
            min-width: 0 !important;
            box-sizing: border-box !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 9px 8px !important;
            font-size: 12px !important;
            font-weight: 700 !important;
            border-radius: 10px !important;
            text-align: center !important;
        }

        .attendance-save-desktop-bar {
            display: none !important;
        }
    }

    .mobile-sticky-bar {
        display: none;
    }

    @media (max-width: 767.98px) {
        .mobile-sticky-bar {
            display: block;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-top: 1px solid #E2E8F0;
            padding: 10px 16px;
            z-index: 99;
            box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
        }

        .main-panel-content-padding {
            padding-bottom: 84px !important;
        }
    }

    [data-theme="dark"] .text-gray-800,
    .light-mode-disabled .text-gray-800,
    html.dark .text-gray-800 {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .card,
    .light-mode-disabled .card,
    html.dark .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .form-input,
    .light-mode-disabled .form-input,
    html.dark .form-input {
        background: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .teacher-avatar,
    .light-mode-disabled .teacher-avatar,
    html.dark .teacher-avatar {
        background: #101726 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .teacher-name-text,
    .light-mode-disabled .teacher-name-text,
    html.dark .teacher-name-text {
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .teacher-email-text,
    .light-mode-disabled .teacher-email-text,
    html.dark .teacher-email-text {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .teacher-index-badge,
    .light-mode-disabled .teacher-index-badge,
    html.dark .teacher-index-badge {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .attendance-pill,
    .light-mode-disabled .attendance-pill,
    html.dark .attendance-pill {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .attendance-option:hover .attendance-pill,
    .light-mode-disabled .attendance-option:hover .attendance-pill,
    html.dark .attendance-option:hover .attendance-pill {
        background: #242F4D !important;
        border-color: #475569 !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .attendance-option input[value="present"]:checked+.attendance-pill,
    .light-mode-disabled .attendance-option input[value="present"]:checked+.attendance-pill,
    html.dark .attendance-option input[value="present"]:checked+.attendance-pill {
        background: #059669 !important;
        border-color: #10B981 !important;
        color: #FFFFFF !important;
    }

    [data-theme="dark"] .attendance-option input[value="absent"]:checked+.attendance-pill,
    .light-mode-disabled .attendance-option input[value="absent"]:checked+.attendance-pill,
    html.dark .attendance-option input[value="absent"]:checked+.attendance-pill {
        background: #E11D48 !important;
        border-color: #F43F5E !important;
        color: #FFFFFF !important;
    }

    [data-theme="dark"] .attendance-option input[value="half-day"]:checked+.attendance-pill,
    .light-mode-disabled .attendance-option input[value="half-day"]:checked+.attendance-pill,
    html.dark .attendance-option input[value="half-day"]:checked+.attendance-pill {
        background: #D97706 !important;
        border-color: #F59E0B !important;
        color: #FFFFFF !important;
    }

    [data-theme="dark"] .attendance-option input[value="leave"]:checked+.attendance-pill,
    .light-mode-disabled .attendance-option input[value="leave"]:checked+.attendance-pill,
    html.dark .attendance-option input[value="leave"]:checked+.attendance-pill {
        background: #2563EB !important;
        border-color: #3B82F6 !important;
        color: #FFFFFF !important;
    }

    [data-theme="dark"] .attendance-option input[value="late"]:checked+.attendance-pill,
    .light-mode-disabled .attendance-option input[value="late"]:checked+.attendance-pill,
    html.dark .attendance-option input[value="late"]:checked+.attendance-pill {
        background: #7C3AED !important;
        border-color: #8B5CF6 !important;
        color: #FFFFFF !important;
    }

    [data-theme="dark"] .attendance-table-card,
    .light-mode-disabled .attendance-table-card,
    html.dark .attendance-table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .attendance-responsive-table thead th,
    .light-mode-disabled .attendance-responsive-table thead th,
    html.dark .attendance-responsive-table thead th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .attendance-responsive-table tbody tr.attendance-row-card,
    .light-mode-disabled .attendance-responsive-table tbody tr.attendance-row-card,
    html.dark .attendance-responsive-table tbody tr.attendance-row-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .attendance-responsive-table tbody tr:hover,
    .light-mode-disabled .attendance-responsive-table tbody tr:hover,
    html.dark .attendance-responsive-table tbody tr:hover {
        background: #19233A !important;
    }

    [data-theme="dark"] .attendance-responsive-table td.status-cell,
    .light-mode-disabled .attendance-responsive-table td.status-cell,
    html.dark .attendance-responsive-table td.status-cell {
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .btn-secondary,
    .light-mode-disabled .btn-secondary,
    html.dark .btn-secondary {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .mobile-sticky-bar,
    .light-mode-disabled .mobile-sticky-bar,
    html.dark .mobile-sticky-bar {
        background: rgba(21, 29, 48, 0.95) !important;
        border-color: #242F4D !important;
    }

    @media (max-width: 767.98px) {
        [data-theme="dark"] .attendance-responsive-table tr.attendance-row-card,
        .light-mode-disabled .attendance-responsive-table tr.attendance-row-card,
        html.dark .attendance-responsive-table tr.attendance-row-card {
            background: #151D30 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .attendance-responsive-table td.status-cell,
        .light-mode-disabled .attendance-responsive-table td.status-cell,
        html.dark .attendance-responsive-table td.status-cell {
            border-top: 1px dashed #242F4D !important;
        }

        [data-theme="dark"] .teacher-index-badge,
        .light-mode-disabled .teacher-index-badge,
        html.dark .teacher-index-badge {
            background: #1E293B !important;
            border-color: #334155 !important;
            color: #CBD5E1 !important;
        }
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content main-panel-content-padding" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Teacher_Attendance || 'Teacher Attendance' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;">
                                <i class="fa-regular fa-calendar" style="margin-right: 4px;"></i>
                                <%- lan.Date || 'Date' %>: <%= new Date(date).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                            </p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <a href="/schooladmin/attendance" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back || 'Back' %>
                        </a>
                        <a href="/schooladmin/attendance/teachers/monthly" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-calendar-days"></i> <%- lan.Monthly_View || 'Monthly View' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <% const activeTeachers = (teachers || []).filter(t => !!t.teacher_id); %>
            <div class="card" style="border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-3">
                    <form method="GET" action="/schooladmin/attendance/teachers/mark" id="dateFilterForm" class="flex-shrink-0 w-full sm:w-auto">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-[11px] text-slate-400 uppercase tracking-wider mb-2 block">
                                <i class="fa-regular fa-calendar-check mr-1 text-slate-400"></i> <%- lan.Date || 'Date' %>
                            </label>
                            <input type="date" name="date" value="<%= date %>" max="<%= new Date().toISOString().slice(0,10) %>" class="form-input w-full sm:w-56 rounded-lg border-slate-300 text-sm font-medium" style="height: 34px; font-size: 11px;" onchange="this.form.submit()">
                        </div>
                    </form>
                    <% if (activeTeachers && activeTeachers.length > 0) { %>
                        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 w-full md:w-auto justify-start md:justify-end">
                            <button type="button" onclick="markAll('present')" class="btn btn-secondary btn-compact text-slate-700 shadow-xs border border-slate-300 hover:bg-slate-50" style="height: 34px;">
                                <i class="fa-solid fa-user-check text-emerald-600 mr-1.5"></i><%- lan.Mark_All_Present || 'Mark All Present' %>
                            </button>
                            <button type="button" onclick="markAll('absent')" class="btn btn-secondary btn-compact text-slate-700 shadow-xs border border-slate-300 hover:bg-slate-50" style="height: 34px;">
                                <i class="fa-solid fa-user-xmark text-rose-600 mr-1.5"></i><%- lan.Mark_All_Absent || 'Mark All Absent' %>
                            </button>
                            <button type="submit" form="attendanceForm" <% if (typeof lockStatus !== 'undefined' && lockStatus.isLocked) { %> disabled <% } %> class="btn btn-primary btn-compact text-white shadow-xs border-0" style="background: #059669; padding: 0 16px !important; height: 34px; font-size: 11px !important; font-weight: 700;">
                                <i class="fa-solid fa-floppy-disk mr-1.5"></i> <%- lan.Save_Attendance || 'Save Attendance' %>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
            <% if (activeTeachers && activeTeachers.length > 0) { %>
                <% if (typeof lockStatus !== 'undefined' && lockStatus.isLocked) { %>
                    <div class="bg-rose-50 border border-rose-300 rounded-xl p-3.5 sm:p-4 mb-4 flex items-start sm:items-center gap-3">
                        <i class="fas fa-ban text-rose-600 text-lg mt-0.5 sm:mt-0 flex-shrink-0"></i>
                        <div>
                            <span class="font-bold text-rose-900 text-sm block"><%- lan.Attendance_Locked || 'Attendance Locked' %></span>
                            <p class="text-xs text-rose-700 m-0 mt-0.5"><%= lockStatus.reason || (lan.Attendance_Locked_Default_Reason || 'Attendance cannot be marked for this date.') %></p>
                        </div>
                    </div>
                <% } else if (typeof lockStatus !== 'undefined' && lockStatus.requiresReason) { %>
                    <div class="bg-amber-50/80 border border-amber-300 rounded-xl p-3.5 sm:p-4 mb-4 flex items-start sm:items-center gap-3">
                        <i class="fas fa-lock text-amber-600 text-lg mt-0.5 sm:mt-0 flex-shrink-0"></i>
                        <div>
                            <span class="font-bold text-amber-900 text-sm block"><%- lan.Attendance_Cutoff_Warning || 'Attendance Cutoff / Past Date Editing' %></span>
                            <p class="text-xs text-amber-700 m-0 mt-0.5"><%- lan.Attendance_Cutoff_Desc || 'You are editing attendance past the daily cutoff time or for a past date. Please provide a reason below for the audit log.' %></p>
                        </div>
                    </div>
                <% } %>
                <form method="POST" action="/schooladmin/attendance/teachers/mark" id="attendanceForm">
                    <input type="hidden" name="date" value="<%= date %>">
                    <% if (typeof lockStatus !== 'undefined' && lockStatus.requiresReason) { %>
                        <div class="mb-4 bg-white p-4 rounded-xl border border-amber-200 shadow-xs">
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5"><%- lan.Unlock_Modification_Reason || 'Unlock / Modification Reason' %> <span class="text-red-500">*</span></label>
                            <input type="text" name="unlock_reason" required placeholder="<%- lan.Unlock_Reason_Placeholder || 'e.g. Approved leave update by Admin, System sync request...' %>" class="w-full text-sm border-gray-300 rounded-lg focus:ring-amber-500 focus:border-amber-500" style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; width: 100%;">
                        </div>
                    <% } %>
                    <div class="table-card attendance-table-card">
                        <div class="table-container">
                            <table class="data-table attendance-responsive-table w-full">
                                <thead>
                                    <tr>
                                        <th style="width: 60px;" class="text-left py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">#</th>
                                        <th class="text-left py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500"><%- lan.Teacher_Info || 'Teacher Info' %></th>
                                        <th class="text-left py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500"><%- lan.Email || 'Email' %></th>
                                        <th class="text-center py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500"><%- lan.Status_Selection || 'Status Selection' %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% activeTeachers.forEach((t, i) => { 
                                        let displayPhoto = '/images/default-avatar.svg';
                                        if (t.photo) {
                                            displayPhoto = t.photo.startsWith('/uploads/') ? t.photo : '/uploads/teachers/' + t.photo;
                                        }
                                        const curStatus = (t.attendanceStatus || '').toLowerCase().trim();
                                        const isPresent = curStatus ? (curStatus === 'present' || curStatus === 'p') : true;
                                        const isAbsent = curStatus === 'absent' || curStatus === 'a';
                                        const isHalfDay = curStatus === 'half-day' || curStatus === 'half_day' || curStatus === 'h';
                                        const isLeave = curStatus === 'leave' || curStatus === 'lv' || curStatus === 'paid_leave' || curStatus === 'medical_leave';
                                    %>
                                        <tr class="attendance-row-card">
                                            <td class="desktop-index-cell font-bold text-slate-700">
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 text-xs font-bold border border-slate-200 teacher-index-badge">
                                                    <%= i + 1 %>
                                                </span>
                                            </td>
                                            <td class="staff-cell">
                                                <div class="teacher-meta-wrap">
                                                    <img src="<%= displayPhoto %>" onerror="this.onerror=null; this.src='/images/default-avatar.svg';" alt="<%= t.first_name %>" class="teacher-avatar">
                                                    <div class="teacher-info-text">
                                                        <span class="teacher-name-text"><%= t.first_name %> <%= t.last_name %></span>
                                                        <span class="teacher-email-text"><%= t.email || '—' %></span>
                                                    </div>
                                                </div>
                                                <span class="md:hidden teacher-index-badge">#<%= i + 1 %></span>
                                            </td>
                                            <td class="desktop-email-cell text-slate-500 font-medium text-xs teacher-email-text"><%= t.email || '—' %></td>
                                            <td class="status-cell">
                                                <div class="attendance-options">
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[teacher_<%= t.teacher_id %>]" value="present" <%= isPresent ? 'checked' : '' %>>
                                                        <span class="attendance-pill"><%- lan.Present || 'Present' %></span>
                                                    </label>
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[teacher_<%= t.teacher_id %>]" value="absent" <%= isAbsent ? 'checked' : '' %>>
                                                        <span class="attendance-pill"><%- lan.Absent || 'Absent' %></span>
                                                    </label>
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[teacher_<%= t.teacher_id %>]" value="half-day" <%= isHalfDay ? 'checked' : '' %>>
                                                        <span class="attendance-pill"><%- lan.Half_Day || 'Half Day' %></span>
                                                    </label>
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[teacher_<%= t.teacher_id %>]" value="leave" <%= isLeave ? 'checked' : '' %>>
                                                        <span class="attendance-pill"><%- lan.Leave || 'Leave' %></span>
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="attendance-save-desktop-bar">
                        <button type="submit" <% if (typeof lockStatus !== 'undefined' && lockStatus.isLocked) { %> disabled <% } %> class="btn btn-primary btn-compact text-white shadow-xs border-0" style="background: #059669; padding: 10px 24px !important; font-size: 13.5px !important;">
                            <i class="fa-solid fa-floppy-disk mr-1.5"></i> <%- lan.Save_Attendance || 'Save Attendance' %> (<%= activeTeachers.length %> <%- lan.Teachers || 'Teachers' %>)
                        </button>
                    </div>
                    <div class="mobile-sticky-bar">
                        <button type="submit" <% if (typeof lockStatus !== 'undefined' && lockStatus.isLocked) { %> disabled <% } %> class="btn btn-primary w-full py-2.5 text-sm font-bold shadow-lg rounded-xl flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white border-0">
                            <i class="fa-solid fa-floppy-disk"></i> <%- lan.Save_Attendance || 'Save Attendance' %> (<%= activeTeachers.length %> <%- lan.Teachers || 'Teachers' %>)
                        </button>
                    </div>
                </form>
            <% } else { %>
                <div class="card p-8 text-center text-gray-500 rounded-xl shadow-xs">
                    <div class="empty-state">
                        <div class="empty-state-icon text-4xl text-slate-300 mb-3"><i class="fas fa-chalkboard-user"></i></div>
                        <h4 class="empty-state-title font-bold text-gray-700 text-lg"><%- lan.No_Teachers_Found || 'No teachers found' %></h4>
                        <p class="empty-state-text text-sm text-gray-500 mt-1"><%- lan.No_Teachers_Desc || 'There are no active teachers registered in this school.' %></p>
                    </div>
                </div>
            <% } %>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script>
    function markAll(status) {
        document.querySelectorAll('input[type="radio"][value="' + status + '"]').forEach(r => r.checked = true);
    };
</script>