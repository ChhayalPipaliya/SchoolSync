<%- include('../../partials/head') %>
<%- include('../../partials/attendanceCss') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex justify-between items-center mb-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Driver Attendance</h2>
                    <p class="text-xs text-gray-500 mt-1">Mark attendance for transport staff — <%= date %></p>
                </div>
                <div class="flex gap-2">
                    <a href="/schooladmin/attendance/drivers/monthly" class="btn btn-secondary text-xs flex items-center gap-1.5">
                        <i class="fa-solid fa-calendar-days"></i> Monthly View
                    </a>
                    <a href="/schooladmin/attendance" class="btn btn-secondary text-xs flex items-center gap-1.5">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card p-4 mb-4">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="flex flex-wrap items-center gap-4">
                        <div class="flex items-center gap-2">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-0 whitespace-nowrap">Date</label>
                            <input type="date" value="<%= date %>" max="<%= new Date().toISOString().slice(0,10) %>" class="form-input text-xs py-1.5" style="width: auto;" onchange="window.location.href='/schooladmin/attendance/drivers/mark?date=' + this.value">
                        </div>
                        <% if (drivers && drivers.length > 0) { %>
                            <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="markAll('present')" class="btn btn-secondary btn-sm py-1.5 text-xs font-bold whitespace-nowrap">Mark All Present</button>
                                <button type="button" onclick="markAll('absent')" class="btn btn-secondary btn-sm py-1.5 text-xs font-bold whitespace-nowrap">Mark All Absent</button>
                            </div>
                        <% } %>
                    </div>
                    <% if (drivers && drivers.length > 0) { %>
                        <div>
                            <button type="submit" form="driverAttendanceForm" class="btn btn-primary px-6 py-2 text-xs font-bold whitespace-nowrap">Save Attendance</button>
                        </div>
                    <% } %>
                </div>
            </div>
            <% if (drivers && drivers.length > 0) { %>
                <% if (typeof lockStatus !== 'undefined' && lockStatus.requiresReason) { %>
                    <div style="background: #fffbeeb0; border: 1px solid #fcd34d; border-radius: 12px; padding: 14px 18px; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
                        <i class="fas fa-lock text-amber-600 text-lg"></i>
                        <div>
                            <span class="font-bold text-amber-900 text-sm">Attendance Cutoff / Past Date Editing</span>
                            <p class="text-xs text-amber-700 m-0">You are editing attendance past the daily cutoff time or for a past date. Please provide a reason below for the audit log.</p>
                        </div>
                    </div>
                <% } %>
                <form id="driverAttendanceForm" method="POST" action="/schooladmin/attendance/drivers/mark">
                    <input type="hidden" name="date" value="<%= date %>">
                    <% if (typeof lockStatus !== 'undefined' && lockStatus.requiresReason) { %>
                        <div class="mb-4 bg-white p-4 rounded-xl border border-amber-200 shadow-sm">
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Unlock / Modification Reason <span class="text-red-500">*</span></label>
                            <input type="text" name="unlock_reason" required placeholder="e.g. Approved leave update by Admin, System sync request..." class="w-full text-sm border-gray-300 rounded-lg focus:ring-amber-500 focus:border-amber-500" style="padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; width: 100%;">
                        </div>
                    <% } %>
                    <div class="table-card">
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">#</th>
                                        <th>Driver Info</th>
                                        <th>Phone</th>
                                        <th class="text-center">Status Selection</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% drivers.forEach((d, i) => { 
                                        let displayPhoto = '/images/default-avatar.png';
                                        if (d.photo) {
                                            displayPhoto = d.photo.startsWith('/uploads/') ? d.photo : '/uploads/drivers/' + d.photo;
                                        }
                                    %>
                                        <tr>
                                            <td class="font-semibold text-gray-400"><%= i + 1 %></td>
                                            <td>
                                                <div class="flex items-center gap-3">
                                                    <img src="<%= displayPhoto %>" class="w-9 h-9 rounded-full object-cover bg-slate-50 border border-slate-100 flex-shrink-0" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;">
                                                    <div>
                                                        <span class="font-bold text-gray-800 text-[13.5px] block">
                                                            <%= d.first_name %> <%= d.last_name %>
                                                        </span>
                                                        <span class="text-xs text-gray-400 block"><%= d.email || '—' %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-gray-500 font-medium text-xs"><%= d.phone || '—' %></td>
                                            <td>
                                                <div class="att-radio-group">
                                                    <label class="att-radio-btn">
                                                        <input type="radio" name="attendance[<%= d.id %>]" value="present" <%= (!d.attendanceStatus || d.attendanceStatus === 'present') ? 'checked' : '' %>>
                                                        <span class="att-pill">Present</span>
                                                    </label>
                                                    <label class="att-radio-btn">
                                                        <input type="radio" name="attendance[<%= d.id %>]" value="absent" <%= d.attendanceStatus === 'absent' ? 'checked' : '' %>>
                                                        <span class="att-pill">Absent</span>
                                                    </label>
                                                    <label class="att-radio-btn">
                                                        <input type="radio" name="attendance[<%= d.id %>]" value="half-day" <%= d.attendanceStatus === 'half-day' ? 'checked' : '' %>>
                                                        <span class="att-pill">Half-day</span>
                                                    </label>
                                                    <label class="att-radio-btn">
                                                        <input type="radio" name="attendance[<%= d.id %>]" value="leave" <%= d.attendanceStatus === 'leave' ? 'checked' : '' %>>
                                                        <span class="att-pill">Leave</span>
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <div class="p-4 flex justify-between items-center bg-slate-50/50 border-t border-slate-100">
                            <div id="liveCounts" class="text-xs font-semibold text-gray-500"></div>
                        </div>
                    </div>
                </form>
            <% } else { %>
                <div class="card p-8 text-center text-gray-500">
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-bus"></i></div>
                        <h4 class="empty-state-title">No drivers found</h4>
                        <p class="empty-state-text">There are no active drivers registered in this school.</p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>
<script>
    function markAll(status) {
        document.querySelectorAll('input[type="radio"][value="' + status + '"]').forEach(r => r.checked = true);
        updateCounts();
    }
    function updateCounts() {
        const p = document.querySelectorAll("input[value=present]:checked").length;
        const a = document.querySelectorAll("input[value=absent]:checked").length;
        const h = document.querySelectorAll("input[value='half-day']:checked").length;
        const l = document.querySelectorAll("input[value=leave]:checked").length;
        const t = '<%= drivers.length %>';
        const el = document.getElementById("liveCounts");
        if (el) {
            el.innerHTML = `<span class="text-emerald-600 font-bold">${p} Present</span> &nbsp;&bull;&nbsp; <span class="text-rose-600 font-bold">${a} Absent</span> &nbsp;&bull;&nbsp; <span class="text-amber-600 font-bold">${h} Half-day</span> &nbsp;&bull;&nbsp; <span class="text-blue-600 font-bold">${l} Leave</span> &nbsp;&bull;&nbsp; <span class="text-gray-400">Total: ${t}</span>`;
        }
    }
    document.querySelectorAll("input[type=radio]").forEach(r => r.addEventListener("change", updateCounts));
    updateCounts();
</script>