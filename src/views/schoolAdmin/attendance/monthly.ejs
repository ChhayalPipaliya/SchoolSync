<%- include('../../partials/head', { title: `${lan.Student_Monthly_Attendance || 'Student Monthly Attendance'} | SchoolSync` }) %>
<%- include('../../partials/attendanceCss') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Student_Monthly_Attendance || 'Student Monthly Attendance' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><% if(cls) { %><%= cls.class_name || cls.name %> (<%= cls.section %>) &bull; <% } %><%= month %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <% if(cls) { %>
                            <a href="/schooladmin/attendance/mark?class_id=<%= class_id %>&date=<%= new Date().toISOString().slice(0,10) %>" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                                <i class="fa-solid fa-pen"></i> <%- lan.Mark_Today || 'Mark Today' %>
                            </a>
                        <% } %>
                        <a href="/schooladmin/attendance" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back || 'Back' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card" style="border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                <form method="GET" style="display: grid; grid-template-columns: 2fr 1.5fr auto; gap: 10px; align-items: flex-end;" class="monthly-att-filter-form">
                    <div>
                        <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                            <%- lan.Class_Room || 'Class Room' %> <span style="color: #E11D48;">*</span>
                        </label>
                        <select name="class_id" required class="form-select" style="height: 34px; font-size: 11px; border-radius: 6px;">
                            <option value="">— <%- lan.Select_Class || 'Select Class' %> —</option>
                            <% (classes||[]).forEach(c => { %>
                                <option value="<%= c.id %>" <%= class_id==c.id?'selected':'' %>>
                                    <%= c.label || (c.class_name || c.name) + (c.stream && c.stream !== 'General' ? ' - ' + c.stream : '') + ' (' + (c.section||'—') + ')' %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                            <%- lan.Month || 'Month' %>
                        </label>
                        <input type="month" name="month" value="<%= month %>" class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
                    </div>
                    <button type="submit" class="btn" style="background: #059669; color: #fff; height: 34px; padding: 0 16px; font-size: 11px; font-weight: 700; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px; border: none; cursor: pointer;">
                        <i class="fa-solid fa-chart-simple"></i> <%- lan.View_Report || 'View Report' %>
                    </button>
                </form>
            </div>
            <% if(cls) { %>
                <div class="card" style="border-radius: 10px; border: 1px solid #E2E8F0; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.02); padding: 0;">
                    <div style="padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
                        <div>
                            <span style="font-size: 12px; font-weight: 800; color: #1E293B;"><%= cls.class_name || cls.name %> (<%= cls.section %>)</span>
                            <span style="font-size: 11px; color: #64748B; margin-left: 6px;"><%= month %> &bull; <%= (students||[]).length %> <%- lan.Students || 'students' %></span>
                        </div>
                        <div style="display: flex; gap: 10px; font-size: 10px; font-weight: 700; color: #64748B; align-items: center;">
                            <span style="display: inline-flex; align-items: center; gap: 3px;"><span class="att-dot p">P</span> <%- lan.Present || 'Present' %></span>
                            <span style="display: inline-flex; align-items: center; gap: 3px;"><span class="att-dot a">A</span> <%- lan.Absent || 'Absent' %></span>
                            <span style="display: inline-flex; align-items: center; gap: 3px;"><span class="att-dot l">L</span> <%- lan.Late || 'Late' %></span>
                            <span style="display: inline-flex; align-items: center; gap: 3px;"><span class="att-dot nd">—</span> <%- lan.Not_Marked || 'Not marked' %></span>
                        </div>
                    </div>
                    <div style="overflow-x: auto;">
                        <%- include('../../partials/monthlyGrid', { people: students, attendanceMap: attendanceMap, days: days, nameLabel: (lan.Student || 'Student')}) %>
                    </div>
                </div>
            <% } else { %>
                <div class="card" style="border-radius: 10px; padding: 32px 16px; text-align: center; color: #94A3B8; border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                    <div class="empty-state">
                        <div class="empty-state-icon" style="font-size: 26px; color: #CBD5E1; margin-bottom: 6px;"><i class="fa-solid fa-filter"></i></div>
                        <h4 class="empty-state-title" style="font-size: 13px; font-weight: 800; color: #1E293B; margin: 0 0 2px;"><%- lan.Select_A_Class || 'Select a Class' %></h4>
                        <p class="empty-state-text" style="font-size: 11px; color: #94A3B8; margin: 0;"><%- lan.Select_Class_Month_Grid_Desc || 'Select a class and month above to view the monthly attendance grid.' %></p>
                    </div>
                </div>
            <% } %>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
