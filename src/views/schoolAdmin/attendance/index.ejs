<%- include('../../partials/head') %>
<%- include('../../partials/attendanceCss') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div style="background:linear-gradient(135deg, #059669, #047857); border-radius:12px; padding:24px; color:#fff; margin-bottom: 10px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(5,150,105,0.15);">
                <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
                <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
                    <div>
                        <h1 style="font-size:24px; font-weight:700; margin:0;">Attendance Hub</h1>
                        <p style="font-size:13px; opacity:0.9; margin:4px 0 0;">Mark & view daily and monthly attendance for Students, Teachers, Librarians, and Drivers</p>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap:20px; margin-bottom:24px;">
                <div class="card" style="padding:20px; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-radius:12px;">
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                        <div style="width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; text-align:center; font-size:20px; background:rgba(5,150,105,0.1); color:#059669;">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                        <div>
                            <div style="font-weight:700; color:#0F172A; font-size:15px;">Students</div>
                            <div style="font-size:11px; color:#94A3B8;">Class-daily & monthly</div>
                        </div>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <a href="/schooladmin/attendance/mark?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px;">
                            <a href="/schooladmin/attendance/report" class="btn btn-secondary" style="font-size:12px; font-weight:600; padding:8px 0; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:4px;">
                                <i class="fa-solid fa-file-lines"></i> Daily Report
                            </a>
                            <a href="/schooladmin/attendance/monthly" class="btn btn-secondary" style="font-size:12px; font-weight:600; padding:8px 0; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:4px;">
                                <i class="fa-solid fa-calendar"></i> Monthly
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card" style="padding:20px; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-radius:12px;">
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                        <div style="width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; text-align:center; font-size:20px; background:rgba(5,150,105,0.1); color:#059669;">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <div style="font-weight:700; color:#0F172A; font-size:15px;">Teachers</div>
                            <div style="font-size:11px; color:#94A3B8;">Staff daily & monthly</div>
                        </div>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <a href="/schooladmin/attendance/teachers?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/teachers/monthly" class="btn btn-secondary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
                <div class="card" style="padding:20px; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-radius:12px;">
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                        <div style="width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; text-align:center; font-size:20px; background:rgba(5,150,105,0.1); color:#059669;">
                            <i class="fa-solid fa-bus"></i>
                        </div>
                        <div>
                            <div style="font-weight:700; color:#0F172A; font-size:15px;">Drivers</div>
                            <div style="font-size:11px; color:#94A3B8;">Transport daily & monthly</div>
                        </div>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <a href="/schooladmin/attendance/drivers/mark?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/drivers/monthly" class="btn btn-secondary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
                <div class="card" style="padding:20px; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-radius:12px;">
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                        <div style="width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; text-align:center; font-size:20px; background:rgba(5,150,105,0.1); color:#059669;">
                            <i class="fa-solid fa-book-reader"></i>
                        </div>
                        <div>
                            <div style="font-weight:700; color:#0F172A; font-size:15px;">Librarians</div>
                            <div style="font-size:11px; color:#94A3B8;">Library staff daily & monthly</div>
                        </div>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <a href="/schooladmin/attendance/librarians?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/librarians/monthly" class="btn btn-secondary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
            </div>
            <div class="card" style="padding:0; overflow:hidden; border-radius:12px; margin-bottom:0;">
                <div style="padding:16px; border-bottom:1px solid #E2E8F0; background:#F8FAFC;">
                    <div style="font-weight:600; color:#0F172A; display:flex; align-items:center; gap:8px; font-size:14px;">
                        <i class="fa-solid fa-bolt" style="color:#D97706;"></i> Quick Mark — Select a Class
                    </div>
                    <div style="font-size:11px; color:#94A3B8; margin-top:2px;">Click any class to mark today's student attendance</div>
                </div>
                <div style="padding:20px;">
                    <% if(!classes || classes.length===0) { %>
                        <div style="text-align:center; padding:32px 0; color:#94A3B8; font-size:13px;">
                            <i class="fa-solid fa-chalkboard" style="font-size:24px; margin-bottom:8px; display:block;"></i>
                            No classes found. Please add classes first.
                        </div>
                    <% } %>
                    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap:10px;">
                        <% (classes||[]).forEach(cls => { %>
                            <a href="/schooladmin/attendance/mark?class_id=<%= cls.id %>&date=<%= today %>"
                                style="display:block; text-align:center; padding:12px; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; text-decoration:none; transition:all 0.2s;"
                                onmouseover="this.style.background='rgba(5,150,105,0.05)'; this.style.borderColor='#34D399';"
                                onmouseout="this.style.background='#F8FAFC'; this.style.borderColor='#E2E8F0;'">
                                <div style="font-weight:700; color:#1E293B; font-size:13px;"><%= cls.name %> - <%= cls.section || '—' %></div>
                                <div style="font-size:10px; color:#94A3B8; margin-top:2px;"><%= cls.stream %></div>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>