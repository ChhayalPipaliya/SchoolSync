<style>
    .att-hub-banner {
        background: linear-gradient(135deg, #059669, #047857);
        border-radius: 12px;
        padding: 20px 24px;
        color: #fff;
        margin-bottom: 16px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(5,150,105,0.15);
    }
    .att-hub-banner-circle {
        position: absolute;
        right: -30px;
        top: -30px;
        width: 150px;
        height: 150px;
        background: rgba(255,255,255,0.08);
        border-radius: 50%;
    }
    .att-hub-banner-title {
        font-size: 22px;
        font-weight: 700;
        margin: 0;
    }
    .att-hub-banner-desc {
        font-size: 13px;
        opacity: 0.9;
        margin: 4px 0 0;
        line-height: 1.4;
    }
    .att-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }
    .att-card {
        padding: 18px;
        margin-bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-radius: 12px;
    }
    .att-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }
    .att-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 18px;
        background: rgba(5,150,105,0.1);
        color: #059669;
        flex-shrink: 0;
    }
    .att-card-title {
        font-weight: 700;
        color: #0F172A;
        font-size: 15px;
    }
    .att-card-sub {
        font-size: 11px;
        color: #94A3B8;
    }
    .att-card-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .att-sub-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }
    .att-sub-btn {
        font-size: 11.5px;
        font-weight: 600;
        padding: 8px 4px;
        text-decoration: none;
        text-align: center;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        white-space: nowrap;
        border-radius: 8px;
    }
    .quick-class-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(115px, 1fr));
        gap: 10px;
    }

    @media (max-width: 640px) {
        .att-hub-banner {
            padding: 16px 18px;
        }
        .att-hub-banner-title {
            font-size: 18px;
        }
        .att-hub-banner-desc {
            font-size: 11.5px;
        }
        .att-cards-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }
        .att-card {
            padding: 16px;
        }
        .quick-class-grid {
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 8px;
        }
    }

    @media (max-width: 380px) {
        .att-sub-grid {
            grid-template-columns: 1fr;
        }
        .att-sub-btn {
            font-size: 11px;
            padding: 7px 10px;
        }
    }

    [data-theme="dark"] .att-card,
    .light-mode-disabled .att-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .att-card-icon,
    .light-mode-disabled .att-card-icon {
        background: rgba(16, 185, 129, 0.18) !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .att-card-title,
    .light-mode-disabled .att-card-title {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .att-card-sub,
    .light-mode-disabled .att-card-sub {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .att-sub-btn,
    .light-mode-disabled .att-sub-btn {
        background: #1E293B !important;
        border: 1px solid #242F4D !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .att-sub-btn:hover,
    .light-mode-disabled .att-sub-btn:hover {
        background: #242F4D !important;
        border-color: #3B82F6 !important;
        color: #60A5FA !important;
    }

    [data-theme="dark"] .quick-class-header,
    .light-mode-disabled .quick-class-header {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .quick-class-header-title,
    .light-mode-disabled .quick-class-header-title {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .quick-class-grid a[data-marked="false"],
    .light-mode-disabled .quick-class-grid a[data-marked="false"] {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .quick-class-grid a[data-marked="false"]:hover,
    .light-mode-disabled .quick-class-grid a[data-marked="false"]:hover {
        background: #1E293B !important;
        border-color: #10B981 !important;
    }
    [data-theme="dark"] .quick-class-grid a[data-marked="false"] div:first-child,
    .light-mode-disabled .quick-class-grid a[data-marked="false"] div:first-child {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .quick-class-grid a[data-marked="false"] .cls-status-label,
    .light-mode-disabled .quick-class-grid a[data-marked="false"] .cls-status-label {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .quick-class-grid a[data-marked="true"],
    .light-mode-disabled .quick-class-grid a[data-marked="true"] {
        background: rgba(16, 185, 129, 0.18) !important;
        border-color: #10B981 !important;
    }
    [data-theme="dark"] .quick-class-grid a[data-marked="true"] div:first-child,
    .light-mode-disabled .quick-class-grid a[data-marked="true"] div:first-child {
        color: #34D399 !important;
    }
    [data-theme="dark"] .quick-class-grid a[data-marked="true"] .cls-status-label,
    .light-mode-disabled .quick-class-grid a[data-marked="true"] .cls-status-label {
        color: #10B981 !important;
    }
</style>
<%- include('../../partials/head') %>
<%- include('../../partials/attendanceCss') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="att-hub-banner">
                <div class="att-hub-banner-circle"></div>
                <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
                    <div>
                        <h1 class="att-hub-banner-title">Attendance Hub</h1>
                        <p class="att-hub-banner-desc">Mark & view daily and monthly attendance for Students, Teachers, Librarians, and Drivers</p>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="att-cards-grid">
                <div class="card att-card">
                    <div class="att-card-header">
                        <div class="att-card-icon">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                        <div>
                            <div class="att-card-title">Students</div>
                            <div class="att-card-sub">Class-daily & monthly</div>
                        </div>
                    </div>
                    <div class="att-card-actions">
                        <a href="/schooladmin/attendance/mark?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px; border-radius:8px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <div class="att-sub-grid">
                            <a href="/schooladmin/attendance/report" class="btn btn-secondary att-sub-btn">
                                <i class="fa-solid fa-file-lines"></i> Daily Report
                            </a>
                            <a href="/schooladmin/attendance/monthly" class="btn btn-secondary att-sub-btn">
                                <i class="fa-solid fa-calendar"></i> Monthly
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card att-card">
                    <div class="att-card-header">
                        <div class="att-card-icon">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <div class="att-card-title">Teachers</div>
                            <div class="att-card-sub">Staff daily & monthly</div>
                        </div>
                    </div>
                    <div class="att-card-actions">
                        <a href="/schooladmin/attendance/teachers?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px; border-radius:8px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/teachers/monthly" class="btn btn-secondary att-sub-btn" style="width:100%;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
                <div class="card att-card">
                    <div class="att-card-header">
                        <div class="att-card-icon">
                            <i class="fa-solid fa-bus"></i>
                        </div>
                        <div>
                            <div class="att-card-title">Drivers</div>
                            <div class="att-card-sub">Transport daily & monthly</div>
                        </div>
                    </div>
                    <div class="att-card-actions">
                        <a href="/schooladmin/attendance/drivers/mark?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px; border-radius:8px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/drivers/monthly" class="btn btn-secondary att-sub-btn" style="width:100%;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
                <div class="card att-card">
                    <div class="att-card-header">
                        <div class="att-card-icon">
                            <i class="fa-solid fa-book-reader"></i>
                        </div>
                        <div>
                            <div class="att-card-title">Librarians</div>
                            <div class="att-card-sub">Library staff daily & monthly</div>
                        </div>
                    </div>
                    <div class="att-card-actions">
                        <a href="/schooladmin/attendance/librarians?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px; border-radius:8px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/librarians/monthly" class="btn btn-secondary att-sub-btn" style="width:100%;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
            </div>
            <div class="card" style="padding:0; overflow:hidden; border-radius:12px; margin-bottom:0;">
                <div class="quick-class-header" style="padding:14px 16px; border-bottom:1px solid #E2E8F0; background:#F8FAFC;">
                    <div class="quick-class-header-title" style="font-weight:600; color:#0F172A; display:flex; align-items:center; gap:8px; font-size:14px;">
                        <i class="fa-solid fa-bolt" style="color:#D97706;"></i> Quick Mark — Select a Class
                    </div>
                    <div style="font-size:11px; color:#94A3B8; margin-top:2px;">Click any class to mark today's student attendance</div>
                </div>
                <div style="padding:16px;">
                    <% if(!classes || classes.length===0) { %>
                        <div style="text-align:center; padding:32px 0; color:#94A3B8; font-size:13px;">
                            <i class="fa-solid fa-chalkboard" style="font-size:24px; margin-bottom:8px; display:block;"></i>
                            No classes found. Please add classes first.
                        </div>
                    <% } %>
                    <div class="quick-class-grid">
                        <% (classes||[]).forEach(cls => { %>
                            <% if (cls.isMarked) { %>
                                <a href="/schooladmin/attendance/mark?class_id=<%= cls.id %>&date=<%= today %>"
                                   data-class-id="<%= cls.id %>"
                                   data-marked="true"
                                   style="display:block; text-align:center; padding:10px 8px; background:linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%); border:1.5px solid #10B981; border-radius:8px; text-decoration:none; transition:all 0.2s; box-shadow:0 2px 5px rgba(16,185,129,0.12);" onmouseover="this.style.background='#A7F3D0'; this.style.borderColor='#059669';" onmouseout="this.style.background='linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%)'; this.style.borderColor='#10B981';">
                                    <div style="font-weight:700; color:#065F46; font-size:12.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        <i class="fa-solid fa-circle-check" style="color:#059669; font-size:11px; margin-right:3px;"></i> <%= cls.name %> - <%= cls.section || '—' %>
                                    </div>
                                    <div class="cls-status-label" style="font-size:10px; color:#047857; font-weight:700; margin-top:2px;">✓ Marked Today</div>
                                </a>
                            <% } else { %>
                                <a href="/schooladmin/attendance/mark?class_id=<%= cls.id %>&date=<%= today %>"
                                   data-class-id="<%= cls.id %>"
                                   data-marked="false"
                                   style="display:block; text-align:center; padding:10px 8px; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; text-decoration:none; transition:all 0.2s;" onmouseover="this.style.background='rgba(5,150,105,0.05)'; this.style.borderColor='#34D399';" onmouseout="this.style.background='#F8FAFC'; this.style.borderColor='#E2E8F0';">
                                    <div style="font-weight:700; color:#1E293B; font-size:12.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= cls.name %> - <%= cls.section || '—' %></div>
                                    <div class="cls-status-label" style="font-size:10px; color:#94A3B8; margin-top:2px;"><%= cls.stream || 'Pending' %></div>
                                </a>
                            <% } %>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>
<script>
    (function () {
        const POLL_INTERVAL = 15000;

        function applyMarked(card) {
            if (card.dataset.marked === 'true') return;
            card.dataset.marked = 'true';

            card.style.background = 'linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%)';
            card.style.border = '1.5px solid #10B981';
            card.style.boxShadow = '0 2px 5px rgba(16,185,129,0.12)';
            card.onmouseover = function() { this.style.background='#A7F3D0'; this.style.borderColor='#059669'; };
            card.onmouseout  = function() { this.style.background='linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%)'; this.style.borderColor='#10B981'; };

            const nameDiv = card.querySelector('div:first-child');
            if (nameDiv && !nameDiv.querySelector('.fa-circle-check')) {
                nameDiv.style.color = '#065F46';
                nameDiv.innerHTML = '<i class="fa-solid fa-circle-check" style="color:#059669; font-size:11px; margin-right:3px;"></i> ' + nameDiv.textContent.trim();
            };

            const statusLabel = card.querySelector('.cls-status-label');
            if (statusLabel) {
                statusLabel.textContent = '✓ Marked Today';
                statusLabel.style.color = '#047857';
                statusLabel.style.fontWeight = '700';
            };
        };

        function pollStatus() {
            fetch('/schooladmin/attendance/api/class-status', { credentials: 'same-origin' })
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (!data || !data.success) return;
                    const markedSet = new Set(data.markedClassIds);
                    document.querySelectorAll('[data-class-id]').forEach(card => {
                        const classId = Number(card.dataset.classId);
                        if (markedSet.has(classId)) {
                            applyMarked(card);
                        };
                    });
                })
                .catch(() => {});
        };

        setInterval(pollStatus, POLL_INTERVAL);
        setTimeout(pollStatus, 2000);
    })();
</script>