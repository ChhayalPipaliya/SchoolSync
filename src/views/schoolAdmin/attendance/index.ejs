<%- include('../../partials/head') %>
<%- include('../../partials/attendanceCss') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <style>
                .att-hub-banner {
                    background: linear-gradient(135deg, #059669, #047857);
                    border-radius: 12px;
                    padding: 20px 24px;
                    color: #fff;
                    margin-bottom: 16px;
                    position: relative;
                    overflow: hidden;
                    box-shadow: 0 4px 12px rgba(5,150,105,0.15);
                }
                .att-hub-banner-circle {
                    position: absolute;
                    right: -30px;
                    top: -30px;
                    width: 150px;
                    height: 150px;
                    background: rgba(255,255,255,0.08);
                    border-radius: 50%;
                }
                .att-hub-banner-title {
                    font-size: 22px;
                    font-weight: 700;
                    margin: 0;
                }
                .att-hub-banner-desc {
                    font-size: 13px;
                    opacity: 0.9;
                    margin: 4px 0 0;
                    line-height: 1.4;
                }
                .att-cards-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                    gap: 16px;
                    margin-bottom: 24px;
                }
                .att-card {
                    padding: 18px;
                    margin-bottom: 0;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    border-radius: 12px;
                }
                .att-card-header {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    margin-bottom: 16px;
                }
                .att-card-icon {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    text-align: center;
                    font-size: 18px;
                    background: rgba(5,150,105,0.1);
                    color: #059669;
                    flex-shrink: 0;
                }
                .att-card-title {
                    font-weight: 700;
                    color: #0F172A;
                    font-size: 15px;
                }
                .att-card-sub {
                    font-size: 11px;
                    color: #94A3B8;
                }
                .att-card-actions {
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                }
                .att-sub-grid {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 8px;
                }
                .att-sub-btn {
                    font-size: 11.5px;
                    font-weight: 600;
                    padding: 8px 4px;
                    text-decoration: none;
                    text-align: center;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 4px;
                    white-space: nowrap;
                    border-radius: 8px;
                }
                .quick-class-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(115px, 1fr));
                    gap: 10px;
                }

                @media (max-width: 640px) {
                    .att-hub-banner {
                        padding: 16px 18px;
                    }
                    .att-hub-banner-title {
                        font-size: 18px;
                    }
                    .att-hub-banner-desc {
                        font-size: 11.5px;
                    }
                    .att-cards-grid {
                        grid-template-columns: 1fr;
                        gap: 12px;
                    }
                    .att-card {
                        padding: 16px;
                    }
                    .quick-class-grid {
                        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
                        gap: 8px;
                    }
                }

                @media (max-width: 380px) {
                    .att-sub-grid {
                        grid-template-columns: 1fr;
                    }
                    .att-sub-btn {
                        font-size: 11px;
                        padding: 7px 10px;
                    }
                }
            </style>
            <div class="att-hub-banner">
                <div class="att-hub-banner-circle"></div>
                <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
                    <div>
                        <h1 class="att-hub-banner-title">Attendance Hub</h1>
                        <p class="att-hub-banner-desc">Mark & view daily and monthly attendance for Students, Teachers, Librarians, and Drivers</p>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="att-cards-grid">
                <div class="card att-card">
                    <div class="att-card-header">
                        <div class="att-card-icon">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                        <div>
                            <div class="att-card-title">Students</div>
                            <div class="att-card-sub">Class-daily & monthly</div>
                        </div>
                    </div>
                    <div class="att-card-actions">
                        <a href="/schooladmin/attendance/mark?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px; border-radius:8px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <div class="att-sub-grid">
                            <a href="/schooladmin/attendance/report" class="btn btn-secondary att-sub-btn">
                                <i class="fa-solid fa-file-lines"></i> Daily Report
                            </a>
                            <a href="/schooladmin/attendance/monthly" class="btn btn-secondary att-sub-btn">
                                <i class="fa-solid fa-calendar"></i> Monthly
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card att-card">
                    <div class="att-card-header">
                        <div class="att-card-icon">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <div class="att-card-title">Teachers</div>
                            <div class="att-card-sub">Staff daily & monthly</div>
                        </div>
                    </div>
                    <div class="att-card-actions">
                        <a href="/schooladmin/attendance/teachers?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px; border-radius:8px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/teachers/monthly" class="btn btn-secondary att-sub-btn" style="width:100%;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
                <div class="card att-card">
                    <div class="att-card-header">
                        <div class="att-card-icon">
                            <i class="fa-solid fa-bus"></i>
                        </div>
                        <div>
                            <div class="att-card-title">Drivers</div>
                            <div class="att-card-sub">Transport daily & monthly</div>
                        </div>
                    </div>
                    <div class="att-card-actions">
                        <a href="/schooladmin/attendance/drivers/mark?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px; border-radius:8px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/drivers/monthly" class="btn btn-secondary att-sub-btn" style="width:100%;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
                <div class="card att-card">
                    <div class="att-card-header">
                        <div class="att-card-icon">
                            <i class="fa-solid fa-book-reader"></i>
                        </div>
                        <div>
                            <div class="att-card-title">Librarians</div>
                            <div class="att-card-sub">Library staff daily & monthly</div>
                        </div>
                    </div>
                    <div class="att-card-actions">
                        <a href="/schooladmin/attendance/librarians?date=<%= today %>" class="btn btn-primary" style="font-size:12px; font-weight:600; padding:8px 12px; text-decoration:none; text-align:center; display:inline-flex; align-items:center; justify-content:center; gap:6px; border-radius:8px;">
                            <i class="fa-solid fa-pen"></i> Mark Today
                        </a>
                        <a href="/schooladmin/attendance/librarians/monthly" class="btn btn-secondary att-sub-btn" style="width:100%;">
                            <i class="fa-solid fa-calendar"></i> Monthly Report
                        </a>
                    </div>
                </div>
            </div>
            <div class="card" style="padding:0; overflow:hidden; border-radius:12px; margin-bottom:0;">
                <div style="padding:14px 16px; border-bottom:1px solid #E2E8F0; background:#F8FAFC;">
                    <div style="font-weight:600; color:#0F172A; display:flex; align-items:center; gap:8px; font-size:14px;">
                        <i class="fa-solid fa-bolt" style="color:#D97706;"></i> Quick Mark — Select a Class
                    </div>
                    <div style="font-size:11px; color:#94A3B8; margin-top:2px;">Click any class to mark today's student attendance</div>
                </div>
                <div style="padding:16px;">
                    <% if(!classes || classes.length===0) { %>
                        <div style="text-align:center; padding:32px 0; color:#94A3B8; font-size:13px;">
                            <i class="fa-solid fa-chalkboard" style="font-size:24px; margin-bottom:8px; display:block;"></i>
                            No classes found. Please add classes first.
                        </div>
                    <% } %>
                    <div class="quick-class-grid">
                        <% (classes||[]).forEach(cls => { %>
                            <a href="/schooladmin/attendance/mark?class_id=<%= cls.id %>&date=<%= today %>"
                                style="display:block; text-align:center; padding:10px 8px; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:8px; text-decoration:none; transition:all 0.2s;"
                                onmouseover="this.style.background='rgba(5,150,105,0.05)'; this.style.borderColor='#34D399';"
                                onmouseout="this.style.background='#F8FAFC'; this.style.borderColor='#E2E8F0;'">
                                <div style="font-weight:700; color:#1E293B; font-size:12.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= cls.name %> - <%= cls.section || '—' %></div>
                                <div style="font-size:10px; color:#94A3B8; margin-top:2px;"><%= cls.stream %></div>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>