<%- include('../../partials/head', { title: `${lan.Attendance_Defaulters || 'Attendance Defaulters'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Attendance_Defaulters || 'Attendance Defaulters' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Defaulters_Subtitle_Prefix || 'Students with attendance percentages below the' %> <%= threshold %><%- lan.Threshold_Suffix || '% threshold' %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <a href="/schooladmin/attendance/mark" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Mark || 'Back to mark' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card" style="border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                <form method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Class_Room || 'Class Room' %></label>
                        <select name="class_id" class="form-select" onchange="this.form.submit()">
                            <option value=""><%- lan.All_Classes || 'All Classes' %></option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>" <%= typeof class_id !== 'undefined' && class_id == c.id ? 'selected' : '' %>><%= c.label || (c.class_name + (c.stream && c.stream !== 'General' ? ' - ' + c.stream : '') + ' - ' + c.section) %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Threshold_Percent || 'Threshold (%)' %></label>
                        <input type="number" name="threshold" value="<%= threshold %>" min="1" max="100" class="form-input">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <%- lan.Filter || 'Filter' %>
                    </button>
                </form>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider"><%- lan.Defaulters_List || 'Defaulters List' %></h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th><%- lan.Roll_No || 'Roll No' %></th>
                                <th><%- lan.Student || 'Student' %></th>
                                <th><%- lan.Class || 'Class' %></th>
                                <th class="text-center"><%- lan.Total_Days || 'Total Days' %></th>
                                <th class="text-center"><%- lan.Present_Days || 'Present Days' %></th>
                                <th class="text-center"><%- lan.Percentage || 'Percentage' %></th>
                                <th class="text-center"><%- lan.Status || 'Status' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!defaulters || defaulters.length === 0) { %>
                                <tr>
                                    <td colspan="7">
                                        <div class="empty-state">
                                            <div class="empty-state-icon"><i class="fa-solid fa-user-check"></i></div>
                                            <h4 class="empty-state-title"><%- lan.No_Defaulters_Found || 'No defaulters found' %></h4>
                                            <p class="empty-state-text"><%- lan.No_Defaulters_Desc || 'All students are above the attendance threshold.' %></p>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% defaulters.forEach(d => { 
                                    const pct = d.total_days > 0 ? (d.present_days / d.total_days * 100).toFixed(1) : 0;
                                %>
                                    <tr>
                                        <td class="font-bold text-gray-800"><%= d.roll_number || '—' %></td>
                                        <td class="font-bold text-gray-800"><%= d.first_name %> <%= d.last_name %></td>
                                        <td><%= d.class_name %> <%= d.section_name ? '(' + d.section_name + ')' : '' %></td>
                                        <td class="text-center font-semibold text-gray-600"><%= d.total_days %></td>
                                        <td class="text-center font-bold text-emerald-600"><%= d.present_days %></td>
                                        <td class="text-center font-bold text-rose-600"><%= pct %>%</td>
                                        <td class="text-center">
                                            <span class="badge badge-danger"><%- lan.Below_Limit || 'Below limit' %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>