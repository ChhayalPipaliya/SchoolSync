<%- include('../../partials/head') %>
<style>
    .attendance-options {
        display: flex;
        gap: 10px;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .attendance-option {
        cursor: pointer;
        user-select: none;
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .attendance-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
    }

    .attendance-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 96px;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 9999px;
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #64748B;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.2;
        transition: all 0.15s ease-in-out;
        text-align: center;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    }

    .attendance-pill::before {
        content: "";
        width: 12px;
        height: 12px;
        border-radius: 9999px;
        border: 2px solid currentColor;
        background: transparent;
        flex-shrink: 0;
        transition: transform 0.15s ease;
    }

    .attendance-option:hover .attendance-pill {
        border-color: #94A3B8;
        color: #334155;
        background: #F8FAFC;
    }

    .attendance-option input:checked + .attendance-pill {
        color: #FFFFFF;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);
    }

    .attendance-option input:checked + .attendance-pill::before {
        content: "\2713";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-color: rgba(255, 255, 255, 0.95);
        background: rgba(255, 255, 255, 0.25);
        font-size: 9px;
        font-weight: 900;
    }

    .attendance-option input[value="present"]:checked + .attendance-pill {
        background: #059669;
        border-color: #047857;
    }

    .attendance-option input[value="absent"]:checked + .attendance-pill {
        background: #E11D48;
        border-color: #BE123C;
    }

    .attendance-option input[value="late"]:checked + .attendance-pill {
        background: #D97706;
        border-color: #B45309;
    }

    .btn-compact {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: auto !important;
        max-width: max-content !important;
        white-space: nowrap !important;
        padding: 6px 14px !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        border-radius: 8px !important;
        line-height: 1.4 !important;
    }

    @media (max-width: 767.98px) {
        .attendance-table-card {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }

        .attendance-responsive-table, 
        .attendance-responsive-table tbody, 
        .attendance-responsive-table tr, 
        .attendance-responsive-table td {
            display: block !important;
            width: 100% !important;
        }

        .attendance-responsive-table thead {
            display: none !important;
        }

        .attendance-responsive-table tr {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            padding: 14px 16px;
            margin-bottom: 12px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
            position: relative;
        }

        .attendance-responsive-table tr:last-child {
            margin-bottom: 0;
        }

        .attendance-responsive-table td {
            padding: 0 !important;
            border: none !important;
        }

        .attendance-responsive-table td.roll-cell {
            position: absolute;
            top: 14px;
            right: 16px;
            width: auto !important;
        }

        .attendance-responsive-table td.student-cell {
            margin-bottom: 12px;
            padding-right: 70px !important;
        }

        .attendance-responsive-table td.status-cell {
            border-top: 1px dashed #E2E8F0 !important;
            padding-top: 12px !important;
        }

        .attendance-options {
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 8px !important;
            width: 100% !important;
        }

        .attendance-option {
            width: 100% !important;
        }

        .attendance-pill {
            width: 100% !important;
            min-width: 0 !important;
            padding: 8px 4px !important;
            font-size: 11.5px !important;
        }

        .btn-compact-mobile-full {
            width: 100% !important;
            max-width: 100% !important;
        }
    }

    .mobile-sticky-bar {
        display: none;
    }
    @media (max-width: 767.98px) {
        .mobile-sticky-bar {
            display: block;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-top: 1px solid #E2E8F0;
            padding: 10px 16px;
            z-index: 99;
            box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
        }
        .main-panel-content-padding {
            padding-bottom: 76px !important;
        }
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content main-panel-content-padding">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-6">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-gray-800 tracking-tight">Mark Attendance</h2>
                    <p class="text-xs text-gray-500 mt-1 flex items-center gap-1.5">
                        <i class="fa-regular fa-calendar text-gray-400"></i>
                        <span>Date: <%= new Date(date).toLocaleDateString('en-IN', { weekday: 'long' , year: 'numeric' , month: 'long' , day: 'numeric' }) %></span>
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/schooladmin/attendance/monthly" class="btn btn-secondary btn-compact text-slate-700 shadow-xs">
                        <i class="fa-solid fa-calendar-days text-slate-500 mr-1.5"></i> Monthly View
                    </a>
                    <a href="/schooladmin/attendance/report" class="btn btn-secondary btn-compact text-slate-700 shadow-xs">
                        <i class="fa-solid fa-chart-pie text-slate-500 mr-1.5"></i> Reports
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card p-4 sm:p-5 mb-6 shadow-xs border border-slate-200 rounded-xl">
                <form method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 items-end">
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-[11px] text-slate-400 uppercase tracking-wider mb-2 block">
                            <i class="fa-regular fa-calendar-check mr-1 text-slate-400"></i> Date
                        </label>
                        <input type="date" name="date" value="<%= date %>" class="form-input w-full rounded-lg border-slate-300 text-sm font-medium" onchange="this.form.submit()">
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-[11px] text-slate-400 uppercase tracking-wider mb-2 block">
                            <i class="fa-solid fa-chalkboard mr-1 text-slate-400"></i> Class Room *
                        </label>
                        <select name="class_id" required class="form-select w-full rounded-lg border-slate-300 text-sm font-medium" onchange="this.form.submit()">
                            <option value="">Select Class</option>
                            <% classes.forEach(c=> { %>
                                <option value="<%= c.id %>" <%=class_id==c.id ? 'selected' : '' %>><%= c.label || (c.class_name + (c.stream && c.stream !== 'General' ? ' - ' + c.stream : '') + (c.section ? ' - ' + c.section : '')) %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% if (typeof sections !=='undefined' && sections && sections.length> 0) { %>
                        <div class="form-group mb-0 sm:col-span-2 lg:col-span-1">
                            <label class="form-label font-bold text-[11px] text-slate-400 uppercase tracking-wider mb-2 block">
                                <i class="fa-solid fa-layer-group mr-1 text-slate-400"></i> Section
                            </label>
                            <select name="section_id" class="form-select w-full rounded-lg border-slate-300 text-sm font-medium" onchange="this.form.submit()">
                                <option value="">All Sections</option>
                                <% sections.forEach(sec=> { %>
                                    <option value="<%= sec.id %>" <%=section_id==sec.id ? 'selected' : '' %>><%= sec.section %></option>
                                <% }) %>
                            </select>
                        </div>
                    <% } %>
                </form>
            </div>
            <% if (students && students.length> 0) { %>
                <% if (typeof lockStatus !=='undefined' && lockStatus.requiresReason) { %>
                    <div class="bg-amber-50/80 border border-amber-300 rounded-xl p-3.5 sm:p-4 mb-4 flex items-start sm:items-center gap-3">
                        <i class="fas fa-lock text-amber-600 text-lg mt-0.5 sm:mt-0 flex-shrink-0"></i>
                        <div>
                            <span class="font-bold text-amber-900 text-sm block">Attendance Cutoff / Past Date Editing</span>
                            <p class="text-xs text-amber-700 m-0 mt-0.5">You are editing attendance past the daily cutoff time or for a past date. Please provide a reason below for the audit log.</p>
                        </div>
                    </div>
                <% } %>
                <form method="POST" action="/schooladmin/attendance/mark" id="attendanceForm">
                    <input type="hidden" name="date" value="<%= date %>">
                    <input type="hidden" name="class_id" value="<%= class_id %>">
                    <input type="hidden" name="section_id" value="<%= section_id || '' %>">
                    <% if (typeof lockStatus !=='undefined' && lockStatus.requiresReason) { %>
                        <div class="mb-4 bg-white p-4 rounded-xl border border-amber-200 shadow-xs">
                            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Unlock / Modification Reason <span class="text-red-500">*</span></label>
                            <input type="text" name="unlock_reason" required placeholder="e.g. Approved leave update by Admin, System sync request..." class="w-full text-sm border-gray-300 rounded-lg focus:ring-amber-500 focus:border-amber-500" style="padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 8px; width: 100%;">
                        </div>
                    <% } %>
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; flex-wrap: wrap;">
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <button type="button" onclick="markAll('present')" class="btn btn-secondary btn-compact text-slate-700 shadow-xs border border-slate-300 hover:bg-slate-50">
                                <i class="fa-solid fa-user-check text-emerald-600 mr-1.5"></i> Mark All Present
                            </button>
                            <button type="button" onclick="markAll('absent')" class="btn btn-secondary btn-compact text-slate-700 shadow-xs border border-slate-300 hover:bg-slate-50">
                                <i class="fa-solid fa-user-xmark text-rose-600 mr-1.5"></i> Mark All Absent
                            </button>
                        </div>
                        <button type="submit" class="btn btn-primary btn-compact text-white shadow-xs border-0" style="background: #059669; padding: 7px 18px !important;">
                            <i class="fa-solid fa-floppy-disk mr-1.5"></i> Save Attendance
                        </button>
                    </div>
                    <div class="table-card attendance-table-card">
                        <div class="table-container overflow-x-auto">
                            <table class="data-table attendance-responsive-table w-full">
                                <thead>
                                    <tr>
                                        <th style="width: 110px;" class="text-left py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">Roll No</th>
                                        <th class="text-left py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">Student Info</th>
                                        <th class="text-center py-3 px-4 text-xs font-bold uppercase tracking-wider text-slate-500">Status Selection</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% students.forEach(s=> { const existing = existingAttendance.find(a => a.student_id === s.id);
                                        let displayPhoto = '/images/default-avatar.svg';
                                        if (s.photo) {
                                            displayPhoto = s.photo.startsWith('/uploads/') ? s.photo : '/uploads/students/' + s.photo;
                                        } %>
                                        <tr>
                                            <td class="roll-cell font-bold text-slate-700">
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 text-xs font-bold border border-slate-200">
                                                    #<%= s.roll_number || '—' %>
                                                </span>
                                            </td>
                                            <td class="student-cell">
                                                <div class="flex items-center gap-3">
                                                    <img src="<%= displayPhoto %>" 
                                                         onerror="this.onerror=null; this.src='/images/default-avatar.svg';" 
                                                         alt="<%= s.first_name %>"
                                                         class="w-10 h-10 rounded-full object-cover bg-slate-100 border border-slate-200 flex-shrink-0 shadow-xs" 
                                                         style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                                    <div>
                                                        <span class="font-bold text-slate-800 text-[14px] leading-snug block"><%= s.first_name %> <%= s.last_name %></span>
                                                        <% if (s.admission_no) { %>
                                                            <span class="text-[11px] text-slate-400 block sm:hidden">ID: <%= s.admission_no %></span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="status-cell">
                                                <div class="attendance-options">
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[student_<%= s.id %>]" value="present" <%=(!existing || !existing.status || existing.status === 'present') ? 'checked' : '' %>>
                                                        <span class="attendance-pill">Present</span>
                                                    </label>
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[student_<%= s.id %>]" value="absent" <%=existing?.status==='absent' ? 'checked' : '' %>>
                                                        <span class="attendance-pill">Absent</span>
                                                    </label>
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[student_<%= s.id %>]" value="late" <%=existing?.status==='late' ? 'checked' : '' %>>
                                                        <span class="attendance-pill">Late</span>
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="mobile-sticky-bar">
                        <button type="submit" class="btn btn-primary w-full py-2.5 text-sm font-bold shadow-lg rounded-xl flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white border-0">
                            <i class="fa-solid fa-floppy-disk"></i> Save Attendance (<%= students.length %> Students)
                        </button>
                    </div>
                </form>
            <% } else if (class_id) { %>
                <div class="card p-8 text-center text-gray-500 rounded-xl shadow-xs">
                    <div class="empty-state">
                        <div class="empty-state-icon text-4xl text-slate-300 mb-3"><i class="fas fa-users"></i></div>
                        <h4 class="empty-state-title font-bold text-gray-700 text-lg">No students found</h4>
                        <p class="empty-state-text text-sm text-gray-500 mt-1">There are no students registered in this class.</p>
                    </div>
                </div>
            <% } else { %>
                <div class="card p-8 text-center text-gray-500 rounded-xl shadow-xs">
                    <div class="empty-state">
                        <div class="empty-state-icon text-4xl text-slate-300 mb-3"><i class="fas fa-hand-pointer"></i></div>
                        <h4 class="empty-state-title font-bold text-gray-700 text-lg">Select a Class</h4>
                        <p class="empty-state-text text-sm text-gray-500 mt-1">Please choose a class from the dropdown above to mark attendance.</p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>
<script>
    function markAll(status) {
        document.querySelectorAll('input[type="radio"][value="' + status + '"]').forEach(r => r.checked = true);
    };
</script>