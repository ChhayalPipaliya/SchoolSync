<%- include('../../partials/head') %>
<style>
    .attendance-options {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .attendance-option {
        cursor: pointer;
        user-select: none;
    }

    .attendance-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .attendance-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 86px;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 999px;
        border: 1px solid #CBD5E1;
        background: #FFFFFF;
        color: #64748B;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .attendance-pill::before {
        content: "";
        width: 14px;
        height: 14px;
        border-radius: 999px;
        border: 2px solid currentColor;
        background: transparent;
    }

    .attendance-option:hover .attendance-pill {
        border-color: #94A3B8;
        color: #334155;
        background: #F8FAFC;
    }

    .attendance-option input:checked + .attendance-pill {
        color: #FFFFFF;
        box-shadow: 0 7px 16px rgba(15, 23, 42, 0.16);
    }

    .attendance-option input:checked + .attendance-pill::before {
        content: "\2713";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-color: rgba(255, 255, 255, 0.95);
        background: rgba(255, 255, 255, 0.22);
        font-size: 10px;
        font-weight: 900;
    }

    .attendance-option input[value="present"]:checked + .attendance-pill {
        background: #059669;
        border-color: #047857;
    }

    .attendance-option input[value="absent"]:checked + .attendance-pill {
        background: #E11D48;
        border-color: #BE123C;
    }

    .attendance-option input[value="late"]:checked + .attendance-pill {
        background: #D97706;
        border-color: #B45309;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Mark Attendance</h2>
                    <p class="text-xs text-gray-500 mt-1">Date: <%= new Date(date).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                </div>
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <a href="/schooladmin/attendance/monthly" class="btn btn-secondary text-xs flex items-center justify-center gap-1.5 flex-1 sm:flex-initial">
                        <i class="fa-solid fa-calendar-days"></i> Monthly View
                    </a>
                    <a href="/schooladmin/attendance/report" class="btn btn-secondary text-xs flex items-center justify-center gap-1.5 flex-1 sm:flex-initial">
                        <i class="fa-solid fa-chart-pie"></i> Reports
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card p-5 mb-6">
                <form method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Date</label>
                        <input type="date" name="date" value="<%= date %>" class="form-input" onchange="this.form.submit()">
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Class Room *</label>
                        <select name="class_id" required class="form-select" onchange="this.form.submit()">
                            <option value="">Select Class</option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>" <%= class_id == c.id ? 'selected' : '' %>><%= c.class_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% if (typeof sections !== 'undefined' && sections && sections.length > 0) { %>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Section</label>
                        <select name="section_id" class="form-select" onchange="this.form.submit()">
                            <option value="">All Sections</option>
                            <% sections.forEach(sec => { %>
                                <option value="<%= sec.id %>" <%= section_id == sec.id ? 'selected' : '' %>><%= sec.section %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } %>
                </form>
            </div>
            <% if (students && students.length > 0) { %>
                <form method="POST" action="/schooladmin/attendance/mark">
                    <input type="hidden" name="date" value="<%= date %>">
                    <input type="hidden" name="class_id" value="<%= class_id %>">
                    <input type="hidden" name="section_id" value="<%= section_id || '' %>">

                    <div class="flex justify-between items-center mb-4">
                        <div class="flex gap-2">
                            <button type="button" onclick="markAll('present')" class="btn btn-secondary btn-sm py-1.5 text-xs font-bold">
                                Mark All Present
                            </button>
                            <button type="button" onclick="markAll('absent')" class="btn btn-secondary btn-sm py-1.5 text-xs font-bold">
                                Mark All Absent
                            </button>
                        </div>
                        <button type="submit" class="btn btn-primary px-6 py-2">
                            Save Attendance
                        </button>
                    </div>
                    <div class="table-card">
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th style="width: 100px;">Roll No</th>
                                        <th>Student Info</th>
                                        <th class="text-center">Status Selection</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% students.forEach(s => {
                                        const existing = existingAttendance.find(a => a.student_id === s.id);
                                        let displayPhoto = '/images/default-avatar.png';
                                        if (s.photo) {
                                            displayPhoto = s.photo.startsWith('/uploads/') ? s.photo : '/uploads/students/' + s.photo;
                                        }
                                    %>
                                        <tr>
                                            <td class="font-bold text-gray-800"><%= s.roll_number || '—' %></td>
                                            <td>
                                                <div class="flex items-center gap-3">
                                                    <img src="<%= displayPhoto %>" class="w-9 h-9 rounded-full object-cover bg-slate-50 border border-slate-100 flex-shrink-0" style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;">
                                                    <span class="font-bold text-gray-800 text-[13.5px]">
                                                        <%= s.first_name %> <%= s.last_name %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="attendance-options">
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[student_<%= s.id %>]" value="present" <%= (!existing || existing.status === 'present') ? 'checked' : '' %>>
                                                        <span class="attendance-pill">Present</span>
                                                    </label>
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[student_<%= s.id %>]" value="absent" <%= existing?.status === 'absent' ? 'checked' : '' %>>
                                                        <span class="attendance-pill">Absent</span>
                                                    </label>
                                                    <label class="attendance-option">
                                                        <input type="radio" name="attendance[student_<%= s.id %>]" value="late" <%= existing?.status === 'late' ? 'checked' : '' %>>
                                                        <span class="attendance-pill">Late</span>
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </form>
                <script>
                    function markAll(status) {
                        document.querySelectorAll('input[type="radio"][value="' + status + '"]').forEach(r => r.checked = true);
                    }
                </script>
            <% } else if (class_id) { %>
                <div class="card p-8 text-center text-gray-500">
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-users"></i></div>
                        <h4 class="empty-state-title">No students found</h4>
                        <p class="empty-state-text">There are no students registered in this class.</p>
                    </div>
                </div>
            <% } else { %>
                <div class="card p-8 text-center text-gray-500">
                    <div class="empty-state">
                        <div class="empty-state-icon"><i class="fas fa-hand-pointer"></i></div>
                        <h4 class="empty-state-title">Select a Class</h4>
                        <p class="empty-state-text">Please choose a class from the dropdown above to mark attendance.</p>
                    </div>
                </div>
            <% } %>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>