<style>
    .cert-tf-banner {
        background: linear-gradient(135deg, #059669, #047857);
        border-radius: 12px;
        padding: 24px;
        color: #fff;
        margin: 24px 24px 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(5,150,105,0.15);
    }
    .cert-tf-wrap {
        padding: 0 24px 24px;
    }
    .template-form-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 20px;
        align-items: start;
    }
    .form-row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 16px;
    }
    @media (max-width: 860px) {
        .cert-tf-banner {
            padding: 18px 16px !important;
            margin: 16px 16px 14px !important;
        }
        .cert-tf-wrap {
            padding: 0 16px 20px !important;
        }
        .template-form-grid {
            grid-template-columns: 1fr !important;
            gap: 16px !important;
        }
    }
    @media (max-width: 600px) {
        .form-row-2col {
            grid-template-columns: 1fr !important;
            gap: 12px !important;
        }
    }
</style>
<%- include('../../partials/head', { title: `${template ? (lan.Edit_Certificate_Template || 'Edit Certificate Template') : (lan.New_Certificate_Template || 'New Certificate Template')} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/certificates' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding:0;">
            <div class="cert-tf-banner">
                <div style="position:absolute;right:-30px;top:-30px;width:150px;height:150px;background:rgba(255,255,255,0.08);border-radius:50%;"></div>
                <div style="position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
                    <div>
                        <h1 style="font-size:22px;font-weight:700;margin:0;">
                            <i class="fas fa-<%= template ? 'edit' : 'plus-circle' %>" style="margin-right:8px;"></i>
                            <%= template ? (lan.Edit_Certificate_Template || 'Edit Certificate Template') : (lan.New_Certificate_Template || 'New Certificate Template') %>
                        </h1>
                        <p style="font-size:12px;opacity:0.9;margin:4px 0 0;"><%- lan.Design_Template_Desc || 'Design a reusable certificate template with placeholder variables' %></p>
                    </div>
                    <a href="/schooladmin/certificates/templates" style="background:rgba(255,255,255,0.15);color:#fff;border:1px solid rgba(255,255,255,0.3);font-weight:600;padding:8px 14px;font-size:12px;border-radius:8px;display:inline-flex;align-items:center;gap:6px;text-decoration:none;">
                        <i class="fas fa-arrow-left"></i> <%- lan.Back_To_Templates || 'Back to Templates' %>
                    </a>
                </div>
            </div>
            <div class="cert-tf-wrap">
                <%- include('../../partials/flashMessages') %>
                <div class="template-form-grid">
                    <div class="card" style="padding:20px;border-radius:12px;">
                        <form action="<%= template ? '/schooladmin/certificates/templates/' + template.id : '/schooladmin/certificates/templates' %>" method="POST">
                            <div class="form-row-2col">
                                <div>
                                    <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;"><%- lan.Template_Title || 'Template Title' %> <span style="color:#DC2626;">*</span></label>
                                    <input type="text" name="title" required value="<%= template ? template.title : '' %>"
                                        placeholder="<%- lan.Template_Title_Placeholder || 'e.g. Bonafide Certificate 2025' %>"
                                        style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:13px;outline:none;box-sizing:border-box;transition:border-color 0.15s;"
                                        onfocus="this.style.borderColor='#2563EB'" onblur="this.style.borderColor='#D1D5DB'">
                                </div>
                                <div>
                                    <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;"><%- lan.Certificate_Type || 'Certificate Type' %> <span style="color:#DC2626;">*</span></label>
                                    <select name="certificate_type" required style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:13px;outline:none;background:#fff;box-sizing:border-box;"
                                        onfocus="this.style.borderColor='#2563EB'" onblur="this.style.borderColor='#D1D5DB'">
                                        <% CERTIFICATE_TYPES.forEach(ct => { %>
                                        <option value="<%= ct.value %>" <%= (template && template.certificate_type === ct.value) ? 'selected' : '' %>><%= ct.label %></option>
                                        <% }); %>
                                    </select>
                                </div>
                            </div>
                            <div style="margin-bottom:16px;">
                                <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;"><%- lan.Header_Text || 'Header Text' %> <span style="font-weight:400;color:#94A3B8;">(<%- lan.Optional || 'optional' %>)</span></label>
                                <input type="text" name="header_text" value="<%= template ? (template.header_text || '') : '' %>"
                                    placeholder="<%- lan.Header_Text_Placeholder || 'e.g. Affiliated to Gujarat Secondary & Higher Secondary Education Board' %>"
                                    style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:13px;outline:none;box-sizing:border-box;"
                                    onfocus="this.style.borderColor='#2563EB'" onblur="this.style.borderColor='#D1D5DB'">
                            </div>
                            <div style="margin-bottom:16px;">
                                <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;">
                                    <%- lan.Certificate_Body || 'Certificate Body' %> <span style="color:#DC2626;">*</span>
                                    <span style="font-weight:400;color:#94A3B8;font-size:12px;"> <%- lan.Use_Variables_From_Panel_Hint || '— use {{variable}} placeholders from the panel →' %></span>
                                </label>
                                <textarea name="body_template" required rows="12"
                                    placeholder="This is to certify that {{student_name}}, son/daughter of {{father_name}}, is a bonafide student of {{class_name}} {{section}} at {{school_name}} for the academic year {{academic_year}}."
                                    style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:12px;font-size:13px;outline:none;resize:vertical;font-family:inherit;box-sizing:border-box;"
                                    onfocus="this.style.borderColor='#2563EB'" onblur="this.style.borderColor='#D1D5DB'"><%= template ? template.body_template : '' %></textarea>
                            </div>
                            <div class="form-row-2col">
                                <div>
                                    <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;"><%- lan.Signature_Name || 'Signature Name' %></label>
                                    <input type="text" name="signature_name" value="<%= template ? (template.signature_name || '') : '' %>"
                                        placeholder="<%- lan.Signature_Name_Placeholder || 'e.g. Mr. Ramesh Shah' %>"
                                        style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:13px;outline:none;box-sizing:border-box;"
                                        onfocus="this.style.borderColor='#2563EB'" onblur="this.style.borderColor='#D1D5DB'">
                                </div>
                                <div>
                                    <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;"><%- lan.Signature_Designation || 'Signature Designation' %></label>
                                    <input type="text" name="signature_designation" value="<%= template ? (template.signature_designation || '') : '' %>"
                                        placeholder="<%- lan.Signature_Designation_Placeholder || 'e.g. Principal' %>"
                                        style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:13px;outline:none;box-sizing:border-box;"
                                        onfocus="this.style.borderColor='#2563EB'" onblur="this.style.borderColor='#D1D5DB'">
                                </div>
                            </div>
                            <div style="margin-bottom:16px;">
                                <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;"><%- lan.Footer_Text || 'Footer Text' %> <span style="font-weight:400;color:#94A3B8;">(<%- lan.Optional || 'optional' %>)</span></label>
                                <input type="text" name="footer_text" value="<%= template ? (template.footer_text || '') : '' %>"
                                    placeholder="<%- lan.Footer_Text_Placeholder || 'e.g. This certificate is computer generated.' %>"
                                    style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:13px;outline:none;box-sizing:border-box;"
                                    onfocus="this.style.borderColor='#2563EB'" onblur="this.style.borderColor='#D1D5DB'">
                            </div>
                            <div class="form-row-2col" style="margin-bottom:24px;">
                                <div>
                                    <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;"><%- lan.Show_School_Logo || 'Show School Logo' %></label>
                                    <select name="logo_enabled" style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:13px;outline:none;background:#fff;box-sizing:border-box;">
                                        <option value="1" <%= (!template || template.logo_enabled == 1) ? 'selected' : '' %>><%- lan.Yes || 'Yes' %></option>
                                        <option value="0" <%= (template && template.logo_enabled == 0) ? 'selected' : '' %>><%- lan.No || 'No' %></option>
                                    </select>
                                </div>
                                <div>
                                    <label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;"><%- lan.Status || 'Status' %></label>
                                    <select name="status" style="width:100%;border:1px solid #D1D5DB;border-radius:8px;padding:10px 12px;font-size:13px;outline:none;background:#fff;box-sizing:border-box;">
                                        <option value="active" <%= (!template || template.status === 'active') ? 'selected' : '' %>><%- lan.Active || 'Active' %></option>
                                        <option value="inactive" <%= (template && template.status === 'inactive') ? 'selected' : '' %>><%- lan.Inactive || 'Inactive' %></option>
                                    </select>
                                </div>
                            </div>
                            <div style="display:flex;gap:12px;">
                                <button type="submit" class="btn btn-primary" style="padding:10px 24px;font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:8px;">
                                    <i class="fas fa-save"></i> <%= template ? (lan.Update_Template || 'Update Template') : (lan.Create_Template || 'Create Template') %>
                                </button>
                                <a href="/schooladmin/certificates/templates" class="btn btn-secondary" style="padding:10px 24px;font-size:14px;text-decoration:none;">
                                    <%- lan.Cancel || 'Cancel' %>
                                </a>
                            </div>
                        </form>
                    </div>
                    <div>
                        <div class="card" style="padding:20px;border-radius:12px;">
                            <h3 style="margin:0 0 14px;font-size:14px;font-weight:700;color:#0F172A;"><i class="fas fa-code" style="color:#2563EB;margin-right:8px;"></i><%- lan.Available_Variables || 'Available Variables' %></h3>
                            <p style="font-size:12px;color:#64748B;margin:0 0 12px;"><%- lan.Click_Variable_To_Insert_Hint || 'Click a variable to insert it into the body:' %></p>
                            <div style="display:flex;flex-direction:column;gap:5px;">
                                <% TEMPLATE_VARIABLES.forEach(v => { %>
                                <button type="button" onclick="insertVar('<%= v.key %>')"
                                    style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:6px;padding:7px 10px;text-align:left;cursor:pointer;font-family:monospace;font-size:11px;color:#2563EB;font-weight:600;transition:background 0.15s;"
                                    onmouseover="this.style.background='rgba(37,99,235,0.06)';this.style.borderColor='#93C5FD'" onmouseout="this.style.background='#F8FAFC';this.style.borderColor='#E2E8F0'"
                                    title="<%= v.desc %>">
                                    <%= v.key %>
                                    <span style="font-family:sans-serif;font-weight:400;color:#94A3B8;font-size:10px;margin-left:4px;"><%= v.desc %></span>
                                </button>
                                <% }); %>
                            </div>
                        </div>
                    </div>
</div>
        <%- include('../../partials/footer') %>
                </div>
        </div>

    </div>
</div>
<script>
function insertVar(variable) {
    const textarea = document.querySelector('[name="body_template"]');
    if (!textarea) return;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const text = textarea.value;
    textarea.value = text.substring(0, start) + variable + text.substring(end);
    textarea.selectionStart = textarea.selectionEnd = start + variable.length;
    textarea.focus();
}
</script>