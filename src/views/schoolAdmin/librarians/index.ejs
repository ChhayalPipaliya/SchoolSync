<%- include('../../partials/head', { title: `${lan.Librarians || 'Librarians'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Librarians || 'Librarians' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Librarians_Desc || 'Manage school library staff credentials, status, and system access' %></p>
                </div>
                <% if (!hasLibraryAccount) { %>
                    <a href="/schooladmin/librarians/add" class="btn btn-primary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                        <i class="fa-solid fa-plus"></i> <%- lan.Add_Library || 'Add Library' %>
                    </a>
                <% } else { %>
                    <a href="/schooladmin/librarians/<%= existingLibraryAccount.id %>/edit" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                        <i class="fa-solid fa-pen"></i> <%- lan.Edit_Library || 'Edit Library' %>
                    </a>
                <% } %>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider"><%- lan.Library_Management_Staff || 'Library Management Staff' %></h4>
                </div>
                <div class="table-container" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
                    <table class="data-table" style="min-width: 840px; width: 100%;">
                        <thead>
                            <tr>
                                <th style="white-space: nowrap;"><%- lan.Librarian_Name || 'Librarian Name' %></th>
                                <th style="white-space: nowrap;"><%- lan.Email_Address || 'Email Address' %></th>
                                <th style="white-space: nowrap;"><%- lan.Library_ID || 'Library ID' %></th>
                                <th style="white-space: nowrap;"><%- lan.Employee_Code || 'Employee Code' %></th>
                                <th style="white-space: nowrap;"><%- lan.Joining_Date || 'Joining Date' %></th>
                                <th style="white-space: nowrap;"><%- lan.Salary || 'Salary' %></th>
                                <th style="white-space: nowrap;" class="text-center"><%- lan.Status || 'Status' %></th>
                                <th style="white-space: nowrap;" class="text-center"><%- lan.Actions || 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!librarians || librarians.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center py-12 text-gray-400 font-medium">
                                        <div class="flex flex-col items-center justify-center gap-2">
                                            <i class="fa-solid fa-book-reader fa-2x text-gray-200"></i>
                                            <span><%- lan.No_Library_Account_Found || 'No library account found.' %></span>
                                            <% if (!hasLibraryAccount) { %>
                                                <a href="/schooladmin/librarians/add" class="text-emerald-600 font-bold hover:underline mt-1"><%- lan.Add_Library || 'Add library' %></a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            <% (librarians||[]).forEach((l, i) => { const initials = (l.first_name[0]||'') + (l.last_name[0]||''); %>
                                <tr>
                                    <td style="white-space: nowrap;">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 bg-emerald-50 text-emerald-700 rounded-full flex items-center justify-center font-bold text-xs border border-emerald-100/30 flex-shrink-0">
                                                <%= initials.toUpperCase() %>
                                            </div>
                                            <div>
                                                <div class="font-bold text-gray-800 text-[13px]"><%= l.first_name %> <%= l.last_name %></div>
                                                <% if (l.phone) { %>
                                                    <div class="text-[10px] text-gray-400 mt-0.5 whitespace-nowrap"><i class="fa-solid fa-phone text-[9px] mr-1"></i><%= l.phone %></div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="font-medium text-gray-700" style="white-space: nowrap;"><%= l.email %></td>
                                    <td class="font-mono font-semibold text-gray-600" style="white-space: nowrap;"><%= l.library_id || '—' %></td>
                                    <td class="font-mono font-semibold text-gray-600" style="white-space: nowrap;"><%= l.employee_code || '—' %></td>
                                    <td class="font-medium text-gray-600" style="white-space: nowrap;"><%= l.joining_date ? new Date(l.joining_date).toLocaleDateString('en-IN') : '—' %></td>
                                    <td class="font-bold text-emerald-600 font-mono text-[13px]" style="white-space: nowrap;"><%= l.salary ? '₹' + parseFloat(l.salary).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %></td>
                                    <td class="text-center" style="white-space: nowrap;">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase border
                                            <%= l.status === 'active' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-slate-50 text-slate-500 border-slate-100' %>">
                                            <%= l.status === 'active' ? (lan.Active || 'Active') : (lan.Inactive || 'Inactive') %>
                                        </span>
                                    </td>
                                    <td class="text-center" style="white-space: nowrap;">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <a href="/schooladmin/librarians/<%= l.id %>/edit" class="btn-icon btn-edit-icon" title="<%- lan.Edit || 'Edit' %>">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form method="POST" action="/schooladmin/librarians/<%= l.id %>/delete" class="delete-librarian-form inline-block m-0" data-confirm="<%- lan.Delete_Librarian_Confirm || 'Delete this librarian?' %>">
                                                <button type="submit" class="btn-icon btn-danger-icon" title="<%- lan.Delete || 'Delete' %>">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<script>
    document.querySelectorAll('.delete-librarian-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const confirmMsg = this.getAttribute('data-confirm');
            if (confirmMsg && !confirm(confirmMsg)) {
                e.preventDefault();
            }
        });
    });
</script>
