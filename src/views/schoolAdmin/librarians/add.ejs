<%- include('../../partials/head', { title: `${lan.Add_Library || 'Add Library'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Add_Library || 'Add Library' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Add_Library_Desc || 'Register the single library account allowed for this school' %></p>
                </div>
                <a href="/schooladmin/librarians" class="btn btn-secondary text-xs font-bold flex items-center gap-1.5 transition">
                    <i class="fas fa-arrow-left"></i> <%- lan.Back_To_List || 'Back to list' %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card">
                <div class="card-body">
                    <form method="POST" action="/schooladmin/librarians/add">
                        <div class="mb-8">
                            <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2">
                                <i class="fa-solid fa-user-lock text-emerald-600 text-xs"></i> <%- lan.Account_Information || 'Account Information' %>
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.First_Name || 'First Name' %> <span class="text-rose-500">*</span></label>
                                    <input type="text" name="first_name" required placeholder="<%- lan.Enter_First_Name || 'Enter first name' %>" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Last_Name || 'Last Name' %> <span class="text-rose-500">*</span></label>
                                    <input type="text" name="last_name" required placeholder="<%- lan.Enter_Last_Name || 'Enter last name' %>" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Email_Address || 'Email Address' %> <span class="text-rose-500">*</span></label>
                                    <input type="email" name="email" required placeholder="librarian@school.com" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Phone || 'Phone' %></label>
                                    <input type="tel" name="phone" placeholder="<%- lan.Contact_Phone_Number || 'Contact phone number' %>" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Password || 'Password' %> <span class="text-rose-500">*</span></label>
                                    <input type="password" name="password" required placeholder="<%- lan.Create_Login_Password || 'Create login password' %>" class="form-input">
                                </div>
                            </div>
                        </div>
                        <div class="mb-8">
                            <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2">
                                <i class="fa-solid fa-briefcase text-emerald-600 text-xs"></i> <%- lan.Employment_Details || 'Employment Details' %>
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Employee_Code || 'Employee Code' %></label>
                                    <input type="text" name="employee_code" placeholder="e.g. EMP-9021" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Library_ID || 'Library ID' %></label>
                                    <input type="text" name="library_id" placeholder="<%- lan.Auto_Generated_If_Blank || 'Auto-generated if blank' %>" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Joining_Date || 'Joining Date' %></label>
                                    <input type="date" name="joining_date" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Monthly_Salary || 'Monthly Salary (₹)' %></label>
                                    <div style="position: relative;">
                                        <span style="position: absolute; left: 10px; top: 7px; color: #94A3B8; font-weight: bold; font-size: 13px;">₹</span>
                                        <input type="number" name="salary" min="0" step="0.01" placeholder="e.g. 30000" class="form-input" style="padding-left: 26px;">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Status || 'Status' %></label>
                                    <select name="status" class="form-select">
                                        <option value="active"><%- lan.Active || 'Active' %></option>
                                        <option value="inactive"><%- lan.Inactive || 'Inactive' %></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="flex gap-3 pt-4 border-t border-gray-100/70">
                            <button type="submit" class="btn btn-primary text-xs font-bold shadow-sm transition">
                                <%- lan.Create_Library || 'Create Library' %>
                            </button>
                            <a href="/schooladmin/librarians" class="btn btn-secondary text-xs font-bold transition text-center">
                                <%- lan.Cancel || 'Cancel' %>
                            </a>
                        </div>
                    </form>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

