<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Edit Librarian</h2>
                    <p class="text-xs text-gray-500 mt-1">Update profile and employment details for <%= librarian.first_name %> <%= librarian.last_name %></p>
                </div>
                <a href="/schooladmin/librarians" class="btn btn-secondary text-xs font-bold flex items-center gap-1.5 transition">
                    <i class="fas fa-arrow-left"></i> Back to list
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card">
                <div class="card-body">
                    <form method="POST" action="/schooladmin/librarians/<%= librarian.id %>/edit">
                        <div class="mb-8">
                            <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2">
                                <i class="fa-solid fa-user-lock text-emerald-600 text-xs"></i> Account Information
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">First Name <span class="text-rose-500">*</span></label>
                                    <input type="text" name="first_name" value="<%= librarian.first_name %>" required placeholder="Enter first name" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Last Name <span class="text-rose-500">*</span></label>
                                    <input type="text" name="last_name" value="<%= librarian.last_name %>" required placeholder="Enter last name" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Email Address</label>
                                    <input type="email" value="<%= librarian.email %>" disabled class="form-input bg-slate-100 text-slate-500 cursor-not-allowed">
                                    <p class="text-[9px] text-gray-400 mt-1">Email address cannot be modified after registration.</p>
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Phone</label>
                                    <input type="tel" name="phone" value="<%= librarian.phone||'' %>" placeholder="Contact phone number" class="form-input">
                                </div>
                            </div>
                        </div>
                        <div class="mb-8">
                            <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2">
                                <i class="fa-solid fa-briefcase text-emerald-600 text-xs"></i> Employment Details
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Employee Code</label>
                                    <input type="text" name="employee_code" value="<%= librarian.employee_code||'' %>" placeholder="e.g. EMP-9021" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Library ID</label>
                                    <input type="text" name="library_id" value="<%= librarian.library_id||'' %>" placeholder="Library card ID" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Joining Date</label>
                                    <input type="date" name="joining_date" value="<%= librarian.joining_date ? new Date(librarian.joining_date).toISOString().split('T')[0] : '' %>" class="form-input">
                                </div>
                                <div class="form-group">
                                    <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Status</label>
                                    <select name="status" class="form-select">
                                        <option value="active" <%= librarian.status==='active'?'selected':'' %>>Active</option>
                                        <option value="inactive" <%= librarian.status==='inactive'?'selected':'' %>>Inactive</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="flex gap-3 pt-4 border-t border-gray-100/70">
                            <button type="submit" class="btn btn-primary text-xs font-bold shadow-sm transition"> Save Changes</button>
                            <a href="/schooladmin/librarians" class="btn btn-secondary text-xs font-bold transition text-center"> Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
