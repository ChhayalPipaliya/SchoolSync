<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="max-w-3xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800 tracking-tight">
                            <%= notice ? 'Edit Notice' : 'Publish Notice' %>
                        </h2>
                        <p class="text-xs text-gray-500 mt-1">
                            <%= notice ? 'Modify existing announcement details' : 'Draft and broadcast a new notice board announcement' %>
                        </p>
                    </div>
                    <a href="/schooladmin/notices" class="btn btn-secondary text-xs flex items-center gap-1">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>

                <form method="POST" action="<%= notice ? '/schooladmin/notices/' + notice.id + '/edit' : '/schooladmin/notices' %>" enctype="multipart/form-data" class="card p-6 md:p-8 space-y-6">
                    <div class="form-group">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Title *</label>
                        <input type="text" name="title" value="<%= notice?.title || '' %>" required class="form-input" placeholder="e.g. Annual Sports Meet Day 2026">
                    </div>

                    <div class="form-group">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Content *</label>
                        <textarea name="content" rows="6" required class="form-textarea" placeholder="Write full details here..."><%= notice?.content || '' %></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Target</label>
                            <select name="target_type" class="form-select">
                                <option value="all" <%= notice?.target_type === 'all' ? 'selected' : '' %>>All Staff & Students</option>
                                <option value="students" <%= notice?.target_type === 'students' ? 'selected' : '' %>>Students Only</option>
                                <option value="drivers" <%= notice?.target_type === 'drivers' ? 'selected' : '' %>>Drivers Only</option>
                                <option value="librarians" <%= notice?.target_type === 'librarians' ? 'selected' : '' %>>Librarians Only</option>
                                <option value="teachers" <%= notice?.target_type === 'teachers' ? 'selected' : '' %>>Teachers Only</option>
                                <option value="parents" <%= notice?.target_type === 'parents' ? 'selected' : '' %>>Parents Only</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Priority</label>
                            <select name="priority" class="form-select">
                                <option value="normal" <%= notice?.priority === 'normal' ? 'selected' : '' %>>Normal</option>
                                <option value="medium" <%= notice?.priority === 'medium' ? 'selected' : '' %>>Medium</option>
                                <option value="high" <%= notice?.priority === 'high' ? 'selected' : '' %>>High</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Expiry Date</label>
                            <input type="date" name="expiry_date" value="<%= notice?.expiry_date ? new Date(notice.expiry_date).toISOString().split('T')[0] : '' %>" class="form-input">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Attachment</label>
                        <input type="file" name="attachment" class="form-input">
                        <% if (notice?.attachment) { %>
                            <p class="text-[11px] text-gray-400 mt-1.5 font-mono">Current File: <%= notice.attachment %></p>
                        <% } %>
                    </div>

                    <% if (notice) { %>
                        <div class="form-group">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Status</label>
                            <select name="status" class="form-select">
                                <option value="published" <%= notice.status === 'published' ? 'selected' : '' %>>Published</option>
                                <option value="draft" <%= notice.status === 'draft' ? 'selected' : '' %>>Draft</option>
                                <option value="archived" <%= notice.status === 'archived' ? 'selected' : '' %>>Archived</option>
                            </select>
                        </div>
                    <% } %>

                    <div class="flex gap-4 pt-4 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary px-8 py-3">
                            <%= notice ? 'Update Notice' : 'Publish Notice' %>
                        </button>
                        <a href="/schooladmin/notices" class="btn btn-secondary px-8 py-3">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
