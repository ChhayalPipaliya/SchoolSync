<%- include('../../partials/head', { title: `${notice ? (lan.Edit_Notice || 'Edit Notice') : (lan.Publish_Notice || 'Publish Notice')} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">
                        <%= notice ? (lan.Edit_Notice || 'Edit Notice') : (lan.Publish_Notice || 'Publish Notice') %>
                    </h2>
                    <p class="text-xs text-gray-500 mt-1">
                        <%= notice ? (lan.Edit_Notice_Desc || 'Modify existing announcement details') : (lan.Publish_Notice_Desc || 'Draft and broadcast a new notice board announcement') %>
                    </p>
                </div>
                <a href="/schooladmin/notices" class="btn btn-secondary text-xs flex items-center gap-1">
                    <i class="fas fa-arrow-left"></i> <%- lan.Back_To_List || 'Back to List' %>
                </a>
            </div>
            <form method="POST" action="<%= notice ? '/schooladmin/notices/' + notice.id + '/edit' : '/schooladmin/notices' %>" enctype="multipart/form-data" class="card p-6 md:p-8 space-y-6">
                <div class="form-group">
                    <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Title || 'Title' %> *</label>
                    <input type="text" name="title" value="<%= notice?.title || '' %>" required class="form-input" placeholder="<%- lan.Notice_Title_Placeholder_2 || 'e.g. Annual Sports Meet Day 2026' %>">
                </div>
                <div class="form-group">
                    <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Content || 'Content' %> *</label>
                    <textarea name="content" rows="6" required class="form-textarea" placeholder="<%- lan.Write_Full_Details_Placeholder || 'Write full details here...' %>"><%= notice?.content || '' %></textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Target || 'Target' %></label>
                        <select name="target_type" class="form-select">
                            <option value="all" <%= notice?.target_type === 'all' ? 'selected' : '' %>><%- lan.All_Staff_And_Students || 'All Staff & Students' %></option>
                            <option value="students" <%= notice?.target_type === 'students' ? 'selected' : '' %>><%- lan.Students_Only || 'Students Only' %></option>
                            <option value="drivers" <%= notice?.target_type === 'drivers' ? 'selected' : '' %>><%- lan.Drivers_Only || 'Drivers Only' %></option>
                            <option value="librarians" <%= notice?.target_type === 'librarians' ? 'selected' : '' %>><%- lan.Librarians_Only || 'Librarians Only' %></option>
                            <option value="teachers" <%= notice?.target_type === 'teachers' ? 'selected' : '' %>><%- lan.Teachers_Only || 'Teachers Only' %></option>
                            <option value="parents" <%= notice?.target_type === 'parents' ? 'selected' : '' %>><%- lan.Parents_Only || 'Parents Only' %></option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Priority || 'Priority' %></label>
                        <select name="priority" class="form-select">
                            <option value="normal" <%= notice?.priority === 'normal' ? 'selected' : '' %>><%- lan.Normal || 'Normal' %></option>
                            <option value="medium" <%= notice?.priority === 'medium' ? 'selected' : '' %>><%- lan.Medium || 'Medium' %></option>
                            <option value="high" <%= notice?.priority === 'high' ? 'selected' : '' %>><%- lan.High || 'High' %></option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Expiry_Date || 'Expiry Date' %></label>
                        <input type="date" name="expiry_date" value="<%= notice?.expiry_date ? new Date(notice.expiry_date).toISOString().split('T')[0] : '' %>" class="form-input">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Attachment || 'Attachment' %></label>
                    <input type="file" name="attachment" class="form-input">
                    <% if (notice?.attachment) { %>
                        <p class="text-[11px] text-gray-400 mt-1.5 font-mono"><%- lan.Current_File || 'Current File' %>: <%= notice.attachment %></p>
                    <% } %>
                </div>
                <% if (notice) { %>
                    <div class="form-group">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Status || 'Status' %></label>
                        <select name="status" class="form-select">
                            <option value="published" <%= notice.status === 'published' ? 'selected' : '' %>><%- lan.Published || 'Published' %></option>
                            <option value="draft" <%= notice.status === 'draft' ? 'selected' : '' %>><%- lan.Draft || 'Draft' %></option>
                            <option value="archived" <%= notice.status === 'archived' ? 'selected' : '' %>><%- lan.Archived || 'Archived' %></option>
                        </select>
                    </div>
                <% } %>
                <div class="flex gap-4 pt-4 border-t border-slate-100">
                    <button type="submit" class="btn btn-primary px-8 py-3">
                        <%= notice ? (lan.Update_Notice || 'Update Notice') : (lan.Publish_Notice || 'Publish Notice') %>
                    </button>
                    <a href="/schooladmin/notices" class="btn btn-secondary px-8 py-3"><%- lan.Cancel || 'Cancel' %></a>
                </div>
            </form>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
