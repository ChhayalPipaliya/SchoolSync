<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Add Notice</h2>
                    <p class="text-xs text-gray-500 mt-1">
                        <a href="/schooladmin/notices" class="text-indigo-600 hover:underline">Notices</a> → Add New
                    </p>
                </div>
                <a href="/schooladmin/notices" class="bg-slate-100 text-slate-600 px-4 py-2.5 rounded-lg hover:bg-slate-200 flex items-center gap-2 text-xs font-bold transition">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <div class="max-w-2xl">
                <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm">
                    <div class="text-xs font-bold text-indigo-600 mb-4 pb-2 border-b border-indigo-50 flex items-center gap-2">
                        <i class="fa-solid fa-bullhorn"></i> Notice Details
                    </div>
                    <form action="/schooladmin/notices/add" method="POST">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1.5">Title <span class="text-rose-500">*</span></label>
                                <input type="text" name="title" required class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none bg-slate-50/50" placeholder="e.g. School Holiday Notice">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1.5">Target Audience <span class="text-rose-500">*</span></label>
                                <select name="target" required class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 outline-none bg-slate-50/50">
                                    <option value="all">All (Students + Teachers)</option>
                                    <option value="students">Students Only</option>
                                    <option value="teachers">Teachers Only</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1.5">Content <span class="text-rose-500">*</span></label>
                                <textarea name="content" required rows="5" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none bg-slate-50/50" placeholder="Write your notice here..."></textarea>
                            </div>
                        </div>
                        <div class="flex gap-3 mt-5">
                            <button type="submit" class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg hover:bg-indigo-700 flex items-center gap-2 text-sm font-bold shadow-sm transition">
                                <i class="fa-solid fa-bullhorn"></i> Publish Notice
                            </button>
                            <a href="/schooladmin/notices" class="bg-slate-100 text-slate-600 px-5 py-2.5 rounded-lg hover:bg-slate-200 text-sm font-bold transition">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>