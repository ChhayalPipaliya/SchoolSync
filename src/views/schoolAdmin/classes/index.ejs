    }
    [data-theme="dark"] .auto-section-option:hover,
    .light-mode-disabled .auto-section-option:hover {
        border-color: #10B981 !important;
        background: #1E293B !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .auto-section-option:has(input:checked),
    .light-mode-disabled .auto-section-option:has(input:checked) {
        border-color: #10B981 !important;
        background: rgba(16, 185, 129, 0.18) !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .modal-container label[class*="bg-slate-50"],
    .light-mode-disabled .modal-container label[class*="bg-slate-50"] {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #CBD5E1 !important;
    }

    [data-theme="dark"] .modal-container label[class*="bg-blue-50"],
    .light-mode-disabled .modal-container label[class*="bg-blue-50"] {
        background: rgba(59, 130, 246, 0.18) !important;
        border-color: rgba(59, 130, 246, 0.35) !important;
        color: #93C5FD !important;
    }
    [data-theme="dark"] .modal-container label[class*="bg-emerald-50"],
    .light-mode-disabled .modal-container label[class*="bg-emerald-50"] {
        background: rgba(16, 185, 129, 0.18) !important;
        border-color: rgba(16, 185, 129, 0.35) !important;
        color: #34D399 !important;
    }
    [data-theme="dark"] .modal-container label[class*="bg-amber-50"],
    .light-mode-disabled .modal-container label[class*="bg-amber-50"] {
        background: rgba(245, 158, 11, 0.18) !important;
        border-color: rgba(245, 158, 11, 0.35) !important;
        color: #FBBF24 !important;
    }

    [data-theme="dark"] .student-row:hover,
    .light-mode-disabled .student-row:hover {
        background: #1E293B !important;
    }
    [data-theme="dark"] .student-row .text-slate-800,
    .light-mode-disabled .student-row .text-slate-800 {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .student-avatar,
    .light-mode-disabled .student-avatar {
        border-color: #242F4D !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="classes-page-header">
                <div class="classes-page-heading">
                    <h2>Classes & Sections</h2>
                    <p>Click on a section badge to view its students</p>
                </div>
                <div class="classes-page-actions">
                    <% if (classes && classes.length > 0) { %>
                    <form action="/schooladmin/classes/delete-all" method="POST"
                        onsubmit="return confirm('Delete all classes and sections? This cannot be undone. Classes with active students will not be deleted.')">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash-can"></i> Delete All Classes
                        </button>
                    </form>
                    <% } %>
                    <button type="button" onclick="document.getElementById('autoGenModal').classList.remove('hidden')"
                        class="btn btn-secondary">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Auto-Generate
                    </button>
                    <button onclick="document.getElementById('addClassModal').classList.remove('hidden')" class="btn btn-primary">
                        <i class="fa-solid fa-plus"></i> Add Class
                    </button>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <%
                const totalClasses = classes.length;
                const totalStudents = classes.reduce((sum, c) => sum + Number(c.student_count || 0), 0);
                const uniqueClassNames = [...new Set(classes.map(c => c.name))].length;
            %>
            <div class="classes-stats grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
                <div class="stats-card" style="--card-glow: var(--cls-primary);">
                    <div class="stats-icon" style="background: var(--cls-primary-50); color: var(--cls-primary-dark);">
                        <i class="fa-solid fa-door-open"></i>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Total Sections</div>
                        <div class="text-2xl font-extrabold mt-0.5 text-slate-800"><%= totalClasses %></div>
                    </div>
                </div>
                <div class="stats-card" style="--card-glow: var(--cls-secondary);">
                    <div class="stats-icon" style="background: #EFF6FF; color: #0284C7;">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Total Students</div>
                        <div class="text-2xl font-extrabold mt-0.5 text-slate-800"><%= totalStudents %></div>
                    </div>
                </div>
                <div class="stats-card" style="--card-glow: var(--cls-warning);">
                    <div class="stats-icon" style="background: #FEF3C7; color: #D97706;">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div>
                        <div class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">Unique Classes</div>
                        <div class="text-2xl font-extrabold mt-0.5 text-slate-800"><%= uniqueClassNames %></div>
                    </div>
                </div>
            </div>
            <% if (!classes || classes.length === 0) { %>
            <div class="classes-empty-card text-center">
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fa-solid fa-door-closed"></i></div>
                    <h3 class="empty-state-title">No classes yet</h3>
                    <p class="empty-state-text">Use Auto-Generate or Add Class manually</p>
                    <button onclick="document.getElementById('addClassModal').classList.remove('hidden')" class="btn btn-primary mt-4">
                        <i class="fa-solid fa-plus"></i> Add First Class
                    </button>
                </div>
            </div>
            <% } else {
                const grouped = {};
                classes.forEach(c => {
                    const key = [c.name, c.medium || 'English', c.stream || 'General'].join('||');
                    if (!grouped[key]) grouped[key] = { name: c.name, medium: c.medium || 'English', stream: c.stream, sections: [] };
                    grouped[key].sections.push(c);
                });
                const palette = ['#059669','#0891B2','#4F46E5','#D97706','#7C3AED','#DB2777','#DC2626','#0EA5E9'];
                const streamColors = { Science:'#1D4ED8', Commerce:'#16A34A', Arts:'#92400E', General:'#475569' };
                const streamBg     = { Science:'#DBEAFE', Commerce:'#DCFCE7', Arts:'#FEF3C7', General:'#F1F5F9' };
                const streamIcon   = { Science:'fa-flask', Commerce:'fa-chart-line', Arts:'fa-palette', General:'fa-book' };
                const normalKeys = Object.keys(grouped).filter(k => !grouped[k].stream || grouped[k].stream === 'General');
                const streamKeys = Object.keys(grouped).filter(k => grouped[k].stream && grouped[k].stream !== 'General');
                let ci = 0;
            %>
            <% if (normalKeys.length > 0) { %>
            <div class="section-divider">
                <i class="fa-solid fa-layer-group"></i>
                <span>General Classes</span>
                <div class="line"></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                <% normalKeys.forEach(key => {
                    const grp = grouped[key];
                    const color = palette[ci++ % palette.length];
                    const label = (isNaN(Number(grp.name)) ? grp.name : `Class ${grp.name}`) + ` - ${grp.medium}`;
                    const initials = isNaN(Number(grp.name)) ? grp.name.charAt(0) : grp.name;
                    const totalSec = grp.sections.reduce((s,r) => s + Number(r.student_count||0), 0);
                %>
                <div class="class-summary-card" style="--group-color: <%= color %>; --group-color-15: <%= color %>18; --group-color-30: <%= color %>30;">
                    <div class="class-summary-header">
                        <div class="class-summary-main">
                            <div class="class-avatar-box">
                                <%= initials %>
                            </div>
                            <div class="class-summary-copy">
                                <div class="font-bold text-gray-800 text-sm"><%= label %></div>
                                <div class="text-[11px] text-gray-400"><%= grp.sections.length %> section<%= grp.sections.length > 1 ? 's' : '' %> · <%= totalSec %> students</div>
                            </div>
                        </div>
                        <div class="flex flex-col gap-1.5 ml-2 flex-shrink-0">
                            <% grp.sections.forEach(s => { %>
                                <div class="flex gap-1 items-center justify-end">
                                    <span class="text-[10px] font-bold text-slate-400 mr-0.5">Sec <%= s.section %>:</span>
                                    <a href="/schooladmin/classes/<%= s.id %>/edit" class="btn-icon btn-edit-icon" title="Edit Section <%= s.section %>">
                                        <i class="fa-solid fa-pen" style="font-size: 8px;"></i>
                                    </a>
                                    <form action="/schooladmin/classes/<%= s.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete <%= s.label || (label + ' - ' + s.section) %>?')">
                                        <button type="submit" class="btn-icon btn-danger-icon" title="Delete Section <%= s.section %>">
                                            <i class="fa-solid fa-trash" style="font-size: 8px;"></i>
                                        </button>
                                    </form>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">Sections</div>
                    <div class="flex flex-wrap gap-2">
                        <% grp.sections.forEach(s => { %>
                        <button type="button" onclick="openSectionModal('<%= s.id %>', '<%= label %>', '<%= s.section %>')" class="section-badge group" title="Click to view students in Section <%= s.section %> (<%= s.medium %>)">
                            <span>Sec <%= s.section %></span>
                            <% if (Number(s.student_count) > 0) { %>
                                <span class="student-counter">
                                    <%= s.student_count %>
                                </span>
                            <% } else { %>
                                <span class="text-[9px] opacity-60">0</span>
                            <% } %>
                            <i class="fa-solid fa-chevron-right text-[8px] opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform"></i>
                        </button>
                        <% }) %>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
            <% if (streamKeys.length > 0) { %>
            <div class="section-divider">
                <i class="fa-solid fa-flask"></i>
                <span>Higher Secondary & Streams</span>
                <div class="line"></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
                <% streamKeys.forEach(key => {
                    const grp = grouped[key];
                    const sc = streamColors[grp.stream] || '#475569';
                    const sb = streamBg[grp.stream] || '#F1F5F9';
                    const icon = streamIcon[grp.stream] || 'fa-book';
                    const totalSec = grp.sections.reduce((s,r) => s + Number(r.student_count||0), 0);
                %>
                <div class="class-summary-card" style="--group-color: <%= sc %>; --group-color-15: <%= sb %>; --group-color-30: <%= sc %>40;">
                    <div class="class-summary-header">
                        <div class="class-summary-main">
                            <div class="class-avatar-box">
                                <i class="fa-solid <%= icon %>"></i>
                            </div>
                            <div class="class-summary-copy">
                                <div class="font-bold text-gray-800 text-sm">
                                    Class <%= grp.name %> - <%= grp.medium %>
                                    <span class="ml-1 px-2 py-0.5 rounded-full text-[9px] font-extrabold uppercase tracking-wider"
                                        style="background: var(--group-color-15); color: var(--group-color);"><%= grp.stream %></span>
                                </div>
                                <div class="text-[11px] text-gray-400"><%= grp.sections.length %> section<%= grp.sections.length > 1 ? 's' : '' %> · <%= totalSec %> students</div>
                            </div>
                        </div>
                        <div class="flex flex-col gap-1.5 ml-2 flex-shrink-0">
                            <% grp.sections.forEach(r => { %>
                            <div class="flex gap-1 items-center justify-end">
                                <span class="text-[10px] font-bold text-slate-400 mr-0.5">Sec <%= r.section %>:</span>
                                <a href="/schooladmin/classes/<%= r.id %>/edit" class="btn-icon btn-edit-icon" title="Edit Section <%= r.section %>">
                                    <i class="fa-solid fa-pen" style="font-size: 8px;"></i>
                                </a>
                                <form action="/schooladmin/classes/<%= r.id %>/delete" method="POST" style="display:inline;" <% const _delMsg = r.label || ('Class ' + grp.name + ' - ' + r.section + ' - ' + grp.medium + ' - ' + grp.stream); %>
                                    onsubmit="return confirm('Delete <%= _delMsg %>?')">
                                    <button type="submit" class="btn-icon btn-danger-icon" title="Delete Section <%= r.section %>">
                                        <i class="fa-solid fa-trash" style="font-size: 8px;"></i>
                                    </button>
                                </form>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                    <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">Sections</div>
                    <div class="flex flex-wrap gap-2">
                        <% grp.sections.forEach(r => { %>
                        <button type="button" onclick="openSectionModal('<%= r.id %>', 'Class <%= grp.name %> - <%= grp.medium %> - <%= grp.stream %>', '<%= r.section %>')" class="section-badge group" title="Click to view students in Section <%= r.section %> (<%= r.medium %>)">
                            <span>Sec <%= r.section %></span>
                            <% if (Number(r.student_count) > 0) { %>
                                <span class="student-counter">
                                    <%= r.student_count %>
                                </span>
                            <% } else { %>
                                <span class="text-[9px] opacity-60">0</span>
                            <% } %>
                            <i class="fa-solid fa-chevron-right text-[8px] opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform"></i>
                        </button>
                        <% }) %>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
            <% } %>
        </div>
    </div>
</div>
<div id="sectionModal" class="fixed inset-0 hidden items-center justify-center modal-overlay">
    <div class="modal-container w-full max-w-2xl mx-4">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-shrink-0 bg-slate-50/50">
            <div>
                <div id="modalTitle" class="text-base font-extrabold text-slate-800"></div>
                <div id="modalSubtitle" class="text-xs text-slate-400 mt-1"></div>
            </div>
            <button onclick="closeSectionModal()" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-rose-50 hover:text-rose-600 transition-all text-slate-500 font-bold border-none cursor-pointer">&times;</button>
        </div>
        <div class="flex-1 overflow-y-auto px-6 py-4" id="modalBody">
            <div id="modalLoading" class="flex flex-col items-center justify-center py-16">
                <div class="w-10 h-10 rounded-full border-4 border-slate-200 animate-spin mb-3" style="border-top-color: var(--cls-primary);"></div>
                <p class="text-sm text-slate-400">Loading students...</p>
            </div>
            <div id="studentsList" class="hidden"></div>
            <div id="modalError" class="hidden text-center py-12">
                <i class="fa-solid fa-circle-exclamation text-3xl text-rose-500 mb-3"></i>
                <p class="text-sm text-rose-600 font-semibold">Failed to load students</p>
            </div>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 flex-shrink-0 bg-slate-50/50 flex items-center justify-between">
            <span id="modalCount" class="text-xs text-slate-500 font-bold"></span>
            <a id="modalViewAllLink" href="#" class="btn btn-primary text-xs hidden">
                <i class="fa-solid fa-users mr-1"></i>View All Students
            </a>
        </div>
    </div>
</div>
<div id="addClassModal" class="hidden fixed inset-0 flex items-center justify-center modal-overlay">
    <div class="modal-container w-full max-w-md mx-4">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-shrink-0 bg-slate-50/50">
            <h3 class="text-base font-bold text-slate-800 flex items-center gap-2 m-0">
                <i class="fa-solid fa-plus text-emerald-600"></i> Add New Class
            </h3>
            <button onclick="document.getElementById('addClassModal').classList.add('hidden')" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-rose-50 hover:text-rose-600 transition-all text-slate-500 font-bold border-none cursor-pointer">&times;</button>
        </div>
        <form method="POST" action="/schooladmin/classes/add" class="m-0">
            <div class="px-6 py-5 space-y-4">
                <div class="form-group">
                    <label class="form-label">Class Name *</label>
                    <input type="text" name="class_name" required class="form-input" placeholder="e.g., 10, Nursery, LKG">
                </div>
                <div class="form-group">
                    <label class="form-label">Medium *</label>
                    <select name="medium" required class="form-select">
                        <% (schoolMediums && schoolMediums.length ? schoolMediums : [primaryMedium || 'English']).forEach(med => { %>
                            <option value="<%= med %>" <%= med === primaryMedium ? 'selected' : '' %>><%= med %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Stream (for Class 11–12 only)</label>
                    <select name="stream" class="form-select">
                        <option value="General">None / General</option>
                        <option value="Science">Science</option>
                        <option value="Commerce">Commerce</option>
                        <option value="Arts">Arts</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Sections <span class="text-slate-400 font-normal">(comma separated)</span></label>
                    <input type="text" name="sections" class="form-input" placeholder="A, B, C" value="A">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50 flex gap-3">
                <button type="submit" class="btn btn-primary flex-1">Add Class</button>
                <button type="button" onclick="document.getElementById('addClassModal').classList.add('hidden')" class="btn btn-secondary flex-1">Cancel</button>
            </div>
        </form>
    </div>
</div>
<div id="autoGenModal" class="hidden fixed inset-0 flex items-center justify-center modal-overlay">
    <div class="modal-container w-[480px] max-w-[95vw] mx-4">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-shrink-0 bg-slate-50/50">
            <h3 class="text-base font-bold text-slate-800 flex items-center gap-2 m-0">
                <i class="fa-solid fa-wand-magic-sparkles text-emerald-600"></i> Auto-Generate Classes
            </h3>
            <button onclick="document.getElementById('autoGenModal').classList.add('hidden')" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-rose-50 hover:text-rose-600 transition-all text-slate-500 font-bold border-none cursor-pointer">&times;</button>
        </div>
        <form action="/schooladmin/classes/auto-generate" method="POST" id="inlineAutoGenerateForm" class="m-0">
            <input type="hidden" name="class_range" value="school_type_default">
            <div class="px-6 py-5 space-y-5 max-h-[60vh] overflow-y-auto">
                <div>
                    <label class="form-label font-extrabold text-xs text-slate-400 uppercase tracking-wider mb-2 block">Sections *</label>
                    <p class="text-xs text-slate-500 mb-3">Select the sections to create for every generated class.</p>
                    <div class="auto-section-options">
                        <% (typeof validSections !== 'undefined' && validSections.length ? validSections : ['A','B','C','D','E','F']).forEach(section => { %>
                            <label class="auto-section-option flex items-center gap-2">
                                <input type="checkbox" name="sections" value="<%= section %>" <%= section === 'A' ? 'checked' : '' %>>
                                <span>Section <%= section %></span>
                            </label>
                        <% }) %>
                    </div>
                    <p class="text-xs text-rose-500 mt-2 hidden animate-pulse" id="inlineSectionError">Please select at least one section.</p>
                </div>
                <div>
                    <label class="form-label font-extrabold text-xs text-slate-400 uppercase tracking-wider mb-2 block">Mediums *</label>
                    <div class="flex gap-2 flex-wrap">
                        <% (schoolMediums && schoolMediums.length ? schoolMediums : [primaryMedium || 'English']).forEach(med => { %>
                            <label class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-sm font-semibold text-slate-700 hover:bg-emerald-50/50 hover:border-emerald-400 transition" style="border-width: 1.5px;">
                                <input type="checkbox" name="mediums" value="<%= med %>" checked class="w-3.5 h-3.5 accent-emerald-600">
                                <%= med %>
                            </label>
                        <% }) %>
                    </div>
                </div>
                <div class="bg-slate-50/80 rounded-xl p-4 border border-slate-200/60">
                    <label class="form-label font-extrabold text-xs text-slate-500 uppercase tracking-wider mb-1 block">
                        Streams (for Class 11 & 12)
                    </label>
                    <span class="text-[11px] text-slate-400 block mb-3">Select the streams your school offers</span>
                    <div class="flex gap-2 flex-wrap">
                        <label class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg border border-blue-300 bg-blue-50 text-sm font-semibold text-blue-700 hover:bg-blue-100/50 transition">
                            <input type="checkbox" name="streams" value="Science" checked class="w-3.5 h-3.5 accent-blue-600">
                            <i class="fa-solid fa-flask"></i> Science
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg border border-emerald-300 bg-emerald-50 text-sm font-semibold text-emerald-700 hover:bg-emerald-100/50 transition">
                            <input type="checkbox" name="streams" value="Commerce" checked class="w-3.5 h-3.5 accent-emerald-600">
                            <i class="fa-solid fa-chart-line"></i> Commerce
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg border border-amber-300 bg-amber-50 text-sm font-semibold text-amber-700 hover:bg-amber-100/50 transition">
                            <input type="checkbox" name="streams" value="Arts" checked class="w-3.5 h-3.5 accent-amber-600">
                            <i class="fa-solid fa-palette"></i> Arts
                        </label>
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50 flex gap-3 justify-end">
                <button type="button" onclick="document.getElementById('autoGenModal').classList.add('hidden')" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Generate
                </button>
            </div>
        </form>
    </div>
</div>
<script>
    const inlineAutoGenerateForm = document.getElementById('inlineAutoGenerateForm');
    if (inlineAutoGenerateForm) {
        inlineAutoGenerateForm.addEventListener('submit', function (event) {
            const selectedSections = inlineAutoGenerateForm.querySelectorAll('input[name="sections"]:checked');
            const sectionError = document.getElementById('inlineSectionError');
            if (selectedSections.length === 0) {
                event.preventDefault();
                sectionError.classList.remove('hidden');
                sectionError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            };
            sectionError.classList.add('hidden');
        });
    };

    document.getElementById('autoGenModal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
    });

    document.getElementById('addClassModal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
    });

    let currentClassId = null;
    function openSectionModal(classId, className, section) {
        currentClassId = classId;
        document.getElementById('modalTitle').textContent = className + ' — Section ' + section;
        document.getElementById('modalSubtitle').textContent = 'Loading student list...';
        document.getElementById('modalCount').textContent = '';
        document.getElementById('modalLoading').classList.remove('hidden');
        document.getElementById('studentsList').classList.add('hidden');
        document.getElementById('modalError').classList.add('hidden');
        document.getElementById('modalViewAllLink').classList.add('hidden');

        const modal = document.getElementById('sectionModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        fetch('/schooladmin/classes/' + classId + '/students')
            .then(r => r.json())
            .then(data => {
                document.getElementById('modalLoading').classList.add('hidden');
                if (!data.success) throw new Error(data.message || 'Error');

                document.getElementById('modalSubtitle').textContent = className + ' — Section ' + section;
                document.getElementById('modalCount').textContent = data.count + ' student' + (data.count !== 1 ? 's' : '') + ' enrolled';

                let html = '';
                if (data.students.length === 0) {
                    html = `<div class="flex flex-col items-center justify-center py-14 text-center">
                        <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center mb-3">
                            <i class="fa-solid fa-user-slash text-2xl text-slate-300"></i>
                        </div>
                        <p class="text-sm font-semibold text-gray-500">No students in this section</p>
                        <p class="text-xs text-gray-400 mt-1">Add students and assign them to this section</p>
                        <a href="/schooladmin/students/add" class="btn btn-primary mt-4 py-2 px-4 text-xs">
                            <i class="fa-solid fa-plus mr-1"></i>Add Student
                        </a>
                    </div>`;
                } else {
                    html = '<div class="divide-y divide-slate-100">';
                    data.students.forEach((s, i) => {
                        const name = s.first_name + ' ' + (s.last_name || '');
                        const initial = (s.first_name || 'S').charAt(0).toUpperCase();
                        const genderColor = s.gender === 'female' ? '#DB2777' : s.gender === 'male' ? '#0891B2' : '#64748B';
                        const genderBg   = s.gender === 'female' ? '#FDF2F8' : s.gender === 'male' ? '#EFF6FF' : '#F8FAFC';
                        const statusDot  = s.status === 'active' ? '<span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span>' : '<span class="relative flex h-2 w-2"><span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span></span>';
                        const avatarHtml = s.image ? `<img src="${s.image}" alt="${name}" class="student-avatar w-10 h-10 rounded-full object-cover border-2 border-slate-200 flex-shrink-0">` : `<div class="student-avatar-placeholder w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-sm flex-shrink-0" style="background:${genderBg}; color:${genderColor};">${initial}</div>`;

                        html += `<div class="student-row flex items-center gap-3 py-2.5 px-3 rounded-lg transition-all cursor-pointer hover:bg-slate-50" onclick="window.location='/schooladmin/students/${s.id}/view'">
                            ${avatarHtml}
                            <div class="flex-1 min-w-0">
                                <div class="font-bold text-sm text-slate-800 truncate">${name}</div>
                                <div class="text-[11px] text-slate-400 flex items-center gap-2 mt-0.5">
                                    ${s.admission_no ? '<span class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-[10px]">' + s.admission_no + '</span>' : ''}
                                    ${s.roll_no ? '<span class="font-semibold text-slate-500">· Roll ' + s.roll_no + '</span>' : ''}
                                </div>
                            </div>
                            <div class="flex items-center gap-3 flex-shrink-0">
                                <div class="flex items-center gap-1.5">
                                    ${statusDot}
                                    <span class="text-[10px] font-bold capitalize px-2.5 py-0.5 rounded-full" style="background:${genderBg}; color:${genderColor};">
                                        ${s.gender || '—'}
                                    </span>
                                </div>
                                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>
                            </div>
                        </div>`;
                    });
                    html += '</div>';
                };

                document.getElementById('studentsList').innerHTML = html;
                document.getElementById('studentsList').classList.remove('hidden');

                const viewAll = document.getElementById('modalViewAllLink');
                viewAll.href = '/schooladmin/students?class_id=' + classId;
                viewAll.classList.remove('hidden');
            })
            .catch(err => {
                document.getElementById('modalLoading').classList.add('hidden');
                document.getElementById('modalError').classList.remove('hidden');
                console.error(err);
            });
    };

    function closeSectionModal() {
        const modal = document.getElementById('sectionModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        currentClassId = null;
    };

    document.getElementById('sectionModal').addEventListener('click', function(e) {
        if (e.target === this) closeSectionModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeSectionModal();
    });
</script>