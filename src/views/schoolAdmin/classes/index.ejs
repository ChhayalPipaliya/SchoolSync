                                                                            <%= s.section %></span>
                                                                    <% if (Number(s.student_count)> 0) { %>
                                                                        <span class="student-counter">
                                                                            <%= s.student_count %>
                                                                        </span>
                                                                        <% } else { %>
                                                                            <span class="text-[9px] opacity-60">0</span>
                                                                            <% } %>
                                                                                <i
                                                                                    class="fa-solid fa-chevron-right text-[8px] opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform"></i>
                                                                </button>
                                                                <% }) %>
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                            </div>
                                            <% } %>
                                                <% if (streamKeys.length> 0) { %>
                                                    <div class="section-divider">
                                                        <i class="fa-solid fa-flask"></i>
                                                        <span><%- lan.Higher_Secondary_Streams
                                                                || 'Higher Secondary & Streams' %></span>
                                                        <div class="line"></div>
                                                    </div>
                                                    <div
                                                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-3">
                                                        <% streamKeys.forEach(key=> {
                                                            const grp = grouped[key];
                                                            const sc = streamColors[grp.stream] || '#475569';
                                                            const sb = streamBg[grp.stream] || '#F1F5F9';
                                                            const icon = streamIcon[grp.stream] || 'fa-book';
                                                            const totalSec = grp.sections.reduce((s,r) => s +
                                                            Number(r.student_count||0), 0);
                                                            const streamLabel = ((lan.Class || 'Class') + ' ' + grp.name
                                                            + ' - ' + grp.medium + ' - ' + grp.stream);
                                                            %>
                                                            <div class="class-summary-card"
                                                                style="--group-color: <%= sc %>; --group-color-15: <%= sb %>; --group-color-30: <%= sc %>40;">
