                                                            <% grp.sections.forEach(s=> { %>
                                                                <button type="button"
                                                                    class="section-badge group section-modal-trigger"
                                                                    data-class-id="<%= s.id %>"
                                                                    data-class-label="<%= label %>"
                                                                    data-section="<%= s.section %>"
