                                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                                                <% normalKeys.forEach(key=> {
                                                    const grp = grouped[key];
                                                    const color = palette[ci++ % palette.length];
                                                    const label = (isNaN(Number(grp.name)) ? grp.name : ((lan.Class ||
                                                    'Class') + ' ' + grp.name)) + ` - ${grp.medium}`;
                                                    const initials = isNaN(Number(grp.name)) ? grp.name.charAt(0) :
                                                    grp.name;
                                                    const totalSec = grp.sections.reduce((s,r) => s +
                                                    Number(r.student_count||0), 0);
                                                    %>
                                                    <div class="class-summary-card"
                                                        style="--group-color: <%= color %>; --group-color-15: <%= color %>18; --group-color-30: <%= color %>30;">
                                                        <div class="class-summary-header">
