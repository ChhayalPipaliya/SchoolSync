                                                                <div class="class-avatar-box">
                                                                    <%= initials %>
                                                                </div>
                                                                <div class="class-summary-copy">
                                                                    <div class="font-bold text-gray-800 text-sm">
                                                                        <%= label %>
                                                                    </div>
                                                                    <div class="text-[11px] text-gray-400">
                                                                        <%= grp.sections.length %> <%- lan.Sections
                                                                                || 'sections' %> · <%= totalSec %> <%-
                                                                                        lan.Students || 'students' %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div
                                                                class="class-section-actions-list flex flex-col gap-1.5 ml-2 flex-shrink-0">
