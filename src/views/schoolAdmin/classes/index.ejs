    </style>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 14px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-chalkboard"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%- lan.Classes_And_Sections || 'Classes & Sections' %>
                                        </h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%-
                                                lan.Click_Section_To_View_Students
                                                || 'Click on a section badge to view its students' %></p>
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <% if (classes && classes.length> 0) { %>
                                        <form action="/schooladmin/classes/delete-all" method="POST" style="margin: 0;"
                                            data-confirm="<%- lan.Delete_All_Classes_Confirm || 'Delete all classes and sections? This cannot be undone. Classes with active students will not be deleted.' %>">
                                            <button type="submit" class="btn"
                                                style="background: rgba(239, 68, 68, 0.25); color: #fff; border: 1px solid rgba(239, 68, 68, 0.4); font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                                                <i class="fa-solid fa-trash-can"></i> <%- lan.Delete_All_Classes
                                                    || 'Delete All Classes' %>
                                            </button>
                                        </form>
                                        <% } %>
                                            <button type="button" id="openAutoGenBtn" class="btn"
                                                style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                                                <i class="fa-solid fa-wand-magic-sparkles"></i> <%- lan.Auto_Generate
                                                    || 'Auto-Generate' %>
                                            </button>
                                            <button type="button" id="openAddClassBtn" class="btn"
                                                style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 13px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                                                <i class="fa-solid fa-plus"></i> <%- lan.Add_Class || 'Add Class' %>
                                            </button>
                                </div>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <% const totalClasses=classes.length; const totalStudents=classes.reduce((sum, c)=> sum +
                                Number(c.student_count || 0), 0);
                                const uniqueClassNames = [...new Set(classes.map(c => c.name))].length;
                                %>
                                <div class="classes-stats grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
                                    <div class="stats-card"
                                        style="--card-glow: var(--cls-primary); padding: 12px 14px;">
                                        <div class="stats-icon"
                                            style="background: var(--cls-primary-50); color: var(--cls-primary-dark); width: 40px; height: 40px; font-size: 16px;">
                                            <i class="fa-solid fa-door-open"></i>
                                        </div>
                                        <div>
                                            <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">
                                                <%- lan.Total_Sections || 'Total Sections' %>
                                            </div>
                                            <div class="text-xl font-extrabold mt-0.5 text-slate-800">
                                                <%= totalClasses %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="stats-card"
                                        style="--card-glow: var(--cls-secondary); padding: 12px 14px;">
                                        <div class="stats-icon"
                                            style="background: #EFF6FF; color: #0284C7; width: 40px; height: 40px; font-size: 16px;">
                                            <i class="fa-solid fa-graduation-cap"></i>
                                        </div>
                                        <div>
                                            <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">
                                                <%- lan.Total_Students || 'Total Students' %>
                                            </div>
                                            <div class="text-xl font-extrabold mt-0.5 text-slate-800">
                                                <%= totalStudents %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="stats-card"
                                        style="--card-glow: var(--cls-warning); padding: 12px 14px;">
                                        <div class="stats-icon"
                                            style="background: #FEF3C7; color: #D97706; width: 40px; height: 40px; font-size: 16px;">
                                            <i class="fa-solid fa-layer-group"></i>
                                        </div>
                                        <div>
                                            <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">
                                                <%- lan.Unique_Classes || 'Unique Classes' %>
                                            </div>
                                            <div class="text-xl font-extrabold mt-0.5 text-slate-800">
                                                <%= uniqueClassNames %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% if (!classes || classes.length===0) { %>
                                    <div class="classes-empty-card text-center">
                                        <div class="empty-state">
                                            <div class="empty-state-icon"><i class="fa-solid fa-door-closed"></i></div>
                                            <h3 class="empty-state-title"><%- lan.No_Classes_Yet || 'No classes yet' %>
                                            </h3>
                                            <p class="empty-state-text"><%- lan.Use_Autogen_Or_Add_Desc
                                                    || 'Use Auto-Generate or Add Class manually' %></p>
                                            <button type="button" id="openAddClassEmptyBtn"
                                                class="btn btn-primary mt-4">
                                                <i class="fa-solid fa-plus"></i> <%- lan.Add_First_Class
                                                    || 'Add First Class' %>
                                            </button>
                                        </div>
                                    </div>
                                    <% } else { const grouped={}; classes.forEach(c=> {
                                        const key = [c.name, c.medium || 'English', c.stream || 'General'].join('||');
                                        if (!grouped[key]) grouped[key] = { name: c.name, medium: c.medium || 'English',
                                        stream: c.stream, sections: [] };
                                        grouped[key].sections.push(c);
                                        });
                                        const palette =
                                        ['#059669','#0891B2','#4F46E5','#D97706','#7C3AED','#DB2777','#DC2626','#0EA5E9'];
                                        const streamColors = { Science:'#1D4ED8', Commerce:'#16A34A', Arts:'#92400E',
                                        General:'#475569' };
                                        const streamBg = { Science:'#DBEAFE', Commerce:'#DCFCE7', Arts:'#FEF3C7',
                                        General:'#F1F5F9' };
                                        const streamIcon = { Science:'fa-flask', Commerce:'fa-chart-line',
                                        Arts:'fa-palette', General:'fa-book' };
                                        const normalKeys = Object.keys(grouped).filter(k => !grouped[k].stream ||
                                        grouped[k].stream === 'General');
                                        const streamKeys = Object.keys(grouped).filter(k => grouped[k].stream &&
                                        grouped[k].stream !== 'General');
                                        let ci = 0;
                                        %>
                                        <% if (normalKeys.length> 0) { %>
                                            <div class="section-divider">
                                                <i class="fa-solid fa-layer-group"></i>
                                                <span><%- lan.General_Classes || 'General Classes' %></span>
                                                <div class="line"></div>
