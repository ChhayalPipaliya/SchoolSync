                                                                            class="section-badge group section-modal-trigger"
                                                                            data-class-id="<%= r.id %>"
                                                                            data-class-label="<%= streamLabel %>"
                                                                            data-section="<%= r.section %>"
                                                                            title="<%- lan.Click_Section_To_View_Students || 'Click to view students' %> (<%= r.medium %>)">
                                                                            <span><%- lan.Section || 'Sec' %>
                                                                                    <%= r.section %></span>
                                                                            <% if (Number(r.student_count)> 0) { %>
                                                                                <span class="student-counter">
                                                                                    <%= r.student_count %>
                                                                                </span>
                                                                                <% } else { %>
                                                                                    <span
                                                                                        class="text-[9px] opacity-60">0</span>
                                                                                    <% } %>
                                                                                        <i
                                                                                            class="fa-solid fa-chevron-right text-[8px] opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform"></i>
                                                                        </button>
                                                                        <% }) %>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
                                                        <% } %>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>
    <div id="sectionModal" class="fixed inset-0 hidden items-center justify-center modal-overlay"
        data-loading="<%- lan.Loading_Student_List || 'Loading student list...' %>"
        data-student="<%- lan.Student || 'student' %>" data-students="<%- lan.Students || 'students' %>"
        data-enrolled="<%- lan.Enrolled || 'enrolled' %>"
        data-no-students="<%- lan.No_Students_In_Section || 'No students in this section' %>"
        data-no-students-desc="<%- lan.Add_Students_Assign_Section_Desc || 'Add students and assign them to this section' %>"
        data-add-student="<%- lan.Add_Student || 'Add Student' %>" data-roll="<%- lan.Roll || 'Roll' %>">
        <div class="modal-container w-full max-w-2xl mx-4">
            <div
                class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-shrink-0 bg-slate-50/50">
                <div>
                    <div id="modalTitle" class="text-base font-extrabold text-slate-800"></div>
                    <div id="modalSubtitle" class="text-xs text-slate-400 mt-1"></div>
                </div>
                <button type="button" id="closeSectionModalBtn"
                    class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-rose-50 hover:text-rose-600 transition-all text-slate-500 font-bold border-none cursor-pointer">&times;</button>
            </div>
            <div class="flex-1 overflow-y-auto px-6 py-4" id="modalBody">
                <div id="modalLoading" class="flex flex-col items-center justify-center py-16">
                    <div class="w-10 h-10 rounded-full border-4 border-slate-200 animate-spin mb-3"
                        style="border-top-color: var(--cls-primary);"></div>
                    <p class="text-sm text-slate-400"><%- lan.Loading_Students || 'Loading students...' %></p>
                </div>
                <div id="studentsList" class="hidden"></div>
                <div id="modalError" class="hidden text-center py-12">
                    <i class="fa-solid fa-circle-exclamation text-3xl text-rose-500 mb-3"></i>
                    <p class="text-sm text-rose-600 font-semibold"><%- lan.Failed_To_Load_Students
                            || 'Failed to load students' %></p>
                </div>
            </div>
            <div
                class="px-6 py-4 border-t border-slate-100 flex-shrink-0 bg-slate-50/50 flex items-center justify-between">
                <span id="modalCount" class="text-xs text-slate-500 font-bold"></span>
                <a id="modalViewAllLink" href="#" class="btn btn-primary text-xs hidden">
                    <i class="fa-solid fa-users mr-1"></i><%- lan.View_All_Students || 'View All Students' %>
                </a>
            </div>
        </div>
    </div>
    <div id="addClassModal" class="hidden fixed inset-0 flex items-center justify-center modal-overlay">
        <div class="modal-container w-full max-w-md mx-4">
            <div
                class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-shrink-0 bg-slate-50/50">
                <h3 class="text-base font-bold text-slate-800 flex items-center gap-2 m-0">
                    <i class="fa-solid fa-plus text-emerald-600"></i> <%- lan.Add_New_Class || 'Add New Class' %>
                </h3>
                <button type="button" id="closeAddClassBtn"
                    class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-rose-50 hover:text-rose-600 transition-all text-slate-500 font-bold border-none cursor-pointer">&times;</button>
            </div>
            <form method="POST" action="/schooladmin/classes/add" class="m-0">
                <div class="px-6 py-5 space-y-4">
                    <div class="form-group">
                        <label class="form-label"><%- lan.Class_Name || 'Class Name' %> *</label>
                        <input type="text" name="class_name" required class="form-input"
                            placeholder="<%- lan.Class_Name_Placeholder || 'e.g., 10, Nursery, LKG' %>">
                    </div>
                    <div class="form-group">
                        <label class="form-label"><%- lan.Medium || 'Medium' %> *</label>
                        <select name="medium" required class="form-select">
                            <% (schoolMediums && schoolMediums.length ? schoolMediums : [primaryMedium || 'English'
                                ]).forEach(med=> { %>
                                <option value="<%= med %>" <%=med===primaryMedium ? 'selected' : '' %>><%= med %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><%- lan.Stream_For_11_12_Only || 'Stream (for Class 11–12 only)'
                                %></label>
                        <select name="stream" class="form-select">
                            <option value="General"><%- lan.None_General || 'None / General' %></option>
                            <option value="Science"><%- lan.Science || 'Science' %></option>
                            <option value="Commerce"><%- lan.Commerce || 'Commerce' %></option>
                            <option value="Arts"><%- lan.Arts || 'Arts' %></option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><%- lan.Sections_Comma_Separated || 'Sections (comma separated)'
                                %></label>
                        <input type="text" name="sections" class="form-input" placeholder="A, B, C" value="A">
                    </div>
                </div>
                <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50 flex gap-3">
                    <button type="submit" class="btn btn-primary flex-1"><%- lan.Add_Class || 'Add Class' %></button>
                    <button type="button" id="cancelAddClassBtn" class="btn btn-secondary flex-1"><%- lan.Cancel
                            || 'Cancel' %></button>
                </div>
            </form>
        </div>
    </div>
    <div id="autoGenModal" class="hidden fixed inset-0 flex items-center justify-center modal-overlay">
        <div class="modal-container w-[480px] max-w-[95vw] mx-4">
            <div
                class="flex items-center justify-between px-6 py-4 border-b border-slate-100 flex-shrink-0 bg-slate-50/50">
                <h3 class="text-base font-bold text-slate-800 flex items-center gap-2 m-0">
                    <i class="fa-solid fa-wand-magic-sparkles text-emerald-600"></i> <%- lan.Auto_Generate_Classes
                        || 'Auto-Generate Classes' %>
                </h3>
                <button type="button" id="closeAutoGenBtn"
                    class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-rose-50 hover:text-rose-600 transition-all text-slate-500 font-bold border-none cursor-pointer">&times;</button>
            </div>
            <form action="/schooladmin/classes/auto-generate" method="POST" id="inlineAutoGenerateForm" class="m-0">
                <input type="hidden" name="class_range" value="school_type_default">
                <div class="px-6 py-5 space-y-5 max-h-[60vh] overflow-y-auto">
                    <div>
                        <label
                            class="form-label font-extrabold text-xs text-slate-400 uppercase tracking-wider mb-2 block"><%-
                                lan.Sections || 'Sections' %> *</label>
                        <p class="text-xs text-slate-500 mb-3"><%- lan.Select_Sections_Desc
                                || 'Select the sections to create for every generated class.' %></p>
                        <div class="auto-section-options">
                            <% (typeof validSections !=='undefined' && validSections.length ? validSections :
                                ['A','B','C','D','E','F']).forEach(section=> { %>
                                <label class="auto-section-option flex items-center gap-2">
                                    <input type="checkbox" name="sections" value="<%= section %>" <%=section==='A'
                                        ? 'checked' : '' %>>
                                    <span><%- lan.Section || 'Section' %>
                                            <%= section %></span>
                                </label>
                                <% }) %>
                        </div>
                        <p class="text-xs text-rose-500 mt-2 hidden animate-pulse" id="inlineSectionError"><%-
                                lan.Select_At_Least_One_Section_Error || 'Please select at least one section.' %></p>
                    </div>
                    <div>
                        <label
                            class="form-label font-extrabold text-xs text-slate-400 uppercase tracking-wider mb-2 block"><%-
                                lan.Mediums || 'Mediums' %> *</label>
                        <div class="flex gap-2 flex-wrap">
                            <% (schoolMediums && schoolMediums.length ? schoolMediums : [primaryMedium || 'English'
                                ]).forEach(med=> { %>
                                <label
                                    class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-sm font-semibold text-slate-700 hover:bg-emerald-50/50 hover:border-emerald-400 transition"
                                    style="border-width: 1.5px;">
                                    <input type="checkbox" name="mediums" value="<%= med %>" checked
                                        class="w-3.5 h-3.5 accent-emerald-600">
                                    <%= med %>
                                </label>
                                <% }) %>
                        </div>
                    </div>
                    <div class="bg-slate-50/80 rounded-xl p-4 border border-slate-200/60">
                        <label
                            class="form-label font-extrabold text-xs text-slate-500 uppercase tracking-wider mb-1 block">
                            <%- lan.Stream || 'Streams' %> (<%- lan.Required_For_Class_11_12 || 'for Class 11 & 12' %>)
                        </label>
                        <span class="text-[11px] text-slate-400 block mb-3"><%- lan.Select_Streams_School_Offers
                                || 'Select the streams your school offers' %></span>
                        <div class="flex gap-2 flex-wrap">
                            <label
                                class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg border border-blue-300 bg-blue-50 text-sm font-semibold text-blue-700 hover:bg-blue-100/50 transition">
                                <input type="checkbox" name="streams" value="Science" checked
                                    class="w-3.5 h-3.5 accent-blue-600">
                                <i class="fa-solid fa-flask"></i> <%- lan.Science || 'Science' %>
                            </label>
                            <label
                                class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg border border-emerald-300 bg-emerald-50 text-sm font-semibold text-emerald-700 hover:bg-emerald-100/50 transition">
                                <input type="checkbox" name="streams" value="Commerce" checked
                                    class="w-3.5 h-3.5 accent-emerald-600">
                                <i class="fa-solid fa-chart-line"></i> <%- lan.Commerce || 'Commerce' %>
                            </label>
                            <label
                                class="flex items-center gap-2 cursor-pointer px-3 py-2 rounded-lg border border-amber-300 bg-amber-50 text-sm font-semibold text-amber-700 hover:bg-amber-100/50 transition">
                                <input type="checkbox" name="streams" value="Arts" checked
                                    class="w-3.5 h-3.5 accent-amber-600">
                                <i class="fa-solid fa-palette"></i> <%- lan.Arts || 'Arts' %>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-4 border-t border-slate-100 bg-slate-50/50 flex gap-3 justify-end">
                    <button type="button" id="cancelAutoGenBtn" class="btn btn-secondary"><%- lan.Cancel || 'Cancel'
                            %></button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> <%- lan.Generate || 'Generate' %>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <script>
        const inlineAutoGenerateForm = document.getElementById('inlineAutoGenerateForm');
        if (inlineAutoGenerateForm) {
            inlineAutoGenerateForm.addEventListener('submit', function (event) {
                const selectedSections = inlineAutoGenerateForm.querySelectorAll('input[name="sections"]:checked');
                const sectionError = document.getElementById('inlineSectionError');
                if (selectedSections.length === 0) {
                    event.preventDefault();
                    sectionError.classList.remove('hidden');
                    sectionError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                };
                sectionError.classList.add('hidden');
            });
        };

        document.querySelectorAll('form[data-confirm]').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                const msg = this.dataset.confirm || 'Are you sure?';
                if (!confirm(msg)) {
                    e.preventDefault();
                }
            });
        });

        document.querySelectorAll('.section-modal-trigger').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openSectionModal(this.dataset.classId, this.dataset.classLabel, this.dataset.section);
            });
        });

        const openAutoGenBtn = document.getElementById('openAutoGenBtn');
        if (openAutoGenBtn) {
            openAutoGenBtn.addEventListener('click', function () {
                document.getElementById('autoGenModal').classList.remove('hidden');
            });
        }

        const closeAutoGenBtn = document.getElementById('closeAutoGenBtn');
        if (closeAutoGenBtn) {
            closeAutoGenBtn.addEventListener('click', function () {
                document.getElementById('autoGenModal').classList.add('hidden');
            });
        }

        const cancelAutoGenBtn = document.getElementById('cancelAutoGenBtn');
        if (cancelAutoGenBtn) {
            cancelAutoGenBtn.addEventListener('click', function () {
                document.getElementById('autoGenModal').classList.add('hidden');
            });
        }

        const openAddClassBtn = document.getElementById('openAddClassBtn');
        if (openAddClassBtn) {
            openAddClassBtn.addEventListener('click', function () {
                document.getElementById('addClassModal').classList.remove('hidden');
            });
        }

        const openAddClassEmptyBtn = document.getElementById('openAddClassEmptyBtn');
        if (openAddClassEmptyBtn) {
            openAddClassEmptyBtn.addEventListener('click', function () {
                document.getElementById('addClassModal').classList.remove('hidden');
            });
        }

        const closeAddClassBtn = document.getElementById('closeAddClassBtn');
        if (closeAddClassBtn) {
            closeAddClassBtn.addEventListener('click', function () {
                document.getElementById('addClassModal').classList.add('hidden');
            });
        }

        const cancelAddClassBtn = document.getElementById('cancelAddClassBtn');
        if (cancelAddClassBtn) {
            cancelAddClassBtn.addEventListener('click', function () {
                document.getElementById('addClassModal').classList.add('hidden');
            });
        }

        const closeSectionModalBtn = document.getElementById('closeSectionModalBtn');
        if (closeSectionModalBtn) {
            closeSectionModalBtn.addEventListener('click', closeSectionModal);
        }

        document.getElementById('autoGenModal').addEventListener('click', function (e) {
            if (e.target === this) this.classList.add('hidden');
        });

        document.getElementById('addClassModal').addEventListener('click', function (e) {
            if (e.target === this) this.classList.add('hidden');
        });

        let currentClassId = null;
        function openSectionModal(classId, className, section) {
            currentClassId = classId;
            const secModal = document.getElementById('sectionModal');
            const txtLoading = secModal ? (secModal.dataset.loading || 'Loading student list...') : 'Loading student list...';
            const txtStudent = secModal ? (secModal.dataset.student || 'student') : 'student';
            const txtStudents = secModal ? (secModal.dataset.students || 'students') : 'students';
            const txtEnrolled = secModal ? (secModal.dataset.enrolled || 'enrolled') : 'enrolled';
            const txtNoStudents = secModal ? (secModal.dataset.noStudents || 'No students in this section') : 'No students in this section';
            const txtNoStudentsDesc = secModal ? (secModal.dataset.noStudentsDesc || 'Add students and assign them to this section') : 'Add students and assign them to this section';
            const txtAddStudent = secModal ? (secModal.dataset.addStudent || 'Add Student') : 'Add Student';
            const txtRoll = secModal ? (secModal.dataset.roll || 'Roll') : 'Roll';

            document.getElementById('modalTitle').textContent = className + ' — Section ' + section;
            document.getElementById('modalSubtitle').textContent = txtLoading;
            document.getElementById('modalCount').textContent = '';
            document.getElementById('modalLoading').classList.remove('hidden');
            document.getElementById('studentsList').classList.add('hidden');
            document.getElementById('modalError').classList.add('hidden');
            document.getElementById('modalViewAllLink').classList.add('hidden');

            secModal.classList.remove('hidden');
            secModal.classList.add('flex');
            document.body.style.overflow = 'hidden';

            fetch('/schooladmin/classes/' + classId + '/students')
                .then(r => r.json())
                .then(data => {
                    document.getElementById('modalLoading').classList.add('hidden');
                    if (!data.success) throw new Error(data.message || 'Error');

                    document.getElementById('modalSubtitle').textContent = className + ' — Section ' + section;
                    const unit = data.count !== 1 ? txtStudents : txtStudent;
                    document.getElementById('modalCount').textContent = data.count + ' ' + unit + ' ' + txtEnrolled;

                    let html = '';
                    if (data.students.length === 0) {
                        html = `<div class="flex flex-col items-center justify-center py-14 text-center">
                        <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center mb-3">
                            <i class="fa-solid fa-user-slash text-2xl text-slate-300"></i>
                        </div>
                        <p class="text-sm font-semibold text-gray-500">${txtNoStudents}</p>
                        <p class="text-xs text-gray-400 mt-1">${txtNoStudentsDesc}</p>
                        <a href="/schooladmin/students/add" class="btn btn-primary mt-4 py-2 px-4 text-xs">
                            <i class="fa-solid fa-plus mr-1"></i>${txtAddStudent}
                        </a>
                    </div>`;
                    } else {
                        html = '<div class="divide-y divide-slate-100">';
                        data.students.forEach((s) => {
                            const name = s.first_name + ' ' + (s.last_name || '');
                            const initial = (s.first_name || 'S').charAt(0).toUpperCase();
                            const genderColor = s.gender === 'female' ? '#DB2777' : s.gender === 'male' ? '#0891B2' : '#64748B';
                            const genderBg = s.gender === 'female' ? '#FDF2F8' : s.gender === 'male' ? '#EFF6FF' : '#F8FAFC';
                            const statusDot = s.status === 'active' ? '<span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span>' : '<span class="relative flex h-2 w-2"><span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span></span>';
                            const avatarHtml = s.image ? `<img src="${s.image}" alt="${name}" class="student-avatar w-10 h-10 rounded-full object-cover border-2 border-slate-200 flex-shrink-0">` : `<div class="student-avatar-placeholder w-10 h-10 rounded-full flex items-center justify-center font-extrabold text-sm flex-shrink-0" style="background:${genderBg}; color:${genderColor};">${initial}</div>`;

                            html += `<div class="student-row flex items-center gap-3 py-2.5 px-3 rounded-lg transition-all cursor-pointer hover:bg-slate-50" onclick="window.location='/schooladmin/students/${s.id}/view'">
                            ${avatarHtml}
                            <div class="flex-1 min-w-0">
                                <div class="font-bold text-sm text-slate-800 truncate">${name}</div>
                                <div class="text-[11px] text-slate-400 flex items-center gap-2 mt-0.5">
                                    ${s.admission_no ? '<span class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-[10px]">' + s.admission_no + '</span>' : ''}
                                    ${s.roll_no ? '<span class="font-semibold text-slate-500">· ' + txtRoll + ' ' + s.roll_no + '</span>' : ''}
                                </div>
                            </div>
                            <div class="flex items-center gap-3 flex-shrink-0">
                                <div class="flex items-center gap-1.5">
                                    ${statusDot}
                                    <span class="text-[10px] font-bold capitalize px-2.5 py-0.5 rounded-full" style="background:${genderBg}; color:${genderColor};">
                                        ${s.gender || '—'}
                                    </span>
                                </div>
                                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>
                            </div>
                        </div>`;
                        });
                        html += '</div>';
                    };

                    document.getElementById('studentsList').innerHTML = html;
                    document.getElementById('studentsList').classList.remove('hidden');

                    const viewAll = document.getElementById('modalViewAllLink');
                    viewAll.href = '/schooladmin/students?class_id=' + classId;
                    viewAll.classList.remove('hidden');
                })
                .catch(err => {
                    document.getElementById('modalLoading').classList.add('hidden');
                    document.getElementById('modalError').classList.remove('hidden');
                    console.error(err);
                });
        };

        function closeSectionModal() {
            const modal = document.getElementById('sectionModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
            currentClassId = null;
        };

        document.getElementById('sectionModal').addEventListener('click', function (e) {
            if (e.target === this) closeSectionModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeSectionModal();
        });
    </script>