                                                                        <div class="class-avatar-box">
                                                                            <i class="fa-solid <%= icon %>"></i>
                                                                        </div>
                                                                        <div class="class-summary-copy">
                                                                            <div
                                                                                class="font-bold text-gray-800 text-sm">
                                                                                <%- lan.Class || 'Class' %>
                                                                                    <%= grp.name %> - <%= grp.medium %>
                                                                                            <span
                                                                                                class="ml-1 px-2 py-0.5 rounded-full text-[9px] font-extrabold uppercase tracking-wider"
                                                                                                style="background: var(--group-color-15); color: var(--group-color);">
                                                                                                <%= grp.stream %>
                                                                                            </span>
                                                                            </div>
                                                                            <div class="text-[11px] text-gray-400">
                                                                                <%= grp.sections.length %> <%-
                                                                                        lan.Sections || 'sections' %> ·
                                                                                        <%= totalSec %> <%- lan.Students
                                                                                                || 'students' %>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div
                                                                        class="class-section-actions-list flex flex-col gap-1.5 ml-2 flex-shrink-0">
                                                                        <% grp.sections.forEach(r=> { %>
                                                                            <div
                                                                                class="class-section-action-item flex gap-1 items-center justify-end">
                                                                                <span
                                                                                    class="text-[10px] font-bold text-slate-400 mr-0.5"><%-
                                                                                        lan.Section || 'Sec' %>
                                                                                        <%= r.section %>:</span>
                                                                                <a href="/schooladmin/classes/<%= r.id %>/edit"
                                                                                    class="btn-icon btn-edit-icon"
                                                                                    title="<%- lan.Edit_Section || 'Edit Section' %> <%= r.section %>">
                                                                                    <i class="fa-solid fa-pen"
                                                                                        style="font-size: 8px;"></i>
                                                                                </a>
                                                                                <form
                                                                                    action="/schooladmin/classes/<%= r.id %>/delete"
                                                                                    method="POST"
                                                                                    style="display:inline;" <% const
                                                                                    _delMsg=r.label || ((lan.Class
                                                                                    || 'Class' ) + ' ' + grp.name
                                                                                    + ' - ' + r.section + ' - ' +
                                                                                    grp.medium + ' - ' + grp.stream); %>
                                                                                    data-confirm="Delete <%= _delMsg %>
                                                                                        ?">
                                                                                        <button type="submit"
                                                                                            class="btn-icon btn-danger-icon"
                                                                                            title="<%- lan.Delete_Section || 'Delete Section' %> <%= r.section %>">
                                                                                            <i class="fa-solid fa-trash"
                                                                                                style="font-size: 8px;"></i>
                                                                                        </button>
                                                                                </form>
                                                                            </div>
                                                                            <% }) %>
                                                                    </div>
                                                                </div>
                                                                <div
                                                                    class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">
                                                                    <%- lan.Sections || 'Sections' %>
