<%- include('../../partials/head') %>
<style>
    :root {
        --cls-primary: #10B981;
        --cls-primary-dark: #059669;
        --cls-primary-light: #D1FAE5;
        --cls-primary-50: #ECFDF5;
        --cls-secondary: #0EA5E9;
        --cls-danger: #EF4444;
        --cls-warning: #F59E0B;
        --cls-info: #6366F1;
        --cls-success: #22C55E;
        --cls-gray-50: #F9FAFB;
        --cls-gray-100: #F3F4F6;
        --cls-gray-200: #E5E7EB;
        --cls-gray-300: #D1D5DB;
        --cls-gray-400: #9CA3AF;
        --cls-gray-500: #6B7280;
        --cls-gray-600: #4B5563;
        --cls-gray-700: #374151;
        --cls-gray-800: #1F2937;
        --cls-gray-900: #111827;
        --cls-white: #FFFFFF;
        --cls-shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
        --cls-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        --cls-shadow-md: 0 10px 15px -3px rgba(0,0,0,0.08), 0 4px 6px -2px rgba(0,0,0,0.04);
        --cls-shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
        --cls-shadow-xl: 0 25px 50px -12px rgba(0,0,0,0.15);
        --cls-radius-sm: 8px;
        --cls-radius: 12px;
        --cls-radius-lg: 16px;
        --cls-radius-xl: 24px;
        --cls-radius-full: 9999px;
    }

    .classes-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }
    .classes-page-heading { min-width: 0; }
    .classes-page-heading h2 {
        font-size: 26px !important;
        font-weight: 800 !important;
        color: var(--cls-gray-900);
        letter-spacing: -0.5px;
        margin-bottom: 6px;
        line-height: 1.2;
    }
    .classes-page-heading p {
        font-size: 13px;
        color: var(--cls-gray-400);
        font-weight: 500;
        margin: 0;
    }
    .classes-page-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
    }
    .classes-page-actions form { margin: 0; }

    .classes-page-actions .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: var(--cls-radius);
        font-size: 13px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        border: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        white-space: nowrap;
    }
    .classes-page-actions .btn-primary {
        background: linear-gradient(135deg, var(--cls-primary) 0%, var(--cls-primary-dark) 100%);
        color: white;
        box-shadow: 0 4px 14px rgba(16,185,129,0.35);
    }
    .classes-page-actions .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16,185,129,0.45);
    }
    .classes-page-actions .btn-secondary {
        background: var(--cls-white);
        color: var(--cls-gray-600);
        border: 1.5px solid var(--cls-gray-200);
    }
    .classes-page-actions .btn-secondary:hover {
        background: var(--cls-gray-50);
        border-color: var(--cls-gray-300);
        transform: translateY(-1px);
    }
    .classes-page-actions .btn-danger {
        background: var(--cls-white);
        color: var(--cls-danger);
        border: 1.5px solid #FECACA;
    }
    .classes-page-actions .btn-danger:hover {
        background: #FEF2F2;
        border-color: var(--cls-danger);
        transform: translateY(-1px);
    }

    .stats-card {
        background: var(--cls-white);
        border: 1px solid var(--cls-gray-100);
        border-radius: var(--cls-radius-lg);
        padding: 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: var(--cls-shadow-sm);
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }
    .stats-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--cls-shadow-md);
        border-color: var(--cls-gray-200);
    }
    .stats-card::after {
        content: '';
        position: absolute;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: var(--card-glow, var(--cls-primary));
        opacity: 0.03;
        bottom: -60px;
        right: -60px;
        transition: all 0.3s ease;
    }
    .stats-card:hover::after {
        transform: scale(1.2);
        opacity: 0.06;
    }
    .stats-card .stats-icon {
        width: 52px;
        height: 52px;
        border-radius: var(--cls-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
        position: relative;
        z-index: 2;
    }

    .section-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        margin-top: 8px;
    }
    .section-divider i {
        font-size: 14px;
        color: var(--cls-gray-400);
    }
    .section-divider span {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--cls-gray-400);
    }
    .section-divider .line {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--cls-gray-200) 0%, transparent 100%);
    }

    .class-summary-card {
        background: var(--cls-white);
        border: 1px solid var(--cls-gray-100);
        border-radius: var(--cls-radius-lg);
        padding: 24px;
        box-shadow: var(--cls-shadow-sm);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    .class-summary-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--cls-shadow-lg);
        border-color: var(--group-color-30, var(--cls-gray-200));
    }
    .class-summary-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        transition: height 0.2s ease;
    }
    .class-summary-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 16px;
    }
    .class-summary-main {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        flex: 1;
    }
    .class-avatar-box {
        width: 48px;
        height: 48px;
        border-radius: var(--cls-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 18px;
        background-color: var(--group-color-15);
        color: var(--group-color);
        flex-shrink: 0;
        position: relative;
        transition: transform 0.2s ease;
    }
    .class-summary-card:hover .class-avatar-box {
        transform: scale(1.05);
    }
    .class-avatar-box::after {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: calc(var(--cls-radius) + 3px);
        border: 2px solid currentColor;
        opacity: 0.15;
    }
    .class-summary-copy { min-width: 0; }
    .class-summary-copy .font-bold.text-sm {
        font-size: 15px !important;
        font-weight: 700;
        color: var(--cls-gray-800);
        margin-bottom: 3px;
    }
    .class-summary-copy .text-\[11px\] {
        font-size: 12px !important;
        color: var(--cls-gray-400);
        font-weight: 500;
    }

    .btn-icon {
        width: 24px;
        height: 24px;
        border-radius: var(--cls-radius-sm);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-edit-icon {
        background: var(--cls-gray-50);
        color: var(--cls-gray-500);
    }
    .btn-edit-icon:hover {
        background: #DBEAFE;
        color: #2563EB;
        transform: scale(1.1);
    }
    .btn-danger-icon {
        background: var(--cls-gray-50);
        color: var(--cls-gray-400);
    }
    .btn-danger-icon:hover {
        background: #FEF2F2;
        color: var(--cls-danger);
        transform: scale(1.1);
    }

    /* Section badges */
    .section-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: var(--cls-radius-full);
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        background-color: var(--group-color-15);
        color: var(--group-color);
        border: 1.5px solid var(--group-color-30);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    .section-badge::before {
        content: '';
        position: absolute;
        inset: 0;
        background: currentColor;
        opacity: 0;
        transition: opacity 0.2s;
    }
    .section-badge:hover::before { opacity: 0.08; }
    .section-badge:hover {
        transform: translateY(-2px);
        background-color: var(--group-color);
        color: var(--cls-white);
        border-color: var(--group-color);
        box-shadow: 0 6px 16px var(--group-color-30);
    }
    .section-badge .student-counter {
        width: 18px;
        height: 18px;
        border-radius: var(--cls-radius-full);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        background-color: var(--group-color);
        color: var(--cls-white);
        transition: all 0.2s ease;
    }
    .section-badge:hover .student-counter {
        background-color: var(--cls-white);
        color: var(--group-color);
    }
    .section-badge i.fa-chevron-right {
        font-size: 9px;
        opacity: 0.5;
        transition: all 0.2s;
    }
    .section-badge:hover i.fa-chevron-right {
        opacity: 1;
        transform: translateX(2px);
    }

    .classes-empty-card {
        background: var(--cls-white);
        border: 2px dashed var(--cls-gray-200);
        border-radius: var(--cls-radius-lg);
        padding: 48px 24px;
        transition: all 0.3s ease;
    }
    .classes-empty-card:hover {
        border-color: var(--cls-primary);
    }
    .empty-state-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: var(--cls-primary-50);
        color: var(--cls-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin: 0 auto 16px;
        transition: transform 0.3s ease;
    }
    .classes-empty-card:hover .empty-state-icon {
        transform: scale(1.1) rotate(-5deg);
    }
    .empty-state-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--cls-gray-700);
    }
    .empty-state-text {
        font-size: 14px;
        color: var(--cls-gray-400);
    }

    .modal-overlay {
        position: fixed !important;
        inset: 0 !important;
        z-index: 99999 !important;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(8px);
        transition: opacity 0.3s ease;
    }
    .modal-container {
        position: relative !important;
        z-index: 100000 !important;
        background: var(--cls-white);
        border-radius: var(--cls-radius-xl);
        box-shadow: var(--cls-shadow-xl);
        border: 1px solid rgba(255, 255, 255, 0.8);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: 88vh;
        transform: scale(0.95);
        opacity: 0;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    
    #sectionModal:not(.hidden) .modal-container,
    #addClassModal:not(.hidden) .modal-container,
    #autoGenModal:not(.hidden) .modal-container {
        animation: modalSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    #sectionModal:not(.hidden),
    #addClassModal:not(.hidden),
    #autoGenModal:not(.hidden) {
        animation: fadeIn 0.25s ease-out forwards;
    }

    @keyframes modalSlideUp {
        from { transform: scale(0.96) translateY(20px); opacity: 0; }
        to { transform: scale(1) translateY(0); opacity: 1; }
    }
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    #modalBody::-webkit-scrollbar {
        width: 6px;
    }
    #modalBody::-webkit-scrollbar-track {
        background: transparent;
    }
    #modalBody::-webkit-scrollbar-thumb {
        background: var(--cls-gray-300);
        border-radius: 3px;
    }
    #modalBody::-webkit-scrollbar-thumb:hover {
        background: var(--cls-gray-400);
    }

    .student-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: var(--cls-radius);
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .student-row:hover {
        background: var(--cls-gray-50);
        transform: translateX(4px);
    }
    .student-avatar {
        width: 40px;
        height: 40px;
        border-radius: var(--cls-radius-full);
        object-fit: cover;
        border: 2px solid var(--cls-gray-200);
    }
    .student-avatar-placeholder {
        width: 40px;
        height: 40px;
        border-radius: var(--cls-radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }
    
    .auto-section-options {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }
    .auto-section-option {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px;
        border: 2px solid var(--cls-gray-200);
        border-radius: var(--cls-radius);
        background: var(--cls-white);
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: var(--cls-gray-600);
        transition: all 0.2s;
    }
    .auto-section-option:hover {
        border-color: var(--cls-primary);
        background: var(--cls-primary-50);
    }
    .auto-section-option input {
        width: 16px;
        height: 16px;
        accent-color: var(--cls-primary);
        margin: 0;
    }
    .auto-section-option:has(input:checked) {
        border-color: var(--cls-primary);
        background: var(--cls-primary-50);
        color: var(--cls-primary-dark);
    }

    .form-group { margin-bottom: 20px; }
    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--cls-gray-700);
        margin-bottom: 8px;
    }
    .form-input,
    .form-select {
        width: 100%;
        padding: 11px 16px;
        border: 1.5px solid var(--cls-gray-200);
        border-radius: var(--cls-radius);
        font-size: 14px;
        font-family: inherit;
        color: var(--cls-gray-800);
        background: var(--cls-white);
        transition: all 0.2s;
        outline: none;
    }
    .form-input:focus,
    .form-select:focus {
        border-color: var(--cls-primary);
        box-shadow: 0 0 0 3px rgba(16,185,129,0.1);
    }

    @media (max-width: 768px) {
        .classes-page-header {
            flex-direction: column;
            align-items: stretch;
            gap: 16px;
        }
        .classes-page-header h2 { font-size: 22px !important; }
        .classes-page-actions {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            width: 100%;
        }
        .classes-page-actions form { grid-column: 1 / -1; }
        .classes-page-actions .btn {
            width: 100%;
            min-width: 0;
            min-height: 44px;
        }
        .classes-stats { grid-template-columns: 1fr !important; gap: 12px !important; }
        .auto-section-options { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (max-width: 420px) {
        .classes-page-actions { grid-template-columns: 1fr; }
        .classes-page-actions form { grid-column: auto; }
    }

    [data-theme="dark"] .classes-page-heading h2,
    .light-mode-disabled .classes-page-heading h2 {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .classes-page-actions .btn-secondary,
    .light-mode-disabled .classes-page-actions .btn-secondary {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .classes-page-actions .btn-secondary:hover,
    .light-mode-disabled .classes-page-actions .btn-secondary:hover {
        background: #1E293B !important;
        border-color: #3B82F6 !important;
        color: #60A5FA !important;
    }

    [data-theme="dark"] .classes-page-actions .btn-danger,
    .light-mode-disabled .classes-page-actions .btn-danger {
        background: rgba(239, 68, 68, 0.15) !important;
        border-color: rgba(239, 68, 68, 0.35) !important;
        color: #F87171 !important;
    }
    [data-theme="dark"] .classes-page-actions .btn-danger:hover,
    .light-mode-disabled .classes-page-actions .btn-danger:hover {
        background: rgba(239, 68, 68, 0.25) !important;
        border-color: #EF4444 !important;
    }

    [data-theme="dark"] .stats-card,
    .light-mode-disabled .stats-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .stats-card .text-slate-800,
    .light-mode-disabled .stats-card .text-slate-800 {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .section-divider .line,
    .light-mode-disabled .section-divider .line {
        background: linear-gradient(90deg, #242F4D 0%, transparent 100%) !important;
    }

    [data-theme="dark"] .class-summary-card,
    .light-mode-disabled .class-summary-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .class-summary-card:hover,
    .light-mode-disabled .class-summary-card:hover {
        border-color: var(--group-color, #3B82F6) !important;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35) !important;
    }

    [data-theme="dark"] .class-summary-copy .font-bold,
    [data-theme="dark"] .class-summary-copy .text-gray-800,
    .light-mode-disabled .class-summary-copy .font-bold,
    .light-mode-disabled .class-summary-copy .text-gray-800 {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .class-summary-copy .text-\[11px\],
    [data-theme="dark"] .class-summary-copy .text-gray-400,
    .light-mode-disabled .class-summary-copy .text-\[11px\],
    .light-mode-disabled .class-summary-copy .text-gray-400 {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .btn-edit-icon,
    .light-mode-disabled .btn-edit-icon {
        background: #1E293B !important;
        color: #60A5FA !important;
        border: 1px solid #242F4D !important;
    }
    [data-theme="dark"] .btn-edit-icon:hover,
    .light-mode-disabled .btn-edit-icon:hover {
        background: rgba(59, 130, 246, 0.25) !important;
        color: #93C5FD !important;
        border-color: #3B82F6 !important;
    }

    [data-theme="dark"] .btn-danger-icon,
    .light-mode-disabled .btn-danger-icon {
        background: rgba(239, 68, 68, 0.15) !important;
        color: #F87171 !important;
        border: 1px solid rgba(239, 68, 68, 0.3) !important;
    }
    [data-theme="dark"] .btn-danger-icon:hover,
    .light-mode-disabled .btn-danger-icon:hover {
        background: rgba(239, 68, 68, 0.3) !important;
        color: #FCA5A5 !important;
        border-color: #EF4444 !important;
    }

    [data-theme="dark"] .section-badge,
    .light-mode-disabled .section-badge {
        background-color: rgba(255, 255, 255, 0.05) !important;
        color: var(--group-color) !important;
        border: 1.5px solid rgba(255, 255, 255, 0.1) !important;
    }
    [data-theme="dark"] .section-badge:hover,
    .light-mode-disabled .section-badge:hover {
        background-color: var(--group-color) !important;
        color: #FFFFFF !important;
        border-color: var(--group-color) !important;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4) !important;
    }
    [data-theme="dark"] .section-badge .student-counter,
    .light-mode-disabled .section-badge .student-counter {
        background-color: var(--group-color) !important;
        color: #FFFFFF !important;
    }
    [data-theme="dark"] .section-badge:hover .student-counter,
    .light-mode-disabled .section-badge:hover .student-counter {
        background-color: #FFFFFF !important;
        color: var(--group-color) !important;
    }

    [data-theme="dark"] .modal-container,
    .light-mode-disabled .modal-container {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7) !important;
    }

    [data-theme="dark"] .modal-container [class*="bg-slate-50"],
    .light-mode-disabled .modal-container [class*="bg-slate-50"] {
        background: #101726 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .modal-container h3,
    [data-theme="dark"] #modalTitle,
    .light-mode-disabled .modal-container h3,
    .light-mode-disabled #modalTitle {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .modal-container button[class*="rounded-full bg-slate-100"],
    .light-mode-disabled .modal-container button[class*="rounded-full bg-slate-100"] {
        background: #1E293B !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .modal-container button[class*="rounded-full bg-slate-100"]:hover,
    .light-mode-disabled .modal-container button[class*="rounded-full bg-slate-100"]:hover {
        background: rgba(239, 68, 68, 0.2) !important;
        color: #F87171 !important;
    }

    [data-theme="dark"] .form-label,
    .light-mode-disabled .form-label {
        color: #CBD5E1 !important;
    }

    [data-theme="dark"] .form-input,
    [data-theme="dark"] .form-select,
    .light-mode-disabled .form-input,
    .light-mode-disabled .form-select {
        background: #0F172A !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .form-input:focus,
    [data-theme="dark"] .form-select:focus,
    .light-mode-disabled .form-input:focus,
    .light-mode-disabled .form-select:focus {
        border-color: #10B981 !important;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2) !important;
    }

    [data-theme="dark"] .auto-section-option,
    .light-mode-disabled .auto-section-option {
        background: #101726 !important;
        border-color: #242F4D !important;
