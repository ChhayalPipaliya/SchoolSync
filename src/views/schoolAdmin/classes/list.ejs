<%- include('../../partials/head') %>
<style>
    @media (max-width: 640px) {
        .classes-main-content {
            padding: 12px !important;
        }
        .classes-main-content-inner {
            padding: 0 12px 12px !important;
        }
        .hero-banner-inner {
            flex-direction: column !important;
            align-items: stretch !important;
            text-align: center;
        }
        .hero-banner-actions {
            flex-direction: column !important;
            width: 100% !important;
        }
        .hero-banner-actions .btn,
        .hero-banner-actions button {
            width: 100% !important;
            justify-content: center;
        }
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content classes-main-content" style="padding:0;">
            <!-- Hero Banner -->
            <div style="background:linear-gradient(135deg, #059669, #047857); border-radius:12px; padding:24px; color:#fff; margin:24px 24px 20px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(5,150,105,0.15);">
                <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
                <div class="hero-banner-inner" style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
                    <div>
                        <h1 style="font-size:24px; font-weight:700; margin:0;">Classes & Sections</h1>
                        <p style="font-size:13px; opacity:0.9; margin:4px 0 0;">Manage academic grades, student distribution, streams and sections</p>
                    </div>
                    <div class="hero-banner-actions" style="display:flex; gap:10px;">
                        <a href="/schooladmin/classes/auto-generate" class="btn btn-secondary" style="font-size:13px; font-weight:600; padding:8px 16px; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Auto Generate
                        </a>
                        <button onclick="document.getElementById('addClassModal').style.display='flex'" class="btn" style="background:#fff; color:#059669; border:none; font-weight:600; padding:10px 20px; font-size:13px; border-radius:8px; display:inline-flex; align-items:center; gap:8px; cursor:pointer;">
                            <i class="fas fa-plus"></i> Add Class
                        </button>
                    </div>
                </div>
            </div>
 
            <div class="classes-main-content-inner" style="padding:0 24px 24px;">
                <%- include('../../partials/flashMessages') %>

                <!-- Classes Grid -->
                <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap:24px;">
                    <% classes.forEach(c=> { %>
                        <div class="card" style="padding:24px; border-radius:12px; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between;">
                            <div>
                                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
                                    <div>
                                        <h3 style="font-size:20px; font-weight:700; color:#0F172A; margin:0;">
                                            <%= c.class_name %>
                                        </h3>
                                        <p style="font-size:11px; color:#94A3B8; margin:4px 0 0;">Numeric Value: <%= c.numeric_value || 'N/A' %></p>
                                    </div>
                                    <span class="badge" style="
                                        padding:4px 10px; border-radius:9999px; font-size:11px; font-weight:700; text-transform:capitalize;
                                        <% if (c.status === 'active') { %>
                                            background:rgba(16, 185, 129, 0.15); color:#10B981;
                                        <% } else { %>
                                            background:rgba(239, 68, 68, 0.15); color:#EF4444;
                                        <% } %>
                                    ">
                                        <%= c.status %>
                                    </span>
                                </div>
                                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom:20px;">
                                    <div style="padding:12px; border-radius:8px; text-align:center; background:rgba(5,150,105,0.06); border:1px solid rgba(5,150,105,0.1);">
                                        <p style="font-size:24px; font-weight:800; color:#059669; margin:0;">
                                            <%= c.student_count %>
                                        </p>
                                        <p style="font-size:10px; color:#94A3B8; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin:4px 0 0;">Students</p>
                                    </div>
                                    <div style="padding:12px; border-radius:8px; text-align:center; background:#F8FAFC; border:1px solid #E2E8F0;">
                                        <p style="font-size:24px; font-weight:800; color:#475569; margin:0;">
                                            <%= c.section_count %>
                                        </p>
                                        <p style="font-size:10px; color:#94A3B8; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin:4px 0 0;">Sections</p>
                                    </div>
                                </div>
                                <div style="margin-bottom:20px;">
                                    <p style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin:0 0 8px;">Sections:</p>
                                    <div style="display:flex; flex-wrap:wrap; gap:8px;">
                                        <% const classSections = sections.filter(s=> s.class_id === c.id); %>
                                        <% if (classSections.length === 0) { %>
                                            <span style="font-size:12px; color:#94A3B8;">No sections assigned</span>
                                        <% } else { %>
                                            <% classSections.forEach(s => { %>
                                                <span style="padding:4px 10px; background:#F1F5F9; border:1px solid #E2E8F0; border-radius:9999px; font-size:11px; font-weight:600; color:#475569;">
                                                    <%= s.section_name %>
                                                </span>
                                            <% }) %>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <div style="display:flex; gap:10px; padding-top:16px; border-top:1px solid #F1F5F9; margin-top:8px;">
                                <button onclick="editClass('<%= c.id %>', '<%= c.class_name %>', '<%= c.numeric_value %>', '<%= c.stream %>', '<%= c.status %>')" class="btn btn-secondary" style="flex:1; height:32px; font-size:12px; font-weight:600; display:inline-flex; align-items:center; justify-content:center; gap:6px; cursor:pointer;">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <form method="POST" action="/schooladmin/classes/<%= c.id %>/delete" style="flex:1; margin:0;" onsubmit="return confirm('Delete this class? All sections will be removed.')">
                                    <button type="submit" class="btn" style="width:100%; background:rgba(239,68,68,0.15); color:#EF4444; border:none; padding:0; font-size:12px; font-weight:600; border-radius:6px; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; gap:6px; height:32px;">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Add Class Modal -->
            <div id="addClassModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); align-items:center; justify-content:center; z-index:9999; padding:20px;">
                <div class="card" style="width:100%; max-width:400px; padding:24px; border-radius:12px; margin-bottom:0; box-shadow:0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);">
                    <h3 style="font-size:18px; font-weight:700; color:#0F172A; margin:0 0 16px;">Add New Class</h3>
                    <form method="POST" action="/schooladmin/classes/add" style="display:flex; flex-direction:column; gap:16px; margin:0;">
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label" style="display:block; font-size:11px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Class Name *</label>
                            <input type="text" name="class_name" required class="form-input" placeholder="e.g., Class 10, Nursery" style="width:100%; min-height:38px;">
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label" style="display:block; font-size:11px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Numeric Value</label>
                            <input type="number" name="numeric_value" class="form-input" placeholder="10" style="width:100%; min-height:38px;">
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label" style="display:block; font-size:11px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Stream (for 11-12)</label>
                            <select name="stream" class="form-select" style="width:100%; min-height:38px;">
                                <option value="">None</option>
                                <option value="science">Science</option>
                                <option value="commerce">Commerce</option>
                                <option value="arts">Arts</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label" style="display:block; font-size:11px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Sections (comma separated)</label>
                            <input type="text" name="sections" class="form-input" placeholder="A, B, C" style="width:100%; min-height:38px;">
                        </div>
                        <div style="display:flex; gap:10px; margin-top:8px;">
                            <button type="submit" class="btn btn-primary" style="flex:1; height:38px; font-weight:600;">Add Class</button>
                            <button type="button" onclick="document.getElementById('addClassModal').style.display='none'" class="btn btn-secondary" style="flex:1; height:38px; font-weight:600;">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Edit Class Modal -->
            <div id="editClassModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); align-items:center; justify-content:center; z-index:9999; padding:20px;">
                <div class="card" style="width:100%; max-width:400px; padding:24px; border-radius:12px; margin-bottom:0; box-shadow:0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);">
                    <h3 style="font-size:18px; font-weight:700; color:#0F172A; margin:0 0 16px;">Edit Class</h3>
                    <form method="POST" id="editClassForm" action="" style="display:flex; flex-direction:column; gap:16px; margin:0;">
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label" style="display:block; font-size:11px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Class Name *</label>
                            <input type="text" name="class_name" id="editClassName" required class="form-input" style="width:100%; min-height:38px;">
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label" style="display:block; font-size:11px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Numeric Value</label>
                            <input type="number" name="numeric_value" id="editNumericValue" class="form-input" style="width:100%; min-height:38px;">
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label" style="display:block; font-size:11px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Stream</label>
                            <select name="stream" id="editStream" class="form-select" style="width:100%; min-height:38px;">
                                <option value="">None</option>
                                <option value="science">Science</option>
                                <option value="commerce">Commerce</option>
                                <option value="arts">Arts</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label" style="display:block; font-size:11px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Status</label>
                            <select name="status" id="editStatus" class="form-select" style="width:100%; min-height:38px;">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                        <div style="display:flex; gap:10px; margin-top:8px;">
                            <button type="submit" class="btn btn-primary" style="flex:1; height:38px; font-weight:600;">Update</button>
                            <button type="button" onclick="document.getElementById('editClassModal').style.display='none'" class="btn btn-secondary" style="flex:1; height:38px; font-weight:600;">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>

            <script>
                function editClass(id, name, numeric, stream, status) {
                    document.getElementById('editClassForm').action = '/schooladmin/classes/' + id + '/edit';
                    document.getElementById('editClassName').value = name;
                    document.getElementById('editNumericValue').value = numeric || '';
                    document.getElementById('editStream').value = stream || '';
                    document.getElementById('editStatus').value = status;
                    document.getElementById('editClassModal').style.display = 'flex';
                }
            </script>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>