<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Edit Class</h2>
                    <p class="text-xs text-gray-500 mt-1"><%= cls.label %></p>
                </div>
                <a href="/schooladmin/classes" class="btn btn-secondary w-full sm:w-auto justify-center">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Classes
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <div class="card max-w-2xl mx-auto">
                <div class="card-body p-6">
                    <form method="POST" action="/schooladmin/classes/<%= cls.id %>/edit" class="space-y-4">
                        <div class="form-group">
                            <label class="form-label">Class Name *</label>
                            <input type="text" name="class_name" value="<%= cls.class_name %>" required class="form-input" placeholder="e.g., 10, Nursery, LKG">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sections <span class="text-gray-400 font-normal">(comma separated)</span></label>
                            <input type="text" name="sections" value="<%= cls.sections || cls.section || 'A' %>" required class="form-input" placeholder="A, B, C">
                            <p class="text-[10px] text-gray-400 mt-1">Use simple section labels A-F. Sections with assigned students are marked inactive instead of deleted.</p>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Medium *</label>
                            <select name="medium" required class="form-select">
                                <% (schoolMediums || []).forEach(medium => { %>
                                    <option value="<%= medium %>" <%= cls.medium === medium ? 'selected' : '' %>><%= medium %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Stream</label>
                            <select name="stream" class="form-select">
                                <option value="General" <%= !cls.stream || cls.stream === 'General' ? 'selected' : '' %>>None / General</option>
                                <% validStreams.forEach(stream => { %>
                                    <option value="<%= stream %>" <%= cls.stream === stream ? 'selected' : '' %>><%= stream %></option>
                                <% }) %>
                            </select>
                            <p class="text-[10px] text-gray-400 mt-1">Streams are applied only for Class 11 and Class 12.</p>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:justify-end gap-3 pt-4 border-t border-slate-100">
                            <a href="/schooladmin/classes" class="btn btn-secondary w-full sm:w-auto text-center justify-center">Cancel</a>
                            <button type="submit" class="btn btn-primary w-full sm:w-auto justify-center">
                                <i class="fa-solid fa-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
