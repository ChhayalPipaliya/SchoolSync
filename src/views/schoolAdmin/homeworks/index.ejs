<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Homework Overview</h2>
                <p class="text-xs text-gray-500 mt-1">Monitor teacher-assigned tasks and deadlines</p>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card mb-6" style="border-left: 4px solid var(--primary);">
                <div class="card-body">
                    <form method="GET" action="/schooladmin/homework">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Class</label>
                                <select class="form-select" name="class_id">
                                    <option value="">All Classes</option>
                                    <% classes.forEach(function(c) { %>
                                        <option value="<%= c.id %>" <%= Number(filters.class_id) === Number(c.id) ? 'selected' : '' %>><%= c.name %> <%= c.section || '' %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Teacher</label>
                                <select class="form-select" name="teacher_id">
                                    <option value="">All Teachers</option>
                                    <% teachers.forEach(function(t) { %>
                                        <option value="<%= t.id %>" <%= Number(filters.teacher_id) === Number(t.id) ? 'selected' : '' %>><%= t.first_name %> <%= t.last_name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]">Subject</label>
                                <select class="form-select" name="subject_id">
                                    <option value="">All Subjects</option>
                                    <% subjects.forEach(function(s) { %>
                                        <option value="<%= s.id %>" <%= Number(filters.subject_id) === Number(s.id) ? 'selected' : '' %>><%= s.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div>
                                <button class="btn btn-primary w-full text-xs font-bold shadow-sm transition">
                                    <i class="fa-solid fa-filter"></i> Apply Filters
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <% if (homeworks.length > 0) { %>
                    <% homeworks.forEach(function(hw) {
                        const daysLeft = Math.ceil((new Date(hw.deadline) - new Date()) / (1000 * 60 * 60 * 24));
                        const isPastDue = daysLeft < 0;
                        const isExpiring = daysLeft >= 0 && daysLeft <= 2;
                    %>
                        <div class="card p-5 hover:shadow-md hover:-translate-y-0.5 transition-all">
                            <div class="flex justify-between items-start mb-3">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase
                                    <%= isPastDue ? 'bg-rose-50 text-rose-700 border border-rose-100' : isExpiring ? 'bg-amber-50 text-amber-700 border border-amber-100' : 'bg-emerald-50 text-emerald-700 border border-emerald-100' %>">
                                    <%= isPastDue ? 'Past Due' : isExpiring ? 'Expiring Soon' : 'On Track' %>
                                </span>
                                <div class="text-[11px] text-gray-400 font-semibold">
                                    <%= new Date(hw.deadline).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) %>
                                </div>
                            </div>
                            <div class="font-bold text-gray-800 mb-1"><%= hw.title %></div>
                            <div class="flex items-center gap-2 mb-3 text-xs text-gray-500">
                                <span class="flex items-center gap-1"><i class="fa-solid fa-graduation-cap"></i> <%= hw.className %> <%= hw.section || '' %></span>
                                <span class="text-gray-300">•</span>
                                <span class="flex items-center gap-1"><i class="fa-solid fa-book-open"></i> <%= hw.subjectName %></span>
                            </div>
                            <div class="text-sm text-gray-500 leading-relaxed min-h-[40px]">
                                <%= hw.description ? (hw.description.substring(0, 120) + (hw.description.length > 120 ? '...' : '')) : 'No additional details provided.' %>
                            </div>
                            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center gap-2 text-xs text-gray-400">
                                <div class="w-6 h-6 bg-slate-100 rounded-full flex items-center justify-center">
                                    <i class="fa-solid fa-user-tie text-[10px] text-gray-500"></i>
                                </div>
                                <%= hw.first_name %> <%= hw.last_name %>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-3 card text-center py-16">
                        <i class="fa-solid fa-list-check fa-2x text-gray-200 block mb-2"></i>
                        <span class="text-gray-400 text-sm">No homework assignments match your criteria.</span>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>