<%- include('../../partials/head', { title: `${lan.Leave_Calendar || 'Leave Calendar'} | SchoolSync` }) %>
<style>
    [data-theme="dark"] .text-gray-800,
    .light-mode-disabled .text-gray-800,
    [data-theme="dark"] .text-slate-800,
    .light-mode-disabled .text-slate-800,
    [data-theme="dark"] .text-slate-700,
    .light-mode-disabled .text-slate-700 {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .text-slate-600,
    .light-mode-disabled .text-slate-600,
    [data-theme="dark"] .text-slate-500,
    .light-mode-disabled .text-slate-500,
    [data-theme="dark"] .text-slate-400,
    .light-mode-disabled .text-slate-400 {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .border-slate-200,
    .light-mode-disabled .border-slate-200,
    [data-theme="dark"] .border-slate-100,
    .light-mode-disabled .border-slate-100 {
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .bg-slate-50,
    .light-mode-disabled .bg-slate-50 {
        background-color: #101726 !important;
        border-color: #242F4D !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .bg-slate-50\/60,
    .light-mode-disabled .bg-slate-50\/60,
    [data-theme="dark"] .bg-slate-50\/40,
    .light-mode-disabled .bg-slate-50\/40 {
        background-color: rgba(255, 255, 255, 0.02) !important;
    }
    [data-theme="dark"] .bg-emerald-50,
    .light-mode-disabled .bg-emerald-50 {
        background-color: rgba(16, 185, 129, 0.15) !important;
        color: #34D399 !important;
        border-color: rgba(16, 185, 129, 0.35) !important;
    }
    [data-theme="dark"] .btn-secondary,
    .light-mode-disabled .btn-secondary {
        background-color: #1E293B !important;
        border-color: #334155 !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .btn-secondary:hover,
    .light-mode-disabled .btn-secondary:hover {
        background-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .role-chip-teacher,
    .light-mode-disabled .role-chip-teacher {
        background-color: rgba(168, 85, 247, 0.15) !important;
        color: #C084FC !important;
        border-color: rgba(168, 85, 247, 0.35) !important;
    }
    [data-theme="dark"] .role-chip-student,
    .light-mode-disabled .role-chip-student {
        background-color: rgba(59, 130, 246, 0.15) !important;
        color: #60A5FA !important;
        border-color: rgba(59, 130, 246, 0.35) !important;
    }
    [data-theme="dark"] .role-chip-driver,
    .light-mode-disabled .role-chip-driver {
        background-color: rgba(249, 115, 22, 0.15) !important;
        color: #FB923C !important;
        border-color: rgba(249, 115, 22, 0.35) !important;
    }
    [data-theme="dark"] .role-chip-librarian,
    .light-mode-disabled .role-chip-librarian {
        background-color: rgba(20, 184, 166, 0.15) !important;
        color: #2DD4BF !important;
        border-color: rgba(20, 184, 166, 0.35) !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Leave_Calendar || 'Leave Calendar' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Leave_Calendar_Desc || 'Monthly overview of approved leave requests, color-coded by role' %></p>
                </div>
                <a href="/schooladmin/leaves" class="btn btn-secondary flex items-center gap-2 text-xs font-bold">
                    <i class="fa-solid fa-list"></i> <%- lan.List_View || 'List View' %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-4 mb-6">
                <a href="/schooladmin/leaves" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-slate-600 hover:bg-slate-50"><%- lan.All_Applications || 'All Applications' %></a>
                <a href="/schooladmin/leaves/calendar" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-100/50"><%- lan.Leave_Calendar || 'Leave Calendar' %></a>
            </div>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
                <div class="flex items-center justify-between sm:justify-start gap-3">
                    <a href="/schooladmin/leaves/calendar?month=<%= prevMonth %>&year=<%= prevYear %>"
                       class="btn btn-secondary btn-sm w-8 h-8 flex items-center justify-center p-0">
                        <i class="fa-solid fa-chevron-left text-xs"></i>
                    </a>
                    <h3 class="text-base sm:text-lg font-bold text-slate-800 min-w-[140px] sm:min-w-[160px] text-center">
                        <%= monthName %> <%= year %>
                    </h3>
                    <a href="/schooladmin/leaves/calendar?month=<%= nextMonth %>&year=<%= nextYear %>"
                       class="btn btn-secondary btn-sm w-8 h-8 flex items-center justify-center p-0">
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </a>
                    <a href="/schooladmin/leaves/calendar" class="btn btn-secondary btn-sm text-[11px] font-bold"><%- lan.Today || 'Today' %></a>
                </div>
                <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2">
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-100">
                        <span class="w-2.5 h-2.5 rounded-full bg-purple-500 flex-shrink-0"></span>
                        <span class="text-xs font-bold text-slate-600 truncate"><%= monthStats.teachers || 0 %> <%= monthStats.teachers != 1 ? (lan.Teachers || 'Teachers') : (lan.Teacher || 'Teacher') %></span>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-100">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-500 flex-shrink-0"></span>
                        <span class="text-xs font-bold text-slate-600 truncate"><%= monthStats.students || 0 %> <%= monthStats.students != 1 ? (lan.Students || 'Students') : (lan.Student || 'Student') %></span>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-100">
                        <span class="w-2.5 h-2.5 rounded-full bg-orange-500 flex-shrink-0"></span>
                        <span class="text-xs font-bold text-slate-600 truncate"><%= monthStats.drivers || 0 %> <%= monthStats.drivers != 1 ? (lan.Drivers || 'Drivers') : (lan.Driver || 'Driver') %></span>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-100">
                        <span class="w-2.5 h-2.5 rounded-full bg-teal-500 flex-shrink-0"></span>
                        <span class="text-xs font-bold text-slate-600 truncate"><%= monthStats.librarians || 0 %> <%= monthStats.librarians != 1 ? (lan.Librarians || 'Librarians') : (lan.Librarian || 'Librarian') %></span>
                    </div>
                </div>
            </div>
            <div class="card overflow-hidden">
                <div class="grid grid-cols-7 border-b border-slate-100 bg-slate-50/50">
                    <% [
                        { key: 'Sun', fallback: 'Sun' },
                        { key: 'Mon', fallback: 'Mon' },
                        { key: 'Tue', fallback: 'Tue' },
                        { key: 'Wed', fallback: 'Wed' },
                        { key: 'Thu', fallback: 'Thu' },
                        { key: 'Fri', fallback: 'Fri' },
                        { key: 'Sat', fallback: 'Sat' }
                    ].forEach(d => { 
                        const dayLabel = lan[d.key] || d.fallback;
                    %>
                        <div class="py-2 text-center text-[10px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider
                            <%= d.key === 'Sun' || d.key === 'Sat' ? 'bg-slate-50/80 text-slate-400' : '' %>">
                            <span class="sm:hidden"><%= dayLabel.charAt(0) %></span>
                            <span class="hidden sm:inline"><%= dayLabel %></span>
                        </div>
                    <% }) %>
                </div>
                <div class="grid grid-cols-7">
                    <%
                    const today = new Date();
                    const todayStr = today.getFullYear() + '-' +
                        String(today.getMonth() + 1).padStart(2, '0') + '-' +
                        String(today.getDate()).padStart(2, '0');

                    calendarDays.forEach((cell, cellIdx) => {
                        const colIdx = cellIdx % 7; // 0=Sun, 6=Sat
                        const isWeekend = colIdx === 0 || colIdx === 6;
                        const isToday = cell && cell.date === todayStr;
                    %>
                        <div class="min-h-[50px] sm:min-h-[90px] p-1 sm:p-1.5 border-b border-r border-slate-100 relative flex flex-col justify-between
                            <%= !cell ? 'bg-slate-50/30' : '' %>
                            <%= isWeekend && cell ? 'bg-slate-50/50' : '' %>">
                            <% if (cell) { %>
                                <div class="flex items-center justify-between">
                                    <span class="inline-flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 rounded-full text-[10px] sm:text-[11px] font-bold
                                        <%= isToday ? 'text-white' : 'text-slate-700' %>"
                                          <% if (isToday) { %>style="background-color: var(--primary);"<% } %>>
                                        <%= cell.day %>
                                    </span>
                                </div>
                                <div class="space-y-0.5 mt-0.5">
                                    <% const roleChipColors = {
                                        teacher: 'bg-purple-100 text-purple-800 border-purple-200',
                                        student: 'bg-blue-100 text-blue-800 border-blue-200',
                                        librarian: 'bg-teal-100 text-teal-800 border-teal-200',
                                        driver:  'bg-orange-100 text-orange-800 border-orange-200'
                                    }; %>
                                    <% const maxVisible = 3; %>
                                    <div class="flex sm:hidden items-center justify-center gap-0.5 flex-wrap">
                                        <% cell.leaves.slice(0, 4).forEach(lv => { %>
                                            <span class="w-1.5 h-1.5 rounded-full inline-block flex-shrink-0
                                                <%= lv.user_role === 'teacher' ? 'bg-purple-500' : lv.user_role === 'student' ? 'bg-blue-500' : lv.user_role === 'librarian' ? 'bg-teal-500' : 'bg-orange-500' %>"
                                                title="<%= lv.first_name %> <%= lv.last_name %> (<%= lv.user_role %>)"></span>
                                        <% }) %>
                                    </div>
                                    <div class="hidden sm:block space-y-0.5">
                                        <% cell.leaves.slice(0, maxVisible).forEach(lv => { %>
                                            <div class="flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-bold truncate border role-chip-<%= lv.user_role %> <%= roleChipColors[lv.user_role] || 'bg-slate-100 text-slate-700 border-slate-200' %>" title="<%= lv.first_name %> <%= lv.last_name %> (<%= lv.leave_type %> leave)">
                                                <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 <%= lv.user_role === 'teacher' ? 'bg-purple-500' : lv.user_role === 'student' ? 'bg-blue-500' : lv.user_role === 'librarian' ? 'bg-teal-500' : 'bg-orange-500' %>"></span>
                                                <span class="truncate"><%= lv.first_name %> <%= lv.last_name.charAt(0) %>.</span>
                                            </div>
                                        <% }) %>
                                        <% if (cell.leaves.length > maxVisible) { %>
                                            <div class="text-[9px] font-bold text-slate-400 pl-1">
                                                +<%= cell.leaves.length - maxVisible %> <%- lan.More_Small || 'more' %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-4 mt-4 pt-4">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"><%- lan.Legend || 'Legend:' %></span>
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm bg-purple-500 inline-block"></span>
                    <span class="text-[11px] font-bold text-slate-600"><%- lan.Teacher || 'Teacher' %></span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm bg-blue-500 inline-block"></span>
                    <span class="text-[11px] font-bold text-slate-600"><%- lan.Student || 'Student' %></span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm bg-orange-500 inline-block"></span>
                    <span class="text-[11px] font-bold text-slate-600"><%- lan.Driver || 'Driver' %></span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-sm bg-teal-500 inline-block"></span>
                    <span class="text-[11px] font-bold text-slate-600"><%- lan.Librarian || 'Librarian' %></span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="w-3 h-3 rounded-full inline-block flex-shrink-0" style="background-color: var(--primary);"></span>
                    <span class="text-[11px] font-bold text-slate-600"><%- lan.Today || 'Today' %></span>
</div>
        <%- include('../../partials/footer') %>
                </div>
        </div>

    </div>
</div>