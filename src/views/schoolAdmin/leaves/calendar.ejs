<%- include('../../partials/head', { title: `${lan.Leave_Calendar || 'Leave Calendar'} | SchoolSync` }) %>
<style>
    :root {
        --cal-teacher-color: #8B5CF6;
        --cal-teacher-bg: rgba(139, 92, 246, 0.12);
        --cal-teacher-border: rgba(139, 92, 246, 0.25);
        --cal-student-color: #3B82F6;
        --cal-student-bg: rgba(59, 130, 246, 0.12);
        --cal-student-border: rgba(59, 130, 246, 0.25);
        --cal-driver-color: #F97316;
        --cal-driver-bg: rgba(249, 115, 22, 0.12);
        --cal-driver-border: rgba(249, 115, 22, 0.25);
        --cal-librarian-color: #0D9488;
        --cal-librarian-bg: rgba(13, 148, 136, 0.12);
        --cal-librarian-border: rgba(13, 148, 136, 0.25);
    }

    .leave-cal-container {
        font-family: inherit;
    }

    .cal-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .cal-stat-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .cal-stat-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.05);
    }

    .cal-stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .cal-stat-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .cal-stat-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748B;
    }

    .cal-stat-val {
        font-size: 17px;
        font-weight: 800;
        line-height: 1.1;
        color: #1E293B;
    }

    .cal-nav-wrapper {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 8px 12px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 12px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .cal-nav-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cal-nav-btn {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        color: #475569;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s ease;
        font-size: 11px;
    }

    .cal-nav-btn:hover {
        background: #F1F5F9;
        color: #1E293B;
        border-color: #CBD5E1;
    }

    .cal-current-title {
        font-size: 15px;
        font-weight: 800;
        color: #0F172A;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding: 3px 6px;
        border-radius: 6px;
        transition: background 0.15s;
    }

    .cal-current-title:hover {
        background: #F1F5F9;
    }

    .cal-today-btn {
        padding: 5px 10px;
        border-radius: 6px;
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        color: #334155;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.15s ease;
    }

    .cal-today-btn:hover {
        background: #F1F5F9;
        color: #0F172A;
        border-color: #CBD5E1;
    }

    .cal-main-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
        margin-bottom: 12px;
    }

    .cal-weekdays-row {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        background: #F8FAFC;
        border-bottom: 1px solid #E2E8F0;
    }

    .cal-weekday-head {
        padding: 7px 4px;
        text-align: center;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cal-weekday-head.is-weekend {
        background: rgba(241, 245, 249, 0.65);
        color: #64748B;
    }

    .cal-days-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        background: #FFFFFF;
    }

    .cal-day-cell {
        min-height: 90px;
        padding: 5px 6px;
        border-right: 1px solid #F1F5F9;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        flex-direction: column;
        position: relative;
        background: #FFFFFF;
        transition: background-color 0.15s ease;
    }

    .cal-day-cell:nth-child(7n) {
        border-right: none;
    }

    .cal-day-cell.is-empty {
        background: #FBFDFE;
        opacity: 0.5;
    }

    .cal-day-cell.is-weekend:not(.is-empty) {
        background: rgba(248, 250, 252, 0.6);
    }

    .cal-day-cell.has-leaves {
        cursor: pointer;
    }

    .cal-day-cell.has-leaves:hover {
        background: #F8FAFC;
    }

    .cal-day-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 3px;
    }

    .cal-day-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        color: #334155;
        transition: all 0.15s;
    }

    .cal-day-cell.is-today .cal-day-num {
        background: #2563EB;
        color: #FFFFFF;
        box-shadow: 0 1px 4px rgba(37, 99, 235, 0.35);
    }

    .cal-today-tag {
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        color: #2563EB;
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        padding: 1px 4px;
        border-radius: 4px;
        letter-spacing: 0.03em;
    }

    .cal-day-leaves-list {
        display: flex;
        flex-direction: column;
        gap: 3px;
        flex: 1;
        min-height: 0;
    }

    .cal-leave-pill {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 2px 5px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.2;
        text-decoration: none;
        border: 1px solid transparent;
        transition: filter 0.15s, transform 0.15s;
        cursor: pointer;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .cal-leave-pill:hover {
        filter: brightness(0.95);
        transform: translateY(-1px);
    }

    .cal-leave-pill.role-teacher {
        background: var(--cal-teacher-bg);
        color: var(--cal-teacher-color);
        border-color: var(--cal-teacher-border);
    }

    .cal-leave-pill.role-student {
        background: var(--cal-student-bg);
        color: var(--cal-student-color);
        border-color: var(--cal-student-border);
    }

    .cal-leave-pill.role-driver {
        background: var(--cal-driver-bg);
        color: var(--cal-driver-color);
        border-color: var(--cal-driver-border);
    }

    .cal-leave-pill.role-librarian {
        background: var(--cal-librarian-bg);
        color: var(--cal-librarian-color);
        border-color: var(--cal-librarian-border);
    }

    .cal-role-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .role-teacher .cal-role-dot { background: var(--cal-teacher-color); }
    .role-student .cal-role-dot { background: var(--cal-student-color); }
    .role-driver .cal-role-dot { background: var(--cal-driver-color); }
    .role-librarian .cal-role-dot { background: var(--cal-librarian-color); }

    .cal-pill-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 10px;
        font-weight: 600;
    }

    .cal-pill-type {
        font-size: 8px;
        opacity: 0.8;
        margin-left: auto;
        flex-shrink: 0;
        text-transform: capitalize;
    }

    .cal-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 9px;
        font-weight: 700;
        color: #64748B;
        background: #F1F5F9;
        border: 1px solid #E2E8F0;
        padding: 1px 5px;
        border-radius: 4px;
        margin-top: 1px;
        align-self: flex-start;
        cursor: pointer;
        transition: all 0.15s;
    }

    .cal-more-btn:hover {
        background: #E2E8F0;
        color: #1E293B;
    }

    .cal-legend-bar {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 8px 14px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
        margin-bottom: 16px;
    }

    .cal-legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 600;
        color: #475569;
    }

    .cal-legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        flex-shrink: 0;
    }

    .cal-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 12px;
    }

    .cal-modal.active {
        display: flex;
    }

    .cal-modal-box {
        background: #FFFFFF;
        border-radius: 14px;
        width: 100%;
        max-width: 520px;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.18);
        animation: calModalFadeIn 0.18s ease-out;
        overflow: hidden;
    }

    @keyframes calModalFadeIn {
        from { opacity: 0; transform: scale(0.97) translateY(6px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .cal-modal-header {
        padding: 12px 16px;
        border-bottom: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #F8FAFC;
    }

    .cal-modal-body {
        padding: 14px 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .cal-modal-footer {
        padding: 10px 16px;
        border-top: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        background: #F8FAFC;
        gap: 8px;
    }

    .cal-detail-card {
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 10px 12px;
        background: #FFFFFF;
        display: flex;
        flex-direction: column;
        gap: 6px;
        transition: border-color 0.15s;
    }

    .cal-detail-card:hover {
        border-color: #CBD5E1;
    }

    .cal-picker-dialog {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 100;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        width: 260px;
        margin-top: 4px;
    }

    .cal-picker-dialog.active {
        display: block;
    }

    [data-theme="dark"] .cal-stat-card,
    .light-mode-disabled .cal-stat-card,
    [data-theme="dark"] .cal-nav-wrapper,
    .light-mode-disabled .cal-nav-wrapper,
    [data-theme="dark"] .cal-main-card,
    .light-mode-disabled .cal-main-card,
    [data-theme="dark"] .cal-legend-bar,
    .light-mode-disabled .cal-legend-bar,
    [data-theme="dark"] .cal-modal-box,
    .light-mode-disabled .cal-modal-box,
    [data-theme="dark"] .cal-detail-card,
    .light-mode-disabled .cal-detail-card,
    [data-theme="dark"] .cal-picker-dialog,
    .light-mode-disabled .cal-picker-dialog {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .cal-stat-val,
    .light-mode-disabled .cal-stat-val,
    [data-theme="dark"] .cal-current-title,
    .light-mode-disabled .cal-current-title,
    [data-theme="dark"] .cal-day-num,
    .light-mode-disabled .cal-day-num {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .cal-stat-label,
    .light-mode-disabled .cal-stat-label,
    [data-theme="dark"] .cal-legend-item,
    .light-mode-disabled .cal-legend-item {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .cal-nav-btn,
    .light-mode-disabled .cal-nav-btn,
    [data-theme="dark"] .cal-today-btn,
    .light-mode-disabled .cal-today-btn,
    [data-theme="dark"] .cal-weekdays-row,
    .light-mode-disabled .cal-weekdays-row,
    [data-theme="dark"] .cal-modal-header,
    .light-mode-disabled .cal-modal-header,
    [data-theme="dark"] .cal-modal-footer,
    .light-mode-disabled .cal-modal-footer {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #CBD5E1 !important;
    }

    [data-theme="dark"] .cal-weekday-head,
    .light-mode-disabled .cal-weekday-head {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .cal-weekday-head.is-weekend,
    .light-mode-disabled .cal-weekday-head.is-weekend {
        background: rgba(255, 255, 255, 0.03) !important;
        color: #64748B !important;
    }

    [data-theme="dark"] .cal-days-grid,
    .light-mode-disabled .cal-days-grid,
    [data-theme="dark"] .cal-day-cell,
    .light-mode-disabled .cal-day-cell {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .cal-day-cell.is-empty,
    .light-mode-disabled .cal-day-cell.is-empty {
        background: #0E1524 !important;
    }

    [data-theme="dark"] .cal-day-cell.is-weekend:not(.is-empty),
    .light-mode-disabled .cal-day-cell.is-weekend:not(.is-empty) {
        background: rgba(255, 255, 255, 0.02) !important;
    }

    [data-theme="dark"] .cal-day-cell.has-leaves:hover,
    .light-mode-disabled .cal-day-cell.has-leaves:hover {
        background: #1B243B !important;
    }

    [data-theme="dark"] .cal-more-btn,
    .light-mode-disabled .cal-more-btn {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #94A3B8 !important;
    }

    @media print {
        .app-wrapper .main-panel { margin: 0 !important; padding: 0 !important; }
        .sidebar, .navbar, .cal-nav-group button, .leaves-banner-btn, .cal-more-btn { display: none !important; }
        .cal-main-card { border: 1px solid #000 !important; box-shadow: none !important; }
        .cal-day-cell { min-height: 80px !important; }
    }

    @media (max-width: 768px) {
        .cal-day-cell {
            min-height: 70px;
            padding: 3px 4px;
        }
        .cal-pill-type {
            display: none;
        }
        .cal-weekday-head {
            font-size: 10px;
            padding: 6px 2px;
        }
    }
</style>
<div class="app-wrapper schooladmin-theme leave-cal-container">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding-top: 14px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); color: #fff; padding: 14px 18px; border-radius: 12px; border: none; margin-bottom: 12px; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Leave_Calendar || 'Leave Calendar' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Leave_Calendar_Desc || 'Monthly overview of approved leave requests, color-coded by role' %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <a href="/schooladmin/leaves" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 13px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fa-solid fa-list"></i> <%- lan.List_View || 'List View' %>
                        </a>
                        <button onclick="window.print()" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                            <i class="fa-solid fa-print"></i> <%- lan.Print || 'Print' %>
                        </button>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 12px;">
                <a href="/schooladmin/leaves" style="padding: 6px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; border-radius: 8px; text-decoration: none; color: #64748B; background: transparent; transition: all 0.15s;">
                    <i class="fa-solid fa-table-list me-1"></i> <%- lan.All_Applications || 'All Applications' %>
                </a>
                <a href="/schooladmin/leaves/calendar" style="padding: 6px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; border-radius: 8px; text-decoration: none; background: #ECFDF5; color: #047857; border: 1px solid #D1FAE5; box-shadow: 0 1px 2px rgba(4, 120, 87, 0.05);">
                    <i class="fa-regular fa-calendar-check me-1"></i> <%- lan.Leave_Calendar || 'Leave Calendar' %>
                </a>
            </div>
            <div class="cal-stats-grid">
                <div class="cal-stat-card">
                    <div class="cal-stat-icon" style="background: rgba(139, 92, 246, 0.12); color: #8B5CF6;">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                    <div class="cal-stat-info">
                        <span class="cal-stat-label"><%- lan.Teachers || 'Teachers' %></span>
                        <span class="cal-stat-val"><%= monthStats.teachers || 0 %></span>
                    </div>
                </div>
                <div class="cal-stat-card">
                    <div class="cal-stat-icon" style="background: rgba(59, 130, 246, 0.12); color: #3B82F6;">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                    <div class="cal-stat-info">
                        <span class="cal-stat-label"><%- lan.Students || 'Students' %></span>
                        <span class="cal-stat-val"><%= monthStats.students || 0 %></span>
                    </div>
                </div>
                <div class="cal-stat-card">
                    <div class="cal-stat-icon" style="background: rgba(249, 115, 22, 0.12); color: #F97316;">
                        <i class="fa-solid fa-bus"></i>
                    </div>
                    <div class="cal-stat-info">
                        <span class="cal-stat-label"><%- lan.Drivers || 'Drivers' %></span>
                        <span class="cal-stat-val"><%= monthStats.drivers || 0 %></span>
                    </div>
                </div>
                <div class="cal-stat-card">
                    <div class="cal-stat-icon" style="background: rgba(13, 148, 136, 0.12); color: #0D9488;">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <div class="cal-stat-info">
                        <span class="cal-stat-label"><%- lan.Librarians || 'Librarians' %></span>
                        <span class="cal-stat-val"><%= monthStats.librarians || 0 %></span>
                    </div>
                </div>
            </div>
            <div class="cal-nav-wrapper">
                <div class="cal-nav-group" style="position: relative;">
                    <a href="/schooladmin/leaves/calendar?month=<%= prevMonth %>&year=<%= prevYear %>"
                       class="cal-nav-btn" title="Previous Month">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                    <div id="monthYearPickerTrigger" class="cal-current-title" onclick="toggleMonthPicker()">
                        <span><%= monthName %> <%= year %></span>
                        <i class="fa-solid fa-angle-down" style="font-size: 11px; color: #94A3B8;"></i>
                    </div>
                    <div id="calPickerDialog" class="cal-picker-dialog">
                        <div style="display: flex; gap: 6px; margin-bottom: 10px;">
                            <select id="jumpMonthSelect" class="form-select" style="flex: 1; font-size: 11px; font-weight: 600; padding: 5px 8px; border-radius: 6px;">
                                <% 
                                const allMonths = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                                allMonths.forEach((mName, idx) => { %>
                                    <option value="<%= idx + 1 %>" <%= (idx + 1) === month ? 'selected' : '' %>><%= mName %></option>
                                <% }); %>
                            </select>
                            <select id="jumpYearSelect" class="form-select" style="width: 80px; font-size: 11px; font-weight: 600; padding: 5px 8px; border-radius: 6px;">
                                <% const curY = new Date().getFullYear(); 
                                for (let y = curY - 3; y <= curY + 3; y++) { %>
                                    <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
                                <% } %>
                            </select>
                        </div>
                        <button onclick="applyMonthJump()" style="width: 100%; background: #059669; color: #fff; border: none; padding: 6px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer;">
                            <%- lan.Apply || 'Go to Month' %>
                        </button>
                    </div>
                    <a href="/schooladmin/leaves/calendar?month=<%= nextMonth %>&year=<%= nextYear %>"
                       class="cal-nav-btn" title="Next Month">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                    <a href="/schooladmin/leaves/calendar" class="cal-today-btn">
                        <i class="fa-regular fa-calendar"></i> <%- lan.Today || 'Today' %>
                    </a>
                </div>

                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 11px; font-weight: 700; color: #64748B;">
                        <%- lan.Total_Approved || 'Total Approved:' %>
                    </span>
                    <span style="font-size: 11px; font-weight: 800; color: #047857; background: #ECFDF5; border: 1px solid #D1FAE5; padding: 2px 8px; border-radius: 16px;">
                        <%= monthStats.total || 0 %> <%- lan.Leaves || 'Leaves' %>
                    </span>
                </div>
            </div>
            <div class="cal-main-card">
                <div class="cal-weekdays-row">
                    <% [
                        { key: 'Sunday', short: 'Sun', fallback: 'Sun', isWeekend: true },
                        { key: 'Monday', short: 'Mon', fallback: 'Mon', isWeekend: false },
                        { key: 'Tuesday', short: 'Tue', fallback: 'Tue', isWeekend: false },
                        { key: 'Wednesday', short: 'Wed', fallback: 'Wed', isWeekend: false },
                        { key: 'Thursday', short: 'Thu', fallback: 'Thu', isWeekend: false },
                        { key: 'Friday', short: 'Fri', fallback: 'Fri', isWeekend: false },
                        { key: 'Saturday', short: 'Sat', fallback: 'Sat', isWeekend: true }
                    ].forEach(d => { 
                        const dayLabel = lan[d.key] || lan[d.short] || d.fallback;
                    %>
                        <div class="cal-weekday-head <%= d.isWeekend ? 'is-weekend' : '' %>">
                            <span><%= dayLabel %></span>
                        </div>
                    <% }) %>
                </div>
                <div class="cal-days-grid">
                    <%
                    const today = new Date();
                    const todayStr = today.getFullYear() + '-' +
                        String(today.getMonth() + 1).padStart(2, '0') + '-' +
                        String(today.getDate()).padStart(2, '0');

                    calendarDays.forEach((cell, cellIdx) => {
                        const colIdx = cellIdx % 7; // 0 = Sun, 6 = Sat
                        const isWeekend = (colIdx === 0 || colIdx === 6);
                        const isToday = cell && cell.date === todayStr;
                        const hasLeaves = cell && cell.leaves && cell.leaves.length > 0;
                    %>
                        <div class="cal-day-cell <%= !cell ? 'is-empty' : '' %> <%= isWeekend ? 'is-weekend' : '' %> <%= isToday ? 'is-today' : '' %> <%= hasLeaves ? 'has-leaves' : '' %>"
                             <% if (cell && hasLeaves) { %>
                                onclick="openDayLeavesModal('<%= cell.date %>', '<%= cell.day %> <%= monthName %> <%= year %>')"
                             <% } %>>
                            <% if (cell) { %>
                                <div class="cal-day-top">
                                    <span class="cal-day-num"><%= cell.day %></span>
                                    <% if (isToday) { %>
                                        <span class="cal-today-tag"><%- lan.Today || 'Today' %></span>
                                    <% } else if (hasLeaves) { %>
                                        <span style="font-size: 9px; font-weight: 700; color: #94A3B8;">
                                            <%= cell.leaves.length %>
                                        </span>
                                    <% } %>
                                </div>
                                <div class="cal-day-leaves-list">
                                    <% const maxVisible = 2; %>
                                    <% cell.leaves.slice(0, maxVisible).forEach(lv => { %>
                                        <div class="cal-leave-pill role-<%= lv.user_role %>"
                                             title="<%= lv.first_name %> <%= lv.last_name %> (<%= lv.leave_type || 'Leave' %>)">
                                            <span class="cal-role-dot"></span>
                                            <span class="cal-pill-name"><%= lv.first_name %> <%= lv.last_name ? lv.last_name.charAt(0) + '.' : '' %></span>
                                            <% if (lv.leave_type) { %>
                                                <span class="cal-pill-type"><%= lv.leave_type %></span>
                                            <% } %>
                                        </div>
                                    <% }) %>
                                    <% if (cell.leaves.length > maxVisible) { %>
                                        <button class="cal-more-btn" type="button">
                                            <i class="fa-solid fa-ellipsis"></i> +<%= cell.leaves.length - maxVisible %> <%- lan.More || 'more' %>
                                        </button>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="cal-legend-bar">
                <span style="font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B;">
                    <i class="fa-solid fa-circle-info me-1"></i> <%- lan.Legend || 'Legend:' %>
                </span>
                <div class="cal-legend-item">
                    <span class="cal-legend-dot" style="background: #8B5CF6;"></span>
                    <span><%- lan.Teacher || 'Teacher' %></span>
                </div>
                <div class="cal-legend-item">
                    <span class="cal-legend-dot" style="background: #3B82F6;"></span>
                    <span><%- lan.Student || 'Student' %></span>
                </div>
                <div class="cal-legend-item">
                    <span class="cal-legend-dot" style="background: #F97316;"></span>
                    <span><%- lan.Driver || 'Driver' %></span>
                </div>
                <div class="cal-legend-item">
                    <span class="cal-legend-dot" style="background: #0D9488;"></span>
                    <span><%- lan.Librarian || 'Librarian' %></span>
                </div>
                <div class="cal-legend-item" style="margin-left: auto;">
                    <span class="cal-legend-dot" style="background: #2563EB; border-radius: 50%;"></span>
                    <span><%- lan.Today || 'Current Day' %></span>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<div id="dayLeavesModal" class="cal-modal" onclick="handleModalBackdrop(event)">
    <div class="cal-modal-box">
        <div class="cal-modal-header">
            <div style="display: flex; align-items: center; gap: 8px;">
                <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(5, 150, 105, 0.12); color: #059669; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                    <i class="fa-regular fa-calendar-check"></i>
                </div>
                <div>
                    <h3 id="modalDateTitle" style="font-size: 15px; font-weight: 800; margin: 0; color: #1E293B;">Approved Leaves</h3>
                    <p id="modalDateSubtitle" style="font-size: 11px; color: #64748B; margin: 2px 0 0;">0 persons on leave</p>
                </div>
            </div>
            <button onclick="closeDayLeavesModal()" style="background: transparent; border: none; color: #94A3B8; font-size: 16px; cursor: pointer; padding: 4px 6px; border-radius: 6px; line-height: 1;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div id="modalLeavesList" class="cal-modal-body"></div>
        <div class="cal-modal-footer">
            <a href="/schooladmin/leaves" class="btn" style="background: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; font-size: 11px; font-weight: 700; padding: 6px 12px; border-radius: 6px; text-decoration: none;">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> <%- lan.View_All_Applications || 'View in Applications' %>
            </a>
            <button onclick="closeDayLeavesModal()" class="btn" style="background: #059669; color: #fff; border: none; font-size: 11px; font-weight: 700; padding: 6px 14px; border-radius: 6px; cursor: pointer;">
                <%- lan.Close || 'Close' %>
            </button>
        </div>
    </div>
</div>
<script type="application/json" id="calendarDataJson"><%- JSON.stringify(calendarDays.filter(c => c !== null)) %></script>
<script>
    function getCalendarData() {
        try {
            const raw = document.getElementById('calendarDataJson')?.textContent;
            return raw ? JSON.parse(raw) : [];
        } catch (e) {
            return [];
        };
    };

    function openDayLeavesModal(dateStr, formattedDate) {
        const calendarData = getCalendarData();
        const dayObj = calendarData.find(d => d && d.date === dateStr);
        if (!dayObj || !dayObj.leaves || dayObj.leaves.length === 0) return;

        const modal = document.getElementById('dayLeavesModal');
        const titleEl = document.getElementById('modalDateTitle');
        const subTitleEl = document.getElementById('modalDateSubtitle');
        const listEl = document.getElementById('modalLeavesList');

        titleEl.textContent = formattedDate;
        subTitleEl.textContent = `${dayObj.leaves.length} approved leave${dayObj.leaves.length > 1 ? 's' : ''} on this day`;

        const roleBadges = {
            teacher: { label: 'Teacher', bg: 'rgba(139, 92, 246, 0.12)', color: '#8B5CF6', icon: 'fa-chalkboard-user' },
            student: { label: 'Student', bg: 'rgba(59, 130, 246, 0.12)', color: '#3B82F6', icon: 'fa-user-graduate' },
            driver: { label: 'Driver', bg: 'rgba(249, 115, 22, 0.12)', color: '#F97316', icon: 'fa-bus' },
            librarian: { label: 'Librarian', bg: 'rgba(13, 148, 136, 0.12)', color: '#0D9488', icon: 'fa-book-open' }
        };

        let html = '';
        dayObj.leaves.forEach(lv => {
            const roleInfo = roleBadges[lv.user_role] || { label: lv.user_role, bg: '#F1F5F9', color: '#475569', icon: 'fa-user' };
            const fromFmt = lv.from_date ? new Date(lv.from_date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : '';
            const toFmt = lv.to_date ? new Date(lv.to_date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : '';

            html += `
                <div class="cal-detail-card">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div style="width: 30px; height: 30px; border-radius: 6px; background: ${roleInfo.bg}; color: ${roleInfo.color}; display: flex; align-items: center; justify-content: center; font-size: 12px;">
                                <i class="fa-solid ${roleInfo.icon}"></i>
                            </div>
                            <div>
                                <h4 style="font-size: 13px; font-weight: 700; margin: 0; color: inherit;">
                                    ${lv.first_name || ''} ${lv.last_name || ''}
                                </h4>
                                <span style="font-size: 10px; font-weight: 700; color: ${roleInfo.color}; text-transform: uppercase;">
                                    ${roleInfo.label}
                                </span>
                            </div>
                        </div>
                        <span style="font-size: 10px; font-weight: 700; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 3px 8px; border-radius: 6px; text-transform: capitalize;">
                            ${lv.leave_type || 'Leave'}
                        </span>
                    </div>

                    <div style="font-size: 11px; color: #64748B; display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                        <i class="fa-regular fa-calendar" style="font-size: 11px;"></i>
                        <span>${fromFmt} &rarr; ${toFmt}</span>
                    </div>

                    ${lv.reason ? `
                        <div style="font-size: 11px; background: #F8FAFC; border-left: 3px solid ${roleInfo.color}; padding: 6px 10px; border-radius: 0 6px 6px 0; margin-top: 2px; color: #475569; font-style: italic;">
                            "${lv.reason}"
                        </div>
                    ` : ''}
                </div>
            `;
        });
        listEl.innerHTML = html;
        modal.classList.add('active');
    };

    function closeDayLeavesModal() {
        const modal = document.getElementById('dayLeavesModal');
        if (modal) modal.classList.remove('active');
    };

    function handleModalBackdrop(e) {
        if (e.target.id === 'dayLeavesModal') {
            closeDayLeavesModal();
        };
    };

    function toggleMonthPicker() {
        const dialog = document.getElementById('calPickerDialog');
        if (dialog) dialog.classList.toggle('active');
    };

    function applyMonthJump() {
        const m = document.getElementById('jumpMonthSelect').value;
        const y = document.getElementById('jumpYearSelect').value;
        window.location.href = `/schooladmin/leaves/calendar?month=${m}&year=${y}`;
    };

    document.addEventListener('click', function(e) {
        const trigger = document.getElementById('monthYearPickerTrigger');
        const dialog = document.getElementById('calPickerDialog');
        if (dialog && trigger && !trigger.contains(e.target) && !dialog.contains(e.target)) {
            dialog.classList.remove('active');
        };
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeDayLeavesModal();
            const dialog = document.getElementById('calPickerDialog');
            if (dialog) dialog.classList.remove('active');
        };
    });
</script>