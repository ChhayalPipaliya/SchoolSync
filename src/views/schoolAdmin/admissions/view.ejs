<%- include('../../partials/head', { title: `${lan.Admission_Detail || 'Admission Detail'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <style>
        .back-btn {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          color: #667eea;
          font-size: 13px;
          font-weight: 600;
          text-decoration: none;
          margin-bottom: 20px;
          transition: gap 0.2s;
        }
        .back-btn:hover { gap: 10px; }
        .detail-grid {
          display: grid;
          grid-template-columns: 1fr 330px;
          gap: 22px;
          align-items: start;
        }
        @media(max-width:900px) { .detail-grid { grid-template-columns: 1fr; } }
        .detail-card {
          background: var(--surface);
          border-radius: 16px;
          overflow: hidden;
          box-shadow: var(--shadow-sm);
          border: 1px solid var(--border);
        }
        .card-header-band {
          height: 6px;
          background: linear-gradient(90deg, #667eea, #764ba2);
        }
        .card-body { padding: 28px 30px; }
        .applicant-hero {
          display: flex;
          align-items: center;
          gap: 18px;
          margin-bottom: 28px;
          padding-bottom: 22px;
          border-bottom: 1px solid var(--border);
        }
        .big-avatar {
          width: 70px; height: 70px;
          border-radius: 50%;
          display: flex; align-items: center; justify-content: center;
          font-size: 26px; font-weight: 800;
          color: white;
          flex-shrink: 0;
          box-shadow: 0 6px 20px rgba(102,126,234,0.25);
        }
        .avatar-c0 { background: #667eea; }
        .avatar-c1 { background: #f093fb; }
        .avatar-c2 { background: #4facfe; }
        .avatar-c3 { background: #43e97b; }
        .avatar-c4 { background: #f7971e; }
        .applicant-hero h2 { font-size: 20px; font-weight: 800; color: var(--text-primary); margin-bottom: 5px; }
        .applicant-hero p  { font-size: 13px; color: var(--text-muted); }
        .status-pill {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          padding: 5px 14px;
          border-radius: 20px;
          font-size: 12px;
          font-weight: 700;
        }
        .pill-pending  { background: #fff7ed; color: #c05621; border: 1.5px solid #fed7aa; }
        .pill-approved { background: #f0fdf4; color: #15803d; border: 1.5px solid #bbf7d0; }
        .pill-rejected { background: #fef2f2; color: #dc2626; border: 1.5px solid #fecaca; }
        .info-section { margin-bottom: 24px; }
        .info-section h4 {
          font-size: 11px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.8px;
          color: var(--text-muted);
          margin-bottom: 14px;
          display: flex;
          align-items: center;
          gap: 7px;
        }
        .info-section h4 i { color: #667eea; font-size: 13px; }
        .info-rows { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 20px; }
        .info-row {
          display: flex;
          flex-direction: column;
          gap: 2px;
          padding: 10px 14px;
          background: var(--surface-hover);
          border-radius: 9px;
        }
        .info-row .label { font-size: 11px; color: var(--text-muted); font-weight: 500; }
        .info-row .value { font-size: 13px; color: var(--text-primary); font-weight: 600; }
        .info-row.full { grid-column: 1/-1; }
        .side-card {
          background: var(--surface);
          border-radius: 16px;
          padding: 24px;
          box-shadow: var(--shadow-sm);
          border: 1px solid var(--border);
          margin-bottom: 16px;
        }
        .side-card h4 {
          font-size: 13px;
          font-weight: 700;
          color: var(--text-primary);
          margin-bottom: 16px;
          display: flex;
          align-items: center;
          gap: 7px;
        }
        .side-card h4 i { color: #667eea; }
        .action-note textarea {
          width: 100%;
          border: 1.5px solid var(--border);
          border-radius: 9px;
          padding: 10px 12px;
          font-size: 13px;
          font-family: inherit;
          resize: vertical;
          min-height: 80px;
          outline: none;
          background: var(--surface);
          color: var(--text-primary);
          transition: border-color 0.2s;
        }
        .action-note textarea:focus { border-color: #667eea; }
        .action-note label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 6px; }
        .btn-action {
          width: 100%;
          padding: 11px;
          border: none;
          border-radius: 9px;
          font-size: 13px;
          font-weight: 700;
          cursor: pointer;
          margin-top: 10px;
          transition: all 0.2s;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 6px;
        }
        .btn-approve-full {
          background: linear-gradient(135deg,#11998e,#38ef7d);
          color: white;
        }
        .btn-approve-full:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn-reject-full {
          background: linear-gradient(135deg,#ee0979,#ff6a00);
          color: white;
        }
        .btn-reject-full:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn-back-list {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 6px;
          width: 100%;
          padding: 10px;
          background: var(--surface-hover);
          color: var(--text-secondary);
          border: none;
          border-radius: 9px;
          font-size: 13px;
          font-weight: 700;
          text-decoration: none;
          transition: all 0.2s;
          border: 1px solid var(--border);
        }
        .btn-back-list:hover { background: #f0f4ff; color: #667eea; }
        .admin-note-box {
          background: #fffbf0;
          border: 1px solid #fde68a;
          border-radius: 9px;
          padding: 12px 14px;
          font-size: 13px;
          color: #92400e;
          margin-top: 10px;
        }
        .already-decided {
          text-align: center;
          padding: 20px;
          color: var(--text-muted);
          font-size: 13px;
        }
        .already-decided i { font-size: 32px; margin-bottom: 8px; display: block; }
      </style>
      <a href="/schooladmin/admissions" class="back-btn">
        <i class="fas fa-arrow-left"></i> <%- lan.Back_To_All_Admissions || 'Back to All Admissions' %>
      </a>
      <%- include('../../partials/flashMessages') %>
      <% const initials = admission.full_name.split(' ').map(w => w[0]).join('').substring(0,2).toUpperCase(); %>
      <%
        let extra = admission.extra_data;
        if (typeof extra === 'string') {
            try { extra = JSON.parse(extra); } catch(e) { extra = {}; }
        }
        extra = extra || {};
      %>
      <div class="detail-grid">
        <div class="detail-card">
          <div class="card-header-band"></div>
          <div class="card-body">
            <div class="applicant-hero">
              <div class="big-avatar avatar-c<%= admission.id % 5 %>"><%= initials %></div>
              <div>
                <h2><%= admission.full_name %></h2>
                <p>
                  <i class="fas fa-envelope" style="color:#667eea;"></i> <%= admission.email %>
                  <% if (admission.phone) { %> &nbsp;|&nbsp; <i class="fas fa-phone" style="color:#667eea;"></i> <%= admission.phone %><% } %>
                </p>
                <div style="margin-top:8px;">
                  <span class="status-pill pill-<%= admission.status %>">
                    <% if (admission.status === 'pending')  { %>
                        <i class="fas fa-clock"></i> <%- lan.Pending || 'Pending' %>
                    <% } %>
                    <% if (admission.status === 'approved') { %>
                        <i class="fas fa-check"></i> <%- lan.Approved || 'Approved' %>
                    <% } %>
                    <% if (admission.status === 'rejected') { %>
                        <i class="fas fa-times"></i> <%- lan.Rejected || 'Rejected' %>
                    <% } %>
                    <% if (admission.status !== 'pending' && admission.status !== 'approved' && admission.status !== 'rejected') { %>
                        <%= admission.status.charAt(0).toUpperCase() + admission.status.slice(1) %>
                    <% } %>
                  </span>
                </div>
              </div>
            </div>
            <div class="info-section">
              <h4><i class="fas fa-user"></i> <%- lan.Personal_Information || 'Personal Information' %></h4>
              <div class="info-rows">
                <div class="info-row">
                  <span class="label"><%- lan.Date_Of_Birth || 'Date of Birth' %></span>
                  <span class="value"><%= admission.date_of_birth ? new Date(admission.date_of_birth).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Gender || 'Gender' %></span>
                  <span class="value" style="text-transform:capitalize;"><%= admission.gender || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Blood_Group || 'Blood Group' %></span>
                  <span class="value"><%= admission.blood_group || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Phone || 'Phone' %></span>
                  <span class="value"><%= admission.phone || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Aadhaar_No || 'Aadhaar No' %></span>
                  <span class="value"><%= extra.aadhaar_no || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Religion || 'Religion' %></span>
                  <span class="value"><%= extra.religion || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Category || 'Category' %></span>
                  <span class="value"><%= extra.category || '—' %></span>
                </div>
                <div class="info-row full">
                  <span class="label"><%- lan.Medical_Notes || 'Medical Notes' %></span>
                  <span class="value"><%= extra.medical_notes || '—' %></span>
                </div>
              </div>
            </div>
            <div class="info-section">
              <h4><i class="fas fa-map-location-dot"></i> <%- lan.Addresses || 'Addresses' %></h4>
              <div class="info-rows">
                <div class="info-row full">
                  <span class="label"><%- lan.Permanent_Address || 'Permanent Address' %></span>
                  <span class="value">
                    <%= extra.permanent_address || admission.address || '—' %>
                    <% if (extra.permanent_city) { %>, <%= extra.permanent_city %><% } %>
                    <% if (extra.permanent_state) { %>, <%= extra.permanent_state %><% } %>
                    <% if (extra.permanent_pincode) { %> - <%= extra.permanent_pincode %><% } %>
                  </span>
                </div>
                <div class="info-row full">
                  <span class="label"><%- lan.Current_Address || 'Current Address' %></span>
                  <span class="value">
                    <% if (extra.current_address_same === 1 || extra.current_address_same === '1') { %>
                      <%- lan.Same_As_Permanent_Address || 'Same as Permanent Address' %>
                    <% } else { %>
                      <%= extra.current_address || '—' %>
                      <% if (extra.current_city) { %>, <%= extra.current_city %><% } %>
                      <% if (extra.current_state) { %>, <%= extra.current_state %><% } %>
                      <% if (extra.current_pincode) { %> - <%= extra.current_pincode %><% } %>
                    <% } %>
                  </span>
                </div>
              </div>
            </div>
            <div class="info-section">
              <h4><i class="fas fa-users"></i> <%- lan.Parent_Guardian_Information || 'Parent & Guardian Information' %></h4>
              <div class="info-rows">
                <div class="info-row">
                  <span class="label"><%- lan.Fathers_Name || "Father's Name" %></span>
                  <span class="value"><%= extra.father_name || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Fathers_Phone || "Father's Phone" %></span>
                  <span class="value"><%= extra.father_phone || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Fathers_Email || "Father's Email" %></span>
                  <span class="value"><%= extra.father_email || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Fathers_Occupation || "Father's Occupation" %></span>
                  <span class="value"><%= extra.father_occupation || '—' %></span>
                </div>
                <div class="info-row" style="grid-column: 1/-1; height: 1px; background: var(--border); margin: 6px 0; padding: 0;"></div>
                <div class="info-row">
                  <span class="label"><%- lan.Mothers_Name || "Mother's Name" %></span>
                  <span class="value"><%= extra.mother_name || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Mothers_Phone || "Mother's Phone" %></span>
                  <span class="value"><%= extra.mother_phone || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Mothers_Email || "Mother's Email" %></span>
                  <span class="value"><%= extra.mother_email || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Mothers_Occupation || "Mother's Occupation" %></span>
                  <span class="value"><%= extra.mother_occupation || '—' %></span>
                </div>
                <div class="info-row" style="grid-column: 1/-1; height: 1px; background: var(--border); margin: 6px 0; padding: 0;"></div>
                <div class="info-row">
                  <span class="label"><%- lan.Guardian_Name || 'Guardian Name' %></span>
                  <span class="value"><%= admission.guardian_name || extra.guardian_name || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Guardian_Phone || 'Guardian Phone' %></span>
                  <span class="value"><%= admission.guardian_phone || extra.guardian_phone || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Relation || 'Relation' %></span>
                  <span class="value"><%= admission.guardian_relation || extra.guardian_relation || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Guardian_Occupation || 'Guardian Occupation' %></span>
                  <span class="value"><%= extra.guardian_occupation || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Guardian_Aadhaar || 'Guardian Aadhaar' %></span>
                  <span class="value"><%= extra.guardian_aadhaar || '—' %></span>
                </div>
              </div>
            </div>
            <div class="info-section">
              <h4><i class="fas fa-bus"></i> <%- lan.Transport_Hostel_Details || 'Transport & Hostel Details' %></h4>
              <div class="info-rows">
                <div class="info-row">
                  <span class="label"><%- lan.Transport_Required || 'Transport Required' %></span>
                  <span class="value"><%= (extra.transport_required === 1 || extra.transport_required === '1' || extra.transport_required === true) ? (lan.Yes || 'Yes') : (lan.No || 'No') %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Transport_Mode || 'Transport Mode' %></span>
                  <span class="value"><%= extra.transport_mode || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Route || 'Route' %></span>
                  <span class="value"><%= extra.transport_route || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Vehicle_No || 'Vehicle No' %></span>
                  <span class="value"><%= extra.transport_vehicle_no || '—' %></span>
                </div>
                <div class="info-row" style="grid-column: 1/-1; height: 1px; background: var(--border); margin: 6px 0; padding: 0;"></div>
                <div class="info-row">
                  <span class="label"><%- lan.Hostel_Required || 'Hostel Required' %></span>
                  <span class="value"><%= (extra.hostel_required === 1 || extra.hostel_required === '1' || extra.hostel_required === true) ? (lan.Yes || 'Yes') : (lan.No || 'No') %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Hostel_Name || 'Hostel Name' %></span>
                  <span class="value"><%= extra.hostel_name || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Room_No || 'Room No' %></span>
                  <span class="value"><%= extra.hostel_room_no || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Hostel_Phone || 'Hostel Phone' %></span>
                  <span class="value"><%= extra.hostel_phone_number || '—' %></span>
                </div>
              </div>
            </div>
            <div class="info-section">
              <h4><i class="fas fa-graduation-cap"></i> <%- lan.Academic_Details || 'Academic Details' %></h4>
              <div class="info-rows">
                <div class="info-row">
                  <span class="label"><%- lan.Applying_For_Standard || 'Applying For Standard' %></span>
                  <span class="value"><%= admission.applied_standard || admission.class_applied || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Previous_School || 'Previous School' %></span>
                  <span class="value"><%= admission.previous_school || '—' %></span>
                </div>
                <div class="info-row">
                  <span class="label"><%- lan.Submitted_On || 'Submitted On' %></span>
                  <span class="value"><%= new Date(admission.submitted_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></span>
                </div>
                <% if (admission.reviewed_at) { %>
                <div class="info-row">
                  <span class="label"><%- lan.Reviewed_On || 'Reviewed On' %></span>
                  <span class="value"><%= new Date(admission.reviewed_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></span>
                </div>
                <% } %>
              </div>
            </div>
            <% if (extra.files && Object.keys(extra.files).length > 0) { %>
            <div class="info-section">
              <h4><i class="fas fa-file-pdf"></i> <%- lan.Uploaded_Documents || 'Uploaded Documents' %></h4>
              <div class="info-rows" style="grid-template-columns: 1fr; gap: 10px;">
                <% Object.keys(extra.files).forEach(field => { %>
                  <% const file = extra.files[field]; %>
                  <% if (file && file.filename) { %>
                    <div class="info-row" style="flex-direction: row; justify-content: space-between; align-items: center; padding: 12px 18px;">
                      <div>
                        <span class="label" style="text-transform: capitalize; margin-bottom: 2px;"><%= field.replace(/_/g, ' ') %></span>
                        <span class="value" style="font-size: 12.5px;"><%= file.originalname %></span>
                      </div>
                      <a href="/uploads/students/<%= file.filename %>" target="_blank" class="btn btn-secondary text-xs flex items-center gap-1" style="background: #edf2f7; color: #4a5568; border: 1px solid #cbd5e0; padding: 6px 12px; border-radius: 6px; text-decoration: none; font-weight: 600;">
                        <i class="fas fa-external-link-alt"></i> <%- lan.View || 'View' %>
                      </a>
                    </div>
                  <% } %>
                <% }) %>
              </div>
            </div>
            <% } %>
            <% if (admission.admin_note) { %>
            <div class="info-section">
              <h4><i class="fas fa-sticky-note"></i> <%- lan.Admin_Note || 'Admin Note' %></h4>
              <div class="admin-note-box"><%= admission.admin_note %></div>
            </div>
            <% } %>
          </div>
        </div>
        <div>
          <div class="side-card">
            <h4><i class="fas fa-gavel"></i> <%- lan.Review_Decision || 'Review Decision' %></h4>
            <% if (admission.status === 'pending') { %>
            <div class="action-note" style="margin-bottom:12px;">
              <label><%- lan.Note_To_Applicant_Optional || 'Note to Applicant (Optional)' %></label>
              <textarea id="sharedNote" placeholder="<%- lan.Note_To_Applicant_Placeholder || 'e.g. Please bring documents on...' %>"></textarea>
            </div>
            <form method="POST" action="/schooladmin/admissions/<%= admission.id %>/approve">
              <input type="hidden" name="admin_note" id="approveNote">
              <div class="info-section" style="margin-bottom:14px;">
                <h4><i class="fas fa-school"></i> <%- lan.Final_Academic_Assignment || 'Final Academic Assignment' %></h4>
                <div class="action-note" style="margin-bottom:10px;">
                  <label><%- lan.Class || 'Class' %> <span style="color:#dc2626;">*</span></label>
                  <select id="approvalClassSelect" name="base_class_id" required style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:10px;font-family:inherit;font-size:13px;outline:none;">
                    <option value=""><%- lan.Select_Class || 'Select Class' %></option>
                    <% classes.forEach(cls => { %>
                      <option value="<%= cls.id %>" data-medium="<%= cls.medium || '' %>" data-academic-year="<%= cls.academic_year || '' %>">
                        <%= cls.display_name || ('Class ' + cls.class_name) %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="action-note" style="margin-bottom:10px;">
                  <label><%- lan.Section || 'Section' %> <span style="color:#dc2626;">*</span></label>
                  <select id="approvalSectionSelect" name="class_id" required
                          data-placeholder="<%- lan.Select_Section || 'Select Section' %>"
                          style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:10px;font-family:inherit;font-size:13px;outline:none;" disabled>
                    <option value=""><%- lan.Select_Section || 'Select Section' %></option>
                  </select>
                </div>
                <div class="action-note" style="margin-bottom:10px;">
                  <label><%- lan.Roll_No || 'Roll No' %></label>
                  <input type="text" name="roll_no" inputmode="numeric" pattern="[0-9]*" placeholder="<%- lan.Optional || 'Optional' %>" style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:10px;font-family:inherit;font-size:13px;outline:none;">
                </div>
                <div class="action-note" style="margin-bottom:10px;">
                  <label><%- lan.Admission_No_GR_No || 'Admission No / GR No' %> <span style="color:#dc2626;">*</span></label>
                  <input type="text" name="admission_no" value="<%= suggestedAdmissionNo || '' %>" required style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:10px;font-family:inherit;font-size:13px;outline:none;">
                </div>
                <div class="action-note" style="margin-bottom:10px;">
                  <label><%- lan.Academic_Year || 'Academic Year' %> <span style="color:#dc2626;">*</span></label>
                  <input id="approvalAcademicYear" type="text" name="academic_year" readonly required style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:10px;font-family:inherit;font-size:13px;outline:none;background:#f8fafc;">
                </div>
                <div class="action-note" style="margin-bottom:0;">
                  <label><%- lan.Medium || 'Medium' %> <span style="color:#dc2626;">*</span></label>
                  <input id="approvalMedium" type="text" name="medium" readonly required style="width:100%;border:1.5px solid #e2e8f0;border-radius:8px;padding:10px;font-family:inherit;font-size:13px;outline:none;background:#f8fafc;">
                </div>
              </div>
              <div class="action-note" style="margin-bottom:12px;color:#4a5568;font-size:13px;line-height:1.5;">
                <%- lan.Final_Section_Assignment_Notice || 'Final section is assigned here by the school admin. Student and parent applicants cannot choose it.' %>
              </div>
              <button type="submit" class="btn-action btn-approve-full"
                onclick="document.getElementById('approveNote').value=document.getElementById('sharedNote').value">
                <i class="fas fa-check-circle"></i> <%- lan.Approve_Admission || 'Approve Admission' %>
              </button>
            </form>
            <form method="POST" action="/schooladmin/admissions/<%= admission.id %>/reject">
              <input type="hidden" name="admin_note" id="rejectNote">
              <button type="submit" class="btn-action btn-reject-full"
                onclick="document.getElementById('rejectNote').value=document.getElementById('sharedNote').value">
                <i class="fas fa-times-circle"></i> <%- lan.Reject_Application || 'Reject Application' %>
              </button>
            </form>
            <% } else { %>
            <div class="already-decided">
              <% if (admission.status === 'approved') { %>
                <i class="fas fa-check-circle" style="color:#16a34a;"></i>
                <strong style="color:#15803d;"><%- lan.Approved || 'Approved' %></strong>
                <p style="margin-top:6px;"><%- lan.Application_Approved_Notice || 'This application has been approved. An email was sent to the applicant.' %></p>
              <% } else { %>
                <i class="fas fa-times-circle" style="color:#dc2626;"></i>
                <strong style="color:#dc2626;"><%- lan.Rejected || 'Rejected' %></strong>
                <p style="margin-top:6px;"><%- lan.Application_Rejected_Notice || 'This application was not selected. The applicant was notified via email.' %></p>
              <% } %>
            </div>
            <% } %>
          </div>
          <a href="/schooladmin/admissions" class="btn-back-list">
            <i class="fas fa-arrow-left"></i> <%- lan.Back_To_All_Admissions || 'Back to All Admissions' %>
          </a>
</div>
        <%- include('../../partials/footer') %>
          </div>
    </div>

  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const classSelect = document.getElementById('approvalClassSelect');
    const sectionSelect = document.getElementById('approvalSectionSelect');
    const academicYearInput = document.getElementById('approvalAcademicYear');
    const mediumInput = document.getElementById('approvalMedium');

    if (!classSelect || !sectionSelect) return;
    const selectSectionText = sectionSelect.dataset.placeholder || 'Select Section';

    classSelect.addEventListener('change', () => {
      const classId = classSelect.value;
      const selectedOption = classSelect.options[classSelect.selectedIndex];
      academicYearInput.value = selectedOption?.dataset.academicYear || '';
      mediumInput.value = selectedOption?.dataset.medium || '';

      if (!classId) {
        sectionSelect.innerHTML = `<option value="">${selectSectionText}</option>`;
        sectionSelect.disabled = true;
        return;
      }

      sectionSelect.disabled = true;
      sectionSelect.innerHTML = '<option value="">Loading...</option>';

      fetch(`/schooladmin/sections/by-class/${classId}`)
        .then(response => response.json())
        .then(data => {
          if (data.success && data.sections.length) {
            let html = `<option value="">${selectSectionText}</option>`;
            data.sections.forEach(section => {
              html += `<option value="${section.id}">Section ${section.name}</option>`;
            });
            sectionSelect.innerHTML = html;
            sectionSelect.disabled = false;
          } else {
            sectionSelect.innerHTML = '<option value="">No active sections</option>';
          }
        })
        .catch(err => {
          console.error(err);
          sectionSelect.innerHTML = '<option value="">Error loading sections</option>';
        });
    });
  });
</script>