<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">

      <style>
        .stats-strip {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 16px;
          margin-bottom: 24px;
        }
        .stat-card {
          background: var(--surface);
          border-radius: 14px;
          padding: 18px 20px;
          display: flex;
          align-items: center;
          gap: 14px;
          box-shadow: var(--shadow-sm);
          border: 1px solid var(--border);
          transition: transform 0.2s;
        }
        .stat-card:hover { transform: translateY(-2px); }
        .stat-icon {
          width: 46px; height: 46px;
          border-radius: 12px;
          display: flex; align-items: center; justify-content: center;
          font-size: 20px; flex-shrink: 0;
        }
        .stat-icon.purple { background: #f3f0ff; color: #7c3aed; }
        .stat-icon.orange { background: #fff7ed; color: #ea580c; }
        .stat-icon.green  { background: #f0fdf4; color: #16a34a; }
        .stat-icon.red    { background: #fef2f2; color: #dc2626; }
        .stat-val { font-size: 24px; font-weight: 800; color: var(--text-primary); line-height: 1; }
        .stat-lbl { font-size: 12px; color: var(--text-muted); font-weight: 500; margin-top: 2px; }

        .qr-container {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 24px;
          margin-bottom: 28px;
        }
        .qr-card {
          background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
          border-radius: 18px;
          padding: 28px;
          color: white;
          display: grid;
          grid-template-columns: 1fr auto;
          gap: 20px;
          align-items: center;
          box-shadow: var(--shadow-sm);
          transition: transform 0.2s;
        }
        .qr-card:hover { transform: translateY(-2px); }
        .qr-card.teacher-theme {
          background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        }
        .qr-card.driver-theme {
          background: linear-gradient(135deg, #0f766e 0%, #2563eb 100%);
        }
        .qr-card h2 { font-size: 19px; font-weight: 800; margin-bottom: 6px; }
        .qr-card p  { font-size: 12.5px; opacity: 0.85; margin-bottom: 16px; line-height: 1.5; }
        
        .btn-generate {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: white;
          color: #667eea;
          border: none;
          padding: 10px 20px;
          border-radius: 8px;
          font-size: 13px;
          font-weight: 700;
          cursor: pointer;
          transition: all 0.2s;
        }
        .qr-card.teacher-theme .btn-generate {
          color: #4f46e5;
        }
        .btn-generate:hover {
          background: #f0f2ff;
          transform: translateY(-1px);
          box-shadow: 0 4px 15px rgba(0,0,0,0.12);
        }
        .qr-result {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 10px;
        }
        .qr-result img {
          width: 140px; height: 140px;
          border-radius: 10px;
          border: 3px solid rgba(255,255,255,0.3);
        }
        .qr-result .qr-placeholder {
          width: 140px; height: 140px;
          border-radius: 10px;
          border: 2px dashed rgba(255,255,255,0.3);
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 6px;
          color: rgba(255,255,255,0.5);
          font-size: 12px;
        }
        .qr-result .qr-placeholder i { font-size: 30px; }
        .btn-download {
          background: rgba(255,255,255,0.15);
          color: white;
          border: 1px solid rgba(255,255,255,0.25);
          padding: 6px 14px;
          border-radius: 6px;
          font-size: 11.5px;
          font-weight: 600;
          cursor: pointer;
          text-decoration: none;
          display: inline-flex;
          align-items: center;
          gap: 5px;
          transition: all 0.2s;
        }
        .btn-download:hover { background: rgba(255,255,255,0.25); color: white; }
        .link-box {
          background: rgba(255,255,255,0.1);
          border: 1px solid rgba(255,255,255,0.18);
          border-radius: 8px;
          padding: 8px 12px;
          margin-top: 10px;
        }
        .link-box p { font-size: 11px; margin: 0; word-break: break-all; opacity: 0.9; }
        .copy-btn {
          background: rgba(255,255,255,0.18);
          color: white;
          border: none;
          padding: 4px 10px;
          border-radius: 5px;
          font-size: 10.5px;
          cursor: pointer;
          margin-top: 5px;
        }
        
        .section-title {
          font-size: 15px;
          font-weight: 700;
          color: var(--text-primary);
          margin-bottom: 14px;
          display: flex;
          align-items: center;
          gap: 8px;
        }
        .section-title i { color: #667eea; }
        
        .table-card {
          background: var(--surface);
          border-radius: 14px;
          overflow: hidden;
          box-shadow: var(--shadow-sm);
          border: 1px solid var(--border);
        }
        table { width: 100%; border-collapse: collapse; }
        thead th {
          background: var(--surface-hover);
          padding: 12px 16px;
          font-size: 11px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          color: var(--text-muted);
          border-bottom: 1px solid var(--border);
          text-align: left;
        }
        tbody td {
          padding: 13px 16px;
          font-size: 13px;
          color: var(--text-secondary);
          border-bottom: 1px solid var(--border);
        }
        tbody tr:last-child td { border-bottom: none; }
        tbody tr:hover { background: var(--surface-hover); }
        .qr-badge {
          display: inline-flex;
          align-items: center;
          gap: 4px;
          padding: 3px 10px;
          border-radius: 20px;
          font-size: 11px;
          font-weight: 600;
        }
        .badge-active  { background: #f0fdf4; color: #16a34a; }
        .badge-expired { background: #f9f9f9; color: #999; }
        .badge-used    { background: #fff7ed; color: #ea580c; }
        
        .view-all-btn {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 9px 18px;
          background: var(--surface-hover);
          color: var(--text-secondary);
          border-radius: 10px;
          font-size: 13px;
          font-weight: 600;
          text-decoration: none;
          transition: all 0.2s;
          border: 1px solid var(--border);
        }
        .view-all-btn:hover { background: #f0f4ff; color: #667eea; border-color: #667eea; }

        @media(max-width:992px) {
          .stats-strip { grid-template-columns: repeat(2,1fr); }
          .qr-container { grid-template-columns: 1fr; }
        }
        @media(max-width:576px) {
          .qr-card { grid-template-columns: 1fr; justify-items: center; text-align: center; }
        }
      </style>

      <div class="flex justify-between items-center mb-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Admission QR Portals</h2>
          <p class="text-xs text-gray-500 mt-1">Generate and distribute application QR codes for students and teachers</p>
        </div>
        <div style="display:flex; gap:10px;">
          <a href="/schooladmin/admissions" class="view-all-btn">
            <i class="fas fa-user-graduate"></i> Student Applications
          </a>
          <a href="/admin/teachers/applications" class="view-all-btn">
            <i class="fas fa-chalkboard-teacher"></i> Teacher Applications
          </a>
          <a href="/admin/drivers/applications" class="view-all-btn">
            <i class="fas fa-id-card"></i> Driver Applications
          </a>
        </div>
      </div>

      <%- include('../../partials/flashMessages') %>
      <% if (success && success.length) { %>
        <div class="alert-banner success mb-4"><i class="fas fa-check-circle"></i> <%= success[0] %></div>
      <% } %>
      <% if (error && error.length) { %>
        <div class="alert-banner error mb-4"><i class="fas fa-exclamation-triangle"></i> <%= error[0] %></div>
      <% } %>

      <div class="stats-strip">
        <div class="stat-card">
          <div class="stat-icon purple"><i class="fas fa-users"></i></div>
          <div>
            <div class="stat-val"><%= counts.total %></div>
            <div class="stat-lbl">Total Applications</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon orange"><i class="fas fa-clock"></i></div>
          <div>
            <div class="stat-val"><%= counts.pending %></div>
            <div class="stat-lbl">Pending Review</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
          <div>
            <div class="stat-val"><%= counts.approved %></div>
            <div class="stat-lbl">Approved</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon red"><i class="fas fa-times-circle"></i></div>
          <div>
            <div class="stat-val"><%= counts.rejected %></div>
            <div class="stat-lbl">Rejected</div>
          </div>
        </div>
      </div>

        <div class="qr-container">
            <div class="qr-card">
                <div>
                    <h2><i class="fas fa-user-graduate"></i> Student Admission QR</h2>
                    <p>Create a QR code that students or guardians can scan to submit a new student admission request online. Valid for <strong>7 days</strong> from generation.</p>
                    <form method="POST" action="/schooladmin/admissions/qr/generate">
                        <button type="submit" class="btn-generate">
                            <i class="fas fa-qrcode"></i> Generate Student QR
                        </button>
                    </form>
                    <% if (studentGeneratedLink) { %>
                        <div class="link-box">
                            <p id="studentLink"><%= studentGeneratedLink %></p>
                            <button class="copy-btn" onclick="copyLink('studentLink')" data-copy-for="studentLink"><i class="fas fa-copy"></i> Copy Link</button>
                        </div>
                    <% } %>
                </div>
            <div class="qr-result">
                <% if (studentQrDataUrl) { %>
                    <img src="<%= studentQrDataUrl %>" alt="Student Admission QR" id="studentQrImg">
                    <a href="<%= studentQrDataUrl %>" download="student-admission-qr.png" class="btn-download">
                        <i class="fas fa-download"></i> Download PNG
                    </a>
                <% } else { %>
                    <div class="qr-placeholder">
                        <i class="fas fa-qrcode"></i>
                        <span>No active QR<br>code available</span>
                    </div>
                <% } %>
            </div>
        </div>
        <div class="qr-card teacher-theme">
          <div>
            <h2><i class="fas fa-chalkboard-teacher"></i> Teacher Onboarding QR</h2>
            <p>Create a QR code that teachers can scan to submit their onboarding application profile. Valid until the **end of the academic year**.</p>
            <form method="POST" action="/schooladmin/admissions/teachers/qr/generate">
              <button type="submit" class="btn-generate">
                <i class="fas fa-qrcode"></i> Generate Teacher QR
              </button>
            </form>
            <% if (teacherGeneratedLink) { %>
            <div class="link-box">
              <p id="teacherLink"><%= teacherGeneratedLink %></p>
              <button class="copy-btn" onclick="copyLink('teacherLink')" data-copy-for="teacherLink"><i class="fas fa-copy"></i> Copy Link</button>
            </div>
            <% } %>
          </div>
          <div class="qr-result">
            <% if (teacherQrDataUrl) { %>
              <img src="<%= teacherQrDataUrl %>" alt="Teacher Onboarding QR" id="teacherQrImg">
              <a href="<%= teacherQrDataUrl %>" download="teacher-onboarding-qr.png" class="btn-download">
                <i class="fas fa-download"></i> Download PNG
              </a>
            <% } else { %>
              <div class="qr-placeholder">
                <i class="fas fa-qrcode"></i>
                <span>No active QR<br>code available</span>
              </div>
            <% } %>
          </div>
        </div>
        <div class="qr-card driver-theme">
          <div>
            <h2><i class="fas fa-id-card"></i> Driver Onboarding QR</h2>
            <p>Create a QR code that drivers can scan to submit license, identity, and onboarding details. Valid until the end of the academic year.</p>
            <form method="POST" action="/schooladmin/admissions/drivers/qr/generate">
              <button type="submit" class="btn-generate">
                <i class="fas fa-qrcode"></i> Generate Driver QR
              </button>
            </form>
            <% if (driverGeneratedLink) { %>
            <div class="link-box">
              <p id="driverLink"><%= driverGeneratedLink %></p>
              <button class="copy-btn" onclick="copyLink('driverLink')" data-copy-for="driverLink"><i class="fas fa-copy"></i> Copy Link</button>
            </div>
            <% } %>
          </div>
          <div class="qr-result">
            <% if (driverQrDataUrl) { %>
              <img src="<%= driverQrDataUrl %>" alt="Driver Onboarding QR" id="driverQrImg">
              <a href="<%= driverQrDataUrl %>" download="driver-onboarding-qr.png" class="btn-download">
                <i class="fas fa-download"></i> Download PNG
              </a>
            <% } else { %>
              <div class="qr-placeholder">
                <i class="fas fa-qrcode"></i>
                <span>No active QR<br>code available</span>
              </div>
            <% } %>
          </div>
        </div>
      </div>
      <div class="section-title">
        <i class="fas fa-history"></i> Recently Generated Portal Tokens
      </div>
      <div class="table-card">
        <% if (tokens && tokens.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Token Preview</th>
              <th>Role / Portal</th>
              <th>Status</th>
              <th>Expires At</th>
              <th>Generated On</th>
            </tr>
          </thead>
          <tbody>
            <% tokens.forEach((t, i) => {
              const now = new Date();
              const exp = new Date(t.expires_at);
              const isExpired = exp < now;
              const isUsed = t.used == 1;
              let badgeClass = 'badge-active', badgeLabel = 'Active';
              if (isUsed) { badgeClass = 'badge-used'; badgeLabel = 'Used'; }
              else if (isExpired) { badgeClass = 'badge-expired'; badgeLabel = 'Expired'; }
            %>
            <tr>
              <td style="color:#aaa;font-size:12px;"><%= i + 1 %></td>
              <td style="font-family:monospace;font-size:12px;color:#4f46e5;"><%= t.token.substring(0, 18) %>...</td>
              <td>
                <span class="qr-badge badge-active" style="text-transform:capitalize;">
                  <i class="fas <%= t.role === 'teacher' ? 'fa-chalkboard-teacher' : (t.role === 'driver' ? 'fa-id-card' : 'fa-user-graduate') %>" style="margin-right:4px;"></i><%= t.role %>
                </span>
              </td>
              <td><span class="qr-badge <%= badgeClass %>"><%= badgeLabel %></span></td>
              <td style="font-size:12px;color:var(--text-muted);"><%= new Date(t.expires_at).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></td>
              <td style="font-size:12px;color:var(--text-muted);"><%= new Date(t.created_at).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <% } else { %>
        <div class="empty-state" style="text-align:center;padding:40px;color:var(--text-muted);">
          <div class="empty-state-icon"><i class="fas fa-qrcode"></i></div>
          <h4 class="empty-state-title">No QR codes generated yet</h4>
          <p class="empty-state-text">Click "Generate Student QR" or "Generate Teacher QR" to create application portals.</p>
        </div>
        <% } %>
      </div>

    </div>
    <%- include('../../partials/footer') %>
  </div>
</div>

<script>
  function copyLink(elementId) {
    const link = document.getElementById(elementId).innerText;
    navigator.clipboard.writeText(link).then(() => {
      const btn = document.querySelector('[data-copy-for="' + elementId + '"]');
      btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
      setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy Link', 2000);
    });
  }
</script>
