<style>
    .admission-qr-page {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }
    .admission-qr-page .qr-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
    }
    .admission-qr-page .qr-page-heading h2 {
        margin: 0;
        color: var(--text-main, var(--text));
        font-family: 'DM Sans', var(--font-sans);
        font-size: 24px;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.02em;
    }
    .admission-qr-page .qr-page-heading p {
        margin: 5px 0 0;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.5;
    }
    .admission-qr-page .application-links {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
    }
    .admission-qr-page .portal-nav-btn {
        min-height: 40px;
        padding: 9px 15px;
        border: 1px solid var(--border-color, var(--border));
        border-radius: 10px;
        background: var(--bg-card, var(--surface));
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 700;
        box-shadow: var(--shadow-sm);
    }
    .admission-qr-page .portal-nav-btn i {
        color: var(--primary);
    }
    .admission-qr-page .portal-nav-btn:hover,
    .admission-qr-page .portal-nav-btn:focus-visible {
        border-color: var(--primary);
        background: var(--primary-light, #ECFDF5);
        color: var(--primary-dark);
    }
    .admission-qr-page .portal-nav-btn:active {
        transform: translateY(0);
    }

    .admission-qr-page .stats-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }
    .admission-qr-page .stat-card {
        min-height: 84px;
        background: var(--bg-card, var(--surface));
        border-radius: 16px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: var(--card-shadow, var(--shadow-sm));
        border: 1px solid var(--card-border, var(--border));
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .admission-qr-page .stat-card:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--primary) 26%, var(--border));
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.07);
    }
    .admission-qr-page .stat-icon {
        width: 46px; height: 46px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; flex-shrink: 0;
    }
    .admission-qr-page .stat-icon.total  { background: var(--primary-light, #ECFDF5); color: var(--primary-dark); }
    .admission-qr-page .stat-icon.orange { background: #FFF7ED; color: #C2410C; }
    .admission-qr-page .stat-icon.green  { background: #ECFDF5; color: #047857; }
    .admission-qr-page .stat-icon.red    { background: #FEF2F2; color: #DC2626; }
    .admission-qr-page .stat-val {
        font-size: 24px;
        font-weight: 800;
        color: var(--text-main, var(--text));
        line-height: 1;
    }
    .admission-qr-page .stat-lbl {
        font-size: 12px;
        color: var(--text-muted);
        font-weight: 500;
        margin-top: 4px;
    }

    .admission-qr-page .qr-container {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: stretch;
        gap: 18px;
        margin-bottom: 30px;
    }
    .admission-qr-page .qr-card {
        min-width: 0;
        max-width: 100%;
        height: 100%;
        background: var(--bg-card, var(--surface));
        border: 1px solid var(--card-border, var(--border));
        border-radius: 18px;
        padding: 24px;
        color: var(--text-main, var(--text));
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: var(--card-shadow, var(--shadow-sm));
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .admission-qr-page .qr-card:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--primary) 34%, var(--border));
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
    }
    .admission-qr-page .qr-card-copy {
        display: flex;
        flex: 1;
        flex-direction: column;
        min-width: 0;
    }
    .admission-qr-page .qr-card-title {
        display: flex;
        align-items: center;
        min-width: 0;
        gap: 12px;
        margin-bottom: 10px;
    }
    .admission-qr-page .qr-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 44px;
        background: var(--primary-light, #ECFDF5);
        color: var(--primary-dark);
        font-size: 18px;
    }
    .admission-qr-page .qr-card h2 {
        min-width: 0;
        margin: 0;
        color: var(--text-main, var(--text));
        font-size: 17px;
        font-weight: 800;
        line-height: 1.3;
        overflow-wrap: anywhere;
    }
    .admission-qr-page .qr-card-description {
        min-height: 76px;
        margin: 0 0 18px;
        color: var(--text-muted);
        font-size: 12.5px;
        line-height: 1.55;
    }
    .admission-qr-page .qr-card-description strong {
        color: var(--text-secondary);
        font-weight: 700;
    }
    .admission-qr-page .qr-generate-form {
        margin-top: auto;
    }
    .admission-qr-page .btn-generate {
        width: 100%;
        min-height: 42px;
        border-radius: 10px;
        background: var(--primary);
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 700;
    }
    .admission-qr-page .btn-generate:hover {
        background: var(--primary-dark);
        color: #FFFFFF;
        transform: translateY(-1px);
        box-shadow: 0 7px 16px rgba(5, 150, 105, 0.2);
    }
    .admission-qr-page .btn-generate:active {
        transform: translateY(0);
    }
    .admission-qr-page .qr-result {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--border-color, var(--border));
    }
    .admission-qr-page .qr-result img {
        display: block;
        width: 164px;
        height: 164px;
        padding: 10px;
        border-radius: 12px;
        border: 1px solid var(--border-color, var(--border));
        background: #FFFFFF;
        object-fit: contain;
        box-shadow: var(--shadow-sm);
    }
    .admission-qr-page .qr-placeholder {
        width: 164px;
        height: 164px;
        border-radius: 12px;
        border: 1px dashed #CBD5E1;
        background: #F8FAFC;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: #94A3B8;
        font-size: 12px;
        line-height: 1.45;
        text-align: center;
    }
    .admission-qr-page .qr-placeholder i {
        color: var(--primary);
        font-size: 30px;
        opacity: 0.7;
    }
    .admission-qr-page .btn-download {
        min-height: 36px;
        padding: 7px 14px;
        border: 1px solid color-mix(in srgb, var(--primary) 42%, var(--border));
        border-radius: 9px;
        background: #FFFFFF;
        color: var(--primary-dark);
        font-size: 11.5px;
        font-weight: 700;
    }
    .admission-qr-page .btn-download:hover {
        border-color: var(--primary);
        background: var(--primary-light, #ECFDF5);
        color: var(--primary-dark);
    }
    .admission-qr-page .link-box {
        min-width: 0;
        margin-top: 12px;
        padding: 11px 12px;
        border: 1px solid var(--border-color, var(--border));
        border-radius: 10px;
        background: #F8FAFC;
    }
    .admission-qr-page .link-box p {
        margin: 0;
        color: var(--text-secondary);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 10.5px;
        line-height: 1.5;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .admission-qr-page .copy-btn {
        min-height: 30px;
        margin-top: 8px;
        padding: 5px 10px;
        border: 1px solid color-mix(in srgb, var(--primary) 35%, var(--border));
        border-radius: 8px;
        background: var(--primary-light, #ECFDF5);
        color: var(--primary-dark);
        font-size: 10.5px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }
    .admission-qr-page .copy-btn:hover {
        border-color: var(--primary);
        background: var(--primary);
        color: #FFFFFF;
    }
    
    .admission-qr-page .section-title {
        font-size: 15px;
        font-weight: 800;
        color: var(--text-main, var(--text));
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .admission-qr-page .section-title i { color: var(--primary); }
    
    .admission-qr-page .table-card {
        background: var(--bg-card, var(--surface));
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--card-shadow, var(--shadow-sm));
        border: 1px solid var(--card-border, var(--border));
    }
    .admission-qr-page .table-scroll {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    .admission-qr-page table {
        width: 100%;
        min-width: 698px;
        border-collapse: collapse;
    }
    .admission-qr-page thead th {
        background: #F8FAFC;
        padding: 11px 15px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        border-bottom: 1px solid var(--border-color, var(--border));
        text-align: left;
        white-space: nowrap;
    }
    .admission-qr-page tbody td {
        padding: 12px 15px;
        font-size: 12.5px;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border-color, var(--border));
        vertical-align: middle;
    }
    .admission-qr-page tbody tr:last-child td { border-bottom: none; }
    .admission-qr-page tbody tr:hover { background: var(--surface-hover); }
    .admission-qr-page .token-index,
    .admission-qr-page .token-date { color: var(--text-muted); font-size: 12px; }
    .admission-qr-page .token-preview {
        color: var(--primary-dark);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 11.5px;
    }
    .admission-qr-page .qr-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
    }
    .admission-qr-page .role-student { background: #ECFDF5; color: #047857; }
    .admission-qr-page .role-teacher,
    .admission-qr-page .role-driver { background: #F1F5F9; color: #334155; }
    .admission-qr-page .role-teacher i,
    .admission-qr-page .role-driver i { color: var(--primary); }
    .admission-qr-page .badge-active  { background: #ECFDF5; color: #047857; }
    .admission-qr-page .badge-expired { background: #F1F5F9; color: #64748B; }
    .admission-qr-page .badge-used    { background: #FFF7ED; color: #C2410C; }
    .admission-qr-page .badge-revoked { background: #FEF2F2; color: #B91C1C; }
    .admission-qr-page .empty-state {
        padding: 42px 20px;
        color: var(--text-muted);
        text-align: center;
    }
    .admission-qr-page .empty-state-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 12px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-light, #ECFDF5);
        color: var(--primary);
        font-size: 21px;
    }
    .admission-qr-page .empty-state-title {
        margin: 0 0 5px;
        color: var(--text-main, var(--text));
        font-size: 14px;
        font-weight: 700;
    }
    .admission-qr-page .empty-state-text { margin: 0; font-size: 12px; }

    @media (max-width: 1100px) {
        .admission-qr-page .qr-page-header { flex-direction: column; }
        .admission-qr-page .application-links { justify-content: flex-start; }
        .admission-qr-page .stats-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .admission-qr-page .qr-container { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .admission-qr-page .qr-card-description { min-height: 58px; }
    }
    @media (max-width: 768px) {
        .admission-qr-page .qr-container { grid-template-columns: 1fr; }
        .admission-qr-page .qr-card-description { min-height: 0; }
        .admission-qr-page .application-links {
        display: grid;
        grid-template-columns: 1fr;
        width: 100%;
        }
        .admission-qr-page .portal-nav-btn {
        width: 100%;
        max-width: 100%;
        white-space: normal;
        }
        .admission-qr-page .btn-generate { white-space: normal; }
    }
    @media (max-width: 576px) {
        .admission-qr-page .qr-page-heading h2 { font-size: 21px; }
        .admission-qr-page .stats-strip { grid-template-columns: 1fr; gap: 12px; }
        .admission-qr-page .stat-card { min-height: 76px; padding: 15px 17px; }
        .admission-qr-page .qr-card { padding: 20px; }
        .admission-qr-page .portal-nav-btn,
        .admission-qr-page .btn-download { width: 100%; }
        .admission-qr-page .qr-result img,
        .admission-qr-page .qr-placeholder { width: 156px; height: 156px; }
    }

    [data-theme="dark"] .admission-qr-page .qr-page-heading h2,
    .light-mode-disabled .admission-qr-page .qr-page-heading h2 {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .admission-qr-page .portal-nav-btn,
    .light-mode-disabled .admission-qr-page .portal-nav-btn {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .admission-qr-page .portal-nav-btn:hover,
    .light-mode-disabled .admission-qr-page .portal-nav-btn:hover {
        background: #1E293B !important;
        border-color: #10B981 !important;
        color: #10B981 !important;
    }

    [data-theme="dark"] .admission-qr-page .stat-card,
    [data-theme="dark"] .admission-qr-page .qr-card,
    [data-theme="dark"] .admission-qr-page .table-card,
    .light-mode-disabled .admission-qr-page .stat-card,
    .light-mode-disabled .admission-qr-page .qr-card,
    .light-mode-disabled .admission-qr-page .table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .admission-qr-page .qr-card-icon,
    .light-mode-disabled .admission-qr-page .qr-card-icon {
        background: rgba(16, 185, 129, 0.18) !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .admission-qr-page .link-box,
    .light-mode-disabled .admission-qr-page .link-box {
        background: #0F172A !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .admission-qr-page .link-box p,
    .light-mode-disabled .admission-qr-page .link-box p {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .admission-qr-page .copy-btn,
    .light-mode-disabled .admission-qr-page .copy-btn {
        background: rgba(16, 185, 129, 0.18) !important;
        border-color: rgba(16, 185, 129, 0.35) !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .admission-qr-page .copy-btn:hover,
    .light-mode-disabled .admission-qr-page .copy-btn:hover {
        background: #10B981 !important;
        color: #FFFFFF !important;
    }

    [data-theme="dark"] .admission-qr-page .btn-download,
    .light-mode-disabled .admission-qr-page .btn-download {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .admission-qr-page .btn-download:hover,
    .light-mode-disabled .admission-qr-page .btn-download:hover {
        background: #242F4D !important;
        border-color: #10B981 !important;
        color: #10B981 !important;
    }

    [data-theme="dark"] .admission-qr-page thead th,
    .light-mode-disabled .admission-qr-page thead th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .admission-qr-page tbody td,
    .light-mode-disabled .admission-qr-page tbody td {
        border-color: #242F4D !important;
        color: #CBD5E1 !important;
    }

    [data-theme="dark"] .admission-qr-page tbody tr:hover td,
    .light-mode-disabled .admission-qr-page tbody tr:hover td {
        background: #1E293B !important;
    }

    [data-theme="dark"] .admission-qr-page .token-preview,
    .light-mode-disabled .admission-qr-page .token-preview {
        color: #60A5FA !important;
    }

    [data-theme="dark"] .admission-qr-page .role-student,
    .light-mode-disabled .admission-qr-page .role-student {
        background: rgba(16, 185, 129, 0.18) !important;
        border: 1px solid rgba(16, 185, 129, 0.35) !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .admission-qr-page .role-teacher,
    [data-theme="dark"] .admission-qr-page .role-driver,
    .light-mode-disabled .admission-qr-page .role-teacher,
    .light-mode-disabled .admission-qr-page .role-driver {
        background: rgba(59, 130, 246, 0.18) !important;
        border: 1px solid rgba(59, 130, 246, 0.35) !important;
        color: #93C5FD !important;
    }

    [data-theme="dark"] .admission-qr-page .badge-active,
    .light-mode-disabled .admission-qr-page .badge-active {
        background: rgba(16, 185, 129, 0.18) !important;
        border: 1px solid rgba(16, 185, 129, 0.35) !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .admission-qr-page .badge-expired,
    .light-mode-disabled .admission-qr-page .badge-expired {
        background: rgba(100, 116, 139, 0.2) !important;
        border: 1px solid rgba(100, 116, 139, 0.35) !important;
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .admission-qr-page .badge-used,
    .light-mode-disabled .admission-qr-page .badge-used {
        background: rgba(245, 158, 11, 0.18) !important;
        border: 1px solid rgba(245, 158, 11, 0.35) !important;
        color: #FBBF24 !important;
    }

    [data-theme="dark"] .admission-qr-page .badge-revoked,
    .light-mode-disabled .admission-qr-page .badge-revoked {
        background: rgba(239, 68, 68, 0.18) !important;
        border: 1px solid rgba(239, 68, 68, 0.35) !important;
        color: #F87171 !important;
    }
</style>
<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="admission-qr-page">
                <div class="qr-page-header">
                    <div class="qr-page-heading">
                        <h2>Admission QR Portals</h2>
                        <p>Generate and distribute application QR codes for students and teachers</p>
                    </div>
                    <nav class="application-links" aria-label="Application lists">
                        <a href="/schooladmin/admissions" class="btn btn-secondary portal-nav-btn">
                            <i class="fas fa-user-graduate"></i> Student Applications
                        </a>
                        <a href="/admin/teachers/applications" class="btn btn-secondary portal-nav-btn">
                            <i class="fas fa-chalkboard-teacher"></i> Teacher Applications
                        </a>
                        <a href="/admin/drivers/applications" class="btn btn-secondary portal-nav-btn">
                            <i class="fas fa-id-card"></i> Driver Applications
                        </a>
                    </nav>
                </div>
                <%- include('../../partials/flashMessages') %>
                <% if (success && success.length) { %>
                    <div class="alert-banner success mb-4"><i class="fas fa-check-circle"></i> <%= success[0] %></div>
                <% } %>
                <% if (error && error.length) { %>
                    <div class="alert-banner error mb-4"><i class="fas fa-exclamation-triangle"></i> <%= error[0] %></div>
                <% } %>
                <div class="stats-strip">
                    <div class="stat-card">
                        <div class="stat-icon total"><i class="fas fa-users"></i></div>
                    <div>
                    <div class="stat-val"><%= counts.total %></div>
                    <div class="stat-lbl">Total Applications</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange"><i class="fas fa-clock"></i></div>
                <div>
                    <div class="stat-val"><%= counts.pending %></div>
                    <div class="stat-lbl">Pending Review</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
                <div>
                    <div class="stat-val"><%= counts.approved %></div>
                    <div class="stat-lbl">Approved</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon red"><i class="fas fa-times-circle"></i></div>
                <div>
                    <div class="stat-val"><%= counts.rejected %></div>
                    <div class="stat-lbl">Rejected</div>
                </div>
            </div>
        </div>
        <div class="qr-container">
            <article class="qr-card">
                <div class="qr-card-copy">
                    <div class="qr-card-title">
                        <span class="qr-card-icon" aria-hidden="true"><i class="fas fa-user-graduate"></i></span>
                        <h2>Student Admission QR</h2>
                    </div>
                    <p class="qr-card-description">Create a QR code that students or guardians can scan to submit a new student admission request online. Valid for <strong>1 month</strong> from generation.</p>
                    <form class="qr-generate-form" method="POST" action="/schooladmin/admissions/qr/generate">
                        <button type="submit" class="btn btn-primary btn-generate">
                            <i class="fas fa-qrcode"></i> Generate Student QR
                        </button>
                    </form>
                    <% if (studentGeneratedLink) { %>
                        <div class="link-box">
                            <p id="studentLink"><%= studentGeneratedLink %></p>
                            <button type="button" class="copy-btn" onclick="copyLink('studentLink')" data-copy-for="studentLink" aria-live="polite">
                                <i class="fas fa-copy"></i> Copy Link
                            </button>
                        </div>
                    <% } %>
                </div>
                <div class="qr-result">
                    <% if (studentQrDataUrl) { %>
                        <img src="<%= studentQrDataUrl %>" alt="Student Admission QR" id="studentQrImg">
                        <a href="<%= studentQrDataUrl %>" download="student-admission-qr.png" class="btn btn-secondary btn-download">
                            <i class="fas fa-download"></i> Download PNG
                        </a>
                    <% } else { %>
                        <div class="qr-placeholder" aria-label="No active student admission QR code available">
                            <i class="fas fa-qrcode" aria-hidden="true"></i>
                            <span>No active QR<br>code available</span>
                        </div>
                    <% } %>
                </div>
            </article>
            <article class="qr-card">
                <div class="qr-card-copy">
                    <div class="qr-card-title">
                        <span class="qr-card-icon" aria-hidden="true"><i class="fas fa-chalkboard-teacher"></i></span>
                        <h2>Teacher Onboarding QR</h2>
                    </div>
                    <p class="qr-card-description">Create a QR code that teachers can scan to submit their onboarding application profile. Valid for <strong>1 month</strong> from generation.</p>
                    <form class="qr-generate-form" method="POST" action="/schooladmin/admissions/teachers/qr/generate">
                        <button type="submit" class="btn btn-primary btn-generate">
                            <i class="fas fa-qrcode"></i> Generate Teacher QR
                        </button>
                    </form>
                    <% if (teacherGeneratedLink) { %>
                        <div class="link-box">
                            <p id="teacherLink"><%= teacherGeneratedLink %></p>
                            <button type="button" class="copy-btn" onclick="copyLink('teacherLink')" data-copy-for="teacherLink" aria-live="polite">
                                <i class="fas fa-copy"></i> Copy Link
                            </button>
                        </div>
                    <% } %>
                </div>
                <div class="qr-result">
                    <% if (teacherQrDataUrl) { %>
                        <img src="<%= teacherQrDataUrl %>" alt="Teacher Onboarding QR" id="teacherQrImg">
                        <a href="<%= teacherQrDataUrl %>" download="teacher-onboarding-qr.png" class="btn btn-secondary btn-download">
                            <i class="fas fa-download"></i> Download PNG
                        </a>
                    <% } else { %>
                        <div class="qr-placeholder" aria-label="No active teacher onboarding QR code available">
                            <i class="fas fa-qrcode" aria-hidden="true"></i>
                            <span>No active QR<br>code available</span>
                        </div>
                    <% } %>
                </div>
            </article>
            <article class="qr-card">
                <div class="qr-card-copy">
                    <div class="qr-card-title">
                        <span class="qr-card-icon" aria-hidden="true"><i class="fas fa-id-card"></i></span>
                        <h2>Driver Onboarding QR</h2>
                    </div>
                    <p class="qr-card-description">Create a QR code that drivers can scan to submit license, identity, and onboarding details. Valid for <strong>1 month</strong> from generation.</p>
                    <form class="qr-generate-form" method="POST" action="/schooladmin/admissions/drivers/qr/generate">
                        <button type="submit" class="btn btn-primary btn-generate">
                            <i class="fas fa-qrcode"></i> Generate Driver QR
                        </button>
                    </form>
                    <% if (driverGeneratedLink) { %>
                        <div class="link-box">
                            <p id="driverLink"><%= driverGeneratedLink %></p>
                            <button type="button" class="copy-btn" onclick="copyLink('driverLink')" data-copy-for="driverLink" aria-live="polite">
                                <i class="fas fa-copy"></i> Copy Link
                            </button>
                        </div>
                    <% } %>
                </div>
                <div class="qr-result">
                    <% if (driverQrDataUrl) { %>
                        <img src="<%= driverQrDataUrl %>" alt="Driver Onboarding QR" id="driverQrImg">
                        <a href="<%= driverQrDataUrl %>" download="driver-onboarding-qr.png" class="btn btn-secondary btn-download">
                            <i class="fas fa-download"></i> Download PNG
                        </a>
                    <% } else { %>
                        <div class="qr-placeholder" aria-label="No active driver onboarding QR code available">
                            <i class="fas fa-qrcode" aria-hidden="true"></i>
                            <span>No active QR<br>code available</span>
                        </div>
                    <% } %>
                </div>
            </article>
        </div>
        <div class="section-title">
            <i class="fas fa-history"></i> Recently Generated Portal Tokens
        </div>
        <div class="table-card">
            <% if (tokens && tokens.length > 0) { %>
                <div class="table-scroll" role="region" aria-label="Recently generated portal tokens" tabindex="0">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Token Preview</th>
                                <th>Role / Portal</th>
                                <th>Status</th>
                                <th>Expires At</th>
                                <th>Generated On</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% tokens.forEach((t, i) => {
                                const now = new Date();
                                const exp = new Date(t.expires_at);
                                const isExpired = exp < now;
                                const isUsed = t.used == 1;
                                const isRevoked = String(t.status || '').toLowerCase() === 'revoked' || t.revoked == 1;
                                const roleKey = t.role === 'teacher' ? 'teacher' : (t.role === 'driver' ? 'driver' : 'student');
                                let badgeClass = 'badge-active', badgeLabel = 'Active';
                                if (isRevoked) { badgeClass = 'badge-revoked'; badgeLabel = 'Revoked'; }
                                else if (isUsed) { badgeClass = 'badge-used'; badgeLabel = 'Used'; }
                                else if (isExpired) { badgeClass = 'badge-expired'; badgeLabel = 'Expired'; }
                            %>
                                <tr>
                                    <td class="token-index"><%= i + 1 %></td>
                                    <td class="token-preview"><%= t.token.substring(0, 18) %>...</td>
                                    <td>
                                        <span class="qr-badge role-<%= roleKey %>" style="text-transform:capitalize;">
                                            <i class="fas <%= roleKey === 'teacher' ? 'fa-chalkboard-teacher' : (roleKey === 'driver' ? 'fa-id-card' : 'fa-user-graduate') %>" aria-hidden="true"></i><%= roleKey %>
                                        </span>
                                    </td>
                                    <td><span class="qr-badge <%= badgeClass %>"><%= badgeLabel %></span></td>
                                    <td class="token-date"><%= new Date(t.expires_at).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></td>
                                    <td class="token-date"><%= new Date(t.created_at).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-qrcode"></i></div>
                    <h4 class="empty-state-title">No QR codes generated yet</h4>
                    <p class="empty-state-text">Generate a student, teacher, or driver QR code to create an application portal.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>
</div>
</div>
<script>
    function copyLink(elementId) {
        const link = document.getElementById(elementId).innerText;
        navigator.clipboard.writeText(link).then(() => {
            const btn = document.querySelector('[data-copy-for="' + elementId + '"]');
            btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
            setTimeout(() => btn.innerHTML = '<i class="fas fa-copy"></i> Copy Link', 2000);
        });
    };
</script>