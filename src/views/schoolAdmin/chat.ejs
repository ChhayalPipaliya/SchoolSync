<style>
    .chat-filter-btn {
        background: rgba(255, 255, 255, 0.18);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.3);
        font-weight: 600;
        padding: 6px 12px;
        font-size: 11px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
    }
    .chat-filter-btn:hover {
        background: rgba(255, 255, 255, 0.28);
        color: #ffffff;
    }
    .chat-filter-btn.active {
        background: #ffffff;
        color: #059669;
        font-weight: 700;
        border-color: #ffffff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    }
</style>
<div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                <i class="fa-solid fa-comments"></i>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%= lan.School_Staff_Messaging %></h1>
                <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%= lan.School_Staff_Messaging_Subtitle %></p>
            </div>
        </div>
        <% if (typeof allowedChatRoles !== 'undefined' && allowedChatRoles.length > 1) { %>
        <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
            <a href="/schooladmin/chat" class="chat-filter-btn <%= !filterRole ? 'active' : '' %>"><%= lan.All_Contacts %></a>
            <% if (allowedChatRoles.includes('teacher')) { %>
                <a href="/schooladmin/chat?role=teacher" class="chat-filter-btn <%= filterRole === 'teacher' ? 'active' : '' %>"><%= lan.Teachers %></a>
            <% } %>
            <% if (allowedChatRoles.includes('driver')) { %>
                <a href="/schooladmin/chat?role=driver" class="chat-filter-btn <%= filterRole === 'driver' ? 'active' : '' %>"><%= lan.Drivers %></a>
            <% } %>
            <% if (allowedChatRoles.includes('librarian')) { %>
                <a href="/schooladmin/chat?role=librarian" class="chat-filter-btn <%= filterRole === 'librarian' ? 'active' : '' %>"><%= lan.Librarians %></a>
            <% } %>
        </div>
        <% } %>
    </div>
</div>
<%- include('../partials/chatWindow') %>