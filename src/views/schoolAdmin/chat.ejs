<div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
        <h3 class="text-xl font-bold text-slate-800 m-0">School Staff Messaging</h3>
        <p class="text-slate-500 text-xs mt-1 m-0">Communicate in real-time with Teachers, Drivers, Librarians, and Branch Admins</p>
    </div>
    <% if (typeof allowedChatRoles !== 'undefined' && allowedChatRoles.length > 1) { %>
    <div class="flex items-center gap-1.5 flex-wrap">
        <a href="/schooladmin/chat" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= !filterRole ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">All Contacts</a>
        <% if (allowedChatRoles.includes('teacher')) { %>
            <a href="/schooladmin/chat?role=teacher" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filterRole === 'teacher' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">Teachers</a>
        <% } %>
        <% if (allowedChatRoles.includes('driver')) { %>
            <a href="/schooladmin/chat?role=driver" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filterRole === 'driver' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">Drivers</a>
        <% } %>
        <% if (allowedChatRoles.includes('librarian')) { %>
            <a href="/schooladmin/chat?role=librarian" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filterRole === 'librarian' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">Librarians</a>
        <% } %>
    </div>
    <% } %>
</div>
<%- include('../partials/chatWindow') %>