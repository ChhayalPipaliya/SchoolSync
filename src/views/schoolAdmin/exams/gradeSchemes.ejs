<%- include('../../partials/head') %>
<style>
    .grade-badge { font-size: 15px; font-weight: 800; display: inline-block; min-width: 36px; text-align: center; padding: 2px 10px; border-radius: 6px; }
    .grade-badge-a1 { color: #059669; background: rgba(5, 150, 105, 0.12); }
    .grade-badge-a2 { color: #10B981; background: rgba(16, 185, 129, 0.12); }
    .grade-badge-b1 { color: #0EA5E9; background: rgba(14, 165, 233, 0.12); }
    .grade-badge-b2 { color: #0284C7; background: rgba(2, 132, 199, 0.12); }
    .grade-badge-c1 { color: #F59E0B; background: rgba(245, 158, 11, 0.12); }
    .grade-badge-c2 { color: #FBBF24; background: rgba(251, 191, 36, 0.12); }
    .grade-badge-d  { color: #94A3B8; background: rgba(148, 163, 184, 0.12); }
    .grade-badge-e  { color: #EF4444; background: rgba(239, 68, 68, 0.12); }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { active: 'exams', user: user }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 style="font-size: 22px; font-weight: 700; color: #1E293B; margin: 0;"><i class="fa-solid fa-star me-2" style="color: #F59E0B;"></i>Grade Schemes</h2>
                    <div style="font-size: 12px; color: #94A3B8; margin-top: 4px;">Customize grading bands for your school</div>
                </div>
                <a href="/schooladmin/exams" class="btn btn-light" style="border-radius: 8px; font-size: 13px; font-weight: 600; border: 1px solid #E2E8F0; background: #fff;">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Exams
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card" style="border-radius: 12px; border: 1px solid #E2E8F0; padding: 24px;">
                        <h6 style="font-size: 15px; font-weight: 700; color: #1E293B; margin-bottom: 20px;"><i class="fa-solid fa-plus-circle me-2" style="color: var(--primary);"></i>Add Grade Band</h6>
                        <form method="POST" action="/schooladmin/exams/grade-schemes/add">
                            <div class="mb-3">
                                <label style="font-size: 12px; font-weight: 600; color: #374151; text-transform: uppercase; letter-spacing: 0.3px;">Grade Label *</label>
                                <input type="text" name="grade" required maxlength="10" placeholder="e.g. A+, A, B" style="width: 100%; padding: 9px 12px; border: 1.5px solid #E2E8F0; border-radius: 8px; font-size: 14px; margin-top: 4px; outline: none;">
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label style="font-size: 12px; font-weight: 600; color: #374151; text-transform: uppercase; letter-spacing: 0.3px;">Min %</label>
                                    <input type="number" name="min_marks" step="0.01" min="0" max="100" required placeholder="e.g. 91" style="width: 100%; padding: 9px 12px; border: 1.5px solid #E2E8F0; border-radius: 8px; font-size: 14px; margin-top: 4px; outline: none;">
                                </div>
                                <div class="col-6">
                                    <label style="font-size: 12px; font-weight: 600; color: #374151; text-transform: uppercase; letter-spacing: 0.3px;">Max %</label>
                                    <input type="number" name="max_marks" step="0.01" min="0" max="100" required placeholder="e.g. 100" style="width: 100%; padding: 9px 12px; border: 1.5px solid #E2E8F0; border-radius: 8px; font-size: 14px; margin-top: 4px; outline: none;">
                                </div>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label style="font-size: 12px; font-weight: 600; color: #374151; text-transform: uppercase; letter-spacing: 0.3px;">Grade Point</label>
                                    <input type="number" name="grade_point" step="0.1" min="0" max="10" placeholder="e.g. 10.0" style="width: 100%; padding: 9px 12px; border: 1.5px solid #E2E8F0; border-radius: 8px; font-size: 14px; margin-top: 4px; outline: none;">
                                </div>
                                <div class="col-6">
                                    <label style="font-size: 12px; font-weight: 600; color: #374151; text-transform: uppercase; letter-spacing: 0.3px;">Scheme Name</label>
                                    <input type="text" name="scheme_name" value="Default" maxlength="50" style="width: 100%; padding: 9px 12px; border: 1.5px solid #E2E8F0; border-radius: 8px; font-size: 14px; margin-top: 4px; outline: none;">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label style="font-size: 12px; font-weight: 600; color: #374151; text-transform: uppercase; letter-spacing: 0.3px;">Description</label>
                                <input type="text" name="description" placeholder="e.g. Outstanding, Excellent" maxlength="100" style="width: 100%; padding: 9px 12px; border: 1.5px solid #E2E8F0; border-radius: 8px; font-size: 14px; margin-top: 4px; outline: none;">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa-solid fa-plus me-1"></i> Add Grade Band
                            </button>
                        </form>
                    </div>
                    <div class="card mt-3" style="border-radius: 12px; border: 1px solid #E2E8F0; padding: 20px; background: #F8FAFC;">
                        <h6 style="font-size: 13px; font-weight: 700; color: #1E293B; margin-bottom: 12px;"><i class="fa-solid fa-info-circle me-2" style="color: #0284C7;"></i>CBSE Default Scale</h6>
                        <div style="font-size: 11px; color: #475569; line-height: 2;">
                            <div>A1 (10.0) — 91–100%</div>
                            <div>A2 (9.0) — 81–90%</div>
                            <div>B1 (8.0) — 71–80%</div>
                            <div>B2 (7.0) — 61–70%</div>
                            <div>C1 (6.0) — 51–60%</div>
                            <div>C2 (5.0) — 41–50%</div>
                            <div>D (4.0) — 33–40%</div>
                            <div>E (0.0) — 0–32% (Fail)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="table-card">
                        <div class="table-header-row">
                            <h6 class="table-heading">Current Grade Scheme (<%= schemes.length %> bands)</h6>
                        </div>
                        <% if (schemes.length > 0) { %>
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Grade</th>
                                        <th style="text-align: center;">Min %</th>
                                        <th style="text-align: center;">Max %</th>
                                        <th style="text-align: center;">Grade Point</th>
                                        <th>Description</th>
                                        <th style="text-align: center;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% schemes.forEach(s => { const gradeClass = s.max_marks >= 91 ? 'a1' : s.max_marks >= 81 ? 'a2' : s.max_marks >= 71 ? 'b1' : s.max_marks >= 61 ? 'b2' : s.max_marks >= 51 ? 'c1' : s.max_marks >= 41 ? 'c2' : s.max_marks >= 33 ? 'd' : 'e'; %>
                                        <tr>
                                            <td>
                                                <span class="grade-badge grade-badge-<%= gradeClass %>"><%= s.grade %></span>
                                            </td>
                                            <td style="text-align: center; font-size: 13px; font-weight: 600; color: #475569;"><%= s.min_marks %>%</td>
                                            <td style="text-align: center; font-size: 13px; font-weight: 600; color: #475569;"><%= s.max_marks %>%</td>
                                            <td style="text-align: center; font-size: 13px; font-weight: 700; color: #1E293B;"><%= s.grade_point %></td>
                                            <td><%= s.description || '—' %></td>
                                            <td style="text-align: center;">
                                                <form method="POST" action="/schooladmin/exams/grade-schemes/<%= s.id %>/delete" onsubmit="return confirm('Remove this grade band?')" style="display:inline;">
                                                    <button type="submit" class="btn-icon btn-danger-icon">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <% } else { %>
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fa-solid fa-star"></i>
                                </div>
                                <h6 class="empty-state-title">No grade schemes defined yet.</h6>
                                <p class="empty-state-text">Add your first grade band using the form.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>