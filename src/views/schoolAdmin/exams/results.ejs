<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { active: 'exams', user: user }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 style="font-size: 22px; font-weight: 700; color: #1E293B; margin: 0;">Result Overview</h2>
                    <div style="font-size: 12px; color: #94A3B8; margin-top: 4px;">
                        <%= exam.name %> &rarr; Class <%= exam.class_name %> (<%= exam.section %>) &rarr; <%= stats.total %> students
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/schooladmin/exams/<%= exam.id %>/export" class="btn btn-secondary">
                        <i class="fa-solid fa-file-csv me-1"></i> Export CSV
                    </a>
                    <a href="/schooladmin/exams/<%= exam.id %>/reportcard" target="_blank" class="btn btn-primary">
                        <i class="fa-solid fa-file-pdf me-1"></i> Print Report Cards
                    </a>
                    <a href="/schooladmin/exams" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-2">
                    <div style="background: var(--primary-gradient); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                        <div style="font-size: 28px; font-weight: 800;"><%= stats.total %></div>
                        <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;">Total</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div style="background: linear-gradient(135deg, #10B981, #059669); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                        <div style="font-size: 28px; font-weight: 800;"><%= stats.passed %></div>
                        <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;">Passed</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div style="background: linear-gradient(135deg, #EF4444, #DC2626); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                        <div style="font-size: 28px; font-weight: 800;"><%= stats.failed %></div>
                        <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;">Failed</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div style="background: linear-gradient(135deg, #F59E0B, #D97706); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                        <div style="font-size: 28px; font-weight: 800;"><%= stats.passPercent %>%</div>
                        <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;">Pass Rate</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div style="background: linear-gradient(135deg, #0284C7, #0EA5E9); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                        <div style="font-size: 28px; font-weight: 800;"><%= stats.avgMarks %></div>
                        <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;">Avg Marks</div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div style="background: var(--primary-gradient); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                        <div style="font-size: 28px; font-weight: 800;"><%= stats.highestMarks %></div>
                        <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;">Highest</div>
                    </div>
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <div class="card" style="border-radius: 12px; border: 1px solid #E2E8F0; padding: 20px;">
                        <h6 style="font-size: 14px; font-weight: 700; color: #1E293B; margin-bottom: 16px;"><i class="fa-solid fa-chart-bar me-2" style="color: var(--primary);"></i>Grade Distribution</h6>
                        <canvas id="gradeChart" height="80"></canvas>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card" style="border-radius: 12px; border: 1px solid #E2E8F0; padding: 20px;">
                        <h6 style="font-size: 14px; font-weight: 700; color: #1E293B; margin-bottom: 16px;"><i class="fa-solid fa-circle-half-stroke me-2" style="color: #10B981;"></i>Pass / Fail</h6>
                        <canvas id="passfailChart" height="160"></canvas>
                        <div style="text-align: center; margin-top: 12px; font-size: 12px; color: #64748B;">
                            <span style="color: #10B981; font-weight: 700;"><%= stats.passed %> Passed</span> &middot;
                            <span style="color: #EF4444; font-weight: 700;"><%= stats.failed %> Failed</span>
                        </div>
                    </div>
                </div>
            </div>
            <% if (toppers.length > 0) { %>
            <div class="card mb-4" style="border-radius: 12px; border: 1px solid #E2E8F0; overflow: hidden;">
                <div style="padding: 16px 20px; border-bottom: 1px solid #E2E8F0; background: linear-gradient(135deg, #FFF7ED, #FFFBEB);">
                    <h6 style="font-size: 14px; font-weight: 700; color: #1E293B; margin: 0;"><i class="fa-solid fa-trophy me-2" style="color: #F59E0B;"></i>Top Performers</h6>
                </div>
                <div style="padding: 16px 20px; display: flex; gap: 12px; flex-wrap: wrap;">
                    <% toppers.forEach((t, i) => { %>
                        <% if (i === 0) { %>
                            <div style="background: linear-gradient(135deg, #FFF7ED, #FEF3C7); border: 1px solid #FCD34D; border-radius: 10px; padding: 14px 18px; text-align: center; min-width: 120px; flex: 1;">
                                <div style="font-size: 20px; margin-bottom: 4px;">🥇</div>
                                <div style="font-size: 13px; font-weight: 700; color: #1E293B;"><%= t.first_name %> <%= t.last_name %></div>
                                <div style="font-size: 20px; font-weight: 800; color: #D97706; margin: 4px 0;"><%= t.obtained_marks %></div>
                                <div style="font-size: 11px; color: #94A3B8;"><%= t.percentage %>% • <%= t.grade %></div>
                            </div>
                        <% } else { %>
                            <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 14px 18px; text-align: center; min-width: 120px; flex: 1;">
                                <div style="font-size: 20px; margin-bottom: 4px;"><%= i === 1 ? '🥈' : i === 2 ? '🥉' : `#${t.rank}` %></div>
                                <div style="font-size: 13px; font-weight: 700; color: #1E293B;"><%= t.first_name %> <%= t.last_name %></div>
                                <div style="font-size: 20px; font-weight: 800; color: var(--primary); margin: 4px 0;"><%= t.obtained_marks %></div>
                                <div style="font-size: 11px; color: #94A3B8;"><%= t.percentage %>% • <%= t.grade %></div>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
            </div>
            <% } %>
            <div class="table-card mb-4">
                <div class="table-header-row">
                    <h6 class="table-heading"><i class="fa-solid fa-list me-2" style="color: var(--primary);"></i>All Students Results</h6>
                    <% if (exam.is_published) { %>
                        <span class="badge badge-success">
                            <i class="fa-solid fa-eye me-1"></i>Published
                        </span>
                    <% } else { %>
                        <span class="badge badge-warning">
                            <i class="fa-solid fa-eye-slash me-1"></i>Not Published
                        </span>
                    <% } %>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Roll No</th>
                                <th>Student Name</th>
                                <th style="text-align: center;">Marks</th>
                                <th style="text-align: center;">%</th>
                                <th style="text-align: center;">Grade</th>
                                <th style="text-align: center;">Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% results.forEach((r, i) => {
                                const pct = exam.max_marks > 0 ? ((parseFloat(r.obtained_marks) / exam.max_marks) * 100).toFixed(1) : 0;
                             %>
                            <tr<% if (r.status === 'fail') { %> style="background: #FFF5F5;"<% } %>>
                                <td style="font-weight: 700; color: #64748B;">#<%= i + 1 %></td>
                                <td style="color: #64748B;">#<%= r.roll_no || '—' %></td>
                                <td style="font-weight: 600; color: #1E293B;"><%= r.first_name %> <%= r.last_name %></td>
                                <td style="text-align: center; font-weight: 700; color: #1E293B;"><%= r.obtained_marks %><span style="font-size: 11px; color: #94A3B8; font-weight: 500;">/<%= exam.max_marks %></span></td>
                                <td style="text-align: center; color: #475569;"><%= pct %>%</td>
                                <td style="text-align: center;">
                                    <span class="badge <%= r.status === 'pass' ? 'badge-success' : 'badge-danger' %>">
                                        <%= r.grade || '—' %>
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge <%= r.status === 'pass' ? 'badge-success' : 'badge-danger' %>">
                                        <%= r.status === 'pass' ? '✓ Pass' : '✗ Fail' %>
                                    </span>
                                </td>
                                <td><%= r.remarks || '—' %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const gradeData = '<%- JSON.stringify(gradeDistrib || {}) %>';
    const gradeLabels = Object.keys(gradeData);
    const gradeValues = Object.values(gradeData);
    const gradeColors = { A1:'#059669', A2:'#10B981', B1:'#0EA5E9', B2:'#34D399', C1:'#F59E0B', C2:'#FBBF24', D:'#94A3B8', E:'#EF4444' };

    new Chart(document.getElementById('gradeChart'), {
        type: 'bar',
        data: {
            labels: gradeLabels,
            datasets: [{
                label: 'Students',
                data: gradeValues,
                backgroundColor: gradeLabels.map(g => gradeColors[g] || '#CBD5E1'),
                borderRadius: 6,
                borderSkipped: false
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    new Chart(document.getElementById('passfailChart'), {
        type: 'doughnut',
        data: {
            labels: ['Passed', 'Failed'],
            datasets: [{
                data: ['<%= stats.passed %>, <%= stats.failed %>'],
                backgroundColor: ['#10B981', '#EF4444'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            cutout: '65%',
            plugins: { legend: { display: false } }
        }
    });
</script>