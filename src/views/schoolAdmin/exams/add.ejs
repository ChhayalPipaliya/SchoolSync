<%- include('../../partials/head', { title: `${lan.Add_New_Exam || 'Add New Exam' } | SchoolSync` }) %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { active: 'exams' , user: user }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content">
                        <div style="max-width: 800px; margin: 0 auto;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h2 style="font-size: 22px; font-weight: 700; color: #1E293B; margin: 0;"><%-
                                            lan.Add_New_Exam || 'Add New Exam' %></h2>
                                    <div style="font-size: 12px; color: #94A3B8;"><%- lan.Schedule_Configure_Exams_Desc
                                            || 'Schedule and configure examinations for a class' %></div>
                                </div>
                                <a href="/schooladmin/exams" class="btn btn-secondary"><i
                                        class="fas fa-arrow-left mr-1"></i> <%- lan.Back_To_Exams || 'Back to Exams'
                                        %></a>
                            </div>
                            <%- include('../../partials/flashMessages') %>
                                <form method="POST" action="/schooladmin/exams/add" class="card p-4"
                                    style="border-radius: 12px; border: 1px solid #E2E8F0; background: #fff; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 20px;">
                                    <input type="hidden" name="_csrf"
                                        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <div>
                                        <h3
                                            style="font-size: 16px; font-weight: 700; color: var(--primary); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #E2E8F0;">
                                            <i class="fa-solid fa-circle-info me-2"></i><%- lan.Exam_Information
                                                || 'Exam Information' %>
                                        </h3>
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label class="form-label form-label-required"><%- lan.Exam_Name
                                                        || 'Exam Name' %></label>
                                                <input type="text" name="name" required class="form-input"
                                                    placeholder="e.g., First Unit Test, Mid Term Exam, Final Exam">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label form-label-required"><%- lan.Exam_Type
                                                        || 'Exam Type' %></label>
                                                <select name="exam_type" required class="form-select">
                                                    <option value=""><%- lan.Select_Type || 'Select Type' %></option>
                                                    <option value="unit_test"><%- lan.Unit_Test || 'Unit Test' %>
                                                    </option>
                                                    <option value="mid_term"><%- lan.Mid_Term || 'Mid Term' %></option>
                                                    <option value="final"><%- lan.Final_Exam || 'Final Exam' %></option>
                                                    <option value="quiz"><%- lan.Quiz || 'Quiz' %></option>
                                                    <option value="oral"><%- lan.Oral_Test || 'Oral Test' %></option>
                                                    <option value="practical"><%- lan.Practical || 'Practical' %>
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label form-label-required"><%- lan.Term || 'Term'
                                                        %></label>
                                                <select name="term" required class="form-select">
                                                    <option value=""><%- lan.Select_Term || 'Select Term' %></option>
                                                    <option value="first_term"><%- lan.First_Term || 'First Term' %>
                                                    </option>
                                                    <option value="mid_term"><%- lan.Mid_Term || 'Mid Term' %></option>
                                                    <option value="final_term"><%- lan.Final_Term || 'Final Term' %>
                                                    </option>
                                                    <option value="annual"><%- lan.Annual || 'Annual' %></option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <h3
                                            style="font-size: 16px; font-weight: 700; color: var(--primary); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #E2E8F0;">
                                            <i class="fa-solid fa-graduation-cap me-2"></i><%- lan.Class_Details
                                                || 'Class Details' %>
                                        </h3>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label form-label-required"><%- lan.Class || 'Class'
                                                        %></label>
                                                <select name="class_id" id="classSelect" required class="form-select">
                                                    <option value=""><%- lan.Select_Class || 'Select Class' %></option>
                                                    <% classes.forEach(c=> { %>
                                                        <option value="<%= c.id %>">
                                                            <%= c.label || (c.class_name + (c.stream && c.stream
                                                                !=='General' ? ' — ' + c.stream : '' ) + ' — Section ' +
                                                                c.section) %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label"><%- lan.Subject || 'Subject' %></label>
                                                <select name="subject_id" class="form-select">
                                                    <option value=""><%- lan.All_General_Subject
                                                            || '-- All / General Subject --' %></option>
                                                    <% if (typeof subjects !=='undefined' && subjects) {
                                                        subjects.forEach(s=> { %>
                                                        <option value="<%= s.id %>">
                                                            <%= s.subject_name %>
                                                                <%= s.code ? `(${s.code})` : '' %>
                                                        </option>
                                                        <% }) } %>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <h3
                                            style="font-size: 16px; font-weight: 700; color: var(--primary); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #E2E8F0;">
                                            <i class="fa-solid fa-calendar-days me-2"></i><%- lan.Schedule_And_Marks
                                                || 'Schedule & Marks' %>
                                        </h3>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label form-label-required"><%- lan.Start_Date
                                                        || 'Start Date' %></label>
                                                <input type="date" name="start_date" required class="form-input">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label"><%- lan.End_Date || 'End Date' %></label>
                                                <input type="date" name="end_date" class="form-input">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label form-label-required"><%- lan.Maximum_Marks
                                                        || 'Maximum Marks' %></label>
                                                <input type="number" name="max_marks" value="100" required min="1"
                                                    class="form-input">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label form-label-required"><%- lan.Passing_Marks
                                                        || 'Passing Marks' %></label>
                                                <input type="number" name="pass_marks" value="33" required min="1"
                                                    class="form-input">
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label form-label-required"><%- lan.Academic_Year
                                                        || 'Academic Year' %></label>
                                                <input type="text" name="academic_year" value="2025-26" maxlength="10"
                                                    required class="form-input">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 pt-4"
                                        style="border-top: 1px solid #E2E8F0; margin-top: 10px;">
                                        <button type="submit" class="btn btn-primary"><i
                                                class="fas fa-save mr-2"></i><%- lan.Create_Exam || 'Create Exam'
                                                %></button>
                                        <a href="/schooladmin/exams" class="btn btn-secondary"><%- lan.Cancel
                                                || 'Cancel' %></a>
                                    </div>
                                </form>
                        </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>