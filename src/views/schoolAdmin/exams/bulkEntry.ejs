<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { active: 'exams', user: user }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 style="font-size: 22px; font-weight: 700; color: #1E293B; margin: 0;">Bulk Marks Entry</h2>
                    <div style="font-size: 12px; color: #94A3B8; margin-top: 4px;">
                        <%= exam.name %> &rarr; Class <%= exam.class_name %> (<%= exam.section %>) &rarr; Max Marks: <%= exam.max_marks %>
                    </div>
                </div>
                <a href="/schooladmin/exams/<%= exam.id %>/marks" class="btn btn-light" style="border-radius: 8px; font-size: 13px; font-weight: 600; border: 1px solid #E2E8F0; background: #fff;">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Marks
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="row g-4 mt-2">
                <div class="col-md-6">
                    <div class="card p-4" style="border-radius: 12px; border: 1px solid #E2E8F0; background: #fff; box-shadow: var(--shadow-sm);">
                        <div style="font-size: 14px; font-weight: 600; color: var(--primary); margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid #E2E8F0;">
                            <i class="fa-solid fa-file-import me-2"></i>Import Marks (CSV Data)
                        </div>

                        <div class="p-3 mb-4 rounded" style="background: #F8FAFC; border: 1px solid #F1F5F9; font-size: 12px; color: #475569; line-height: 1.6;">
                            <span class="font-bold text-gray-800 d-block mb-1">CSV Format Specification:</span>
                            Enter one student record per line in the format:<br>
                            <code class="bg-gray-200 px-1.5 py-0.5 rounded font-mono font-bold" style="font-size: 11px; color: var(--primary);">[roll_number], [marks_obtained], [remark]</code>
                            <br><br>
                            <span class="font-bold text-gray-800 d-block mb-1">Example:</span>
                            <pre class="bg-gray-100 p-2 rounded font-mono text-gray-700 mt-1" style="font-size: 10px; margin: 0;">1, 85.5, Excellent performance 2, 60, Average 3, 31, Needs Improvement</pre>
                        </div>
                        <form method="POST" action="/schooladmin/exams/bulk-entry">
                            <input type="hidden" name="exam_id" value="<%= exam.id %>">
                            <div class="mb-4">
                                <label style="font-size: 13px; font-weight: 600; color: #374151;">Paste CSV Data Here *</label>
                                <textarea name="csv_data" required rows="10" class="form-input font-mono mt-1" placeholder="e.g.&#13;&#10;1, 95.0, Outsdanding&#13;&#10;2, 78.5, Very Good" style="border-radius: 8px; font-size: 13px; padding: 10px 12px; border: 1px solid #D1D5DB; width: 100%; height: 220px; line-height: 1.5;"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload & Process Marks
                            </button>
                        </form>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="table-card" style="height: 100%;">
                        <div class="table-header-row">
                            <h5 class="table-heading">Roll Number Directory Guide</h5>
                        </div>
                        <div class="table-container" style="max-height: 440px; overflow-y: auto;">
                            <table class="data-table">
                                <thead style="position: sticky; top: 0; z-index: 5;">
                                    <tr>
                                        <th style="width: 120px;">Roll No</th>
                                        <th>Student Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (students.length > 0) { %>
                                        <% students.forEach(s => { %>
                                            <tr>
                                                <td style="font-weight: 700; color: #64748B;">
                                                    <%= s.roll_no %>
                                                </td>
                                                <td style="font-weight: 600; color: #1E293B;">
                                                    <%= s.first_name %> <%= s.last_name %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="2" class="text-center py-5">
                                                <span style="color: #94A3B8; font-size: 13px;">No enrolled students in this class.</span>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>