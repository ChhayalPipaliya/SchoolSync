<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">

            <!-- Page Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Meeting Details</h2>
                    <p class="text-xs text-gray-500 mt-1">Review meeting details, status, and join options.</p>
                </div>
                <div class="flex gap-2">
                    <a href="/schooladmin/meetings" class="btn btn-secondary btn-sm">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Back to List
                    </a>
                </div>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Details Card -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="card p-6 lg:col-span-2 space-y-6">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <%
                                let badgeClass = 'bg-slate-100 text-slate-700';
                                if (meeting.status === 'scheduled') badgeClass = 'bg-blue-50 text-blue-700 border-blue-200';
                                if (meeting.status === 'live') badgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-200 animate-pulse';
                                if (meeting.status === 'completed') badgeClass = 'bg-slate-100 text-slate-500';
                                if (meeting.status === 'cancelled') badgeClass = 'bg-rose-50 text-rose-700 border-rose-200';
                            %>
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold capitalize border <%= badgeClass %>">
                                <%= meeting.status %>
                            </span>
                        </div>
                        <h3 class="text-xl font-bold text-gray-800"><%= meeting.title %></h3>
                        <p class="text-xs text-gray-400 mt-1">Scheduled by <strong><%= creatorName %></strong></p>
                    </div>

                    <% if (meeting.description) { %>
                        <div>
                            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Description / Agenda</h4>
                            <div class="p-4 bg-slate-50 border border-slate-100 rounded-xl text-sm text-gray-700 leading-relaxed">
                                <%= meeting.description %>
                            </div>
                        </div>
                    <% } %>

                    <% if (meeting.status === 'cancelled') { %>
                        <div class="p-4 bg-rose-50 border border-rose-100 rounded-xl text-sm text-rose-800">
                            <h4 class="font-bold mb-1"><i class="fa-solid fa-circle-xmark mr-1"></i> Cancelled</h4>
                            <p>Reason: <%= meeting.cancel_reason %></p>
                            <p class="text-xs text-rose-600 mt-1">Cancelled on <%= new Date(meeting.cancelled_at).toLocaleString('en-IN') %></p>
                        </div>
                    <% } %>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="flex gap-3 items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                            <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-lg"><i class="fa-regular fa-calendar"></i></div>
                            <div>
                                <div class="text-[10px] text-gray-400 font-bold uppercase">Scheduled Time</div>
                                <div class="text-xs font-extrabold text-gray-700">
                                    <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                </div>
                            </div>
                        </div>

                        <div class="flex gap-3 items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                            <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center text-lg"><i class="fa-regular fa-clock"></i></div>
                            <div>
                                <div class="text-[10px] text-gray-400 font-bold uppercase">Duration</div>
                                <div class="text-xs font-extrabold text-gray-700"><%= meeting.duration_minutes %> Minutes</div>
                            </div>
                        </div>

                        <div class="flex gap-3 items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                            <div class="w-10 h-10 rounded-lg bg-cyan-100 text-cyan-600 flex items-center justify-center text-lg"><i class="fa-solid fa-user-group"></i></div>
                            <div>
                                <div class="text-[10px] text-gray-400 font-bold uppercase">Target Audience</div>
                                <div class="text-xs font-extrabold text-gray-700 capitalize"><%= targetDisplay %></div>
                            </div>
                        </div>

                        <div class="flex gap-3 items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                            <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-lg"><i class="fa-solid fa-hashtag"></i></div>
                            <div>
                                <div class="text-[10px] text-gray-400 font-bold uppercase">Jitsi Room ID</div>
                                <div class="text-xs font-mono font-extrabold text-gray-700"><%= meeting.room_name %></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Join / Actions Column -->
                <div class="space-y-6">
                    <!-- Join Section -->
                    <div class="card p-6 flex flex-col items-center justify-center text-center">
                        <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mb-4 text-gray-400 text-2xl">
                            <i class="fa-solid fa-video"></i>
                        </div>
                        <h4 class="text-sm font-bold text-gray-800 mb-1">Enter Jitsi Room</h4>
                        
                        <%
                            const startMs = new Date(meeting.scheduled_at).getTime();
                            const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                            const now = Date.now();
                            const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
                        %>

                        <% if (canJoin) { %>
                            <p class="text-xs text-gray-500 mb-4">The meeting room is currently open. Click join below.</p>
                            <a href="/schooladmin/meetings/<%= meeting.id %>/join" class="btn btn-success w-full py-2.5">
                                <i class="fa-solid fa-video mr-1"></i> Join Meeting
                            </a>
                        <% } else if (meeting.status === 'cancelled') { %>
                            <p class="text-xs text-rose-500 font-semibold mb-4">This meeting has been cancelled.</p>
                            <button class="btn btn-secondary w-full opacity-50 cursor-not-allowed" disabled>Join Unavailable</button>
                        <% } else if (meeting.status === 'completed') { %>
                            <p class="text-xs text-gray-400 mb-4">This meeting has already completed.</p>
                            <button class="btn btn-secondary w-full opacity-50 cursor-not-allowed" disabled>Meeting Completed</button>
                        <% } else { %>
                            <p class="text-xs text-gray-500 mb-4">Join window opens 15 minutes before the scheduled start time.</p>
                            <button class="btn btn-secondary w-full opacity-50 cursor-not-allowed" disabled>Join Not Open</button>
                        <% } %>
                    </div>

                    <!-- Management Actions Section -->
                    <div class="card p-6 space-y-3">
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Meeting Actions</h4>
                        
                        <a href="/schooladmin/meetings/<%= meeting.id %>/attendance-report" class="btn btn-secondary w-full justify-center">
                            <i class="fa-solid fa-chart-simple mr-1"></i> View Attendance Report
                        </a>
                        <a href="/schooladmin/meetings/<%= meeting.id %>/attendance-report/pdf"
                           class="btn btn-outline text-xs flex items-center gap-1 justify-center"
                           title="Export PDF">
                          <i class="fas fa-file-pdf text-red-400"></i> Export PDF
                        </a>

                        <% if (meeting.status === 'scheduled') { %>
                            <a href="/schooladmin/meetings/<%= meeting.id %>/edit" class="btn btn-secondary w-full justify-center">
                                <i class="fa-solid fa-pen mr-1"></i> Edit Meeting
                            </a>
                            <button onclick="openCancelModal(<%= meeting.id %>, '<%= meeting.title %>')" class="btn btn-danger w-full justify-center">
                                <i class="fa-solid fa-ban mr-1"></i> Cancel Meeting
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Meeting Notes -->
            <div class="card p-6 mt-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-gray-800 text-sm">Meeting Notes / Minutes</h3>
                <span id="notesSaveStatus" class="text-xs text-gray-400 hidden">Saving...</span>
              </div>

              <% if (user.role === 'school_admin') { %>
                <textarea id="meetingNotes"
                          class="form-textarea w-full text-sm"
                          rows="6"
                          maxlength="5000"
                          placeholder="Add meeting notes, decisions, action items..."
                ><%= meeting.notes || '' %></textarea>
                <div class="flex items-center justify-between mt-3">
                  <span id="notesCharCount" class="text-[10px] text-gray-400">
                    <%= (meeting.notes || '').length %>/5000
                  </span>
                  <button onclick="saveNotes()"
                          class="btn btn-primary text-xs">
                    <i class="fas fa-save mr-1"></i> Save Notes
                  </button>
                </div>
              <% } else { %>
                <% if (meeting.notes) { %>
                  <p class="text-sm text-gray-600 whitespace-pre-wrap leading-relaxed">
                    <%= meeting.notes %>
                  </p>
                <% } else { %>
                  <p class="text-xs text-gray-400">No notes added yet.</p>
                <% } %>
              <% } %>
            </div>

            <!-- Recording -->
            <div class="card p-6 mt-4">
              <h3 class="font-bold text-gray-800 text-sm mb-4">Recording</h3>

              <% if (meeting.recording_url) { %>
                <a href="<%= meeting.recording_url %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-secondary text-xs inline-flex items-center gap-2 mb-4">
                  <i class="fas fa-play-circle"></i> Watch Recording
                </a>
              <% } else { %>
                <p class="text-xs text-gray-400 mb-3">No recording link added yet.</p>
              <% } %>

              <% if (user.role === 'school_admin') { %>
                <div class="flex gap-2 mt-2">
                  <input type="url"
                         id="recordingUrl"
                         class="form-input flex-1 text-xs"
                         placeholder="https://..."
                         value="<%= meeting.recording_url || '' %>">
                  <button onclick="saveRecording()"
                          class="btn btn-outline text-xs whitespace-nowrap">
                    <i class="fas fa-link mr-1"></i> Save Link
                  </button>
                </div>
                <span id="recordingSaveStatus" class="text-xs text-gray-400 mt-1 hidden">Saving...</span>
              <% } %>
            </div>

        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>

<!-- Cancel Meeting Modal -->
<div id="cancelModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md mx-4">
        <h3 class="text-base font-bold text-gray-800 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation text-rose-500"></i> Cancel Meeting
        </h3>
        <p class="text-xs text-gray-500 mb-4">Are you sure you want to cancel the meeting <strong id="cancelMeetingTitle"></strong>? This will notify all invited participants.</p>
        <form id="cancelForm" method="POST" action="" class="space-y-4">
            <div class="form-group">
                <label class="form-label">Reason for Cancellation *</label>
                <textarea name="cancel_reason" required class="form-input" rows="3" placeholder="e.g. Schedule conflict..."></textarea>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="submit" class="btn btn-danger flex-1">Yes, Cancel Meeting</button>
                <button type="button" onclick="closeCancelModal()" class="btn btn-secondary flex-1">Close</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openCancelModal(id, title) {
        document.getElementById('cancelMeetingTitle').textContent = title;
        document.getElementById('cancelForm').action = '/schooladmin/meetings/' + id + '/cancel';
        document.getElementById('cancelModal').classList.remove('hidden');
    }
    
    function closeCancelModal() {
        document.getElementById('cancelModal').classList.add('hidden');
    }

    document.getElementById('cancelModal').addEventListener('click', function(e) {
        if (e.target === this) closeCancelModal();
    });
</script>

<script>
const MEETING_ID = <%= meeting.id %>;

// Notes char counter
const notesArea = document.getElementById('meetingNotes');
const charCount = document.getElementById('notesCharCount');
if (notesArea && charCount) {
  notesArea.addEventListener('input', () => {
    charCount.textContent = notesArea.value.length + '/5000';
  });
}

async function saveNotes() {
  const notes = document.getElementById('meetingNotes')?.value || '';
  const status = document.getElementById('notesSaveStatus');
  if (!status) return;

  status.textContent = 'Saving...';
  status.classList.remove('hidden', 'text-emerald-600', 'text-red-500');
  status.classList.add('text-gray-400');

  try {
    const res = await fetch(`/schooladmin/meetings/${MEETING_ID}/notes`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ notes })
    });
    const data = await res.json();
    status.classList.remove('hidden', 'text-gray-400');
    if (data.success) {
      status.textContent = '✓ Saved';
      status.classList.add('text-emerald-600');
    } else {
      status.textContent = '✗ ' + (data.message || 'Failed');
      status.classList.add('text-red-500');
    }
  } catch {
    status.textContent = '✗ Request failed';
    status.classList.remove('hidden', 'text-gray-400');
    status.classList.add('text-red-500');
  }

  setTimeout(() => status.classList.add('hidden'), 3000);
}

async function saveRecording() {
  const url = document.getElementById('recordingUrl')?.value?.trim() || '';
  const status = document.getElementById('recordingSaveStatus');

  if (url && !url.startsWith('http://') && !url.startsWith('https://')) {
    alert('URL must start with http:// or https://');
    return;
  }

  if (status) {
    status.textContent = 'Saving...';
    status.classList.remove('hidden');
  }

  try {
    const res = await fetch(`/schooladmin/meetings/${MEETING_ID}/recording`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ recording_url: url })
    });
    const data = await res.json();
    if (data.success) {
      if (status) {
        status.textContent = '✓ Saved';
        status.classList.add('text-emerald-600');
      }
      // Reload page to show Watch Recording button
      setTimeout(() => location.reload(), 800);
    } else {
      if (status) {
        status.textContent = '✗ ' + (data.message || 'Failed');
        status.classList.add('text-red-500');
      }
    }
  } catch {
    if (status) {
      status.textContent = '✗ Request failed';
      status.classList.add('text-red-500');
    }
  }
}
</script>
