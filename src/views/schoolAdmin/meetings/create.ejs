<div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                <i class="fa-solid fa-video"></i>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Schedule_Video_Meeting || 'Schedule Video Meeting' %></h1>
                <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Schedule_Video_Meeting_Desc || 'Fill in the fields below to schedule a meeting using Jitsi Meet.' %></p>
            </div>
        </div>
        <div>
            <a href="/schooladmin/meetings" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                <i class="fas fa-arrow-left"></i> <%- lan.Back_To_Meetings || 'Back to Meetings' %>
            </a>
        </div>
    </div>
</div>
<div class="card p-4 sm:p-6">
        <form method="POST" action="/schooladmin/meetings" class="space-y-6" id="meetingForm">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="form-group sm:col-span-2">
                    <label class="form-label font-bold text-gray-700"><%- lan.Meeting_Title || 'Meeting Title' %> *</label>
                    <input type="text" name="title" required maxlength="255" class="form-input" placeholder="<%- lan.Meeting_Title_Placeholder || 'e.g. Science Class - Chapter 4 Discussion' %>">
                </div>
                <div class="form-group sm:col-span-2">
                    <label class="form-label font-bold text-gray-700"><%- lan.Description || 'Description' %></label>
                    <textarea name="description" class="form-input" rows="3" maxlength="2000" placeholder="<%- lan.Meeting_Description_Placeholder || 'Provide any additional details or agenda...' %>"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label font-bold text-gray-700"><%- lan.Scheduled_At || 'Scheduled At' %> *</label>
                    <input type="datetime-local" name="scheduled_at" required class="form-input">
                </div>
                <div class="form-group">
                    <label class="form-label font-bold text-gray-700"><%- lan.Duration_Minutes || 'Duration (Minutes)' %> *</label>
                    <input type="number" name="duration_minutes" required class="form-input" min="5" max="300" value="45">
                </div>
                <div class="form-group sm:col-span-2">
                    <label class="form-label font-bold text-gray-700"><%- lan.Target_Audience || 'Target Audience' %> *</label>
                    <select name="target_type" id="targetType" required class="form-select" onchange="toggleTargetDetails()">
                        <option value="" disabled selected><%- lan.Select_Audience || '-- Select Audience --' %></option>
                        <option value="all"><%- lan.All_Users || 'All Users' %></option>
                        <option value="teachers"><%- lan.Teachers_Only || 'Teachers Only' %></option>
                        <option value="students"><%- lan.Students_Only || 'Students Only' %></option>
                        <option value="parents"><%- lan.Parents_Only || 'Parents Only' %></option>
                        <option value="staff"><%- lan.Staff_Only || 'Staff Only (Teachers, Drivers, Librarians)' %></option>
                        <option value="drivers"><%- lan.Drivers_Only || 'Drivers Only' %></option>
                        <option value="librarians"><%- lan.Librarians_Only || 'Librarians Only' %></option>
                        <option value="specific_class"><%- lan.Specific_Class || 'Specific Class' %></option>
                        <option value="multiple_classes"><%- lan.Multiple_Classes || 'Multiple Classes' %></option>
                    </select>
                </div>
                <div class="form-group sm:col-span-2 hidden" id="specificClassDiv">
                    <label class="form-label font-bold text-gray-700"><%- lan.Select_Class || 'Select Class' %> *</label>
                    <select name="target_class_id" id="targetClassId" class="form-select">
                        <option value="" disabled selected><%- lan.Select_A_Class || '-- Select a Class --' %></option>
                        <% (classes||[]).forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.display_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group sm:col-span-2 hidden" id="multipleClassesDiv">
                    <label class="form-label font-bold text-gray-700 mb-2"><%- lan.Select_Classes || 'Select Classes' %> *</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 sm:gap-3 p-4 bg-slate-50 border border-slate-200 rounded-xl">
                        <% (classes||[]).forEach(c => { %>
                            <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700">
                                <input type="checkbox" name="class_ids" value="<%= c.id %>" class="w-4 h-4 rounded text-primary border-gray-300">
                                <%= c.display_name %>
                            </label>
                        <% }) %>
                    </div>
                    <p class="text-xs text-rose-600 mt-2 hidden" id="classSelectionError"><%- lan.Select_At_Least_One_Class || 'Select at least one class.' %></p>
                </div>
            </div>
            <div class="flex gap-3 sm:gap-4 pt-4 border-t border-slate-100">
                <button type="submit" class="btn btn-primary flex-1 inline-flex items-center justify-center">
                    <i class="fa-solid fa-calendar-check mr-1"></i> <%- lan.Schedule_Meeting || 'Schedule Meeting' %>
                </button>
                <a href="/schooladmin/meetings" class="btn btn-secondary flex-1 text-center inline-flex items-center justify-center"><%- lan.Cancel || 'Cancel' %></a>
            </div>
        </form>
    </div>
<script>
    function toggleTargetDetails() {
        const targetType = document.getElementById('targetType').value;
        const specClassDiv = document.getElementById('specificClassDiv');
        const multiClassDiv = document.getElementById('multipleClassesDiv');
        const targetClassSelect = document.getElementById('targetClassId');

        specClassDiv.classList.add('hidden');
        multiClassDiv.classList.add('hidden');
        targetClassSelect.required = false;

        if (targetType === 'specific_class') {
            specClassDiv.classList.remove('hidden');
            targetClassSelect.required = true;
        } else if (targetType === 'multiple_classes') {
            multiClassDiv.classList.remove('hidden');
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        toggleTargetDetails();
        
        const datetimeInput = document.querySelector('input[type="datetime-local"]');
        if (datetimeInput) {
            const now = new Date();
            const localNow = new Date(now.getTime());
            localNow.setMinutes(localNow.getMinutes() - localNow.getTimezoneOffset());
            datetimeInput.min = localNow.toISOString().slice(0, 16);
            const defaultStart = new Date(localNow.getTime());
            defaultStart.setMinutes(defaultStart.getMinutes() + 30);
            datetimeInput.value = defaultStart.toISOString().slice(0, 16);
        }

        const form = document.getElementById('meetingForm');
        const classError = document.getElementById('classSelectionError');
        if (form) {
            form.addEventListener('submit', (event) => {
                const targetType = document.getElementById('targetType').value;
                const checkedClasses = document.querySelectorAll('input[name="class_ids"]:checked');
                if (targetType === 'multiple_classes' && checkedClasses.length === 0) {
                    event.preventDefault();
                    if (classError) classError.classList.remove('hidden');
                }
            });
        }
    });
</script>