<style>
    .meeting-stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 10px;
        margin-bottom: 16px;
    }
    @media (min-width: 768px) {
        .meeting-stats-grid {
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 16px;
        }
    }
    @media (max-width: 640px) {
        .meeting-header-btn {
            width: 100% !important;
            justify-content: center !important;
        }
    }
</style>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Video_Meetings || 'Video Meetings' %></h2>
        <p class="text-xs text-gray-500 mt-1"><%- lan.Video_Meetings_Desc || 'Schedule, manage, and monitor virtual classrooms and staff meetings' %></p>
    </div>
    <div>
        <a href="/schooladmin/meetings/create" class="btn btn-primary meeting-header-btn">
            <i class="fa-solid fa-plus mr-1"></i> <%- lan.Schedule_Meeting || 'Schedule Meeting' %>
        </a>
    </div>
</div>
<div class="meeting-stats-grid" id="meetingStatsBar">
  <div class="card p-4">
    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider"><%- lan.Scheduled || 'Scheduled' %></p>
    <p id="statScheduled" class="text-xl font-bold mt-1 text-blue-600">—</p>
    <p class="text-[10px] text-gray-400 mt-0.5"><%- lan.This_Month || 'This month' %></p>
  </div>
  <div class="card p-4">
    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider"><%- lan.Live_Now || 'Live Now' %></p>
    <p id="statLive" class="text-xl font-bold mt-1 text-green-600">—</p>
    <p class="text-[10px] text-gray-400 mt-0.5"><%- lan.Currently_Active || 'Currently active' %></p>
  </div>
  <div class="card p-4">
    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider"><%- lan.Completed || 'Completed' %></p>
    <p id="statCompleted" class="text-xl font-bold mt-1" style="color: var(--primary);">—</p>
    <p class="text-[10px] text-gray-400 mt-0.5"><%- lan.This_Month || 'This month' %></p>
  </div>
  <div class="card p-4">
    <p class="text-xs text-gray-400 font-bold uppercase tracking-wider"><%- lan.Cancelled || 'Cancelled' %></p>
    <p id="statCancelled" class="text-xl font-bold mt-1 text-red-400">—</p>
    <p class="text-[10px] text-gray-400 mt-0.5"><%- lan.This_Month || 'This month' %></p>
  </div>
</div>
<div class="card p-4 mb-6">
    <form method="GET" action="/schooladmin/meetings" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
            <label class="form-label text-xs"><%- lan.Search_Meeting_Title || 'Search Meeting Title' %></label>
            <input type="text" name="search" class="form-input" placeholder="<%- lan.Search_Meeting_Placeholder || 'e.g. Science Class...' %>" value="<%= filters.search %>">
        </div>
        <div>
            <label class="form-label text-xs"><%- lan.Filter_Status || 'Filter Status' %></label>
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>><%- lan.All_Statuses || 'All Statuses' %></option>
                <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>><%- lan.Scheduled || 'Scheduled' %></option>
                <option value="live" <%= filters.status === 'live' ? 'selected' : '' %>><%- lan.Live_Now || 'Live' %></option>
                <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>><%- lan.Completed || 'Completed' %></option>
                <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>><%- lan.Cancelled || 'Cancelled' %></option>
            </select>
        </div>
        <div class="flex items-end gap-2">
            <button type="submit" class="btn btn-secondary flex-1">
                <i class="fa-solid fa-filter mr-1"></i> <%- lan.Filter || 'Filter' %>
            </button>
            <% if (filters.search || filters.status !== 'all') { %>
                <a href="/schooladmin/meetings" class="btn btn-light" style="padding: 10px 15px;"><i class="fa-solid fa-xmark"></i></a>
            <% } %>
        </div>
    </form>
</div>
<% if (!meetings || meetings.length === 0) { %>
    <div class="card text-center py-16">
        <div class="empty-state">
            <div class="empty-state-icon" style="color: var(--primary);"><i class="fa-solid fa-video-slash"></i></div>
            <h3 class="empty-state-title"><%- lan.No_Meetings_Found || 'No meetings found' %></h3>
            <p class="empty-state-text"><%- lan.Schedule_First_Meeting_Desc || 'Schedule your first Jitsi meeting to get started.' %></p>
            <a href="/schooladmin/meetings/create" class="btn btn-primary btn-sm mt-4">
                <i class="fa-solid fa-plus mr-1"></i> <%- lan.Schedule_Meeting || 'Schedule Meeting' %>
            </a>
        </div>
    </div>
<% } else { %>
    <div class="card p-0 overflow-hidden">
        <div class="table-responsive" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
            <table class="table min-w-full divide-y divide-slate-100" style="min-width: 820px;">
                <thead>
                    <tr class="bg-slate-50">
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase whitespace-nowrap"><%- lan.Meeting_Info || 'Meeting Info' %></th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase whitespace-nowrap"><%- lan.Room_Name || 'Room Name' %></th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase whitespace-nowrap"><%- lan.Target_Audience || 'Target Audience' %></th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase whitespace-nowrap"><%- lan.Status || 'Status' %></th>
                        <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase whitespace-nowrap"><%- lan.Actions || 'Actions' %></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-100">
                    <% meetings.forEach(meeting => { %>
                        <%
                            let statusClass = 'bg-slate-100 text-slate-700';
                            if (meeting.status === 'scheduled') statusClass = 'bg-blue-50 text-blue-700 border-blue-200';
                            if (meeting.status === 'live') statusClass = 'bg-emerald-50 text-emerald-700 border-emerald-200 animate-pulse';
                            if (meeting.status === 'completed') statusClass = 'bg-slate-100 text-slate-500';
                            if (meeting.status === 'cancelled') statusClass = 'bg-rose-50 text-rose-700 border-rose-200';

                            let statusText = meeting.status;
                            if (meeting.status === 'scheduled') statusText = lan.Scheduled || 'Scheduled';
                            else if (meeting.status === 'live') statusText = lan.Live_Now || 'Live';
                            else if (meeting.status === 'completed') statusText = lan.Completed || 'Completed';
                            else if (meeting.status === 'cancelled') statusText = lan.Cancelled || 'Cancelled';

                            const startMs = new Date(meeting.scheduled_at).getTime();
                            const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                            const now = Date.now();
                            const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
                            
                            let targetLabel = meeting.target_type.replace('_', ' ');
                            if (meeting.target_type === 'specific_class') {
                                targetLabel = `${lan.Class || 'Class'}: ${meeting.class_name || (lan.Not_Available || 'N/A')}`;
                            } else if (meeting.target_type === 'teachers') {
                                targetLabel = lan.Teachers_Only || 'Teachers Only';
                            } else if (meeting.target_type === 'students') {
                                targetLabel = lan.Students_Only || 'Students Only';
                            } else if (meeting.target_type === 'parents') {
                                targetLabel = lan.Parents_Only || 'Parents Only';
                            } else if (meeting.target_type === 'all') {
                                targetLabel = lan.All_Users || 'All Users';
                            }
                        %>
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4" style="min-width: 220px;">
                                <div class="font-bold text-gray-800 text-sm"><%= meeting.title %></div>
                                <div class="text-[11px] text-gray-400 mt-1 whitespace-nowrap">
                                    <i class="fa-regular fa-calendar-days mr-1"></i>
                                    <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                    · <i class="fa-regular fa-clock mr-1"></i><%= meeting.duration_minutes %> <%- lan.Mins || 'mins' %>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-xs font-mono text-gray-500 whitespace-nowrap">
                                <%= meeting.room_name %>
                            </td>
                            <td class="px-6 py-4 text-sm font-semibold capitalize text-gray-600 whitespace-nowrap">
                                <%= targetLabel %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold capitalize border <%= statusClass %>">
                                    <%= statusText %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right whitespace-nowrap">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/schooladmin/meetings/<%= meeting.id %>" class="btn btn-sm btn-light" title="<%- lan.Details || 'View Details' %>">
                                        <i class="fa-solid fa-eye"></i> <%- lan.Details || 'Details' %>
                                    </a>
                                    <% if (canJoin) { %>
                                        <a href="/schooladmin/meetings/<%= meeting.id %>/join" class="btn btn-sm btn-success" title="<%- lan.Join_Meeting || 'Join' %>">
                                            <i class="fa-solid fa-video mr-1"></i> <%- lan.Join || 'Join' %>
                                        </a>
                                    <% } else { %>
                                        <button class="btn btn-sm btn-secondary opacity-50 cursor-not-allowed" disabled title="<%- lan.Join_Window_15m_Notice || 'Join window opens 15 mins before start time' %>">
                                            <i class="fa-solid fa-video mr-1"></i> <%- lan.Join || 'Join' %>
                                        </button>
                                    <% } %>
                                     <a href="/schooladmin/meetings/<%= meeting.id %>/attendance-report" class="btn btn-sm btn-secondary" title="<%- lan.View_Attendance_Report || 'View Attendance Report' %>">
                                         <i class="fa-solid fa-chart-simple"></i> <%- lan.Report || 'Report' %>
                                     </a>
                                     <% if (meeting.status === 'completed' || meeting.status === 'live') { %>
                                       <a href="/schooladmin/meetings/<%= meeting.id %>/attendance-report/pdf"
                                          class="btn-icon text-gray-400 hover:text-red-500 transition"
                                          title="<%- lan.Export_Attendance_PDF || 'Export Attendance PDF' %>"
                                          style="padding: 4px 8px; font-size: 12px;">
                                         <i class="fas fa-file-pdf"></i>
                                       </a>
                                     <% } %>
                                     <% if (meeting.status === 'scheduled') { %>
                                        <a href="/schooladmin/meetings/<%= meeting.id %>/edit" class="btn-icon btn-edit-icon" title="<%- lan.Edit || 'Edit' %>">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <button data-meeting-id="<%= meeting.id %>" data-meeting-title="<%= meeting.title %>" onclick="openCancelModal(this.dataset.meetingId, this.dataset.meetingTitle)" class="btn-icon btn-danger-icon" title="<%- lan.Cancel_Meeting || 'Cancel Meeting' %>">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>
<div id="cancelModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md mx-4">
        <h3 class="text-base font-bold text-gray-800 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation text-rose-500"></i> <%- lan.Cancel_Meeting || 'Cancel Meeting' %>
        </h3>
        <p class="text-xs text-gray-500 mb-4"><%- lan.Cancel_Meeting_Confirm_Msg || 'Are you sure you want to cancel the meeting' %> <strong id="cancelMeetingTitle"></strong>? <%- lan.Cancel_Meeting_Notify_Notice || 'This will notify all invited participants.' %></p>
        <form id="cancelForm" method="POST" action="" class="space-y-4">
            <div class="form-group">
                <label class="form-label"><%- lan.Reason_For_Cancellation || 'Reason for Cancellation' %> *</label>
                <textarea name="cancel_reason" required class="form-input" rows="3" placeholder="<%- lan.Cancel_Reason_Placeholder || 'e.g. Schedule conflict, technical issue...' %>"></textarea>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="submit" class="btn btn-danger flex-1"><%- lan.Yes_Cancel_Meeting || 'Yes, Cancel Meeting' %></button>
                <button type="button" onclick="closeCancelModal()" class="btn btn-secondary flex-1"><%- lan.Close || 'Close' %></button>
            </div>
        </form>
    </div>
</div>
<script>
    function openCancelModal(id, title) {
        document.getElementById('cancelMeetingTitle').textContent = title;
        document.getElementById('cancelForm').action = '/schooladmin/meetings/' + id + '/cancel';
        document.getElementById('cancelModal').classList.remove('hidden');
    }
    
    function closeCancelModal() {
        document.getElementById('cancelModal').classList.add('hidden');
    }

    document.getElementById('cancelModal').addEventListener('click', function(e) {
        if (e.target === this) closeCancelModal();
    });

    (async () => {
        try {
            const res = await fetch('/schooladmin/api/meetings/stats');
            const d = await res.json();
            if (!d.success) return;
            document.getElementById('statScheduled').textContent = d.stats.scheduled ?? 0;
            document.getElementById('statLive').textContent = d.stats.liveNow ?? 0;
            document.getElementById('statCompleted').textContent = d.stats.completed ?? 0;
            document.getElementById('statCancelled').textContent = d.stats.cancelled ?? 0;

            if ((d.stats.liveNow ?? 0) > 0) {
                document.getElementById('statLive').classList.add('animate-pulse');
            }
        } catch (e) {
            console.error('Meeting stats failed', e);
        }
    })();
</script>