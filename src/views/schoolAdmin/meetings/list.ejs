<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">

            <!-- Page Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Video Meetings</h2>
                    <p class="text-xs text-gray-500 mt-1">Schedule, manage, and monitor virtual classrooms and staff meetings</p>
                </div>
                <div>
                    <a href="/schooladmin/meetings/create" class="btn btn-primary">
                        <i class="fa-solid fa-plus mr-1"></i> Schedule Meeting
                    </a>
                </div>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Meeting Stats Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6" id="meetingStatsBar">
              <div class="card p-4">
                <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Scheduled</p>
                <p id="statScheduled" class="text-xl font-bold mt-1 text-blue-600">—</p>
                <p class="text-[10px] text-gray-400 mt-0.5">This month</p>
              </div>
              <div class="card p-4">
                <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Live Now</p>
                <p id="statLive" class="text-xl font-bold mt-1 text-green-600">—</p>
                <p class="text-[10px] text-gray-400 mt-0.5">Currently active</p>
              </div>
              <div class="card p-4">
                <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Completed</p>
                <p id="statCompleted" class="text-xl font-bold mt-1" style="color: var(--primary);">—</p>
                <p class="text-[10px] text-gray-400 mt-0.5">This month</p>
              </div>
              <div class="card p-4">
                <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Cancelled</p>
                <p id="statCancelled" class="text-xl font-bold mt-1 text-red-400">—</p>
                <p class="text-[10px] text-gray-400 mt-0.5">This month</p>
              </div>
            </div>

            <!-- Filters & Search -->
            <div class="card p-4 mb-6">
                <form method="GET" action="/schooladmin/meetings" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="form-label text-xs">Search Meeting Title</label>
                        <input type="text" name="search" class="form-input" placeholder="e.g. Science Class..." value="<%= filters.search %>">
                    </div>
                    <div>
                        <label class="form-label text-xs">Filter Status</label>
                        <select name="status" class="form-select" onchange="this.form.submit()">
                            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                            <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
                            <option value="live" <%= filters.status === 'live' ? 'selected' : '' %>>Live</option>
                            <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
                            <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                        </select>
                    </div>
                    <div class="flex items-end gap-2">
                        <button type="submit" class="btn btn-secondary flex-1">
                            <i class="fa-solid fa-filter mr-1"></i> Filter
                        </button>
                        <% if (filters.search || filters.status !== 'all') { %>
                            <a href="/schooladmin/meetings" class="btn btn-light" style="padding: 10px 15px;"><i class="fa-solid fa-xmark"></i></a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- Meetings Grid/Table -->
            <% if (!meetings || meetings.length === 0) { %>
                <div class="card text-center py-16">
                    <div class="empty-state">
                        <div class="empty-state-icon" style="color: var(--primary);"><i class="fa-solid fa-video-slash"></i></div>
                        <h3 class="empty-state-title">No meetings found</h3>
                        <p class="empty-state-text">Schedule your first Jitsi meeting to get started.</p>
                        <a href="/schooladmin/meetings/create" class="btn btn-primary btn-sm mt-4">
                            <i class="fa-solid fa-plus mr-1"></i> Schedule Meeting
                        </a>
                    </div>
                </div>
            <% } else { %>
                <div class="card p-0 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table min-w-full divide-y divide-slate-100">
                            <thead>
                                <tr class="bg-slate-50">
                                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Meeting Info</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Room Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Target Audience</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Status</th>
                                    <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-slate-100">
                                <% meetings.forEach(meeting => { %>
                                    <%
                                        let statusClass = 'bg-slate-100 text-slate-700';
                                        if (meeting.status === 'scheduled') statusClass = 'bg-blue-50 text-blue-700 border-blue-200';
                                        if (meeting.status === 'live') statusClass = 'bg-emerald-50 text-emerald-700 border-emerald-200 animate-pulse';
                                        if (meeting.status === 'completed') statusClass = 'bg-slate-100 text-slate-500';
                                        if (meeting.status === 'cancelled') statusClass = 'bg-rose-50 text-rose-700 border-rose-200';

                                        const startMs = new Date(meeting.scheduled_at).getTime();
                                        const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                                        const now = Date.now();
                                        const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
                                        
                                        let targetLabel = meeting.target_type.replace('_', ' ');
                                        if (meeting.target_type === 'specific_class') {
                                            targetLabel = `Class: ${meeting.class_name || 'N/A'}`;
                                        }
                                    %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="font-bold text-gray-800 text-sm"><%= meeting.title %></div>
                                            <div class="text-[11px] text-gray-400 mt-1">
                                                <i class="fa-regular fa-calendar-days mr-1"></i>
                                                <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                                · <i class="fa-regular fa-clock mr-1"></i><%= meeting.duration_minutes %> mins
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-xs font-mono text-gray-500">
                                            <%= meeting.room_name %>
                                        </td>
                                        <td class="px-6 py-4 text-sm font-semibold capitalize text-gray-600">
                                            <%= targetLabel %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-1 rounded-full text-xs font-bold capitalize border <%= statusClass %>">
                                                <%= meeting.status %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <a href="/schooladmin/meetings/<%= meeting.id %>" class="btn btn-sm btn-light" title="View Details">
                                                    <i class="fa-solid fa-eye"></i> Details
                                                </a>
                                                <% if (canJoin) { %>
                                                    <a href="/schooladmin/meetings/<%= meeting.id %>/join" class="btn btn-sm btn-success" title="Join Jitsi Call">
                                                        <i class="fa-solid fa-video mr-1"></i> Join
                                                    </a>
                                                <% } else { %>
                                                    <button class="btn btn-sm btn-secondary opacity-50 cursor-not-allowed" disabled title="Join window opens 15 mins before start time">
                                                        <i class="fa-solid fa-video mr-1"></i> Join
                                                    </button>
                                                <% } %>
                                                 <a href="/schooladmin/meetings/<%= meeting.id %>/attendance-report" class="btn btn-sm btn-secondary" title="View Attendance Report">
                                                     <i class="fa-solid fa-chart-simple"></i> Report
                                                 </a>
                                                 <% if (meeting.status === 'completed' || meeting.status === 'live') { %>
                                                   <a href="/schooladmin/meetings/<%= meeting.id %>/attendance-report/pdf"
                                                      class="btn-icon text-gray-400 hover:text-red-500 transition"
                                                      title="Export Attendance PDF"
                                                      style="padding: 4px 8px; font-size: 12px;">
                                                     <i class="fas fa-file-pdf"></i>
                                                   </a>
                                                 <% } %>
                                                 <% if (meeting.status === 'scheduled') { %>
                                                    <a href="/schooladmin/meetings/<%= meeting.id %>/edit" class="btn-icon btn-edit-icon" title="Edit">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </a>
                                                    <button onclick="openCancelModal(<%= meeting.id %>, '<%= meeting.title %>')" class="btn-icon btn-danger-icon" title="Cancel Meeting">
                                                        <i class="fa-solid fa-ban"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>

<!-- Cancel Meeting Modal -->
<div id="cancelModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md mx-4">
        <h3 class="text-base font-bold text-gray-800 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation text-rose-500"></i> Cancel Meeting
        </h3>
        <p class="text-xs text-gray-500 mb-4">Are you sure you want to cancel the meeting <strong id="cancelMeetingTitle"></strong>? This will notify all invited participants.</p>
        <form id="cancelForm" method="POST" action="" class="space-y-4">
            <div class="form-group">
                <label class="form-label">Reason for Cancellation *</label>
                <textarea name="cancel_reason" required class="form-input" rows="3" placeholder="e.g. Schedule conflict, technical issue..."></textarea>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="submit" class="btn btn-danger flex-1">Yes, Cancel Meeting</button>
                <button type="button" onclick="closeCancelModal()" class="btn btn-secondary flex-1">Close</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openCancelModal(id, title) {
        document.getElementById('cancelMeetingTitle').textContent = title;
        document.getElementById('cancelForm').action = '/schooladmin/meetings/' + id + '/cancel';
        document.getElementById('cancelModal').classList.remove('hidden');
    }
    
    function closeCancelModal() {
        document.getElementById('cancelModal').classList.add('hidden');
    }

    document.getElementById('cancelModal').addEventListener('click', function(e) {
        if (e.target === this) closeCancelModal();
    });
</script>

<script>
(async () => {
  try {
    const res = await fetch('/schooladmin/api/meetings/stats');
    const d = await res.json();
    if (!d.success) return;
    document.getElementById('statScheduled').textContent = d.stats.scheduled ?? 0;
    document.getElementById('statLive').textContent = d.stats.liveNow ?? 0;
    document.getElementById('statCompleted').textContent = d.stats.completed ?? 0;
    document.getElementById('statCancelled').textContent = d.stats.cancelled ?? 0;

    // Pulse live count if > 0
    if ((d.stats.liveNow ?? 0) > 0) {
      document.getElementById('statLive').classList.add('animate-pulse');
    }
  } catch (e) {
    console.error('Meeting stats failed', e);
  }
})();
</script>
