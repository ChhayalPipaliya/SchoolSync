<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Edit Meeting</h2>
                    <p class="text-xs text-gray-500 mt-1">Modify the scheduled meeting details.</p>
                </div>
                <div>
                    <a href="/schooladmin/meetings/<%= meeting.id %>" class="btn btn-secondary btn-sm">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Back to Details
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card p-6 max-w-3xl mx-auto">
                <form method="POST" action="/schooladmin/meetings/<%= meeting.id %>/edit" class="space-y-6" id="meetingForm">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group md:col-span-2">
                            <label class="form-label font-bold text-gray-700">Meeting Title *</label>
                            <input type="text" name="title" required maxlength="255" class="form-input" placeholder="e.g. Science Class" value="<%= meeting.title %>">
                        </div>
                        <div class="form-group md:col-span-2">
                            <label class="form-label font-bold text-gray-700">Description</label>
                            <textarea name="description" class="form-input" rows="3" maxlength="2000" placeholder="Provide details..."><%= meeting.description %></textarea>
                        </div>
                        <%
                            const schedDate = new Date(meeting.scheduled_at);
                            schedDate.setMinutes(schedDate.getMinutes() - schedDate.getTimezoneOffset());
                            const schedString = schedDate.toISOString().slice(0, 16);
                        %>
                        <div class="form-group">
                            <label class="form-label font-bold text-gray-700">Scheduled At *</label>
                            <input type="datetime-local" name="scheduled_at" required class="form-input" value="<%= schedString %>">
                        </div>
                        <div class="form-group">
                            <label class="form-label font-bold text-gray-700">Duration (Minutes) *</label>
                            <input type="number" name="duration_minutes" required class="form-input" min="5" max="300" value="<%= meeting.duration_minutes %>">
                        </div>
                        <div class="form-group md:col-span-2">
                            <label class="form-label font-bold text-gray-700">Target Audience *</label>
                            <select name="target_type" id="targetType" required class="form-select" onchange="toggleTargetDetails()">
                                <option value="all" <%= meeting.target_type === 'all' ? 'selected' : '' %>>All Users</option>
                                <option value="teachers" <%= meeting.target_type === 'teachers' ? 'selected' : '' %>>Teachers Only</option>
                                <option value="students" <%= meeting.target_type === 'students' ? 'selected' : '' %>>Students Only</option>
                                <option value="parents" <%= meeting.target_type === 'parents' ? 'selected' : '' %>>Parents Only</option>
                                <option value="staff" <%= meeting.target_type === 'staff' ? 'selected' : '' %>>Staff Only (Teachers, Drivers, Librarians)</option>
                                <option value="drivers" <%= meeting.target_type === 'drivers' ? 'selected' : '' %>>Drivers Only</option>
                                <option value="librarians" <%= meeting.target_type === 'librarians' ? 'selected' : '' %>>Librarians Only</option>
                                <option value="specific_class" <%= meeting.target_type === 'specific_class' ? 'selected' : '' %>>Specific Class</option>
                                <option value="multiple_classes" <%= meeting.target_type === 'multiple_classes' ? 'selected' : '' %>>Multiple Classes</option>
                            </select>
                        </div>
                        <div class="form-group md:col-span-2 hidden" id="specificClassDiv">
                            <label class="form-label font-bold text-gray-700">Select Class *</label>
                            <select name="target_class_id" id="targetClassId" class="form-select">
                                <option value="" disabled>-- Select a Class --</option>
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= meeting.target_class_id == c.id ? 'selected' : '' %>><%= c.display_name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group md:col-span-2 hidden" id="multipleClassesDiv">
                            <label class="form-label font-bold text-gray-700 mb-2">Select Classes *</label>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-4 bg-slate-50 border border-slate-200 rounded-xl">
                                <% classes.forEach(c => { %>
                                    <% const isChecked = selectedClassIds.includes(c.id); %>
                                    <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700">
                                        <input type="checkbox" name="class_ids" value="<%= c.id %>" <%= isChecked ? 'checked' : '' %> class="w-4 h-4 rounded text-primary border-gray-300">
                                        <%= c.display_name %>
                                    </label>
                                <% }) %>
                            </div>
                            <p class="text-xs text-rose-600 mt-2 hidden" id="classSelectionError">Select at least one class.</p>
                        </div>
                    </div>
                    <div class="flex gap-4 pt-4 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1">
                            <i class="fa-solid fa-save mr-1"></i> Save Changes
                        </button>
                        <a href="/schooladmin/meetings/<%= meeting.id %>" class="btn btn-secondary flex-1 text-center">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script>
    function toggleTargetDetails() {
        const targetType = document.getElementById('targetType').value;
        const specClassDiv = document.getElementById('specificClassDiv');
        const multiClassDiv = document.getElementById('multipleClassesDiv');
        const targetClassSelect = document.getElementById('targetClassId');

        specClassDiv.classList.add('hidden');
        multiClassDiv.classList.add('hidden');
        targetClassSelect.required = false;

        if (targetType === 'specific_class') {
            specClassDiv.classList.remove('hidden');
            targetClassSelect.required = true;
        } else if (targetType === 'multiple_classes') {
            multiClassDiv.classList.remove('hidden');
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        toggleTargetDetails();
        const datetimeInput = document.querySelector('input[type="datetime-local"]');
        if (datetimeInput) {
            const now = new Date();
            const localNow = new Date(now.getTime());
            localNow.setMinutes(localNow.getMinutes() - localNow.getTimezoneOffset());
            datetimeInput.min = localNow.toISOString().slice(0, 16);
        }

        const form = document.getElementById('meetingForm');
        const classError = document.getElementById('classSelectionError');
        if (form) {
            form.addEventListener('submit', (event) => {
                const targetType = document.getElementById('targetType').value;
                const checkedClasses = document.querySelectorAll('input[name="class_ids"]:checked');
                if (targetType === 'multiple_classes' && checkedClasses.length === 0) {
                    event.preventDefault();
                    if (classError) classError.classList.remove('hidden');
                }
            });
        }
    });
</script>