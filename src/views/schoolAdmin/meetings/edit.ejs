<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Edit_Meeting || 'Edit Meeting' %></h2>
        <p class="text-xs text-gray-500 mt-1"><%- lan.Edit_Meeting_Desc || 'Modify the scheduled meeting details.' %></p>
    </div>
    <div>
        <a href="/schooladmin/meetings/<%= meeting.id %>" class="btn btn-secondary btn-sm w-full sm:w-auto inline-flex items-center justify-center">
            <i class="fa-solid fa-arrow-left mr-1"></i> <%- lan.Back_To_Details || 'Back to Details' %>
        </a>
    </div>
</div>
<div class="card p-4 sm:p-6 max-w-3xl mx-auto">
    <form method="POST" action="/schooladmin/meetings/<%= meeting.id %>/edit" class="space-y-6" id="meetingForm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="form-group sm:col-span-2">
                <label class="form-label font-bold text-gray-700"><%- lan.Meeting_Title || 'Meeting Title' %> *</label>
                <input type="text" name="title" required maxlength="255" class="form-input" placeholder="<%- lan.Meeting_Title_Placeholder || 'e.g. Science Class' %>" value="<%= meeting.title %>">
            </div>
            <div class="form-group sm:col-span-2">
                <label class="form-label font-bold text-gray-700"><%- lan.Description || 'Description' %></label>
                <textarea name="description" class="form-input" rows="3" maxlength="2000" placeholder="<%- lan.Meeting_Description_Placeholder || 'Provide details...' %>"><%= meeting.description %></textarea>
            </div>
            <%
                const schedDate = new Date(meeting.scheduled_at);
                schedDate.setMinutes(schedDate.getMinutes() - schedDate.getTimezoneOffset());
                const schedString = schedDate.toISOString().slice(0, 16);
            %>
            <div class="form-group">
                <label class="form-label font-bold text-gray-700"><%- lan.Scheduled_At || 'Scheduled At' %> *</label>
                <input type="datetime-local" name="scheduled_at" required class="form-input" value="<%= schedString %>">
            </div>
            <div class="form-group">
                <label class="form-label font-bold text-gray-700"><%- lan.Duration_Minutes || 'Duration (Minutes)' %> *</label>
                <input type="number" name="duration_minutes" required class="form-input" min="5" max="300" value="<%= meeting.duration_minutes %>">
            </div>
            <div class="form-group sm:col-span-2">
                <label class="form-label font-bold text-gray-700"><%- lan.Target_Audience || 'Target Audience' %> *</label>
                <select name="target_type" id="targetType" required class="form-select" onchange="toggleTargetDetails()">
                    <option value="all" <%= meeting.target_type === 'all' ? 'selected' : '' %>><%- lan.All_Users || 'All Users' %></option>
                    <option value="teachers" <%= meeting.target_type === 'teachers' ? 'selected' : '' %>><%- lan.Teachers_Only || 'Teachers Only' %></option>
                    <option value="students" <%= meeting.target_type === 'students' ? 'selected' : '' %>><%- lan.Students_Only || 'Students Only' %></option>
                    <option value="parents" <%= meeting.target_type === 'parents' ? 'selected' : '' %>><%- lan.Parents_Only || 'Parents Only' %></option>
                    <option value="staff" <%= meeting.target_type === 'staff' ? 'selected' : '' %>><%- lan.Staff_Only || 'Staff Only (Teachers, Drivers, Librarians)' %></option>
                    <option value="drivers" <%= meeting.target_type === 'drivers' ? 'selected' : '' %>><%- lan.Drivers_Only || 'Drivers Only' %></option>
                    <option value="librarians" <%= meeting.target_type === 'librarians' ? 'selected' : '' %>><%- lan.Librarians_Only || 'Librarians Only' %></option>
                    <option value="specific_class" <%= meeting.target_type === 'specific_class' ? 'selected' : '' %>><%- lan.Specific_Class || 'Specific Class' %></option>
                    <option value="multiple_classes" <%= meeting.target_type === 'multiple_classes' ? 'selected' : '' %>><%- lan.Multiple_Classes || 'Multiple Classes' %></option>
                </select>
            </div>
            <div class="form-group sm:col-span-2 hidden" id="specificClassDiv">
                <label class="form-label font-bold text-gray-700"><%- lan.Select_Class || 'Select Class' %> *</label>
                <select name="target_class_id" id="targetClassId" class="form-select">
                    <option value="" disabled><%- lan.Select_A_Class || '-- Select a Class --' %></option>
                    <% (classes||[]).forEach(c => { %>
                        <option value="<%= c.id %>" <%= meeting.target_class_id == c.id ? 'selected' : '' %>><%= c.display_name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group sm:col-span-2 hidden" id="multipleClassesDiv">
                <label class="form-label font-bold text-gray-700 mb-2"><%- lan.Select_Classes || 'Select Classes' %> *</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 sm:gap-3 p-4 bg-slate-50 border border-slate-200 rounded-xl">
                    <% (classes||[]).forEach(c => { %>
                        <% const isChecked = (selectedClassIds||[]).includes(c.id); %>
                        <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-gray-700">
                            <input type="checkbox" name="class_ids" value="<%= c.id %>" <%= isChecked ? 'checked' : '' %> class="w-4 h-4 rounded text-primary border-gray-300">
                            <%= c.display_name %>
                        </label>
                    <% }) %>
                </div>
                <p class="text-xs text-rose-600 mt-2 hidden" id="classSelectionError"><%- lan.Select_At_Least_One_Class || 'Select at least one class.' %></p>
            </div>
        </div>
        <div class="flex gap-3 sm:gap-4 pt-4 border-t border-slate-100">
            <button type="submit" class="btn btn-primary flex-1 inline-flex items-center justify-center">
                <i class="fa-solid fa-save mr-1"></i> <%- lan.Save_Changes || 'Save Changes' %>
            </button>
            <a href="/schooladmin/meetings/<%= meeting.id %>" class="btn btn-secondary flex-1 text-center inline-flex items-center justify-center"><%- lan.Cancel || 'Cancel' %></a>
        </div>
    </form>
</div>
<script>
    function toggleTargetDetails() {
        const targetType = document.getElementById('targetType').value;
        const specClassDiv = document.getElementById('specificClassDiv');
        const multiClassDiv = document.getElementById('multipleClassesDiv');
        const targetClassSelect = document.getElementById('targetClassId');

        specClassDiv.classList.add('hidden');
        multiClassDiv.classList.add('hidden');
        targetClassSelect.required = false;

        if (targetType === 'specific_class') {
            specClassDiv.classList.remove('hidden');
            targetClassSelect.required = true;
        } else if (targetType === 'multiple_classes') {
            multiClassDiv.classList.remove('hidden');
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        toggleTargetDetails();
        const datetimeInput = document.querySelector('input[type="datetime-local"]');
        if (datetimeInput) {
            const now = new Date();
            const localNow = new Date(now.getTime());
            localNow.setMinutes(localNow.getMinutes() - localNow.getTimezoneOffset());
            datetimeInput.min = localNow.toISOString().slice(0, 16);
        }

        const form = document.getElementById('meetingForm');
        const classError = document.getElementById('classSelectionError');
        if (form) {
            form.addEventListener('submit', (event) => {
                const targetType = document.getElementById('targetType').value;
                const checkedClasses = document.querySelectorAll('input[name="class_ids"]:checked');
                if (targetType === 'multiple_classes' && checkedClasses.length === 0) {
                    event.preventDefault();
                    if (classError) classError.classList.remove('hidden');
                }
            });
        }
    });
</script>