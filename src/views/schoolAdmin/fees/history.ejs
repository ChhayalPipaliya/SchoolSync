<%- include('../../partials/head', { title: `${lan.Payment_Ledger || 'Payment Ledger'} | SchoolSync` }) %>
<style>
    .table-history thead th {
        background: #F8FAFC;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748B;
        padding: 12px 15px;
        border-bottom: 2px solid #E2E8F0;
    }
    .table-history tbody td {
        padding: 15px;
        vertical-align: middle;
        font-size: 14px;
        border-bottom: 1px solid #F1F5F9;
    }
    .receipt-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #EEF2FF;
        color: #4F46E5;
        border: 1px solid #C7D2FE;
        padding: 5px 12px;
        border-radius: 8px;
        font-family: 'Monaco', 'Consolas', monospace;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .receipt-pill:hover {
        background: #E0E7FF;
        color: #3730A3;
        transform: translateY(-1px);
    }
    .month-badge {
        background: #F1F5F9;
        border: 1px solid #E2E8F0;
        color: #334155;
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 600;
    }

    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table thead tr,
    .light-mode-disabled .table thead tr {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .table thead th,
    .light-mode-disabled .table thead th {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .table tbody tr,
    .light-mode-disabled .table tbody tr {
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .table tbody tr:hover,
    .light-mode-disabled .table tbody tr:hover {
        background: #1E293B !important;
    }
    [data-theme="dark"] .table tbody td,
    .light-mode-disabled .table tbody td {
        color: #E2E8F0 !important;
    }
    [data-theme="dark"] .receipt-pill,
    .light-mode-disabled .receipt-pill {
        background: rgba(99, 102, 241, 0.15) !important;
        color: #A5B4FC !important;
        border-color: rgba(99, 102, 241, 0.35) !important;
    }
    [data-theme="dark"] .receipt-pill:hover,
    .light-mode-disabled .receipt-pill:hover {
        background: rgba(99, 102, 241, 0.25) !important;
        color: #C7D2FE !important;
    }
    [data-theme="dark"] .month-badge,
    .light-mode-disabled .month-badge {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .amount-paid-text,
    .light-mode-disabled .amount-paid-text {
        color: #34D399 !important;
    }
    [data-theme="dark"] .total-collection-text,
    .light-mode-disabled .total-collection-text {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .empty-icon-box,
    .light-mode-disabled .empty-icon-box {
        background: #101726 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .empty-title,
    .light-mode-disabled .empty-title {
        color: #F1F5F9 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                <% if (payments && payments.length > 0) { %>
                                    <%= payments[0].first_name %> <%= payments[0].last_name %>
                                <% } else { %>
                                    <%- lan.Student || 'Student' %>
                                <% } %>
                                — <%- lan.Payment_History || 'Payment History' %>
                            </h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;">
                                <%- lan.Payment_History_Desc || 'View the ledger of historical fee collections and transactions' %>
                            </p>
                        </div>
                    </div>
                    <div>
                        <a href="/schooladmin/fees/pending" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_List || 'Back to List' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card" style="padding: 0; overflow: hidden; border-radius: 12px; margin-bottom: 24px;">
                <div style="overflow-x:auto;">
                    <table class="table" style="width:100%; border-collapse:collapse; margin:0;">
                        <thead>
                            <tr style="border-bottom:1px solid #E2E8F0; text-align:left; background:#F8FAFC;">
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Receipt_No || 'Receipt No' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Payment_Date || 'Payment Date' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Fee_Month || 'Fee Month' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Payment_Method || 'Payment Method' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; text-align:right;"><%- lan.Amount_Paid || 'Amount Paid' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (payments.length > 0) { %>
                                <% payments.forEach(p => { %>
                                    <tr style="border-bottom:1px solid #F1F5F9;">
                                        <td style="padding:14px 16px;">
                                            <a href="/schooladmin/fees/receipt/<%= p.id %>" class="receipt-pill" style="text-decoration:none;" title="View & Download Receipt">
                                                <i class="fa-solid fa-file-invoice" style="margin-right:4px;"></i> <%= p.receipt_no || '#' + p.id %>
                                            </a>
                                        </td>
                                        <td style="padding:14px 16px; font-size:13px; color:#475569; font-weight:500;">
                                            <i class="fa-regular fa-calendar-check" style="margin-right:4px; opacity:0.6;"></i>
                                            <%= new Date(p.payment_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                        </td>
                                        <td style="padding:14px 16px;">
                                            <span class="month-badge">
                                                <%= p.fee_month %>
                                            </span>
                                        </td>
                                        <td style="padding:14px 16px; font-size:13px;">
                                            <i class="fa-solid fa-money-bill-transfer" style="margin-right:6px; opacity:0.5;"></i>
                                            <%= p.payment_method %>
                                        </td>
                                        <td style="padding:14px 16px; text-align:right;">
                                            <div class="amount-paid-text" style="font-weight:800; color:#15803D; font-size:15px;">
                                                ₹<%= parseFloat(p.amount).toLocaleString('en-IN', {minimumFractionDigits: 2}) %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="padding:40px; text-align:center;">
                                        <div class="empty-icon-box" style="background: #F8FAFC; width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px; border: 1px solid #E2E8F0;">
                                            <i class="fa-solid fa-receipt" style="font-size: 24px; color: #CBD5E1;"></i>
                                        </div>
                                        <h4 class="empty-title" style="color:#475569; font-weight:700; font-size:16px; margin:0 0 6px;"><%- lan.No_Transactions_Found || 'No transactions found' %></h4>
                                        <p style="color:#94A3B8; font-size:13px; margin:0;"><%- lan.No_Fee_Payments_Recorded_Student || 'This student has no recorded fee payments yet.' %></p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% if (payments.length > 0) { %>
                <div style="text-align:right; padding-right:16px;">
                    <span style="font-size:12px; color:#94A3B8; font-weight:600; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Total_Historical_Collection || 'Total Historical Collection' %>:</span>
                    <span class="total-collection-text" style="font-size:20px; font-weight:800; color:#1E293B; margin-left:10px;">
                        ₹<%= payments.reduce((acc, p) => acc + parseFloat(p.amount), 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %>
                    </span>
                </div>
            <% } %>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>