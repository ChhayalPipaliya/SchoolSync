<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { active: 'fees', user: user }) %>

    <div class="main-panel">
        <%- include('../../partials/header') %>

        <div class="content">
            <!-- Page Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Generate Student Fee</h2>
                    <p class="text-xs text-gray-500 mt-1">
                        <a href="/schooladmin/fees" style="color: var(--primary); text-decoration: none;">Student Fees</a> &rarr; Generate Record
                    </p>
                </div>
                <div>
                    <a href="/schooladmin/fees" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>

            <!-- Flash Messages -->
            <%- include('../../partials/flashMessages') %>

            <div class="max-w-xl">
                <div class="card p-6">
                    <form action="/schooladmin/fees/generate" method="POST" class="space-y-4">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                            <i class="fa-solid fa-file-invoice me-2"></i>Fee Generation Details
                        </h3>

                        <div class="form-group mb-0">
                            <label class="form-label">Student *</label>
                            <select class="form-select" name="student_id" required>
                                <option value="">-- Select Student --</option>
                                <% students.forEach(s => { %>
                                    <option value="<%= s.id %>">
                                        <%= s.first_name %> <%= s.last_name %> — <%= s.className %> (<%= s.section %>)
                                    </option>
                                <% }) %>
                            </select>
                            <p class="text-[11px] text-gray-400 mt-1.5">
                                Fees are generated based on the student's assigned class.
                            </p>
                        </div>

                        <div class="form-group mb-0">
                            <label class="form-label">Fee Month *</label>
                            <input type="month" class="form-input" name="fee_month" required>
                            <div class="text-xs bg-slate-50 text-gray-500 p-3.5 border border-slate-100 rounded-lg mt-3">
                                <i class="fa-solid fa-circle-info me-1" style="color: var(--primary);"></i>
                                The total amount is calculated automatically according to the <strong>Fee Structure</strong> defined for this student's class.
                            </div>
                        </div>

                        <div class="flex gap-2 pt-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-plus me-1"></i> Generate Fee Record
                            </button>
                            <a href="/schooladmin/fees" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
