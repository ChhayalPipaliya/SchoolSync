<%- include('../../partials/head', { title: `${lan.Generate_Student_Fee || 'Generate Student Fee' } | SchoolSync` }) %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { active: 'fees' , user: user }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Generate_Student_Fee
                                        || 'Generate Student Fee' %></h2>
                                <p class="text-xs text-gray-500 mt-1">
                                    <a href="/schooladmin/fees"
                                        style="color: var(--primary); text-decoration: none;"><%- lan.Student_Fees
                                            || 'Student Fees' %></a> &rarr; <%- lan.Generate_Record || 'Generate Record'
                                        %>
                                </p>
                            </div>
                            <div>
                                <a href="/schooladmin/fees" class="btn btn-secondary">
                                    <i class="fa-solid fa-arrow-left me-1"></i> <%- lan.Back_To_List || 'Back to List'
                                        %>
                                </a>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div class="max-w-xl">
                                <div class="card p-6">
                                    <form action="/schooladmin/fees/generate" method="POST" class="space-y-4">
                                        <input type="hidden" name="_csrf"
                                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <h3 class="text-sm font-bold uppercase tracking-wider mb-3 pb-2 border-b border-slate-100"
                                            style="color: var(--primary);">
                                            <i class="fa-solid fa-file-invoice me-2"></i><%- lan.Annual_Fee_Gen_Details
                                                || 'Annual Fee Generation Details' %>
                                        </h3>
                                        <div class="form-group mb-0">
                                            <label class="form-label"><%- lan.Student || 'Student' %> *</label>
                                            <select class="form-select" name="student_id" required>
                                                <option value="">-- <%- lan.Select_Student || 'Select Student' %> --
                                                </option>
                                                <% students.forEach(s=> { %>
                                                    <option value="<%= s.id %>">
                                                        <%= s.first_name %>
                                                            <%= s.last_name %> — <%= s.className %> (<%= s.section %>)
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <p class="text-[11px] text-gray-400 mt-1.5">
                                                <%- lan.Annual_Fee_Auto_Determined
                                                    || "Annual fee is determined automatically from the student's assigned class fee structure."
                                                    %>
                                            </p>
                                        </div>
                                        <div class="form-group mb-0">
                                            <label class="form-label"><%- lan.Academic_Year || 'Academic Year' %>
                                                    *</label>
                                            <select class="form-select" name="academic_year" required>
                                                <% (typeof academicYears !=='undefined' && academicYears.length> 0 ?
                                                    academicYears : [{ code: '2026-2027', is_current: 1
                                                    }]).forEach(function(ay) { %>
                                                    <option value="<%= ay.code %>" <%=ay.is_current ? 'selected' : '' %>
                                                        >
                                                        <%- lan.Academic_Year || 'Academic Year' %>
                                                            <%= ay.code %>
                                                                <%= ay.is_current ? `(${lan.Current || 'Current' })`
                                                                    : '' %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                            <div
                                                class="text-xs bg-slate-50 text-gray-500 p-3.5 border border-slate-100 rounded-lg mt-3">
                                                <i class="fa-solid fa-circle-info me-1"
                                                    style="color: var(--primary);"></i>
                                                <%- lan.Single_Annual_Liability_Notice
                                                    || 'Creates one annual fee liability record for the selected student for the entire academic year (e.g. ₹22,000 for Class 1).'
                                                    %>
                                            </div>
                                        </div>
                                        <div class="flex gap-2 pt-2">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fa-solid fa-plus me-1"></i> <%- lan.Generate_Annual_Fee_Record
                                                    || 'Generate Annual Fee Record' %>
                                            </button>
                                            <a href="/schooladmin/fees" class="btn btn-secondary"><%- lan.Cancel
                                                    || 'Cancel' %></a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>