<%- include('../../partials/head', { title: `${lan.Official_Payment_Receipt || 'Official Payment Receipt' } |
    SchoolSync` }) %>
    <style>
        @media print {
            body {
                background: #FFFFFF !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .sidebar,
            .top-header,
            .header,
            .no-print,
            .btn,
            footer,
            #ss-ai-trigger,
            #ss-ai-widget,
            #ss-ai-window,
            #ss-ai-locked-popup {
                display: none !important;
                visibility: hidden !important;
                opacity: 0 !important;
            }

            .app-wrapper,
            .main-panel,
            .content {
                margin: 0 !important;
                padding: 0 !important;
                background: #FFFFFF !important;
            }

            .receipt-card {
                box-shadow: none !important;
                border: 1px solid #E2E8F0 !important;
                margin: 0 auto !important;
                width: 100% !important;
                max-width: 100% !important;
                padding: 24px !important;
            }
        }

        .receipt-card {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
            padding: 18px;
            position: relative;
        }

        .receipt-badge {
            background: #F0FDFA;
            border: 1px solid #CCFBF1;
            color: #0F766E;
            padding: 6px 14px;
            border-radius: 8px;
            font-family: 'Monaco', 'Consolas', monospace;
            font-weight: 700;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        @media (max-width: 768px) {
            .schooladmin-theme .content {
                padding: 12px 10px !important;
            }

            .receipt-card {
                padding: 14px !important;
                border-radius: 12px !important;
            }

            .receipt-header-actions {
                flex-direction: column !important;
                align-items: stretch !important;
            }

            .receipt-header-actions a,
            .receipt-header-actions button {
                width: 100% !important;
                justify-content: center !important;
            }
        }

        [data-theme="dark"] .receipt-card,
        .light-mode-disabled .receipt-card {
            background: #151D30 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .bg-slate-50,
        .light-mode-disabled .bg-slate-50 {
            background: #101726 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .text-slate-800,
        .light-mode-disabled .text-slate-800 {
            color: #F1F5F9 !important;
        }
    </style>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content">
                        <div class="receipt-container">
                            <div class="no-print flex flex-wrap items-center justify-between gap-3 mb-3">
                                <div class="flex items-center gap-2">
                                    <a href="/schooladmin/fees/history"
                                        class="btn btn-secondary text-xs flex items-center gap-1.5 px-3 py-2">
                                        <i class="fa-solid fa-arrow-left"></i> <%- lan.Payment_Ledger
                                            || 'Payment Ledger' %>
                                    </a>
                                    <a href="/schooladmin/fees/collect"
                                        class="btn btn-secondary text-xs flex items-center gap-1.5 px-3 py-2">
                                        <i class="fa-solid fa-hand-holding-dollar"></i> <%- lan.Collect_Another_Fee
                                            || 'Collect Another Fee' %>
                                    </a>
                                </div>
                                <div class="flex items-center gap-3">
                                    <button type="button" onclick="window.print()"
                                        class="btn btn-secondary text-xs font-semibold flex items-center gap-1.5 px-4 py-2 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50">
                                        <i class="fa-solid fa-print text-slate-500"></i> <%- lan.Print_Receipt
                                            || 'Print Receipt' %>
                                    </button>
                                    <a href="/schooladmin/fees/receipt/<%= payment.id %>/download"
                                        class="btn btn-primary text-xs font-semibold flex items-center gap-1.5 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm">
                                        <i class="fa-solid fa-file-pdf"></i> <%- lan.Download_Official_PDF
                                            || 'Download Official PDF' %>
                                    </a>
                                </div>
                            </div>
                            <%- include('../../partials/flashMessages') %>
                                <div class="receipt-card">
                                    <div
                                        class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-2 border-b border-slate-200">
                                        <div class="flex items-center gap-4">
                                            <% if (school.logoPath) { %>
                                                <img src="/uploads/schools/<%= school.logo %>"
                                                    class="w-14 h-14 object-contain rounded-lg border border-slate-100 p-1"
                                                    onerror="this.style.display='none'">
                                                <% } else { %>
                                                    <div
                                                        class="w-14 h-14 rounded-xl bg-teal-50 border border-teal-100 flex items-center justify-center text-teal-700 font-bold text-xl shadow-inner">
                                                        <%= school.name ? school.name.charAt(0).toUpperCase() : 'S' %>
                                                    </div>
                                                    <% } %>
                                                        <div>
                                                            <h1
                                                                class="text-xl font-extrabold text-slate-800 tracking-tight">
                                                                <%= school.name.toUpperCase() %>
                                                            </h1>
                                                            <p class="text-xs text-slate-500 mt-0.5">
                                                                <%= school.address || 'Education Campus' %>
                                                            </p>
                                                            <p class="text-[11px] text-slate-400 mt-0.5">
                                                                <% if (school.phone) { %><span><i
                                                                            class="fa-solid fa-phone text-[10px] me-1"></i>
                                                                        <%= school.phone %>
                                                                    </span>
                                                                    <% } %>
                                                                        <% if (school.email) { %><span
                                                                                class="mx-2">·</span><span><i
                                                                                    class="fa-solid fa-envelope text-[10px] me-1"></i>
                                                                                <%= school.email %>
                                                                            </span>
                                                                            <% } %>
                                                                                <% if (school.website) { %><span
                                                                                        class="mx-2">·</span><span><i
                                                                                            class="fa-solid fa-globe text-[10px] me-1"></i>
                                                                                        <%= school.website %>
                                                                                    </span>
                                                                                    <% } %>
                                                            </p>
                                                        </div>
                                        </div>
                                        <div class="text-left sm:text-right flex flex-col items-start sm:items-end">
                                            <span
                                                class="text-[10px] font-bold tracking-widest text-teal-700 uppercase mb-1"><%-
                                                    lan.Official_Payment_Receipt || 'Official Payment Receipt' %></span>
                                            <div class="receipt-badge">
                                                <i class="fa-solid fa-receipt text-teal-600"></i>
                                                <%= payment.receiptNumber %>
                                            </div>
                                            <span class="text-[11px] text-slate-400 font-medium mt-1">
                                                <%- lan.Date || 'Date' %>: <%= new
                                                        Date(payment.paymentDate).toLocaleDateString('en-IN', {
                                                        day: '2-digit' , month: 'short' , year: 'numeric' }) %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
                                        <div class="p-4 bg-slate-50 border border-slate-100 rounded-xl">
                                            <h3
                                                class="text-xs font-bold uppercase tracking-wider text-teal-800 mb-3 flex items-center gap-1.5">
                                                <i class="fa-solid fa-user-graduate text-teal-600"></i> <%-
                                                    lan.Student_Details || 'Student Details' %>
                                            </h3>
                                            <div class="space-y-1.5 text-xs">
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500 font-medium"><%- lan.Student_Name
                                                            || 'Student Name' %>:</span>
                                                    <span class="font-bold text-slate-800">
                                                        <%= student.name %>
                                                    </span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500 font-medium"><%- lan.Class_And_Section
                                                            || 'Class & Section' %>:</span>
                                                    <span class="font-bold text-slate-700">
                                                        <%= student.className %>
                                                            <%= student.section ? `(${student.section})` : '' %>
                                                    </span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500 font-medium"><%- lan.Admission_No
                                                            || 'Admission No' %>:</span>
                                                    <span class="font-bold text-slate-700 font-mono">
                                                        <%= student.admissionNo %>
                                                    </span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500 font-medium"><%- lan.Roll_Number
                                                            || 'Roll Number' %>:</span>
                                                    <span class="font-bold text-slate-700">
                                                        <%= student.rollNo %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="p-4 bg-slate-50 border border-slate-100 rounded-xl">
                                            <h3
                                                class="text-xs font-bold uppercase tracking-wider text-teal-800 mb-3 flex items-center gap-1.5">
                                                <i class="fa-solid fa-credit-card text-teal-600"></i> <%-
                                                    lan.Payment_And_Guardian || 'Payment & Guardian' %>
                                            </h3>
                                            <div class="space-y-1.5 text-xs">
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500 font-medium"><%- lan.Father_Or_Guardian
                                                            || 'Father / Guardian' %>:</span>
                                                    <span class="font-bold text-slate-800">
                                                        <%= student.fatherName %>
                                                    </span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500 font-medium"><%- lan.Payment_Mode
                                                            || 'Payment Mode' %>:</span>
                                                    <span class="font-bold text-emerald-700">
                                                        <%= payment.paymentMethodLabel %>
                                                    </span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500 font-medium"><%- lan.Payment_Status
                                                            || 'Payment Status' %>:</span>
                                                    <span
                                                        class="inline-flex items-center gap-1 font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded text-[11px]">
                                                        <i class="fa-solid fa-circle-check text-[10px]"></i> <%-
                                                            lan.Completed_And_Verified || 'Completed & Verified' %>
                                                    </span>
                                                </div>
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500 font-medium"><%- lan.Received_By
                                                            || 'Received By' %>:</span>
                                                    <span class="font-semibold text-slate-600">
                                                        <%= payment.receiverName %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="my-4">
                                        <h3
                                            class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-3 flex items-center gap-1.5">
                                            <i class="fa-solid fa-list-check text-slate-500"></i> <%-
                                                lan.Itemized_Fee_Breakdown || 'Itemized Fee Breakdown' %>
                                        </h3>
                                        <div class="overflow-x-auto border border-slate-200 rounded-xl overflow-hidden">
                                            <table class="w-full text-left text-xs border-collapse"
                                                style="min-width: 520px;">
                                                <thead class="bg-teal-700 text-white font-bold">
                                                    <tr>
                                                        <th class="py-2.5 px-3 w-10" style="white-space: nowrap;">#</th>
                                                        <th class="py-2.5 px-3" style="white-space: nowrap;"><%-
                                                                lan.Fee_Particulars || 'Fee Particulars' %></th>
                                                        <th class="py-2.5 px-3" style="white-space: nowrap;"><%-
                                                                lan.Period || 'Period' %></th>
                                                        <th class="py-2.5 px-3 text-right" style="white-space: nowrap;">
                                                            <%- lan.Demanded || 'Demanded' %></th>
                                                        <th class="py-2.5 px-3 text-right" style="white-space: nowrap;">
                                                            <%- lan.Paid_In_This_Trx || 'Paid In This Trx' %></th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-100">
                                                    <% feeItems.forEach((item, idx)=> { %>
                                                        <tr
                                                            class="<%= idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/50' %>">
                                                            <td class="py-2.5 px-3 text-slate-400 font-mono"
                                                                style="white-space: nowrap;">
                                                                <%= idx + 1 %>
                                                            </td>
                                                            <td class="py-2.5 px-3 font-semibold text-slate-800"
                                                                style="white-space: nowrap;">
                                                                <%= item.name %>
                                                            </td>
                                                            <td class="py-2.5 px-3 text-slate-500"
                                                                style="white-space: nowrap;">
                                                                <%= item.month || item.frequency || (lan.Annual
                                                                    || 'Annual' ) %>
                                                            </td>
                                                            <td class="py-2.5 px-3 text-right text-slate-600"
                                                                style="white-space: nowrap;">₹<%=
                                                                    Number(item.totalAmount).toLocaleString('en-IN', {
                                                                    minimumFractionDigits: 2 }) %>
                                                            </td>
                                                            <td class="py-2.5 px-3 text-right font-bold text-teal-800"
                                                                style="white-space: nowrap;">₹<%=
                                                                    Number(item.allocatedAmount).toLocaleString('en-IN',
                                                                    { minimumFractionDigits: 2 }) %>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div
                                        class="grid grid-cols-1 sm:grid-cols-12 gap-4 pt-2 pb-6 border-b border-slate-200">
                                        <div
                                            class="sm:col-span-7 p-3.5 bg-slate-50 border border-slate-100 rounded-xl text-xs space-y-1.5">
                                            <div
                                                class="font-bold text-slate-700 uppercase tracking-wider text-[11px] mb-2">
                                                <%- lan.Transaction_Metadata || 'Transaction Metadata' %></div>
                                            <div class="flex justify-between">
                                                <span class="text-slate-500"><%- lan.Method || 'Method' %>:</span>
                                                <span class="font-semibold text-slate-800">
                                                    <%= payment.paymentMethodLabel %>
                                                </span>
                                            </div>
                                            <% if (payment.transactionId) { %>
                                                <div class="flex justify-between">
                                                    <span class="text-slate-500"><%- lan.Transaction_ID
                                                            || 'Transaction ID' %>:</span>
                                                    <span class="font-mono text-slate-700">
                                                        <%= payment.transactionId %>
                                                    </span>
                                                </div>
                                                <% } %>
                                                    <% if (payment.paymentReference) { %>
                                                        <div class="flex justify-between">
                                                            <span class="text-slate-500"><%- lan.Reference_Or_UTR
                                                                    || 'Reference / UTR' %>:</span>
                                                            <span class="font-mono text-slate-700">
                                                                <%= payment.paymentReference %>
                                                            </span>
                                                        </div>
                                                        <% } %>
                                                            <% if (payment.razorpayOrderId) { %>
                                                                <div class="flex justify-between">
                                                                    <span class="text-slate-500"><%- lan.Razorpay_Order
                                                                            || 'Razorpay Order' %>:</span>
                                                                    <span class="font-mono text-slate-700">
                                                                        <%= payment.razorpayOrderId %>
                                                                    </span>
                                                                </div>
                                                                <% } %>
                                                                    <% if (payment.razorpayPaymentId) { %>
                                                                        <div class="flex justify-between">
                                                                            <span class="text-slate-500"><%-
                                                                                    lan.Razorpay_Payment
                                                                                    || 'Razorpay Payment' %>:</span>
                                                                            <span class="font-mono text-slate-700">
                                                                                <%= payment.razorpayPaymentId %>
                                                                            </span>
                                                                        </div>
                                                                        <% } %>
                                                                            <% if (student.address) { %>
                                                                                <div class="flex justify-between">
                                                                                    <span class="text-slate-500"><%-
                                                                                            lan.Address || 'Address'
                                                                                            %>:</span>
                                                                                    <span
                                                                                        class="text-slate-700 truncate max-w-[200px]">
                                                                                        <%= student.address %>
                                                                                    </span>
                                                                                </div>
                                                                                <% } %>
                                        </div>
                                        <div
                                            class="sm:col-span-5 p-4 bg-teal-50/50 border border-teal-100 rounded-xl text-xs space-y-2">
                                            <div class="flex justify-between text-slate-600">
                                                <span><%- lan.Allocated_Subtotal || 'Allocated Subtotal' %>:</span>
                                                <span class="font-semibold">₹<%=
                                                        Number(payment.totalAllocated).toLocaleString('en-IN', {
                                                        minimumFractionDigits: 2 }) %></span>
                                            </div>
                                            <% if (payment.discount> 0) { %>
                                                <div class="flex justify-between text-emerald-600 font-semibold">
                                                    <span><%- lan.Discount_Applied || 'Discount Applied' %>:</span>
                                                    <span>-₹<%= Number(payment.discount).toLocaleString('en-IN', {
                                                            minimumFractionDigits: 2 }) %></span>
                                                </div>
                                                <% } %>
                                                    <div
                                                        class="flex justify-between text-sm font-extrabold text-teal-900 border-t border-teal-200/60 pt-2">
                                                        <span><%- lan.Total_Paid || 'TOTAL PAID' %>:</span>
                                                        <span class="text-base text-teal-800">₹<%=
                                                                Number(payment.amount).toLocaleString('en-IN', {
                                                                minimumFractionDigits: 2 }) %></span>
                                                    </div>
                                                    <div
                                                        class="flex justify-between text-[11px] text-red-600 font-semibold border-t border-teal-200/40 pt-1.5">
                                                        <span><%- lan.Overall_Balance_Due || 'Overall Balance Due'
                                                                %>:</span>
                                                        <span>₹<%=
                                                                Number(summary.overallBalance).toLocaleString('en-IN', {
                                                                minimumFractionDigits: 2 }) %></span>
                                                    </div>
                                        </div>
                                    </div>
                                    <div
                                        class="flex flex-col sm:flex-row justify-between items-end pt-6 gap-4 text-xs text-slate-400">
                                        <div>
                                            <p class="font-serif italic text-slate-700 text-sm font-semibold mb-1"><%-
                                                    lan.Accounts_Office_Signatory
                                                    || 'Accounts Office / Authorized Signatory' %></p>
                                            <p class="text-[10px] text-slate-400"><%- lan.Computer_Generated_Voucher
                                                    || 'Computer generated official voucher' %> · <%- lan.Verified_On
                                                        || 'Verified on' %>
                                                        <%= new Date().toLocaleDateString('en-IN') %>
                                            </p>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-[11px] font-semibold text-slate-500"><%-
                                                    lan.Thank_You_For_Payment || 'Thank you for your payment!' %></p>
                                            <p
                                                class="text-[10px] text-teal-700 font-bold tracking-wider uppercase mt-0.5">
                                                SchoolSync Management ERP</p>
                                        </div>
                                    </div>
                                </div>
                        </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>