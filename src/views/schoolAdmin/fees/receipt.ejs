<%- include('../../partials/head') %>
  <div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
      <div class="main-panel">
        <%- include('../../partials/header') %>
          <div class="content">
            <div class="max-w-2xl mx-auto">
              <div class="bg-white rounded-lg shadow p-8">
                <div class="text-center mb-6 border-b pb-4">
                  <h2 class="text-2xl font-bold text-gray-800">Fee Receipt</h2>
                  <p class="text-gray-500">Receipt No: #<%= payment.id %>
                  </p>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6 text-sm">
                  <div>
                    <p class="text-gray-500">Student</p>
                    <p class="font-bold">
                      <%= payment.first_name %>
                        <%= payment.last_name %>
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="text-gray-500">Date</p>
                    <p class="font-bold">
                      <%= new Date(payment.created_at).toLocaleDateString() %>
                    </p>
                  </div>
                  <div>
                    <p class="text-gray-500">Class</p>
                    <p class="font-bold">
                      <%= payment.class_name || 'N/A' %>
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="text-gray-500">Payment Mode</p>
                    <p class="font-bold capitalize">
                      <%= payment.payment_mode %>
                    </p>
                  </div>
                </div>

                <table class="w-full text-sm mb-6">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-4 py-2 text-left">Fee Name</th>
                      <th class="px-4 py-2 text-right">Amount</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% feeItems.forEach(item=> { %>
                      <tr class="border-b">
                        <td class="px-4 py-2">
                          <%= item.fee_name %>
                        </td>
                        <td class="px-4 py-2 text-right">₹<%= item.amount %>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>
                  <tfoot class="font-bold">
                    <tr>
                      <td class="px-4 py-2">Total</td>
                      <td class="px-4 py-2 text-right">₹<%= payment.amount %>
                      </td>
                    </tr>
                    <% if (payment.discount> 0) { %>
                      <tr>
                        <td class="px-4 py-2 text-green-600">Discount</td>
                        <td class="px-4 py-2 text-right text-green-600">-₹<%= payment.discount %>
                        </td>
                      </tr>
                      <tr>
                        <td class="px-4 py-2">Net Amount</td>
                        <td class="px-4 py-2 text-right">₹<%= payment.amount - payment.discount %>
                        </td>
                      </tr>
                      <% } %>
                  </tfoot>
                </table>

                <div class="text-center mt-8">
                  <p class="text-sm text-gray-500">Thank you for your payment!</p>
                  <p class="text-xs text-gray-400 mt-2">This is a computer generated receipt.</p>
                </div>

                <div class="flex justify-center gap-4 mt-6">
                  <button onclick="window.print()" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700"><i
                      class="fas fa-print mr-2"></i>Print</button>
                  <a href="/schooladmin/fees/pending" class="px-6 py-2 border rounded hover:bg-gray-50">Back</a>
                </div>
              </div>
            </div>
          </div>
          <%- include('../../partials/footer') %>
      </div>
  </div>