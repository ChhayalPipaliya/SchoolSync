<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { active: 'fees', user: user }) %>

    <div class="main-panel">
        <%- include('../../partials/header') %>

        <div class="content">
            <!-- Page Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Add Fee</h2>
                    <p class="text-xs text-gray-500 mt-1">
                        <a href="/schooladmin/fees" style="color: var(--primary); text-decoration: none;">Fees</a> &rarr; Add New
                    </p>
                </div>
                <div>
                    <a href="/schooladmin/fees" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>

            <!-- Flash Messages -->
            <%- include('../../partials/flashMessages') %>

            <div class="max-w-xl">
                <div class="card p-6">
                    <form action="/schooladmin/fees/add" method="POST" class="space-y-4">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <h3 class="text-sm font-bold uppercase tracking-wider mb-4 pb-2 border-b border-slate-100" style="color: var(--primary);">
                            <i class="fa-solid fa-indian-rupee-sign me-2"></i>Fee Details
                        </h3>
                        <div class="form-group mb-0">
                            <label class="form-label">Student *</label>
                            <select name="student_id" required class="form-select">
                                <option value="">-- Select Student --</option>
                                <% students.forEach(function(s) { %>
                                    <option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %> (<%= s.className || 'No Class' %>)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label">Amount (₹) *</label>
                            <input type="number" name="amount" required min="0" class="form-input" placeholder="e.g. 5000">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label">Due Date *</label>
                            <input type="date" name="due_date" required class="form-input">
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="form-group mb-0">
                                <label class="form-label">Discount (₹)</label>
                                <input type="number" name="discount" min="0" value="0" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label">Late Fee (₹)</label>
                                <input type="number" name="late_fee" min="0" value="0" class="form-input">
                            </div>
                        </div>
                        <div class="flex gap-2 pt-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-plus me-1"></i> Add Fee
                            </button>
                            <a href="/schooladmin/fees" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
