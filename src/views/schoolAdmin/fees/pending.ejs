<%- include('../../partials/head', { title: `${lan.Pending_Fees || 'Pending Fees'} | SchoolSync` }) %>
<style>
    @media (max-width: 768px) {
        .pending-fees-banner {
            margin: 12px 10px 12px !important;
            padding: 16px 14px !important;
            border-radius: 12px !important;
        }
        .pending-fees-banner h1 {
            font-size: 20px !important;
        }
        .pending-fees-actions {
            width: 100% !important;
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 8px !important;
        }
        .pending-fees-actions a.btn {
            width: 100% !important;
            justify-content: center !important;
            padding: 8px !important;
            font-size: 11.5px !important;
        }
        .pending-fees-body {
            padding: 0 10px 16px !important;
        }
        .pending-filter-wrap {
            width: 100% !important;
        }
        .pending-table-wrapper {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
        }
        .pending-table-wrapper table {
            min-width: 720px !important;
        }
        .pending-table-wrapper th,
        .pending-table-wrapper td {
            padding: 10px 12px !important;
            font-size: 12px !important;
            white-space: nowrap !important;
        }
    }

    /* Dark Mode */
    [data-theme="dark"] .pending-fees-banner,
    .light-mode-disabled .pending-fees-banner {
        background: linear-gradient(135deg, #064E3B, #022C22) !important;
        box-shadow: 0 4px 14px rgba(0,0,0,0.3) !important;
    }
    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .card select,
    .light-mode-disabled .card select {
        background: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .table thead tr,
    .light-mode-disabled .table thead tr {
        background: #101726 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table thead th,
    .light-mode-disabled .table thead th {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .table tbody tr,
    .light-mode-disabled .table tbody tr {
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table tbody td,
    .light-mode-disabled .table tbody td {
        color: #E2E8F0 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { active: 'fees', user: user }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Pending_Fees || 'Pending Fees' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Pending_Fees_Desc || 'Monitor and follow up on outstanding fee payments and student balances' %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;" class="pending-fees-actions">
                        <a href="/schooladmin/fees/structures" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-gears"></i> <%- lan.Configure_Rates || 'Configure Rates' %>
                        </a>
                        <a href="/schooladmin/fees/collect" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fa-solid fa-plus"></i> <%- lan.Collect_Fee || 'Collect Fee' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card" style="padding:12px 16px; margin-bottom:12px; border-radius:10px; border:1px solid #E2E8F0;">
                <form method="GET" style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin:0;">
                    <div class="pending-filter-wrap" style="width:240px;">
                        <label style="display:block; font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px;"><%- lan.Filter_By_Class || 'Filter by Class' %></label>
                        <select name="class_id" class="form-select" style="width:100%; min-height:34px; font-size:11px; border-radius:6px;" onchange="this.form.submit()">
                            <option value=""><%- lan.All_Classes || 'All Classes' %></option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>" <%= class_id == c.id ? 'selected' : '' %>><%= c.class_name %> (<%= c.section %>)</option>
                            <% }) %>
                        </select>
                    </div>
                </form>
            </div>
            <div class="card" style="padding: 0; overflow: hidden; border-radius: 12px; margin-bottom: 0;">
                <div style="padding:16px; border-bottom:1px solid #E2E8F0; background:#F8FAFC;">
                    <h3 style="font-size:14px; font-weight:700; color:#0F172A; margin:0; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Unpaid_Dues_List || 'Unpaid Dues List' %></h3>
                </div>
                <div class="pending-table-wrapper" style="overflow-x:auto;">
                    <table class="table" style="min-width:720px; width:100%; border-collapse:collapse; margin:0;">
                        <thead>
                            <tr style="border-bottom:1px solid #E2E8F0; text-align:left; background:#F8FAFC;">
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Student || 'Student' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Class || 'Class' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em;"><%- lan.Fee_Item || 'Fee Item' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; text-align:center;"><%- lan.Amount || 'Amount' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; text-align:center;"><%- lan.Due_Date || 'Due Date' %></th>
                                <th style="padding:14px 16px; font-size:11px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; text-align:center;"><%- lan.Actions || 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!pendingFees || pendingFees.length === 0) { %>
                                <tr>
                                    <td colspan="6" style="padding:40px; text-align:center;">
                                        <div style="font-size:36px; color:#CBD5E1; margin-bottom:12px;"><i class="fa-solid fa-receipt"></i></div>
                                        <h3 style="font-size:16px; font-weight:700; color:#475569; margin:0 0 6px;"><%- lan.No_Pending_Fees_Found || 'No pending fees found' %></h3>
                                        <p style="font-size:13px; color:#94A3B8; margin:0;"><%- lan.All_Dues_Paid_Up_To_Date || 'All student dues are currently paid up to date.' %></p>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% pendingFees.forEach(f => { 
                                    const isOverdue = f.due_date && new Date(f.due_date) < new Date();
                                %>
                                    <tr style="border-bottom:1px solid #F1F5F9;">
                                        <td style="padding:14px 16px;">
                                            <div style="font-weight:600; color:#0F172A; font-size:13px;">
                                                <%= f.first_name %> <%= f.last_name %>
                                            </div>
                                            <div style="font-size:11px; color:#94A3B8; margin-top:2px;"><%- lan.Roll_No || 'Roll No' %>: <%= f.roll_no || '—' %></div>
                                        </td>
                                        <td style="padding:14px 16px; font-size:13px; color:#334155;">
                                            <%= f.class_name %> <%= f.section ? '(' + f.section + ')' : '' %>
                                        </td>
                                        <td style="padding:14px 16px; font-size:13px; color:#334155; font-weight:500;">
                                            <%= f.fee_name || (lan.Annual_Tuition_Fee || 'Annual Tuition Fee') %>
                                            <div style="font-size:11px; color:#94A3B8; margin-top:2px;"><%- lan.AY || 'AY' %> <%= f.academic_year || f.fee_month %></div>
                                        </td>
                                        <td style="padding:14px 16px; text-align:center; font-size:13px; font-weight:700; color:#0F172A;">
                                            <% const remaining = Math.max(0, parseFloat(f.total_amount) - parseFloat(f.paid_amount || 0)); %>
                                            ₹<%= remaining.toLocaleString('en-IN', {minimumFractionDigits: 2}) %>
                                            <% if (parseFloat(f.paid_amount || 0) > 0) { %>
                                                <div style="font-size:10px; color:#94A3B8; font-weight:normal; margin-top:2px;" title="<%- lan.Annual_Fee || 'Annual Fee' %>: ₹<%= parseFloat(f.total_amount).toLocaleString('en-IN', {minimumFractionDigits: 2}) %>">
                                                    <%- lan.Paid || 'Paid' %>: ₹<%= parseFloat(f.paid_amount).toLocaleString('en-IN', {minimumFractionDigits: 2}) %>
                                                </div>
                                            <% } %>
                                        </td>
                                        <td style="padding:14px 16px; text-align:center;">
                                            <% if (isOverdue) { %>
                                                <span class="badge" style="background:rgba(239, 68, 68, 0.15); color:#EF4444; padding:4px 10px; border-radius:9999px; font-size:11px; font-weight:700;" title="<%- lan.Overdue || 'Overdue' %>">
                                                    <%= f.due_date ? new Date(f.due_date).toLocaleDateString('en-GB') : '—' %>
                                                </span>
                                            <% } else { %>
                                                <span style="font-size:12px; color:#64748B;">
                                                    <%= f.due_date ? new Date(f.due_date).toLocaleDateString('en-GB') : '—' %>
                                                </span>
                                            <% } %>
                                        </td>
                                        <td style="padding:14px 16px; text-align:center;">
                                            <div style="display:flex; justify-content:center;">
                                                <a href="/schooladmin/fees/collect?student_id=<%= f.student_id %>" class="btn btn-primary" style="padding:6px 12px; font-size:12px; font-weight:600; text-decoration:none; height:32px; display:inline-flex; align-items:center; justify-content:center;">
                                                    <%- lan.Collect_Dues || 'Collect Dues' %>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>