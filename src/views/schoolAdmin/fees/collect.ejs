                                    </div>
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-800 leading-tight mb-0.5"><%- lan.Auto_Receipt_Generation || 'Instant Official PDF Receipts' %></h4>
                                        <p class="text-[11px] text-slate-500 mb-0 leading-normal"><%- lan.Auto_Receipt_Desc || 'Sequential receipt numbers with official school header and print format.' %></p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3">
                                    <div class="w-7 h-7 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-xs font-bold flex-shrink-0" style="width: 28px; height: 28px; border-radius: 50%; background: #dbeafe; color: #1d4ed8; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-qrcode"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-800 leading-tight mb-0.5"><%- lan.UPI_QR_And_Online || 'UPI QR & Online Payments' %></h4>
                                        <p class="text-[11px] text-slate-500 mb-0 leading-normal"><%- lan.UPI_QR_Desc || 'Collect using dynamic UPI QR code, school QR or Razorpay checkout.' %></p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3">
                                    <div class="w-7 h-7 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center text-xs font-bold flex-shrink-0" style="width: 28px; height: 28px; border-radius: 50%; background: #f3e8ff; color: #7e22ce; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa-solid fa-sliders"></i>
                                    </div>
                                    <div>
                                        <h4 class="text-xs font-bold text-slate-800 leading-tight mb-0.5"><%- lan.Flexible_Partial_Payment || 'Partial & Multi-Head Collection' %></h4>
                                        <p class="text-[11px] text-slate-500 mb-0 leading-normal"><%- lan.Flexible_Payment_Desc || 'Supports partial payment, multi-fee selection, and balance carry-over.' %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
    <%- include('../../partials/footer') %>
</div>
<%- include('../../partials/razorpay-checkout') %>
<script>
    function filterStudents() {
        const classFilter = document.getElementById('classFilterSelect');
        const searchInput = document.getElementById('studentSearchInput');
        const studentSelect = document.getElementById('studentSelect');
        if (!studentSelect) return;

        const classVal = classFilter ? classFilter.value.toLowerCase().trim() : '';
        const searchVal = searchInput ? searchInput.value.toLowerCase().trim() : '';

        let visibleCount = 0;
        const options = studentSelect.options;
        for (let i = 1; i < options.length; i++) {
            const opt = options[i];
            const optClass = (opt.getAttribute('data-class') || '').toLowerCase().trim();
            const optSearch = (opt.getAttribute('data-search') || opt.textContent || '').toLowerCase();

            const matchClass = !classVal || optClass === classVal;
            const matchSearch = !searchVal || optSearch.includes(searchVal);

            if (matchClass && matchSearch) {
                opt.hidden = false;
                opt.disabled = false;
                opt.style.display = '';
                visibleCount++;
            } else {
                opt.hidden = true;
                opt.disabled = true;
                opt.style.display = 'none';
            }
        }

        const countBadge = document.getElementById('filteredStudentCount');
        if (countBadge) {
            countBadge.textContent = `${visibleCount} <%- lan.Students || 'students' %>`;
        }
    }

    function onStudentSelected() {
        const select = document.getElementById('studentSelect');
        const preview = document.getElementById('studentPreviewCard');
        const proceedBtn = document.getElementById('proceedCollectBtn');
        if (!select || !preview) return;

        const opt = select.options[select.selectedIndex];
        if (opt && opt.value) {
            const nameEl = document.getElementById('previewStudentName');
            const classEl = document.getElementById('previewStudentClass');
            const rollEl = document.getElementById('previewStudentRoll');
            const admnEl = document.getElementById('previewStudentAdmn');
            const photoEl = document.getElementById('previewStudentPhoto');

            if (nameEl) nameEl.textContent = opt.getAttribute('data-name') || '';
            if (classEl) classEl.textContent = opt.getAttribute('data-class-display') || '';
            if (rollEl) rollEl.textContent = opt.getAttribute('data-roll') ? `<%- lan.Roll || 'Roll' %>: ${opt.getAttribute('data-roll')}` : '';
            if (admnEl) admnEl.textContent = opt.getAttribute('data-admn') ? `<%- lan.Admn || 'Admn' %>: ${opt.getAttribute('data-admn')}` : '';
            if (photoEl) photoEl.src = opt.getAttribute('data-photo') || '/images/default-avatar.png';

            preview.style.display = 'flex';
            if (proceedBtn) {
                proceedBtn.disabled = false;
                proceedBtn.style.opacity = '1';
                proceedBtn.style.cursor = 'pointer';
            }
        } else {
            preview.style.display = 'none';
            if (proceedBtn) {
                proceedBtn.disabled = true;
                proceedBtn.style.opacity = '0.6';
                proceedBtn.style.cursor = 'not-allowed';
            }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (document.getElementById('studentSelect')) {
            onStudentSelected();
        }
    });

    function handlePaymentModeChange(mode) {
        const chequeBox = document.getElementById('chequeFields');
        const bankBox = document.getElementById('bankTransferFields');
        const upiBox = document.getElementById('upiFields');
        const cardBox = document.getElementById('cardFields');
        const onlineBox = document.getElementById('onlineFields');

        if (chequeBox) chequeBox.style.display = (mode === 'cheque') ? 'block' : 'none';
        if (bankBox) bankBox.style.display = (mode === 'bank_transfer' || mode === 'net_banking') ? 'block' : 'none';
        if (upiBox) upiBox.style.display = (mode === 'upi' || mode === 'school_upi_qr') ? 'block' : 'none';
        if (cardBox) cardBox.style.display = (mode === 'card') ? 'block' : 'none';
        if (onlineBox) onlineBox.style.display = (mode === 'online') ? 'block' : 'none';
    };

    function calculateTotal() {
        const checkboxes = document.querySelectorAll('input[name="fee_ids"]');
        let total = 0;
        checkboxes.forEach(cb => {
            const flexContainer = cb.closest('.flex-1');
            if (!flexContainer) return;
            const rowContainer = flexContainer.nextElementSibling;
            if (!rowContainer) return;
            const input = rowContainer.querySelector('.paying-amount-input');
            if (!input) return;

            if (cb.checked) {
                input.disabled = false;
                total += parseFloat(input.value || 0);
            } else {
                input.disabled = true;
            };
        });
        document.getElementById('totalAmount').textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        const qrAmountEl = document.getElementById('qrAmountDisplay');
        if (qrAmountEl) {
            qrAmountEl.textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        }
    };

    function switchTab(event, tabId) {
        switchTabDirect(tabId);
    };

    function switchTabDirect(tabId) {
        const targetTab = document.getElementById('tab-' + tabId);
        if (!targetTab) return;

        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

        const matchingBtn = document.querySelector(`.tab-btn[onclick*="'${tabId}'"]`);
        if (matchingBtn) matchingBtn.classList.add('active');

        targetTab.classList.add('active');
        const activeInput = document.getElementById('activeTabInput');
        if (activeInput) activeInput.value = tabId;

        sessionStorage.setItem('collectFeeActiveTab', tabId);
        try {
            history.replaceState(null, null, '#' + tabId);
        } catch (e) {}

        if (tabId !== 'qr') {
            stopQrPolling();
        };
    };

    document.addEventListener('DOMContentLoaded', () => {
        const hashTab = window.location.hash ? window.location.hash.replace('#', '') : null;
        const savedTab = hashTab || sessionStorage.getItem('collectFeeActiveTab');
        if (savedTab && document.getElementById('tab-' + savedTab)) {
            switchTabDirect(savedTab);
        }
    });

    let qrPollInterval = null;

    function stopQrPolling() {
        if (qrPollInterval) {
            clearInterval(qrPollInterval);
            qrPollInterval = null;
        };
    };

    function getSelectedFeeIds() {
        return Array.from(document.querySelectorAll('input[name="fee_ids"]:checked')).map(cb => cb.value);
    };

    function getSelectedPayingAmounts() {
        const amounts = {};
        document.querySelectorAll('input[name="fee_ids"]:checked').forEach(cb => {
            const flexContainer = cb.closest('.flex-1');
            if (!flexContainer) return;
            const rowContainer = flexContainer.nextElementSibling;
            if (!rowContainer) return;
            const input = rowContainer.querySelector('.paying-amount-input');
            if (!input) return;
            const parsedAmount = parseFloat(input.value || 0);
            if (Number.isFinite(parsedAmount) && parsedAmount > 0) {
                amounts[cb.value] = parsedAmount;
            };
        });
        return amounts;
    };

    async function startRazorpayPayment() {
        const feeIds = getSelectedFeeIds();
        if (feeIds.length === 0) {
            alert('<%- lan.Select_At_Least_One_Fee_Item || "Please select at least one fee item" %>');
            return;
        };

        const amounts = getSelectedPayingAmounts();
        const remarks = document.getElementById('feeRemarks').value;
        const discount = document.getElementById('feeDiscount')?.value || 0;

        try {
            const res = await fetch('/schooladmin/fees/razorpay/order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    student_id: '<%= student ? student.id : "" %>',
                    fee_ids: feeIds,
                    paying_amount: amounts,
                    discount: discount,
                    remarks: remarks
                })
            });

            const data = await res.json();
            if (!data.success) {
                alert(data.message || 'Error initializing payment gateway');
                return;
            };

            const orderInfo = data.data || data;
            const checkoutData = {
                key_id: orderInfo.key_id,
                amount: orderInfo.amount,
                currency: orderInfo.currency || 'INR',
                order_id: orderInfo.order_id,
                payment_id: orderInfo.payment_id,
                prefill: {
                    name: '<%= student ? (student.first_name + " " + (student.last_name || "")) : "" %>',
                    email: '<%= student && student.email ? student.email : "" %>'
                }
            };

            if (typeof window.openRazorpayCheckout === 'function') {
                window.openRazorpayCheckout(
                    checkoutData,
                    function (result) {
                        const receiptId = result?.receiptId || checkoutData.payment_id;
                        window.location.href = `/schooladmin/fees/receipt/${receiptId}`;
                    },
                    function (errorMsg) {
                        alert(errorMsg || 'Payment failed or cancelled');
                    }
                );
            } else {
                const options = {
                    key: checkoutData.key_id,
                    amount: checkoutData.amount,
                    currency: checkoutData.currency,
                    name: '<%= (typeof activeSchool !== "undefined" && activeSchool && activeSchool.name) ? activeSchool.name : "SchoolSync" %>',
                    description: 'School Fee Payment',
                    order_id: checkoutData.order_id,
                    handler: async function (response) {
                        try {
                            const verifyRes = await fetch('/api/fees/razorpay/verify', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_signature: response.razorpay_signature,
                                    payment_id: checkoutData.payment_id,
                                    localPaymentId: checkoutData.payment_id
                                })
                            });

                            const verifyData = await verifyRes.json();
                            if (verifyData.success) {
                                window.location.href = `/schooladmin/fees/receipt/${verifyData.data?.receiptId || checkoutData.payment_id}`;
                            } else {
                                alert(verifyData.message || 'Payment verification failed');
                            };
                        } catch (err) {
                            alert('Network error verifying payment');
                        };
                    },
                    prefill: checkoutData.prefill,
                    theme: {
                        color: '#059669'
                    }
                };

                const rzp = new Razorpay(options);
                rzp.open();
            };
        } catch (err) {
            console.error('Payment gateway error:', err);
            alert('Failed to connect to payment server: ' + (err.message || 'Network error'));
        };
    };

    async function startUPIDirectPayment() {
        const upiId = document.getElementById('upiIdInput').value;
        if (!upiId) {
            alert('Please enter a valid UPI ID (VPA)');
            return;
        };

        const feeIds = getSelectedFeeIds();
        if (feeIds.length === 0) {
            alert('<%- lan.Select_At_Least_One_Fee_Item || "Please select at least one fee item" %>');
            return;
        };

        const amounts = getSelectedPayingAmounts();
        const remarks = document.getElementById('feeRemarks').value;
        const discount = document.getElementById('feeDiscount')?.value || 0;
        try {
            const res = await fetch('/schooladmin/fees/upi/create-request', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    student_id: '<%= student ? student.id : "" %>',
                    fee_ids: feeIds,
                    paying_amount: amounts,
                    discount: discount,
                    upi_id: upiId.trim(),
                    remarks: remarks
                })
            });

            const data = await res.json();
            if (!data.success) {
                alert(data.message || 'Error sending UPI request');
                return;
            };

            if (data.data?.order_id && typeof window.openRazorpayCheckout === 'function') {
                const checkoutData = {
                    key_id: data.data.key_id,
                    amount: data.data.amount,
                    currency: data.data.currency || 'INR',
                    order_id: data.data.order_id,
                    payment_id: data.data.payment_id,
                    prefill: {
                        name: '<%= student ? (student.first_name + " " + (student.last_name || "")) : "" %>',
                        email: '<%= student && student.email ? student.email : "" %>',
                        vpa: data.data.upi_id,
                        method: 'upi'
                    }
                };
                window.openRazorpayCheckout(
                    checkoutData,
                    function (result) {
                        const receiptId = result?.receiptId || checkoutData.payment_id;
                        window.location.href = `/schooladmin/fees/receipt/${receiptId}`;
                    },
                    function (errorMsg) {
                        alert(data.message + '\n\nNote: ' + (errorMsg || 'Checkout closed. UPI collect request remains active.'));
                    }
                );
            } else {
                alert(data.message || 'UPI payment collect request initiated successfully');
            };
        } catch (err) {
            console.error(err);
            alert('Network error sending UPI payment request');
        };
    };

    async function generateQR() {
        const feeIds = getSelectedFeeIds();
        if (feeIds.length === 0) {
            alert('<%- lan.Select_At_Least_One_Fee_Item || "Please select at least one fee item" %>');
            return;
        };

        const amounts = getSelectedPayingAmounts();
        const remarks = document.getElementById('feeRemarks').value;
        const discount = document.getElementById('feeDiscount')?.value || 0;

        try {
            const orderRes = await fetch('/schooladmin/fees/razorpay/order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    student_id: '<%= student ? student.id : "" %>',
                    fee_ids: feeIds,
                    paying_amount: amounts,
                    discount: discount,
                    remarks: remarks
                })
            });

            const orderData = await orderRes.json();
            if (!orderData.success) {
                alert(orderData.message || 'Error initializing payment order for QR');
                return;
            };

            const paymentId = orderData.data?.payment_id;
            const orderId = orderData.data?.order_id;
            const qrRes = await fetch(`/schooladmin/fees/razorpay/qr/${paymentId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            const qrData = await qrRes.json();
            const fallbackQrUrl = '<%= (typeof schoolInfo !== "undefined" && schoolInfo && schoolInfo.upi_qr_image) ? (schoolInfo.upi_qr_image.startsWith("/") ? schoolInfo.upi_qr_image : "/" + schoolInfo.upi_qr_image) : "" %>';
            const qrImage = (qrData && qrData.data?.image_url) ? qrData.data.image_url : fallbackQrUrl;

            if (qrImage) {
                document.getElementById('qrPlaceholder').style.display = 'none';
                const qrDisplay = document.getElementById('qrDisplay');
                qrDisplay.style.display = 'flex';
                document.getElementById('qrCodeImg').src = qrImage;

                const schoolName = (qrData && qrData.data && qrData.data.school_name) || '<%= (typeof schoolInfo !== "undefined" && schoolInfo && schoolInfo.school_name) ? schoolInfo.school_name : "" %>';
                if (schoolName) {
                    document.getElementById('qrSchoolName').textContent = schoolName;
                };
                const totalAmount = (qrData && qrData.data && qrData.data.amount) ? parseFloat(qrData.data.amount) : parseFloat((document.getElementById('totalAmount')?.textContent || '').replace(/[^0-9.]/g, '') || 0);
                if (totalAmount) {
                    document.getElementById('qrAmountDisplay').textContent = totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2 });
                };
                const upiId = (qrData && qrData.data && qrData.data.upi_id) || '<%= (typeof schoolInfo !== "undefined" && schoolInfo && schoolInfo.upi_id) ? schoolInfo.upi_id : "" %>';
                if (upiId) {
                    document.getElementById('qrUpiIdDisplay').textContent = upiId;
                    document.getElementById('qrUpiIdContainer').style.display = 'block';
                };

                if (orderId || qrData.data?.order_id) {
                    startQrPolling(orderId || qrData.data?.order_id, paymentId);
                };
            } else {
                alert((qrData && qrData.message) || 'Error generating payment QR Code');
            };
        } catch (err) {
            console.error('QR creation error:', err);
            alert(err.message || 'Network error creating QR Code');
        };
    };

    function confirmQrPaymentDirect() {
        const utr = (document.getElementById('qrDirectUtr')?.value || '').trim();
        const modeSelect = document.getElementById('manualPaymentMode');
        if (modeSelect) modeSelect.value = 'school_upi_qr';
        const form = document.getElementById('collectFeeForm') || document.querySelector('form[action="/schooladmin/fees/collect"]');
        if (form) {
            let refInput = form.querySelector('input[name="reference_no"]');
            if (!refInput) {
                refInput = document.createElement('input');
                refInput.type = 'hidden';
                refInput.name = 'reference_no';
                form.appendChild(refInput);
            };
            refInput.value = utr || ('UPI-COLLECT-' + Date.now());

            let utrInput = form.querySelector('input[name="utr_no"]');
            if (!utrInput) {
                utrInput = document.createElement('input');
                utrInput.type = 'hidden';
                utrInput.name = 'utr_no';
                form.appendChild(utrInput);
            };
            utrInput.value = utr || ('UPI-COLLECT-' + Date.now());

            form.submit();
        };
    };

    document.getElementById('collectFeeForm')?.addEventListener('submit', function(e) {
        const checked = this.querySelectorAll('input[name="fee_ids"]:checked');
        if (checked.length === 0) {
            e.preventDefault();
            alert('<%- lan.Select_At_Least_One_Fee_Item || "Please select at least one fee item to collect." %>');
            return false;
        }
    });

    function startQrPolling(orderId, fallbackPaymentId) {
        stopQrPolling();
        qrPollInterval = setInterval(async () => {
            try {
                const res = await fetch(`/api/fees/razorpay/payment-status/${orderId}`);
                const data = await res.json();
                if (data.success && (data.data?.status === 'completed' || data.data?.status === 'paid')) {
                    stopQrPolling();
                    document.getElementById('qrStatusText').textContent = '<%- lan.Payment_Received_Redirecting || "Payment received! Redirecting..." %>';
                    setTimeout(() => {
                        window.location.href = `/schooladmin/fees/receipt/${data.data?.paymentId || fallbackPaymentId}`;
                    }, 1000);
                };
            } catch (err) { }
        }, 3000);
    };
</script>