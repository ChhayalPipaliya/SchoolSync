<style>
    .payment-tabs {
        display: flex;
        gap: 0.5rem;
        border-bottom: 2px solid #e2e8f0;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        white-space: nowrap;
    }

    .tab-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: #64748b;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: all 0.2s ease-in-out;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .tab-btn:hover {
        color: var(--primary, #059669);
    }

    .tab-btn.active {
        color: var(--primary, #059669);
        border-bottom: 2px solid var(--primary, #059669);
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .qr-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: #f8fafc;
        border-radius: 12px;
        border: 2px dashed #e2e8f0;
    }

    .pulse-loader {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: var(--primary, #059669);
        animation: pulse 1.5s infinite ease-in-out;
    }

    @keyframes pulse {
        0% {
            transform: scale(0.8);
            opacity: 0.5;
        }

        50% {
            transform: scale(1.2);
            opacity: 1;
        }

        100% {
            transform: scale(0.8);
            opacity: 0.5;
        }
    }

    @media (max-width: 768px) {
        .schooladmin-theme .content {
            padding: 12px 10px !important;
        }

        .collect-fee-header {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 12px !important;
        }

        .collect-fee-header a.btn {
            width: 100% !important;
            justify-content: center !important;
        }

        .payment-tabs {
            display: grid !important;
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 4px !important;
            border-bottom: none !important;
        }

        .tab-btn {
            padding: 8px 6px !important;
            font-size: 11.5px !important;
            text-align: center !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 8px !important;
            margin-bottom: 0 !important;
        }

        .tab-btn.active {
            background: #ecfdf5 !important;
            color: #059669 !important;
            border-color: #059669 !important;
        }
    }

    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .qr-container,
    .light-mode-disabled .qr-container {
        background: #101726 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .tab-btn,
    .light-mode-disabled .tab-btn {
        color: #94A3B8 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .tab-btn.active,
    .light-mode-disabled .tab-btn.active {
        background: rgba(5, 150, 105, 0.15) !important;
        color: #34D399 !important;
        border-color: #059669 !important;
    }

    [data-theme="dark"] .bg-slate-50,
    .light-mode-disabled .bg-slate-50 {
        background: #101726 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .text-gray-800,
    .light-mode-disabled .text-gray-800 {
        color: #F1F5F9 !important;
    }
</style>
<%- include('../../partials/head', { title: `${lan.Collect_Fee || 'Collect Fee' } | SchoolSync` }) %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { active: 'fees' , user: user }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content" style="padding: 14px 20px;">
                        <div class="card"
                            style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <div
                                        style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                                        <i class="fa-solid fa-hand-holding-dollar"></i>
                                    </div>
                                    <div>
                                        <h1
                                            style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;">
                                            <%- lan.Collect_Fee || 'Collect Fee' %></h1>
                                        <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%-
                                                lan.Collect_Fee_Desc || 'Record and collect fee payments from students'
                                                %></p>
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                                    <a href="/schooladmin/fees/pending" class="btn"
                                        style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                                        <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Pending
                                            || 'Back to Pending' %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% if (student) { %>
                            <div class="card p-6 mb-3">
                                <div class="flex items-center gap-4">
                                    <% let displayPhoto='/images/default-avatar.png' ; if (student.photo) {
                                        displayPhoto=student.photo.startsWith('/uploads/') ? student.photo
                                        : '/uploads/students/' + student.photo; } %>
                                        <img src="<%= displayPhoto %>"
                                            class="w-16 h-16 rounded-full bg-gray-100 object-cover border border-slate-100 shadow-sm"
                                            style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover;">
                                        <div>
                                            <h3 class="text-lg font-bold text-gray-800">
                                                <%= student.first_name %>
                                                    <%= student.last_name %>
                                            </h3>
                                            <p class="text-xs text-gray-500 mt-0.5">
                                                <%= student.class_name %>
                                                    <%= student.section || '' %> | <%- lan.Roll_No || 'Roll No' %>: <%=
                                                                student.roll_no || '—' %>
                                            </p>
                                        </div>
                                </div>
                            </div>
                            <% if (pendingFees && pendingFees.length> 0) { %>
                                <form method="POST" action="/schooladmin/fees/collect" class="card p-6">
                                    <input type="hidden" name="_csrf"
                                        value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <input type="hidden" name="student_id" value="<%= student.id %>">
                                    <h3 class="font-bold text-gray-700 text-sm mb-4 pb-2 border-b border-slate-100"
                                        style="color: var(--primary);"><%- lan.Pending_Fees || 'Pending Fees' %></h3>
                                    <div class="space-y-3 mb-3">
                                        <% let total=0; %>
                                            <% pendingFees.forEach(f=> {
                                                const remaining = parseFloat(f.total_amount) - parseFloat(f.paid_amount
                                                || 0);
                                                total += remaining;
                                                %>
                                                <div
                                                    class="flex items-center justify-between p-3.5 bg-slate-50 border border-slate-100 rounded-lg gap-4">
                                                    <div class="flex items-center gap-3 flex-1">
                                                        <input type="checkbox" name="fee_ids" value="<%= f.id %>"
                                                            class="w-4 h-4 rounded fee-checkbox-item"
                                                            style="color: var(--primary);" checked
                                                            onchange="calculateTotal()">
                                                        <div>
                                                            <p class="font-bold text-gray-800 text-xs">
                                                                <%= f.fee_name || (lan.Annual_Tuition_Fee
                                                                    || 'Annual Tuition Fee' ) %> (<%= f.academic_year ||
                                                                        f.fee_month || (lan.Annual || 'Annual' ) %>)
                                                            </p>
                                                            <p class="text-[10px] text-gray-400 mt-0.5">
                                                                <%- lan.Annual_Demanded || 'Annual Demanded' %>: ₹<%=
                                                                        parseFloat(f.total_amount).toLocaleString('en-IN',
                                                                        {minimumFractionDigits: 2}) %>
                                                                        <% if (parseFloat(f.paid_amount || 0)> 0) { %>
                                                                            · <%- lan.Paid || 'Paid' %>: ₹<%=
                                                                                    parseFloat(f.paid_amount).toLocaleString('en-IN',
                                                                                    {minimumFractionDigits: 2}) %>
                                                                                    <% } %>
                                                                                        · <%- lan.Remaining_Balance
                                                                                            || 'Remaining Balance' %>: ₹
                                                                                            <%= remaining.toLocaleString('en-IN',
                                                                                                {minimumFractionDigits:
                                                                                                2}) %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-xs text-gray-400 font-semibold"><%- lan.Paying
                                                                || 'Paying' %>: ₹</span>
                                                        <input type="number" name="paying_amount[<%= f.id %>]"
                                                            class="form-input paying-amount-input text-right font-bold text-gray-700"
                                                            style="width: 110px; padding: 4px 8px; font-size: 13px;"
                                                            min="0.01" max="<%= remaining %>" step="0.01"
                                                            value="<%= remaining %>" oninput="calculateTotal()">
                                                    </div>
                                                </div>
                                                <% }) %>
                                    </div>
                                    <div class="border-t border-slate-100 pt-6 space-y-6">
                                        <div class="flex justify-between text-lg font-bold">
                                            <span class="text-gray-800"><%- lan.Total_Amount || 'Total Amount'
                                                    %>:</span>
                                            <span id="totalAmount" style="color: var(--primary);">₹<%=
                                                    parseFloat(total).toLocaleString('en-IN', {minimumFractionDigits:
                                                    2}) %></span>
                                        </div>
                                        <input type="hidden" id="feeDiscount" name="discount" value="0">
                                        <div class="form-group mb-0">
                                            <label
                                                class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%-
                                                    lan.Remarks || 'Remarks' %></label>
                                            <input type="text" id="feeRemarks" name="remarks" class="form-input"
                                                placeholder="<%- lan.Eg_Paid_In_Full || 'e.g. Paid in full' %>">
                                        </div>
                                        <div class="payment-tabs flex gap-2 border-b border-slate-200 mb-4 mt-6">
                                            <button type="button" class="tab-btn active"
                                                onclick="switchTab(event, 'manual')">
                                                <i class="fas fa-hand-holding-usd mr-1"></i> <%- lan.Manual || 'Manual'
                                                    %>
                                            </button>
                                            <button type="button" class="tab-btn"
                                                onclick="switchTab(event, 'razorpay')">
                                                <i class="fas fa-credit-card mr-1"></i> <%- lan.Card_Netbanking
                                                    || 'Card / Netbanking' %>
                                            </button>
                                            <button type="button" class="tab-btn" onclick="switchTab(event, 'upi')">
                                                <i class="fab fa-google-pay mr-1"></i> <%- lan.UPI_Direct
                                                    || 'UPI Direct' %>
                                            </button>
                                            <button type="button" class="tab-btn" onclick="switchTab(event, 'qr')">
                                                <i class="fas fa-qrcode mr-1"></i> <%- lan.QR_Code || 'QR Code' %>
                                            </button>
                                        </div>
                                        <input type="hidden" id="activeTabInput" name="active_tab" value="manual">
                                        <div id="tab-manual" class="tab-content active space-y-4">
                                            <div class="form-group mb-3">
                                                <label
                                                    class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%-
                                                        lan.Payment_Method || 'Payment Method' %> *</label>
                                                <select name="payment_mode" id="manualPaymentMode" class="form-select"
                                                    onchange="handlePaymentModeChange(this.value)">
                                                    <option value="cash" selected><%- lan.Cash || 'Cash' %></option>
                                                    <option value="cheque"><%- lan.Cheque || 'Cheque' %></option>
                                                    <option value="net_banking"><%- lan.Net_Banking || 'Net Banking' %>
                                                    </option>
                                                    <option value="bank_transfer"><%- lan.Bank_Transfer
                                                            || 'Bank Transfer' %> (NEFT / RTGS / IMPS)</option>
                                                    <option value="upi"><%- lan.UPI || 'UPI' %> / VPA</option>
                                                    <option value="school_upi_qr"><%- lan.School_UPI_QR
                                                            || 'School UPI QR' %></option>
                                                    <option value="card"><%- lan.Card || 'Credit / Debit Card (POS)' %>
                                                    </option>
                                                    <option value="online"><%- lan.Online || 'Online (Direct)' %>
                                                    </option>
                                                </select>
                                            </div>
                                            <div id="chequeFields"
                                                class="p-3.5 bg-slate-50 border border-slate-100 rounded-lg space-y-3"
                                                style="display: none;">
                                                <div class="text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                    <%- lan.Cheque_Details || 'Cheque Details' %></div>
                                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.Cheque_Number || 'Cheque Number' %> *</label>
                                                        <input type="text" name="cheque_no" class="form-input text-xs"
                                                            placeholder="<%- lan.Eg_000123 || 'e.g. 000123' %>">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.Bank_Name || 'Bank Name' %> *</label>
                                                        <input type="text" name="bank_name" class="form-input text-xs"
                                                            placeholder="<%- lan.Eg_Bank_Name || 'e.g. HDFC Bank' %>">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.Cheque_Date || 'Cheque Date' %></label>
                                                        <input type="date" name="cheque_date"
                                                            class="form-input text-xs">
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="bankTransferFields"
                                                class="p-3.5 bg-slate-50 border border-slate-100 rounded-lg space-y-3"
                                                style="display: none;">
                                                <div class="text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                    <%- lan.Bank_Transfer_Details
                                                        || 'Bank Transfer / Net Banking Details' %></div>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.Bank_Name || 'Bank Name' %></label>
                                                        <input type="text" name="bank_name" class="form-input text-xs"
                                                            placeholder="<%- lan.Eg_Bank_SBI || 'e.g. State Bank of India' %>">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.UTR_Transaction_Ref || 'UTR / Transaction Ref No' %>
                                                                *</label>
                                                        <input type="text" name="utr_no" class="form-input text-xs"
                                                            placeholder="<%- lan.Eg_UTR || 'e.g. UTR123456789' %>">
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="upiFields"
                                                class="p-3.5 bg-slate-50 border border-slate-100 rounded-lg space-y-3"
                                                style="display: none;">
                                                <div class="text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                    <%- lan.UPI_Transaction_Details || 'UPI / QR Transaction Details' %>
                                                </div>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.UPI_ID_VPA || 'UPI ID / VPA' %></label>
                                                        <input type="text" name="upi_id" class="form-input text-xs"
                                                            placeholder="<%- lan.Eg_UPI_ID || 'e.g. name@okhdfcbank' %>">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.UPI_Reference_UTR || 'UPI Reference / UTR Number' %>
                                                                *</label>
                                                        <input type="text" name="reference_no"
                                                            class="form-input text-xs"
                                                            placeholder="<%- lan.Eg_UPI_Ref || 'e.g. 324567890123' %>">
                                                    </div>
                                                </div>
                                            </div>
                                            <div id="cardFields"
                                                class="p-3.5 bg-slate-50 border border-slate-100 rounded-lg space-y-3"
                                                style="display: none;">
                                                <div class="text-xs font-bold text-slate-700 uppercase tracking-wider">
                                                    <%- lan.Card_POS_Details || 'Card POS Transaction Details' %></div>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.POS_Approval_Code || 'POS / Approval Code'
                                                                %></label>
                                                        <input type="text" name="reference_no"
                                                            class="form-input text-xs"
                                                            placeholder="<%- lan.Eg_POS || 'e.g. POS-88741' %>">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[11px] font-semibold text-slate-500 block mb-1"><%-
                                                                lan.Card_Last_4_Digits || 'Card Last 4 Digits'
                                                                %></label>
                                                        <input type="text" name="transaction_id"
                                                            class="form-input text-xs"
                                                            placeholder="<%- lan.Eg_Card_Last4 || 'e.g. 4321' %>">
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="submit"
                                                class="w-full btn btn-primary py-3 font-bold text-sm tracking-wide bg-emerald-600 hover:bg-emerald-700 text-white">
                                                <i class="fa-solid fa-file-invoice-dollar mr-1"></i> <%-
                                                    lan.Collect_Fee_Generate_Receipt
                                                    || 'Collect Fee & Generate Official Receipt' %>
                                            </button>
                                        </div>
                                        <div id="tab-razorpay" class="tab-content space-y-4">
                                            <div
                                                class="p-4 bg-slate-50 border border-slate-100 rounded-lg text-xs text-gray-500">
                                                <i class="fas fa-info-circle mr-1 text-primary"></i> <%-
                                                    lan.Razorpay_Collect_Desc
                                                    || 'Collect payment online using Razorpay Checkout. Accepts cards, netbanking, wallets, etc.'
                                                    %>
                                                    <div class="mt-2 text-xs font-semibold text-emerald-600"
                                                        style="margin-top: 8px;">
                                                        <%- lan.Razorpay_Test_Mode_Notice
                                                            || 'Test Mode: Use Netbanking for quick testing. Do not use 4242 card. UPI appears only if enabled in Razorpay Dashboard.'
                                                            %>
                                                    </div>
                                            </div>
                                            <button type="button" onclick="startRazorpayPayment()"
                                                class="w-full btn btn-primary py-3 font-bold text-sm tracking-wide"
                                                style="background: #059669; border-color: #059669; color: white;">
                                                <i class="fas fa-external-link-alt mr-1"></i> <%-
                                                    lan.Collect_Payment_Via_Razorpay || 'Collect Payment via Razorpay'
                                                    %>
                                            </button>
                                        </div>
                                        <div id="tab-upi" class="tab-content space-y-4">
                                            <div class="form-group mb-4">
                                                <label
                                                    class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%-
                                                        lan.UPI_ID_VPA || 'UPI ID (VPA)' %></label>
                                                <input type="text" id="upiIdInput" class="form-input"
                                                    placeholder="<%- lan.Eg_UPI_Placeholder || 'e.g. student@okaxis' %>">
                                            </div>
                                            <button type="button" onclick="startUPIDirectPayment()"
                                                class="w-full btn btn-primary py-3 font-bold text-sm tracking-wide"
                                                style="background: #059669; border-color: #059669; color: white;">
                                                <i class="fab fa-google-pay mr-1"></i> <%-
                                                    lan.Request_UPI_Direct_Payment || 'Request UPI Direct Payment' %>
                                            </button>
                                        </div>
                                        <div id="tab-qr" class="tab-content space-y-4">
                                            <div id="qrPlaceholder" class="qr-container text-center">
                                                <i class="fas fa-qrcode text-4xl mb-2 text-slate-400"
                                                    style="font-size: 2.5rem; color: #94a3b8;"></i>
                                                <p class="text-xs text-gray-500 mb-4"><%- lan.QR_Desc
                                                        || 'Generate a dynamic UPI QR Code for instant scanning and auto-verification.'
                                                        %></p>
                                                <button type="button" onclick="generateQR()"
                                                    class="btn btn-primary px-6 py-2 text-xs"><%- lan.Generate_QR_Code
                                                        || 'Generate QR Code' %></button>
                                            </div>
                                            <div id="qrDisplay" class="qr-container"
                                                style="display: none; align-items: center;">
                                                <p class="text-xs text-gray-500 mb-2 font-bold"><%- lan.Scan_To_Pay
                                                        || 'Scan to Pay' %></p>
                                                <img id="qrCodeImg" class="qr-image mb-4" src="" alt="UPI QR Code"
                                                    style="width: 200px; height: 200px; padding: 10px; background: white; border: 1px solid #e2e8f0; border-radius: 8px;">
                                                <div class="flex items-center gap-2 mb-2"
                                                    style="display: flex; align-items: center; gap: 8px;">
                                                    <div class="pulse-loader"></div>
                                                    <span class="text-xs text-gray-500 font-bold" id="qrStatusText"><%-
                                                            lan.Waiting_For_Payment_Confirmation
                                                            || 'Waiting for payment confirmation...' %></span>
                                                </div>
                                                <p class="text-[10px] text-gray-400"><%- lan.Do_Not_Close_Window
                                                        || 'Please do not close this window while the payment is processing.'
                                                        %></p>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                                <% } else { %>
                                    <div class="card p-8 text-center" style="color: var(--success, #059669);">
                                        <i class="fas fa-check-circle text-4xl mb-3"></i>
                                        <h4 class="font-bold text-lg"><%- lan.All_Fees_Paid || 'All fees paid!' %></h4>
                                        <p class="text-xs text-gray-500 mt-1"><%- lan.No_Outstanding_Fees
                                                || 'There are no outstanding fee items for this student.' %></p>
                                    </div>
                                    <% } %>
                                        <% } else { %>
                                            <div class="card p-5">
                                                <div class="text-center mb-3">
                                                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-3"
                                                        style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                                                        <i class="fa-solid fa-graduation-cap"></i>
                                                    </div>
                                                    <h3 class="text-lg font-bold text-gray-800"><%-
                                                            lan.Select_Student_To_Collect
                                                            || 'Select Student to Collect Fee' %></h3>
                                                    <p class="text-xs text-gray-500 mt-1"><%- lan.Search_Student_Desc
                                                            || 'Search active students by name, class, roll number, or admission number.'
                                                            %></p>
                                                </div>
                                                <form method="GET" action="/schooladmin/fees/collect" class="space-y-4">
                                                    <div class="form-group">
                                                        <label
                                                            class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%-
                                                                lan.Search_Student || 'Search Student' %></label>
                                                        <select name="student_id"
                                                            class="form-select select-clean w-full"
                                                            style="padding: 10px;" required>
                                                            <option value=""><%- lan.Select_A_Student
                                                                    || 'Select a student...' %></option>
                                                            <% studentsList.forEach(s=> { %>
                                                                <option value="<%= s.id %>">
                                                                    <%= s.first_name %>
                                                                        <%= s.last_name || '' %> (<%= s.class_name %>-
                                                                                <%= s.section || '' %>) — <%- lan.Roll
                                                                                        || 'Roll' %>: <%= s.roll_no
                                                                                            || '—' %> — <%- lan.Admn
                                                                                                || 'Admn' %>: <%=
                                                                                                    s.admission_no %>
                                                                </option>
                                                                <% }) %>
                                                        </select>
                                                    </div>
                                                    <button type="submit"
                                                        class="btn btn-primary w-full py-3 font-semibold text-sm tracking-wide mt-2">
                                                        <i class="fas fa-search mr-1"></i> <%- lan.Proceed_To_Collection
                                                            || 'Proceed to Collection' %>
                                                    </button>
                                                </form>
                                            </div>
                                            <% } %>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>
    <%- include('../../partials/razorpay-checkout') %>
        <script>
            function handlePaymentModeChange(mode) {
                const chequeBox = document.getElementById('chequeFields');
                const bankBox = document.getElementById('bankTransferFields');
                const upiBox = document.getElementById('upiFields');
                const cardBox = document.getElementById('cardFields');

                if (chequeBox) chequeBox.style.display = (mode === 'cheque') ? 'block' : 'none';
                if (bankBox) bankBox.style.display = (mode === 'bank_transfer' || mode === 'net_banking') ? 'block' : 'none';
                if (upiBox) upiBox.style.display = (mode === 'upi' || mode === 'school_upi_qr') ? 'block' : 'none';
                if (cardBox) cardBox.style.display = (mode === 'card') ? 'block' : 'none';
            };

            function calculateTotal() {
                const checkboxes = document.querySelectorAll('input[name="fee_ids"]');
                let total = 0;
                checkboxes.forEach(cb => {
                    const flexContainer = cb.closest('.flex-1');
                    if (!flexContainer) return;
                    const rowContainer = flexContainer.nextElementSibling;
                    if (!rowContainer) return;
                    const input = rowContainer.querySelector('.paying-amount-input');
                    if (!input) return;

                    if (cb.checked) {
                        input.disabled = false;
                        total += parseFloat(input.value || 0);
                    } else {
                        input.disabled = true;
                    };
                });
                document.getElementById('totalAmount').textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
            };

            function switchTab(event, tabId) {
                document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

                event.currentTarget.classList.add('active');
                document.getElementById('tab-' + tabId).classList.add('active');
                document.getElementById('activeTabInput').value = tabId;

                if (tabId !== 'qr') {
                    stopQrPolling();
                };
            };

            let qrPollInterval = null;

            function stopQrPolling() {
                if (qrPollInterval) {
                    clearInterval(qrPollInterval);
                    qrPollInterval = null;
                };
            };

            function getSelectedFeeIds() {
                return Array.from(document.querySelectorAll('input[name="fee_ids"]:checked')).map(cb => cb.value);
            };

            function getSelectedPayingAmounts() {
                const amounts = {};
                document.querySelectorAll('input[name="fee_ids"]:checked').forEach(cb => {
                    const flexContainer = cb.closest('.flex-1');
                    if (!flexContainer) return;
                    const rowContainer = flexContainer.nextElementSibling;
                    if (!rowContainer) return;
                    const input = rowContainer.querySelector('.paying-amount-input');
                    if (!input) return;
                    const parsedAmount = parseFloat(input.value || 0);
                    if (Number.isFinite(parsedAmount) && parsedAmount > 0) {
                        amounts[cb.value] = parsedAmount;
                    };
                });
                return amounts;
            };

            async function startRazorpayPayment() {
                const feeIds = getSelectedFeeIds();
                if (feeIds.length === 0) {
                    alert('Please select at least one fee item');
                    return;
                }

                const amounts = getSelectedPayingAmounts();
                const remarks = document.getElementById('feeRemarks').value;

                try {
                    const res = await fetch('/schooladmin/fees/razorpay/create-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            student_id: '<%= student ? student.id : "" %>',
                            fee_ids: feeIds,
                            paying_amount: amounts,
                            remarks: remarks
                        })
                    });

                    const data = await res.json();
                    if (!data.success) {
                        alert(data.message || 'Error initializing payment gateway');
                        return;
                    }

                    const options = {
                        key: data.key_id,
                        amount: data.amount,
                        currency: data.currency,
                        name: '<%= (typeof activeSchool !== "undefined" && activeSchool && activeSchool.name) ? activeSchool.name : "SchoolSync" %>',
                        description: 'School Fee Payment',
                        order_id: data.order_id,
                        handler: async function (response) {
                            try {
                                const verifyRes = await fetch('/schooladmin/fees/razorpay/verify', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_signature: response.razorpay_signature,
                                        student_id: '<%= student ? student.id : "" %>',
                                        fee_ids: feeIds,
                                        paying_amount: amounts,
                                        remarks: remarks
                                    })
                                });

                                const verifyData = await verifyRes.json();
                                if (verifyData.success) {
                                    window.location.href = `/schooladmin/fees/receipt/${verifyData.payment_id}`;
                                } else {
                                    alert(verifyData.message || 'Payment verification failed');
                                }
                            } catch (err) {
                                alert('Network error verifying payment');
                            }
                        },
                        prefill: {
                            name: '<%= student ? (student.first_name + " " + (student.last_name || "")) : "" %>',
                            email: '<%= student && student.email ? student.email : "" %>'
                        },
                        theme: {
                            color: '#059669'
                        }
                    };

                    const rzp = new Razorpay(options);
                    rzp.open();
                } catch (err) {
                    alert('Failed to connect to payment server');
                }
            }

            async function startUPIDirectPayment() {
                const upiId = document.getElementById('upiIdInput').value;
                if (!upiId) {
                    alert('Please enter a valid UPI ID (VPA)');
                    return;
                }

                const feeIds = getSelectedFeeIds();
                if (feeIds.length === 0) {
                    alert('Please select at least one fee item');
                    return;
                }

                const amounts = getSelectedPayingAmounts();
                const remarks = document.getElementById('feeRemarks').value;

                try {
                    const res = await fetch('/schooladmin/fees/upi/create-request', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            student_id: '<%= student ? student.id : "" %>',
                            fee_ids: feeIds,
                            paying_amount: amounts,
                            upi_id: upiId,
                            remarks: remarks
                        })
                    });

                    const data = await res.json();
                    if (data.success) {
                        alert(data.message || 'UPI payment collect request initiated successfully');
                    } else {
                        alert(data.message || 'Error sending UPI request');
                    }
                } catch (err) {
                    alert('Network error sending UPI payment request');
                }
            }

            async function generateQR() {
                const feeIds = getSelectedFeeIds();
                if (feeIds.length === 0) {
                    alert('Please select at least one fee item');
                    return;
                }

                const amounts = getSelectedPayingAmounts();
                const remarks = document.getElementById('feeRemarks').value;

                try {
                    const res = await fetch('/schooladmin/fees/qr/generate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            student_id: '<%= student ? student.id : "" %>',
                            fee_ids: feeIds,
                            paying_amount: amounts,
                            remarks: remarks
                        })
                    });

                    const data = await res.json();
                    if (data.success && data.qr_image) {
                        document.getElementById('qrPlaceholder').style.display = 'none';
                        const qrDisplay = document.getElementById('qrDisplay');
                        qrDisplay.style.display = 'flex';
                        document.getElementById('qrCodeImg').src = data.qr_image;

                        if (data.order_id) {
                            startQrPolling(data.order_id);
                        }
                    } else {
                        alert(data.message || 'Error generating payment QR Code');
                    }
                } catch (err) {
                    alert('Network error creating QR Code');
                }
            }

            function startQrPolling(orderId) {
                stopQrPolling();
                qrPollInterval = setInterval(async () => {
                    try {
                        const res = await fetch(`/schooladmin/fees/qr/status/${orderId}`);
                        const data = await res.json();
                        if (data.success && data.status === 'paid') {
                            stopQrPolling();
                            document.getElementById('qrStatusText').textContent = 'Payment received! Redirecting...';
                            setTimeout(() => {
                                window.location.href = `/schooladmin/fees/receipt/${data.payment_id}`;
                            }, 1000);
                        }
                    } catch (err) {
                        // Keep polling silently
                    }
                }, 3000);
            }
        </script>