<%- include('../../partials/head', { title: `${lan.Edit_Fee || 'Edit Fee'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { active: 'fees', user: user }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 style="font-size: 22px; font-weight: 700; color: #1E293B; margin: 0;"><%- lan.Edit_Fee || 'Edit Fee' %></h2>
                    <div style="font-size: 12px; color: #94A3B8; margin-top: 4px;">
                        <a href="/schooladmin/fees" style="color: #4F46E5; text-decoration: none;"><%- lan.Fees || 'Fees' %></a> &rarr; <%- lan.Edit || 'Edit' %>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="page-body">
                <div style="max-width: 550px;">
                    <div class="card p-4" style="border-radius: 12px; border: 1px solid #E2E8F0; background: #fff; box-shadow: var(--shadow-sm);">
                        <form action="/schooladmin/fees/<%= fee.id %>/edit" method="POST">
                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                            <div style="background: #F8FAFC; border-radius: 10px; padding: 14px; margin-bottom: 20px; border: 1px solid #E2E8F0;">
                                <div style="font-size: 13px; color: #64748B;"><%- lan.Student || 'Student' %></div>
                                <div style="font-size: 15px; font-weight: 600; color: #1E293B; margin-top: 2px;">
                                    <%= fee.first_name %> <%= fee.last_name %>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label style="font-size: 13px; font-weight: 600; color: #374151;"><%- lan.Amount || 'Amount' %> (₹) *</label>
                                <input type="number" name="amount" required value="<%= fee.amount %>" class="form-input mt-1" style="border-radius: 8px; font-size: 14px; padding: 8px 12px;">
                            </div>
                            <div class="mb-3">
                                <label style="font-size: 13px; font-weight: 600; color: #374151;"><%- lan.Due_Date || 'Due Date' %> *</label>
                                <input type="date" name="due_date" required value="<%= fee.due_date ? new Date(fee.due_date).toISOString().split('T')[0] : '' %>" class="form-input mt-1" style="border-radius: 8px; font-size: 14px; padding: 8px 12px;">
                            </div>
                            <div class="mb-3">
                                <label style="font-size: 13px; font-weight: 600; color: #374151;"><%- lan.Status || 'Status' %> *</label>
                                <select name="status" required class="form-select mt-1" style="border-radius: 8px; font-size: 14px; padding: 8px 12px;">
                                    <option value="pending" <%= fee.status === 'pending' ? 'selected' : '' %>><%- lan.Pending || 'Pending' %></option>
                                    <option value="paid" <%= fee.status === 'paid' ? 'selected' : '' %>><%- lan.Paid || 'Paid' %></option>
                                    <option value="overdue" <%= fee.status === 'overdue' ? 'selected' : '' %>><%- lan.Overdue || 'Overdue' %></option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label style="font-size: 13px; font-weight: 600; color: #374151;"><%- lan.Payment_Method || 'Payment Method' %></label>
                                <select name="payment_method" class="form-select mt-1" style="border-radius: 8px; font-size: 14px; padding: 8px 12px;">
                                    <option value="">-- <%- lan.Select || 'Select' %> --</option>
                                    <option value="Cash" <%= fee.payment_method === 'Cash' ? 'selected' : '' %>><%- lan.Cash || 'Cash' %></option>
                                    <option value="UPI" <%= fee.payment_method === 'UPI' ? 'selected' : '' %>><%- lan.UPI || 'UPI' %></option>
                                    <option value="Card" <%= fee.payment_method === 'Card' ? 'selected' : '' %>><%- lan.Card || 'Card' %></option>
                                    <option value="Bank" <%= fee.payment_method === 'Bank' ? 'selected' : '' %>><%- lan.Bank_Transfer || 'Bank Transfer' %></option>
                                    <option value="Cheque" <%= fee.payment_method === 'Cheque' ? 'selected' : '' %>><%- lan.Cheque || 'Cheque' %></option>
                                </select>
                            </div>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label style="font-size: 13px; font-weight: 600; color: #374151;"><%- lan.Discount || 'Discount' %> (₹)</label>
                                    <input type="number" name="discount" min="0" value="<%= fee.discount || 0 %>" class="form-input mt-1" style="border-radius: 8px; font-size: 14px; padding: 8px 12px;">
                                </div>
                                <div class="col-md-6">
                                    <label style="font-size: 13px; font-weight: 600; color: #374151;"><%- lan.Late_Fee || 'Late Fee' %> (₹)</label>
                                    <input type="number" name="late_fee" min="0" value="<%= fee.late_fee || 0 %>" class="form-input mt-1" style="border-radius: 8px; font-size: 14px; padding: 8px 12px;">
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn text-white" style="background: #4F46E5; border-radius: 8px; padding: 10px 24px; font-size: 14px; font-weight: 600; border: none; transition: all 0.2s ease;">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> <%- lan.Save_Changes || 'Save Changes' %>
                                </button>
                                <a href="/schooladmin/fees" class="btn" style="background: #F1F5F9; color: #64748B; border-radius: 8px; padding: 10px 24px; font-size: 14px; font-weight: 600; border: none;"><%- lan.Cancel || 'Cancel' %></a>
                            </div>
                        </form>
                    </div>
</div>
        <%- include('../../partials/footer') %>
                </div>
        </div>

    </div>
</div>