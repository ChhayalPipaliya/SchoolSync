<%- include('../../partials/head', { title: `${lan.Fee_Dashboard || 'Fee Dashboard' } | SchoolSync` }) %>

    <body class="schooladmin-theme">
        <div class="app-wrapper">
            <%- include('../../partials/sidebar', { active: 'fees' , user: user,
                currentPath: '/schooladmin/fees/dashboard' }) %>
                <main class="main-panel" id="mainPanel">
                    <%- include('../../partials/header', { user: user }) %>
                        <div class="content">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                                <div>
                                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Fee_Dashboard
                                            || 'Fee Dashboard' %></h2>
                                    <p class="text-xs text-gray-500 mt-1"><%- lan.Financial_Overview_Month
                                            || 'Financial overview for current month' %></p>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    <a href="/schooladmin/fees/export?format=excel&month=<%= new Date().toISOString().slice(0,7) %>"
                                        class="btn btn-outline text-xs flex items-center gap-1">
                                        <i class="fas fa-file-excel"></i> <%- lan.Export_Excel || 'Export Excel' %>
                                    </a>
                                    <a href="/schooladmin/fees/export?format=pdf&month=<%= new Date().toISOString().slice(0,7) %>"
                                        class="btn btn-secondary text-xs flex items-center gap-1">
                                        <i class="fas fa-file-pdf"></i> <%- lan.Export_PDF || 'Export PDF' %>
                                    </a>
                                    <a href="/schooladmin/fees/collect"
                                        class="btn btn-primary text-xs flex items-center gap-1">
                                        <i class="fas fa-plus"></i> <%- lan.Collect_Fee || 'Collect Fee' %>
                                    </a>
                                </div>
                            </div>
                            <%- include('../../partials/flashMessages') %>
                                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-3">
                                    <div class="card p-5">
                                        <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1"><%-
                                                lan.Collected_This_Month || 'Collected This Month' %></p>
                                        <p class="text-2xl font-bold" style="color: var(--primary);">
                                            ₹<%= parseFloat(stats.collectedThisMonth || 0).toLocaleString('en-IN', {
                                                minimumFractionDigits: 2 }) %>
                                        </p>
                                        <p class="text-xs text-gray-400 mt-1">
                                            <%= stats.collectionCount %> <%- lan.Payments_Small || 'payments' %>
                                        </p>
                                    </div>
                                    <div class="card p-5">
                                        <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1"><%-
                                                lan.Outstanding || 'Outstanding' %></p>
                                        <p class="text-2xl font-bold text-amber-500">
                                            ₹<%= parseFloat(stats.outstanding || 0).toLocaleString('en-IN', {
                                                minimumFractionDigits: 2 }) %>
                                        </p>
                                        <p class="text-xs text-gray-400 mt-1"><%- lan.Total_Pending_Balance
                                                || 'Total pending balance' %></p>
                                    </div>
                                    <div class="card p-5">
                                        <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1"><%-
                                                lan.Overdue || 'Overdue' %></p>
                                        <p class="text-2xl font-bold text-red-500">
                                            ₹<%= parseFloat(stats.overdue || 0).toLocaleString('en-IN', {
                                                minimumFractionDigits: 2 }) %>
                                        </p>
                                        <p class="text-xs text-gray-400 mt-1"><%- lan.Past_Due_Date || 'Past due date'
                                                %></p>
                                    </div>
                                    <div class="card p-5">
                                        <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-2"><%-
                                                lan.Quick_Actions || 'Quick Actions' %></p>
                                        <div class="space-y-1.5">
                                            <a href="/schooladmin/fees/bulk-generate"
                                                class="block text-xs font-bold text-blue-600 hover:underline">
                                                <i class="fas fa-bolt mr-1"></i> <%- lan.Bulk_Generate
                                                    || 'Bulk Generate' %>
                                            </a>
                                            <a href="/schooladmin/fees/pending"
                                                class="block text-xs font-bold text-amber-600 hover:underline">
                                                <i class="fas fa-clock mr-1"></i> <%- lan.View_Pending || 'View Pending'
                                                    %>
                                            </a>
                                            <a href="/schooladmin/fees/structure"
                                                class="block text-xs font-bold text-gray-500 hover:underline">
                                                <i class="fas fa-layer-group mr-1"></i> <%- lan.Fee_Structures
                                                    || 'Fee Structures' %>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="card p-5 mb-3">
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                        <div>
                                            <p class="text-sm font-bold text-gray-800"><%- lan.Auto_Late_Fee_Calculator
                                                    || 'Auto Late Fee Calculator' %></p>
                                            <p class="text-xs text-gray-400 mt-0.5"><%- lan.Auto_Late_Fee_Desc
                                                    || 'Apply late charges to all overdue unpaid fees (runs once per fee record)'
                                                    %></p>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <input type="number" id="lateFeePerDay"
                                                placeholder="₹/<%- lan.Day || 'day' %>" value="5"
                                                class="form-input text-xs w-24" min="1">
                                            <input type="number" id="maxLateFee" placeholder="Max ₹" value="500"
                                                class="form-input text-xs w-24" min="1">
                                            <button onclick="applyLateFees()"
                                                class="btn btn-outline text-xs whitespace-nowrap">
                                                <i class="fas fa-calculator mr-1"></i> <%- lan.Apply_Late_Fees
                                                    || 'Apply Late Fees' %>
                                            </button>
                                        </div>
                                    </div>
                                    <div id="lateFeeResult"
                                        class="hidden mt-3 text-xs p-3 rounded-lg bg-emerald-50 text-emerald-700 font-bold">
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                                    <div class="card p-6 lg:col-span-2">
                                        <h3 class="font-bold text-gray-800 mb-3 text-sm"><%-
                                                lan.Collections_Last_6_Months || 'Collections — Last 6 Months' %></h3>
                                        <canvas id="feeChart" height="120"></canvas>
                                    </div>
                                    <div class="card p-6">
                                        <h3 class="font-bold text-gray-800 mb-3 text-sm"><%- lan.Recent_Payments
                                                || 'Recent Payments' %></h3>
                                        <% if (recentPayments.length===0) { %>
                                            <p class="text-xs text-gray-400"><%- lan.No_Payments_Recorded
                                                    || 'No payments recorded yet.' %></p>
                                            <% } else { %>
                                                <div class="space-y-3">
                                                    <% recentPayments.forEach(p=> { %>
                                                        <div
                                                            class="flex justify-between items-center py-2 border-b border-slate-50 last:border-0">
                                                            <div>
                                                                <p class="text-xs font-bold text-gray-800">
                                                                    <%= p.first_name %>
                                                                        <%= p.last_name %>
                                                                </p>
                                                                <p class="text-[10px] text-gray-400">
                                                                    <%= new
                                                                        Date(p.created_at).toLocaleDateString('en-IN')
                                                                        %> ·
                                                                        <span class="capitalize">
                                                                            <%= p.payment_method || '—' %>
                                                                        </span>
                                                                </p>
                                                            </div>
                                                            <p class="text-xs font-bold" style="color: var(--primary);">
                                                                ₹<%= parseFloat(p.amount).toLocaleString('en-IN') %>
                                                            </p>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <a href="/schooladmin/fees/history"
                                                    class="block text-xs text-blue-500 hover:underline mt-3">
                                                    <%- lan.View_All_History || 'View all history' %> &rarr;
                                                </a>
                                                <% } %>
                                    </div>
                                    <%- include('../../partials/footer') %>
                                </div>
                        </div>

                </main>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            const chartData = '<%- JSON.stringify(chartData) %>';
            new Chart(document.getElementById('feeChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: chartData.map(d => d.month),
                    datasets: [{
                        label: 'Collected (₹)',
                        data: chartData.map(d => parseFloat(d.total || 0)),
                        backgroundColor: 'rgba(16,185,129,0.75)',
                        borderColor: 'rgb(16,185,129)',
                        borderWidth: 1,
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { callback: v => '₹' + v.toLocaleString('en-IN') } } }
                }
            });

            async function applyLateFees() {

                const perDay = document.getElementById('lateFeePerDay').value;
                const maxFee = document.getElementById('maxLateFee').value;

                if (!perDay || !maxFee) return;
                const btn = event.target;
                btn.disabled = true;
                btn.textContent = 'Applying...';

                try {
                    const res = await fetch('/schooladmin/fees/calculate-late-fees', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ late_fee_per_day: perDay, max_late_fee: maxFee })
                    });
                    const data = await res.json();
                    const el = document.getElementById('lateFeeResult');
                    el.classList.remove('hidden');

                    if (data.success) {
                        el.textContent = `Done — ${data.updated} fees updated. Total late fee added: ₹${parseFloat(data.totalLateFeeAdded).toFixed(2)}`;
                    } else {
                        el.className = 'mt-3 text-xs p-3 rounded-lg bg-red-50 text-red-700 font-bold';
                        el.textContent = data.message || 'Failed to apply late fees';
                    };
                } catch {
                    alert('Request failed. Try again.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-calculator mr-1"></i> Apply Late Fees';
                }
            }
        </script>
    </body>

    </html>