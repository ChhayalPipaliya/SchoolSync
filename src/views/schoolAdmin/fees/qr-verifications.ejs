<%- include('../../partials/head', { title: `${lan.QR_Payment_Verification || 'QR Payment Verification'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/fees/qr-verifications' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding:24px;">
            <div style="background:linear-gradient(135deg, #059669, #047857); border-radius:12px; padding:24px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(5,150,105,0.15);">
                <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
                <div style="position:relative; z-index:1;">
                    <h1 style="font-size:24px; font-weight:700; margin:0;"><%- lan.QR_Payment_Verification || 'QR Payment Verification' %></h1>
                    <p style="font-size:13px; opacity:0.9; margin:4px 0 0;"><%- lan.QR_Payment_Verification_Desc || "Review and verify fee payments submitted by parents using the school's UPI QR code" %></p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card shadow-sm border border-slate-100" style="border-radius:12px;">
                <div class="card-header bg-slate-50/50" style="padding:16px 20px; border-bottom:1px solid #f1f5f9; display:flex; justify-content:space-between; align-items:center;">
                    <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700" style="margin:0;">
                        <i class="fa-solid fa-clock-rotate-left text-emerald-600"></i> <%- lan.Pending_Verification_Submissions || 'Pending Verification Submissions' %>
                    </h3>
                    <span class="badge bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded-full">
                        <%= pendingPayments ? pendingPayments.length : 0 %> <%- lan.Pending || 'Pending' %>
                    </span>
                </div>
                <div class="card-body" style="padding:0; overflow-x:auto;">
                    <table class="w-full text-left border-collapse" style="font-size:13px;">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold text-[11px] uppercase tracking-wider">
                                <th class="p-4"><%- lan.Student_Info || 'Student Info' %></th>
                                <th class="p-4"><%- lan.Fee_Month || 'Fee Month' %></th>
                                <th class="p-4"><%- lan.Amount || 'Amount' %></th>
                                <th class="p-4"><%- lan.Payment_Ref_UTR || 'Payment Ref / UTR' %></th>
                                <th class="p-4"><%- lan.Submission_Date || 'Submission Date' %></th>
                                <th class="p-4"><%- lan.Proof_Image || 'Proof Image' %></th>
                                <th class="p-4 text-center"><%- lan.Actions || 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (pendingPayments && pendingPayments.length > 0) { %>
                                <% pendingPayments.forEach(pay => { %>
                                    <tr class="hover:bg-slate-50/50 transition">
                                        <td class="p-4">
                                            <div class="font-bold text-slate-800"><%= pay.first_name %> <%= pay.last_name %></div>
                                            <div class="text-xs text-slate-500">
                                                <%= pay.class_name ? pay.class_name + '-' + (pay.section || '') : (lan.NA || 'N/A') %> 
                                                <%= pay.roll_no ? `(${lan.Roll || 'Roll'}: ` + pay.roll_no + ')' : '' %>
                                            </div>
                                        </td>
                                        <td class="p-4 font-medium text-slate-700 capitalize"><%= pay.fee_name || (lan.Tuition_Fee || 'Tuition Fee') %></td>
                                        <td class="p-4 font-bold text-emerald-700">₹<%= parseFloat(pay.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                        <td class="p-4">
                                            <div class="font-mono text-xs font-bold text-slate-800"><%= pay.payment_reference || pay.transaction_id || (lan.NA || 'N/A') %></div>
                                            <% if (pay.transaction_id && pay.transaction_id !== pay.payment_reference) { %>
                                                <div class="text-[11px] text-slate-500"><%- lan.UTR || 'UTR' %>: <%= pay.transaction_id %></div>
                                            <% } %>
                                        </td>
                                        <td class="p-4 text-xs text-slate-600"><%= new Date(pay.created_at).toLocaleString('en-IN') %></td>
                                        <td class="p-4">
                                            <% if (pay.proof_image) { %>
                                                <a href="<%= pay.proof_image %>" target="_blank" class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 hover:text-emerald-700 underline">
                                                    <i class="fa-solid fa-image"></i> <%- lan.View_Proof || 'View Proof' %>
                                                </a>
                                            <% } else { %>
                                                <span class="text-xs text-slate-400 italic"><%- lan.No_Image || 'No image' %></span>
                                            <% } %>
                                        </td>
                                        <td class="p-4 text-center">
                                            <div class="flex items-center justify-center gap-2">
                                                <form action="/schooladmin/fees/qr-payments/<%= pay.id %>/verify" method="POST" class="verify-payment-form" data-confirm="<%- lan.Verify_Payment_Confirm || 'Verify and mark this payment as completed?' %>">
                                                    <button type="submit" class="btn btn-sm bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-3 py-1.5 rounded-lg text-xs flex items-center gap-1 shadow-sm transition">
                                                        <i class="fa-solid fa-check"></i> <%- lan.Verify || 'Verify' %>
                                                    </button>
                                                </form>

                                                <button type="button" onclick="openRejectModal('<%= pay.id %>', '<%= pay.first_name %> <%= pay.last_name %>', '<%= pay.amount %>')" class="btn btn-sm bg-rose-600 hover:bg-rose-700 text-white font-bold px-3 py-1.5 rounded-lg text-xs flex items-center gap-1 shadow-sm transition">
                                                    <i class="fa-solid fa-xmark"></i> <%- lan.Reject || 'Reject' %>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="p-8 text-center text-slate-500 text-sm">
                                        <i class="fa-solid fa-circle-check text-2xl text-emerald-500 mb-2 block"></i>
                                        <%- lan.No_Pending_QR_Verifications || 'No pending QR payment verifications.' %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<div id="rejectModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[9999] items-center justify-center p-4">
    <div class="bg-white w-full max-width-md max-w-md rounded-2xl overflow-hidden shadow-2xl">
        <div class="bg-rose-600 p-4 text-white flex justify-between items-center">
            <h3 class="font-bold text-base flex items-center gap-2 m-0">
                <i class="fa-solid fa-circle-exclamation"></i> <%- lan.Reject_Payment_Submission || 'Reject Payment Submission' %>
            </h3>
            <button type="button" onclick="closeRejectModal()" class="text-white opacity-80 hover:opacity-100 text-sm">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form id="rejectForm" method="POST" class="p-5 space-y-4">
            <p class="text-xs text-slate-600 m-0">
                <%- lan.Rejecting_Payment_Notice || 'You are rejecting the payment request for' %> <strong id="rejectStudentName"></strong> (<%- lan.Amount || 'Amount' %>: ₹<span id="rejectAmount"></span>).
            </p>
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1"><%- lan.Rejection_Reason || 'Rejection Reason' %></label>
                <textarea name="rejection_reason" required placeholder="<%- lan.Rejection_Reason_Placeholder || 'e.g. Transaction reference not found in bank account statement.' %>" rows="3" class="w-full border border-slate-300 rounded-lg p-2.5 text-xs font-medium focus:ring-rose-500 focus:border-rose-500"></textarea>
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="closeRejectModal()" class="px-4 py-2 text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg"><%- lan.Cancel || 'Cancel' %></button>
                <button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-lg"><%- lan.Confirm_Rejection || 'Confirm Rejection' %></button>
            </div>
        </form>
    </div>
</div>
<script>
    function openRejectModal(paymentId, studentName, amount) {
        document.getElementById('rejectForm').action = `/schooladmin/fees/qr-payments/${paymentId}/reject`;
        document.getElementById('rejectStudentName').innerText = studentName;
        document.getElementById('rejectAmount').innerText = parseFloat(amount).toLocaleString('en-IN', { minimumFractionDigits: 2 });
        document.getElementById('rejectModal').classList.remove('hidden');
        document.getElementById('rejectModal').classList.add('flex');
    };

    function closeRejectModal() {
        document.getElementById('rejectModal').classList.add('hidden');
        document.getElementById('rejectModal').classList.remove('flex');
    };

    document.querySelectorAll('.verify-payment-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const confirmMsg = this.getAttribute('data-confirm');
            if (confirmMsg && !confirm(confirmMsg)) {
                e.preventDefault();
            }
        });
    });
</script>