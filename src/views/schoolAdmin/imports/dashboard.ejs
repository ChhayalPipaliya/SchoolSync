<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/imports' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Bulk Import Center</h2>
                    <p class="text-xs text-gray-500 mt-1">Upload CSV or Excel files to batch register students, teachers, books, fees, and marks.</p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-purple-100">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Students</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Batch upload student profiles including email, roll number, parents, address, and admission date.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/students" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('students')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-indigo-100">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Teachers</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Register teachers in bulk with qualifications, joining dates, salary structure, and assigned subjects.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/teachers" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('teachers')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-rose-100">
                            <i class="fa-solid fa-book"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Books</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Batch catalog library books with details like publisher, ISBN, physical rack ID, and copies.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/books" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('books')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-emerald-100">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Fee Structures</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Define multiple class fee structures, types (Tuition, Exam, etc.), amounts, and due dates.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/fees" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('fees')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-cyan-50 text-cyan-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-cyan-100">
                            <i class="fa-solid fa-square-poll-vertical"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Exam Marks</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Import marks obtained by students for specific exams and subjects in bulk.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/marks" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('marks')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-amber-100">
                            <i class="fa-solid fa-users-between-lines"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Parents / Guardians</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Bulk register parent and guardian profiles including contact information and student relationships.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/parents" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('parents')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-blue-100">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Classes / Sections</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Create and manage classes and sections in bulk for the academic year.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/classes_sections" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('classes_sections')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-teal-50 text-teal-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-teal-100">
                            <i class="fa-solid fa-book-open-reader"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Subjects</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Bulk create academic subjects and map them to classes/sections.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/subjects" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('subjects')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-violet-50 text-violet-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-violet-100">
                            <i class="fa-solid fa-user-check"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Student-Class Allocation</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Bulk assign students to classes, sections, academic years, streams, and roll numbers.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/student_class_allocation" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('student_class_allocation')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-sky-50 text-sky-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-sky-100">
                            <i class="fa-solid fa-chalkboard"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Teacher-Subject Assignment</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Bulk assign teachers to subjects, classes, sections, and streams.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/teacher_subject_assignment" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('teacher_subject_assignment')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
                <div class="card p-6 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 bg-fuchsia-50 text-fuchsia-600 rounded-lg flex items-center justify-center mb-4 text-xl font-bold border border-fuchsia-100">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                        <h3 class="text-base font-bold text-gray-800 mb-2">Import Timetable</h3>
                        <p class="text-xs text-gray-500 mb-6 leading-relaxed">Bulk create timetable schedules for classes, subjects, teachers, rooms, and periods.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/api/templates/timetable" class="btn btn-secondary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-download mr-1"></i> Template</a>
                        <button onclick="openUploadModal('timetable')" class="btn btn-primary btn-sm flex-1 text-xs font-bold py-2"><i class="fa-solid fa-upload mr-1"></i> Upload</button>
                    </div>
                </div>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider"><i class="fa-solid fa-clock-rotate-left mr-2 text-emerald-600"></i> Import History</h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>File Name</th>
                                <th>Rows</th>
                                <th>Status</th>
                                <th>User</th>
                                <th class="text-center">Error Report</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!logs || logs.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center py-8 text-gray-400">No import history found.</td>
                                </tr>
                            <% } else { %>
                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td class="font-mono text-xs"><%= new Date(log.created_at).toLocaleString('en-IN') %></td>
                                        <td class="font-semibold capitalize text-xs">
                                            <span class="px-2 py-0.5 rounded-full text-[10.5px] font-bold 
                                                <%= log.entity_type === 'students' ? 'bg-purple-50 text-purple-700 border border-purple-100/50' : '' %>
                                                <%= log.entity_type === 'teachers' ? 'bg-indigo-50 text-indigo-700 border border-indigo-100/50' : '' %>
                                                <%= log.entity_type === 'books' ? 'bg-rose-50 text-rose-700 border border-rose-100/50' : '' %>
                                                <%= log.entity_type === 'fees' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100/50' : '' %>
                                                <%= log.entity_type === 'marks' ? 'bg-cyan-50 text-cyan-700 border border-cyan-100/50' : '' %>
                                                <%= log.entity_type === 'parents' ? 'bg-amber-50 text-amber-700 border border-amber-100/50' : '' %>
                                                <%= log.entity_type === 'classes_sections' ? 'bg-blue-50 text-blue-700 border border-blue-100/50' : '' %>
                                                <%= log.entity_type === 'subjects' ? 'bg-teal-50 text-teal-700 border border-teal-100/50' : '' %>
                                                <%= log.entity_type === 'student_class_allocation' ? 'bg-violet-50 text-violet-700 border border-violet-100/50' : '' %>
                                                <%= log.entity_type === 'teacher_subject_assignment' ? 'bg-sky-50 text-sky-700 border border-sky-100/50' : '' %>
                                                <%= log.entity_type === 'timetable' ? 'bg-fuchsia-50 text-fuchsia-700 border border-fuchsia-100/50' : '' %>
                                            ">
                                                <%= log.entity_type.replace(/_/g, ' ') %>
                                            </span>
                                        </td>
                                        <td class="max-w-[200px] truncate" title="<%= log.file_name %>"><%= log.file_name %></td>
                                        <td class="text-xs">
                                            <span class="text-emerald-600 font-bold"><%= log.success_count %></span> / 
                                            <span class="text-rose-500 font-bold"><%= log.failed_count %></span> 
                                            <span class="text-gray-400">(Total: <%= log.total_rows %>)</span>
                                        </td>
                                        <td>
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase
                                                <%= log.status === 'completed' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : '' %>
                                                <%= log.status === 'failed' ? 'bg-red-50 text-red-700 border border-red-100' : '' %>
                                                <%= log.status === 'partial' ? 'bg-amber-50 text-amber-700 border border-amber-100' : '' %>
                                                <%= log.status === 'processing' ? 'bg-cyan-50 text-cyan-700 border border-cyan-100' : '' %>
                                            ">
                                                <%= log.status %>
                                            </span>
                                        </td>
                                        <td class="text-xs text-gray-500"><%= log.imported_by_name %></td>
                                        <td class="text-center">
                                            <% if (log.error_report_path) { %>
                                                <a href="<%= log.error_report_path %>" class="btn btn-danger btn-sm py-1 px-2.5 text-[11px] font-bold"><i class="fa-solid fa-file-csv mr-1"></i> Download Report</a>
                                            <% } else { %>
                                                <span class="text-gray-300">—</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-xl shadow-lg">
            <div class="modal-header border-bottom border-gray-100 pb-3">
                <h5 class="modal-title font-bold text-gray-800 text-base" id="modalTitle">Upload Data File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-6">
                <div id="dropzone" class="border-2 border-dashed border-slate-200 rounded-xl p-8 text-center hover:border-emerald-400 transition-colors cursor-pointer mb-4">
                    <input type="file" id="fileInput" class="d-none" accept=".csv, .xlsx">
                    <div class="text-slate-400 mb-3 text-3xl">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                    </div>
                    <p class="text-xs font-bold text-gray-700 mb-1">Drag and drop file here, or click to browse</p>
                    <p class="text-[10px] text-gray-400">Supports CSV and Excel (.xlsx) up to 5MB</p>
                    <div id="selectedFileInfo" class="mt-4 p-2 bg-emerald-50 border border-emerald-100 rounded-lg text-emerald-700 text-xs font-semibold d-none flex justify-between items-center">
                        <span id="fileNameDisplay" class="truncate max-w-[80%]">filename.csv</span>
                        <button onclick="removeSelectedFile(event)" class="text-emerald-900 hover:text-red-500 font-bold border-0 bg-transparent"><i class="fa-solid fa-circle-xmark"></i></button>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Import Option</label>
                    <select id="importMode" class="form-select">
                        <option value="all_or_nothing" selected>All or Nothing (Reject file if any row fails)</option>
                        <option value="partial">Partial Import (Skip invalid rows and log errors)</option>
                    </select>
                </div>
                <div id="progressSection" class="d-none mb-4">
                    <div class="flex justify-between text-xs font-bold text-gray-500 mb-1">
                        <span>Uploading & Processing...</span>
                        <span id="progressPercent">0%</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-emerald-600" role="progressbar" style="width: 0%"></div>
                    </div>
                </div>
                <div id="responseZone" class="d-none"></div>
            </div>
            <div class="modal-footer border-top border-gray-100 pt-3">
                <button type="button" class="btn btn-secondary text-xs font-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSubmitImport" onclick="submitImport()" class="btn btn-primary font-bold text-xs"><i class="fa-solid fa-circle-play mr-1"></i> Start Import</button>
            </div>
        </div>
    </div>
</div>
<script>
    let activeEntityType = '';
    let selectedFile = null;
    let uploadModalObj = null;

    document.addEventListener("DOMContentLoaded", () => {
        uploadModalObj = new bootstrap.Modal(document.getElementById('uploadModal'));

        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('fileInput');

        dropzone.addEventListener('click', () => fileInput.click());

        dropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropzone.classList.add('border-emerald-400', 'bg-emerald-50/20');
        });

        dropzone.addEventListener('dragleave', () => {
            dropzone.classList.remove('border-emerald-400', 'bg-emerald-50/20');
        });

        dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropzone.classList.remove('border-emerald-400', 'bg-emerald-50/20');
            if (e.dataTransfer.files.length) {
                handleFileSelection(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length) {
                handleFileSelection(e.target.files[0]);
            }
        });
    });

    function openUploadModal(entityType) {
        activeEntityType = entityType;
        document.getElementById('modalTitle').innerText = `Bulk Import: ${entityType.charAt(0).toUpperCase() + entityType.slice(1)}`;
        
        selectedFile = null;
        document.getElementById('fileInput').value = '';
        document.getElementById('selectedFileInfo').classList.add('d-none');
        document.getElementById('progressSection').classList.add('d-none');
        document.getElementById('progressBar').style.width = '0%';
        document.getElementById('responseZone').classList.add('d-none');
        document.getElementById('responseZone').innerHTML = '';
        document.getElementById('btnSubmitImport').removeAttribute('disabled');
        
        uploadModalObj.show();
    }

    function handleFileSelection(file) {
        const ext = file.name.split('.').pop().toLowerCase();
        if (ext !== 'csv' && ext !== 'xlsx') {
            alert('Invalid file type! Please upload only .csv or .xlsx spreadsheets.');
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            alert('File size exceeds 5MB limit.');
            return;
        }

        selectedFile = file;
        document.getElementById('fileNameDisplay').innerText = file.name;
        document.getElementById('selectedFileInfo').classList.remove('d-none');
    }

    function removeSelectedFile(e) {
        e.stopPropagation();
        selectedFile = null;
        document.getElementById('fileInput').value = '';
        document.getElementById('selectedFileInfo').classList.add('d-none');
    }

    async function submitImport() {
        if (!selectedFile) {
            alert('Please select a file to import.');
            return;
        }

        const mode = document.getElementById('importMode').value;
        const formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('import_mode', mode);

        document.getElementById('progressSection').classList.remove('d-none');
        document.getElementById('btnSubmitImport').setAttribute('disabled', 'true');
        document.getElementById('responseZone').classList.add('d-none');

        const xhr = new XMLHttpRequest();
        xhr.open('POST', `/api/import/${activeEntityType}`, true);

        xhr.upload.onprogress = (e) => {
            if (e.lengthComputable) {
                const pct = Math.round((e.loaded / e.total) * 50);
                document.getElementById('progressBar').style.width = `${pct}%`;
                document.getElementById('progressPercent').innerText = `${pct}%`;
            }
        };

        xhr.onload = async () => {
            const res = JSON.parse(xhr.responseText);
            if (xhr.status === 202 && res.jobId) {
                pollJobStatus(res.jobId);
            } else {
                handleImportResponse(res);
            }
        };

        xhr.onerror = () => {
            handleImportResponse({ success: false, message: 'Connection error. Failed to execute upload.' });
        };

        xhr.send(formData);
    }

    async function pollJobStatus(jobId) {
        const interval = setInterval(async () => {
            try {
                const response = await fetch(`/api/import/status/${jobId}`);
                const data = await response.json();
                
                if (data.success) {
                    if (data.status === 'processing') {
                        const progress = 50 + Math.round(data.progress / 2); 
                        document.getElementById('progressBar').style.width = `${progress}%`;
                        document.getElementById('progressPercent').innerText = `${progress}% (Row ${data.current_row}/${data.total_rows})`;
                    } else {
                        clearInterval(interval);
                        handleImportResponse(data.result || data);
                    }
                } else {
                    clearInterval(interval);
                    handleImportResponse({ success: false, message: data.message || 'Background processing failed.' });
                }
            } catch (err) {
                clearInterval(interval);
                handleImportResponse({ success: false, message: 'Error checking background progress.' });
            }
        }, 2000);
    }

    function handleImportResponse(res) {
        document.getElementById('progressSection').classList.add('d-none');
        document.getElementById('btnSubmitImport').removeAttribute('disabled');
        const zone = document.getElementById('responseZone');
        zone.classList.remove('d-none');

        if (res.success) {
            let detailsHtml = '';
            if (res.failed_count > 0) {
                detailsHtml = `
                    <div class="mt-3 p-3 bg-amber-50 rounded-lg border border-amber-100 text-xs">
                        <div class="font-bold text-amber-800 mb-1">Imported with warnings:</div>
                        <p class="text-amber-700">Successfully inserted <strong>${res.success_count}</strong> records, but <strong>${res.failed_count}</strong> records failed validation.</p>
                        <div class="mt-2">
                            <a href="${res.error_report_url}" class="btn btn-danger btn-sm font-bold py-1 px-3"><i class="fa-solid fa-file-csv mr-1"></i> Download Error Report</a>
                        </div>
                    </div>
                `;
            } else {
                detailsHtml = `
                    <div class="mt-3 p-3 bg-emerald-50 rounded-lg border border-emerald-100 text-xs text-emerald-800 font-medium">
                        <i class="fa-solid fa-circle-check mr-1"></i> Successfully imported all <strong>${res.success_count}</strong> records without errors!
                    </div>
                `;
            }

            zone.innerHTML = `
                <div class="alert alert-success text-xs font-medium py-3 rounded-lg border border-success/10 mb-0">
                    <strong>Import Successful!</strong>
                    ${detailsHtml}
                </div>
            `;
            
            document.getElementById('uploadModal').addEventListener('hidden.bs.modal', () => {
                location.reload();
            }, { once: true });

        } else {
            let reportBtn = '';
            if (res.error_report_url) {
                reportBtn = `
                    <div class="mt-2">
                        <a href="${res.error_report_url}" class="btn btn-danger btn-sm font-bold py-1 px-3"><i class="fa-solid fa-file-csv mr-1"></i> Download Error Report</a>
                    </div>
                `;
            }

            zone.innerHTML = `
                <div class="alert alert-danger text-xs font-medium py-3 rounded-lg border border-danger/10 mb-0">
                    <strong class="block mb-1"><i class="fa-solid fa-circle-exclamation mr-1"></i> Import Failed</strong>
                    <p>${res.message}</p>
                    ${res.details ? `<p class="mt-1 text-[11px] text-red-500 font-mono">Row ${res.details.row_number}: [${res.details.field}] - ${res.details.message}</p>` : ''}
                    ${reportBtn}
                </div>
            `;
        }
    }
</script>
<%- include('../../partials/footer') %>