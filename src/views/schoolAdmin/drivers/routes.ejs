<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Routes</h2>
                    <p class="text-xs text-gray-500 mt-1">Manage school transport transit routes and vehicle allocations</p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/schooladmin/drivers/vehicles" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold transition">
                        <i class="fa-solid fa-bus"></i> Vehicles
                    </a>
                    <a href="/schooladmin/drivers" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold transition">
                        <i class="fa-solid fa-id-card-clip"></i> Drivers
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title flex items-center gap-2">
                        <i class="fa-solid fa-plus-circle text-emerald-600 text-sm"></i> Add New Route
                    </h3>
                </div>
                <div class="card-body">
                    <form action="/schooladmin/drivers/routes/add" method="POST">
                        <div class="grid grid-cols-1 md:grid-cols-6 gap-4 items-end">
                            <div class="form-group mb-0 md:col-span-2">
                                <label class="form-label font-bold text-gray-400 uppercase tracking-wider mb-2 text-[10px]">Route Name <span class="text-rose-500">*</span></label>
                                <input type="text" name="routeName" required placeholder="e.g. Morning Route #10A" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-gray-400 uppercase tracking-wider mb-2 text-[10px]">Start Point <span class="text-rose-500">*</span></label>
                                <input type="text" name="startPoint" required placeholder="e.g. Main Gate" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-gray-400 uppercase tracking-wider mb-2 text-[10px]">End Point <span class="text-rose-500">*</span></label>
                                <input type="text" name="endPoint" required placeholder="e.g. North Suburb" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-gray-400 uppercase tracking-wider mb-2 text-[10px]">Assign Driver</label>
                                <select name="driver_id" class="form-select">
                                    <option value="">— None —</option>
                                    <% (drivers || []).forEach(function(d) { %>
                                        <option value="<%= d.id %>"><%= d.first_name %> <%= d.last_name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-gray-400 uppercase tracking-wider mb-2 text-[10px]">Assign Vehicle</label>
                                <select name="vehicle_id" class="form-select">
                                    <option value="">— None —</option>
                                    <% (vehicles || []).forEach(function(v) { %>
                                        <option value="<%= v.id %>"><%= v.vehicleNumber %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="md:col-span-6 flex justify-end mt-2">
                                <button type="submit" class="btn btn-primary text-xs font-bold shadow-sm transition">
                                    Add Route
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider">All Transit Routes</h4>
                </div>
                <div class="table-container">
                    <% if (!routes || routes.length === 0) { %>
                        <div class="text-center py-12 text-gray-400 font-medium">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <i class="fa-solid fa-route fa-2x text-gray-200"></i>
                                <span>No transit routes added yet.</span>
                            </div>
                        </div>
                    <% } else { %>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Route Name</th>
                                    <th>Transit Path</th>
                                    <th>Assigned Driver</th>
                                    <th>Assigned Vehicle</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% routes.forEach(function(r) { %>
                                    <tr>
                                        <td class="font-bold text-gray-800">
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10.5px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100/50">
                                                <i class="fa-solid fa-route text-[9px]"></i> <%= r.routeName %>
                                            </span>
                                        </td>
                                        <td class="font-semibold">
                                            <span class="text-emerald-600"><%= r.startPoint %></span>
                                            <span class="text-gray-400 mx-2">→</span>
                                            <span class="text-gray-700"><%= r.endPoint %></span>
                                        </td>
                                        <td>
                                            <% if (r.driverFirst) { %>
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10.5px] font-bold bg-green-50 text-green-700 border border-green-100/50">
                                                    <i class="fa-solid fa-user text-[9px]"></i> <%= r.driverFirst %> <%= r.driverLast %>
                                                </span>
                                            <% } else { %>
                                                <span class="text-gray-300 italic">Unassigned</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (r.vehicleNumber) { %>
                                                <span class="font-bold text-emerald-600">
                                                    <i class="fa-solid fa-bus text-[9px] mr-1"></i><%= r.vehicleNumber %>
                                                    <% if (r.capacity) { %>
                                                        <span class="text-gray-400 font-normal"> · <%= r.capacity %> seats</span>
                                                    <% } %>
                                                </span>
                                            <% } else { %>
                                                <span class="text-gray-300 italic">Unassigned</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border bg-emerald-50 text-emerald-700 border-emerald-100">
                                                <%= r.status %>
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <form action="/schooladmin/drivers/routes/<%= r.id %>/delete" method="POST" class="inline-block m-0" onsubmit="return confirm('Delete route: <%= r.routeName %>?')">
                                                <button type="submit" class="btn-icon btn-danger-icon" title="Delete">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>