<%- include('../../partials/head') %>

<style>
.doc-upload-card {
    border: 1.5px dashed #CBD5E1;
    border-radius: 10px;
    padding: 14px 10px;
    cursor: pointer;
    background: #F8FAFC;
    transition: border-color 0.2s, background 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 110px;
    position: relative;
    text-align: center;
    user-select: none;
}
.doc-upload-card:hover { border-color: #10B981; background: #F0FDF4; }
.doc-upload-card.has-file { border-style: solid; border-color: #10B981; background: #F0FDF4; }
.doc-upload-card input[type=file] { display: none; }
.doc-icon { font-size: 20px; color: #94A3B8; margin-bottom: 6px; }
.doc-upload-card.has-file .doc-icon { color: #10B981; }
.doc-text { font-size: 12px; color: #94A3B8; }
.doc-upload-card.has-file .doc-text { color: #059669; font-weight: 600; }
.doc-filename { font-size: 11px; color: #64748B; margin-top: 3px; word-break: break-all; max-width: 100%; }
.doc-remove {
    position: absolute; top: 5px; right: 7px;
    background: none; border: none; cursor: pointer;
    color: #94A3B8; font-size: 13px; padding: 2px 5px; line-height: 1;
}
.doc-remove:hover { color: #EF4444; }
.doc-view-link {
    font-size: 11px; color: #10B981; margin-top: 4px;
    text-decoration: none; font-weight: 600;
}
.doc-view-link:hover { text-decoration: underline; }
</style>

<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { active: 'drivers', user: user }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="top-header d-flex justify-content-between align-items-center mb-6">
                <div>
                    <h2 style="font-size: 24px; font-weight: 700; color: #1E293B; margin: 0;">
                        <%= typeof driver !== 'undefined' ? 'Edit Driver' : 'Add New Driver' %>
                    </h2>
                    <div style="font-size: 14px; color: #64748B; margin-top: 4px;">
                        <%= typeof driver !== 'undefined' ? 'Update the details for driver ' + driver.first_name + ' ' + driver.last_name : 'Onboard a new transport driver for vehicle routes' %>
                    </div>
                </div>
                <a href="/schooladmin/drivers" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Back to list
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <form action="<%= typeof driver !== 'undefined' ? '/schooladmin/drivers/' + driver.id + '/edit' : '/schooladmin/drivers/add' %>"
                  method="POST" enctype="multipart/form-data" class="row g-4">

                <!-- Assign Vehicle -->
                <div class="col-12">
                    <div class="card p-4 mb-4" style="border-radius: 12px; border: 1px solid #E2E8F0; background: #fff;">
                        <h3 style="font-size: 16px; font-weight: 600; color: #10B981; margin-bottom: 16px;">
                            <i class="fa-solid fa-truck me-2"></i>Assign Vehicle
                        </h3>
                        <select name="vehicle_id" class="form-select form-select-lg">
                            <option value="">— No Vehicle Assigned —</option>
                            <% (vehicles || []).forEach(function(v) { %>
                                <option value="<%= v.id %>" <%= (formData.assignedVehicleId == v.id) ? 'selected' : '' %>>
                                    <%= v.vehicleNumber %> — <%= v.model || v.type %> (Capacity: <%= v.capacity %> seats)
                                </option>
                            <% }); %>
                        </select>
                        <p class="mt-2 mb-0" style="font-size: 13px; color: #64748B; display: flex; align-items: center; gap: 6px;">
                            <i class="fa-solid fa-circle-info text-info"></i>
                            Assigning a vehicle automatically unassigns it from any other active driver.
                        </p>
                    </div>
                </div>

                <!-- Personal Information -->
                <div class="col-12">
                    <div class="card p-4 mb-4" style="border-radius: 12px; border: 1px solid #E2E8F0; background: #fff;">
                        <h3 style="font-size: 16px; font-weight: 600; color: #10B981; margin-bottom: 20px;">
                            <i class="fa-solid fa-user me-2"></i>Personal Information
                        </h3>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label">First Name <span class="text-danger">*</span></label>
                                <input type="text" name="first_name" required value="<%= formData.first_name || '' %>"
                                       placeholder="Enter first name" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                <input type="text" name="last_name" required value="<%= formData.last_name || '' %>"
                                       placeholder="Enter last name" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone <span class="text-danger">*</span></label>
                                <input type="tel" name="phone" required value="<%= formData.phone || '' %>"
                                       placeholder="e.g. 9876543210" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email Address <span class="text-danger">*</span></label>
                                <input type="email" name="email" required value="<%= formData.email || '' %>"
                                       placeholder="driver@school.com" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    Password <span class="text-danger">*</span>
                                    <% if (typeof driver !== 'undefined') { %>
                                        <span style="font-size: 12px; color: #94A3B8; font-weight: 400;">(leave blank to keep current)</span>
                                    <% } %>
                                </label>
                                <input type="password" name="password" <%= typeof driver === 'undefined' ? 'required' : '' %>
                                       minlength="8" placeholder="Minimum 8 characters" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Aadhar Number</label>
                                <input type="text" name="aadharNumber" value="<%= formData.aadharNumber || '' %>"
                                       maxlength="12" pattern="[0-9]{12}" placeholder="12-digit Aadhar number" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Status</label>
                                <select name="status" class="form-select">
                                    <% const selectedStatus = formData.status || 'active'; %>
                                    <option value="active" <%= selectedStatus === 'active' ? 'selected' : '' %>>Active</option>
                                    <option value="inactive" <%= selectedStatus === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                    <option value="suspended" <%= selectedStatus === 'suspended' ? 'selected' : '' %>>Suspended</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Full Address</label>
                                <textarea name="address" rows="3" placeholder="Enter driver address..."
                                          class="form-control"><%= formData.address || '' %></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- License Credentials -->
                <div class="col-12">
                    <div class="card p-4 mb-4" style="border-radius: 12px; border: 1px solid #E2E8F0; background: #fff;">
                        <h3 style="font-size: 16px; font-weight: 600; color: #10B981; margin-bottom: 20px;">
                            <i class="fa-solid fa-id-card me-2"></i>License Credentials
                        </h3>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label">License Number <span class="text-danger">*</span></label>
                                <input type="text" name="licenseNumber" required value="<%= formData.licenseNumber || '' %>"
                                       placeholder="e.g. DL-1420110012345" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">License Expiry Date <span class="text-danger">*</span></label>
                                <input type="date" name="licenseExpiry" required value="<%= formData.licenseExpiry ? new Date(formData.licenseExpiry).toISOString().slice(0,10) : '' %>"
                                       class="form-control">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Section: Profile Photo + Documents -->
                <div class="col-12">
                    <div class="row g-4">

                        <!-- Profile Photo -->
                        <div class="col-lg-3 col-md-4">
                            <div class="card p-4 h-100" style="border-radius: 12px; border: 1px solid #E2E8F0; background: #fff; text-align: center;">
                                <h5 style="font-size: 15px; font-weight: 600; color: #10B981; margin-bottom: 16px;">
                                    <i class="fa-solid fa-camera me-2"></i>Profile Photo
                                </h5>
                                <div class="border border-dashed rounded-3 p-4"
                                     style="cursor: pointer; min-height: 160px; display: flex; align-items: center; justify-content: center; flex-direction: column;"
                                     onclick="document.getElementById('imgInput').click()">
                                    <input type="file" name="image" accept="image/*" id="imgInput"
                                           onchange="previewImage(this)" style="display: none;">
                                    <img id="imgPreview" src="<%= formData.image || '' %>"
                                         style="<%= formData.image ? 'display:block; width:100px; height:100px; border-radius:50%; object-fit:cover;' : 'display:none;' %>">
                                    <div id="uploadPlaceholder" style="<%= formData.image ? 'display:none;' : '' %>">
                                        <i class="fa-solid fa-cloud-arrow-up fa-3x text-muted mb-3"></i>
                                        <p style="font-weight: 600; color: #64748B; margin: 0;">Select Photo</p>
                                        <small style="color: #94A3B8;">JPG or PNG up to 2MB</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Documents Upload -->
                        <div class="col-lg-9 col-md-8">
                            <div class="card p-4 h-100" style="border-radius: 12px; border: 1px solid #E2E8F0; background: #fff;">
                                <h5 style="font-size: 15px; font-weight: 600; color: #10B981; margin-bottom: 20px;">
                                    <i class="fa-solid fa-paperclip me-2"></i>Documents Upload
                                </h5>

                                <%
                                const docFields = [
                                    { name: 'license_document',   label: 'License Document',    icon: 'fa-file-lines',    key: 'licenseDoc' },
                                    { name: 'aadhaar_card',        label: 'Aadhaar Card',        icon: 'fa-id-card',       key: 'aadhaarDoc' },
                                    { name: 'address_proof',       label: 'Address Proof',       icon: 'fa-house',         key: 'addressDoc' },
                                    { name: 'medical_certificate', label: 'Medical Certificate', icon: 'fa-hospital',      key: 'medicalDoc' },
                                    { name: 'police_verification', label: 'Police Verification', icon: 'fa-shield-halved', key: 'policeDoc'  },
                                    { name: 'other_document',      label: 'Other Document',      icon: 'fa-paperclip',     key: 'otherDoc'   }
                                ];
                                %>

                                <div class="row g-3">
                                    <% docFields.forEach(function(doc) { %>
                                        <% const existingFile = (typeof driver !== 'undefined' && formData[doc.key]) ? formData[doc.key] : null; %>
                                        <div class="col-md-6 col-lg-4">
                                            <label class="form-label mb-1" style="font-size: 13px; font-weight: 600; color: #374151;">
                                                <%= doc.label %>
                                            </label>
                                            <div class="doc-upload-card <%= existingFile ? 'has-file' : '' %>"
                                                 onclick="triggerDocFile(this)">
                                                <input type="file" name="<%= doc.name %>"
                                                       accept=".pdf,.jpg,.jpeg,.png"
                                                       onchange="docFileSelected(this)">
                                                <i class="fa-solid <%= existingFile ? 'fa-circle-check' : doc.icon %> doc-icon"></i>
                                                <div class="doc-text">
                                                    <%= existingFile ? 'File uploaded' : 'Click to upload' %>
                                                </div>
                                                <div class="doc-filename">
                                                    <%= existingFile ? existingFile.split('/').pop() : '' %>
                                                </div>
                                                <% if (existingFile) { %>
                                                    <a href="<%= existingFile %>" target="_blank"
                                                       class="doc-view-link" onclick="event.stopPropagation()">
                                                        <i class="fa-solid fa-eye me-1"></i>View
                                                    </a>
                                                <% } %>
                                                <button type="button" class="doc-remove"
                                                        onclick="removeDocFile(event, this)"
                                                        style="<%= existingFile ? '' : 'display:none' %>">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                <!-- Submit Buttons -->
                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-success px-5 py-2 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <%= typeof driver !== 'undefined' ? 'Update Driver' : 'Save Driver' %>
                    </button>
                    <a href="/schooladmin/drivers" class="btn btn-secondary px-5 py-2">Cancel</a>
                </div>

            </form>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>

<script>
    function previewImage(input) {
        const preview = document.getElementById('imgPreview');
        const placeholder = document.getElementById('uploadPlaceholder');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => {
                preview.src = e.target.result;
                preview.style.display = 'block';
                placeholder.style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function triggerDocFile(card) {
        card.querySelector('input[type=file]').click();
    }

    function docFileSelected(input) {
        const card = input.closest('.doc-upload-card');
        if (input.files && input.files[0]) {
            const name = input.files[0].name;
            card.classList.add('has-file');
            card.querySelector('.doc-icon').className = 'fa-solid fa-circle-check doc-icon';
            card.querySelector('.doc-text').textContent = 'File selected';
            card.querySelector('.doc-filename').textContent = name.length > 22 ? name.substring(0, 20) + '…' : name;
            card.querySelector('.doc-remove').style.display = 'block';
        }
    }

    function removeDocFile(e, btn) {
        e.stopPropagation();
        const card = btn.closest('.doc-upload-card');
        const input = card.querySelector('input[type=file]');
        input.value = '';
        card.classList.remove('has-file');
        card.querySelector('.doc-icon').className = 'fa-solid fa-file-lines doc-icon';
        card.querySelector('.doc-text').textContent = 'Click to upload';
        card.querySelector('.doc-filename').textContent = '';
        btn.style.display = 'none';
    }
</script>
