<div class="lm-wrapper"
     data-txt-active="<%- lan.Active || 'Active' %>"
     data-txt-live="<%- lan.Live || 'Live' %>"
     data-txt-driver="<%- lan.Driver || 'Driver' %>"
     data-txt-route="<%- lan.Route_Name || 'Route' %>"
     data-txt-phone="<%- lan.Phone || 'Phone' %>"
     data-txt-speed="<%- lan.Speed || 'Speed' %>"
     data-txt-updated="<%- lan.Updated || 'Updated' %>">
    <div class="lm-sidebar">
        <div class="lm-sidebar-header">
            <div class="lm-sidebar-title">
                <i class="fas fa-satellite-dish"></i>
                <span><%- lan.GPS_Fleet_Monitor || 'GPS Fleet Monitor' %></span>
            </div>
            <span class="lm-badge" id="activeBusCount">
                <span class="lm-pulse"></span> 0 <%- lan.Active || 'Active' %>
            </span>
        </div>
        <div class="lm-search-wrap">
            <i class="fas fa-search lm-search-icon"></i>
            <input type="text" id="busSearchInput" class="lm-search" placeholder="<%- lan.Search_Driver_Vehicle_Route || 'Search driver, vehicle or route...' %>">
        </div>
        <div class="lm-bus-list" id="busListContainer">
            <div class="lm-loading" id="loadingState">
                <div class="lm-spinner"></div>
                <p><%- lan.Connecting_GPS_Service || 'Connecting to GPS service...' %></p>
            </div>
        </div>
        <div class="lm-sidebar-footer">
            <span id="lastRefreshedTime"><%- lan.Last_Updated_Just_Now || 'Last updated: Just now' %></span>
            <button class="lm-refresh-btn" id="refreshBtn" onclick="fetchLiveBuses()">
                <i class="fas fa-sync-alt"></i> <%- lan.Refresh || 'Refresh' %>
            </button>
        </div>
    </div>
    <div class="lm-map-wrap">
        <div id="map"></div>
        <div class="lm-map-controls">
            <button class="lm-ctrl-btn" onclick="fitAllMarkers()" title="<%- lan.Fit_All || 'Fit All' %>">
                <i class="fas fa-expand-arrows-alt"></i> <%- lan.Fit_All || 'Fit All' %>
            </button>
        </div>
        <div class="lm-conn-badge" id="connBadge">
            <span class="lm-pulse"></span> <%- lan.Live || 'Live' %>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="/socket.io/socket.io.js"></script>

<style>
    .lm-wrapper {
        display: flex;
        height: calc(100vh - 70px);
        overflow: hidden;
        background: #f1f5f9;
        font-family: 'Inter', system-ui, sans-serif;
    }
    .lm-sidebar {
        width: 300px;
        min-width: 260px;
        background: #fff;
        border-right: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        z-index: 20;
        box-shadow: 2px 0 12px rgba(0,0,0,0.06);
    }
    .lm-sidebar-header {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: #fff;
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }
    .lm-sidebar-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 700;
    }
    .lm-sidebar-title i { color: #f59e0b; font-size: 16px; }
    .lm-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(16,185,129,0.15);
        border: 1px solid rgba(16,185,129,0.35);
        color: #10b981;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }
    .lm-pulse {
        width: 7px; height: 7px;
        background: #10b981;
        border-radius: 50%;
        display: inline-block;
        animation: lmPulse 1.5s infinite;
    }
    @keyframes lmPulse {
        0%,100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.7); }
    }
    .lm-search-wrap {
        position: relative;
        padding: 10px 12px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    .lm-search-icon {
        position: absolute;
        left: 22px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 13px;
    }
    .lm-search {
        width: 100%;
        padding: 7px 10px 7px 32px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 13px;
        outline: none;
        background: #fff;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }
    .lm-search:focus { border-color: #3b82f6; }
    .lm-bus-list {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
    }
    .lm-bus-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #3b82f6;
        border-radius: 10px;
        padding: 10px 12px;
        margin-bottom: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .lm-bus-card:hover {
        background: #f0f9ff;
        border-left-color: #2563eb;
        transform: translateX(2px);
        box-shadow: 0 2px 8px rgba(59,130,246,0.12);
    }
    .lm-bus-card.lm-selected {
        background: #eff6ff;
        border-left-color: #1d4ed8;
    }
    .lm-bus-card.drop-trip { border-left-color: #10b981; }
    .lm-bus-card.drop-trip:hover { border-left-color: #059669; background: #f0fdf4; }
    .lm-bus-top { display: flex; justify-content: space-between; align-items: flex-start; }
    .lm-bus-num { font-size: 13px; font-weight: 700; color: #1e293b; }
    .lm-bus-driver { font-size: 11px; color: #64748b; margin-top: 2px; }
    .lm-live-dot {
        background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;
        border-radius: 999px; padding: 2px 8px; font-size: 10px; font-weight: 700;
    }
    .lm-bus-meta {
        margin-top: 8px; padding-top: 6px;
        border-top: 1px solid #f1f5f9;
        display: flex; justify-content: space-between;
        font-size: 10px; color: #94a3b8;
    }
    .lm-loading {
        display: flex; flex-direction: column; align-items: center;
        justify-content: center; padding: 40px 16px; color: #94a3b8;
    }
    .lm-spinner {
        width: 24px; height: 24px;
        border: 3px solid #e2e8f0; border-top-color: #3b82f6;
        border-radius: 50%; animation: lmSpin 0.8s linear infinite; margin-bottom: 10px;
    }
    @keyframes lmSpin { to { transform: rotate(360deg); } }
    .lm-empty {
        text-align: center; padding: 40px 16px; color: #94a3b8;
    }
    .lm-empty i { font-size: 32px; margin-bottom: 10px; opacity: 0.4; }
    .lm-empty p { font-size: 12px; margin: 4px 0; }
    .lm-sidebar-footer {
        padding: 10px 14px; border-top: 1px solid #f1f5f9;
        background: #f8fafc; font-size: 11px; color: #94a3b8;
        display: flex; align-items: center; justify-content: space-between;
    }
    .lm-refresh-btn {
        background: none; border: none; color: #3b82f6;
        font-size: 11px; font-weight: 600; cursor: pointer; padding: 0;
    }
    .lm-refresh-btn:hover { color: #1d4ed8; }
    .lm-map-wrap {
        flex: 1; position: relative;
    }
    #map { width: 100%; height: 100%; }
    .lm-map-controls {
        position: absolute; top: 12px; right: 12px; z-index: 10;
        display: flex; flex-direction: column; gap: 8px;
    }
    .lm-ctrl-btn {
        background: #fff; border: 1px solid #e2e8f0;
        border-radius: 8px; padding: 7px 14px;
        font-size: 12px; font-weight: 600; color: #1e293b;
        cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        transition: all 0.2s;
    }
    .lm-ctrl-btn:hover { background: #f0f9ff; border-color: #3b82f6; color: #2563eb; }
    .lm-conn-badge {
        position: absolute; bottom: 20px; left: 12px; z-index: 10;
        background: rgba(255,255,255,0.95); backdrop-filter: blur(6px);
        border: 1px solid #a7f3d0; border-radius: 999px;
        padding: 5px 12px; font-size: 11px; font-weight: 700; color: #047857;
        display: flex; align-items: center; gap: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    @media (max-width: 768px) {
        .lm-wrapper { flex-direction: column; }
        .lm-sidebar { width: 100%; height: 240px; min-width: unset; }
    }
    .leaflet-popup-content-wrapper {
        border-radius: 12px !important;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
        font-family: 'Inter', system-ui, sans-serif !important;
    }
    .lm-popup { padding: 4px; min-width: 200px; }
    .lm-popup-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .lm-popup-header i { color: #3b82f6; font-size: 18px; }
    .lm-popup-header strong { font-size: 14px; color: #1e293b; }
    .lm-popup-row { font-size: 12px; color: #475569; margin: 3px 0; }
    .lm-popup-row strong { color: #1e293b; }
    .lm-popup-time { font-size: 10px; color: #94a3b8; margin-top: 6px; }
</style>
<script>
    (function () {
        'use strict';

        const DEFAULT_LAT = 22.3072, DEFAULT_LNG = 73.1812;

        const map = L.map('map', { zoomControl: true, attributionControl: true }).setView([DEFAULT_LAT, DEFAULT_LNG], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19
        }).addTo(map);

        const markers = {};

        function busIcon(color = '#2563eb') {
            return L.divIcon({
                className: '',
                html: `<div style="background:${color};width:38px;height:38px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:3px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,0.25);display:flex;align-items:center;justify-content:center;">
                            <div style="transform:rotate(45deg);color:#fff;font-size:14px;">🚌</div>
                    </div>`,
                iconSize: [38, 38],
                iconAnchor: [19, 38],
                popupAnchor: [0, -40]
            });
        }

        function buildPopup(bus) {
            const t = bus.last_location_at ? new Date(bus.last_location_at).toLocaleTimeString('en-IN') : 'Just now';
            return `<div class="lm-popup">
                <div class="lm-popup-header"><i class="fas fa-bus"></i><strong>${escapeHtml(bus.vehicle_number || 'School Bus')}</strong></div>
                <div class="lm-popup-row"><strong>Driver:</strong> ${escapeHtml(bus.driver_name || '—')}</div>
                <div class="lm-popup-row"><strong>Route:</strong> ${escapeHtml(bus.route_name || '—')}</div>
                ${bus.driver_phone ? `<div class="lm-popup-row"><strong>Phone:</strong> <a href="tel:${escapeHtml(bus.driver_phone)}">${escapeHtml(bus.driver_phone)}</a></div>` : ''}
                ${bus.speed > 0 ? `<div class="lm-popup-row"><strong>Speed:</strong> ${bus.speed} km/h</div>` : ''}
                <div class="lm-popup-time"><i class="far fa-clock"></i> Updated: ${t}</div>
            </div>`;
        }

        function escapeHtml(str) {
            const d = document.createElement('div');
            d.textContent = str == null ? '' : String(str);
            return d.innerHTML;
        }

        function animateMarker(marker, newLat, newLng) {
            const start = marker.getLatLng();
            const dLat = newLat - start.lat;
            const dLng = newLng - start.lng;
            if (Math.abs(dLat) < 0.00001 && Math.abs(dLng) < 0.00001) return marker.setLatLng([newLat, newLng]);
            let step = 0, steps = 25;
            const iv = setInterval(() => {
                step++;
                marker.setLatLng([start.lat + dLat * step / steps, start.lng + dLng * step / steps]);
                if (step >= steps) { clearInterval(iv); marker.setLatLng([newLat, newLng]); }
            }, 40);
        }

        window.updateBusOnMap = function (bus) {
            if (!bus || !bus.latitude || !bus.longitude) return;
            const lat = parseFloat(bus.latitude), lng = parseFloat(bus.longitude);
            if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
            const tid = bus.trip_id;
            const color = bus.trip_type === 'drop' ? '#10b981' : '#2563eb';

            if (markers[tid]) {
                animateMarker(markers[tid].marker, lat, lng);
                markers[tid].marker.setPopupContent(buildPopup(bus));
                markers[tid].busData = bus;
            } else {
                const m = L.marker([lat, lng], { icon: busIcon(color) })
                    .addTo(map)
                    .bindPopup(buildPopup(bus), { maxWidth: 260 });
                m.on('click', () => {
                    document.querySelectorAll('.lm-bus-card').forEach(c => c.classList.remove('lm-selected'));
                    const card = document.getElementById(`lm-card-${tid}`);
                    if (card) card.classList.add('lm-selected');
                });
                markers[tid] = { marker: m, busData: bus };
            }
            updateCardTime(tid, bus.last_location_at);
        };

        window.fitAllMarkers = function () {
            const keys = Object.keys(markers);
            if (!keys.length) return;
            const bounds = L.latLngBounds(keys.map(k => markers[k].marker.getLatLng()));
            map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
        };

        function updateCardTime(tid, ts) {
            const el = document.getElementById(`lm-time-${tid}`);
            if (el && ts) el.innerHTML = `<i class="far fa-clock"></i> ${new Date(ts).toLocaleTimeString('en-IN')}`;
        }

        window.selectBus = function (tid) {
            if (!markers[tid]) return;
            document.querySelectorAll('.lm-bus-card').forEach(c => c.classList.remove('lm-selected'));
            const card = document.getElementById(`lm-card-${tid}`);
            if (card) card.classList.add('lm-selected');
            map.setView(markers[tid].marker.getLatLng(), 15, { animate: true });
            markers[tid].marker.openPopup();
        };

        function renderBuses(buses) {
            const container = document.getElementById('busListContainer');
            const badge = document.getElementById('activeBusCount');
            badge.innerHTML = `<span class="lm-pulse"></span> ${buses.length} Active`;

            if (!buses.length) {
                container.innerHTML = `<div class="lm-empty">
                    <i class="fas fa-bus-slash"></i>
                    <p><strong>No active buses right now</strong></p>
                    <p>Active driver trips will appear here automatically.</p>
                </div>`;
                return;
            }

            container.innerHTML = buses.map(b => {
                const t = b.last_location_at ? new Date(b.last_location_at).toLocaleTimeString('en-IN') : 'Active';
                const isDropTrip = b.trip_type === 'drop';
                return `<div class="lm-bus-card ${isDropTrip ? 'drop-trip' : ''}" id="lm-card-${b.trip_id}" onclick="selectBus(${b.trip_id})">
                    <div class="lm-bus-top">
                        <div>
                            <div class="lm-bus-num"><i class="fas fa-bus me-1" style="color:${isDropTrip ? '#10b981' : '#3b82f6'}"></i>${escapeHtml(b.vehicle_number || 'Bus')}</div>
                            <div class="lm-bus-driver"><i class="fas fa-user-circle me-1"></i>${escapeHtml(b.driver_name || '—')}</div>
                        </div>
                        <span class="lm-live-dot">LIVE</span>
                    </div>
                    <div class="lm-bus-meta">
                        <span><i class="fas fa-route me-1"></i>${escapeHtml(b.route_name || '—')}</span>
                        <span id="lm-time-${b.trip_id}"><i class="far fa-clock me-1"></i>${t}</span>
                    </div>
                </div>`;
            }).join('');

            buses.forEach(b => updateBusOnMap(b));
            fitAllMarkers();
        }

        window.fetchLiveBuses = async function () {
            try {
                const res = await fetch('/api/gps/live-buses');
                const data = await res.json();
                if (data.success && Array.isArray(data.buses)) {
                    renderBuses(data.buses);
                } else {
                    document.getElementById('busListContainer').innerHTML = `<div class="lm-empty">
                        <i class="fas fa-bus-slash"></i><p>No active buses</p></div>`;
                }
                document.getElementById('lastRefreshedTime').textContent = `Updated: ${new Date().toLocaleTimeString('en-IN')}`;
            } catch (err) {
                console.error('[GPS Fetch Error]:', err);
            }
        };

        try {
            const socket = io({ withCredentials: true });
            socket.on('connect', () => {
                socket.emit('join_school_trips');
                document.getElementById('connBadge').innerHTML = '<span class="lm-pulse"></span> Live';
            });
            socket.on('school_trip_location_updated', updateBusOnMap);
            socket.on('bus_location_update', updateBusOnMap);
            socket.on('disconnect', () => {
                document.getElementById('connBadge').innerHTML = '🔴 Reconnecting...';
                document.getElementById('connBadge').style.color = '#dc2626';
            });
            socket.on('connect', () => {
                document.getElementById('connBadge').style.color = '#047857';
            });
        } catch (e) {
            console.error('[GPS Socket Error]:', e);
        }

        document.getElementById('busSearchInput').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.lm-bus-card').forEach(card => {
                card.style.display = card.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });

        fetchLiveBuses();
        setInterval(fetchLiveBuses, 30000);
    })();
</script>