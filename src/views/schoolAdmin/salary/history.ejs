<%- include('../../partials/head', { title: `${lan.Salary_Payment_History || 'Salary Payment History'} | SchoolSync` }) %>
<style>
    .salary-nav-tabs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid #E2E8F0;
        padding-bottom: 10px;
        margin-bottom: 16px;
    }
    .salary-nav-tab {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 8px 16px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        border-radius: 8px;
        color: #64748B;
        transition: all 0.2s ease;
    }
    .salary-nav-tab:hover {
        background: #F1F5F9;
        color: #0F172A;
    }
    .salary-nav-tab.active {
        background: #ECFDF5;
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .badge-teacher {
        background: rgba(67, 56, 202, 0.12) !important;
        color: #4338CA !important;
        border-color: rgba(67, 56, 202, 0.2) !important;
    }
    .badge-librarian {
        background: rgba(219, 39, 119, 0.12) !important;
        color: #DB2777 !important;
        border-color: rgba(219, 39, 119, 0.2) !important;
    }
    .badge-driver {
        background: rgba(14, 165, 233, 0.12) !important;
        color: #0284C7 !important;
        border-color: rgba(14, 165, 233, 0.2) !important;
    }
    .badge-role-other {
        background: rgba(245, 158, 11, 0.12) !important;
        color: #D97706 !important;
        border-color: rgba(245, 158, 11, 0.2) !important;
    }

    .salary-filter-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        align-items: flex-end;
    }

    @media (max-width: 768px) {
        .schooladmin-theme .content {
            padding: 12px 10px !important;
        }
        .salary-header-block {
            margin-bottom: 14px !important;
        }
        .salary-nav-tabs {
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 4px !important;
            padding-bottom: 8px !important;
        }
        .salary-nav-tab {
            padding: 7px 4px !important;
            font-size: 9.5px !important;
            justify-content: center !important;
            text-align: center !important;
        }
        .salary-filter-card {
            padding: 14px !important;
            border-radius: 12px !important;
            margin-bottom: 14px !important;
        }
        .salary-filter-grid {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }
        .salary-btn-group {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 8px !important;
            width: 100% !important;
        }
        .salary-btn-group .btn {
            height: 38px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 12px !important;
        }
        .table-card {
            border-radius: 12px !important;
        }
        .table-container {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
        }
        .data-table {
            min-width: 820px !important;
            width: 100% !important;
        }
        .data-table th,
        .data-table td {
            padding: 8px 10px !important;
            font-size: 12px !important;
            white-space: nowrap !important;
        }
    }

    /* Dark Mode */
    [data-theme="dark"] .salary-nav-tab,
    .light-mode-disabled .salary-nav-tab {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .salary-nav-tab:hover,
    .light-mode-disabled .salary-nav-tab:hover {
        background: #1E293B !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .salary-nav-tab.active,
    .light-mode-disabled .salary-nav-tab.active {
        background: rgba(16, 185, 129, 0.15) !important;
        color: #34D399 !important;
        border-color: rgba(16, 185, 129, 0.3) !important;
    }
    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .card select,
    .light-mode-disabled .card select,
    [data-theme="dark"] .card input,
    .light-mode-disabled .card input {
        background: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .table-card,
    .light-mode-disabled .table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table-header-row,
    .light-mode-disabled .table-header-row {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .table-heading,
    .light-mode-disabled .table-heading {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .data-table thead th,
    .light-mode-disabled .data-table thead th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .data-table tbody td,
    .light-mode-disabled .data-table tbody td {
        border-color: #242F4D !important;
        color: #E2E8F0 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 salary-header-block">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Salary_Payment_History || 'Salary Payment History' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Salary_Payment_History_Desc || 'Review historical salary payments and receipts issued to staff' %></p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="salary-nav-tabs">
                <a href="/schooladmin/salary/monthly" class="salary-nav-tab"><%- lan.Monthly_Salaries || 'Monthly Salaries' %></a>
                <a href="/schooladmin/salary/structures" class="salary-nav-tab"><%- lan.Salary_Structures || 'Salary Structures' %></a>
                <a href="/schooladmin/salary/history" class="salary-nav-tab active"><%- lan.Payment_History || 'Payment History' %></a>
            </div>
            <div class="card p-5 mb-4 salary-filter-card">
                <form method="GET" action="/schooladmin/salary/history" class="salary-filter-grid">
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Staff_Member || 'Staff Member' %></label>
                        <select name="user_id" class="form-select">
                            <option value=""><%- lan.All_Users || 'All Users' %></option>
                            <% users.forEach(u => { %>
                                <option value="<%= u.id %>" <%= filters.user_id == u.id ? 'selected' : '' %>>
                                    <%= u.first_name %> <%= u.last_name %> (<%= u.role.toUpperCase() %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.Start_Date || 'Start Date' %></label>
                        <input type="date" name="start_date" value="<%= filters.start_date || '' %>" class="form-input">
                    </div>
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%- lan.End_Date || 'End Date' %></label>
                        <input type="date" name="end_date" value="<%= filters.end_date || '' %>" class="form-input">
                    </div>
                    <div class="salary-btn-group flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-1">
                            <i class="fas fa-filter mr-1"></i> <%- lan.Filter || 'Filter' %>
                        </button>
                        <a href="/schooladmin/salary/history" class="btn btn-secondary btn-sm flex-1 text-center flex items-center justify-center">
                            <%- lan.Reset || 'Reset' %>
                        </a>
                    </div>
                </form>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider"><%- lan.Salary_Payment_Transactions || 'Salary Payment Transactions' %></h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th><%- lan.Staff_Name || 'Staff Name' %></th>
                                <th><%- lan.Role || 'Role' %></th>
                                <th><%- lan.Salary_Month || 'Salary Month' %></th>
                                <th><%- lan.Paid_Amount || 'Paid Amount' %></th>
                                <th><%- lan.Payment_Date || 'Payment Date' %></th>
                                <th><%- lan.Method || 'Method' %></th>
                                <th><%- lan.Receipt_No || 'Receipt No' %></th>
                                <th><%- lan.Timestamp || 'Timestamp' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!payments || payments.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center py-12 text-gray-400 font-medium"><%- lan.No_Salary_Payment_Logs || 'No salary payment logs match the selected filters.' %></td>
                                </tr>
                            <% } %>
                            <% (payments||[]).forEach(p => {
                                const initials = ((p.first_name ? p.first_name[0] : '') + (p.last_name ? p.last_name[0] : '') || '?').toUpperCase();
                            %>
                                <tr>
                                    <td style="white-space: nowrap;">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 bg-emerald-50 text-emerald-700 rounded-full flex items-center justify-center font-bold text-xs border border-emerald-100/30">
                                                <%= initials %>
                                            </div>
                                            <div class="font-bold text-gray-800 text-[13px]"><%= p.first_name %> <%= p.last_name %></div>
                                        </div>
                                    </td>
                                    <td style="white-space: nowrap;">
                                        <% 
                                            let roleClass = 'badge-role-other';
                                            if (p.role === 'teacher') roleClass = 'badge-teacher';
                                            else if (p.role === 'librarian') roleClass = 'badge-librarian';
                                            else if (p.role === 'driver') roleClass = 'badge-driver';
                                        %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide border <%= roleClass %>" style="white-space: nowrap;">
                                            <%= p.role %>
                                        </span>
                                    </td>
                                    <td class="font-mono font-semibold text-slate-600 text-[13px]" style="white-space: nowrap;"><%= p.salary_month %></td>
                                    <td class="font-bold text-emerald-700" style="white-space: nowrap;">₹<%= parseFloat(p.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="font-medium text-slate-700" style="white-space: nowrap;"><%= p.payment_date ? new Date(p.payment_date).toLocaleDateString('en-IN') : '—' %></td>
                                    <td style="white-space: nowrap;">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-slate-100 text-slate-700 border border-slate-200/50" style="white-space: nowrap;">
                                            <%= p.payment_method.replace('_', ' ') %>
                                        </span>
                                    </td>
                                    <td class="font-mono text-xs font-semibold text-gray-600" style="white-space: nowrap;"><%= p.receipt_no || '—' %></td>
                                    <td class="text-xs text-gray-400" style="white-space: nowrap;"><%= p.created_at ? new Date(p.created_at).toLocaleString('en-IN') : '—' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
