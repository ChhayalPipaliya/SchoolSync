<%- include('../../partials/head', { title: `${lan.Salary_Payroll_Details || 'Salary Payroll Details'} | SchoolSync` }) %>
<style>
    @media (max-width: 768px) {
        .schooladmin-theme .content {
            padding: 12px 10px !important;
        }
        .salary-pay-header {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 12px !important;
            margin-bottom: 14px !important;
        }
        .salary-pay-header a.btn {
            width: 100% !important;
            justify-content: center !important;
            padding: 10px !important;
        }
        .table-card {
            border-radius: 12px !important;
        }
        .table-container {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
        }
        .data-table {
            min-width: 600px !important;
            width: 100% !important;
        }
        .data-table th,
        .data-table td {
            padding: 8px 10px !important;
            font-size: 12px !important;
            white-space: nowrap !important;
        }
    }

    /* Dark Mode */
    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .card select,
    .light-mode-disabled .card select,
    [data-theme="dark"] .card input,
    .light-mode-disabled .card input {
        background: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .table-card,
    .light-mode-disabled .table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table-header-row,
    .light-mode-disabled .table-header-row {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .table-heading,
    .light-mode-disabled .table-heading {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .data-table thead th,
    .light-mode-disabled .data-table thead th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .data-table tbody td,
    .light-mode-disabled .data-table tbody td {
        border-color: #242F4D !important;
        color: #E2E8F0 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 salary-pay-header">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Salary_Payroll_Details || 'Salary Payroll Details' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Salary_Payroll_Details_Desc || 'Record payments and review transaction logs for staff member' %></p>
                </div>
                <a href="/schooladmin/salary/monthly" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Monthly_List || 'Back to Monthly List' %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <%
                const total = parseFloat(salary.total_amount);
                const paid = parseFloat(salary.paid_amount);
                const remaining = total - paid;
                const today = new Date().toISOString().slice(0, 10);
            %>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 space-y-6">
                    <div class="card p-6">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4"><%- lan.Staff_And_Month_Details || 'Staff & Month Details' %></h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 bg-emerald-50 text-emerald-700 rounded-full flex items-center justify-center font-bold text-sm border border-emerald-100/30">
                                    <%= ((salary.first_name ? salary.first_name[0] : '') + (salary.last_name ? salary.last_name[0] : '') || '?').toUpperCase() %>
                                </div>
                                <div>
                                    <div class="font-bold text-gray-800 text-[15px]"><%= salary.first_name %> <%= salary.last_name %></div>
                                    <div class="text-xs text-gray-400 mt-0.5"><%= salary.email %></div>
                                </div>
                            </div>
                            <div class="space-y-2 text-xs font-medium text-slate-600">
                                <div class="flex justify-between">
                                    <span><%- lan.Designation_Slash_Role || 'Designation / Role' %>:</span>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide border bg-indigo-50 text-indigo-700 border-indigo-100"><%= salary.role %></span>
                                </div>
                                <div class="flex justify-between">
                                    <span><%- lan.Payroll_Month || 'Payroll Month' %>:</span>
                                    <span class="font-bold text-slate-700"><%= salary.salary_month %></span>
                                </div>
                                <div class="flex justify-between">
                                    <span><%- lan.Current_Status || 'Current Status' %>:</span>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase border
                                        <%= salary.status === 'paid' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 
                                           salary.status === 'partial' ? 'bg-blue-50 text-blue-700 border-blue-100' : 
                                           'bg-amber-50 text-amber-700 border-amber-100' %>">
                                        <%= salary.status %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% if (salary.status !== 'paid') { %>
                        <div class="card p-6">
                            <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4"><%- lan.Record_New_Payment || 'Record New Payment' %></h3>
                            <form method="POST" action="/schooladmin/salary/pay/<%= salary.id %>" class="space-y-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="form-group">
                                        <label for="amount" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Payment_Amount_INR || 'Payment Amount (INR)' %> *</label>
                                        <input type="number" id="amount" name="amount" value="<%= remaining.toFixed(2) %>" min="1" max="<%= (remaining + 0.01).toFixed(2) %>" step="0.01" required class="form-input w-full" placeholder="e.g., <%= remaining.toFixed(2) %>">
                                        <p class="text-[10px] text-gray-400 mt-1.5">Max remaining: ₹<%= remaining.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
                                    </div>

                                    <div class="form-group">
                                        <label for="payment_date" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Payment_Date || 'Payment Date' %> *</label>
                                        <input type="date" id="payment_date" name="payment_date" value="<%= today %>" required class="form-input w-full">
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="form-group">
                                        <label for="payment_method" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Payment_Method || 'Payment Method' %> *</label>
                                        <select id="payment_method" name="payment_method" required class="form-select w-full">
                                            <option value="cash"><%- lan.Cash || 'Cash' %></option>
                                            <option value="bank_transfer"><%- lan.Bank_Transfer || 'Bank Transfer' %></option>
                                            <option value="online"><%- lan.Online_Payment || 'Online Payment' %></option>
                                            <option value="upi"><%- lan.UPI || 'UPI' %></option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="receipt_no" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Receipt_Reference_No || 'Receipt / Reference No.' %></label>
                                        <input type="text" id="receipt_no" name="receipt_no" class="form-input w-full" placeholder="e.g., TXN123456789">
                                    </div>
                                </div>
                                <div class="pt-3 border-t border-slate-100 flex justify-end">
                                    <button type="submit" class="btn btn-primary px-6 py-2.5 font-semibold">
                                        <i class="fa-solid fa-check mr-1.5"></i> <%- lan.Submit_Payment || 'Submit Payment' %>
                                    </button>
                                </div>
                            </form>
                        </div>
                    <% } else { %>
                        <div class="p-6 rounded-lg bg-emerald-50 border border-emerald-200/50 flex gap-3 text-emerald-800 text-xs">
                            <i class="fa-solid fa-circle-check fa-lg mt-0.5 text-emerald-600"></i>
                            <div>
                                <span class="font-bold block mb-1"><%- lan.Payment_Completed || 'Payment Completed' %></span>
                                <%- lan.Monthly_Salary_Fully_Paid_Notice || 'This monthly salary has been fully paid. No further payments can be recorded for this month.' %>
                            </div>
                        </div>
                    <% } %>
                    <div class="table-card">
                        <div class="table-header-row bg-slate-50/20">
                            <h4 class="table-heading uppercase tracking-wider"><%- lan.Payments_Logs_For_Month || 'Payments Logs for this Month' %></h4>
                        </div>
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th><%- lan.Date || 'Date' %></th>
                                        <th><%- lan.Amount || 'Amount' %></th>
                                        <th><%- lan.Method || 'Method' %></th>
                                        <th><%- lan.Receipt_No || 'Receipt No' %></th>
                                        <th><%- lan.Recorded_At || 'Recorded At' %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!payments || payments.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-8 text-gray-400 font-medium"><%- lan.No_Payments_Recorded_Month || 'No payments have been recorded for this month yet.' %></td>
                                        </tr>
                                    <% } %>
                                    <% (payments||[]).forEach(p => { %>
                                        <tr>
                                            <td class="font-medium text-slate-700"><%= p.payment_date ? new Date(p.payment_date).toLocaleDateString('en-IN') : '—' %></td>
                                            <td class="font-bold text-slate-800">₹<%= parseFloat(p.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                            <td>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-slate-100 text-slate-700 border border-slate-200/50">
                                                    <%= p.payment_method.replace('_', ' ') %>
                                                </span>
                                            </td>
                                            <td class="font-mono text-xs font-semibold text-gray-600"><%= p.receipt_no || '—' %></td>
                                            <td class="text-xs text-gray-400"><%= p.created_at ? new Date(p.created_at).toLocaleString('en-IN') : '—' %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="card p-6 sticky top-6">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4"><%- lan.Financial_Summary || 'Financial Summary' %></h3>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center py-2 border-b border-slate-100">
                                <span class="text-xs font-bold text-slate-500"><%- lan.Total_Base_Salary || 'Total Base Salary' %></span>
                                <span class="text-sm font-bold text-slate-800">₹<%= total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                            </div>
                            <div class="flex justify-between items-center py-2 border-b border-slate-100">
                                <span class="text-xs font-bold text-slate-500"><%- lan.Total_Paid_Amount || 'Total Paid Amount' %></span>
                                <span class="text-sm font-bold text-emerald-600">₹<%= paid.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                            </div>
                            <div class="flex justify-between items-center py-2">
                                <span class="text-xs font-bold text-slate-500"><%- lan.Remaining_Balance || 'Remaining Balance' %></span>
                                <span class="text-sm font-bold text-rose-600">₹<%= remaining.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                            </div>
                        </div>
                        <%  const percentage = total > 0 ? (paid / total) * 100 : 0; %>
                        <div class="mt-6">
                            <div class="flex justify-between items-center text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2">
                                <span><%- lan.Payout_Progress || 'Payout progress' %></span>
                                <span><%= percentage.toFixed(0) %>%</span>
                            </div>
                            <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 rounded-full salary-progress-bar" data-rate="<%= percentage %>"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.salary-progress-bar').forEach(function(el) {
            var rate = el.getAttribute('data-rate') || 0;
            el.style.width = rate + '%';
        });
    });
</script>