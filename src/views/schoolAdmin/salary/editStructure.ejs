<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Edit Salary Structure</h2>
                    <p class="text-xs text-gray-500 mt-1">Modify base monthly salary amount for a staff member</p>
                </div>
                <a href="/schooladmin/salary/structures" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-arrow-left"></i> Back to Structures
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card max-w-xl mx-auto p-6">
                <form method="POST" action="/schooladmin/salary/structures/edit/<%= structure.id %>" class="space-y-5">
                    <div class="p-4 bg-slate-50 border border-slate-100 rounded-lg space-y-2 mb-2">
                        <div class="flex justify-between items-center text-xs">
                            <span class="font-bold text-slate-400 uppercase tracking-wider">Employee Name</span>
                            <span class="font-bold text-slate-800"><%= structure.first_name %> <%= structure.last_name %></span>
                        </div>
                        <div class="flex justify-between items-center text-xs">
                            <span class="font-bold text-slate-400 uppercase tracking-wider">Designation / Role</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide border bg-emerald-50 text-emerald-700 border-emerald-100"><%= structure.role %></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="amount" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Monthly Amount (INR) *</label>
                        <input type="number" id="amount" name="amount" value="<%= structure.amount %>" min="1" step="0.01" required class="form-input w-full" placeholder="e.g., 25000">
                        <p class="text-[10px] text-gray-400 mt-1.5">Enter a valid positive number for the base monthly pay.</p>
                    </div>
                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1 py-2.5 font-semibold">
                            <i class="fa-solid fa-save mr-1.5"></i> Update Structure
                        </button>
                        <a href="/schooladmin/salary/structures" class="btn btn-secondary flex-1 py-2.5 font-semibold text-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>