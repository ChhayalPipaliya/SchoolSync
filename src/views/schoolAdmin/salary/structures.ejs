<%- include('../../partials/head', { title: `${lan.Salary_Structures || 'Salary Structures'} | SchoolSync` }) %>
<style>
    .salary-nav-tabs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid #E2E8F0;
        padding-bottom: 10px;
        margin-bottom: 16px;
    }
    .salary-nav-tab {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 8px 16px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        border-radius: 8px;
        color: #64748B;
        transition: all 0.2s ease;
    }
    .salary-nav-tab:hover {
        background: #F1F5F9;
        color: #0F172A;
    }
    .salary-nav-tab.active {
        background: #ECFDF5;
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .badge-teacher {
        background: rgba(67, 56, 202, 0.12) !important;
        color: #4338CA !important;
        border-color: rgba(67, 56, 202, 0.2) !important;
    }
    .badge-librarian {
        background: rgba(219, 39, 119, 0.12) !important;
        color: #DB2777 !important;
        border-color: rgba(219, 39, 119, 0.2) !important;
    }
    .badge-driver {
        background: rgba(14, 165, 233, 0.12) !important;
        color: #0284C7 !important;
        border-color: rgba(14, 165, 233, 0.2) !important;
    }
    .badge-role-other {
        background: rgba(245, 158, 11, 0.12) !important;
        color: #D97706 !important;
        border-color: rgba(245, 158, 11, 0.2) !important;
    }

    @media (max-width: 768px) {
        .schooladmin-theme .content {
            padding: 12px 10px !important;
        }
        .salary-header-block {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 12px !important;
            margin-bottom: 14px !important;
        }
        .salary-header-block a.btn {
            width: 100% !important;
            justify-content: center !important;
            padding: 10px !important;
        }
        .salary-nav-tabs {
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 4px !important;
            padding-bottom: 8px !important;
        }
        .salary-nav-tab {
            padding: 7px 4px !important;
            font-size: 9.5px !important;
            justify-content: center !important;
            text-align: center !important;
        }
        .table-card {
            border-radius: 12px !important;
        }
        .table-container {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
        }
        .data-table {
            min-width: 760px !important;
            width: 100% !important;
        }
        .data-table th,
        .data-table td {
            padding: 8px 10px !important;
            font-size: 12px !important;
            white-space: nowrap !important;
        }
    }

    /* Dark Mode */
    [data-theme="dark"] .salary-nav-tab,
    .light-mode-disabled .salary-nav-tab {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .salary-nav-tab:hover,
    .light-mode-disabled .salary-nav-tab:hover {
        background: #1E293B !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .salary-nav-tab.active,
    .light-mode-disabled .salary-nav-tab.active {
        background: rgba(16, 185, 129, 0.15) !important;
        color: #34D399 !important;
        border-color: rgba(16, 185, 129, 0.3) !important;
    }
    [data-theme="dark"] .table-card,
    .light-mode-disabled .table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .table-header-row,
    .light-mode-disabled .table-header-row {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .table-heading,
    .light-mode-disabled .table-heading {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .data-table thead th,
    .light-mode-disabled .data-table thead th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .data-table tbody td,
    .light-mode-disabled .data-table tbody td {
        border-color: #242F4D !important;
        color: #E2E8F0 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4 salary-header-block">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Salary_Management || 'Salary Management' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Salary_Management_Desc || 'Configure staff salaries, generate monthly payrolls, and track payments' %></p>
                </div>
                <a href="/schooladmin/salary/structures/add" class="btn btn-primary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-plus"></i> <%- lan.Define_Structure || 'Define Structure' %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="salary-nav-tabs">
                <a href="/schooladmin/salary/monthly" class="salary-nav-tab"><%- lan.Monthly_Salaries || 'Monthly Salaries' %></a>
                <a href="/schooladmin/salary/structures" class="salary-nav-tab active"><%- lan.Salary_Structures || 'Salary Structures' %></a>
                <a href="/schooladmin/salary/history" class="salary-nav-tab"><%- lan.Payment_History || 'Payment History' %></a>
            </div>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider"><%- lan.Active_Salary_Structures || 'Active Salary Structures' %></h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th><%- lan.User_Details || 'User Details' %></th>
                                <th><%- lan.Role || 'Role' %></th>
                                <th><%- lan.Email_Address || 'Email Address' %></th>
                                <th><%- lan.Monthly_Salary || 'Monthly Salary' %></th>
                                <th><%- lan.Configured_On || 'Configured On' %></th>
                                <th class="text-center"><%- lan.Actions || 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!structures || structures.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center py-12 text-gray-400 font-medium">
                                        <div class="flex flex-col items-center justify-center gap-2">
                                            <i class="fa-solid fa-money-check fa-2x text-gray-200"></i>
                                            <span><%- lan.No_Salary_Structures_Defined || 'No salary structures defined.' %></span>
                                            <a href="/schooladmin/salary/structures/add" class="text-emerald-600 font-bold hover:underline mt-1"><%- lan.Define_First_Structure || 'Define first structure' %></a>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            <% (structures||[]).forEach((s, i) => {
                                const initials = ((s.first_name ? s.first_name[0] : '') + (s.last_name ? s.last_name[0] : '')) || '?';
                            %>
                                <tr>
                                    <td style="white-space: nowrap;">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 bg-emerald-50 text-emerald-700 rounded-full flex items-center justify-center font-bold text-xs border border-emerald-100/30">
                                                <%= initials.toUpperCase() %>
                                            </div>
                                            <div>
                                                <div class="font-bold text-gray-800 text-[13px]"><%= s.first_name %> <%= s.last_name %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="white-space: nowrap;">
                                        <% 
                                            let roleClass = 'badge-role-other';
                                            if (s.role === 'teacher') roleClass = 'badge-teacher';
                                            else if (s.role === 'librarian') roleClass = 'badge-librarian';
                                            else if (s.role === 'driver') roleClass = 'badge-driver';
                                        %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide border <%= roleClass %>" style="white-space: nowrap;">
                                            <%= s.role %>
                                        </span>
                                    </td>
                                    <td class="font-medium text-gray-700" style="white-space: nowrap;"><%= s.email %></td>
                                    <td class="font-bold text-slate-800" style="white-space: nowrap;">₹<%= parseFloat(s.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="font-medium text-gray-600" style="white-space: nowrap;"><%= s.created_at ? new Date(s.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %></td>
                                    <td class="text-center" style="white-space: nowrap;">
                                        <div class="flex items-center justify-center gap-1.5" style="white-space: nowrap;">
                                            <a href="/schooladmin/salary/structures/edit/<%= s.id %>" class="btn-icon btn-edit-icon" title="<%= lan.Edit || 'Edit' %>">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form method="POST" action="/schooladmin/salary/structures/delete/<%= s.id %>" class="inline-block m-0 delete-structure-form" data-confirm="<%- lan.Delete_Salary_Structure_Confirm || 'Delete this salary structure?' %>">
                                                <button type="submit" class="btn-icon btn-danger-icon" title="<%= lan.Delete || 'Delete' %>">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<script>
    document.querySelectorAll('.delete-structure-form').forEach(form => {
        form.addEventListener('submit', function (e) {
            const msg = this.getAttribute('data-confirm') || 'Delete this salary structure?';
            if (!confirm(msg)) {
                e.preventDefault();
            }
        });
    });
</script>