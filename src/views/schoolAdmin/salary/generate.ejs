<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <!-- Header Section -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Generate Monthly Salaries</h2>
                    <p class="text-xs text-gray-500 mt-1">Batch generate pending payroll records for all staff with salary structures</p>
                </div>
                <a href="/schooladmin/salary/monthly" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-arrow-left"></i> Back to Monthly List
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Form Card -->
            <div class="card max-w-xl mx-auto p-6">
                <form method="POST" action="/schooladmin/salary/generate" class="space-y-6">
                    <div class="p-4 rounded-lg bg-amber-50 border border-amber-200/50 flex gap-3 text-amber-800 text-xs">
                        <i class="fa-solid fa-circle-exclamation fa-lg mt-0.5 text-amber-600"></i>
                        <div>
                            <span class="font-bold block mb-1">Important Payroll Information</span>
                            This action will create monthly salary records for all active teachers, drivers and librarians who have a configured salary structure.
                            Records will start with a status of <strong class="uppercase text-amber-900">pending</strong>. If salaries are already generated for the chosen month, a warning will be displayed and no duplicates will be created.
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="salary_month" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Select Target Payroll Month *</label>
                        <input type="month" id="salary_month" name="salary_month" required class="form-input w-full" value="<%= new Date().toISOString().slice(0, 7) %>">
                        <p class="text-[10px] text-gray-400 mt-1.5">Choose the month and year for which you want to generate salaries.</p>
                    </div>

                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1 py-2.5 font-semibold">
                            <i class="fa-solid fa-gears mr-1.5"></i> Run Payroll Generation
                        </button>
                        <a href="/schooladmin/salary/monthly" class="btn btn-secondary flex-1 py-2.5 font-semibold text-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
