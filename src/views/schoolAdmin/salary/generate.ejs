<%- include('../../partials/head', { title: `${lan.Generate_Monthly_Salaries || 'Generate Monthly Salaries'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-gears"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Generate_Monthly_Salaries || 'Generate Monthly Salaries' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Generate_Monthly_Salaries_Desc || 'Batch generate pending payroll records for all staff with salary structures' %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <a href="/schooladmin/salary/monthly" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Monthly_List || 'Back to Monthly List' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card max-w-xl mx-auto p-6" style="border-radius: 12px; border: 1px solid #E2E8F0;">
                <form method="POST" action="/schooladmin/salary/generate" class="space-y-6">
                    <div class="p-4 rounded-lg bg-amber-50 border border-amber-200/50 flex gap-3 text-amber-800 text-xs">
                        <i class="fa-solid fa-circle-exclamation fa-lg mt-0.5 text-amber-600"></i>
                        <div>
                            <span class="font-bold block mb-1"><%- lan.Important_Payroll_Info || 'Important Payroll Information' %></span>
                            <%- lan.Payroll_Generation_Notice || 'This action will create monthly salary records for all active teachers, drivers and librarians who have a configured salary structure.' %>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="salary_month" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Select_Target_Payroll_Month || 'Select Target Payroll Month' %> *</label>
                        <input type="month" id="salary_month" name="salary_month" required class="form-input w-full" value="<%= new Date().toISOString().slice(0, 7) %>">
                        <p class="text-[10px] text-gray-400 mt-1.5"><%- lan.Target_Payroll_Month_Desc || 'Choose the month and year for which you want to generate salaries.' %></p>
                    </div>
                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1 py-2.5 font-semibold">
                            <i class="fa-solid fa-gears mr-1.5"></i> <%- lan.Run_Payroll_Generation || 'Run Payroll Generation' %>
                        </button>
                        <a href="/schooladmin/salary/monthly" class="btn btn-secondary flex-1 py-2.5 font-semibold text-center">
                            <%- lan.Cancel || 'Cancel' %>
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>