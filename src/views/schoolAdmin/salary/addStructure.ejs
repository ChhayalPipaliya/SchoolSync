<%- include('../../partials/head', { title: `${lan.Define_Salary_Structure || 'Define Salary Structure'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-plus"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Define_Salary_Structure || 'Define Salary Structure' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Define_Salary_Structure_Desc || 'Assign a fixed monthly salary amount to a teacher, driver or librarian' %></p>
                        </div>
                    </div>
                    <div>
                        <a href="/schooladmin/salary/structures" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Structures || 'Back to Structures' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card max-w-xl mx-auto p-6" style="border-radius: 12px; border: 1px solid #E2E8F0;">
                <form method="POST" action="/schooladmin/salary/structures/add" class="space-y-5">
                    <div class="form-group">
                        <label for="user_id" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Select_User || 'Select User' %> *</label>
                        <select id="user_id" name="user_id" required class="form-select w-full">
                            <option value=""><%- lan.Choose_Staff_Member || '-- Choose Staff Member --' %></option>
                            <% users.forEach(u => { %>
                                <option value="<%= u.id %>">
                                    <%= u.first_name %> <%= u.last_name %> (<%= u.role.toUpperCase() %> - <%= u.email %>)
                                </option>
                            <% }) %>
                        </select>
                        <p class="text-[10px] text-gray-400 mt-1.5"><%- lan.Active_Staff_Without_Structure_Notice || 'Only active staff members without salary structures are shown.' %></p>
                    </div>
                    <div class="form-group">
                        <label for="amount" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Monthly_Amount_INR || 'Monthly Amount (INR)' %> *</label>
                        <div class="relative">
                            <input type="number" id="amount" name="amount" min="1" step="0.01" required class="form-input w-full" placeholder="e.g., 25000">
                        </div>
                        <p class="text-[10px] text-gray-400 mt-1.5"><%- lan.Base_Monthly_Pay_Notice || 'Enter a valid positive number for the base monthly pay.' %></p>
                    </div>
                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1 py-2.5 font-semibold">
                            <i class="fa-solid fa-save mr-1.5"></i> <%- lan.Save_Structure || 'Save Structure' %>
                        </button>
                        <a href="/schooladmin/salary/structures" class="btn btn-secondary flex-1 py-2.5 font-semibold text-center">
                            <%- lan.Cancel || 'Cancel' %>
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
