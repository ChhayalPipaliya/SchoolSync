<%- include('../../partials/head', { title: `${lan.Define_Salary_Structure || 'Define Salary Structure'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Define_Salary_Structure || 'Define Salary Structure' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Define_Salary_Structure_Desc || 'Assign a fixed monthly salary amount to a teacher, driver or librarian' %></p>
                </div>
                <a href="/schooladmin/salary/structures" class="btn btn-secondary flex items-center justify-center gap-2 text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Structures || 'Back to Structures' %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card max-w-xl mx-auto p-6">
                <form method="POST" action="/schooladmin/salary/structures/add" class="space-y-5">
                    <div class="form-group">
                        <label for="user_id" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Select_User || 'Select User' %> *</label>
                        <select id="user_id" name="user_id" required class="form-select w-full">
                            <option value=""><%- lan.Choose_Staff_Member || '-- Choose Staff Member --' %></option>
                            <% users.forEach(u => { %>
                                <option value="<%= u.id %>">
                                    <%= u.first_name %> <%= u.last_name %> (<%= u.role.toUpperCase() %> - <%= u.email %>)
                                </option>
                            <% }) %>
                        </select>
                        <p class="text-[10px] text-gray-400 mt-1.5"><%- lan.Active_Staff_Without_Structure_Notice || 'Only active staff members without salary structures are shown.' %></p>
                    </div>
                    <div class="form-group">
                        <label for="amount" class="form-label font-bold text-xs text-gray-500 uppercase tracking-wider mb-2"><%- lan.Monthly_Amount_INR || 'Monthly Amount (INR)' %> *</label>
                        <div class="relative">
                            <input type="number" id="amount" name="amount" min="1" step="0.01" required class="form-input w-full" placeholder="e.g., 25000">
                        </div>
                        <p class="text-[10px] text-gray-400 mt-1.5"><%- lan.Base_Monthly_Pay_Notice || 'Enter a valid positive number for the base monthly pay.' %></p>
                    </div>
                    <div class="flex gap-3 pt-3 border-t border-slate-100">
                        <button type="submit" class="btn btn-primary flex-1 py-2.5 font-semibold">
                            <i class="fa-solid fa-save mr-1.5"></i> <%- lan.Save_Structure || 'Save Structure' %>
                        </button>
                        <a href="/schooladmin/salary/structures" class="btn btn-secondary flex-1 py-2.5 font-semibold text-center">
                            <%- lan.Cancel || 'Cancel' %>
                        </a>
                    </div>
                </form>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
