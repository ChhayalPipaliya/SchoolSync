                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-action-footer">
                                <p class="footer-help-text">
                                    <i class="fas fa-info-circle text-emerald-600"></i>
                                    <%- lan.Event_Store_Notice || 'All details and media will be stored in your school event gallery.' %>
                                </p>
                                <div class="footer-actions">
                                    <a href="/schooladmin/events" class="btn-cancel-action"><%- lan.Cancel || 'Cancel' %></a>
                                    <button type="submit" id="submitBtn" class="btn-submit-action">
                                        <i class="fas fa-check-circle"></i> <%- lan.Save_Event_Album || 'Save Event Album' %>
