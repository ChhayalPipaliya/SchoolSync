                                                <div>
                                                    <label class="setting-label-text" for="downloadSwitch"><%- lan.Allow_Non_Admins_Download || 'Allow Non-Admins to Download' %></label>
                                                    <p class="setting-subtext"><%- lan.Allow_Download_Desc || 'Teachers, students and parents can download photos and videos' %></p>
