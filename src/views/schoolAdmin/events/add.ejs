<%- include('../../partials/head', { title: 'Create Event Album | SchoolSync' }) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<style>
    h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', 'Inter', sans-serif !important;
    }
    .form-label {
        font-family: 'Inter', sans-serif !important;
        font-weight: 700 !important;
        color: #64748b !important;
        font-size: 11px !important;
        letter-spacing: 0.5px !important;
        text-transform: uppercase !important;
    }
    .premium-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px !important;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04) !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .premium-card:hover {
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08) !important;
        border-color: #cbd5e1;
    }
    .premium-card-header {
        border-bottom: 1px solid #f1f5f9 !important;
        padding: 20px 24px !important;
    }
    .dropzone-container {
        cursor: pointer;
        border: 2px dashed #cbd5e1 !important;
        border-radius: 16px !important;
        background-color: #f8fafc !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    .dropzone-container:hover {
        border-color: #059669 !important;
        background-color: #f0fdf4 !important;
    }
    .dropzone-container.dragover {
        border-color: #059669 !important;
        background-color: #d1fae5 !important;
        transform: scale(0.985);
    }
    .dropzone-icon {
        transition: transform 0.3s ease;
    }
    .dropzone-container:hover .dropzone-icon {
        transform: translateY(-4px);
    }
    .btn-premium-primary {
        background: #059669 !important;
        border-color: #059669 !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        border-radius: 10px !important;
        padding: 10px 24px !important;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.2) !important;
        transition: all 0.2s;
    }
    .btn-premium-primary:hover {
        background: #047857 !important;
        border-color: #047857 !important;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(5, 150, 105, 0.3) !important;
    }
    .btn-premium-secondary {
        background: #ffffff !important;
        border: 1.5px solid #e2e8f0 !important;
        color: #475569 !important;
        font-weight: 600 !important;
        border-radius: 10px !important;
        padding: 10px 24px !important;
        transition: all 0.2s;
    }
    .btn-premium-secondary:hover {
        background: #f8fafc !important;
        border-color: #cbd5e1 !important;
        color: #1e293b !important;
    }
    .btn-outline-premium {
        color: #059669 !important;
        border: 1.5px solid #059669 !important;
        background: transparent !important;
        font-weight: 600 !important;
        transition: all 0.2s;
    }
    .btn-outline-premium:hover {
        color: #ffffff !important;
        background-color: #059669 !important;
        border-color: #059669 !important;
    }
    .back-btn {
        border-radius: 10px !important;
        padding: 8px 16px !important;
        font-weight: 600 !important;
        color: #059669 !important;
        border-color: #059669 !important;
        background: transparent !important;
        transition: all 0.2s;
    }
    .back-btn:hover {
        color: #ffffff !important;
        background-color: #059669 !important;
        border-color: #059669 !important;
    }
    .form-input-premium {
        border-radius: 10px !important;
        padding: 11px 16px !important;
        border: 1.5px solid #e2e8f0 !important;
        background-color: #f8fafc !important;
        transition: all 0.2s !important;
    }
    .form-input-premium:focus {
        border-color: #059669 !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.1) !important;
    }
    .form-switch-premium .form-check-input {
        width: 2.8em !important;
        height: 1.5em !important;
        cursor: pointer;
        border: 1.5px solid #cbd5e1 !important;
        transition: all 0.2s ease !important;
    }
    .form-switch-premium .form-check-input:focus {
        box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.1) !important;
        border-color: #059669 !important;
    }
    .form-switch-premium .form-check-input:checked {
        background-color: #059669 !important;
        border-color: #059669 !important;
    }
    .preview-card {
        border-radius: 12px !important;
        border: 1px solid #e2e8f0 !important;
        transition: all 0.2s ease;
    }
    .preview-card:hover {
        border-color: #cbd5e1 !important;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05) !important;
    }
    .hover-delete:hover {
        background-color: #fee2e2 !important;
        color: #ef4444 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/events' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <%- include('../../partials/flashMessages') %>
            <div class="container-fluid py-4">
                <div class="mb-4">
                    <a href="/schooladmin/events" class="btn btn-sm btn-outline-secondary back-btn mb-3">
                        <i class="fas fa-arrow-left me-1"></i> Back to Gallery
                    </a>
                    <h1 class="h3 text-gray-800 font-weight-bold mb-1">Create Event Album</h1>
                    <p class="text-muted small">Fill in the event details and upload media files to create an album.</p>
                </div>
                <form id="createEventForm" class="row g-4" enctype="multipart/form-data">
                    <div class="col-lg-5">
                        <div class="premium-card mb-4">
                            <div class="premium-card-header bg-white border-bottom-0 py-3">
                                <h5 class="font-weight-bold mb-0 text-dark">Event Information</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="mb-3">
                                    <label class="form-label font-weight-bold text-secondary small">Event Title <span class="text-danger">*</span></label>
                                    <input type="text" name="title" class="form-control form-input-premium" placeholder="e.g. Annual Sports Meet 2026" required>
                                </div>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label font-weight-bold text-secondary small">Event Date <span class="text-danger">*</span></label>
                                        <input type="date" name="event_date" class="form-control form-input-premium" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label font-weight-bold text-secondary small">Category <span class="text-danger">*</span></label>
                                        <select name="event_type" class="form-select form-input-premium" required>
                                            <option value="" disabled selected>Select Category</option>
                                            <option value="Cultural">Cultural</option>
                                            <option value="Sports">Sports</option>
                                            <option value="Academic">Academic</option>
                                            <option value="Festival">Festival</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label font-weight-bold text-secondary small">Venue <span class="text-danger">*</span></label>
                                    <input type="text" name="venue" class="form-control form-input-premium" placeholder="e.g. School Gymnasium" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label font-weight-bold text-secondary small">Description</label>
                                    <textarea name="description" class="form-control form-input-premium" rows="4" placeholder="Brief details about the event..."></textarea>
                                </div>
                                <div class="card bg-light border-0 p-3 mb-2 rounded-3">
                                    <h6 class="font-weight-bold text-dark small mb-3">Permissions & Protection Settings</h6>
                                    <div class="form-check form-switch form-switch-premium mb-3">
                                        <input class="form-check-input" type="checkbox" id="downloadSwitch" name="download_allowed">
                                        <label class="form-check-label font-weight-bold text-secondary small ms-2" for="downloadSwitch">
                                            <i class="fas fa-download me-1 text-emerald-600"></i> Allow Non-Admins to Download
                                        </label>
                                        <div class="text-muted small mt-1" style="font-size: 11px; padding-left: 2px;">
                                            If off, non-admin roles (teachers, students, parents) can only view images and play videos; download buttons will be disabled.
                                        </div>
                                    </div>
                                    <div class="form-check form-switch form-switch-premium">
                                        <input class="form-check-input" type="checkbox" id="watermarkSwitch" name="watermark_enabled" checked>
                                        <label class="form-check-label font-weight-bold text-secondary small ms-2" for="watermarkSwitch">
                                            <i class="fas fa-copyright me-1 text-danger"></i> Enable Dynamic Image Watermarks
                                        </label>
                                        <div class="text-muted small mt-1" style="font-size: 11px; padding-left: 2px;">
                                            Imprints the viewer's Name, Role, and timestamp directly onto streamed images to discourage screenshot redistribution.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="premium-card h-100">
                            <div class="premium-card-header bg-white border-bottom-0 py-3">
                                <h5 class="font-weight-bold mb-0 text-dark">Album Media Upload</h5>
                            </div>
                            <div class="card-body p-4 d-flex flex-column h-100">
                                <div id="dropZone" class="dropzone-container d-flex flex-column align-items-center justify-content-center p-5 mb-4 transition-all duration-300">
                                    <i class="fas fa-cloud-upload-alt fa-3x text-emerald-600 mb-3 dropzone-icon"></i>
                                    <h6 class="font-weight-bold text-dark mb-1">Drag and drop images or videos here</h6>
                                    <p class="text-muted small mb-3">Images: up to 5MB (jpeg, png, webp) | Videos: up to 50MB (mp4, mov, avi)</p>
                                    <button type="button" class="btn btn-sm btn-outline-premium px-3 rounded-pill" onclick="document.getElementById('fileInput').click()">
                                        Browse Files
                                    </button>
                                    <input type="file" id="fileInput" name="media" multiple accept="image/*,video/*" class="d-none">
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="font-weight-bold text-dark small mb-3 d-none" id="selectedFilesTitle">Selected Files (<span id="fileCount">0</span>)</h6>
                                    <div id="previewContainer" class="row row-cols-1 g-3"></div>
                                </div>
                                <div id="progressWrapper" class="mt-4 d-none">
                                    <div class="d-flex justify-content-between mb-1 small text-muted font-weight-bold">
                                        <span>Uploading files...</span>
                                        <span id="progressPercent">0%</span>
                                    </div>
                                    <div class="progress" style="height: 10px; border-radius: 5px;">
                                        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                                    <a href="/schooladmin/events" class="btn btn-premium-secondary">Cancel</a>
                                    <button type="submit" id="submitBtn" class="btn btn-premium-primary">
                                        <i class="fas fa-save me-1"></i> Save Event Album
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const dropZone = document.getElementById("dropZone");
        const fileInput = document.getElementById("fileInput");
        const previewContainer = document.getElementById("previewContainer");
        const selectedFilesTitle = document.getElementById("selectedFilesTitle");
        const fileCount = document.getElementById("fileCount");
        const progressWrapper = document.getElementById("progressWrapper");
        const progressBar = document.getElementById("progressBar");
        const progressPercent = document.getElementById("progressPercent");
        const form = document.getElementById("createEventForm");
        const submitBtn = document.getElementById("submitBtn");

        let uploadedFiles = [];
        const formatBytes = (bytes) => {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const dm = 2;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
        };

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            }, false);
        });

        dropZone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            const files = dt.files;
            handleFiles(files);
        });

        fileInput.addEventListener('change', (e) => {
            handleFiles(e.target.files);
        });

        function handleFiles(files) {
            Array.from(files).forEach(file => {
                const ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
                const allowedImg = ['.jpg', '.jpeg', '.png', '.webp'];
                const allowedVid = ['.mp4', '.mov', '.avi'];
                const isImg = allowedImg.includes(ext);
                const isVid = allowedVid.includes(ext);

                if (!isImg && !isVid) {
                    alert(`File type not supported: ${file.name}`);
                    return;
                }

                if (isImg && file.size > 5 * 1024 * 1024) {
                    alert(`Image exceeds 5MB size limit: ${file.name}`);
                    return;
                }
                if (isVid && file.size > 50 * 1024 * 1024) {
                    alert(`Video exceeds 50MB size limit: ${file.name}`);
                    return;
                }

                uploadedFiles.push(file);
                renderPreview(file, uploadedFiles.length - 1);
            });

            updateFileCount();
        }

        function renderPreview(file, index) {
            const col = document.createElement("div");
            col.className = "col preview-item";
            col.dataset.index = index;

            const isVideo = file.type.startsWith("video/");
            
            let mediaIcon = `<i class="fas fa-file-image fa-2x text-emerald-600"></i>`;
            if (isVideo) {
                mediaIcon = `<i class="fas fa-file-video fa-2x text-danger"></i>`;
            }

            col.innerHTML = `
                <div class="preview-card bg-white p-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light p-2 rounded">
                                ${mediaIcon}
                            </div>
                            <div>
                                <h6 class="font-weight-bold text-dark mb-0 text-truncate" style="max-width: 250px;">${file.name}</h6>
                                <span class="text-muted small">${formatBytes(file.size)}</span>
                            </div>
                        </div>
                        <div class="flex-grow-1 mx-md-3" style="min-width: 200px;">
                            <input type="text" name="captions[]" class="form-control form-control-sm form-input-premium" placeholder="Add a caption for this media...">
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-light border hover-delete text-muted rounded-circle p-2" onclick="removeFile(${index})">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
            previewContainer.appendChild(col);
        }

        window.removeFile = (index) => {
            uploadedFiles = uploadedFiles.filter((_, i) => i !== index);
            
            previewContainer.innerHTML = "";
            uploadedFiles.forEach((file, i) => {
                renderPreview(file, i);
            });
            
            updateFileCount();
        };

        function updateFileCount() {
            const count = uploadedFiles.length;
            fileCount.textContent = count;
            if (count > 0) {
                selectedFilesTitle.classList.remove("d-none");
            } else {
                selectedFilesTitle.classList.add("d-none");
            }
        }

        form.addEventListener("submit", (e) => {
            e.preventDefault();

            if (form.reportValidity() === false) return;

            submitBtn.disabled = true;
            progressWrapper.classList.remove("d-none");

            const formData = new FormData();
            formData.append("title", form.elements["title"].value);
            formData.append("description", form.elements["description"].value);
            formData.append("event_date", form.elements["event_date"].value);
            formData.append("event_type", form.elements["event_type"].value);
            formData.append("venue", form.elements["venue"].value);
            formData.append("download_allowed", form.elements["download_allowed"].checked ? "1" : "0");
            formData.append("watermark_enabled", form.elements["watermark_enabled"].checked ? "1" : "0");

            uploadedFiles.forEach((file) => {
                formData.append("media", file);
            });

            const captionInputs = previewContainer.querySelectorAll("input[name='captions[]']");
            captionInputs.forEach(input => {
                formData.append("captions[]", input.value);
            });

            const xhr = new XMLHttpRequest();
            xhr.open("POST", "/schooladmin/events", true);

            xhr.upload.onprogress = (event) => {
                if (event.lengthComputable) {
                    const percent = Math.round((event.loaded / event.total) * 100);
                    progressBar.style.width = percent + "%";
                    progressBar.setAttribute("aria-valuenow", percent);
                    progressPercent.textContent = percent + "%";
                }
            };

            xhr.onload = () => {
                if (xhr.status >= 200 && xhr.status < 300) {
                    window.location.href = "/schooladmin/events";
                } else {
                    let errorMsg = "Failed to upload files.";
                    try {
                        const resJson = JSON.parse(xhr.responseText);
                        errorMsg = resJson.message || errorMsg;
                    } catch (err) {}
                    alert("Error: " + errorMsg);
                    submitBtn.disabled = false;
                    progressWrapper.classList.add("d-none");
                }
            };

            xhr.onerror = () => {
                alert("Network error occurred during upload.");
                submitBtn.disabled = false;
                progressWrapper.classList.add("d-none");
            };

            xhr.send(formData);
        });
    });
</script>
