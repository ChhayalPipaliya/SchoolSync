                                            <label class="switch-custom">
                                                <input type="checkbox" id="downloadSwitch" name="download_allowed" value="1">
                                                <span class="switch-slider"></span>
                                            </label>
                                        </div>
                                        <div class="setting-item-row">
                                            <div class="setting-info">
                                                <div class="setting-icon-pill icon-pill-rose">
                                                    <i class="fas fa-copyright"></i>
                                                </div>
                                                <div>
                                                    <label class="setting-label-text" for="watermarkSwitch"><%- lan.Dynamic_Image_Watermarks || 'Dynamic Image Watermarks' %></label>
                                                    <p class="setting-subtext"><%- lan.Watermark_Desc || 'Imprints viewer info onto images to prevent screenshot redistribution' %></p>
                                                </div>
                                            </div>
                                            <label class="switch-custom">
                                                <input type="checkbox" id="watermarkSwitch" name="watermark_enabled" value="1" checked>
                                                <span class="switch-slider"></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="form-card">
                                <div class="form-card-header">
                                    <h5 class="form-card-header-title">
                                        <span class="header-icon-box"><i class="fas fa-photo-film"></i></span>
                                        <%- lan.Album_Media_Upload || 'Album Media Upload' %>
                                    </h5>
                                    <span class="files-count-badge" id="headerCountBadge" data-txt-file="<%- lan.File || 'File' %>" data-txt-files="<%- lan.Files || 'Files' %>">0 <%- lan.Files || 'Files' %></span>
                                </div>
                                <div class="form-card-body">
                                    <div id="dropZone" class="dropzone-container">
                                        <div class="dropzone-icon-circle">
                                            <i class="fas fa-cloud-arrow-up"></i>
                                        </div>
                                        <h6 class="dropzone-title"><%- lan.Drag_Drop_Media || 'Drag and drop images or videos here' %></h6>
                                        <p class="dropzone-desc"><%- lan.Choose_Media_Desc || 'Choose high quality photos and recordings for this event' %></p>
                                        <button type="button" class="btn-browse" onclick="document.getElementById('fileInput').click()">
                                            <i class="fas fa-folder-open"></i> <%- lan.Browse_Files || 'Browse Files' %>
                                        </button>
                                        <input type="file" id="fileInput" name="media" multiple accept="image/*,video/*" class="d-none">
                                        
                                        <div class="dropzone-specs">
                                            <span class="spec-pill"><i class="fas fa-image text-emerald-600"></i> <%- lan.Images_Limit_Desc || 'Images up to 5MB (JPG, PNG, WEBP)' %></span>
                                            <span class="spec-pill"><i class="fas fa-video text-amber-600"></i> <%- lan.Videos_Limit_Desc || 'Videos up to 50MB (MP4, MOV, AVI)' %></span>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="selected-files-header d-none" id="selectedFilesHeader">
                                            <h6 class="selected-files-title">
                                                <span><%- lan.Selected_Files || 'Selected Files' %></span>
                                                <span class="files-count-badge" id="fileCount">0</span>
                                                <span class="text-muted small ms-1 font-normal" id="totalSizeLabel">(0 MB)</span>
                                            </h6>
                                            <button type="button" class="btn-clear-all" onclick="clearAllFiles()">
                                                <i class="fas fa-trash-alt me-1"></i> <%- lan.Clear_All || 'Clear All' %>
                                            </button>
                                        </div>
                                        <div id="previewContainer"></div>
                                    </div>
                                    <div id="progressWrapper" class="upload-progress-card d-none">
                                        <div class="d-flex justify-content-between mb-2 small font-weight-bold text-slate-700">
                                            <span><i class="fas fa-spinner fa-spin text-emerald-600 me-1"></i> <%- lan.Uploading_Media_Files || 'Uploading media files...' %></span>
                                            <span id="progressPercent" class="text-emerald-600">0%</span>
                                        </div>
                                        <div class="progress-bar-custom">
                                            <div id="progressBar" class="progress-bar-fill" style="width: 0%"></div>
