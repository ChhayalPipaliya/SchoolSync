<%- include('../../partials/head', { title: event.title + ' | SchoolSync' }) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<style>
    :root {
        --primary-emerald: #059669;
        --primary-emerald-dark: #047857;
        --primary-emerald-light: #ECFDF5;
        --slate-900: #0f172a;
        --slate-800: #1e293b;
        --slate-700: #334155;
        --slate-600: #475569;
        --slate-500: #64748b;
        --slate-400: #94a3b8;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --slate-50: #f8fafc;
    }

    h1, h2, h3, h4, h5, h6, .font-heading {
        font-family: 'Outfit', 'DM Sans', sans-serif !important;
    }

    body, input, select, textarea, button, .font-body {
        font-family: 'Inter', system-ui, sans-serif !important;
    }

    .gallery-page-header {
        background: #ffffff;
        border: 1px solid var(--slate-200);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 10px;
        box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
    }

    .header-top-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .btn-back-header {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        color: var(--slate-600);
        background: var(--slate-50);
        border: 1.5px solid var(--slate-200);
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-back-header:hover {
        background: var(--slate-100);
        border-color: var(--slate-400);
        color: var(--slate-900);
        transform: translateX(-2px);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-edit-album {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #059669, #047857);
        border: none;
        border-radius: 10px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.2);
        transition: all 0.2s ease;
    }

    .btn-edit-album:hover {
        background: linear-gradient(135deg, #047857, #065f46);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(5, 150, 105, 0.3);
    }

    .album-main-title {
        font-size: 26px;
        font-weight: 800;
        color: var(--slate-900);
        margin-bottom: 10px;
        letter-spacing: -0.02em;
    }

    .album-meta-pills {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .meta-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid transparent;
    }

    .badge-cultural { background: #eff6ff; color: #2563eb; border-color: #dbeafe; }
    .badge-sports { background: #fff7ed; color: #ea580c; border-color: #ffedd5; }
    .badge-academic { background: #ecfdf5; color: #059669; border-color: #d1fae5; }
    .badge-festival { background: #fefce8; color: #ca8a04; border-color: #fef08a; }
    .badge-celebration { background: #faf5ff; color: #9333ea; border-color: #f3e8ff; }
    .badge-default { background: #f1f5f9; color: #475569; border-color: #e2e8f0; }

    .meta-badge-info {
        background: #f8fafc;
        color: var(--slate-600);
        border: 1px solid var(--slate-200);
    }

    .meta-badge-protection {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    .meta-badge-locked {
        background: #f8fafc;
        color: #64748b;
        border: 1px solid #e2e8f0;
    }

    .album-desc-card {
        background: #ffffff;
        border: 1px solid var(--slate-200);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 10px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.02);
    }

    .album-desc-title {
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--slate-500);
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .album-desc-text {
        font-size: 13.5px;
        color: var(--slate-700);
        line-height: 1.6;
        margin-bottom: 0;
    }

    .gallery-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 10px;
    }

    .filter-tabs-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #ffffff;
        border: 1px solid var(--slate-200);
        padding: 4px;
        border-radius: 12px;
    }

    .filter-tab-btn {
        padding: 6px 14px;
        font-size: 12.5px;
        font-weight: 650;
        color: var(--slate-600);
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .filter-tab-btn.active {
        background: var(--primary-emerald);
        color: #ffffff;
        box-shadow: 0 2px 6px rgba(5, 150, 105, 0.2);
    }

    .filter-tab-btn:hover:not(.active) {
        background: var(--slate-100);
        color: var(--slate-900);
    }

    .btn-slideshow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 650;
        color: var(--primary-emerald);
        background: var(--primary-emerald-light);
        border: 1px solid #a7f3d0;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-slideshow:hover {
        background: var(--primary-emerald);
        color: #ffffff;
        border-color: var(--primary-emerald);
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.2);
    }

    .gallery-media-card {
        background: #ffffff;
        border: 1px solid var(--slate-200);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.04);
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .gallery-media-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.08);
        border-color: #cbd5e1;
    }

    .media-thumb-box {
        position: relative;
        height: 190px;
        background: var(--slate-100);
        overflow: hidden;
        cursor: pointer;
    }

    .media-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .gallery-media-card:hover .media-thumb-img {
        transform: scale(1.06);
    }

    .media-hover-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(15, 23, 42, 0.1) 0%, rgba(15, 23, 42, 0.6) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .gallery-media-card:hover .media-hover-overlay {
        opacity: 1;
    }

    .btn-preview-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        color: var(--slate-900);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
        transform: scale(0.85);
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .gallery-media-card:hover .btn-preview-circle {
        transform: scale(1);
    }

    .media-type-tag {
        position: absolute;
        bottom: 10px;
        right: 10px;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        color: #ffffff;
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 4px;
        z-index: 2;
    }

    .media-card-body {
        padding: 14px 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #ffffff;
    }

    .media-caption-text {
        font-size: 12.5px;
        color: var(--slate-700);
        line-height: 1.45;
        margin-bottom: 12px;
        display: -webkit-box;
        --webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .media-caption-placeholder {
        font-size: 12px;
        color: var(--slate-400);
        font-style: italic;
        margin-bottom: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .media-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding-top: 10px;
        border-top: 1px solid var(--slate-100);
    }

    .btn-download-media {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 700;
        color: var(--primary-emerald);
        background: var(--primary-emerald-light);
        border: 1px solid #a7f3d0;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-download-media:hover {
        background: var(--primary-emerald);
        color: #ffffff;
        border-color: var(--primary-emerald);
    }

    .badge-protected-media {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 12px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--slate-500);
        background: var(--slate-100);
        border: 1px solid var(--slate-200);
        border-radius: 8px;
    }

    .lightbox-overlay {
        backdrop-filter: blur(12px);
        background: rgba(15, 23, 42, 0.95);
    }

    .lightbox-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 1100;
        background: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, transparent 100%);
    }

    .lightbox-counter {
        font-size: 13px;
        font-weight: 600;
        color: #ffffff;
        background: rgba(255, 255, 255, 0.15);
        padding: 4px 12px;
        border-radius: 20px;
        backdrop-filter: blur(4px);
    }

    .btn-lightbox-nav {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1100;
        transition: all 0.2s ease;
    }

    .btn-lightbox-nav:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: translateY(-50%) scale(1.08);
    }

    .btn-lightbox-prev { left: 24px; }
    .btn-lightbox-next { right: 24px; }
    .lightbox-footer {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 20px 24px;
        text-align: center;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);
        z-index: 1100;
    }

    .lightbox-caption-text {
        font-size: 14px;
        font-weight: 500;
        color: #f8fafc;
        margin-bottom: 10px;
    }

    .empty-gallery-box {
        background: #ffffff;
        border: 1px solid var(--slate-200);
        border-radius: 16px;
        padding: 60px 24px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    }

    .empty-icon-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: var(--slate-100);
        color: var(--slate-400);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 16px;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/events' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <%- include('../../partials/flashMessages') %>
            <div class="gallery-page-header">
                <div class="header-top-nav">
                    <a href="/schooladmin/events" class="btn-back-header">
                        <i class="fas fa-arrow-left"></i> Back to Albums
                    </a>
                    <div class="header-actions">
                        <a href="/schooladmin/events/edit/<%= event.id %>" class="btn-edit-album">
                            <i class="fas fa-pen-to-square"></i> Edit Album
                        </a>
                    </div>
                </div>
                <h1 class="album-main-title"><%= event.title %></h1>
                <div class="album-meta-pills">
                    <% 
                        let catClass = 'badge-default';
                        if (event.event_type === 'Cultural') catClass = 'badge-cultural';
                        else if (event.event_type === 'Sports') catClass = 'badge-sports';
                        else if (event.event_type === 'Academic') catClass = 'badge-academic';
                        else if (event.event_type === 'Festival') catClass = 'badge-festival';
                        else if (event.event_type === 'Celebration') catClass = 'badge-celebration';
                    %>
                    <span class="meta-badge <%= catClass %>">
                        <i class="fas fa-tag"></i> <%= event.event_type %>
                    </span>
                    <span class="meta-badge meta-badge-info">
                        <i class="far fa-calendar-alt text-emerald-600"></i>
                        <%= new Date(event.event_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                    </span>
                    <span class="meta-badge meta-badge-info">
                        <i class="fas fa-map-marker-alt text-rose-500"></i>
                        <%= event.venue %>
                    </span>
                    <span class="meta-badge <%= event.download_allowed === 1 ? 'meta-badge-protection' : 'meta-badge-locked' %>">
                        <i class="fas <%= event.download_allowed === 1 ? 'fa-unlock' : 'fa-lock' %>"></i>
                        <%= event.download_allowed === 1 ? 'Downloads Allowed' : 'View Only' %>
                    </span>
                    <% if (event.watermark_enabled === 1) { %>
                        <span class="meta-badge meta-badge-protection" title="Dynamic watermark applied to streamed preview images">
                            <i class="fas fa-shield-alt"></i> Watermark Protected
                        </span>
                    <% } %>
                </div>
            </div>
            <% if (event.description) { %>
                <div class="album-desc-card">
                    <div class="album-desc-title">
                        <i class="fas fa-quote-left text-emerald-600"></i> About this Album
                    </div>
                    <p class="album-desc-text"><%= event.description %></p>
                </div>
            <% } %>
            <% if (media && media.length > 0) { %>
                <% 
                    const totalPhotos = media.filter(m => m.media_type === 'image').length;
                    const totalVideos = media.filter(m => m.media_type === 'video').length;
                %>
                <div class="gallery-toolbar">
                    <div class="filter-tabs-wrap">
                        <button type="button" class="filter-tab-btn active" data-filter="all">
                            All Media (<%= media.length %>)
                        </button>
                        <% if (totalPhotos > 0) { %>
                            <button type="button" class="filter-tab-btn" data-filter="image">
                                <i class="fas fa-image me-1"></i> Photos (<%= totalPhotos %>)
                            </button>
                        <% } %>
                        <% if (totalVideos > 0) { %>
                            <button type="button" class="filter-tab-btn" data-filter="video">
                                <i class="fas fa-video me-1"></i> Videos (<%= totalVideos %>)
                            </button>
                        <% } %>
                    </div>
                    <button type="button" class="btn-slideshow" id="btnStartSlideshow">
                        <i class="fas fa-play"></i> Fullscreen Slideshow
                    </button>
                </div>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="galleryGrid">
                    <% media.forEach((item, index) => { %>
                        <div class="col media-item-col" data-type="<%= item.media_type %>">
                            <div class="gallery-media-card">
                                <div class="media-thumb-box" data-media-index="<%= index %>">
                                    <% if (item.media_type === 'image') { %>
                                        <img src="/media/<%= item.id %>" class="media-thumb-img" alt="<%= item.caption || item.file_name %>" loading="lazy">
                                    <% } else { %>
                                        <div class="w-100 h-100 d-flex flex-column justify-content-center align-items-center text-muted" style="background: linear-gradient(135deg, #F1F5F9, #E2E8F0);">
                                            <i class="fas fa-play-circle fa-3x text-danger mb-2"></i>
                                            <span class="small font-weight-bold text-truncate w-75 text-center px-2 text-slate-500">
                                                <%= item.file_name %>
                                            </span>
                                        </div>
                                    <% } %>
                                    <div class="media-hover-overlay">
                                        <span class="btn-preview-circle">
                                            <i class="fas <%= item.media_type === 'image' ? 'fa-expand' : 'fa-play' %>"></i>
                                        </span>
                                    </div>
                                    <span class="media-type-tag">
                                        <i class="fas <%= item.media_type === 'image' ? 'fa-image' : 'fa-video text-danger' %>"></i>
                                        <%= item.media_type === 'image' ? 'Photo' : 'Video' %>
                                    </span>
                                </div>
                                <div class="media-card-body">
                                    <% if (item.caption && item.caption.trim()) { %>
                                        <p class="media-caption-text" title="<%= item.caption %>">
                                            <%= item.caption %>
                                        </p>
                                    <% } else { %>
                                        <p class="media-caption-placeholder" title="<%= item.file_name %>">
                                            <%= item.file_name %>
                                        </p>
                                    <% } %>
                                    <div class="media-card-footer">
                                        <% if (event.download_allowed === 1) { %>
                                            <a href="/media/<%= item.id %>/download" class="btn-download-media" title="Download original media file">
                                                <i class="fas fa-download"></i> Download
                                            </a>
                                        <% } else { %>
                                            <span class="badge-protected-media">
                                                <i class="fas fa-lock"></i> View Only
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-gallery-box">
                    <div class="empty-icon-circle">
                        <i class="far fa-images"></i>
                    </div>
                    <h4 class="font-weight-bold text-dark mb-2">No Media Uploaded Yet</h4>
                    <p class="text-muted small mb-4">Add photos and videos to showcase the highlights of this event.</p>
                    <a href="/schooladmin/events/edit/<%= event.id %>" class="btn-edit-album">
                        <i class="fas fa-plus me-1"></i> Upload Photos & Videos
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>
<div id="lightbox" class="lightbox-overlay d-none position-fixed top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="z-index: 1050;">
    <div class="lightbox-header">
        <span class="lightbox-counter" id="lightboxCounter">1 / <%= media ? media.length : 0 %></span>
        <button type="button" class="btn-close btn-close-white" id="btnCloseLightbox" aria-label="Close"></button>
    </div>
    <button type="button" class="btn-lightbox-nav btn-lightbox-prev" id="btnPrevMedia" title="Previous (Left Arrow)">
        <i class="fas fa-chevron-left"></i>
    </button>
    <button type="button" class="btn-lightbox-nav btn-lightbox-next" id="btnNextMedia" title="Next (Right Arrow)">
        <i class="fas fa-chevron-right"></i>
    </button>
    <div class="d-flex flex-column align-items-center justify-content-center p-3" style="max-width: 90%; max-height: 80%;">
        <div id="lightboxMediaWrapper" class="w-100 h-100 d-flex justify-content-center align-items-center"></div>
    </div>
    <div class="lightbox-footer">
        <p id="lightboxCaption" class="lightbox-caption-text"></p>
        <% if (event.download_allowed === 1) { %>
            <a id="lightboxDownload" href="" class="btn-download-media d-inline-flex px-3 py-1.5" style="width: auto;">
                <i class="fas fa-download me-1"></i> Download Original
            </a>
        <% } %>
    </div>
</div>
<script id="galleryMediaData" type="application/json">
    <%- JSON.stringify(media || []) %>
</script>
<script>
    let currentMediaIndex = 0;
    const mediaDataEl = document.getElementById("galleryMediaData");
    const mediaList = mediaDataEl ? JSON.parse(mediaDataEl.textContent || "[]") : [];

    function openLightbox(index) {
        if (!mediaList || mediaList.length === 0) return;
        currentMediaIndex = index;
        updateLightboxContent();
        const lightbox = document.getElementById("lightbox");
        if (lightbox) lightbox.classList.remove("d-none");
        document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
        const wrapper = document.getElementById("lightboxMediaWrapper");
        if (wrapper) wrapper.innerHTML = "";
        const lightbox = document.getElementById("lightbox");
        if (lightbox) lightbox.classList.add("d-none");
        document.body.style.overflow = "";
    }

    function updateLightboxContent() {
        const item = mediaList[currentMediaIndex];
        if (!item) return;

        const wrapper = document.getElementById("lightboxMediaWrapper");
        const captionEl = document.getElementById("lightboxCaption");
        const counterEl = document.getElementById("lightboxCounter");
        const downloadLink = document.getElementById("lightboxDownload");

        if (wrapper) wrapper.innerHTML = "";
        if (counterEl) counterEl.textContent = (currentMediaIndex + 1) + " / " + mediaList.length;
        if (captionEl) captionEl.textContent = item.caption || item.file_name;
        
        if (downloadLink) {
            downloadLink.href = "/media/" + item.id + "/download";
        }

        if (item.media_type === "image") {
            const img = document.createElement("img");
            img.src = "/media/" + item.id;
            img.className = "img-fluid rounded shadow-lg";
            img.style.maxHeight = "72vh";
            img.style.maxWidth = "90vw";
            img.style.objectFit = "contain";
            if (wrapper) wrapper.appendChild(img);
        } else {
            const video = document.createElement("video");
            video.src = "/media/" + item.id;
            video.controls = true;
            video.autoplay = true;
            video.className = "rounded shadow-lg";
            video.style.maxHeight = "72vh";
            video.style.maxWidth = "90vw";
            if (wrapper) wrapper.appendChild(video);
        }
    }

    function nextMedia() {
        if (mediaList.length === 0) return;
        currentMediaIndex = (currentMediaIndex + 1) % mediaList.length;
        updateLightboxContent();
    }

    function prevMedia() {
        if (mediaList.length === 0) return;
        currentMediaIndex = (currentMediaIndex - 1 + mediaList.length) % mediaList.length;
        updateLightboxContent();
    }

    function filterMedia(type, btn) {
        document.querySelectorAll(".filter-tab-btn").forEach(b => b.classList.remove("active"));
        if (btn) btn.classList.add("active");

        const items = document.querySelectorAll(".media-item-col");
        items.forEach(item => {
            if (type === "all" || item.dataset.type === type) {
                item.style.display = "";
            } else {
                item.style.display = "none";
            }
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".media-thumb-box").forEach(box => {
            box.addEventListener("click", () => {
                const idx = parseInt(box.getAttribute("data-media-index") || "0", 10);
                openLightbox(idx);
            });
        });

        document.querySelectorAll(".filter-tab-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const filterType = btn.getAttribute("data-filter") || "all";
                filterMedia(filterType, btn);
            });
        });

        const btnSlideshow = document.getElementById("btnStartSlideshow");
        if (btnSlideshow) {
            btnSlideshow.addEventListener("click", () => openLightbox(0));
        }

        const btnClose = document.getElementById("btnCloseLightbox");
        if (btnClose) btnClose.addEventListener("click", closeLightbox);

        const btnPrev = document.getElementById("btnPrevMedia");
        if (btnPrev) btnPrev.addEventListener("click", prevMedia);

        const btnNext = document.getElementById("btnNextMedia");
        if (btnNext) btnNext.addEventListener("click", nextMedia);
    });

    document.addEventListener("keydown", (e) => {
        const lightbox = document.getElementById("lightbox");
        if (lightbox && !lightbox.classList.contains("d-none")) {
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowRight") nextMedia();
            if (e.key === "ArrowLeft") prevMedia();
        }
    });
</script>