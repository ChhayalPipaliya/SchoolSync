<%- include('../../partials/head', { title: event.title + ' | SchoolSync' }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/events' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <%- include('../../partials/flashMessages') %>
            <div class="container-fluid py-4">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
                    <div>
                        <a href="/schooladmin/events" class="btn btn-sm btn-outline-secondary mb-3">
                            <i class="fas fa-arrow-left me-1"></i> Back to Albums
                        </a>
                        <h1 class="h3 text-gray-800 font-weight-bold mb-1"><%= event.title %></h1>
                        <p class="text-muted small">
                            <span class="badge bg-light text-dark border me-2"><%= event.event_type %></span>
                            <i class="far fa-calendar-alt me-1 text-primary"></i> <%= new Date(event.event_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                            <span class="mx-2">•</span>
                            <i class="fas fa-map-marker-alt me-1 text-danger"></i> <%= event.venue %>
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/schooladmin/events/edit/<%= event.id %>" class="btn btn-outline-secondary">
                            <i class="fas fa-edit me-1"></i> Edit Album
                        </a>
                    </div>
                </div>
                <% if (event.description) { %>
                    <div class="card border-0 shadow-sm p-4 mb-4">
                        <h6 class="font-weight-bold text-dark mb-2">Album Description</h6>
                        <p class="text-secondary small mb-0"><%= event.description %></p>
                    </div>
                <% } %>
                <% if (media && media.length > 0) { %>
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="galleryGrid">
                        <% media.forEach((item, index) => { %>
                            <div class="col">
                                <div class="card h-100 border-0 shadow-sm overflow-hidden hover-card transition-all duration-300" style="border-radius: 16px;">
                                    <div class="position-relative bg-light cursor-pointer overflow-hidden" style="height: 180px;" onclick="openLightbox('<%= index %>')">
                                        <% if (item.media_type === 'image') { %>
                                            <img src="/media/<%= item.id %>" class="w-100 h-100 object-cover hover-scale" alt="<%= item.caption || item.file_name %>" style="object-fit: cover; transition: transform 0.5s ease;">
                                        <% } else { %>
                                            <div class="w-100 h-100 d-flex flex-column justify-content-center align-items-center text-muted" style="background: linear-gradient(135deg, #F1F5F9, #E2E8F0);">
                                                <i class="fas fa-play-circle fa-3x text-danger mb-2"></i>
                                                <span class="small font-weight-bold text-truncate w-75 text-center px-2 text-slate-500"><%= item.file_name %></span>
                                            </div>
                                        <% } %>
                                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(0,0,0,0) 50%, rgba(0,0,0,0.35) 100%); pointer-events: none;"></div>
                                        <div class="position-absolute bottom-0 end-0 m-2 px-2.5 py-1 text-white rounded shadow-sm text-xs font-bold" style="backdrop-filter: blur(4px); background: rgba(15, 23, 42, 0.65); border: 1px solid rgba(255,255,255,0.15);">
                                            <i class="fas <%= item.media_type === 'image' ? 'fa-image' : 'fa-video' %>"></i>
                                        </div>
                                    </div>
                                    <div class="card-body p-3.5 d-flex flex-column justify-content-between" style="background: #ffffff;">
                                        <p class="card-text text-slate-600 text-xs mb-3 italic" style="min-height: 36px; line-height: 18px; display: -webkit-box; --webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            <%= item.caption || 'No caption provided.' %>
                                        </p>
                                        <a href="/media/<%= item.id %>/download" class="btn btn-outline-primary w-100 d-inline-flex align-items-center justify-content-center gap-2 py-2" style="border-radius: 8px; font-weight: 700; font-size: 12px; border-color: #EA580C; color: #EA580C;">
                                            <i class="fas fa-download"></i> Original Quality
                                        </a>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="card border-0 shadow-sm py-5 text-center">
                        <div class="card-body">
                            <i class="far fa-images fa-4x text-muted mb-3"></i>
                            <h5 class="font-weight-bold text-dark">Album is Empty</h5>
                            <p class="text-muted mb-3">Upload media files to this event album.</p>
                            <a href="/schooladmin/events/edit/<%= event.id %>" class="btn btn-primary btn-sm px-4">
                                <i class="fas fa-plus me-1"></i> Add Media
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>

        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<div id="lightbox" class="lightbox-overlay d-none d-flex flex-column align-items-center justify-content-center position-fixed top-0 start-0 w-100 h-100 bg-black bg-opacity-95 text-white" style="z-index: 1050;">
    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-4 p-3" aria-label="Close" onclick="closeLightbox()"></button>
    <button type="button" class="btn btn-link text-white position-absolute start-0 m-4 p-3" onclick="prevMedia()">
        <i class="fas fa-chevron-left fa-2x"></i>
    </button>
    <button type="button" class="btn btn-link text-white position-absolute end-0 m-4 p-3" onclick="nextMedia()">
        <i class="fas fa-chevron-right fa-2x"></i>
    </button>
    <div class="lightbox-content-container d-flex flex-column align-items-center justify-content-center p-3" style="max-width: 90%; max-height: 80%;">
        <div id="lightboxMediaWrapper" class="w-100 h-100 d-flex justify-content-center align-items-center"></div>
        <p id="lightboxCaption" class="mt-3 text-center small text-light font-weight-bold italic"></p>
        <a id="lightboxDownload" href="" class="btn btn-sm btn-primary mt-2">
            <i class="fas fa-download me-1"></i> Download Original
        </a>
    </div>
</div>
<style>
    .cursor-pointer {
        cursor: pointer;
    }
    .hover-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .hover-scale:hover {
        transform: scale(1.05);
    }
    .transition-all {
        transition: all 0.3s ease;
    }
    .lightbox-overlay {
        backdrop-filter: blur(5px);
    }
</style>
<script>
    let currentMediaIndex = 0;
    const mediaList = '<%- JSON.stringify(media || []) %>';

    function openLightbox(index) {
        currentMediaIndex = index;
        updateLightboxContent();
        document.getElementById("lightbox").classList.remove("d-none");
    };

    function closeLightbox() {
        const wrapper = document.getElementById("lightboxMediaWrapper");
        wrapper.innerHTML = "";
        document.getElementById("lightbox").classList.add("d-none");
    };

    function updateLightboxContent() {
        const item = mediaList[currentMediaIndex];
        if (!item) return;

        const wrapper = document.getElementById("lightboxMediaWrapper");
        const captionEl = document.getElementById("lightboxCaption");
        const downloadLink = document.getElementById("lightboxDownload");

        wrapper.innerHTML = "";
        captionEl.textContent = item.caption || item.file_name;
        downloadLink.href = `/media/${item.id}/download`;

        if (item.media_type === "image") {
            const img = document.createElement("img");
            img.src = `/media/${item.id}`;
            img.className = "img-fluid rounded shadow-lg";
            img.style.maxHeight = "70vh";
            wrapper.appendChild(img);
        } else {
            const video = document.createElement("video");
            video.src = `/media/${item.id}`;
            video.controls = true;
            video.className = "w-100 rounded shadow-lg";
            video.style.maxHeight = "70vh";
            video.style.maxWidth = "800px";
            wrapper.appendChild(video);
        };
    };

    function nextMedia() {
        if (mediaList.length === 0) return;
        currentMediaIndex = (currentMediaIndex + 1) % mediaList.length;
        updateLightboxContent();
    };

    function prevMedia() {
        if (mediaList.length === 0) return;
        currentMediaIndex = (currentMediaIndex - 1 + mediaList.length) % mediaList.length;
        updateLightboxContent();
    };

    document.addEventListener("keydown", (e) => {
        const lightbox = document.getElementById("lightbox");
        if (!lightbox.classList.contains("d-none")) {
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowRight") nextMedia();
            if (e.key === "ArrowLeft") prevMedia();
        };
    });
</script>
