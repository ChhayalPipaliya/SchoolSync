<%- include('../../partials/head', { title: `${lan.School_Events_Gallery || 'School Events Gallery'} | SchoolSync` }) %>
<style>
    .events-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }
    .events-page-title {
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 4px;
        letter-spacing: -0.02em;
    }
    .events-page-subtitle {
        color: #64748b;
        font-size: 13.5px;
        margin-bottom: 0;
    }
    .btn-create-event {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        font-size: 14px;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #059669, #047857);
        border: none;
        border-radius: 10px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-create-event:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(5, 150, 105, 0.35);
        background: linear-gradient(135deg, #047857, #065f46);
        color: #ffffff;
    }
    .filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    }
    .filter-input {
        width: 100%;
        padding: 10px 14px 10px 38px;
        font-size: 13.5px;
        color: #1e293b;
        background-color: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        transition: all 0.2s ease;
    }
    .filter-input:focus {
        background-color: #ffffff;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);
    }
    .filter-input::placeholder {
        color: #94a3b8;
    }
    .filter-input-wrap {
        position: relative;
    }
    .filter-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 13px;
        pointer-events: none;
    }
    .filter-select {
        width: 100%;
        padding: 10px 36px 10px 14px;
        font-size: 13.5px;
        color: #1e293b;
        background-color: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2364748b' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 12px center;
        background-repeat: no-repeat;
        background-size: 16px 16px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .filter-select:focus {
        background-color: #ffffff;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);
    }
    .btn-reset-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 10px 16px;
        font-size: 13.5px;
        font-weight: 600;
        color: #475569;
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .btn-reset-filter:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #0f172a;
    }
    .event-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.04);
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .event-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
        border-color: #cbd5e1;
    }
    .event-cover-box {
        position: relative;
        height: 200px;
        background: #f1f5f9;
        overflow: hidden;
    }
    .event-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .event-card:hover .event-cover-img {
        transform: scale(1.05);
    }
    .event-cover-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.45) 100%);
        pointer-events: none;
    }
    .event-category-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 11.5px;
        font-weight: 700;
        color: #ffffff;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    .badge-cat-cultural {
        background: rgba(37, 99, 235, 0.9);
    }
    .badge-cat-sports {
        background: rgba(234, 88, 12, 0.9);
    }
    .badge-cat-academic {
        background: rgba(5, 150, 105, 0.9);
    }
    .badge-cat-festival {
        background: rgba(217, 119, 6, 0.9);
    }
    .badge-cat-default {
        background: rgba(100, 116, 139, 0.9);
    }
    .event-permission-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 11.5px;
        font-weight: 700;
        color: #ffffff;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .badge-perm-allow {
        background: rgba(5, 150, 105, 0.85);
    }
    .badge-perm-lock {
        background: rgba(15, 23, 42, 0.75);
    }
    .event-card-body {
        padding: 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .event-card-title {
        font-family: 'Outfit', sans-serif;
        font-size: 17.5px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .event-meta-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 12px;
    }
    .event-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .event-description {
        font-size: 13px;
        color: #64748b;
        line-height: 1.5;
        display: -webkit-box;
        --webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 39px;
        margin-bottom: 18px;
    }
    .event-card-footer {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 14px;
        border-top: 1px solid #f1f5f9;
        margin-top: auto;
    }
    .btn-card-gallery {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #EA580C, #C2410C);
        border: none;
        border-radius: 10px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(234, 88, 12, 0.22);
        transition: all 0.2s ease;
    }
    .btn-card-gallery:hover {
        background: linear-gradient(135deg, #C2410C, #9A3412);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(234, 88, 12, 0.32);
    }
    .btn-card-edit {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #475569;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: none;
        font-size: 14px;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .btn-card-edit:hover {
        background: #e2e8f0;
        color: #0f172a;
    }
    .btn-card-delete {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #fef2f2;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .btn-card-delete:hover {
        background: #fee2e2;
        color: #b91c1c;
        transform: scale(1.05);
    }
    .empty-state-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 56px 24px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    }
    .empty-icon-box {
        width: 72px;
        height: 72px;
        background: #f1f5f9;
        color: #94a3b8;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 16px;
    }
    .empty-state-title {
        font-family: 'Outfit', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
    }
    .empty-state-desc {
        font-size: 14px;
        color: #64748b;
        max-width: 420px;
        margin: 0 auto 20px;
    }

    [data-theme="dark"] .events-page-title,
    .light-mode-disabled .events-page-title,
    [data-theme="dark"] .event-card-title,
    .light-mode-disabled .event-card-title {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .events-page-subtitle,
    .light-mode-disabled .events-page-subtitle,
    [data-theme="dark"] .event-meta-row,
    .light-mode-disabled .event-meta-row,
    [data-theme="dark"] .event-description,
    .light-mode-disabled .event-description {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .filter-card,
    .light-mode-disabled .filter-card,
    [data-theme="dark"] .event-card,
    .light-mode-disabled .event-card,
    [data-theme="dark"] .empty-state-card,
    .light-mode-disabled .empty-state-card {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .event-card:hover,
    .light-mode-disabled .event-card:hover {
        border-color: #334155 !important;
    }
    [data-theme="dark"] .filter-input,
    .light-mode-disabled .filter-input,
    [data-theme="dark"] .filter-select,
    .light-mode-disabled .filter-select {
        background-color: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .btn-reset-filter,
    .light-mode-disabled .btn-reset-filter {
        background-color: #1E293B !important;
        border-color: #334155 !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .btn-reset-filter:hover,
    .light-mode-disabled .btn-reset-filter:hover {
        background-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .event-card-footer,
    .light-mode-disabled .event-card-footer {
        border-top-color: #242F4D !important;
    }
    [data-theme="dark"] .btn-card-edit,
    .light-mode-disabled .btn-card-edit {
        background-color: #1E293B !important;
        border: 1px solid #334155 !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .btn-card-edit:hover,
    .light-mode-disabled .btn-card-edit:hover {
        background-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .btn-card-delete,
    .light-mode-disabled .btn-card-delete {
        background-color: rgba(244, 63, 94, 0.15) !important;
        border: 1px solid rgba(244, 63, 94, 0.35) !important;
        color: #FB7185 !important;
    }
    [data-theme="dark"] .btn-card-delete:hover,
    .light-mode-disabled .btn-card-delete:hover {
        background-color: rgba(244, 63, 94, 0.25) !important;
        color: #FDA4AF !important;
    }
    [data-theme="dark"] .empty-state-title,
    .light-mode-disabled .empty-state-title {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .empty-state-desc,
    .light-mode-disabled .empty-state-desc {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .empty-icon-box,
    .light-mode-disabled .empty-icon-box {
        background-color: #101726 !important;
        color: #059669 !important;
    }
    [data-theme="dark"] .page-link,
    .light-mode-disabled .page-link {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .page-item.active .page-link,
    .light-mode-disabled .page-item.active .page-link {
        background-color: #059669 !important;
        border-color: #059669 !important;
        color: #ffffff !important;
    }

    @media (max-width: 640px) {
        .events-page-header {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
            margin-bottom: 18px;
        }
        .events-page-title {
            font-size: 20px;
        }
        .btn-create-event {
            width: 100%;
            justify-content: center;
        }
        .filter-card {
            padding: 14px 12px;
        }
        .event-card-body {
            padding: 16px;
        }
        .event-card-footer {
            gap: 8px;
        }
        .btn-card-gallery {
            font-size: 12px;
            padding: 8px 12px;
        }
        .btn-card-edit, .btn-card-delete {
            width: 36px;
            height: 36px;
            font-size: 13px;
        }
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/events' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-camera-retro"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.School_Events_Gallery || 'School Events Gallery' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.School_Events_Subtitle || 'Manage school events, media albums, and access permissions.' %></p>
                        </div>
                    </div>
                    <div>
                        <a href="/schooladmin/events/add" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fas fa-plus"></i> <%- lan.Create_Event_Album || 'Create Event Album' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div>
                <div class="filter-card">
                    <form action="/schooladmin/events" method="GET" class="row g-3 align-items-center">
                        <div class="col-lg-4 col-md-6">
                            <div class="filter-input-wrap">
                                <input type="text" name="search" class="filter-input" placeholder="<%- lan.Search_Events || 'Search events...' %>" value="<%= search %>">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <select name="type" class="filter-select" onchange="this.form.submit()">
                                <option value=""><%- lan.All_Categories || 'All Categories' %></option>
                                <option value="Cultural" <%= selectedType === 'Cultural' ? 'selected' : '' %>><%- lan.Cultural || 'Cultural' %></option>
                                <option value="Sports" <%= selectedType === 'Sports' ? 'selected' : '' %>><%- lan.Sports || 'Sports' %></option>
                                <option value="Academic" <%= selectedType === 'Academic' ? 'selected' : '' %>><%- lan.Academic || 'Academic' %></option>
                                <option value="Festival" <%= selectedType === 'Festival' ? 'selected' : '' %>><%- lan.Festival || 'Festival' %></option>
                                <option value="Celebration" <%= selectedType === 'Celebration' ? 'selected' : '' %>><%- lan.Celebration || 'Celebration' %></option>
                                <option value="Competition" <%= selectedType === 'Competition' ? 'selected' : '' %>><%- lan.Competition || 'Competition' %></option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <select name="year" class="filter-select" onchange="this.form.submit()">
                                <option value=""><%- lan.All_Years || 'All Years' %></option>
                                <% years.forEach(y => { %>
                                    <option value="<%= y %>" <%= selectedYear == y ? 'selected' : '' %>><%= y %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-12">
                            <a href="/schooladmin/events" class="btn-reset-filter">
                                <i class="fas fa-undo"></i> <%- lan.Reset || 'Reset' %>
                            </a>
                        </div>
                    </form>
                </div>
                <% if (events && events.length > 0) { %>
                    <div class="row g-4">
                        <% events.forEach(event => { %>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="event-card">
                                    <div class="event-cover-box">
                                        <% if (event.cover_media_id) { %>
                                            <img src="/media/<%= event.cover_media_id %>" class="event-cover-img" alt="<%= event.title %>">
                                        <% } else { %>
                                            <div class="w-100 h-100 d-flex flex-column justify-content-center align-items-center text-muted" style="background: linear-gradient(135deg, #F1F5F9, #E2E8F0);">
                                                <i class="far fa-images fa-3x mb-2 text-slate-400"></i>
                                                <span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%- lan.No_Media_Uploaded || 'No Media Uploaded' %></span>
                                            </div>
                                        <% } %>
                                        <div class="event-cover-overlay"></div>
                                        <% 
                                            let catClass = 'badge-cat-default';
                                            if (event.event_type === 'Cultural') catClass = 'badge-cat-cultural';
                                            else if (event.event_type === 'Sports') catClass = 'badge-cat-sports';
                                            else if (event.event_type === 'Academic') catClass = 'badge-cat-academic';
                                            else if (event.event_type === 'Festival') catClass = 'badge-cat-festival';
                                            else if (event.event_type === 'Celebration') catClass = 'badge-celebration';
                                        %>
                                        <span class="event-category-badge <%= catClass %>">
                                            <%= lan[event.event_type] || event.event_type %>
                                        </span>
                                        <span class="event-permission-badge <%= event.download_allowed === 1 ? 'badge-perm-allow' : 'badge-perm-lock' %>">
                                            <i class="fas <%= event.download_allowed === 1 ? 'fa-unlock' : 'fa-lock' %>"></i>
                                            <%= event.download_allowed === 1 ? (lan.Downloads_Allowed || 'Downloads Allowed') : (lan.View_Only || 'View Only') %>
                                        </span>
                                    </div>
                                    <div class="event-card-body">
                                        <h5 class="event-card-title" title="<%= event.title %>"><%= event.title %></h5>
                                        <div class="event-meta-row">
                                            <span class="event-meta-item">
                                                <i class="far fa-calendar-alt text-amber-600"></i>
                                                <%= new Date(event.event_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                            </span>
                                            <span>&bull;</span>
                                            <span class="event-meta-item" title="<%= event.venue %>">
                                                <i class="fas fa-map-marker-alt text-rose-500"></i>
                                                <%= event.venue %>
                                            </span>
                                        </div>
                                        <p class="event-description"><%= event.description || (lan.No_Event_Description || 'No description provided for this event album.') %></p>
                                        <div class="event-card-footer">
                                            <a href="/schooladmin/events/<%= event.id %>" class="btn-card-gallery">
                                                <i class="far fa-images"></i> <%- lan.Gallery || 'Gallery' %>
                                            </a>
                                            <a href="/schooladmin/events/edit/<%= event.id %>" class="btn-card-edit" title="<%- lan.Edit_Album || 'Edit Album' %>">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/schooladmin/events/<%= event.id %>/delete" method="POST" class="d-inline mb-0 event-delete-form" data-confirm="<%- lan.Delete_Event_Confirm || 'Are you sure you want to delete this event album and all its media files?' %>">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button type="submit" class="btn-card-delete" title="<%- lan.Delete_Album || 'Delete Album' %>">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <% if (totalPages > 1) { %>
                        <nav class="d-flex justify-content-center mt-5">
                            <ul class="pagination shadow-sm">
                                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>"><%- lan.Previous || 'Previous' %></a>
                                </li>
                                <% for(let i = 1; i <= totalPages; i++) { %>
                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                        <a class="page-link" href="?page=<%= i %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>"><%= i %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>"><%- lan.Next || 'Next' %></a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>
                <% } else { %>
                    <div class="empty-state-card">
                        <div class="empty-icon-box">
                            <i class="far fa-folder-open"></i>
                        </div>
                        <h4 class="empty-state-title"><%- lan.No_Events_Found || 'No Events Found' %></h4>
                        <p class="empty-state-desc"><%- lan.No_Events_Desc || 'Create your first event gallery to store school memories, athletic events, and celebrations.' %></p>
                        <a href="/schooladmin/events/add" class="btn-create-event">
                            <i class="fas fa-plus"></i> <%- lan.Create_Album || 'Create Album' %>
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".event-delete-form").forEach(form => {
            form.addEventListener("submit", function(e) {
                const msg = this.getAttribute("data-confirm") || "Are you sure you want to delete this event album?";
                if (!confirm(msg)) {
                    e.preventDefault();
                }
            });
        });
    });
</script>