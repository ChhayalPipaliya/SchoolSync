<%- include('../../partials/head', { title: 'School Events Gallery | SchoolSync' }) %>
<style>
    .events-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }
    .events-page-title {
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 4px;
        letter-spacing: -0.02em;
    }
    .events-page-subtitle {
        color: #64748b;
        font-size: 13.5px;
        margin-bottom: 0;
    }
    .btn-create-event {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        font-size: 14px;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #059669, #047857);
        border: none;
        border-radius: 10px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-create-event:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(5, 150, 105, 0.35);
        background: linear-gradient(135deg, #047857, #065f46);
        color: #ffffff;
    }
    .filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    }
    .filter-input {
        width: 100%;
        padding: 10px 14px 10px 38px;
        font-size: 13.5px;
        color: #1e293b;
        background-color: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        transition: all 0.2s ease;
    }
    .filter-input:focus {
        background-color: #ffffff;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);
    }
    .filter-input::placeholder {
        color: #94a3b8;
    }
    .filter-input-wrap {
        position: relative;
    }
    .filter-input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 13px;
        pointer-events: none;
    }
    .filter-select {
        width: 100%;
        padding: 10px 36px 10px 14px;
        font-size: 13.5px;
        color: #1e293b;
        background-color: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        outline: none;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2364748b' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 12px center;
        background-repeat: no-repeat;
        background-size: 16px 16px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .filter-select:focus {
        background-color: #ffffff;
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);
    }
    .btn-reset-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 10px 16px;
        font-size: 13.5px;
        font-weight: 600;
        color: #475569;
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .btn-reset-filter:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #0f172a;
    }
    .event-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.04);
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .event-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px -4px rgba(15, 23, 42, 0.08);
        border-color: #cbd5e1;
    }
    .event-cover-box {
        position: relative;
        height: 200px;
        background: #f1f5f9;
        overflow: hidden;
    }
    .event-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .event-card:hover .event-cover-img {
        transform: scale(1.05);
    }
    .event-cover-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.45) 100%);
        pointer-events: none;
    }
    .event-category-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 11.5px;
        font-weight: 700;
        color: #ffffff;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
    .badge-cat-cultural {
        background: rgba(37, 99, 235, 0.9);
    }
    .badge-cat-sports {
        background: rgba(234, 88, 12, 0.9);
    }
    .badge-cat-academic {
        background: rgba(5, 150, 105, 0.9);
    }
    .badge-cat-festival {
        background: rgba(217, 119, 6, 0.9);
    }
    .badge-cat-default {
        background: rgba(100, 116, 139, 0.9);
    }
    .event-permission-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 11.5px;
        font-weight: 700;
        color: #ffffff;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .badge-perm-allow {
        background: rgba(5, 150, 105, 0.85);
    }
    .badge-perm-lock {
        background: rgba(15, 23, 42, 0.75);
    }
    .event-card-body {
        padding: 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .event-card-title {
        font-family: 'Outfit', sans-serif;
        font-size: 17.5px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .event-meta-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 12px;
    }
    .event-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .event-description {
        font-size: 13px;
        color: #64748b;
        line-height: 1.5;
        display: -webkit-box;
        --webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 39px;
        margin-bottom: 18px;
    }
    .event-card-footer {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 14px;
        border-top: 1px solid #f1f5f9;
        margin-top: auto;
    }
    .btn-card-gallery {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #EA580C, #C2410C);
        border: none;
        border-radius: 10px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(234, 88, 12, 0.22);
        transition: all 0.2s ease;
    }
    .btn-card-gallery:hover {
        background: linear-gradient(135deg, #C2410C, #9A3412);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(234, 88, 12, 0.32);
    }
    .btn-card-edit {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #475569;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: none;
        font-size: 14px;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .btn-card-edit:hover {
        background: #e2e8f0;
        color: #0f172a;
    }
    .btn-card-delete {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #fef2f2;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }
    .btn-card-delete:hover {
        background: #fee2e2;
        color: #b91c1c;
        transform: scale(1.05);
    }
    .empty-state-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 56px 24px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    }
    .empty-icon-box {
        width: 72px;
        height: 72px;
        background: #f1f5f9;
        color: #94a3b8;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 16px;
    }
    .empty-state-title {
        font-family: 'Outfit', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
    }
    .empty-state-desc {
        font-size: 14px;
        color: #64748b;
        max-width: 420px;
        margin: 0 auto 20px;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/events' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <%- include('../../partials/flashMessages') %>
            <div class="container-fluid">
                <div class="events-page-header">
                    <div>
                        <h1 class="events-page-title">School Events Gallery</h1>
                        <p class="events-page-subtitle">Manage school events, media albums, and access permissions.</p>
                    </div>
                    <div>
                        <a href="/schooladmin/events/add" class="btn-create-event">
                            <i class="fas fa-plus"></i> Create Event Album
                        </a>
                    </div>
                </div>
                <div class="filter-card">
                    <form action="/schooladmin/events" method="GET" class="row g-3 align-items-center">
                        <div class="col-lg-4 col-md-6">
                            <div class="filter-input-wrap">
                                <i class="fas fa-search filter-input-icon"></i>
                                <input type="text" name="search" class="filter-input" placeholder="Search events..." value="<%= search %>">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <select name="type" class="filter-select" onchange="this.form.submit()">
                                <option value="">All Categories</option>
                                <option value="Cultural" <%= selectedType === 'Cultural' ? 'selected' : '' %>>Cultural</option>
                                <option value="Sports" <%= selectedType === 'Sports' ? 'selected' : '' %>>Sports</option>
                                <option value="Academic" <%= selectedType === 'Academic' ? 'selected' : '' %>>Academic</option>
                                <option value="Festival" <%= selectedType === 'Festival' ? 'selected' : '' %>>Festival</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <select name="year" class="filter-select" onchange="this.form.submit()">
                                <option value="">All Years</option>
                                <% years.forEach(y => { %>
                                    <option value="<%= y %>" <%= selectedYear == y ? 'selected' : '' %>><%= y %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-12">
                            <a href="/schooladmin/events" class="btn-reset-filter">
                                <i class="fas fa-undo"></i> Reset
                            </a>
                        </div>
                    </form>
                </div>
                <% if (events && events.length > 0) { %>
                    <div class="row g-4">
                        <% events.forEach(event => { %>
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="event-card">
                                    <div class="event-cover-box">
                                        <% if (event.cover_media_id) { %>
                                            <img src="/media/<%= event.cover_media_id %>" class="event-cover-img" alt="<%= event.title %>">
                                        <% } else { %>
                                            <div class="w-100 h-100 d-flex flex-column justify-content-center align-items-center text-muted" style="background: linear-gradient(135deg, #F1F5F9, #E2E8F0);">
                                                <i class="far fa-images fa-3x mb-2 text-slate-400"></i>
                                                <span class="text-xs font-bold uppercase tracking-wider text-slate-500">No Media Uploaded</span>
                                            </div>
                                        <% } %>
                                        <div class="event-cover-overlay"></div>
                                        <% 
                                            let catClass = 'badge-cat-default';
                                            if (event.event_type === 'Cultural') catClass = 'badge-cat-cultural';
                                            else if (event.event_type === 'Sports') catClass = 'badge-cat-sports';
                                            else if (event.event_type === 'Academic') catClass = 'badge-cat-academic';
                                            else if (event.event_type === 'Festival') catClass = 'badge-cat-festival';
                                        %>
                                        <span class="event-category-badge <%= catClass %>">
                                            <%= event.event_type %>
                                        </span>
                                        <span class="event-permission-badge <%= event.download_allowed === 1 ? 'badge-perm-allow' : 'badge-perm-lock' %>">
                                            <i class="fas <%= event.download_allowed === 1 ? 'fa-unlock' : 'fa-lock' %>"></i>
                                            <%= event.download_allowed === 1 ? 'Downloads Allowed' : 'View Only' %>
                                        </span>
                                    </div>
                                    <div class="event-card-body">
                                        <h5 class="event-card-title" title="<%= event.title %>"><%= event.title %></h5>
                                        <div class="event-meta-row">
                                            <span class="event-meta-item">
                                                <i class="far fa-calendar-alt text-amber-600"></i>
                                                <%= new Date(event.event_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                            </span>
                                            <span>&bull;</span>
                                            <span class="event-meta-item" title="<%= event.venue %>">
                                                <i class="fas fa-map-marker-alt text-rose-500"></i>
                                                <%= event.venue %>
                                            </span>
                                        </div>
                                        <p class="event-description"><%= event.description || 'No description provided for this event album.' %></p>
                                        <div class="event-card-footer">
                                            <a href="/schooladmin/events/<%= event.id %>" class="btn-card-gallery">
                                                <i class="far fa-images"></i> Gallery
                                            </a>
                                            <a href="/schooladmin/events/edit/<%= event.id %>" class="btn-card-edit" title="Edit Album">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form action="/schooladmin/events/<%= event.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this event album and all its media files?')" class="d-inline mb-0">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <button type="submit" class="btn-card-delete" title="Delete Album">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <% if (totalPages > 1) { %>
                        <nav class="d-flex justify-content-center mt-5">
                            <ul class="pagination shadow-sm">
                                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= currentPage - 1 %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>">Previous</a>
                                </li>
                                <% for(let i = 1; i <= totalPages; i++) { %>
                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                        <a class="page-link" href="?page=<%= i %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>"><%= i %></a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= currentPage + 1 %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    <% } %>
                <% } else { %>
                    <div class="empty-state-card">
                        <div class="empty-icon-box">
                            <i class="far fa-folder-open"></i>
                        </div>
                        <h4 class="empty-state-title">No Events Found</h4>
                        <p class="empty-state-desc">Create your first event gallery to store school memories, athletic events, and celebrations.</p>
                        <a href="/schooladmin/events/add" class="btn-create-event">
                            <i class="fas fa-plus"></i> Create Album
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>