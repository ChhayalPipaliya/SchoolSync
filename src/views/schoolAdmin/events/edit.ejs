<%- include('../../partials/head', { title: 'Edit Event Album | SchoolSync' }) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<style>
    h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', 'Inter', sans-serif !important;
    }

    .form-label {
        font-family: 'Inter', sans-serif !important;
        font-weight: 700 !important;
        color: #64748b !important;
        font-size: 11px !important;
        letter-spacing: 0.5px !important;
        text-transform: uppercase !important;
    }

    .premium-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px !important;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04) !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .premium-card:hover {
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08) !important;
        border-color: #cbd5e1;
    }

    .premium-card-header {
        border-bottom: 1px solid #f1f5f9 !important;
        padding: 20px 24px !important;
    }

    .dropzone-container {
        cursor: pointer;
        border: 2px dashed #cbd5e1 !important;
        border-radius: 16px !important;
        background-color: #f8fafc !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .dropzone-container:hover {
        border-color: #059669 !important;
        background-color: #f0fdf4 !important;
    }

    .dropzone-container.dragover {
        border-color: #059669 !important;
        background-color: #d1fae5 !important;
        transform: scale(0.985);
    }

    .btn-premium-primary {
        background: #059669 !important;
        border-color: #059669 !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        border-radius: 10px !important;
        padding: 10px 24px !important;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.2) !important;
        transition: all 0.2s;
    }

    .btn-premium-primary:hover {
        background: #047857 !important;
        border-color: #047857 !important;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(5, 150, 105, 0.3) !important;
    }

    .btn-premium-secondary {
        background: #ffffff !important;
        border: 1.5px solid #e2e8f0 !important;
        color: #475569 !important;
        font-weight: 600 !important;
        border-radius: 10px !important;
        padding: 10px 24px !important;
        transition: all 0.2s;
    }

    .btn-premium-secondary:hover {
        background: #f8fafc !important;
        border-color: #cbd5e1 !important;
        color: #1e293b !important;
    }

    .btn-outline-premium {
        color: #059669 !important;
        border: 1.5px solid #059669 !important;
        background: transparent !important;
        font-weight: 600 !important;
        transition: all 0.2s;
    }

    .btn-outline-premium:hover {
        color: #ffffff !important;
        background-color: #059669 !important;
        border-color: #059669 !important;
    }

    .back-btn {
        border-radius: 10px !important;
        padding: 8px 16px !important;
        font-weight: 600 !important;
        color: #059669 !important;
        border-color: #059669 !important;
        background: transparent !important;
        transition: all 0.2s;
    }

    .back-btn:hover {
        color: #ffffff !important;
        background-color: #059669 !important;
        border-color: #059669 !important;
    }

    .form-input-premium {
        border-radius: 10px !important;
        padding: 11px 16px !important;
        border: 1.5px solid #e2e8f0 !important;
        background-color: #f8fafc !important;
        transition: all 0.2s !important;
    }

    .form-input-premium:focus {
        border-color: #059669 !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.1) !important;
    }

    .form-switch-premium .form-check-input {
        width: 2.8em !important;
        height: 1.5em !important;
        cursor: pointer;
        border: 1.5px solid #cbd5e1 !important;
        transition: all 0.2s ease !important;
    }

    .form-switch-premium .form-check-input:focus {
        box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.1) !important;
        border-color: #059669 !important;
    }

    .form-switch-premium .form-check-input:checked {
        background-color: #059669 !important;
        border-color: #059669 !important;
    }

    .preview-card {
        border-radius: 12px !important;
        border: 1px solid #e2e8f0 !important;
        transition: all 0.2s ease;
    }

    .preview-card:hover {
        border-color: #cbd5e1 !important;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05) !important;
    }

    .hover-delete:hover {
        background-color: #fee2e2 !important;
        color: #ef4444 !important;
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/events' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <%- include('../../partials/flashMessages') %>
            <div class="container-fluid">
                <div class="mb-4">
                    <a href="/schooladmin/events" class="btn btn-sm btn-outline-secondary back-btn mb-3">
                        <i class="fas fa-arrow-left me-1"></i> Back to Gallery
                    </a>
                    <h1 class="h3 text-gray-800 font-weight-bold mb-1">Edit Event Album: <%= event.title %></h1>
                    <p class="text-muted small">Update event metadata, manage album media, or add new uploads.</p>
                </div>
                <div class="row g-4">
                    <div class="col-lg-5">
                        <div class="premium-card mb-4">
                            <div class="premium-card-header bg-white border-bottom-0 py-3">
                                <h5 class="font-weight-bold mb-0 text-dark">Event Details</h5>
                            </div>
                            <div class="card-body p-4">
                                <form action="/schooladmin/events/edit/<%= event.id %>" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold text-secondary small">Event Title<span class="text-danger">*</span></label>
                                        <input type="text" name="title" class="form-control form-input-premium" value="<%= event.title %>" required>
                                    </div>
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label font-weight-bold text-secondary small">Event Date <span class="text-danger">*</span></label>
                                            <% const dateFormatted = new Date(event.event_date).toISOString().split('T')[0]; %>
                                            <input type="date" name="event_date" class="form-control form-input-premium" value="<%= dateFormatted %>" required>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label font-weight-bold text-secondary small">Category<span class="text-danger">*</span></label>
                                            <select name="event_type" class="form-select form-input-premium" required>
                                                <option value="Cultural" <%=event.event_type==='Cultural' ? 'selected' : '' %>>Cultural</option>
                                                <option value="Sports" <%=event.event_type==='Sports' ? 'selected' : '' %>>Sports</option>
                                                <option value="Academic" <%=event.event_type==='Academic' ? 'selected' : '' %>>Academic</option>
                                                <option value="Festival" <%=event.event_type==='Festival' ? 'selected' : '' %>>Festival</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold text-secondary small">Venue <span class="text-danger">*</span></label>
                                        <input type="text" name="venue" class="form-control form-input-premium" value="<%= event.venue %>" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold text-secondary small">Description</label>
                                        <textarea name="description" class="form-control form-input-premium" rows="4"><%= event.description %></textarea>
                                    </div>
                                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                                        <h6 class="font-weight-bold text-dark small mb-3">Permissions & Protection Settings</h6>
                                        <div class="form-check form-switch form-switch-premium mb-3">
                                            <input class="form-check-input" type="checkbox" id="downloadSwitch" name="download_allowed" <%=event.download_allowed===1 ? 'checked' : '' %>>
                                            <label class="form-check-label font-weight-bold text-secondary small ms-2" for="downloadSwitch">
                                                <i class="fas fa-download me-1 text-emerald-600"></i>
                                                Allow Non-Admins to Download
                                            </label>
                                        </div>
                                        <div class="form-check form-switch form-switch-premium">
                                            <input class="form-check-input" type="checkbox" id="watermarkSwitch" name="watermark_enabled" <%=event.watermark_enabled===1 ? 'checked' : '' %>>
                                            <label class="form-check-label font-weight-bold text-secondary small ms-2" for="watermarkSwitch">
                                                <i class="fas fa-copyright me-1 text-danger"></i> Enable Dynamic Image Watermarks
                                            </label>
                                        </div>
                                    </div>
                                    <div id="captionsFormHelper">
                                        <% media.forEach(m=> { %>
                                            <input type="hidden" name="existing_captions[<%= m.id %>]" id="caption-hidden-<%= m.id %>" value="<%= m.caption || '' %>">
                                        <% }); %>
                                    </div>
                                    <button type="submit" class="btn btn-premium-primary w-100 shadow-sm">
                                        <i class="fas fa-save me-1"></i> Update Details & Captions
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="premium-card mb-4">
                            <div class="premium-card-header bg-white border-bottom-0 py-3 d-flex justify-content-between align-items-center">
                                <h5 class="font-weight-bold mb-0 text-dark">Existing Album Media</h5>
                                <span class="badge bg-secondary rounded-pill"><%= media.length %> Items</span>
                            </div>
                            <div class="card-body p-4">
                                <% if (media && media.length> 0) { %>
                                    <div class="row row-cols-1 row-cols-sm-2 g-3">
                                        <% media.forEach(item=> { %>
                                            <div class="col" id="media-card-<%= item.id %>">
                                                <div class="card h-100 border shadow-sm overflow-hidden position-relative rounded-3">
                                                    <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 shadow-sm rounded-circle p-2" onclick="deleteMedia('<%= item.id %>')">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 140px; overflow: hidden;">
                                                        <% if (item.media_type==='image' ) { %>
                                                            <img src="/media/<%= item.id %>" class="w-100 h-100 object-cover" style="object-fit: cover;">
                                                        <% } else { %>
                                                            <div class="text-center p-3 text-secondary">
                                                                <i class="fas fa-film fa-3x mb-2 text-danger"></i>
                                                                <div class="small font-weight-bold text-truncate w-100 px-2" title="<%= item.file_name %>">
                                                                    <%= item.file_name %>
                                                                </div>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <div class="card-body p-2 bg-light">
                                                        <label class="small text-muted font-weight-bold mb-1">Caption</label>
                                                        <input type="text" class="form-control form-control-sm form-input-premium" value="<%= item.caption || '' %>" oninput="syncCaption('<%= item.id %>', this.value)" placeholder="Enter caption...">
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <div class="text-center py-4 text-muted">
                                        <i class="far fa-images fa-2x mb-2"></i>
                                        <p class="small mb-0">No media files uploaded yet.</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="premium-card">
                            <div class="premium-card-header bg-white border-bottom-0 py-3">
                                <h5 class="font-weight-bold mb-0 text-dark">Upload Additional Media</h5>
                            </div>
                            <div class="card-body p-4">
                                <form id="uploadMoreForm" enctype="multipart/form-data">
                                    <div id="dropZoneMore" class="dropzone-container d-flex flex-column align-items-center justify-content-center p-4 mb-3 transition-all duration-300">
                                        <i class="fas fa-cloud-upload-alt fa-2x text-emerald-600 mb-2"></i>
                                        <span class="small font-weight-bold text-dark">Click to browse or drop new files</span>
                                        <button type="button" class="btn btn-sm btn-outline-premium mt-2 rounded-pill" onclick="document.getElementById('fileInputMore').click()"> Browse</button>
                                        <input type="file" id="fileInputMore" name="media" multiple accept="image/*,video/*" class="d-none">
                                    </div>
                                    <div id="progressWrapperMore" class="mb-3 d-none">
                                        <div class="d-flex justify-content-between mb-1 small text-muted font-weight-bold">
                                            <span>Uploading...</span>
                                            <span id="progressPercentMore">0%</span>
                                        </div>
                                        <div class="progress" style="height: 6px; border-radius: 3px;">
                                            <div id="progressBarMore" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                                        </div>
                                    </div>
                                    <div id="previewContainerMore" class="row row-cols-1 g-2 mb-3"></div>
                                    <button type="submit" id="uploadMoreBtn" class="btn btn-premium-primary w-100" disabled>
                                        <i class="fas fa-upload me-1"></i> Start Uploading New Media
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>
<script>
    function syncCaption(mediaId, value) {
        const hiddenInput = document.getElementById(`caption-hidden-${mediaId}`);
        if (hiddenInput) {
            hiddenInput.value = value;
        }
    }

    async function deleteMedia(mediaId) {
        if (!confirm("Are you sure you want to permanently delete this media file?")) return;

        try {
            const res = await fetch(`/schooladmin/media/${mediaId}`, {
                method: "DELETE"
            });
            const data = await res.json();
            if (data.success) {
                const mediaCard = document.getElementById(`media-card-${mediaId}`);
                if (mediaCard) mediaCard.remove();

                const hiddenInput = document.getElementById(`caption-hidden-${mediaId}`);
                if (hiddenInput) hiddenInput.remove();
            } else {
                alert("Error: " + data.message);
            }
        } catch (err) {
            console.error("Delete media error:", err);
            alert("Failed to delete media file.");
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const dropZone = document.getElementById("dropZoneMore");
        const fileInput = document.getElementById("fileInputMore");
        const previewContainer = document.getElementById("previewContainerMore");
        const progressWrapper = document.getElementById("progressWrapperMore");
        const progressBar = document.getElementById("progressBarMore");
        const progressPercent = document.getElementById("progressPercentMore");
        const uploadBtn = document.getElementById("uploadMoreBtn");
        const uploadForm = document.getElementById("uploadMoreForm");

        let newFiles = [];

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            });
        });

        dropZone.addEventListener('drop', (e) => {
            handleNewFiles(e.dataTransfer.files);
        });

        fileInput.addEventListener('change', (e) => {
            handleNewFiles(e.target.files);
        });

        function handleNewFiles(files) {
            Array.from(files).forEach(file => {
                newFiles.push(file);
                renderNewPreview(file, newFiles.length - 1);
            });
            uploadBtn.disabled = newFiles.length === 0;
        }

        window.removeNewFile = (index) => {
            newFiles = newFiles.filter((_, i) => i !== index);

            previewContainer.innerHTML = "";
            newFiles.forEach((file, i) => {
                renderNewPreview(file, i);
            });

            uploadBtn.disabled = newFiles.length === 0;
        };

        function renderNewPreview(file, index) {
            const item = document.createElement("div");
            item.className = "col";
            item.innerHTML = `
            <div class="card p-2 border shadow-sm">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="far ${file.type.startsWith('video/') ? 'fa-file-video text-danger' : 'fa-file-image text-emerald-600'}"></i>
                        <span class="small font-weight-bold text-truncate" style="max-width: 180px;">${file.name}</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-end">
                        <input type="text" name="new_captions[]" class="form-control form-control-sm w-50" placeholder="Caption...">
                        <button type="button" class="btn btn-sm btn-light border hover-delete text-muted rounded-circle p-2" onclick="removeNewFile(${index})">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        `;
            previewContainer.appendChild(item);
        }

        uploadForm.addEventListener("submit", (e) => {
            e.preventDefault();
            if (newFiles.length === 0) return;

            uploadBtn.disabled = true;
            progressWrapper.classList.remove("d-none");

            const formData = new FormData();
            newFiles.forEach(file => {
                formData.append("media", file);
            });

            const captionInputs = previewContainer.querySelectorAll("input[name='new_captions[]']");
            captionInputs.forEach(input => {
                formData.append("captions[]", input.value);
            });

            const xhr = new XMLHttpRequest();
            xhr.open("POST", "/schooladmin/events/<%= event.id %>/media", true);

            xhr.upload.onprogress = (event) => {
                if (event.lengthComputable) {
                    const percent = Math.round((event.loaded / event.total) * 100);
                    progressBar.style.width = percent + "%";
                    progressPercent.textContent = percent + "%";
                }
            };

            xhr.onload = () => {
                if (xhr.status >= 200 && xhr.status < 300) {
                    window.location.reload();
                } else {
                    alert("Upload failed.");
                    uploadBtn.disabled = false;
                    progressWrapper.classList.add("d-none");
                }
            };

            xhr.send(formData);
        });
    });
</script>