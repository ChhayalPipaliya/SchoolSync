<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Promotion Batch #<%= batch.id %></h2>
          <p class="text-xs text-gray-500 mt-1"><%= batch.from_year %> to <%= batch.to_year %></p>
        </div>
        <div class="flex gap-2">
          <a href="/schooladmin/promotions/history" class="btn btn-light"><i class="fa-solid fa-arrow-left mr-1"></i> History</a>
          <a href="/schooladmin/promotions" class="btn btn-primary"><i class="fa-solid fa-plus mr-1"></i> New Promotion</a>
        </div>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Total</div><div class="text-xl font-extrabold text-gray-800"><%= batch.total_students || 0 %></div></div>
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Promoted</div><div class="text-xl font-extrabold text-emerald-600"><%= batch.promoted_count || 0 %></div></div>
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Repeated</div><div class="text-xl font-extrabold text-amber-600"><%= batch.repeated_count || 0 %></div></div>
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Skipped</div><div class="text-xl font-extrabold text-slate-600"><%= batch.skipped_count || 0 %></div></div>
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Graduated</div><div class="text-xl font-extrabold text-blue-600"><%= batch.graduated_count || 0 %></div></div>
      </div>
      <div class="card p-5 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-sm">
          <div>
            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Status</div>
            <span class="badge <%= batch.status === 'completed' ? 'badge-success' : 'badge-warning' %> capitalize"><%= batch.status %></span>
          </div>
          <div>
            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Class Filter</div>
            <div class="font-semibold text-gray-700"><%= batch.class_name ? formatClassLabel(batch) : 'All classes' %></div>
          </div>
          <div>
            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Created</div>
            <div class="font-semibold text-gray-700"><%= batch.created_at ? new Date(batch.created_at).toLocaleString('en-IN') : '—' %></div>
          </div>
          <div>
            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Updated</div>
            <div class="font-semibold text-gray-700"><%= batch.updated_at ? new Date(batch.updated_at).toLocaleString('en-IN') : '—' %></div>
          </div>
        </div>
      </div>
      <div class="card p-0 overflow-hidden">
        <div class="p-5 border-b border-slate-100">
          <h3 class="text-base font-bold text-gray-800 mb-0">Students</h3>
        </div>
        <div class="table-responsive">
          <table class="table min-w-full divide-y divide-slate-100">
            <thead>
              <tr class="bg-slate-50">
                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Student</th>
                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">From</th>
                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">To</th>
                <th class="px-5 py-3 text-center text-xs font-bold text-gray-500 uppercase">Result</th>
                <th class="px-5 py-3 text-center text-xs font-bold text-gray-500 uppercase">Action</th>
                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">Reason</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-100">
              <% items.forEach(item => { %>
                <%
                  const fromLabel = formatClassLabel({ class_name: item.from_class_name, section: item.from_section, medium: item.from_medium, stream: item.from_stream });
                  const toLabel = item.to_class_id ? formatClassLabel({ class_name: item.to_class_name, section: item.to_section, medium: item.to_medium, stream: item.to_stream }) : 'No new class';
                  const actionClass = item.promotion_action === 'promote' ? 'badge-success' : (item.promotion_action === 'repeat' ? 'badge-warning' : (item.promotion_action === 'graduate' ? 'badge-info' : 'badge-secondary'));
                  const resultClass = item.result_status === 'pass' ? 'badge-success' : (item.result_status === 'fail' ? 'badge-warning' : 'badge-danger');
                %>
                <tr>
                  <td class="px-5 py-4">
                    <div class="font-bold text-gray-800 text-sm"><%= [item.first_name, item.last_name].filter(Boolean).join(' ') || 'Student' %></div>
                    <div class="text-[11px] text-gray-400"><%= item.admission_no ? ('GR: ' + item.admission_no) : 'GR not set' %></div>
                  </td>
                  <td class="px-5 py-4 text-sm font-semibold text-gray-600"><%= fromLabel %></td>
                  <td class="px-5 py-4 text-sm font-semibold text-gray-600"><%= toLabel %></td>
                  <td class="px-5 py-4 text-center"><span class="badge <%= resultClass %> capitalize"><%= item.result_status %></span></td>
                  <td class="px-5 py-4 text-center"><span class="badge <%= actionClass %> capitalize"><%= item.promotion_action %></span></td>
                  <td class="px-5 py-4 text-sm text-gray-500"><%= item.reason || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <%- include('../../partials/footer') %>
  </div>
</div>