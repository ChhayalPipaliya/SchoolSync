<%- include('../../partials/head', { title: `${lan.Promotion_Batch_Num || 'Promotion Batch #'} ${batch.id} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
  <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Promotion_Batch_Num || 'Promotion Batch #' %><%= batch.id %></h2>
          <p class="text-xs text-gray-500 mt-1"><%= batch.from_year %> <%- lan.To || 'to' %> <%= batch.to_year %></p>
        </div>
        <div class="flex gap-2">
          <a href="/schooladmin/promotions/history" class="btn btn-light"><i class="fa-solid fa-arrow-left mr-1"></i> <%- lan.History || 'History' %></a>
          <a href="/schooladmin/promotions" class="btn btn-primary"><i class="fa-solid fa-plus mr-1"></i> <%- lan.New_Promotion || 'New Promotion' %></a>
        </div>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Total || 'Total' %></div><div class="text-xl font-extrabold text-gray-800"><%= batch.total_students || 0 %></div></div>
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Promoted || 'Promoted' %></div><div class="text-xl font-extrabold text-emerald-600"><%= batch.promoted_count || 0 %></div></div>
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Repeated || 'Repeated' %></div><div class="text-xl font-extrabold text-amber-600"><%= batch.repeated_count || 0 %></div></div>
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Skipped || 'Skipped' %></div><div class="text-xl font-extrabold text-slate-600"><%= batch.skipped_count || 0 %></div></div>
        <div class="card p-4 mb-0"><div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Graduated || 'Graduated' %></div><div class="text-xl font-extrabold text-blue-600"><%= batch.graduated_count || 0 %></div></div>
      </div>
      <div class="card p-5 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-sm">
          <div>
            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Status || 'Status' %></div>
            <span class="badge <%= batch.status === 'completed' ? 'badge-success' : 'badge-warning' %> capitalize"><%= batch.status === 'completed' ? (lan.Completed || 'completed') : batch.status %></span>
          </div>
          <div>
            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Class_Filter || 'Class Filter' %></div>
            <div class="font-semibold text-gray-700"><%= batch.class_name ? formatClassLabel(batch) : (lan.All_Classes || 'All classes') %></div>
          </div>
          <div>
            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Created || 'Created' %></div>
            <div class="font-semibold text-gray-700"><%= batch.created_at ? new Date(batch.created_at).toLocaleString('en-IN') : '—' %></div>
          </div>
          <div>
            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%- lan.Updated || 'Updated' %></div>
            <div class="font-semibold text-gray-700"><%= batch.updated_at ? new Date(batch.updated_at).toLocaleString('en-IN') : '—' %></div>
          </div>
        </div>
      </div>
      <div class="card p-0 overflow-hidden">
        <div class="p-5 border-b border-slate-100">
          <h3 class="text-base font-bold text-gray-800 mb-0"><%- lan.Students || 'Students' %></h3>
        </div>
        <div class="table-responsive">
          <table class="table min-w-full divide-y divide-slate-100">
            <thead>
              <tr class="bg-slate-50">
                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%- lan.Student || 'Student' %></th>
                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%- lan.From || 'From' %></th>
                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%- lan.To || 'To' %></th>
                <th class="px-5 py-3 text-center text-xs font-bold text-gray-500 uppercase"><%- lan.Result || 'Result' %></th>
                <th class="px-5 py-3 text-center text-xs font-bold text-gray-500 uppercase"><%- lan.Action || 'Action' %></th>
                <th class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%- lan.Reason || 'Reason' %></th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-100">
              <% (items||[]).forEach(item => { %>
                <%
                  const fromLabel = formatClassLabel({ class_name: item.from_class_name, section: item.from_section, medium: item.from_medium, stream: item.from_stream });
                  const toLabel = item.to_class_id ? formatClassLabel({ class_name: item.to_class_name, section: item.to_section, medium: item.to_medium, stream: item.to_stream }) : (lan.No_New_Class || 'No new class');
                  const actionClass = item.promotion_action === 'promote' ? 'badge-success' : (item.promotion_action === 'repeat' ? 'badge-warning' : (item.promotion_action === 'graduate' ? 'badge-info' : 'badge-secondary'));
                  const resultClass = item.result_status === 'pass' ? 'badge-success' : (item.result_status === 'fail' ? 'badge-warning' : 'badge-danger');
                  
                  let actionLabel = item.promotion_action;
                  if (item.promotion_action === 'promote') actionLabel = lan.Promote || 'promote';
                  else if (item.promotion_action === 'repeat') actionLabel = lan.Repeat || 'repeat';
                  else if (item.promotion_action === 'skip') actionLabel = lan.Skip || 'skip';
                  else if (item.promotion_action === 'graduate') actionLabel = lan.Graduate || 'graduate';

                  let resLabel = item.result_status;
                  if (item.result_status === 'pass') resLabel = lan.Pass || 'pass';
                  else if (item.result_status === 'fail') resLabel = lan.Fail || 'fail';
                %>
                <tr>
                  <td class="px-5 py-4">
                    <div class="font-bold text-gray-800 text-sm"><%= [item.first_name, item.last_name].filter(Boolean).join(' ') || (lan.Student || 'Student') %></div>
                    <div class="text-[11px] text-gray-400"><%= item.admission_no ? ('GR: ' + item.admission_no) : (lan.GR_Not_Set || 'GR not set') %></div>
                  </td>
                  <td class="px-5 py-4 text-sm font-semibold text-gray-600"><%= fromLabel %></td>
                  <td class="px-5 py-4 text-sm font-semibold text-gray-600"><%= toLabel %></td>
                  <td class="px-5 py-4 text-center"><span class="badge <%= resultClass %> capitalize"><%= resLabel %></span></td>
                  <td class="px-5 py-4 text-center"><span class="badge <%= actionClass %> capitalize"><%= actionLabel %></span></td>
                  <td class="px-5 py-4 text-sm text-gray-500"><%= item.reason || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
</div>
        <%- include('../../partials/footer') %>
          </div>
    </div>

  </div>
</div>