<%- include('../../partials/head', { title: `${lan.Promotion_Preview || 'Promotion Preview' } | SchoolSync` }) %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Promotion_Preview
                                        || 'Promotion Preview' %></h2>
                                <p class="text-xs text-gray-500 mt-1">
                                    <%= fromYear.code %> <%- lan.To || 'to' %>
                                            <%= toYear.code %>. <%- lan.Review_Before_Confirmation
                                                    || 'Review every student before confirmation.' %>
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <a href="/schooladmin/promotions" class="btn btn-light"><i
                                        class="fa-solid fa-arrow-left mr-1"></i> <%- lan.Back || 'Back' %></a>
                                <a href="/schooladmin/promotions/history" class="btn btn-secondary"><i
                                        class="fa-solid fa-clock-rotate-left mr-1"></i> <%- lan.History || 'History'
                                        %></a>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
                                <% const counts=(rows||[]).reduce((acc, row)=> {
                                    acc[row.promotion_action] = (acc[row.promotion_action] || 0) + 1;
                                    return acc;
                                    }, {});
                                    %>
                                    <div class="card p-4 mb-0">
                                        <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%-
                                                lan.Promote || 'Promote' %></div>
                                        <div class="text-xl font-extrabold text-emerald-600">
                                            <%= counts.promote || 0 %>
                                        </div>
                                    </div>
                                    <div class="card p-4 mb-0">
                                        <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%-
                                                lan.Repeat || 'Repeat' %></div>
                                        <div class="text-xl font-extrabold text-amber-600">
                                            <%= counts.repeat || 0 %>
                                        </div>
                                    </div>
                                    <div class="card p-4 mb-0">
                                        <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%-
                                                lan.Skip || 'Skip' %></div>
                                        <div class="text-xl font-extrabold text-slate-600">
                                            <%= counts.skip || 0 %>
                                        </div>
                                    </div>
                                    <div class="card p-4 mb-0">
                                        <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider"><%-
                                                lan.Graduate || 'Graduate' %></div>
                                        <div class="text-xl font-extrabold text-blue-600">
                                            <%= counts.graduate || 0 %>
                                        </div>
                                    </div>
                            </div>
                            <div class="p-4 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-sm mb-3">
                                <i class="fa-solid fa-triangle-exclamation mr-1"></i>
                                <%- lan.Promotion_Notice_Text
                                    || 'This will create student records for the new academic year. Old academic year records will remain unchanged.'
                                    %>
                            </div>
                            <% if (!rows || rows.length===0) { %>
                                <div class="card text-center py-16">
                                    <div class="empty-state">
                                        <div class="empty-state-icon"><i class="fa-solid fa-user-graduate"></i></div>
                                        <h3 class="empty-state-title"><%- lan.No_Active_Students_Found
                                                || 'No active students found' %></h3>
                                        <p class="empty-state-text"><%- lan.Adjust_Filters_Notice
                                                || 'Adjust filters or verify academic-year records for the selected year.'
                                                %></p>
                                        <a href="/schooladmin/promotions" class="btn btn-primary btn-sm mt-4"><%-
                                                lan.Choose_Again || 'Choose Again' %></a>
                                    </div>
                                </div>
                                <% } else { %>
                                    <form method="POST" action="/schooladmin/promotions/confirm"
                                        id="promotionConfirmForm">
                                        <input type="hidden" name="_csrf"
                                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <input type="hidden" name="batch_id" value="<%= batch.id %>">
                                        <div class="card p-0 overflow-hidden">
                                            <div class="table-responsive">
                                                <table class="table min-w-full divide-y divide-slate-100">
                                                    <thead>
                                                        <tr class="bg-slate-50">
                                                            <th
                                                                class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">
                                                                <%- lan.Student || 'Student' %>
                                                            </th>
                                                            <th
                                                                class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">
                                                                <%- lan.Current_Class || 'Current Class' %>
                                                            </th>
                                                            <th
                                                                class="px-5 py-3 text-center text-xs font-bold text-gray-500 uppercase">
                                                                <%- lan.Result || 'Result' %>
                                                            </th>
                                                            <th
                                                                class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">
                                                                <%- lan.Action || 'Action' %>
                                                            </th>
                                                            <th
                                                                class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">
                                                                <%- lan.Target_Class || 'Target Class' %>
                                                            </th>
                                                            <th
                                                                class="px-5 py-3 text-left text-xs font-bold text-gray-500 uppercase">
                                                                <%- lan.Reason || 'Reason' %>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="bg-white divide-y divide-slate-100">
                                                        <% rows.forEach((row, index)=> { %>
                                                            <% const resultClass=row.result_status==='pass'
                                                                ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                                                (row.result_status==='fail'
                                                                ? 'bg-amber-50 text-amber-700 border-amber-200'
                                                                : 'bg-rose-50 text-rose-700 border-rose-200' ); const
                                                                actionLabel=row.result_status==='pass' ? (lan.Promote
                                                                || 'Promote' ) : (row.result_status==='fail' ?
                                                                (lan.Repeat_Same_Class || 'Repeat Same Class' ) :
                                                                (lan.Needs_Review || 'Needs Review' )); %>
                                                                <tr>
                                                                    <td class="px-5 py-4">
                                                                        <input type="hidden" name="item_id"
                                                                            value="<%= row.item_id %>">
                                                                        <div class="font-bold text-gray-800 text-sm">
                                                                            <%= row.name || (lan.Student || 'Student' ) %>
                                                                        </div>
                                                                        <div class="text-[11px] text-gray-400 mt-1">
                                                                            <%= row.admission_no ? ('GR: ' + row.admission_no) : (lan.GR_Not_Set || 'GR not set') %>
                                                                            <% if (row.roll_number) { %> · <%- lan.Roll_Number || 'Roll' %> <%= row.roll_number %><% } %>
                                                                        </div>
                                                                    </td>
                                                                    <td class="px-5 py-4 text-sm font-semibold text-gray-600">
                                                                        <%= row.current_class_label %>
                                                                    </td>
                                                                    <td class="px-5 py-4 text-center">
                                                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold border <%= resultClass %>">
                                                                            <%= actionLabel %>
                                                                        </span>
                                                                        <% if (row.warning) { %>
                                                                            <div class="text-[11px] text-amber-700 mt-2 max-w-[180px] mx-auto">
                                                                                <%= row.warning %>
                                                                            </div>
                                                                        <% } %>
                                                                    </td>
                                                                    <td class="px-5 py-4">
                                                                        <select name="promotion_action" class="form-select promotion-action" data-row="<%= index %>">
                                                                            <option value="promote" <%=row.promotion_action==='promote' ? 'selected' : '' %>><%- lan.Promote || 'Promote' %></option>
                                                                            <option value="repeat" <%=row.promotion_action==='repeat' ? 'selected' : '' %>><%- lan.Repeat || 'Repeat' %></option>
                                                                            <option value="skip" <%=row.promotion_action==='skip' ? 'selected' : '' %>><%- lan.Skip_Slash_Transfer || 'Skip / Transfer' %></option>
                                                                            <option value="graduate" <%=row.promotion_action==='graduate' ? 'selected' : '' %>><%- lan.Graduate || 'Graduate' %></option>
                                                                        </select>
                                                                    </td>
                                                                    <td class="px-5 py-4">
                                                                        <select name="to_class_id"
                                                                            class="form-select target-class"
                                                                            data-row="<%= index %>">
                                                                            <option value=""><%- lan.No_Class || 'No class' %></option>
                                                                            <% (targetClasses||[]).forEach(cls=> { %>
                                                                                <option value="<%= cls.id %>" <%=Number(row.to_class_id)===Number(cls.id) ? 'selected' : '' %>><%= formatClassLabel(cls) %></option>
                                                                            <% }) %>
                                                                        </select>
                                                                        <div class="text-[11px] text-gray-400 mt-1"><%- lan.Suggested_Colon || 'Suggested:' %>
                                                                            <%= row.suggested_class_label %>
                                                                        </div>
                                                                    </td>
                                                                    <td class="px-5 py-4">
                                                                        <input type="text" name="reason" class="form-input" maxlength="255" value="<%= row.reason || '' %>" placeholder="<%- lan.Optional_Note || 'Optional note' %>">
                                                                    </td>
                                                                </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="flex flex-col sm:flex-row justify-end gap-3 mt-5">
                                            <a href="/schooladmin/promotions" class="btn btn-light"><%- lan.Cancel
                                                    || 'Cancel' %></a>
                                            <button type="button" class="btn btn-primary" onclick="openConfirmModal()">
                                                <i class="fa-solid fa-check mr-1"></i> <%- lan.Confirm_Promotion
                                                    || 'Confirm Promotion' %>
                                            </button>
                                        </div>
                                        <div id="confirmPromotionModal"
                                            class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                                            <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-lg mx-4">
                                                <h3
                                                    class="text-base font-bold text-gray-800 mb-3 flex items-center gap-2">
                                                    <i class="fa-solid fa-circle-exclamation text-amber-500"></i> <%-
                                                        lan.Confirm_Student_Promotion || 'Confirm Student Promotion' %>
                                                </h3>
                                                <p class="text-sm text-gray-600 mb-3"><%- lan.Promotion_Notice_Text
                                                        || 'This will create student records for the new academic year. Old academic year records will remain unchanged.'
                                                        %></p>
                                                <div
                                                    class="rounded-lg bg-slate-50 border border-slate-100 p-3 text-xs text-gray-500 mb-3">
                                                    <%- lan.Rerun_Batch_Notice
                                                        || 'Re-running the same batch will not create duplicate records for students who already have a target-year enrollment.'
                                                        %>
                                                </div>
                                                <div class="flex gap-3">
                                                    <button type="button" class="btn btn-light flex-1"
                                                        onclick="closeConfirmModal()"><%- lan.Review_Again
                                                            || 'Review Again' %></button>
                                                    <button type="submit" class="btn btn-primary flex-1"><%-
                                                            lan.Yes_Confirm || 'Yes, Confirm' %></button>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                    <% } %>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>
    <script>
        function openConfirmModal() {
            document.getElementById('confirmPromotionModal').classList.remove('hidden');
        }
        function closeConfirmModal() {
            document.getElementById('confirmPromotionModal').classList.add('hidden');
        }

        document.querySelectorAll('.promotion-action').forEach(function (select) {
            select.addEventListener('change', function () {
                const target = document.querySelector('.target-class[data-row="' + this.dataset.row + '"]');
                if (!target) return;
                if (this.value === 'skip' || this.value === 'graduate') {
                    target.value = '';
                }
            });
        });
    </script>