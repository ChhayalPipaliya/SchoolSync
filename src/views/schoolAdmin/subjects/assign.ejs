<%- include('../../partials/head') %>
<style>
        .form-section{border:1px solid #E2E8F0;border-radius:12px;padding:20px 24px;background:#fff;margin-bottom:20px;}
        .section-title{font-size:14px;font-weight:700;color:#4F46E5;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid #EEF2FF;display:flex;align-items:center;gap:8px;}
        .form-label-custom{font-size:12px;font-weight:600;color:#374151;margin-bottom:5px;display:block;}
        .form-control,.form-select{border-radius:8px;font-size:13px;border:1px solid #E2E8F0;padding:8px 12px;}
        .form-control:focus,.form-select:focus{border-color:#4F46E5;box-shadow:0 0 0 3px rgba(79,70,229,.08);}
        .type-card{padding:14px 16px;border-radius:10px;border:2px solid #E2E8F0;cursor:pointer;transition:.15s;text-align:center;}
        .type-card:hover{border-color:#4F46E5;}
        .type-card.active{background:#EEF2FF;border-color:#4F46E5;}

        [data-theme="dark"] .form-section {
            background: #151D30 !important;
            border-color: #242F4D !important;
        }
        [data-theme="dark"] .form-label-custom,
        [data-theme="dark"] .section-title {
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .form-input,
        [data-theme="dark"] .form-select,
        [data-theme="dark"] .form-control {
            background: #1E293B !important;
            border-color: #242F4D !important;
            color: #F1F5F9 !important;
        }

        @media (max-width: 768px) {
            .form-section { padding: 16px 14px; margin-bottom: 14px; }
        }
    </style>
<div class="app-wrapper schooladmin-theme">
<%- include('../../partials/flashMessages') %>
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
        <div style="display:none">
            <div>
                <div style="font-size:18px;font-weight:700;color:#1E293B;"><%- lan.Edit_Subject || 'Edit Subject' %></div>
                <div style="font-size:12px;color:#94A3B8;">
                    <a href="/schooladmin/subjects" style="color:#4F46E5;text-decoration:none;"><%- lan.Subjects || 'Subjects' %></a>
                    → <%= selectedClass ? selectedClass.name : (lan.Assign_Subjects || 'Assign Subjects') %>
                </div>
            </div>
            <a href="/schooladmin/subjects" class="btn btn-sm"
               style="background:#F1F5F9;color:#64748B;border-radius:8px;font-weight:600;">
                <i class="fa-solid fa-arrow-left me-1"></i> <%- lan.Back || 'Back' %>
            </a>
        </div>
        <form action="/schooladmin/subjects/<%= subject.id %>/edit" method="POST">
            <div class="form-section">
                <div class="section-title"><i class="fa-solid fa-pen"></i> <%- lan.Edit_Subject_Details || 'Edit Subject Details' %></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-custom"><%- lan.Subject_Name || 'Subject Name' %> <span style="color:#DC2626;">*</span></label>
                        <input type="text" name="name" value="<%= subject.name %>" required class="form-input">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label-custom"><%- lan.Short_Code || 'Short Code' %></label>
                        <input type="text" name="code" value="<%= subject.code||'' %>" class="form-input" maxlength="10" style="text-transform:uppercase;" oninput="this.value=this.value.toUpperCase()">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label-custom"><%- lan.Status || 'Status' %></label>
                        <select name="status" class="form-select">
                            <option value="active"   <%= subject.status==='active'  ?'selected':'' %>><%- lan.Active || 'Active' %></option>
                            <option value="inactive" <%= subject.status==='inactive'?'selected':'' %>><%- lan.Inactive || 'Inactive' %></option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-center">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:10px 14px;border-radius:8px;border:1.5px solid #E2E8F0;width:100%;background:#F8FAFC;">
                            <input type="checkbox" name="is_optional" value="1" <%= subject.is_optional ? 'checked' : '' %> style="width:16px;height:16px;">
                            <div>
                                <div style="font-size:12px;font-weight:600;color:#374151;"><%- lan.Optional_Subject || 'Optional Subject' %></div>
    <main class="main-panel" id="mainPanel">
        <%- include('../../partials/header') %>
        <%- include('../../partials/flashMessages') %>
        <div class="page-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div style="font-size:18px;font-weight:700;color:#1E293B;"><%- lan.Edit_Subject || 'Edit Subject' %></div>
                    <div style="font-size:12px;color:#94A3B8;">
                        <a href="/schooladmin/subjects" style="color:#4F46E5;text-decoration:none;"><%- lan.Subjects || 'Subjects' %></a>
                        → <%= selectedClass ? selectedClass.name : (lan.Assign_Subjects || 'Assign Subjects') %>
                    </div>
                </div>
                <a href="/schooladmin/subjects" class="btn btn-sm"
                   style="background:#F1F5F9;color:#64748B;border-radius:8px;font-weight:600;">
                    <i class="fa-solid fa-arrow-left me-1"></i> <%- lan.Back || 'Back' %>
                </a>
            </div>
            <form action="/schooladmin/subjects/<%= subject.id %>/edit" method="POST">
                <input type="hidden" name="subject_type" id="typeInput" value="<%= subject.subject_type || 'theory' %>">
                <div class="form-section">
                    <div class="section-title">
                        <i class="fa-solid fa-book"></i> <%- lan.Basic_Details || 'Basic Details' %>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-custom"><%- lan.Subject_Name || 'Subject Name' %> *</label>
                            <input type="text" name="name" class="form-control"
                                   value="<%= subject.name %>" required
                                   placeholder="<%- lan.Subject_Name_Placeholder || 'e.g. Mathematics, Science...' %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom"><%- lan.Subject_Code || 'Subject Code' %></label>
                            <input type="text" name="code" class="form-control"
                                   value="<%= subject.code || '' %>"
                                   placeholder="<%- lan.Subject_Code_Placeholder || 'e.g. MATH101' %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom"><%- lan.Credit_Hours || 'Credit Hours' %></label>
                            <input type="number" name="credit_hours" class="form-control"
                                   value="<%= subject.credit_hours || 1 %>" min="1" max="10">
                        </div>
                    </div>
                </div>
                <div class="form-section">
                    <div class="section-title">
                        <i class="fa-solid fa-shapes"></i> <%- lan.Subject_Type || 'Subject Type' %>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="type-card <%= (!subject.subject_type || subject.subject_type==='theory')?'active':'' %>"
                                 id="card-theory" onclick="selectType('theory')">
                                <i class="fa-solid fa-book-open fa-lg mb-2" style="color:#4F46E5;display:block;"></i>
                                <div style="font-size:13px;font-weight:700;color:#1E293B;"><%- lan.Theory || 'Theory' %></div>
                                <div style="font-size:11px;color:#64748B;margin-top:3px;"><%- lan.Standard_Classroom_Subject || 'Standard classroom subject' %></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="type-card <%= subject.subject_type==='practical'?'active':'' %>"
                                 id="card-practical" onclick="selectType('practical')">
                                <i class="fa-solid fa-flask fa-lg mb-2" style="color:#059669;display:block;"></i>
                                <div style="font-size:13px;font-weight:700;color:#1E293B;"><%- lan.Practical || 'Practical' %></div>
                                <div style="font-size:11px;color:#64748B;margin-top:3px;"><%- lan.Lab_HandsOn_Subject || 'Lab / Hands-on subject' %></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="type-card <%= subject.subject_type==='activity'?'active':'' %>"
                                    id="card-activity" onclick="selectType('activity')">
                                <i class="fa-solid fa-palette fa-lg mb-2" style="color:#D97706;display:block;"></i>
                                <div style="font-size:13px;font-weight:700;color:#1E293B;"><%- lan.Activity || 'Activity' %></div>
                                <div style="font-size:11px;color:#64748B;margin-top:3px;"><%- lan.Art_Sports_Cocurricular || 'Art, Sports, Co-curricular' %></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-3 pb-4">
                    <button type="submit" class="btn text-white px-4 py-2 w-full sm:w-auto justify-center"
                            style="background:#4F46E5;border-radius:8px;font-size:14px;font-weight:600;border:none;">
                        <i class="fa-solid fa-save me-2"></i><%- lan.Save_Changes || 'Save Changes' %>
                    </button>
                    <a href="/schooladmin/subjects" class="btn px-4 py-2 w-full sm:w-auto text-center justify-center"
                        style="background:#F1F5F9;color:#64748B;border-radius:8px;font-size:14px;font-weight:600;display:inline-flex;align-items:center;">
                        <%- lan.Cancel || 'Cancel' %>
                    </a>
                </div>
            </form>
        </div>
        <%- include('../../partials/footer') %>
    </main>
</div>
<script>
    function selectType(t) {
        document.getElementById('typeInput').value = t;
        ['theory','practical','activity'].forEach(x =>
            document.getElementById('card-'+x).classList.remove('active')
        );
        document.getElementById('card-'+t).classList.add('active');
    }
</script>
</body>
</html>