<%- include('../../partials/head') %>
<style>
    .type-pill{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}
    .type-theory{background:#EEF2FF;color:#4F46E5;}
    .type-practical{background:#ECFDF5;color:#059669;}
    .type-activity{background:#FEF3C7;color:#92400E;}
    .opt-badge{background:#F1F5F9;color:#64748B;padding:2px 8px;border-radius:20px;font-size:10px;font-weight:700;}
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Subject_Management || 'Subject Management' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Manage_School_Subject_Master_List || 'Manage school subject master list' %></p>
                </div>
                <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                    <form action="/schooladmin/subjects/auto-populate" method="POST" class="w-full sm:w-auto inline">
                        <button type="submit" class="btn btn-secondary w-full justify-center"
                            onclick="return confirm('<%= lan.Confirm_Auto_Populate_Subjects %>')">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> <%- lan.Auto_Populate || 'Auto-Populate' %>
                        </button>
                    </form>
                    <a href="/schooladmin/subjects/assign" class="btn btn-secondary flex-1 sm:flex-initial justify-center">
                        <i class="fa-solid fa-link"></i> <%- lan.Assign_To_Classes || 'Assign to Classes' %>
                    </a>
                    <a href="/schooladmin/subjects/add" class="btn btn-primary flex-1 sm:flex-initial justify-center">
                        <i class="fa-solid fa-plus"></i> <%- lan.Add_Subject || 'Add Subject' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <% if(!subjects || subjects.length === 0) { %>
                <div class="card text-center py-16">
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i class="fa-solid fa-book"></i>
                        </div>
                        <h3 class="empty-state-title"><%- lan.No_Subjects_Yet || 'No subjects yet' %></h3>
                        <p class="empty-state-text"><%- lan.Click_Auto_Populate_Desc || 'Click Auto-Populate or add subjects manually.' %></p>
                        <div class="flex gap-3 justify-center mt-4">
                            <form action="/schooladmin/subjects/auto-populate" method="POST">
                                <button type="submit" class="btn btn-secondary btn-sm">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> <%- lan.Auto_Populate || 'Auto-Populate' %>
                                </button>
                            </form>
                            <a href="/schooladmin/subjects/add" class="btn btn-primary btn-sm">
                                <i class="fa-solid fa-plus"></i> <%- lan.Add_Manually || 'Add Manually' %>
                            </a>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="table-card">
                    <div class="table-header-row">
                        <h3 class="table-heading"><%- lan.All_Subjects_Title || 'All Subjects' %> <span class="text-gray-400 font-normal text-xs ml-1">(<%= subjects.length %> <%- lan.Total_Lower || 'total' %>)</span></h3>
                        <div class="table-actions">
                            <div class="table-search">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input type="search" id="searchInput" placeholder="<%= lan.Search_Subjects_Placeholder || 'Search subjects...' %>" oninput="searchTable()">
                            </div>
                        </div>
                    </div>
                    <div class="table-container">
                        <table class="data-table" id="subjectTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th><%- lan.Subject || 'Subject' %></th>
                                    <th><%- lan.Code || 'Code' %></th>
                                    <th><%- lan.Type || 'Type' %></th>
                                    <th><%- lan.Classes || 'Classes' %></th>
                                    <th><%- lan.Status || 'Status' %></th>
                                    <th class="text-center"><%- lan.Actions || 'Actions' %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% subjects.forEach((sub, i) => { %>
                                    <tr>
                                        <td class="text-gray-400"><%= i+1 %></td>
                                        <td>
                                            <div class="font-bold text-gray-800"><%= sub.name %></div>
                                            <% if(sub.is_optional) { %><span class="opt-badge"><%- lan.Optional || 'Optional' %></span><% } %>
                                        </td>
                                        <td>
                                            <span class="font-mono text-xs text-gray-500"><%= sub.code || '—' %></span>
                                        </td>
                                        <td>
                                            <span class="type-pill type-<%= sub.subject_type %>">
                                                <%= lan[sub.subject_type ? (sub.subject_type.charAt(0).toUpperCase() + sub.subject_type.slice(1)) : ''] || (sub.subject_type.charAt(0).toUpperCase() + sub.subject_type.slice(1)) %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if(sub.class_count > 0) { %>
                                                <span class="badge badge-role-success">
                                                    <%= sub.class_count %> <%= sub.class_count > 1 ? (lan.Classes_Plural || 'classes') : (lan.Class_Singular || 'class') %>
                                                </span>
                                            <% } else { %>
                                                <span class="text-gray-400 text-xs"><%- lan.Not_Assigned || 'Not assigned' %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if(sub.status === 'active') { %>
                                                <span class="badge badge-role-success"><%- lan.Active || 'Active' %></span>
                                            <% } else { %>
                                                <span class="badge badge-secondary" style="background: #F1F5F9; color: #475569;"><%- lan.Inactive || 'Inactive' %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="flex items-center justify-center gap-1.5">
                                                <a href="/schooladmin/subjects/<%= sub.id %>/edit" class="btn-icon btn-edit-icon" title="<%= lan.Edit || 'Edit' %>">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <form action="/schooladmin/subjects/<%= sub.id %>/delete" method="POST"
                                                    style="display:inline;" onsubmit="return confirm('<%= lan.Delete_Subject_Confirm %> <%= sub.name %>?')">
                                                    <button type="submit" class="btn-icon btn-danger-icon" title="<%= lan.Delete || 'Delete' %>">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<script>
    function searchTable() {
        const q = document.getElementById('searchInput').value.toLowerCase().trim();
        let visibleCount = 0;
        document.querySelectorAll('#subjectTable tbody tr').forEach(r => {
            const match = r.innerText.toLowerCase().includes(q);
            r.style.display = match ? '' : 'none';
            if (match) visibleCount++;
        });
        const noResultRow = document.getElementById('noSearchResult');
        if (noResultRow) noResultRow.style.display = visibleCount === 0 ? '' : 'none';
    }

    document.addEventListener('DOMContentLoaded', function() {
        const inp = document.getElementById('searchInput');
        if (!inp) return;
        inp.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                inp.value = '';
                searchTable();
                inp.blur();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === '/' && document.activeElement !== inp) {
                e.preventDefault();
                inp.focus();
                inp.select();
            }
        });
    });
</script>