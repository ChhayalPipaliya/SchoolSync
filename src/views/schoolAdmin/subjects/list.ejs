        <div style="padding: 14px 18px; background: linear-gradient(135deg, #059669 0%, #0d9488 100%); color: #fff; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 14px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-pen-to-square"></i> <%- lan.Edit_Subject || 'Edit Subject' %>
            </h3>
            <button type="button" onclick="document.getElementById('editSubjectModal').classList.add('hidden')" style="background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; line-height: 1;" aria-label="Close">&times;</button>
