<style>
    .subjects-page-stat-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .subjects-page-stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }
    .subjects-page-stat-label {
        font-size: 9px;
        font-weight: 700;
        color: #94A3B8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .subjects-page-stat-val {
        font-size: 16px;
        font-weight: 800;
        color: #1E293B;
        margin-top: 1px;
    }

    .type-pill {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 9999px;
        font-size: 10px;
        font-weight: 700;
        text-transform: capitalize;
    }
    .type-theory { background: rgba(59, 130, 246, 0.1); color: #1D4ED8; border: 1px solid rgba(59, 130, 246, 0.2); }
    .type-practical { background: rgba(16, 185, 129, 0.1); color: #047857; border: 1px solid rgba(16, 185, 129, 0.2); }
    .type-both { background: rgba(139, 92, 246, 0.1); color: #6D28D9; border: 1px solid rgba(139, 92, 246, 0.2); }
    .type-activity { background: rgba(245, 158, 11, 0.1); color: #B45309; border: 1px solid rgba(245, 158, 11, 0.2); }

    .subject-assignment-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 10px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        font-size: 11px;
        gap: 8px;
        transition: background 0.15s;
    }
    .subject-assignment-item:hover {
        background: #F1F5F9;
    }

    [data-theme="dark"] .subjects-page-stat-card,
    .light-mode-disabled .subjects-page-stat-card {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .subjects-page-stat-val,
    .light-mode-disabled .subjects-page-stat-val {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .subject-assignment-item,
    .light-mode-disabled .subject-assignment-item {
        background-color: #1E293B !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .subject-modal-panel,
    .light-mode-disabled .subject-modal-panel {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
</style>
<%- include('../../partials/head', { title: `${lan.Subjects || 'Subjects'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-book-open"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Subjects || 'Subjects' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Subjects_Subtitle || 'Manage school curriculum subjects and map them to classes & teachers' %></p>
                        </div>
                    </div>
                    <button type="button" onclick="document.getElementById('addSubjectModal').classList.remove('hidden')" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 14px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); cursor: pointer;">
                        <i class="fa-solid fa-plus"></i> <%- lan.Add_Subject || 'Add Subject' %>
                    </button>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <% 
                const totalSubjects = subjects ? subjects.length : 0;
                const theoryCount = subjects ? subjects.filter(s => (s.subject_type || '').toLowerCase() === 'theory').length : 0;
                const practicalCount = subjects ? subjects.filter(s => (s.subject_type || '').toLowerCase() === 'practical').length : 0;
                const totalAssigned = classSubjects ? classSubjects.length : 0;
            %>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; margin-bottom: 14px;">
                <div class="subjects-page-stat-card">
                    <div class="subjects-page-stat-icon" style="background: #ECFDF5; color: #059669;">
                        <i class="fa-solid fa-book-bookmark"></i>
                    </div>
                    <div>
                        <div class="subjects-page-stat-label"><%- lan.Total_Subjects || 'Total Subjects' %></div>
                        <div class="subjects-page-stat-val"><%= totalSubjects %></div>
                    </div>
                </div>
                <div class="subjects-page-stat-card">
                    <div class="subjects-page-stat-icon" style="background: #EFF6FF; color: #2563EB;">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>
                    <div>
                        <div class="subjects-page-stat-label"><%- lan.Theory_Subjects || 'Theory Subjects' %></div>
                        <div class="subjects-page-stat-val"><%= theoryCount %></div>
                    </div>
                </div>
                <div class="subjects-page-stat-card">
                    <div class="subjects-page-stat-icon" style="background: #FDF2F8; color: #DB2777;">
                        <i class="fa-solid fa-flask"></i>
                    </div>
                    <div>
                        <div class="subjects-page-stat-label"><%- lan.Practical_Subjects || 'Practical Subjects' %></div>
                        <div class="subjects-page-stat-val"><%= practicalCount %></div>
                    </div>
                </div>
                <div class="subjects-page-stat-card">
                    <div class="subjects-page-stat-icon" style="background: #F5F3FF; color: #7C3AED;">
                        <i class="fa-solid fa-link"></i>
                    </div>
                    <div>
                        <div class="subjects-page-stat-label"><%- lan.Class_Assignments || 'Class Assignments' %></div>
                        <div class="subjects-page-stat-val"><%= totalAssigned %></div>
                    </div>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 340px; gap: 14px; align-items: start;" class="subjects-layout-grid">
                <div class="card" style="border-radius: 10px; border: 1px solid #E2E8F0; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                    <div style="padding: 10px 14px; background: #F8FAFC; border-bottom: 1px solid #E2E8F0; display: flex; justify-content: space-between; align-items: center;">
                        <h3 style="font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #334155; margin: 0; display: flex; align-items: center; gap: 6px;">
                            <i class="fa-solid fa-list text-emerald-600"></i> <%- lan.All_Subjects_Title || 'All Subjects' %>
                        </h3>
                        <span class="badge badge-secondary" style="font-size: 10px; font-weight: 700; padding: 2px 8px;">
                            <%= totalSubjects %> <%- lan.Subjects || 'Subjects' %>
                        </span>
                    </div>
                    <div style="overflow-x: auto;">
                        <table class="data-table" style="width: 100%; font-size: 11px;">
                            <thead>
                                <tr style="background: #FAFAFA;">
                                    <th style="padding: 8px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #64748B;"><%- lan.Subject || 'Subject' %></th>
                                    <th style="padding: 8px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #64748B;"><%- lan.Code || 'Code' %></th>
                                    <th style="padding: 8px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #64748B;"><%- lan.Type || 'Type' %></th>
                                    <th style="padding: 8px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #64748B; text-align: center;"><%- lan.Max_Marks || 'Max Marks' %></th>
                                    <th style="padding: 8px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #64748B; text-align: center;"><%- lan.Actions || 'Actions' %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!subjects || subjects.length === 0) { %>
                                    <tr>
                                        <td colspan="5" style="text-align: center; padding: 30px 10px; color: #94A3B8;">
                                            <i class="fa-solid fa-book-open" style="font-size: 24px; color: #CBD5E1; margin-bottom: 6px;"></i>
                                            <p style="font-size: 11px; font-weight: 700; color: #475569; margin: 0 0 2px;"><%- lan.No_Subjects_Yet || 'No subjects yet' %></p>
                                            <p style="font-size: 10px; color: #94A3B8; margin: 0;"><%- lan.No_Subjects_Added_Yet_Desc || 'Use "Add Subject" to create your curriculum subjects.' %></p>
                                        </td>
                                    </tr>
                                <% } %>
                                <% (subjects || []).forEach(s => { 
                                    const subType = (s.subject_type || 'theory').toLowerCase();
                                %>
                                    <tr style="border-bottom: 1px solid #F1F5F9;">
                                        <td style="padding: 8px 12px; font-weight: 700; color: #1E293B;">
                                            <%= s.subject_name %>
                                        </td>
                                        <td style="padding: 8px 12px;">
                                            <span style="font-family: monospace; font-size: 10px; font-weight: 700; color: #475569; background: #F1F5F9; padding: 2px 6px; border-radius: 4px; border: 1px solid #E2E8F0;">
                                                <%= s.code || s.subject_code || '—' %>
                                            </span>
                                        </td>
                                        <td style="padding: 8px 12px;">
                                            <span class="type-pill type-<%= subType %>">
                                                <%= lan[s.subject_type ? (s.subject_type.charAt(0).toUpperCase() + s.subject_type.slice(1)) : ''] || s.subject_type || 'Theory' %>
                                            </span>
                                        </td>
                                        <td style="padding: 8px 12px; text-align: center; font-weight: 700; color: #1E293B;">
                                            <span><%= s.max_marks || 100 %></span>
                                            <% if (s.pass_marks) { %>
                                                <span style="font-size: 9px; font-weight: 600; color: #94A3B8; display: block;">Pass: <%= s.pass_marks %></span>
                                            <% } %>
                                        </td>
                                        <td style="padding: 8px 12px; text-align: center;">
                                            <div style="display: flex; gap: 4px; justify-content: center; align-items: center;">
                                                <button type="button" class="btn-icon btn-edit-icon btn-edit-subject"
                                                        data-id="<%= s.id %>"
                                                        data-name="<%= s.subject_name %>"
                                                        data-code="<%= s.code || s.subject_code || '' %>"
                                                        data-type="<%= s.subject_type || 'theory' %>"
                                                        data-max="<%= s.max_marks || 100 %>"
                                                        data-pass="<%= s.pass_marks || 35 %>"
                                                        data-status="<%= s.status || 'active' %>"
                                                        title="<%- lan.Edit || 'Edit' %>"
                                                        style="width: 26px; height: 26px; font-size: 11px; border-radius: 6px;">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <form method="POST" action="/schooladmin/subjects/<%= s.id %>/delete" style="display: inline; margin: 0;" onsubmit="return confirm('<%- lan.Delete_This_Subject_Confirm %>')">
                                                    <button type="submit" class="btn-icon btn-danger-icon" title="<%- lan.Delete || 'Delete' %>" style="width: 26px; height: 26px; font-size: 11px; border-radius: 6px;">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div>
                    <div class="card" style="border-radius: 10px; border: 1px solid #E2E8F0; padding: 14px 16px; margin-bottom: 12px; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                        <h3 style="font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #059669; margin: 0 0 12px; padding-bottom: 6px; border-bottom: 1px solid #F1F5F9; display: flex; align-items: center; gap: 6px;">
                            <i class="fa-solid fa-link"></i> <%- lan.Assign_Subject_To_Class || 'Assign Subject to Class' %>
                        </h3>
                        <form method="POST" action="/schooladmin/subjects/assign" style="display: flex; flex-direction: column; gap: 10px;">
                            <div>
                                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                                    <%- lan.Class || 'Class' %> <span style="color: #E11D48;">*</span>
                                </label>
                                <select name="class_id" required class="form-select" style="height: 34px; font-size: 11px; border-radius: 6px;">
                                    <option value=""><%- lan.Select_Class || 'Select Class' %></option>
                                    <% (classes || []).forEach(c => { %>
                                        <option value="<%= c.id %>"><%= c.label || c.class_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div>
                                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                                    <%- lan.Subject || 'Subject' %> <span style="color: #E11D48;">*</span>
                                </label>
                                <select name="subject_id" required class="form-select" style="height: 34px; font-size: 11px; border-radius: 6px;">
                                    <option value=""><%- lan.Select_Subject || 'Select Subject' %></option>
                                    <% (subjects || []).forEach(s => { %>
                                        <option value="<%= s.id %>"><%= s.subject_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div>
                                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                                    <%- lan.Teacher_Optional || 'Teacher (Optional)' %>
                                </label>
                                <select name="teacher_id" class="form-select" style="height: 34px; font-size: 11px; border-radius: 6px;">
                                    <option value=""><%- lan.Select_Teacher || 'Select Teacher' %></option>
                                    <% (teachers || []).forEach(t => { %>
                                        <option value="<%= t.teacher_id %>"><%= t.first_name %> <%= t.last_name %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                                <input type="checkbox" name="is_mandatory" id="is_mandatory" class="w-4 h-4 rounded text-emerald-600" checked>
                                <label for="is_mandatory" style="font-size: 11px; font-weight: 600; color: #334155; cursor: pointer;">
                                    <%- lan.Mandatory_Subject || 'Mandatory Subject' %>
                                </label>
                            </div>
                            <button type="submit" class="btn" style="background: #059669; color: #fff; height: 36px; padding: 0 16px; font-size: 12px; font-weight: 700; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border: none; cursor: pointer; margin-top: 4px; box-shadow: 0 2px 6px rgba(5,150,105,0.2);">
                                <i class="fa-solid fa-plus"></i> <%- lan.Assign || 'Assign' %>
                            </button>
                        </form>
                    </div>
                    <div class="card" style="border-radius: 10px; border: 1px solid #E2E8F0; padding: 14px 16px; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid #F1F5F9;">
                            <h4 style="font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B; margin: 0;">
                                <%- lan.Current_Assignments || 'Current Assignments' %>
                            </h4>
                            <span class="badge badge-secondary" style="font-size: 9px; font-weight: 700; padding: 1px 6px;">
                                <%= totalAssigned %>
                            </span>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px; max-height: 280px; overflow-y: auto; padding-right: 2px;">
                            <% if (!classSubjects || classSubjects.length === 0) { %>
                                <div style="padding: 16px 10px; text-align: center; color: #94A3B8; font-size: 11px;">
                                    <%- lan.No_Subjects_Assigned_Yet || 'No subjects assigned to classes yet.' %>
                                </div>
                            <% } %>
                            <% (classSubjects || []).forEach(cs => { %>
                                <div class="subject-assignment-item">
                                    <span style="font-weight: 700; color: #1E293B; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        <%= cs.class_label || cs.class_name %> → <%= cs.subject_name %>
                                    </span>
                                    <span class="badge badge-success" style="font-size: 9px; font-weight: 700; padding: 2px 6px; flex-shrink: 0;">
                                        <%= cs.teacher_name || (lan.No_Teacher || 'No teacher') %>
                                    </span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<div id="addSubjectModal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center" style="z-index: 999999;" role="dialog" aria-modal="true">
    <div class="subject-modal-panel" style="background: #fff; border-radius: 12px; width: calc(100% - 32px); max-width: 440px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); overflow: hidden; border: 1px solid #E2E8F0;">
        <div style="padding: 14px 18px; background: linear-gradient(135deg, #059669 0%, #0d9488 100%); color: #fff; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 14px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-plus-circle"></i> <%- lan.Add_Subject || 'Add Subject' %>
            </h3>
            <button type="button" onclick="document.getElementById('addSubjectModal').classList.add('hidden')" style="background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; line-height: 1;" aria-label="Close">&times;</button>
        </div>
        <form method="POST" action="/schooladmin/subjects/add" style="padding: 16px 18px; display: flex; flex-direction: column; gap: 10px;">
            <div>
                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                    <%- lan.Subject_Name || 'Subject Name' %> <span style="color: #E11D48;">*</span>
                </label>
                <input type="text" name="subject_name" required placeholder="e.g. Mathematics, Science..." class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
            </div>
            <div>
                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                    <%- lan.Subject_Code || 'Subject Code' %>
                </label>
                <input type="text" name="subject_code" placeholder="e.g. MATH, SCI..." class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
            </div>
            <div>
                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                    <%- lan.Type || 'Type' %>
                </label>
                <select name="subject_type" class="form-select" style="height: 34px; font-size: 11px; border-radius: 6px;">
                    <option value="theory"><%- lan.Theory || 'Theory' %></option>
                    <option value="practical"><%- lan.Practical || 'Practical' %></option>
                    <option value="both"><%- lan.Both || 'Both' %></option>
                    <option value="activity"><%- lan.Activity || 'Activity' %></option>
                </select>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div>
                    <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                        <%- lan.Max_Marks || 'Max Marks' %>
                    </label>
                    <input type="number" name="max_marks" value="100" class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
                </div>
                <div>
                    <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                        <%- lan.Pass_Marks || 'Pass Marks' %>
                    </label>
                    <input type="number" name="pass_marks" value="35" class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
                </div>
            </div>
            <div style="display: flex; gap: 8px; margin-top: 6px;">
                <button type="submit" class="btn" style="background: #059669; color: #fff; height: 36px; padding: 0 16px; font-size: 11px; font-weight: 700; border-radius: 6px; flex: 1; border: none; cursor: pointer;">
                    <i class="fa-solid fa-plus"></i> <%- lan.Add || 'Add' %>
                </button>
                <button type="button" onclick="document.getElementById('addSubjectModal').classList.add('hidden')" class="btn" style="background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1; height: 36px; padding: 0 16px; font-size: 11px; font-weight: 700; border-radius: 6px; flex: 1; cursor: pointer;">
                    <%- lan.Cancel || 'Cancel' %>
                </button>
            </div>
        </form>
    </div>
</div>
<div id="editSubjectModal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center" style="z-index: 999999;" role="dialog" aria-modal="true">
    <div class="subject-modal-panel" style="background: #fff; border-radius: 12px; width: calc(100% - 32px); max-width: 440px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); overflow: hidden; border: 1px solid #E2E8F0;">
        <div style="padding: 14px 18px; background: linear-gradient(135deg, #059669 0%, #0d9488 100%); color: #fff; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 14px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 6px;">
                <i class="fa-solid fa-pen-to-square"></i> <%- lan.Edit_Subject || 'Edit Subject' %>
            </h3>
            <button type="button" onclick="document.getElementById('editSubjectModal').classList.add('hidden')" style="background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; line-height: 1;" aria-label="Close">&times;</button>
        </div>
        <form method="POST" id="editSubjectForm" action="" style="padding: 16px 18px; display: flex; flex-direction: column; gap: 10px;">
            <div>
                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                    <%- lan.Subject_Name || 'Subject Name' %> <span style="color: #E11D48;">*</span>
                </label>
                <input type="text" name="subject_name" id="editSubName" required class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
            </div>
            <div>
                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                    <%- lan.Subject_Code || 'Subject Code' %>
                </label>
                <input type="text" name="subject_code" id="editSubCode" class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
            </div>
            <div>
                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                    <%- lan.Type || 'Type' %>
                </label>
                <select name="subject_type" id="editSubType" class="form-select" style="height: 34px; font-size: 11px; border-radius: 6px;">
                    <option value="theory"><%- lan.Theory || 'Theory' %></option>
                    <option value="practical"><%- lan.Practical || 'Practical' %></option>
                    <option value="both"><%- lan.Both || 'Both' %></option>
                    <option value="activity"><%- lan.Activity || 'Activity' %></option>
                </select>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div>
                    <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                        <%- lan.Max_Marks || 'Max Marks' %>
                    </label>
                    <input type="number" name="max_marks" id="editMaxMarks" class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
                </div>
                <div>
                    <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                        <%- lan.Pass_Marks || 'Pass Marks' %>
                    </label>
                    <input type="number" name="pass_marks" id="editPassMarks" class="form-input" style="height: 34px; font-size: 11px; border-radius: 6px;">
                </div>
            </div>
            <div>
                <label style="font-size: 9px; font-weight: 700; color: #94A3B8; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 4px;">
                    <%- lan.Status || 'Status' %>
                </label>
                <select name="status" id="editSubStatus" class="form-select" style="height: 34px; font-size: 11px; border-radius: 6px;">
                    <option value="active"><%- lan.Active || 'Active' %></option>
                    <option value="inactive"><%- lan.Inactive || 'Inactive' %></option>
                </select>
            </div>
            <div style="display: flex; gap: 8px; margin-top: 6px;">
                <button type="submit" class="btn" style="background: #059669; color: #fff; height: 36px; padding: 0 16px; font-size: 11px; font-weight: 700; border-radius: 6px; flex: 1; border: none; cursor: pointer;">
                    <i class="fa-solid fa-floppy-disk"></i> <%- lan.Update || 'Update' %>
                </button>
                <button type="button" onclick="document.getElementById('editSubjectModal').classList.add('hidden')" class="btn" style="background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1; height: 36px; padding: 0 16px; font-size: 11px; font-weight: 700; border-radius: 6px; flex: 1; cursor: pointer;">
                    <%- lan.Cancel || 'Cancel' %>
                </button>
            </div>
        </form>
    </div>
</div>
<script>
    document.querySelectorAll('.btn-edit-subject').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.dataset.id;
            const name = this.dataset.name;
            const code = this.dataset.code;
            const type = this.dataset.type;
            const max = this.dataset.max;
            const pass = this.dataset.pass;
            const status = this.dataset.status;

            document.getElementById('editSubjectForm').action = '/schooladmin/subjects/' + id + '/edit';
            document.getElementById('editSubName').value = name;
            document.getElementById('editSubCode').value = code || '';
            document.getElementById('editSubType').value = type;
            document.getElementById('editMaxMarks').value = max;
            document.getElementById('editPassMarks').value = pass;
            document.getElementById('editSubStatus').value = status;
            document.getElementById('editSubjectModal').classList.remove('hidden');
        });
    });
</script>