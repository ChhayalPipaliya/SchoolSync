<script>
    document.querySelectorAll('.btn-edit-subject').forEach(btn => {
        btn.addEventListener('click', function () {
            const id = this.dataset.id;
            const name = this.dataset.name;
            const code = this.dataset.code;
            const type = this.dataset.type;
            const max = this.dataset.max;
            const pass = this.dataset.pass;
            const status = this.dataset.status;

            document.getElementById('editSubjectForm').action = '/schooladmin/subjects/' + id + '/edit';
            document.getElementById('editSubName').value = name;
            document.getElementById('editSubCode').value = code || '';
            document.getElementById('editSubType').value = type;
            document.getElementById('editMaxMarks').value = max;
            document.getElementById('editPassMarks').value = pass;
            document.getElementById('editSubStatus').value = status;
            document.getElementById('editSubjectModal').classList.remove('hidden');
        });
    });

    const subjectSearchInput = document.getElementById('subjectSearchInput');
    const clearSubjectBtn = document.getElementById('clearSubjectBtn');

    function filterSubjects(val) {
        const q = (val || '').toLowerCase().trim();
        if (clearSubjectBtn) {
            clearSubjectBtn.style.display = q ? 'flex' : 'none';
        }
        const rows = document.querySelectorAll('.subject-table-row');
        let visible = 0;
        rows.forEach(row => {
            const searchTarget = (row.getAttribute('data-search') || row.innerText).toLowerCase();
            const matches = !q || searchTarget.includes(q);
            row.style.display = matches ? '' : 'none';
            if (matches) visible++;
        });

        const noMatchRow = document.getElementById('noSubjectMatchesRow');
        const noMatchQuery = document.getElementById('noSubjectMatchesQuery');
        if (noMatchRow) {
            noMatchRow.style.display = (visible === 0 && rows.length > 0) ? '' : 'none';
            if (noMatchQuery) {
                noMatchQuery.innerText = q ? `"${val.trim()}"` : '';
            }
        }

        const badge = document.getElementById('subjectsCountBadge');
        if (badge) {
            if (q) {
                badge.innerText = `${visible} / ${rows.length} <%- lan.Subjects || "Subjects" %>`;
            } else {
                badge.innerText = `${rows.length} <%- lan.Subjects || "Subjects" %>`;
            }
        }
    }

    function clearSubjectSearch() {
        if (subjectSearchInput) {
            subjectSearchInput.value = '';
            filterSubjects('');
            subjectSearchInput.focus();
        }
    }

    if (subjectSearchInput) {
        subjectSearchInput.addEventListener('input', function () {
            filterSubjects(this.value);
        });
        subjectSearchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') clearSubjectSearch();
        });
    }
    if (clearSubjectBtn) {
        clearSubjectBtn.addEventListener('click', clearSubjectSearch);
    }

    const assignmentSearchInput = document.getElementById('assignmentSearchInput');
    const clearAssignmentBtn = document.getElementById('clearAssignmentBtn');

    function filterAssignments(val) {
        const q = (val || '').toLowerCase().trim();
        if (clearAssignmentBtn) {
            clearAssignmentBtn.style.display = q ? 'flex' : 'none';
        }
        const items = document.querySelectorAll('.subject-assignment-item');
        let visible = 0;
        items.forEach(item => {
            const searchTarget = (item.getAttribute('data-search') || item.innerText).toLowerCase();
            const matches = !q || searchTarget.includes(q);
            item.style.display = matches ? 'flex' : 'none';
            if (matches) visible++;
        });

        const noMatchRow = document.getElementById('noAssignmentMatchesRow');
        const noMatchQuery = document.getElementById('noAssignmentMatchesQuery');
        if (noMatchRow) {
            noMatchRow.style.display = (visible === 0 && items.length > 0) ? 'block' : 'none';
            if (noMatchQuery) {
                noMatchQuery.innerText = q ? `"${val.trim()}"` : '';
            }
        }

        const badge = document.getElementById('assignmentCountBadge');
        if (badge) {
            if (q) {
                badge.innerText = `${visible} / ${items.length}`;
            } else {
                badge.innerText = `${items.length}`;
            }
        }
    }

    function clearAssignmentSearch() {
        if (assignmentSearchInput) {
            assignmentSearchInput.value = '';
            filterAssignments('');
            assignmentSearchInput.focus();
        }
    }

    if (assignmentSearchInput) {
        assignmentSearchInput.addEventListener('input', function () {
            filterAssignments(this.value);
        });
        assignmentSearchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') clearAssignmentSearch();
        });
    }
    if (clearAssignmentBtn) {
        clearAssignmentBtn.addEventListener('click', clearAssignmentSearch);
    }
</script>