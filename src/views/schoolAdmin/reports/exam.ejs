<%- include('../../partials/head', { title: `${lan.Exam_Result_Report || 'Exam Result Report'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Exam_Result_Report || 'Exam Result Report' %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%- lan.Exam_Result_Report_Desc || 'Review rankings and grade distributions for school examinations' %></p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card mb-6">
                <div class="card-body">
                    <form method="GET" class="flex flex-wrap gap-4 items-end">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Exam || 'Exam' %></label>
                            <select name="exam_id" class="form-select w-64" onchange="this.form.submit()">
                                <option value=""><%- lan.Select_Exam || 'Select Exam' %></option>
                                <% (exams||[]).forEach(e=> { %>
                                    <option value="<%= e.id %>" <%=exam_id==e.id ? 'selected' : '' %>><%= e.exam_name %> (<%= e.class_name %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary text-xs font-bold shadow-sm transition"><%- lan.Generate || 'Generate' %></button>
                    </form>
                </div>
            </div>
            <% if (results && results.length > 0) { %>
                <div class="table-card mb-6">
                    <div class="table-header-row bg-slate-50/20">
                        <h4 class="table-heading uppercase tracking-wider"><%- lan.Exam_Rank_List || 'Exam Rank List' %></h4>
                    </div>
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="text-left"><%- lan.Rank || 'Rank' %></th>
                                    <th class="text-left"><%- lan.Student || 'Student' %></th>
                                    <th class="text-center"><%- lan.Class || 'Class' %></th>
                                    <th class="text-center"><%- lan.Marks || 'Marks' %></th>
                                    <th class="text-center"><%- lan.Percentage || 'Percentage' %></th>
                                    <th class="text-center"><%- lan.Grade || 'Grade' %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% results.forEach((r, index)=> { %>
                                    <tr class="<%= index < 3 ? 'bg-amber-50/40 hover:bg-amber-50/60' : '' %>">
                                        <td class="font-bold">
                                            <% if(index === 0) { %>
                                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-yellow-400 text-yellow-950 text-xs font-extrabold shadow-sm"><i class="fa-solid fa-crown text-[9px] mr-0.5"></i>1</span>
                                            <% } else if(index === 1) { %>
                                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-slate-300 text-slate-900 text-xs font-extrabold shadow-sm">2</span>
                                            <% } else if(index === 2) { %>
                                                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-600 text-amber-50 text-xs font-extrabold shadow-sm">3</span>
                                            <% } else { %>
                                                <%= index + 1 %>
                                            <% } %>
                                        </td>
                                        <td class="font-medium text-gray-800">
                                            <%= r.first_name %> <%= r.last_name %>
                                        </td>
                                        <td class="text-center font-semibold text-gray-600">
                                            <%= r.class_name %>
                                        </td>
                                        <td class="text-center">
                                            <%= r.marks_obtained %> / <%= r.max_marks %>
                                        </td>
                                        <td class="text-center font-bold text-gray-800">
                                            <%= ((r.marks_obtained / r.max_marks) * 100).toFixed(1) %>%
                                        </td>
                                        <td class="text-center">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold <%= r.grade !== 'F' ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-red-50 text-red-700 border border-red-100' %>">
                                                <%= r.grade %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title flex items-center gap-2">
                            <i class="fa-solid fa-chart-pie text-emerald-600"></i> <%- lan.Grade_Distribution || 'Grade Distribution' %>
                        </h3>
                    </div>
                    <div class="card-body flex justify-center">
                        <div class="w-full max-w-md">
                            <canvas id="examChart" height="200"></canvas>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="card p-8 text-center text-gray-500">
                    <%- lan.Select_Exam_To_View_Results || 'Select an exam to view results' %>
                </div>
            <% } %>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<script>
    const ctx = document.getElementById('examChart').getContext('2d');
    const grades = { 'A+': 0, 'A': 0, 'B': 0, 'C': 0, 'D': 0, 'E': 0, 'F': 0 };
    
    const rawResults = JSON.parse('<%- JSON.stringify(results || []) %>');
    rawResults.forEach(r => {
        if (grades[r.grade] !== undefined) {
            grades[r.grade]++;
        }
    });

    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: Object.keys(grades),
            datasets: [{
                data: Object.values(grades),
                backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#8b5cf6', '#ec4899', '#6b7280', '#ef4444']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'right'
                }
            }
        }
    });
</script>