<%- include('../../partials/head', { title: `${lan.Fee_Collection_Report || 'Fee Collection Report'} | SchoolSync` }) %>
<style>
    @media print {
        body { background: #FFFFFF !important; }
        .sidebar, .top-header, .header, .no-print, .btn, footer { display: none !important; }
        .app-wrapper, .main-panel, .content { margin: 0 !important; padding: 0 !important; background: #FFFFFF !important; }
        .card { box-shadow: none !important; border: 1px solid #E2E8F0 !important; }
    }
    .report-stat-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .report-stat-card:hover {
        transform: translateY(-2px);
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '/schooladmin/reports/fee' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card no-print" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Fee_Collection_Report || 'Fee Collection Report' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Fee_Collection_Report_Desc || 'Comprehensive audit of fee collections, payment methods, discounts, and outstanding dues.' %></p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="window.print()" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-print"></i> <%- lan.Print_Report || 'Print Report' %>
                        </button>
                        <a href="/schooladmin/fees/history" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fa-solid fa-clock-rotate-left"></i> <%- lan.Payment_Ledger || 'Payment Ledger' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card mb-3 no-print">
                <div class="card-body py-4">
                    <form method="GET" action="/schooladmin/reports/fee" class="flex flex-wrap items-end gap-3 sm:gap-4">
                        <div class="form-group mb-0 flex-1 min-w-[140px]">
                            <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Month || 'Month' %></label>
                            <select name="month" class="form-select text-xs">
                                <% 
                                    const monthNames = [lan.January || 'January', lan.February || 'February', lan.March || 'March', lan.April || 'April', lan.May || 'May', lan.June || 'June', lan.July || 'July', lan.August || 'August', lan.September || 'September', lan.October || 'October', lan.November || 'November', lan.December || 'December' ];
                                    monthNames.forEach((mName, idx) => { const mNum = idx + 1;
                                %>
                                    <option value="<%= mNum %>" <%= parseInt(month, 10) === mNum ? 'selected' : '' %>><%= mName %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group mb-0 w-28">
                            <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Year || 'Year' %></label>
                            <input type="number" name="year" value="<%= year %>" min="2000" max="2100" class="form-input text-xs">
                        </div>
                        <div class="form-group mb-0 flex-1 min-w-[160px]">
                            <label class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%- lan.Class_Filter || 'Class Filter' %></label>
                            <select name="class_id" class="form-select text-xs">
                                <option value=""><%- lan.All_Classes || 'All Classes' %></option>
                                <% (classes || []).forEach(c => { %>
                                    <option value="<%= c.id %>" <%= String(class_id) === String(c.id) ? 'selected' : '' %>>
                                        <%= c.class_name %> <%= c.section ? `(${c.section})` : '' %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="submit" class="btn btn-primary text-xs font-bold px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm flex items-center gap-1.5">
                                <i class="fa-solid fa-filter"></i> <%- lan.Apply_Filter || 'Apply Filter' %>
                            </button>
                            <a href="/schooladmin/reports/fee" class="btn btn-secondary text-xs px-3 py-2" title="<%- lan.Reset_Filters || 'Reset Filters' %>">
                                <i class="fa-solid fa-arrows-rotate"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-3">
                <div class="card p-5 report-stat-card">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%- lan.Total_Collection || 'Total Collection' %></span>
                        <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-bold">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                        </span>
                    </div>
                    <p class="text-2xl font-extrabold text-emerald-600 mt-2">₹<%= Number(collection.total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></p>
                    <p class="text-[11px] text-slate-400 mt-1 flex items-center gap-1">
                        <i class="fa-solid fa-circle-check text-emerald-500"></i> <%= collection.total_transactions || 0 %> <%- lan.Transactions || 'transactions' %> (<%= collection.total_students_paid || 0 %> <%- lan.Students_Paid || 'students paid' %>)
                    </p>
                </div>
                <div class="card p-5 report-stat-card">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%- lan.Outstanding_Dues || 'Outstanding Dues' %></span>
                        <span class="w-8 h-8 rounded-full bg-red-50 text-red-600 flex items-center justify-center text-sm font-bold">
                            <i class="fa-solid fa-clock"></i>
                        </span>
                    </div>
                    <p class="text-2xl font-extrabold text-red-600 mt-2">₹<%= Number(pending.total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></p>
                    <p class="text-[11px] text-slate-400 mt-1 flex items-center gap-1">
                        <i class="fa-solid fa-triangle-exclamation text-amber-500"></i> <%= pending.pending_students_count || 0 %> <%- lan.Students_Pending || 'students pending' %>
                    </p>
                </div>
                <div class="card p-5 report-stat-card">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%- lan.Discounts_Slash_Waivers || 'Discounts / Waivers' %></span>
                        <span class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-sm font-bold">
                            <i class="fa-solid fa-percent"></i>
                        </span>
                    </div>
                    <p class="text-2xl font-extrabold text-blue-600 mt-2">₹<%= Number(collection.total_discount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></p>
                    <p class="text-[11px] text-slate-400 mt-1"><%- lan.Concessions_Applied_This_Month || 'Concessions applied this month' %></p>
                </div>
                <div class="card p-5 report-stat-card">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500"><%- lan.Daily_Average || 'Daily Average' %></span>
                        <span class="w-8 h-8 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center text-sm font-bold">
                            <i class="fa-solid fa-chart-simple"></i>
                        </span>
                    </div>
                    <% const avgDaily = (dailyBreakdown && dailyBreakdown.length > 0) ? (collection.total / dailyBreakdown.length) : 0; %>
                    <p class="text-2xl font-extrabold text-teal-700 mt-2">₹<%= Number(avgDaily).toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></p>
                    <p class="text-[11px] text-slate-400 mt-1"><%- lan.Across_Active_Collection_Days || 'Across active collection days' %> (<%= dailyBreakdown ? dailyBreakdown.length : 0 %>)</p>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 mb-3">
                <div class="lg:col-span-8 card">
                    <div class="card-header flex items-center justify-between">
                        <h3 class="card-title text-sm font-bold flex items-center gap-2 text-slate-800">
                            <i class="fa-solid fa-chart-line text-emerald-600"></i> <%- lan.Daily_Collection_Trend || 'Daily Collection Trend' %>
                        </h3>
                        <span class="text-[11px] text-slate-400 font-medium"><%= monthNames[parseInt(month, 10) - 1] || '' %> <%= year %></span>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height: 280px; width: 100%;">
                            <canvas id="feeChart" data-breakdown='<%- JSON.stringify(dailyBreakdown || []) %>'></canvas>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-4 card">
                    <div class="card-header">
                        <h3 class="card-title text-sm font-bold flex items-center gap-2 text-slate-800">
                            <i class="fa-solid fa-wallet text-teal-600"></i> <%- lan.Payment_Methods || 'Payment Methods' %>
                        </h3>
                    </div>
                    <div class="card-body">
                        <% if (methodBreakdown && methodBreakdown.length > 0) { %>
                            <div style="position: relative; height: 160px; width: 100%;" class="mb-4">
                                <canvas id="methodChart" data-methods='<%- JSON.stringify(methodBreakdown || []) %>'></canvas>
                            </div>
                            <div class="space-y-2 text-xs">
                                <% methodBreakdown.forEach(m => { 
                                    const mLabel = (m.payment_method || 'Other').replace(/_/g, ' ').toUpperCase();
                                    const percent = collection.total > 0 ? ((m.total / collection.total) * 100).toFixed(1) : 0;
                                %>
                                    <div class="flex items-center justify-between p-2 bg-slate-50 rounded-lg border border-slate-100">
                                        <div class="flex items-center gap-2">
                                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                                            <span class="font-semibold text-slate-700"><%= mLabel %></span>
                                            <span class="text-[10px] text-slate-400">(<%= m.count %>)</span>
                                        </div>
                                        <div class="text-right">
                                            <span class="font-bold text-slate-800">₹<%= Number(m.total).toLocaleString('en-IN') %></span>
                                            <span class="text-[10px] text-slate-400 ml-1">(<%= percent %>%)</span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-10 text-slate-400">
                                <i class="fa-solid fa-receipt text-3xl mb-2 opacity-50"></i>
                                <p class="text-xs"><%- lan.No_Payment_Mode_Recorded || 'No payment mode breakdown recorded for this period.' %></p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header flex items-center justify-between">
                    <h3 class="card-title text-sm font-bold flex items-center gap-2 text-slate-800">
                        <i class="fa-solid fa-list-check text-slate-600"></i> <%- lan.Transactions_Recorded_Period || 'Transactions Recorded in this Period' %>
                    </h3>
                    <span class="text-xs text-slate-400 font-medium"><%- lan.Showing_Up_To_Entries || 'Showing up to 100 entries' %></span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                            <tr>
                                <th class="py-3 px-4"><%- lan.Receipt_Num || 'Receipt #' %></th>
                                <th class="py-3 px-4"><%- lan.Date || 'Date' %></th>
                                <th class="py-3 px-4"><%- lan.Student || 'Student' %></th>
                                <th class="py-3 px-4"><%- lan.Class || 'Class' %></th>
                                <th class="py-3 px-4"><%- lan.Payment_Method || 'Payment Method' %></th>
                                <th class="py-3 px-4 text-right"><%- lan.Discount || 'Discount' %></th>
                                <th class="py-3 px-4 text-right"><%- lan.Amount_Paid || 'Amount Paid' %></th>
                                <th class="py-3 px-4 text-center no-print"><%- lan.Action || 'Action' %></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (recentPayments && recentPayments.length > 0) { %>
                                <% recentPayments.forEach(p => { %>
                                    <tr class="hover:bg-slate-50/70 transition">
                                        <td class="py-3 px-4">
                                            <a href="/schooladmin/fees/receipt/<%= p.id %>" class="font-mono font-bold text-teal-700 hover:text-teal-900 flex items-center gap-1">
                                                <i class="fa-solid fa-file-invoice text-teal-600"></i>
                                                <%= p.receipt_no || p.receipt_number || '#' + p.id %>
                                            </a>
                                        </td>
                                        <td class="py-3 px-4 text-slate-600">
                                            <%= new Date(p.payment_date || p.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                        </td>
                                        <td class="py-3 px-4 font-semibold text-slate-800">
                                            <%= p.first_name %> <%= p.last_name || '' %>
                                            <div class="text-[10px] text-slate-400 font-mono">Adm: <%= p.admission_no || '—' %></div>
                                        </td>
                                        <td class="py-3 px-4 text-slate-600">
                                            <%= p.class_name || 'N/A' %> <%= p.section ? `(${p.section})` : '' %>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100 capitalize">
                                                <%= (p.payment_method || 'Cash').replace(/_/g, ' ') %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-right text-slate-500">
                                            <% if (Number(p.discount) > 0) { %>
                                                <span class="text-emerald-600 font-medium">-₹<%= Number(p.discount).toLocaleString('en-IN') %></span>
                                            <% } else { %>
                                                —
                                            <% } %>
                                        </td>
                                        <td class="py-3 px-4 text-right font-bold text-slate-800">
                                            ₹<%= Number(p.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                        </td>
                                        <td class="py-3 px-4 text-center no-print">
                                            <div class="flex items-center justify-center gap-1.5">
                                                <a href="/schooladmin/fees/receipt/<%= p.id %>" class="btn btn-secondary text-[11px] py-1 px-2.5" title="<%- lan.View_Voucher || 'View Voucher' %>">
                                                    <i class="fa-solid fa-eye"></i> <%- lan.View || 'View' %>
                                                </a>
                                                <a href="/schooladmin/fees/receipt/<%= p.id %>/download" class="btn btn-secondary text-[11px] py-1 px-2.5 text-emerald-700" title="<%- lan.Download_PDF || 'Download PDF' %>">
                                                    <i class="fa-solid fa-file-pdf"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center py-10 text-slate-400">
                                        <i class="fa-solid fa-receipt text-3xl mb-2 opacity-50"></i>
                                        <p class="text-xs"><%- lan.No_Fee_Transactions_Found || 'No fee transactions found for the selected period.' %></p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const feeCanvas = document.getElementById('feeChart');
        if (feeCanvas) {
            const ctx = feeCanvas.getContext('2d');
            let rawBreakdown = [];
            try {
                rawBreakdown = JSON.parse(feeCanvas.dataset.breakdown || '[]');
            } catch (e) {
                rawBreakdown = [];
            }

            if (!rawBreakdown.length) {
                ctx.font = '13px sans-serif';
                ctx.fillStyle = '#94a3b8';
                ctx.textAlign = 'center';
                ctx.fillText('No daily collection records found for this period.', (feeCanvas.width || 300) / 2, 100);
            } else {
                const labels = rawBreakdown.map(d => {
                    if (!d.date) return '';
                    const dt = new Date(d.date);
                    return dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
                });
                const dataValues = rawBreakdown.map(d => parseFloat(d.total || 0));

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Daily Collection (₹)',
                            data: dataValues,
                            borderColor: '#059669',
                            backgroundColor: 'rgba(5, 150, 105, 0.08)',
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.3,
                            pointBackgroundColor: '#059669',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: { 
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return ' Collection: ₹' + Number(context.parsed.y).toLocaleString('en-IN');
                                    }
                                }
                            }
                        },
                        scales: { 
                            x: { grid: { display: false } },
                            y: { 
                                beginAtZero: true,
                                ticks: {
                                    callback: function(val) {
                                        return '₹' + Number(val).toLocaleString('en-IN');
                                    }
                                }
                            } 
                        } 
                    }
                });
            }
        }

        const methodCanvas = document.getElementById('methodChart');
        if (methodCanvas) {
            const mCtx = methodCanvas.getContext('2d');
            let rawMethods = [];
            try {
                rawMethods = JSON.parse(methodCanvas.dataset.methods || '[]');
            } catch (e) {
                rawMethods = [];
            }

            if (rawMethods.length) {
                const mLabels = rawMethods.map(m => (m.payment_method || 'Other').replace(/_/g, ' ').toUpperCase());
                const mValues = rawMethods.map(m => parseFloat(m.total || 0));
                const palette = ['#059669', '#0d9488', '#3b82f6', '#8b5cf6', '#f59e0b', '#ec4899', '#64748b'];

                new Chart(mCtx, {
                    type: 'doughnut',
                    data: {
                        labels: mLabels,
                        datasets: [{
                            data: mValues,
                            backgroundColor: palette.slice(0, mLabels.length),
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return ' ' + context.label + ': ₹' + Number(context.parsed).toLocaleString('en-IN');
                                    }
                                }
                            }
                        },
                        cutout: '65%'
                    }
                });
            }
        }
    });
</script>