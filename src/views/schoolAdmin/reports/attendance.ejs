<%- include('../../partials/head', { title: `${lan.Attendance_Report || 'Attendance Report' } | SchoolSync` }) %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Attendance_Report
                                        || 'Attendance Report' %></h2>
                                <p class="text-xs text-gray-500 mt-1"><%- lan.Attendance_Report_Desc
                                        || 'View class-wise attendance summary and statistics' %></p>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div class="card mb-3">
                                <div class="card-body">
                                    <form method="GET" class="flex flex-wrap gap-4 items-end">
                                        <div class="form-group mb-0">
                                            <label
                                                class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%-
                                                    lan.Class || 'Class' %></label>
                                            <select name="class_id" class="form-select" onchange="this.form.submit()">
                                                <option value=""><%- lan.Select_Class || 'Select Class' %></option>
                                                <% (classes||[]).forEach(c=> { %>
                                                    <option value="<%= c.id %>" <%=filters.class_id==c.id ? 'selected'
                                                        : '' %>><%= c.class_name %> - <%= c.section %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                        <% if (typeof sections !=='undefined' && sections && sections.length> 0) { %>
                                            <div class="form-group mb-0">
                                                <label
                                                    class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%-
                                                        lan.Section || 'Section' %></label>
                                                <select name="section_id" class="form-select"
                                                    onchange="this.form.submit()">
                                                    <option value=""><%- lan.All_Sections || 'All Sections' %></option>
                                                    <% sections.forEach(sec=> { %>
                                                        <option value="<%= sec.id %>" <%=filters.section_id==sec.id
                                                            ? 'selected' : '' %>><%= sec.section %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                            <% } %>
                                                <div class="form-group mb-0">
                                                    <label
                                                        class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%-
                                                            lan.Month || 'Month' %></label>
                                                    <input type="number" name="month"
                                                        value="<%= filters.month || new Date().getMonth() + 1 %>"
                                                        min="1" max="12" class="form-input w-20">
                                                </div>
                                                <div class="form-group mb-0">
                                                    <label
                                                        class="form-label font-bold text-gray-400 uppercase tracking-wider text-[10px]"><%-
                                                            lan.Year || 'Year' %></label>
                                                    <input type="number" name="year"
                                                        value="<%= filters.year || new Date().getFullYear() %>"
                                                        class="form-input w-24">
                                                </div>
                                                <button type="submit"
                                                    class="btn btn-primary text-xs font-bold shadow-sm transition"><%-
                                                        lan.Generate || 'Generate' %></button>
                                    </form>
                                </div>
                            </div>
                            <% if (summary && summary.length> 0) { %>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-3">
                                    <div class="card p-6 text-center">
                                        <p class="text-gray-500 text-sm"><%- lan.Total_Students || 'Total Students' %>
                                        </p>
                                        <p class="text-3xl font-bold text-gray-800 mt-2">
                                            <%= summary[0].total_students %>
                                        </p>
                                    </div>
                                    <div class="card p-6 text-center">
                                        <p class="text-gray-500 text-sm"><%- lan.Total_Present || 'Total Present' %></p>
                                        <p class="text-3xl font-bold text-emerald-600 mt-2">
                                            <%= summary[0].total_present || 0 %>
                                        </p>
                                    </div>
                                    <div class="card p-6 text-center">
                                        <p class="text-gray-500 text-sm"><%- lan.Average_Percentage || 'Average %' %>
                                        </p>
                                        <p class="text-3xl font-bold text-emerald-700 mt-2">
                                            <%= summary[0].total_records ? ((summary[0].total_present /
                                                summary[0].total_records) * 100).toFixed(1) : 0 %>%
                                        </p>
                                    </div>
                                </div>
                                <% if (typeof studentDetails !=='undefined' && studentDetails && studentDetails.length>
                                    0) { %>
                                    <div class="table-card mt-6">
                                        <div class="table-header-row bg-slate-50/20">
                                            <h4 class="table-heading uppercase tracking-wider"><%-
                                                    lan.Student_Wise_Attendance_Summary
                                                    || 'Student-wise Attendance Summary' %></h4>
                                        </div>
                                        <div class="table-container">
                                            <table class="data-table">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 100px;"><%- lan.Roll_No || 'Roll No' %></th>
                                                        <th><%- lan.Student_Name || 'Student Name' %></th>
                                                        <th class="text-center"><%- lan.Total_Days || 'Total Days' %>
                                                        </th>
                                                        <th class="text-center"><%- lan.Present || 'Present' %></th>
                                                        <th class="text-center"><%- lan.Absent || 'Absent' %></th>
                                                        <th class="text-center"><%- lan.Percentage || 'Percentage' %>
                                                        </th>
                                                        <th class="text-center"><%- lan.Status || 'Status' %></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% studentDetails.forEach(student=> { %>
                                                        <tr>
                                                            <td class="font-bold text-gray-800">
                                                                <%= student.roll_number || '—' %>
                                                            </td>
                                                            <td class="font-medium text-gray-800">
                                                                <%= student.first_name %>
                                                                    <%= student.last_name %>
                                                            </td>
                                                            <td class="text-center text-gray-600">
                                                                <%= student.total_days %>
                                                            </td>
                                                            <td class="text-center text-emerald-600 font-bold">
                                                                <%= student.present_days %>
                                                            </td>
                                                            <td class="text-center text-rose-600 font-bold">
                                                                <%= student.absent_days %>
                                                            </td>
                                                            <td class="text-center font-bold">
                                                                <%= student.percentage %>%
                                                            </td>
                                                            <td class="text-center">
                                                                <% if (student.percentage>= 75) { %>
                                                                    <span class="badge badge-success"><%- lan.Good
                                                                            || 'Good' %></span>
                                                                    <% } else if (student.percentage>= 50) { %>
                                                                        <span class="badge badge-warning"><%-
                                                                                lan.Warning || 'Warning' %></span>
                                                                        <% } else { %>
                                                                            <span class="badge badge-danger"><%-
                                                                                    lan.Critical || 'Critical' %></span>
                                                                            <% } %>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <% } %>
                                        <% } else { %>
                                            <div class="card p-8 text-center text-gray-500">
                                                <%- lan.Select_Class_To_View_Attendance
                                                    || 'Select class to view attendance summary' %>
                                            </div>
                                            <% } %>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>