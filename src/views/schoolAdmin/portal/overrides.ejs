<%- include('../../partials/head', { title: 'Portal Access Rules | SchoolSync' }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/portal/overrides' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <%- include('../../partials/flashMessages') %>
        <div class="content px-4 py-4">
            <div class="d-flex flex-col sm:flex-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Portal Access Rules</h2>
                    <p class="text-xs text-gray-500 mt-1">Control Parent and Student Portal login access per class standard.</p>
                </div>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-indigo-light text-indigo" style="font-size: 20px;">
                                <i class="fa-solid fa-user-group"></i>
                            </div>
                            <div>
                                <h5 class="mb-1 font-bold text-gray-800 text-sm">Parent Portal Defaults</h5>
                                <p class="text-xs text-gray-500 mb-0">Enabled by default for Nursery, LKG, UKG, and Standards 1 to 5.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-success-light text-success" style="font-size: 20px; background-color: rgba(46, 204, 113, 0.1); color: #2ecc71;">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>
                            <div>
                                <h5 class="mb-1 font-bold text-gray-800 text-sm">Student Portal Defaults</h5>
                                <p class="text-xs text-gray-500 mb-0">Enabled by default for every class. School admins can disable it class-wise.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 font-bold text-gray-800 text-base"><i class="fa-solid fa-sliders text-indigo me-2"></i>Class Rules List</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase">Class Standard</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase">Parent Portal Access</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase">Student Portal Access</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase">Override Status</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (classesList && classesList.length > 0) { %>
                                <% classesList.forEach(cls => { %>
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="font-bold text-gray-800 text-sm"><%= cls.class_name %></div>
                                            <% if (cls.reason) { %>
                                                <div class="text-[11px] text-gray-400 mt-0.5"><i class="fa-solid fa-quote-left me-1"></i><%= cls.reason %></div>
                                            <% } %>
                                        </td>
                                        <td class="px-4 py-3">
                                            <% if (cls.parent_portal) { %>
                                                <span class="badge bg-success-light text-success px-3 py-1.5 rounded-pill font-bold" style="background-color: rgba(46, 204, 113, 0.1); color: #2ecc71;">Enabled</span>
                                            <% } else { %>
                                                <span class="badge bg-slate-100 text-secondary px-3 py-1.5 rounded-pill font-bold">Disabled</span>
                                            <% } %>
                                            <span class="text-[10px] text-gray-400 ms-2 font-normal">(Default: <%= cls.defaultParent ? 'ON' : 'OFF' %>)</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <% if (cls.student_portal) { %>
                                                <span class="badge bg-success-light text-success px-3 py-1.5 rounded-pill font-bold" style="background-color: rgba(46, 204, 113, 0.1); color: #2ecc71;">Enabled</span>
                                            <% } else { %>
                                                <span class="badge bg-slate-100 text-secondary px-3 py-1.5 rounded-pill font-bold">Disabled</span>
                                            <% } %>
                                            <span class="text-[10px] text-gray-400 ms-2 font-normal">(Default: <%= cls.defaultStudent ? 'ON' : 'OFF' %>)</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <% if (cls.isOverridden) { %>
                                                <span class="badge bg-amber-100 text-amber-800 px-3 py-1.5 rounded-pill font-bold">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Custom Rule
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-slate-100 text-gray-500 px-3 py-1.5 rounded-pill font-bold">Default Rules</span>
                                            <% } %>
                                        </td>
                                        <td class="px-4 py-3 text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <button onclick="openOverrideModal('<%= cls.class_name %>', '<%= cls.parent_portal %>', '<%= cls.student_portal %>', '<%= cls.reason %>')"
                                                        class="btn btn-sm btn-outline-primary py-1 px-3" style="border-radius: 8px;">
                                                    <i class="fa-solid fa-sliders me-1"></i>Configure
                                                </button>
                                                <% if (cls.isOverridden) { %>
                                                    <form method="POST" action="/schooladmin/portal/overrides/delete" style="display: inline;" onsubmit="return confirm('Reset portal settings to school default for <%= cls.class_name %>?')">
                                                        <input type="hidden" name="class_name" value="<%= cls.class_name %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-3" style="border-radius: 8px;">
                                                            <i class="fa-solid fa-rotate-left me-1"></i>Reset
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-gray-500">
                                        <i class="fa-solid fa-folder-open fa-2x mb-2 text-light"></i>
                                        <p class="mb-0 small">No class standards defined in this school yet. Set up classes first.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="overrideModal" class="fixed inset-0 z-50 hidden flex items-center justify-center" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4">
        <div class="d-flex items-center justify-between px-4 py-3 border-b border-slate-100">
            <h5 class="mb-0 font-bold text-gray-800 text-base"><i class="fa-solid fa-sliders text-indigo me-2"></i>Configure Portal Override</h5>
            <button onclick="closeOverrideModal()" class="btn btn-link text-gray-500 text-xl font-bold p-0 text-decoration-none">&times;</button>
        </div>
        <form method="POST" action="/schooladmin/portal/overrides" class="p-4 space-y-4">
            <input type="hidden" id="overrideClassName" name="class_name">
            <div class="mb-3">
                <label class="form-label text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Class Standard</label>
                <input type="text" id="displayClassName" class="form-control" style="background-color: #f8fafc;" readonly>
            </div>
            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 mb-3 border-bottom pb-3">
                <div>
                    <label class="form-check-label font-bold text-gray-700 text-sm" for="parentPortalSwitch">Parent Portal Access</label>
                    <div class="text-[11px] text-gray-400">Enable or disable parent login credentials and views for this class.</div>
                </div>
                <input class="form-check-input ms-0" type="checkbox" id="parentPortalSwitch" name="parent_portal" value="1" style="width: 2.8em; height: 1.5em; cursor: pointer;">
            </div>
            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 mb-3 border-bottom pb-3">
                <div>
                    <label class="form-check-label font-bold text-gray-700 text-sm" for="studentPortalSwitch">Student Portal Access</label>
                    <div class="text-[11px] text-gray-400">Enable or disable student login credentials and views for this class.</div>
                </div>
                <input class="form-check-input ms-0" type="checkbox" id="studentPortalSwitch" name="student_portal" value="1" style="width: 2.8em; height: 1.5em; cursor: pointer;">
            </div>
            <div class="mb-4">
                <label class="form-label text-xs font-bold text-gray-500 uppercase tracking-wider mb-2" for="overrideReason">Reason for Custom Rule</label>
                <textarea id="overrideReason" name="reason" class="form-control" rows="3" placeholder="e.g. Special exam preparations, Pre-Primary standard requirements override..." style="border-radius: 8px;"></textarea>
            </div>
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary flex-fill">Apply Settings</button>
                <button type="button" onclick="closeOverrideModal()" class="btn btn-secondary flex-fill">Cancel</button>
            </div>
        </form>
    </div>
</div>
<%- include('../../partials/footer') %>
<script>
    function openOverrideModal(className, parentPortal, studentPortal, reason) {
        document.getElementById('overrideClassName').value = className;
        document.getElementById('displayClassName').value = className;
        document.getElementById('parentPortalSwitch').checked = !!parentPortal;
        document.getElementById('studentPortalSwitch').checked = !!studentPortal;
        document.getElementById('overrideReason').value = reason || '';

        const modal = document.getElementById('overrideModal');
        modal.classList.remove('hidden');
        modal.classList.add('d-flex');
    }

    function closeOverrideModal() {
        const modal = document.getElementById('overrideModal');
        modal.classList.add('hidden');
        modal.classList.remove('d-flex');
    }

    document.getElementById('overrideModal').addEventListener('click', function(e) {
        if (e.target === this) closeOverrideModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeOverrideModal();
    });
</script>

<style>
    .bg-indigo-light {
        background-color: rgba(99, 102, 241, 0.08) !important;
    }
    .text-indigo {
        color: #6366F1 !important;
    }
    .bg-success-light {
        background-color: rgba(46, 204, 113, 0.08) !important;
    }
    .hidden {
        display: none !important;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>