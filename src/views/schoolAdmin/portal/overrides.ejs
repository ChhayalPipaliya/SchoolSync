<%- include('../../partials/head', { title: `${lan.Portal_Access_Rules || 'Portal Access Rules'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/schooladmin/portal/overrides' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <%- include('../../partials/flashMessages') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-sliders"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Portal_Access_Rules || 'Portal Access Rules' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Portal_Access_Rules_Desc || 'Control Parent and Student Portal login access per class standard.' %></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-indigo-light text-indigo" style="font-size: 20px;">
                                <i class="fa-solid fa-user-group"></i>
                            </div>
                            <div>
                                <h5 class="mb-1 font-bold text-gray-800 text-sm"><%- lan.Parent_Portal_Defaults || 'Parent Portal Defaults' %></h5>
                                <p class="text-xs text-gray-500 mb-0"><%- lan.Parent_Portal_Defaults_Desc || 'Enabled by default for Nursery, LKG, UKG, and Standards 1 to 5.' %></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-success-light text-success" style="font-size: 20px; background-color: rgba(46, 204, 113, 0.1); color: #2ecc71;">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>
                            <div>
                                <h5 class="mb-1 font-bold text-gray-800 text-sm"><%- lan.Student_Portal_Defaults || 'Student Portal Defaults' %></h5>
                                <p class="text-xs text-gray-500 mb-0"><%- lan.Student_Portal_Defaults_Desc || 'Enabled by default for every class. School admins can disable it class-wise.' %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 font-bold text-gray-800 text-base"><i class="fa-solid fa-sliders text-indigo me-2"></i><%- lan.Class_Rules_List || 'Class Rules List' %></h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase"><%- lan.Class_Standard || 'Class Standard' %></th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase"><%- lan.Parent_Portal_Access || 'Parent Portal Access' %></th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase"><%- lan.Student_Portal_Access || 'Student Portal Access' %></th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase"><%- lan.Override_Status || 'Override Status' %></th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-600 text-uppercase text-end"><%- lan.Actions || 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <% if (classesList && classesList.length > 0) { %>
                                <% classesList.forEach(cls => { %>
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="font-bold text-gray-800 text-sm"><%= cls.class_name %></div>
                                            <% if (cls.reason) { %>
                                                <div class="text-[11px] text-gray-400 mt-0.5"><i class="fa-solid fa-quote-left me-1"></i><%= cls.reason %></div>
                                            <% } %>
                                        </td>
                                        <td class="px-4 py-3">
                                            <% if (cls.parent_portal) { %>
                                                <span class="badge bg-success-light text-success px-3 py-1.5 rounded-pill font-bold" style="background-color: rgba(46, 204, 113, 0.1); color: #2ecc71;"><%- lan.Enabled || 'Enabled' %></span>
                                            <% } else { %>
                                                <span class="badge bg-slate-100 text-secondary px-3 py-1.5 rounded-pill font-bold"><%- lan.Disabled || 'Disabled' %></span>
                                            <% } %>
                                            <span class="text-[10px] text-gray-400 ms-2 font-normal">(<%- lan.Default || 'Default' %>: <%= cls.defaultParent ? (lan.ON || 'ON') : (lan.OFF || 'OFF') %>)</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <% if (cls.student_portal) { %>
                                                <span class="badge bg-success-light text-success px-3 py-1.5 rounded-pill font-bold" style="background-color: rgba(46, 204, 113, 0.1); color: #2ecc71;"><%- lan.Enabled || 'Enabled' %></span>
                                            <% } else { %>
                                                <span class="badge bg-slate-100 text-secondary px-3 py-1.5 rounded-pill font-bold"><%- lan.Disabled || 'Disabled' %></span>
                                            <% } %>
                                            <span class="text-[10px] text-gray-400 ms-2 font-normal">(<%- lan.Default || 'Default' %>: <%= cls.defaultStudent ? (lan.ON || 'ON') : (lan.OFF || 'OFF') %>)</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <% if (cls.isOverridden) { %>
                                                <span class="badge bg-amber-100 text-amber-800 px-3 py-1.5 rounded-pill font-bold">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i><%- lan.Custom_Rule || 'Custom Rule' %>
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-slate-100 text-gray-500 px-3 py-1.5 rounded-pill font-bold"><%- lan.Default_Rules || 'Default Rules' %></span>
                                            <% } %>
                                        </td>
                                        <td class="px-4 py-3 text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <button onclick="openOverrideModal('<%= cls.class_name %>', '<%= cls.parent_portal %>', '<%= cls.student_portal %>', '<%= cls.reason %>')"
                                                        class="btn btn-sm btn-outline-primary py-1 px-3" style="border-radius: 8px;">
                                                    <i class="fa-solid fa-sliders me-1"></i><%- lan.Configure || 'Configure' %>
                                                </button>
                                                <% if (cls.isOverridden) { %>
                                                    <form method="POST" action="/schooladmin/portal/overrides/delete" class="reset-override-form" style="display: inline;" data-class-name="<%= cls.class_name %>" data-confirm-prefix="<%- lan.Reset_Portal_Confirm || 'Reset portal settings to school default for' %>">
                                                        <input type="hidden" name="class_name" value="<%= cls.class_name %>">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-3" style="border-radius: 8px;">
                                                            <i class="fa-solid fa-rotate-left me-1"></i><%- lan.Reset || 'Reset' %>
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-gray-500">
                                        <i class="fa-solid fa-folder-open fa-2x mb-2 text-light"></i>
                                        <p class="mb-0 small"><%- lan.No_Class_Standards_Defined || 'No class standards defined in this school yet. Set up classes first.' %></p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<div id="overrideModal" class="fixed inset-0 z-50 hidden flex items-center justify-center" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4">
        <div class="d-flex items-center justify-between px-4 py-3 border-b border-slate-100">
            <h5 class="mb-0 font-bold text-gray-800 text-base"><i class="fa-solid fa-sliders text-indigo me-2"></i><%- lan.Configure_Portal_Override || 'Configure Portal Override' %></h5>
            <button onclick="closeOverrideModal()" class="btn btn-link text-gray-500 text-xl font-bold p-0 text-decoration-none">&times;</button>
        </div>
        <form method="POST" action="/schooladmin/portal/overrides" class="p-4 space-y-4">
            <input type="hidden" id="overrideClassName" name="class_name">
            <div class="mb-3">
                <label class="form-label text-xs font-bold text-gray-500 uppercase tracking-wider mb-2"><%- lan.Class_Standard || 'Class Standard' %></label>
                <input type="text" id="displayClassName" class="form-control" style="background-color: #f8fafc;" readonly>
            </div>
            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 mb-3 border-bottom pb-3">
                <div>
                    <label class="form-check-label font-bold text-gray-700 text-sm" for="parentPortalSwitch"><%- lan.Parent_Portal_Access || 'Parent Portal Access' %></label>
                    <div class="text-[11px] text-gray-400"><%- lan.Parent_Portal_Switch_Desc || 'Enable or disable parent login credentials and views for this class.' %></div>
                </div>
                <input class="form-check-input ms-0" type="checkbox" id="parentPortalSwitch" name="parent_portal" value="1" style="width: 2.8em; height: 1.5em; cursor: pointer;">
            </div>
            <div class="form-check form-switch d-flex align-items-center justify-content-between p-0 mb-3 border-bottom pb-3">
                <div>
                    <label class="form-check-label font-bold text-gray-700 text-sm" for="studentPortalSwitch"><%- lan.Student_Portal_Access || 'Student Portal Access' %></label>
                    <div class="text-[11px] text-gray-400"><%- lan.Student_Portal_Switch_Desc || 'Enable or disable student login credentials and views for this class.' %></div>
                </div>
                <input class="form-check-input ms-0" type="checkbox" id="studentPortalSwitch" name="student_portal" value="1" style="width: 2.8em; height: 1.5em; cursor: pointer;">
            </div>
            <div class="mb-4">
                <label class="form-label text-xs font-bold text-gray-500 uppercase tracking-wider mb-2" for="overrideReason"><%- lan.Reason_For_Custom_Rule || 'Reason for Custom Rule' %></label>
                <textarea id="overrideReason" name="reason" class="form-control" rows="3" placeholder="<%- lan.Custom_Rule_Placeholder || 'e.g. Special exam preparations, Pre-Primary standard requirements override...' %>" style="border-radius: 8px;"></textarea>
            </div>
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary flex-fill"><%- lan.Apply_Settings || 'Apply Settings' %></button>
                <button type="button" onclick="closeOverrideModal()" class="btn btn-secondary flex-fill"><%- lan.Cancel || 'Cancel' %></button>
            </div>
        </form>
    </div>
</div>
<script>
    function openOverrideModal(className, parentPortal, studentPortal, reason) {
        document.getElementById('overrideClassName').value = className;
        document.getElementById('displayClassName').value = className;
        document.getElementById('parentPortalSwitch').checked = !!parentPortal;
        document.getElementById('studentPortalSwitch').checked = !!studentPortal;
        document.getElementById('overrideReason').value = reason || '';

        const modal = document.getElementById('overrideModal');
        modal.classList.remove('hidden');
        modal.classList.add('d-flex');
    }

    function closeOverrideModal() {
        const modal = document.getElementById('overrideModal');
        modal.classList.add('hidden');
        modal.classList.remove('d-flex');
    }

    document.getElementById('overrideModal').addEventListener('click', function(e) {
        if (e.target === this) closeOverrideModal();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeOverrideModal();
    });

    document.querySelectorAll('.reset-override-form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const prefix = this.getAttribute('data-confirm-prefix') || 'Reset portal settings to school default for';
            const cls = this.getAttribute('data-class-name') || '';
            if (!confirm(`${prefix} ${cls}?`)) {
                e.preventDefault();
            }
        });
    });
</script>

<style>
    .bg-indigo-light {
        background-color: rgba(99, 102, 241, 0.08) !important;
    }
    .text-indigo {
        color: #6366F1 !important;
    }
    .bg-success-light {
        background-color: rgba(16, 185, 129, 0.1) !important;
    }
    .hidden {
        display: none !important;
    }
    .cursor-pointer {
        cursor: pointer;
    }

    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3) !important;
    }
    [data-theme="dark"] .card-header.bg-white,
    .light-mode-disabled .card-header.bg-white {
        background: #151D30 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .text-gray-800,
    .light-mode-disabled .text-gray-800,
    [data-theme="dark"] .text-gray-700,
    .light-mode-disabled .text-gray-700 {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .text-gray-600,
    .light-mode-disabled .text-gray-600,
    [data-theme="dark"] .text-gray-500,
    .light-mode-disabled .text-gray-500,
    [data-theme="dark"] .text-gray-400,
    .light-mode-disabled .text-gray-400 {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] thead.bg-light,
    .light-mode-disabled thead.bg-light {
        background-color: #101726 !important;
    }
    [data-theme="dark"] thead.bg-light th,
    .light-mode-disabled thead.bg-light th {
        color: #94A3B8 !important;
        background-color: #101726 !important;
    }
    [data-theme="dark"] .table tbody tr:hover,
    .light-mode-disabled .table tbody tr:hover {
        background-color: #1E293B !important;
    }
    [data-theme="dark"] .table td,
    .light-mode-disabled .table td {
        border-bottom-color: #242F4D !important;
        color: #E2E8F0 !important;
    }
    [data-theme="dark"] .bg-indigo-light,
    .light-mode-disabled .bg-indigo-light {
        background-color: rgba(99, 102, 241, 0.18) !important;
        color: #A5B4FC !important;
    }
    [data-theme="dark"] .bg-success-light,
    .light-mode-disabled .bg-success-light {
        background-color: rgba(16, 185, 129, 0.18) !important;
        color: #34D399 !important;
    }
    [data-theme="dark"] .badge.bg-slate-100,
    .light-mode-disabled .badge.bg-slate-100 {
        background-color: #1E293B !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .badge.bg-amber-100,
    .light-mode-disabled .badge.bg-amber-100 {
        background-color: rgba(245, 158, 11, 0.18) !important;
        color: #FBBF24 !important;
    }
    [data-theme="dark"] #overrideModal .bg-white,
    .light-mode-disabled #overrideModal .bg-white {
        background-color: #151D30 !important;
        border: 1px solid #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] #overrideModal .border-b,
    [data-theme="dark"] #overrideModal .border-bottom,
    .light-mode-disabled #overrideModal .border-b,
    .light-mode-disabled #overrideModal .border-bottom {
        border-color: #242F4D !important;
    }
    [data-theme="dark"] #overrideModal .form-control,
    .light-mode-disabled #overrideModal .form-control {
        background-color: #101726 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] #overrideModal .form-control:focus,
    .light-mode-disabled #overrideModal .form-control:focus {
        border-color: #6366F1 !important;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25) !important;
    }
</style>