<style>
    .assignments-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .assignments-page-title {
        font-size: 22px;
        font-weight: 800;
        color: var(--text-primary, #1E293B);
        margin: 0;
        line-height: 1.2;
    }
    .assignments-page-subtitle {
        font-size: 12px;
        color: var(--text-muted);
        margin: 4px 0 0;
    }
    .assignments-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .assign-nav-tab {
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-radius: 8px;
        color: #64748B;
        text-decoration: none;
        transition: all 0.15s ease;
    }
    .assign-nav-tab:hover {
        background: #F1F5F9;
        color: #0F172A;
    }
    .assign-nav-tab.active {
        background: #ECFDF5;
        color: #059669;
        border: 1px solid #A7F3D0;
    }

    @media (max-width: 640px) {
        .assignments-page-header {
            flex-direction: column;
            align-items: flex-start;
        }
        .assignments-header-actions {
            width: 100%;
        }
        .assignments-header-actions .btn {
            flex: 1;
            justify-content: center;
            min-width: 0;
        }
        .assignments-page-title { font-size: 20px; }
        .table-container {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch;
        }
        .data-table {
            min-width: 580px;
        }
    }

    [data-theme="dark"] .assignments-page-title,
    .light-mode-disabled .assignments-page-title {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .assign-nav-tab,
    .light-mode-disabled .assign-nav-tab {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .assign-nav-tab:hover,
    .light-mode-disabled .assign-nav-tab:hover {
        background: #1E293B !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .assign-nav-tab.active,
    .light-mode-disabled .assign-nav-tab.active {
        background: rgba(16, 185, 129, 0.18) !important;
        border-color: rgba(16, 185, 129, 0.35) !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .free-alert-card,
    .light-mode-disabled .free-alert-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .free-alert-card.warn,
    .light-mode-disabled .free-alert-card.warn {
        border-left-color: #F59E0B !important;
    }
    [data-theme="dark"] .free-alert-card.ok,
    .light-mode-disabled .free-alert-card.ok {
        border-left-color: #10B981 !important;
    }
    [data-theme="dark"] .free-alert-title,
    .light-mode-disabled .free-alert-title {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .free-alert-sub,
    .light-mode-disabled .free-alert-sub {
        color: #94A3B8 !important;
    }
</style>
<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="assignments-page-header">
                <div>
                    <h2 class="assignments-page-title">Unassigned Teachers</h2>
                    <p class="assignments-page-subtitle">Teachers with no class or subject allocations — ready to be assigned</p>
                </div>
                <div class="assignments-header-actions">
                    <a href="/schooladmin/teachers/assign" class="btn btn-primary flex items-center gap-2 text-xs font-bold shadow-sm">
                        <i class="fa-solid fa-plus"></i> New Assignment
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-4 mb-4">
                <a href="/schooladmin/teachers" class="assign-nav-tab">All Teachers</a>
                <a href="/schooladmin/teachers/assignments" class="assign-nav-tab">Assignments</a>
                <a href="/schooladmin/teachers/free" class="assign-nav-tab active">Unassigned</a>
            </div>
            <% if (teachers && teachers.length > 0) { %>
                <div class="card free-alert-card warn p-4 mb-6 flex flex-col sm:flex-row sm:items-center gap-3 border-l-4 border-amber-400 bg-amber-50/50">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-triangle-exclamation text-amber-500 text-lg"></i>
                        <div>
                            <p class="free-alert-title text-xs font-bold text-amber-800"><%= teachers.length %> teacher<%= teachers.length > 1 ? 's are' : ' is' %> not assigned to any class.</p>
                            <p class="free-alert-sub text-[11px] text-amber-700 mt-0.5">These teachers won't appear in the timetable or grading modules until assigned.</p>
                        </div>
                    </div>
                    <a href="/schooladmin/teachers/assign" class="btn btn-primary btn-sm sm:ml-auto text-[11px] font-bold whitespace-nowrap flex items-center justify-center gap-1">
                        <i class="fa-solid fa-plus"></i> Assign Now
                    </a>
                </div>
            <% } else { %>
                <div class="card free-alert-card ok p-4 mb-6 flex items-center gap-3 border-l-4 border-emerald-400 bg-emerald-50/50">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-lg"></i>
                    <div>
                        <p class="free-alert-title text-xs font-bold text-emerald-800">All teachers are assigned to at least one class.</p>
                        <p class="free-alert-sub text-[11px] text-emerald-700 mt-0.5">Great! Your school is fully staffed and each teacher has a class allocation.</p>
                    </div>
                </div>
            <% } %>
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20 flex items-center justify-between">
                    <h4 class="table-heading uppercase tracking-wider">Unassigned Teaching Staff (<%= (teachers||[]).length %>)</h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Teacher Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Qualification</th>
                                <th>Experience</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!teachers || teachers.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center py-12 text-gray-400 font-medium">
                                        <div class="flex flex-col items-center gap-2">
                                            <i class="fa-solid fa-circle-check fa-2x text-emerald-300"></i>
                                            <span class="font-semibold text-slate-500">All teachers have class assignments!</span>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            <% (teachers||[]).forEach((t, idx) => { %>
                                <tr>
                                    <td class="text-slate-400 font-bold text-xs"><%= idx + 1 %></td>
                                    <td>
                                        <a href="/schooladmin/teachers/<%= t.id %>" class="font-bold text-gray-800 text-[13px] hover:text-emerald-600 transition">
                                            <%= t.first_name %> <%= t.last_name %>
                                        </a>
                                    </td>
                                    <td class="font-mono text-[11px] text-slate-500"><%= t.email %></td>
                                    <td class="text-xs text-slate-600"><%= t.phone || '—' %></td>
                                    <td class="text-xs text-slate-600"><%= t.qualification || '—' %></td>
                                    <td class="text-xs text-slate-600">
                                        <%= t.experience ? t.experience + ' yrs' : '—' %>
                                    </td>
                                    <td>
                                        <% if (t.status === 'active') { %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border bg-emerald-50 text-emerald-700 border-emerald-100">
                                                Active
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border bg-slate-50 text-slate-500 border-slate-100">
                                                <%= t.status %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <a href="/schooladmin/teachers/assign" class="btn btn-sm btn-primary py-1 px-2.5 text-[11px] font-bold flex items-center gap-1">
                                                <i class="fa-solid fa-plus"></i> Assign
                                            </a>
                                            <a href="/schooladmin/teachers/<%= t.id %>" class="btn btn-sm btn-secondary py-1 px-2.5 text-[11px] font-bold flex items-center gap-1">
                                                <i class="fa-solid fa-eye"></i> Profile
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>