<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <a href="/schooladmin/teachers/assignments" class="text-emerald-600 hover:text-emerald-700 font-semibold text-xs flex items-center gap-1">
                            <i class="fa-solid fa-arrow-left"></i> Back to Assignments
                        </a>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Unassigned Teachers</h2>
                    <p class="text-xs text-gray-500 mt-0.5">Teachers with no class or subject allocations — ready to be assigned</p>
                </div>
                <a href="/schooladmin/teachers/assign" class="btn btn-primary flex items-center justify-center gap-2 text-xs font-bold shadow-sm w-full sm:w-auto">
                    <i class="fa-solid fa-plus"></i> New Assignment
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Sub Tabs -->
            <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-4 mb-4">
                <a href="/schooladmin/teachers" class="px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-slate-600 hover:bg-slate-50">All Teachers</a>
                <a href="/schooladmin/teachers/assignments" class="px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-slate-600 hover:bg-slate-50">Assignments</a>
                <a href="/schooladmin/teachers/free" class="px-2 py-2 text-xs font-bold uppercase tracking-wider rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-100/50">Unassigned</a>
            </div>

            <!-- Summary Banner -->
            <% if (teachers && teachers.length > 0) { %>
                <div class="card p-4 mb-6 flex flex-col sm:flex-row sm:items-center gap-3 border-l-4 border-amber-400 bg-amber-50/50">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-triangle-exclamation text-amber-500 text-lg"></i>
                        <div>
                            <p class="text-xs font-bold text-amber-800"><%= teachers.length %> teacher<%= teachers.length > 1 ? 's are' : ' is' %> not assigned to any class.</p>
                            <p class="text-[11px] text-amber-700 mt-0.5">These teachers won't appear in the timetable or grading modules until assigned.</p>
                        </div>
                    </div>
                    <a href="/schooladmin/teachers/assign" class="btn btn-primary btn-sm sm:ml-auto w-full sm:w-auto text-[11px] font-bold whitespace-nowrap flex items-center justify-center gap-1">
                        <i class="fa-solid fa-plus"></i> Assign Now
                    </a>
                </div>
            <% } else { %>
                <div class="card p-4 mb-6 flex items-center gap-3 border-l-4 border-emerald-400 bg-emerald-50/50">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-lg"></i>
                    <div>
                        <p class="text-xs font-bold text-emerald-800">All teachers are assigned to at least one class.</p>
                        <p class="text-[11px] text-emerald-700 mt-0.5">Great! Your school is fully staffed and each teacher has a class allocation.</p>
                    </div>
                </div>
            <% } %>

            <!-- Free Teachers Table -->
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20 flex items-center justify-between">
                    <h4 class="table-heading uppercase tracking-wider">Unassigned Teaching Staff (<%= (teachers||[]).length %>)</h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Teacher Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Qualification</th>
                                <th>Experience</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!teachers || teachers.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center py-12 text-gray-400 font-medium">
                                        <div class="flex flex-col items-center gap-2">
                                            <i class="fa-solid fa-circle-check fa-2x text-emerald-300"></i>
                                            <span class="font-semibold text-slate-500">All teachers have class assignments!</span>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            <% (teachers||[]).forEach((t, idx) => { %>
                                <tr>
                                    <td class="text-slate-400 font-bold text-xs"><%= idx + 1 %></td>
                                    <td>
                                        <a href="/schooladmin/teachers/<%= t.id %>" class="font-bold text-gray-800 text-[13px] hover:text-emerald-600 transition">
                                            <%= t.first_name %> <%= t.last_name %>
                                        </a>
                                    </td>
                                    <td class="font-mono text-[11px] text-slate-500"><%= t.email %></td>
                                    <td class="text-xs text-slate-600"><%= t.phone || '—' %></td>
                                    <td class="text-xs text-slate-600"><%= t.qualification || '—' %></td>
                                    <td class="text-xs text-slate-600">
                                        <%= t.experience ? t.experience + ' yrs' : '—' %>
                                    </td>
                                    <td>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border
                                            <%= t.status === 'active' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-slate-50 text-slate-500 border-slate-100' %>">
                                            <%= t.status %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <a href="/schooladmin/teachers/assign" class="btn btn-sm btn-primary py-1 px-2.5 text-[11px] font-bold flex items-center gap-1">
                                                <i class="fa-solid fa-plus"></i> Assign
                                            </a>
                                            <a href="/schooladmin/teachers/<%= t.id %>" class="btn btn-sm btn-secondary py-1 px-2.5 text-[11px] font-bold flex items-center gap-1">
                                                <i class="fa-solid fa-eye"></i> Profile
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
