                            <span class="text-slate-400 block text-[6.5px] uppercase font-semibold leading-none mb-[1.5px]">Department</span>
                            <span class="font-bold text-slate-700 truncate block">
                                <%= (teacher.assignments && teacher.assignments[0] && teacher.assignments[0].subject_name) || teacher.subject || 'General' %>
                            </span>
                        </div>
                        <div class="min-w-0">
                            <span class="text-slate-400 block text-[6.5px] uppercase font-semibold leading-none mb-[1.5px]">Phone No</span>
                            <span class="font-bold text-slate-700 truncate block"><%= teacher.phone || '—' %></span>
                        </div>
                        <div class="min-w-0">
                            <span class="text-slate-400 block text-[6.5px] uppercase font-semibold leading-none mb-[1.5px]">Experience</span>
                            <span class="font-bold text-slate-700 truncate block"><%= teacher.experience_years ? teacher.experience_years + ' Years' : 'N/A' %></span>
                        </div>
                        <div class="min-w-0">
                            <span class="text-slate-400 block text-[6.5px] uppercase font-semibold leading-none mb-[1.5px]">D.O.B.</span>
                            <span class="font-bold text-slate-700 truncate block"><%= teacher.dob ? new Date(teacher.dob).toLocaleDateString('en-GB') : 'N/A' %></span>
                        </div>
                        <div class="min-w-0">
                            <span class="text-slate-400 block text-[6.5px] uppercase font-semibold leading-none mb-[1.5px]">Joining Date</span>
                            <span class="font-bold text-slate-700 truncate block"><%= teacher.joining_date ? new Date(teacher.joining_date).toLocaleDateString('en-GB') : 'N/A' %></span>
                        </div>
                    </div>
                </div>
                <div class="w-[20mm] flex flex-col items-center justify-between h-full flex-shrink-0 border-l border-slate-100 ps-2.5 text-center">
                    <div class="p-[1.5px] bg-white border border-slate-200 rounded shadow-sm">
                        <% if (teacher.qr_code) { %>
                            <img src="<%= teacher.qr_code %>" class="w-[14.5mm] h-[14.5mm] object-contain">
                        <% } %>
                    </div>                    
                    <div class="w-full flex flex-col items-center">
                        <div class="signature-text leading-none h-[14px] flex items-end justify-center text-[11px] text-emerald-800 font-semibold" style="font-family: 'Caveat', cursive;">
                            <%= teacher.school_principal_name || 'Principal' %>
                        </div>
                        <div class="w-full border-t border-slate-200 mt-[1px] pt-[1.5px] text-[5px] text-slate-400 uppercase tracking-widest font-extrabold">
                            Principal Sig
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="id-card-print">
        <div class="id-card-wrapper">
            <% if (teacher.logo) { %>
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.03]">
                    <img src="/uploads/schools/<%= teacher.logo %>" class="w-32 h-32 object-contain filter grayscale">
                </div>
            <% } %>
            <div class="h-[8mm] bg-gradient-to-r from-slate-800 to-slate-900 text-white px-3 flex items-center justify-between border-b-[1.5px] border-amber-500">
                <span class="text-[7.5px] font-extrabold uppercase tracking-wide flex items-center gap-1 text-amber-400">
                    <i class="fa-solid fa-circle-exclamation text-[6.5px]"></i>
                    Emergency Info
                </span>
                <span class="text-[4.5px] text-slate-400 tracking-wider font-bold uppercase">SchoolSync ERP</span>
            </div>
            <div class="h-[45.98mm] p-2.5 flex flex-col justify-between bg-white text-slate-700">
                <div class="grid grid-cols-2 gap-x-4 gap-y-2 flex-1">
                    <div class="space-y-1.5 border-r border-slate-100 pe-2">
                        <div class="flex items-center gap-1 border-b border-slate-100 pb-[2.5px] mb-1">
                            <i class="fa-solid fa-user-group text-slate-400 text-[6px]"></i>
                            <span class="text-[6.5px] font-bold text-slate-400 uppercase tracking-wider">Family Info</span>
                        </div>                        
                        <div>
                            <span class="text-[5.5px] text-slate-400 uppercase block leading-none">Father's Name</span>
                            <span class="text-[7.5px] font-bold text-slate-800 truncate block mt-[1px]"><%= teacher.father_name || 'N/A' %></span>
                        </div>
                        <div class="mt-1">
                            <span class="text-[5.5px] text-slate-400 uppercase block leading-none">Mother's Name</span>
                            <span class="text-[7.5px] font-bold text-slate-800 truncate block mt-[1px]"><%= teacher.mother_name || 'N/A' %></span>
                        </div>
                        <div class="mt-1">
                            <span class="text-[5.5px] text-slate-400 uppercase block leading-none">Marital Status</span>
                            <span class="text-[7.5px] font-bold text-slate-800 truncate block mt-[1px] uppercase"><%= teacher.marital_status || 'N/A' %></span>
                        </div>
                    </div>
                    <div class="space-y-1.5 flex flex-col justify-between h-full">
                        <div>
                            <div class="flex items-center gap-1 border-b border-slate-100 pb-[2.5px] mb-1">
                                <i class="fa-solid fa-home text-slate-400 text-[6px]"></i>
                                <span class="text-[6.5px] font-bold text-slate-400 uppercase tracking-wider">Residential Address</span>
                            </div>
                            <p class="text-[7px] text-slate-600 leading-snug line-clamp-3 font-semibold mt-[2px]">
                                <%= teacher.address || 'Address details not provided by faculty.' %>
                            </p>
                        </div>
                        <div class="bg-slate-50 border border-slate-200/50 px-1 py-[3px] rounded flex justify-between items-center text-[5.5px] leading-none">
                            <div>
                                <span class="text-slate-400 uppercase font-semibold">Email:</span>
                                <span class="font-bold text-slate-700 truncate block max-w-[85px]"><%= teacher.email %></span>
                            </div>
                            <span class="text-emerald-600 font-bold uppercase tracking-wider text-[5px]">NFC Verified</span>
                        </div>
                    </div>
                </div>
                <div class="border-t border-slate-200 pt-1.5 mt-1 flex justify-between items-end">
                    <div class="max-w-[62%] min-w-0">
                        <span class="text-[5.5px] text-slate-400 block uppercase leading-none font-bold">If found, return to:</span>
                        <span class="text-[7px] font-extrabold text-emerald-700 truncate block mt-[1px]"><%= teacher.school_name || 'SchoolSync Academy' %></span>
                    </div>
                    <div class="text-right text-[6px] text-slate-500 font-semibold leading-normal space-y-[0.5px]">
                        <% if (teacher.school_phone) { %>
                            <div><i class="fa-solid fa-phone text-[5px] me-[2px]"></i><%= teacher.school_phone %></div>
                        <% } %>
                        <% if (teacher.school_email) { %>
                            <div class="truncate max-w-[100px]"><i class="fa-solid fa-envelope text-[5px] me-[2px]"></i><%= teacher.school_email %></div>
                        <% } %>
                        <% if (teacher.website) { %>
                            <div class="truncate max-w-[100px]"><i class="fa-solid fa-globe text-[5px] me-[2px]"></i><%= teacher.website %></div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const card = document.getElementById('idCard');
    const cardInner = document.getElementById('cardInner');
    const rotateIcon = document.getElementById('rotateIcon');
    let isRotating = true;
    let isFlipped = false;

    function toggleRotation() {
        isRotating = !isRotating;
        if (isRotating) {
            cardInner.style.animation = 'autoFlip360 8s ease-in-out infinite';
            rotateIcon.className = 'fa-solid fa-pause text-emerald-600';
        } else {
            cardInner.style.animation = 'none';
            rotateIcon.className = 'fa-solid fa-play text-slate-500';
        }
    };

    card.addEventListener('click', function(e) {
        if (isRotating) {
            isRotating = false;
            cardInner.style.animation = 'none';
            rotateIcon.className = 'fa-solid fa-play text-slate-500';
        };

        isFlipped = !isFlipped;
        if (isFlipped) {
            card.classList.add('flipped');
            card.classList.remove('flipped-back');
        } else {
            card.classList.remove('flipped');
            card.classList.add('flipped-back');
        };
    });
</script>