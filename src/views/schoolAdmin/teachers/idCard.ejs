<%- include('../../partials/head') %>

<style>
    /* Google Fonts for Signature and Display */
    @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@400;500;600;700;800&display=swap');

    :root {
        --card-w: 85.6mm;
        --card-h: 53.98mm;
        --primary-emerald: #059669;
        --dark-emerald: #047857;
        --accent-gold: #f59e0b;
    }

    /* Print styling rules */
    .print-layout {
        display: none;
    }

    @media print {
        body {
            background: white !important;
            margin: 0 !important;
            padding: 0 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .no-print {
            display: none !important;
        }
        .app-wrapper, .main-panel, .content, .page-body {
            padding: 0 !important;
            margin: 0 !important;
            background: transparent !important;
            box-shadow: none !important;
        }
        .print-layout {
            display: flex !important;
            flex-direction: row !important;
            gap: 10mm;
            justify-content: center;
            align-items: center;
            height: 100vh;
            width: 100%;
            background: white !important;
        }
        .id-card-print {
            display: block !important;
            width: 85.6mm !important;
            height: 53.98mm !important;
            position: relative !important;
            border: 0.5px solid #64748b !important;
            border-radius: 3.18mm !important;
            overflow: hidden !important;
            page-break-inside: avoid;
            background: white !important;
            box-shadow: none !important;
            transform: none !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }

    /* Screen preview 3D card layout */
    .flip-card {
        perspective: 1000px;
        width: var(--card-w);
        height: var(--card-h);
        cursor: pointer;
    }

    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
        transform-style: preserve-3d;
        animation: autoFlip360 8s ease-in-out infinite;
        box-shadow: 0 20px 40px rgba(4, 120, 87, 0.15), 0 5px 15px rgba(0, 0, 0, 0.08);
        border-radius: 3.18mm;
    }

    /* Auto Rotation */
    @keyframes autoFlip360 {
        0% { transform: rotateY(0deg); }
        35% { transform: rotateY(0deg); }
        45% { transform: rotateY(180deg); }
        85% { transform: rotateY(180deg); }
        95% { transform: rotateY(360deg); }
        100% { transform: rotateY(360deg); }
    }

    .flip-card.flipped .flip-card-inner {
        animation: none;
        transform: rotateY(180deg);
    }

    .flip-card.flipped-back .flip-card-inner {
        animation: none;
        transform: rotateY(0deg);
    }

    .flip-card-front, .flip-card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        border-radius: 3.18mm;
        overflow: hidden;
        background: white;
    }

    .flip-card-back {
        transform: rotateY(180deg);
    }

    .id-card-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        border: 0.5px solid #e2e8f0;
    }

    /* Hologram seal */
    .hologram {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: conic-gradient(from 0deg, 
            #059669 0%, 
            #f59e0b 25%, 
            #06b6d4 50%, 
            #ec4899 75%, 
            #059669 100%);
        opacity: 0.35;
        mix-blend-mode: color-burn;
        animation: spin-hologram 4s linear infinite;
        border: 0.5px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 0 4px rgba(255, 255, 255, 0.5);
    }
    @keyframes spin-hologram {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Header Shimmer */
    .header-shimmer-bg {
        position: relative;
        overflow: hidden;
    }
    .header-shimmer-bg::after {
        content: '';
        position: absolute;
        top: 0;
        left: -150%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
        animation: shimmer 4s infinite;
    }
    @keyframes shimmer {
        0% { left: -150%; }
        50% { left: 150%; }
        100% { left: 150%; }
    }
</style>

