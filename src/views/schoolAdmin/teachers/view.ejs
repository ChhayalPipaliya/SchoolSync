<style>
    .teacher-view-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 12px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .teacher-view-card-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #059669;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .teacher-meta-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px solid #F8FAFC;
        font-size: 11px;
    }

    .teacher-meta-row:last-child {
        border-bottom: none;
    }

    .teacher-meta-label {
        font-size: 9px;
        font-weight: 700;
        color: #94A3B8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .teacher-meta-value {
        font-weight: 600;
        color: #334155;
        text-align: right;
    }

    .timetable-scroll-container {
        max-height: 480px;
        overflow-y: auto;
        overflow-x: auto;
    }

    .timetable-scroll-container::-webkit-scrollbar {
        width: 5px;
        height: 5px;
    }

    .timetable-scroll-container::-webkit-scrollbar-track {
        background: #F1F5F9;
        border-radius: 4px;
    }

    .timetable-scroll-container::-webkit-scrollbar-thumb {
        background: #CBD5E1;
        border-radius: 4px;
    }

    .timetable-scroll-container thead th {
        position: sticky;
        top: 0;
        background: #F8FAFC !important;
        z-index: 2;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748B;
        padding: 8px 12px;
    }

    .day-badge-monday { background: rgba(59, 130, 246, 0.1); color: #1D4ED8; border: 1px solid rgba(59, 130, 246, 0.2); }
    .day-badge-tuesday { background: rgba(245, 158, 11, 0.1); color: #B45309; border: 1px solid rgba(245, 158, 11, 0.2); }
    .day-badge-wednesday { background: rgba(16, 185, 129, 0.1); color: #047857; border: 1px solid rgba(16, 185, 129, 0.2); }
    .day-badge-thursday { background: rgba(139, 92, 246, 0.1); color: #6D28D9; border: 1px solid rgba(139, 92, 246, 0.2); }
    .day-badge-friday { background: rgba(236, 72, 153, 0.1); color: #BE185D; border: 1px solid rgba(236, 72, 153, 0.2); }
    .day-badge-saturday { background: rgba(99, 102, 241, 0.1); color: #4338CA; border: 1px solid rgba(99, 102, 241, 0.2); }
    .day-badge-sunday { background: rgba(239, 68, 68, 0.1); color: #B91C1C; border: 1px solid rgba(239, 68, 68, 0.2); }

    [data-theme="dark"] .teacher-view-card,
    .light-mode-disabled .teacher-view-card {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .teacher-view-card-title,
    .light-mode-disabled .teacher-view-card-title {
        border-bottom-color: #242F4D !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .teacher-meta-row,
    .light-mode-disabled .teacher-meta-row {
        border-bottom-color: #242F4D !important;
    }

    [data-theme="dark"] .teacher-meta-value,
    .light-mode-disabled .teacher-meta-value {
        color: #E2E8F0 !important;
    }

    [data-theme="dark"] .timetable-scroll-container thead th,
    .light-mode-disabled .timetable-scroll-container thead th {
        background: #101726 !important;
        color: #94A3B8 !important;
    }
</style>
<%- include('../../partials/head', { title: `${teacher.first_name} ${teacher.last_name} | Teacher Profile | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Teacher_Profile || 'Teacher Profile' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Teacher_Profile_Subtitle || 'Detailed details and weekly schedule of the teaching staff member' %> &bull; <%= teacher.first_name %> <%= teacher.last_name %></p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                        <a href="/schooladmin/teachers" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-arrow-left"></i> <%- lan.Back || 'Back' %>
                        </a>
                        <a href="/schooladmin/teachers/<%= teacher.id %>/id-card" target="_blank" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-id-card"></i> <%- lan.ID_Card || 'ID Card' %>
                        </a>
                        <a href="/schooladmin/teachers/<%= teacher.id %>/assign" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 11px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                            <i class="fa-solid fa-list-check"></i> <%- lan.Assign_Classes || 'Assign Classes' %>
                        </a>
                        <a href="/schooladmin/teachers/<%= teacher.id %>/edit" class="btn" style="background: #ffffff; color: #059669; border: none; font-weight: 700; padding: 7px 13px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.08);">
                            <i class="fa-solid fa-pen-to-square"></i> <%- lan.Edit_Profile || 'Edit Profile' %>
                        </a>
                    </div>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div style="display: grid; grid-template-columns: 320px 1fr; gap: 14px; align-items: start;" class="teacher-profile-layout">
                <div>
                    <div class="teacher-view-card" style="text-align: center; padding: 18px 14px;">
                        <% 
                            let profileImg = null;
                            const rawImg = teacher.photo || teacher.image;
                            if (rawImg) {
                                try {
                                    const imgs = JSON.parse(rawImg);
                                    if (Array.isArray(imgs) && imgs.length) {
                                        profileImg = imgs[0].startsWith('/uploads/') ? imgs[0] : '/uploads/teachers/' + imgs[0].replace(/^\/+/,'');
                                    } else if (typeof imgs === 'string') {
                                        profileImg = imgs.startsWith('/uploads/') ? imgs : '/uploads/teachers/' + imgs.replace(/^\/+/,'');
                                    }
                                } catch (e) {
                                    profileImg = rawImg.startsWith('/') ? rawImg : '/uploads/teachers/' + rawImg.replace(/^\/+/,'');
                                }
                            }
                        %>
                        <% if (profileImg) { %>
                            <img src="<%= profileImg %>" style="width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 2px solid #E2E8F0; margin: 0 auto 10px; display: block; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
                        <% } else { %>
                            <div style="width: 84px; height: 84px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #ECFDF5; color: #059669; font-weight: 800; font-size: 26px; border: 2px solid rgba(5, 150, 105, 0.2); margin: 0 auto 10px;">
                                <%= (teacher.first_name || '?').charAt(0).toUpperCase() %>
                            </div>
                        <% } %>
                        <h2 style="font-size: 15px; font-weight: 800; color: #1E293B; margin: 0 0 2px;"><%= teacher.first_name %> <%= teacher.last_name %></h2>
                        <p style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #059669; margin: 0 0 8px;"><%= teacher.qualification || lan.Teaching_Staff || 'Teaching Staff' %></p>
                        
                        <div style="display: flex; justify-content: center; gap: 6px; flex-wrap: wrap;">
                            <span class="badge badge-<%= teacher.status === 'active' ? 'success' : 'danger' %>" style="font-size: 10px; padding: 2px 8px; text-transform: capitalize;">
                                <%= teacher.status === 'active' ? (lan.Active || 'Active') : (teacher.status === 'inactive' ? (lan.Inactive || 'Inactive') : (teacher.status || 'Active')) %>
                            </span>
                            <% if (teacher.gender) { %>
                                <span class="badge badge-secondary" style="font-size: 10px; padding: 2px 8px; text-transform: capitalize;">
                                    <%= teacher.gender === 'male' ? (lan.Male || 'Male') : (teacher.gender === 'female' ? (lan.Female || 'Female') : teacher.gender) %>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <div class="teacher-view-card">
                        <h3 class="teacher-view-card-title">
                            <i class="fa-solid fa-address-card"></i> <%- lan.Employment_Details || 'Employment Details' %>
                        </h3>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Email || 'Email' %></span>
                            <span class="teacher-meta-value" style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= teacher.email %>"><%= teacher.email || '—' %></span>
                        </div>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Phone || 'Phone' %></span>
                            <span class="teacher-meta-value"><%= teacher.phone || '—' %></span>
                        </div>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Experience || 'Experience' %></span>
                            <span class="teacher-meta-value"><%= teacher.experience_years || teacher.experience || 0 %> yrs</span>
                        </div>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Salary || 'Salary' %></span>
                            <span class="teacher-meta-value" style="color: #059669; font-weight: 700;">₹<%= teacher.salary ? Number(teacher.salary).toLocaleString('en-IN') : 0 %></span>
                        </div>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Joining_Date || 'Joining Date' %></span>
                            <span class="teacher-meta-value"><%= teacher.joining_date ? new Date(teacher.joining_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %></span>
                        </div>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Last_Login || 'Last Login' %></span>
                            <span class="teacher-meta-value"><%= teacher.last_login ? new Date(teacher.last_login).toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : (lan.Never_Logged_In || 'Never Logged In') %></span>
                        </div>
                    </div>
                    <div class="teacher-view-card">
                        <h3 class="teacher-view-card-title">
                            <i class="fa-solid fa-user-group"></i> <%- lan.Family_And_Contact || 'Family & Contact' %>
                        </h3>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Father_Name || "Father's Name" %></span>
                            <span class="teacher-meta-value"><%= teacher.father_name || '—' %></span>
                        </div>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Mother_Name || "Mother's Name" %></span>
                            <span class="teacher-meta-value"><%= teacher.mother_name || '—' %></span>
                        </div>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Marital_Status || 'Marital Status' %></span>
                            <span class="teacher-meta-value" style="text-transform: capitalize;"><%= teacher.marital_status === 'single' ? (lan.Single || 'Single') : (teacher.marital_status === 'married' ? (lan.Married || 'Married') : (teacher.marital_status || '—')) %></span>
                        </div>
                        <div class="teacher-meta-row">
                            <span class="teacher-meta-label"><%- lan.Emergency_Phone || 'Emergency Phone' %></span>
                            <span class="teacher-meta-value"><%= teacher.emergency_contact || '—' %></span>
                        </div>
                        <div style="padding-top: 6px;">
                            <span class="teacher-meta-label" style="display: block; margin-bottom: 2px;"><%- lan.Current_Address || 'Current Address' %></span>
                            <p style="font-size: 11px; color: #475569; margin: 0; background: #F8FAFC; padding: 6px 8px; border-radius: 6px; border: 1px solid #F1F5F9; line-height: 1.4;"><%= teacher.current_address || teacher.address || '—' %></p>
                        </div>
                    </div>
                    <div class="teacher-view-card">
                        <h3 class="teacher-view-card-title">
                            <i class="fa-solid fa-heart-pulse"></i> <%- lan.Health_And_Medical || 'Health & Medical' %>
                        </h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; text-align: center; margin-bottom: 8px;">
                            <div style="background: #F8FAFC; padding: 6px 4px; border-radius: 6px; border: 1px solid #F1F5F9;">
                                <span class="teacher-meta-label"><%- lan.Blood || 'Blood' %></span>
                                <span style="display: block; font-size: 11px; font-weight: 800; color: #1E293B; margin-top: 2px;"><%= typeof medical !== 'undefined' && medical.blood_group ? medical.blood_group : (teacher.blood_group || '—') %></span>
                            </div>
                            <div style="background: #F8FAFC; padding: 6px 4px; border-radius: 6px; border: 1px solid #F1F5F9;">
                                <span class="teacher-meta-label"><%- lan.Height || 'Height' %></span>
                                <span style="display: block; font-size: 11px; font-weight: 800; color: #1E293B; margin-top: 2px;"><%= typeof medical !== 'undefined' && medical.height ? medical.height + ' cm' : '—' %></span>
                            </div>
                            <div style="background: #F8FAFC; padding: 6px 4px; border-radius: 6px; border: 1px solid #F1F5F9;">
                                <span class="teacher-meta-label"><%- lan.Weight || 'Weight' %></span>
                                <span style="display: block; font-size: 11px; font-weight: 800; color: #1E293B; margin-top: 2px;"><%= typeof medical !== 'undefined' && medical.weight ? medical.weight + ' kg' : '—' %></span>
                            </div>
                        </div>
                        <div>
                            <span class="teacher-meta-label" style="display: block; margin-bottom: 2px;"><%- lan.Medical_Conditions || 'Medical Conditions' %></span>
                            <p style="font-size: 11px; color: #475569; margin: 0; background: #F8FAFC; padding: 6px 8px; border-radius: 6px; border: 1px solid #F1F5F9;">
                                <%= typeof medical !== 'undefined' && medical.medical_issues ? medical.medical_issues : (lan.None_Reported || 'None reported') %>
                            </p>
                        </div>
                    </div>
                    <div class="teacher-view-card">
                        <h3 class="teacher-view-card-title">
                            <i class="fa-solid fa-file-shield"></i> <%- lan.Documents_And_Certificates || 'Documents & Certificates' %>
                        </h3>
                        <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <% documents.forEach(d => { %>
                                    <a href="/uploads/teachers/<%= d.file_path %>" target="_blank" style="display: flex; align-items: center; justify-content: space-between; padding: 6px 8px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 6px; text-decoration: none; font-size: 11px; font-weight: 600; color: #334155;">
                                        <div style="display: flex; align-items: center; gap: 6px; min-width: 0;">
                                            <i class="fas fa-file-pdf" style="color: #E11D48;"></i>
                                            <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= d.document_name %></span>
                                        </div>
                                        <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 9px; color: #94A3B8;"></i>
                                    </a>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p style="font-size: 11px; color: #94A3B8; font-style: italic; text-align: center; margin: 4px 0;"><%- lan.No_Documents_Uploaded || 'No documents uploaded' %></p>
                        <% } %>
                    </div>
                </div>
                <div>
                    <div class="teacher-view-card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid #F1F5F9;">
                            <h3 style="font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #059669; margin: 0; display: flex; align-items: center; gap: 6px;">
                                <i class="fa-solid fa-person-chalkboard"></i> <%- lan.Class_Subject_Assignments || 'Class & Subject Assignments' %>
                            </h3>
                            <span class="badge badge-success" style="font-size: 10px; font-weight: 700; padding: 2px 8px;">
                                <%= assignments.length %> <%- lan.Assigned || 'Assigned' %>
                            </span>
                        </div>
                        <% if (assignments.length > 0) { %>
                            <div style="overflow-x: auto;">
                                <table class="data-table" style="font-size: 11px; width: 100%;">
                                    <thead>
                                        <tr style="background: #F8FAFC;">
                                            <th style="padding: 8px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #64748B;"><%- lan.Class_And_Section || 'Class & Section' %></th>
                                            <th style="padding: 8px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #64748B;"><%- lan.Subject || 'Subject' %></th>
                                            <th style="padding: 8px 12px; font-size: 9px; font-weight: 700; text-transform: uppercase; color: #64748B; text-align: center;"><%- lan.Primary_Instructor || 'Primary Instructor' %></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% assignments.forEach(a => { %>
                                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                                <td style="padding: 8px 12px; font-weight: 700; color: #1E293B;">
                                                    <span style="display: inline-flex; align-items: center; padding: 3px 8px; border-radius: 6px; background: #F1F5F9; color: #334155; font-size: 11px; font-weight: 700; border: 1px solid #E2E8F0;">
                                                        <%= a.section ? (a.class_name + ' - ' + a.section) : a.class_name %>
                                                    </span>
                                                </td>
                                                <td style="padding: 8px 12px; font-weight: 600; color: #475569;">
                                                    <%= a.subject_name || 'General' %>
                                                </td>
                                                <td style="padding: 8px 12px; text-align: center;">
                                                    <% if (a.is_primary) { %>
                                                        <span class="badge badge-success" style="font-size: 10px; padding: 2px 8px;"><%- lan.Yes || 'Yes' %></span>
                                                    <% } else { %>
                                                        <span class="badge badge-secondary" style="font-size: 10px; padding: 2px 8px;"><%- lan.No || 'No' %></span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div style="text-align: center; padding: 20px 10px; color: #94A3B8;">
                                <i class="fa-solid fa-folder-open" style="font-size: 24px; color: #CBD5E1; margin-bottom: 6px;"></i>
                                <p style="font-size: 11px; font-weight: 700; color: #475569; margin: 0 0 4px;"><%- lan.No_Class_Assignments_Found || 'No class assignments found' %></p>
                                <a href="/schooladmin/teachers/<%= teacher.id %>/assign" style="font-size: 11px; font-weight: 700; color: #059669; text-decoration: underline;"><%- lan.Assign_First_Class || 'Assign First Class' %></a>
                            </div>
                        <% } %>
                    </div>
                    <div class="teacher-view-card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid #F1F5F9;">
                            <h3 style="font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #059669; margin: 0; display: flex; align-items: center; gap: 6px;">
                                <i class="fa-solid fa-calendar-days"></i> <%- lan.Weekly_Timetable_Schedule || 'Weekly Timetable Schedule' %>
                            </h3>
                            <span class="badge badge-primary" style="font-size: 10px; font-weight: 700; padding: 2px 8px;">
                                <%= timetable.length %> <%- lan.Weekly_Periods || 'Weekly Periods' %>
                            </span>
                        </div>
                        <div class="timetable-scroll-container">
                            <% if (timetable && timetable.length > 0) { %>
                                <table class="data-table" style="font-size: 11px; width: 100%;">
                                    <thead>
                                        <tr>
                                            <th style="width: 100px;"><%- lan.Day || 'Day' %></th>
                                            <th style="width: 150px;"><%- lan.Time_Slot || 'Time Slot' %></th>
                                            <th><%- lan.Class_And_Section || 'Class & Section' %></th>
                                            <th><%- lan.Subject || 'Subject' %></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% timetable.forEach(t => { 
                                            const formatTime = (timeStr) => {
                                                if (!timeStr) return '';
                                                const parts = timeStr.split(':');
                                                if (parts.length >= 2) return parts[0] + ':' + parts[1];
                                                return timeStr;
                                            };
                                        %>
                                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                                <td style="padding: 8px 12px;">
                                                    <span class="day-badge-<%= (t.day_of_week || '').toLowerCase() %>" style="display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 9999px; font-size: 10px; font-weight: 700; text-transform: capitalize;">
                                                        <%= t.day_of_week %>
                                                    </span>
                                                </td>
                                                <td style="padding: 8px 12px;">
                                                    <span style="display: inline-flex; align-items: center; gap: 4px; font-family: monospace; font-size: 11px; color: #475569; background: #F1F5F9; padding: 2px 6px; border-radius: 4px; font-weight: 600; border: 1px solid #E2E8F0;">
                                                        <i class="fa-regular fa-clock" style="font-size: 10px; color: #94A3B8;"></i>
                                                        <%= formatTime(t.start_time) %> – <%= formatTime(t.end_time) %>
                                                    </span>
                                                </td>
                                                <td style="padding: 8px 12px; font-weight: 700; color: #1E293B;">
                                                    <%= t.section ? (t.class_name + ' - ' + t.section) : t.class_name %>
                                                </td>
                                                <td style="padding: 8px 12px;">
                                                    <span style="display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 600; background: #ECFDF5; color: #047857; border: 1px solid rgba(5, 150, 105, 0.2);">
                                                        <%= t.subject_name %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            <% } else { %>
                                <div style="text-align: center; padding: 24px 10px; color: #94A3B8;">
                                    <i class="fa-regular fa-calendar-xmark" style="font-size: 24px; color: #CBD5E1; margin-bottom: 6px;"></i>
                                    <p style="font-size: 11px; font-weight: 700; color: #475569; margin: 0 0 2px;"><%- lan.No_Active_Timetable_Slots || 'No active timetable slots' %></p>
                                    <p style="font-size: 10px; color: #94A3B8; margin: 0;"><%- lan.No_Timetable_Slots_Subtitle || 'No weekly timetable slots have been scheduled for this teacher yet.' %></p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>