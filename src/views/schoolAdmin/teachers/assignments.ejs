<style>
    .assignments-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .assignments-page-title {
        font-size: 22px;
        font-weight: 800;
        color: var(--text-primary, #1E293B);
        margin: 0;
        line-height: 1.2;
    }

    .assignments-page-subtitle {
        font-size: 12px;
        color: var(--text-muted);
        margin: 4px 0 0;
    }

    .assignments-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .assignments-table-container {
        position: relative;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
        width: 100%;
        scrollbar-width: thin;
        scrollbar-color: #94a3b8 #f1f5f9;
    }

    .assignments-table-container::-webkit-scrollbar {
        height: 8px;
    }

    .assignments-table-container::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
    }

    .assignments-table-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }

    .assignments-table-container::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }

    .assignments-data-table {
        width: 100%;
        min-width: 820px !important;
        border-collapse: collapse;
    }

    .assignments-data-table th {
        white-space: nowrap;
        padding: 12px 16px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .assignments-data-table td {
        padding: 12px 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 13px;
    }

    .col-idx {
        white-space: nowrap;
        min-width: 45px;
        width: 45px;
    }

    .col-teacher {
        white-space: nowrap;
        min-width: 170px;
    }

    .col-class {
        white-space: nowrap;
        min-width: 145px;
    }

    .col-subject {
        white-space: nowrap;
        min-width: 120px;
    }

    .col-primary {
        white-space: nowrap;
        min-width: 140px;
        text-align: center;
    }

    .col-date {
        white-space: nowrap;
        min-width: 125px;
    }

    .col-actions {
        white-space: nowrap;
        min-width: 160px;
        text-align: center;
    }

    .assign-nav-tab {
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-radius: 8px;
        color: #64748B;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .assign-nav-tab:hover {
        background: #F1F5F9;
        color: #0F172A;
    }

    .assign-nav-tab.active {
        background: #ECFDF5;
        color: #059669;
        border: 1px solid #A7F3D0;
    }

    .class-badge-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: #EFF6FF;
        color: #2563EB;
        border: 1px solid #BFDBFE;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .class-badge-pill:hover {
        background: #DBEAFE;
    }

    .primary-teacher-pill {
        display: inline-flex;
        align-items: center;
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        background: #ECFDF5;
        color: #059669;
        border: 1px solid #A7F3D0;
    }

    .mobile-scroll-hint {
        display: none;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 600;
        color: #059669;
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        border-radius: 6px;
        padding: 4px 10px;
    }

    @media (max-width: 768px) {
        .mobile-scroll-hint {
            display: inline-flex;
        }
    }

    @media (max-width: 640px) {
        .assignments-page-header {
            flex-direction: column;
            align-items: flex-start;
        }
        .assignments-header-actions {
            width: 100%;
        }
        .assignments-header-actions .btn {
            flex: 1;
            justify-content: center;
            min-width: 0;
        }

        .assignments-page-title {
            font-size: 20px;
        }

        .assignments-filter-form {
            grid-template-columns: 1fr !important;
        }

        .assignments-table-header {
            flex-wrap: wrap;
            gap: 8px;
        }
        .table-container,
        .assignments-table-container {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch;
        }
        .data-table,
        .assignments-data-table {
            min-width: 820px !important;
        }
    }
    @media (max-width: 768px) and (min-width: 641px) {
        .assignments-filter-form {
            grid-template-columns: 1fr 1fr !important;
        }
    }

    [data-theme="dark"] .assignments-page-title,
    .light-mode-disabled .assignments-page-title {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .assign-nav-tab,
    .light-mode-disabled .assign-nav-tab {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .assign-nav-tab:hover,
    .light-mode-disabled .assign-nav-tab:hover {
        background: #1E293B !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .assign-nav-tab.active,
    .light-mode-disabled .assign-nav-tab.active {
        background: rgba(16, 185, 129, 0.18) !important;
        border-color: rgba(16, 185, 129, 0.35) !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .assignments-data-table th,
    .light-mode-disabled .assignments-data-table th {
        background: #1E293B !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .assignments-data-table td,
    .light-mode-disabled .assignments-data-table td {
        border-color: #242F4D !important;
        color: #CBD5E1 !important;
    }

    [data-theme="dark"] .assignments-data-table tbody tr:hover td,
    .light-mode-disabled .assignments-data-table tbody tr:hover td {
        background: #1E293B !important;
    }

    [data-theme="dark"] .teacher-name-link,
    .light-mode-disabled .teacher-name-link {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .teacher-name-link:hover,
    .light-mode-disabled .teacher-name-link:hover {
        color: #34D399 !important;
    }

    [data-theme="dark"] .class-badge-pill,
    .light-mode-disabled .class-badge-pill {
        background: rgba(59, 130, 246, 0.18) !important;
        border-color: rgba(59, 130, 246, 0.35) !important;
        color: #93C5FD !important;
    }

    [data-theme="dark"] .primary-teacher-pill,
    .light-mode-disabled .primary-teacher-pill {
        background: rgba(16, 185, 129, 0.18) !important;
        border-color: rgba(16, 185, 129, 0.35) !important;
        color: #34D399 !important;
    }
</style>
<%- include('../../partials/head') %>
    <div class="app-wrapper schooladmin-theme">
        <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content">
                        <div class="assignments-page-header">
                            <div>
                                <h2 class="assignments-page-title"><%= lan.Class_Assignments %></h2>
                                <p class="assignments-page-subtitle"><%= lan.Class_Assignments_Subtitle %></p>
                            </div>
                            <div class="assignments-header-actions">
                                <a href="/schooladmin/teachers/assign"
                                    class="btn btn-primary flex items-center gap-2 text-xs font-bold shadow-sm">
                                    <i class="fa-solid fa-plus"></i> <%= lan.New_Assignment %>
                                </a>
                                <a href="/schooladmin/teachers/free"
                                    class="btn btn-secondary flex items-center gap-2 text-xs font-bold shadow-sm">
                                    <i class="fa-solid fa-user-slash"></i> <%= lan.Unassigned_Teachers %>
                                </a>
                            </div>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-4 mb-4">
                                <a href="/schooladmin/teachers" class="assign-nav-tab"><%= lan.All_Teachers %></a>
                                <a href="/schooladmin/teachers/assignments"
                                    class="assign-nav-tab active"><%= lan.Assignments %></a>
                                <a href="/schooladmin/teachers/free" class="assign-nav-tab"><%= lan.Unassigned %></a>
                            </div>
                            <div class="card p-5 mb-6">
                                <form method="GET" action="/schooladmin/teachers/assignments"
                                    class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end assignments-filter-form">
                                    <div>
                                        <label
                                            class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Teacher %></label>
                                        <select name="teacher_id" class="form-select text-xs">
                                            <option value=""><%= lan.All_Teachers %></option>
                                            <% (teachers||[]).forEach(t=> { %>
                                                <option value="<%= t.id %>" <%=filters.teacher_id==t.id ? 'selected'
                                                    : '' %>><%= t.first_name %>
                                                        <%= t.last_name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                    <div>
                                        <label
                                            class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Class %></label>
                                        <select name="class_id" class="form-select text-xs">
                                            <option value=""><%= lan.All_Classes %></option>
                                            <% (classes||[]).forEach(c=> { %>
                                                <option value="<%= c.id %>" <%=filters.class_id==c.id ? 'selected' : ''
                                                    %>><%= c.name || c.class_label || (c.class_name + (c.stream &&
                                                        c.stream !=='General' ? ' - ' + c.stream : '' ) + ' - ' +
                                                        c.section) %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                    <div>
                                        <label
                                            class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Subject %></label>
                                        <select name="subject_id" class="form-select text-xs">
                                            <option value=""><%= lan.All_Subjects %></option>
                                            <% (subjects||[]).forEach(s=> { %>
                                                <option value="<%= s.id %>" <%=filters.subject_id==s.id ? 'selected'
                                                    : '' %>><%= s.subject_name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                    <div class="flex gap-2">
                                        <button type="submit"
                                            class="btn btn-primary btn-sm flex-1 text-[11px] font-bold"><i
                                                class="fas fa-filter mr-1"></i> <%= lan.Filter %></button>
                                        <a href="/schooladmin/teachers/assignments"
                                            class="btn btn-secondary btn-sm flex-1 text-center flex items-center justify-center text-[11px] font-bold"><%= lan.Reset %></a>
                                    </div>
                                </form>
                            </div>
                            <div class="table-card">
                                <div
                                    class="table-header-row bg-slate-50/20 flex items-center justify-between assignments-table-header">
                                    <div class="flex items-center gap-3">
                                        <h4 class="table-heading uppercase tracking-wider"><%= lan.All_Class_Assignments %> (<%=
                                                (assignments||[]).length %>)</h4>
                                        <div class="mobile-scroll-hint">
                                            <i class="fa-solid fa-arrows-left-right"></i> <%= lan.Scroll %>
                                        </div>
                                    </div>
                                    <a href="/schooladmin/teachers/assign"
                                        class="btn btn-primary btn-sm text-[11px] font-bold flex items-center gap-1">
                                        <i class="fa-solid fa-plus"></i> <%= lan.Assign %>
                                    </a>
                                </div>
                                <div class="table-container assignments-table-container">
                                    <table class="data-table assignments-data-table">
                                        <thead>
                                            <tr>
                                                <th class="col-idx">#</th>
                                                <th class="col-teacher"><%= lan.Teacher %></th>
                                                <th class="col-class"><%= lan.Class %></th>
                                                <th class="col-subject"><%= lan.Subject %></th>
                                                <th class="col-primary text-center"><%= lan.Primary_Teacher %></th>
                                                <th class="col-date"><%= lan.Assigned_Date %></th>
                                                <th class="col-actions text-center"><%= lan.Actions %></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (!assignments || assignments.length===0) { %>
                                                <tr>
                                                    <td colspan="7" class="text-center py-12 text-gray-400 font-medium">
                                                        <div class="flex flex-col items-center gap-2">
                                                            <i
                                                                class="fa-solid fa-person-chalkboard fa-2x text-gray-200"></i>
                                                            <span><%= lan.No_Assignments_Found %> <a
                                                                    href="/schooladmin/teachers/assign"
                                                                    class="text-emerald-600 font-bold hover:underline"><%= lan.Create_One_Now %></a></span>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% } %>
                                                    <% (assignments||[]).forEach((a, idx)=> { %>
                                                        <tr>
                                                            <td class="col-idx text-slate-400 font-bold text-xs">
                                                                <%= idx + 1 %>
                                                            </td>
                                                            <td class="col-teacher">
                                                                <a href="/schooladmin/teachers/<%= a.teacher_id %>/classes"
                                                                    class="teacher-name-link font-bold text-[13px] transition whitespace-nowrap">
                                                                    <%= a.first_name %>
                                                                        <%= a.last_name %>
                                                                </a>
                                                            </td>
                                                            <td class="col-class">
                                                                <a href="/schooladmin/teachers/by-class/<%= a.class_id %>"
                                                                    class="class-badge-pill whitespace-nowrap">
                                                                    <%= a.class_label || a.name || (a.class_name +
                                                                        (a.stream && a.stream !=='General' ? ' - ' +
                                                                        a.stream : '' ) + ' - ' + a.section) %>
                                                                </a>
                                                            </td>
                                                            <td
                                                                class="col-subject font-medium text-xs whitespace-nowrap">
                                                                <%= a.subject_name %>
                                                            </td>
                                                            <td class="col-primary text-center">
                                                                <% if (a.is_primary) { %>
                                                                    <span
                                                                        class="primary-teacher-pill whitespace-nowrap">
                                                                        <i class="fa-solid fa-star mr-1 text-[8px]"></i>
                                                                        <%= lan.Primary %>
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="text-slate-400 text-[10px]">—</span>
                                                                        <% } %>
                                                            </td>
                                                            <td
                                                                class="col-date text-xs text-slate-400 whitespace-nowrap">
                                                                <%= a.created_at ? new
                                                                    Date(a.created_at).toLocaleDateString('en-IN', {
                                                                    day: '2-digit' , month: 'short' , year: 'numeric' })
                                                                    : '—' %>
                                                            </td>
                                                            <td class="col-actions text-center">
                                                                <div
                                                                    class="flex items-center justify-center gap-1.5 whitespace-nowrap">
                                                                    <a href="/schooladmin/teachers/assign?edit=<%= a.id %>"
                                                                        class="btn btn-sm btn-secondary py-1 px-2.5 text-[11px] font-bold flex items-center gap-1">
                                                                        <i class="fa-solid fa-pen"></i> <%= lan.Edit %>
                                                                    </a>
                                                                    <form method="POST"
                                                                        action="/schooladmin/teachers/assignments/<%= a.id %>/delete"
                                                                        class="inline-block m-0"
                                                                        onsubmit="return confirm('<%= lan.Remove_Assignment_Confirm %>')">
                                                                        <button type="submit"
                                                                            class="btn btn-sm btn-danger py-1 px-2.5 text-[11px] font-bold flex items-center gap-1">
                                                                            <i class="fa-solid fa-trash"></i> <%= lan.Remove %>
                                                                        </button>
                                                                    </form>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                        </tbody>
                                    </table>
                                </div>
</div>
        <%- include('../../partials/footer') %>
                        </div>
            </div>
