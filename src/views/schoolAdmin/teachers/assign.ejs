<style>
    .assign-teacher-header {
        margin-bottom: 24px;
    }

    .assign-teacher-title {
        font-size: 22px;
        font-weight: 800;
        color: var(--text-primary, #1E293B);
        margin: 0;
        line-height: 1.2;
    }

    .assign-teacher-subtitle {
        font-size: 12px;
        color: var(--text-muted);
        margin: 4px 0 0;
    }

    .attendance-class-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        background: #F8FAFC;
        border-radius: 10px;
        border: 1px solid #E2E8F0;
    }

    .how-it-works-card {
        border-left: 4px solid #10B981;
    }

    @media (max-width: 640px) {
        .assign-action-row {
            flex-direction: column;
        }

        .assign-action-row .btn {
            width: 100%;
            justify-content: center;
        }
    }

    [data-theme="dark"] .assign-teacher-title,
    .light-mode-disabled .assign-teacher-title {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .assign-card-header,
    .light-mode-disabled .assign-card-header {
        color: #F1F5F9 !important;
        border-bottom-color: #242F4D !important;
    }

    [data-theme="dark"] .attendance-class-box,
    .light-mode-disabled .attendance-class-box {
        background: #1E293B !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .attendance-class-label,
    .light-mode-disabled .attendance-class-label {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .how-it-works-card,
    .light-mode-disabled .how-it-works-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        border-left-color: #10B981 !important;
    }

    [data-theme="dark"] .how-it-works-title,
    .light-mode-disabled .how-it-works-title {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .how-it-works-list,
    .light-mode-disabled .how-it-works-list {
        color: #94A3B8 !important;
    }
</style>
<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="assign-teacher-header">
                <div class="flex items-center justify-between">
                    <div class="">
                        <h2 class="assign-teacher-title"><%= editAssignment ? 'Edit Assignment' : 'Assign Teacher' %></h2>
                        <p class="assign-teacher-subtitle"><%= editAssignment ? 'Modify an existing class-subject allocation' : 'Allocate a teacher to a class and subject' %></p>
                    </div>
                    <button onclick="history.back()" class="btn">
                        <i class="fa-solid fa-arrow-left"></i> Back to Assignments
                    </button>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card p-6">
                <h3 class="assign-card-header font-bold text-sm text-slate-800 mb-5 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-person-chalkboard text-emerald-600"></i>
                    <%= editAssignment ? 'Update Assignment Details' : 'New Assignment Details' %>
                </h3>
                <form method="POST" action="<%= editAssignment ? '/schooladmin/teachers/assignments/' + editAssignment.id + '/edit' : '/schooladmin/teachers/assign' %>" class="space-y-5">
                    <div class="form-group">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">
                            Teacher <span class="text-rose-500">*</span>
                        </label>
                        <select name="teacher_id" required class="form-select">
                            <option value="">Select Teacher</option>
                            <% (teachers||[]).forEach(t=> { %>
                                <option value="<%= t.id %>" <%=(editAssignment && editAssignment.teacher_id==t.id) ? 'selected' : '' %>>
                                    <%= t.first_name %> <%= t.last_name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">
                            Class <span class="text-rose-500">*</span>
                        </label>
                        <select name="class_id" required class="form-select">
                            <option value="">Select Class</option>
                            <% (classes||[]).forEach(c=> { %>
                                <option value="<%= c.id %>" <%=(editAssignment &&
                                    editAssignment.class_id==c.id) ? 'selected' : '' %>>
                                    <%= c.name || c.class_label || ('Class ' + c.class_name + (c.stream && c.stream !== 'General' ? ' - ' + c.stream : '') + ' - ' + c.section) %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">
                            Subject <span class="text-slate-400 font-normal">(optional)</span>
                        </label>
                        <select name="subject_id" class="form-select">
                            <option value="">No specific subject (General assignment)</option>
                            <% (subjects||[]).forEach(s=> { %>
                                <option value="<%= s.id %>" <%=(editAssignment &&
                                    editAssignment.subject_id==s.id) ? 'selected' : '' %>>
                                    <%= s.subject_name %>
                                </option>
                            <% }) %>
                        </select>
                        <p class="text-[10px] text-slate-400 mt-1">Leave blank to assign teacher to the class without a specific subject role.</p>
                    </div>
                    <div class="attendance-class-box">
                        <input type="checkbox" name="is_primary" id="is_primary"  class="w-4 h-4 rounded border-gray-300 text-emerald-600" <%=(editAssignment && editAssignment.is_primary) ? 'checked' : '' %>>
                        <div>
                            <label for="is_primary" class="attendance-class-label text-xs font-bold text-slate-700 cursor-pointer">Set as Attendance Class / Class Teacher</label>
                            <p class="text-[10px] text-slate-400 mt-0.5">This class will be used for daily attendance and Teacher Dashboard My Class. Other lecture classes will not be counted as My Class.</p>
                        </div>
                    </div>
                    <div class="flex gap-3 pt-2 assign-action-row">
                        <button type="submit" class="btn btn-primary flex-1 text-sm font-bold shadow-sm">
                            <i class="fa-solid fa-<%= editAssignment ? 'floppy-disk' : 'plus' %> mr-2"></i>
                            <%= editAssignment ? 'Save Changes' : 'Create Assignment' %>
                        </button>
                        <a href="/schooladmin/teachers/assignments" class="btn btn-secondary text-sm font-bold">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
            <div class="card how-it-works-card p-4 mt-4">
                <h4 class="how-it-works-title text-xs font-bold text-slate-700 mb-1.5 flex items-center gap-1">
                    <i class="fa-solid fa-circle-info text-emerald-500"></i> How Assignments Work
                </h4>
                <ul class="how-it-works-list text-[11px] text-slate-500 space-y-1 list-disc list-inside">
                    <li>Each teacher-class-subject combination must be unique.</li>
                    <li>A teacher can be assigned to multiple classes and subjects.</li>
                    <li>Use <strong>Set as Attendance Class / Class Teacher</strong> for daily attendance and Teacher Dashboard My Class.</li>
                    <li>Assignments are used by the timetable and grading modules.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>