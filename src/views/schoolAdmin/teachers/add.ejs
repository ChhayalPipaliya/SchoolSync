<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <style>
                .add-teacher-header {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 16px;
                    margin-bottom: 24px;
                }

                .add-teacher-header-copy {
                    flex: 1 1 auto;
                    min-width: 0;
                }

                .add-teacher-header .btn {
                    flex: 0 0 auto;
                }

                .add-teacher-form,
                .add-teacher-form .grid,
                .add-teacher-form .form-group {
                    min-width: 0;
                }

                .add-teacher-form .form-input,
                .add-teacher-form .form-select,
                .add-teacher-form .form-textarea {
                    box-sizing: border-box;
                    width: 100%;
                    max-width: 100%;
                    min-width: 0;
                }

                .add-teacher-actions {
                    display: flex;
                    gap: 12px;
                }

                @media (max-width: 767px) {
                    .add-teacher-header {
                        flex-direction: column;
                        align-items: stretch;
                        gap: 14px;
                        margin-bottom: 20px;
                    }

                    .add-teacher-header h2 {
                        font-size: 22px;
                        line-height: 1.2;
                        margin: 0;
                    }

                    .add-teacher-header p {
                        max-width: 34rem;
                        line-height: 1.5;
                    }

                    .add-teacher-header .btn {
                        width: 100%;
                        min-height: 44px;
                        justify-content: center;
                    }

                    .add-teacher-form {
                        padding: 16px !important;
                        border-radius: 14px;
                    }

                    .add-teacher-form > div > h3 {
                        font-size: 12px;
                        line-height: 1.45;
                    }

                    .add-teacher-form .grid {
                        grid-template-columns: minmax(0, 1fr) !important;
                    }

                    .add-teacher-form .col-span-2 {
                        grid-column: 1 / -1 !important;
                    }

                    .add-teacher-form input[type="file"] {
                        overflow: hidden;
                        padding: 10px;
                        font-size: 12px;
                    }

                    .add-teacher-actions {
                        flex-direction: column;
                    }

                    .add-teacher-actions .btn {
                        width: 100%;
                        min-height: 44px;
                        justify-content: center;
                    }
                }

                @media (max-width: 380px) {
                    .add-teacher-header h2 {
                        font-size: 20px;
                    }

                    .add-teacher-form {
                        padding: 14px !important;
                    }
                }
            </style>
            <div class="add-teacher-header">
                <div class="add-teacher-header-copy">
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= lan.Add_New_Teacher %></h2>
                    <p class="text-xs text-gray-500 mt-1"><%= lan.Add_Teacher_Subtitle %></p>
                </div>
                <a href="/schooladmin/teachers" class="btn btn-secondary text-xs flex items-center gap-1">
                    <i class="fas fa-arrow-left"></i> <%= lan.Back_To_List %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <form method="POST" action="/schooladmin/teachers/add" enctype="multipart/form-data" class="add-teacher-form card p-6 md:p-8 space-y-6">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-user text-xs"></i> <%= lan.Personal_Information %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.First_Name %> <span class="text-rose-500">*</span></label>
                            <input type="text" name="first_name" required placeholder="<%= lan.First_Name %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Last_Name %></label>
                            <input type="text" name="last_name" placeholder="<%= lan.Last_Name %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Email %> <span class="text-rose-500">*</span></label>
                            <input type="email" name="email" required placeholder="teacher@school.com" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Phone %> <span class="text-rose-500">*</span></label>
                            <input type="tel" name="phone" required maxlength="10" placeholder="10-digit mobile number" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Password %> <span class="text-rose-500">*</span></label>
                            <input type="password" name="password" required placeholder="<%= lan.Password %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Gender %></label>
                            <select name="gender" class="form-select">
                                <option value="male"><%= lan.Male %></option>
                                <option value="female"><%= lan.Female %></option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Date_Of_Birth %></label>
                            <input type="date" name="dob" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Marital_Status %></label>
                            <select name="marital_status" class="form-select">
                                <option value="single"><%= lan.Single %></option>
                                <option value="married"><%= lan.Married %></option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Father_Name %></label>
                            <input type="text" name="father_name" placeholder="<%= lan.Father_Name %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Mother_Name %></label>
                            <input type="text" name="mother_name" placeholder="<%= lan.Mother_Name %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Emergency_Contact %></label>
                            <input type="tel" name="emergency_contact" placeholder="<%= lan.Emergency_Contact %>" class="form-input">
                        </div>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-graduation-cap text-xs"></i> <%= lan.Academic_Professional_Details %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Qualification %></label>
                            <input type="text" name="qualification" placeholder="B.Ed, M.Ed, Ph.D..." class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Experience_Years %></label>
                            <input type="number" name="experience_years" min="0" placeholder="<%= lan.Experience_Years %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Joining_Date %></label>
                            <input type="date" name="joining_date" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Salary_Monthly %></label>
                            <div style="position: relative;">
                                <span style="position: absolute; left: 12px; top: 10px; color: var(--text-muted); font-weight: bold;">₹</span>
                                <input type="number" name="salary" placeholder="<%= lan.Salary %>" class="form-input" style="padding-left: 28px;">
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-history text-xs"></i> <%= lan.Previous_Work_Experience %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Previous_School_Name %></label>
                            <input type="text" name="previous_school" placeholder="<%= lan.Previous_School_Name %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Previous_Joining_Date %></label>
                            <input type="date" name="prev_joining_date" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Total_Experience_Years %></label>
                            <input type="number" step="0.1" name="total_experience" placeholder="e.g. 3.5" class="form-input">
                        </div>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-heartbeat text-xs"></i> <%= lan.Medical_Details %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0 col-span-2">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Medical_Issues %></label>
                            <input type="text" name="medical_issues" placeholder="<%= lan.Medical_Issues %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Height_Cm %></label>
                            <input type="number" step="0.1" name="height" placeholder="<%= lan.Height_Cm %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Weight_Kg %></label>
                            <input type="number" step="0.1" name="weight" placeholder="<%= lan.Weight_Kg %>" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Blood_Group %></label>
                            <select name="blood_group" class="form-select">
                                <option value=""><%= lan.Select_Blood_Group %></option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-location-dot text-xs"></i> <%= lan.Contact_Address %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Current_Address %></label>
                            <textarea name="current_address" rows="2" placeholder="Street, City, Postal Code..." class="form-textarea"></textarea>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Permanent_Address %></label>
                            <textarea name="permanent_address" rows="2" placeholder="Street, City, Postal Code..." class="form-textarea"></textarea>
                        </div>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-paperclip text-xs"></i> <%= lan.Documents_And_Certificates %>
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Profile_Photo %></label>
                            <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Aadhaar_Card %></label>
                            <input type="file" name="aadhaar_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Qualification_Certificate %></label>
                            <input type="file" name="qualification_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Experience_Certificate %></label>
                            <input type="file" name="experience_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Joining_Letter %></label>
                            <input type="file" name="joining_letter" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Resume %></label>
                            <input type="file" name="resume" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.PAN_Card %></label>
                            <input type="file" name="pan_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2"><%= lan.Other_Document %></label>
                            <input type="file" name="other_document" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                    </div>
                </div>
                <div class="add-teacher-actions pt-4 border-t border-gray-100/70">
                    <button type="submit" class="btn btn-primary px-6 py-2.5">
                        <%= lan.Save_Teacher %>
                    </button>
                    <a href="/schooladmin/teachers" class="btn btn-secondary px-6 py-2.5 text-center">
                        <%= lan.Cancel %>
                    </a>
                </div>
            </form>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', () => {
                const fileInputs = form.querySelectorAll('input[type="file"][name="documents"]');
                fileInputs.forEach(fileInput => {
                    const container = fileInput.closest('.flex');
                    if (container) {
                        const select = container.querySelector('select[name="document_types"]');
                        const textInput = container.querySelector('input[name="document_names"]');
                        if (fileInput.files.length === 0) {
                            if (select) select.disabled = true;
                            if (textInput) textInput.disabled = true;
                        }
                    }
                });
            });
        }
    });
</script>