<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <style>
                .add-teacher-header {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 16px;
                    margin-bottom: 24px;
                }

                .add-teacher-header-copy {
                    flex: 1 1 auto;
                    min-width: 0;
                }

                .add-teacher-header .btn {
                    flex: 0 0 auto;
                }

                .add-teacher-form,
                .add-teacher-form .grid,
                .add-teacher-form .form-group {
                    min-width: 0;
                }

                .add-teacher-form .form-input,
                .add-teacher-form .form-select,
                .add-teacher-form .form-textarea {
                    box-sizing: border-box;
                    width: 100%;
                    max-width: 100%;
                    min-width: 0;
                }

                .add-teacher-actions {
                    display: flex;
                    gap: 12px;
                }

                @media (max-width: 767px) {
                    .add-teacher-header {
                        flex-direction: column;
                        align-items: stretch;
                        gap: 14px;
                        margin-bottom: 20px;
                    }

                    .add-teacher-header h2 {
                        font-size: 22px;
                        line-height: 1.2;
                        margin: 0;
                    }

                    .add-teacher-header p {
                        max-width: 34rem;
                        line-height: 1.5;
                    }

                    .add-teacher-header .btn {
                        width: 100%;
                        min-height: 44px;
                        justify-content: center;
                    }

                    .add-teacher-form {
                        padding: 16px !important;
                        border-radius: 14px;
                    }

                    .add-teacher-form > div > h3 {
                        font-size: 12px;
                        line-height: 1.45;
                    }

                    .add-teacher-form .grid {
                        grid-template-columns: minmax(0, 1fr) !important;
                    }

                    .add-teacher-form .col-span-2 {
                        grid-column: 1 / -1 !important;
                    }

                    .add-teacher-form input[type="file"] {
                        overflow: hidden;
                        padding: 10px;
                        font-size: 12px;
                    }

                    .add-teacher-actions {
                        flex-direction: column;
                    }

                    .add-teacher-actions .btn {
                        width: 100%;
                        min-height: 44px;
                        justify-content: center;
                    }
                }

                @media (max-width: 380px) {
                    .add-teacher-header h2 {
                        font-size: 20px;
                    }

                    .add-teacher-form {
                        padding: 14px !important;
                    }
                }
            </style>
            <!-- Top Header -->
            <div class="add-teacher-header">
                <div class="add-teacher-header-copy">
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Add New Teacher</h2>
                    <p class="text-xs text-gray-500 mt-1">Register a new teacher profile to assign classes and subjects</p>
                </div>
                <a href="/schooladmin/teachers" class="btn btn-secondary text-xs flex items-center gap-1">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Onboarding Form -->
            <form method="POST" action="/schooladmin/teachers/add" enctype="multipart/form-data" class="add-teacher-form card p-6 md:p-8 space-y-6">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                
                <!-- Personal Info Section -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-user text-xs"></i> Personal Information
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">First Name <span class="text-rose-500">*</span></label>
                            <input type="text" name="first_name" required placeholder="Enter first name" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Last Name</label>
                            <input type="text" name="last_name" placeholder="Enter last name" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Email <span class="text-rose-500">*</span></label>
                            <input type="email" name="email" required placeholder="teacher@school.com" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Phone <span class="text-rose-500">*</span></label>
                            <input type="tel" name="phone" required maxlength="10" placeholder="10-digit mobile number" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Password <span class="text-rose-500">*</span></label>
                            <input type="password" name="password" required placeholder="Create login password" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Gender</label>
                            <select name="gender" class="form-select">
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Date of Birth</label>
                            <input type="date" name="dob" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Marital Status</label>
                            <select name="marital_status" class="form-select">
                                <option value="single">Single</option>
                                <option value="married">Married</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Father Name</label>
                            <input type="text" name="father_name" placeholder="Father's name" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Mother Name</label>
                            <input type="text" name="mother_name" placeholder="Mother's name" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Emergency Contact</label>
                            <input type="tel" name="emergency_contact" placeholder="Emergency contact number" class="form-input">
                        </div>
                    </div>
                </div>

                <!-- Professional Details Section -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-graduation-cap text-xs"></i> Academic & Professional Details
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Qualification</label>
                            <input type="text" name="qualification" placeholder="B.Ed, M.Ed, Ph.D..." class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Experience (Years)</label>
                            <input type="number" name="experience_years" min="0" placeholder="Years of teaching" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Joining Date</label>
                            <input type="date" name="joining_date" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Salary (Monthly)</label>
                            <div style="position: relative;">
                                <span style="position: absolute; left: 12px; top: 10px; color: var(--text-muted); font-weight: bold;">₹</span>
                                <input type="number" name="salary" placeholder="Amount" class="form-input" style="padding-left: 28px;">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Previous Experience Section -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-history text-xs"></i> Previous Work Experience
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Previous School Name</label>
                            <input type="text" name="previous_school" placeholder="Name of previous school" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Previous Joining Date</label>
                            <input type="date" name="prev_joining_date" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Total Experience (Years)</label>
                            <input type="number" step="0.1" name="total_experience" placeholder="e.g. 3.5" class="form-input">
                        </div>
                    </div>
                </div>

                <!-- Medical Details Section -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-heartbeat text-xs"></i> Medical Details
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="form-group mb-0 col-span-2">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Medical Issues</label>
                            <input type="text" name="medical_issues" placeholder="Any medical issues or conditions" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Height (cm)</label>
                            <input type="number" step="0.1" name="height" placeholder="Height in cm" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Weight (kg)</label>
                            <input type="number" step="0.1" name="weight" placeholder="Weight in kg" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Blood Group</label>
                            <select name="blood_group" class="form-select">
                                <option value="">Select Blood Group</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Address Section -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-location-dot text-xs"></i> Contact Address
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Current Address</label>
                            <textarea name="current_address" rows="2" placeholder="Street, City, Postal Code..." class="form-textarea"></textarea>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Permanent Address</label>
                            <textarea name="permanent_address" rows="2" placeholder="Street, City, Postal Code..." class="form-textarea"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Media & Documents Section -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                        <i class="fa-solid fa-paperclip text-xs"></i> Media & Documents
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Profile Photo</label>
                            <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Aadhaar Card</label>
                            <input type="file" name="aadhaar_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Qualification Certificate</label>
                            <input type="file" name="qualification_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Experience Certificate</label>
                            <input type="file" name="experience_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Joining Letter</label>
                            <input type="file" name="joining_letter" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Resume</label>
                            <input type="file" name="resume" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">PAN Card</label>
                            <input type="file" name="pan_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Other Document</label>
                            <input type="file" name="other_document" accept=".pdf,.jpg,.jpeg,.png" class="form-input">
                        </div>
                    </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const form = document.querySelector('form');
                        if (form) {
                            form.addEventListener('submit', () => {
                                const fileInputs = form.querySelectorAll('input[type="file"][name="documents"]');
                                fileInputs.forEach(fileInput => {
                                    const container = fileInput.closest('.flex');
                                    if (container) {
                                        const select = container.querySelector('select[name="document_types"]');
                                        const textInput = container.querySelector('input[name="document_names"]');
                                        if (fileInput.files.length === 0) {
                                            if (select) select.disabled = true;
                                            if (textInput) textInput.disabled = true;
                                        }
                                    }
                                });
                            });
                        }
                    });
                </script>
                <!-- Action Buttons -->
                <div class="add-teacher-actions pt-4 border-t border-gray-100/70">
                    <button type="submit" class="btn btn-primary px-6 py-2.5">
                        Save Teacher
                    </button>
                    <a href="/schooladmin/teachers" class="btn btn-secondary px-6 py-2.5 text-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
