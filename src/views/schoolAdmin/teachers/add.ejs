<style>
    .teacher-form-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 12px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .teacher-form-section-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #059669;
        margin-bottom: 12px;
        padding-bottom: 6px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-group-compact {
        margin-bottom: 0;
    }

    .form-label-compact {
        font-size: 9px;
        font-weight: 700;
        color: #94A3B8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 4px;
    }

    .form-input-compact {
        width: 100%;
        height: 34px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 0 10px;
        font-size: 11px;
        background: #FFFFFF;
        color: #1E293B;
        outline: none;
        transition: border-color 0.15s;
    }

    .form-input-compact:focus {
        border-color: #059669;
    }

    .form-textarea-compact {
        width: 100%;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 11px;
        background: #FFFFFF;
        color: #1E293B;
        outline: none;
        resize: vertical;
        transition: border-color 0.15s;
    }

    .form-textarea-compact:focus {
        border-color: #059669;
    }

    [data-theme="dark"] .teacher-form-card,
    .light-mode-disabled .teacher-form-card {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .teacher-form-section-title,
    .light-mode-disabled .teacher-form-section-title {
        border-bottom-color: #242F4D !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .form-input-compact,
    [data-theme="dark"] .form-textarea-compact,
    .light-mode-disabled .form-input-compact,
    .light-mode-disabled .form-textarea-compact {
        background-color: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
</style>
<%- include('../../partials/head', { title: `${lan.Add_New_Teacher || 'Add New Teacher'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Add_New_Teacher || 'Add New Teacher' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Add_Teacher_Subtitle || 'Enter personal, professional, and contact details to register a teacher' %></p>
                        </div>
                    </div>
                    <a href="/schooladmin/teachers" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                        <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_List || 'Back to List' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <form method="POST" action="/schooladmin/teachers/add" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-user"></i> <%- lan.Personal_Information || 'Personal Information' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.First_Name || 'First Name' %> <span style="color: #E11D48;">*</span></label>
                            <input type="text" name="first_name" required placeholder="<%- lan.First_Name || 'First Name' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Last_Name || 'Last Name' %></label>
                            <input type="text" name="last_name" placeholder="<%- lan.Last_Name || 'Last Name' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Email || 'Email' %> <span style="color: #E11D48;">*</span></label>
                            <input type="email" name="email" required placeholder="teacher@school.com" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Phone || 'Phone' %> <span style="color: #E11D48;">*</span></label>
                            <input type="tel" name="phone" required maxlength="10" placeholder="10-digit mobile number" class="form-input-compact">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Password || 'Password' %> <span style="color: #E11D48;">*</span></label>
                            <input type="password" name="password" required placeholder="<%- lan.Password || 'Password' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Gender || 'Gender' %></label>
                            <select name="gender" class="form-input-compact">
                                <option value="male"><%- lan.Male || 'Male' %></option>
                                <option value="female"><%- lan.Female || 'Female' %></option>
                            </select>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Date_Of_Birth || 'Date of Birth' %></label>
                            <input type="date" name="dob" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Marital_Status || 'Marital Status' %></label>
                            <select name="marital_status" class="form-input-compact">
                                <option value="single"><%- lan.Single || 'Single' %></option>
                                <option value="married"><%- lan.Married || 'Married' %></option>
                            </select>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Father_Name || "Father's Name" %></label>
                            <input type="text" name="father_name" placeholder="<%- lan.Father_Name || "Father's Name" %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mother_Name || "Mother's Name" %></label>
                            <input type="text" name="mother_name" placeholder="<%- lan.Mother_Name || "Mother's Name" %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Emergency_Contact || 'Emergency Contact' %></label>
                            <input type="tel" name="emergency_contact" placeholder="<%- lan.Emergency_Contact || 'Emergency Phone' %>" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-graduation-cap"></i> <%- lan.Academic_Professional_Details || 'Academic & Professional Details' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Qualification || 'Qualification' %></label>
                            <input type="text" name="qualification" placeholder="B.Ed, M.Ed, Ph.D..." class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Experience_Years || 'Experience (Years)' %></label>
                            <input type="number" name="experience_years" min="0" placeholder="<%- lan.Experience_Years || 'Years' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Joining_Date || 'Joining Date' %></label>
                            <input type="date" name="joining_date" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Salary_Monthly || 'Salary (Monthly)' %></label>
                            <div style="position: relative;">
                                <span style="position: absolute; left: 10px; top: 8px; color: #94A3B8; font-weight: 700; font-size: 11px;">₹</span>
                                <input type="number" name="salary" placeholder="<%- lan.Salary || 'Salary' %>" class="form-input-compact" style="padding-left: 24px;">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-clock-rotate-left"></i> <%- lan.Previous_Work_Experience || 'Previous Work Experience' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Previous_School_Name || 'Previous School Name' %></label>
                            <input type="text" name="previous_school" placeholder="<%- lan.Previous_School_Name || 'Previous School Name' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Previous_Joining_Date || 'Previous Joining Date' %></label>
                            <input type="date" name="prev_joining_date" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Total_Experience_Years || 'Total Experience (Years)' %></label>
                            <input type="number" step="0.1" name="total_experience" placeholder="e.g. 3.5" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-heart-pulse"></i> <%- lan.Medical_Details || 'Medical Details' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px;">
                        <div class="form-group-compact" style="grid-column: 1 / -1;">
                            <label class="form-label-compact"><%- lan.Medical_Issues || 'Medical Issues' %></label>
                            <input type="text" name="medical_issues" placeholder="<%- lan.Medical_Issues || 'Any known medical conditions...' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Height_Cm || 'Height (cm)' %></label>
                            <input type="number" step="0.1" name="height" placeholder="<%- lan.Height_Cm || 'Height in cm' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Weight_Kg || 'Weight (kg)' %></label>
                            <input type="number" step="0.1" name="weight" placeholder="<%- lan.Weight_Kg || 'Weight in kg' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Blood_Group || 'Blood Group' %></label>
                            <select name="blood_group" class="form-input-compact">
                                <option value=""><%- lan.Select_Blood_Group || 'Select Blood Group' %></option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-location-dot"></i> <%- lan.Contact_Address || 'Contact & Address' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Current_Address || 'Current Address' %></label>
                            <textarea name="current_address" rows="2" placeholder="Street, City, Postal Code..." class="form-textarea-compact"></textarea>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Permanent_Address || 'Permanent Address' %></label>
                            <textarea name="permanent_address" rows="2" placeholder="Street, City, Postal Code..." class="form-textarea-compact"></textarea>
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-file-arrow-up"></i> <%- lan.Documents_And_Certificates || 'Documents & Certificates' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Profile_Photo || 'Profile Photo' %></label>
                            <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Aadhaar_Card || 'Aadhaar Card' %></label>
                            <input type="file" name="aadhaar_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Qualification_Certificate || 'Qualification Certificate' %></label>
                            <input type="file" name="qualification_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Experience_Certificate || 'Experience Certificate' %></label>
                            <input type="file" name="experience_certificate" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Joining_Letter || 'Joining Letter' %></label>
                            <input type="file" name="joining_letter" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Resume || 'Resume / CV' %></label>
                            <input type="file" name="resume" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.PAN_Card || 'PAN Card' %></label>
                            <input type="file" name="pan_card" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Other_Document || 'Other Document' %></label>
                            <input type="file" name="other_document" accept=".pdf,.jpg,.jpeg,.png" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div style="display: flex; gap: 8px; margin-top: 14px; margin-bottom: 20px;">
                    <button type="submit" class="btn" style="background: #059669; color: #fff; height: 38px; padding: 0 20px; font-size: 12px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; border: none; cursor: pointer; box-shadow: 0 2px 6px rgba(5,150,105,0.2);">
                        <i class="fa-solid fa-floppy-disk"></i> <%- lan.Save_Teacher || 'Save Teacher' %>
                    </button>
                    <a href="/schooladmin/teachers" class="btn" style="background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1; height: 38px; padding: 0 16px; font-size: 12px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; text-decoration: none;">
                        <%- lan.Cancel || 'Cancel' %>
                    </a>
                </div>
            </form>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>