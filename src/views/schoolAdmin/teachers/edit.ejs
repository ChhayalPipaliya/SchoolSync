<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <style>
                @media (max-width: 640px) {
                    .document-upload-row {
                        flex-direction: column !important;
                        align-items: stretch !important;
                        gap: 8px !important;
                    }
                    .document-upload-row > input[type="file"],
                    .document-upload-row > select,
                    .document-upload-row > input[type="text"] {
                        width: 100% !important;
                    }
                }
            </style>
                <!-- Top Header -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Edit Teacher Details</h2>
                        <p class="text-xs text-gray-500 mt-1">Update profile, contact, and professional records for <%= teacher.first_name %> <%= teacher.last_name %></p>
                    </div>
                    <a href="/schooladmin/teachers/<%= teacher.id %>" class="btn btn-secondary text-xs flex items-center justify-center gap-1 w-full sm:w-auto">
                        <i class="fas fa-arrow-left"></i> Back to Profile
                    </a>
                </div>

                <%- include('../../partials/flashMessages') %>

                <!-- Edit Form -->
                <form method="POST" action="/schooladmin/teachers/<%= teacher.id %>/edit" enctype="multipart/form-data" class="card p-6 md:p-8 space-y-6">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    
                    <!-- Personal Info Section -->
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                            <i class="fa-solid fa-user text-xs"></i> Personal Information
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">First Name <span class="text-rose-500">*</span></label>
                                <input type="text" name="first_name" value="<%= teacher.first_name %>" required class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Last Name</label>
                                <input type="text" name="last_name" value="<%= teacher.last_name || '' %>" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Email <span class="text-rose-500">*</span></label>
                                <input type="email" name="email" value="<%= teacher.email || '' %>" required class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Phone</label>
                                <input type="tel" name="phone" value="<%= teacher.phone || '' %>" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Gender</label>
                                <select name="gender" class="form-select">
                                    <option value="male" <%= teacher.gender === 'male' ? 'selected' : '' %>>Male</option>
                                    <option value="female" <%= teacher.gender === 'female' ? 'selected' : '' %>>Female</option>
                                </select>
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Date of Birth</label>
                                <input type="date" name="dob" value="<%= teacher.dob ? new Date(teacher.dob).toISOString().split('T')[0] : '' %>" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Marital Status</label>
                                <select name="marital_status" class="form-select">
                                    <option value="single" <%= teacher.marital_status === 'single' ? 'selected' : '' %>>Single</option>
                                    <option value="married" <%= teacher.marital_status === 'married' ? 'selected' : '' %>>Married</option>
                                </select>
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Father Name</label>
                                <input type="text" name="father_name" value="<%= teacher.father_name || '' %>" placeholder="Father's name" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Mother Name</label>
                                <input type="text" name="mother_name" value="<%= teacher.mother_name || '' %>" placeholder="Mother's name" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Emergency Contact</label>
                                <input type="tel" name="emergency_contact" value="<%= teacher.emergency_contact || '' %>" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Status</label>
                                <select name="status" class="form-select">
                                    <option value="active" <%= teacher.status === 'active' ? 'selected' : '' %>>Active</option>
                                    <option value="inactive" <%= teacher.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Professional Details Section -->
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                            <i class="fa-solid fa-graduation-cap text-xs"></i> Academic & Professional Details
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Qualification</label>
                                <input type="text" name="qualification" value="<%= teacher.qualification || '' %>" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Experience (Years)</label>
                                <input type="number" name="experience_years" value="<%= teacher.experience_years || 0 %>" min="0" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Joining Date</label>
                                <input type="date" name="joining_date" value="<%= teacher.joining_date ? new Date(teacher.joining_date).toISOString().split('T')[0] : '' %>" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Salary (Monthly)</label>
                                <div style="position: relative;">
                                    <span style="position: absolute; left: 12px; top: 10px; color: var(--text-muted); font-weight: bold;">₹</span>
                                    <input type="number" name="salary" value="<%= teacher.salary || 0 %>" class="form-input" style="padding-left: 28px;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Previous Experience Section -->
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                            <i class="fa-solid fa-history text-xs"></i> Previous Work Experience
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Previous School Name</label>
                                <input type="text" name="previous_school" value="<%= typeof experience !== 'undefined' && experience.previous_school ? experience.previous_school : '' %>" placeholder="Name of previous school" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Previous Joining Date</label>
                                <input type="date" name="prev_joining_date" value="<%= typeof experience !== 'undefined' && experience.joining_date ? new Date(experience.joining_date).toISOString().split('T')[0] : '' %>" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Total Experience (Years)</label>
                                <input type="number" step="0.1" name="total_experience" value="<%= typeof experience !== 'undefined' && experience.total_experience ? experience.total_experience : '' %>" placeholder="e.g. 3.5" class="form-input">
                            </div>
                        </div>
                    </div>

                    <!-- Medical Details Section -->
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                            <i class="fa-solid fa-heartbeat text-xs"></i> Medical Details
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div class="form-group mb-0 col-span-2">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Medical Issues</label>
                                <input type="text" name="medical_issues" value="<%= typeof medical !== 'undefined' && medical.medical_issues ? medical.medical_issues : '' %>" placeholder="Any medical issues or conditions" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Height (cm)</label>
                                <input type="number" step="0.1" name="height" value="<%= typeof medical !== 'undefined' && medical.height ? medical.height : '' %>" placeholder="Height in cm" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Weight (kg)</label>
                                <input type="number" step="0.1" name="weight" value="<%= typeof medical !== 'undefined' && medical.weight ? medical.weight : '' %>" placeholder="Weight in kg" class="form-input">
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Blood Group</label>
                                <select name="blood_group" class="form-select">
                                    <option value="">Select Blood Group</option>
                                    <% const bg = typeof medical !== 'undefined' && medical.blood_group ? medical.blood_group : '' %>
                                    <option value="A+" <%= bg === 'A+' ? 'selected' : '' %>>A+</option>
                                    <option value="A-" <%= bg === 'A-' ? 'selected' : '' %>>A-</option>
                                    <option value="B+" <%= bg === 'B+' ? 'selected' : '' %>>B+</option>
                                    <option value="B-" <%= bg === 'B-' ? 'selected' : '' %>>B-</option>
                                    <option value="O+" <%= bg === 'O+' ? 'selected' : '' %>>O+</option>
                                    <option value="O-" <%= bg === 'O-' ? 'selected' : '' %>>O-</option>
                                    <option value="AB+" <%= bg === 'AB+' ? 'selected' : '' %>>AB+</option>
                                    <option value="AB-" <%= bg === 'AB-' ? 'selected' : '' %>>AB-</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Address Section -->
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                            <i class="fa-solid fa-location-dot text-xs"></i> Contact Address
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Current Address</label>
                                <textarea name="current_address" rows="2" placeholder="Street, City, Postal Code..." class="form-textarea"><%= teacher.current_address || teacher.address || '' %></textarea>
                            </div>
                            <div class="form-group mb-0">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Permanent Address</label>
                                <textarea name="permanent_address" rows="2" placeholder="Street, City, Postal Code..." class="form-textarea"><%= teacher.permanent_address || teacher.address || '' %></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Media & Documents Section -->
                    <div>
                        <h3 class="text-sm font-bold uppercase tracking-wide mb-4 pb-2 border-b border-gray-50 flex items-center gap-2" style="color: var(--primary);">
                            <i class="fa-solid fa-paperclip text-xs"></i> Onboarding Documents
                        </h3>
                        
                        <!-- Existing Documents -->
                        <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
                            <div class="mb-6">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Existing Documents</label>
                                <div class="flex flex-wrap gap-3">
                                    <% documents.forEach(d => { %>
                                        <div class="flex items-center gap-2 px-3 py-2 bg-slate-50 border border-slate-100 rounded-lg text-xs font-semibold text-slate-700">
                                            <i class="fas fa-file-pdf text-rose-500"></i>
                                            <span><%= d.document_name %> (<%= d.document_type %>)</span>
                                            <a href="/uploads/teachers/<%= d.file_path %>" target="_blank" class="text-blue-500 hover:text-blue-700 ml-1">
                                                <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                                            </a>
                                            <button type="button" onclick="deleteDoc(<%= d.id %>)" class="text-rose-500 hover:text-rose-700 bg-none border-none p-0 cursor-pointer ml-2">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="form-group mb-0 col-span-1">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Profile Photo</label>
                                <div class="flex items-center gap-5">
                                    <% 
                                    let profileImg = null;
                                    const rawImg = teacher.photo || teacher.image;
                                    if (rawImg) {
                                        try {
                                            const imgs = JSON.parse(rawImg);
                                            if (Array.isArray(imgs) && imgs.length) {
                                                profileImg = imgs[0].startsWith('/uploads/') ? imgs[0] : '/uploads/teachers/' + imgs[0].replace(/^\/+/,'');
                                            } else if (typeof imgs === 'string') {
                                                profileImg = imgs.startsWith('/uploads/') ? imgs : '/uploads/teachers/' + imgs.replace(/^\/+/,'');
                                            }
                                        } catch (e) {
                                            profileImg = rawImg.startsWith('/') ? rawImg : '/uploads/teachers/' + rawImg.replace(/^\/+/,'');
                                        }
                                    }
                                    %>
                                    <% if (profileImg) { %>
                                        <img src="<%= profileImg %>" class="w-16 h-16 rounded-full bg-gray-50 border border-slate-100 object-cover flex-shrink-0" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover;">
                                    <% } else { %>
                                        <div class="w-16 h-16 rounded-full flex items-center justify-center font-bold text-lg flex-shrink-0" style="width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background-color: var(--primary-light); color: var(--primary); font-weight: bold; border: 1px solid rgba(5, 150, 105, 0.1); flex-shrink: 0;">
                                            <%= (teacher.first_name || '?').charAt(0).toUpperCase() %>
                                        </div>
                                    <% } %>
                                    <div class="flex-1">
                                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-1">Upload New Photo</label>
                                        <input type="file" name="photo" accept="image/*" class="form-input text-xs">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group mb-0 col-span-2">
                                <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Upload New Documents</label>
                                <div class="space-y-3">
                                    <div class="flex items-center gap-3 document-upload-row">
                                        <input type="file" name="documents" class="form-input text-xs" style="width:35%">
                                        <select name="document_types" class="form-select text-xs" style="width:30%">
                                            <option value="aadhaar_card">Aadhaar Card</option>
                                            <option value="experience_certificate">Experience Certificate</option>
                                            <option value="qualification_certificate">Qualification Certificate</option>
                                            <option value="joining_letter">Joining Letter</option>
                                            <option value="resume">Resume</option>
                                            <option value="pan_card">PAN Card</option>
                                            <option value="other">Other</option>
                                        </select>
                                        <input type="text" name="document_names" placeholder="Document Name" class="form-input text-xs" style="width:35%">
                                    </div>
                                    <div class="flex items-center gap-3 document-upload-row">
                                        <input type="file" name="documents" class="form-input text-xs" style="width:35%">
                                        <select name="document_types" class="form-select text-xs" style="width:30%">
                                            <option value="experience_certificate">Experience Certificate</option>
                                            <option value="aadhaar_card">Aadhaar Card</option>
                                            <option value="qualification_certificate">Qualification Certificate</option>
                                            <option value="joining_letter">Joining Letter</option>
                                            <option value="resume">Resume</option>
                                            <option value="pan_card">PAN Card</option>
                                            <option value="other">Other</option>
                                        </select>
                                        <input type="text" name="document_names" placeholder="Document Name" class="form-input text-xs" style="width:35%">
                                    </div>
                                    <div class="flex items-center gap-3 document-upload-row">
                                        <input type="file" name="documents" class="form-input text-xs" style="width:35%">
                                        <select name="document_types" class="form-select text-xs" style="width:30%">
                                            <option value="qualification_certificate">Qualification Certificate</option>
                                            <option value="aadhaar_card">Aadhaar Card</option>
                                            <option value="experience_certificate">Experience Certificate</option>
                                            <option value="joining_letter">Joining Letter</option>
                                            <option value="resume">Resume</option>
                                            <option value="pan_card">PAN Card</option>
                                            <option value="other">Other</option>
                                        </select>
                                        <input type="text" name="document_names" placeholder="Document Name" class="form-input text-xs" style="width:35%">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const form = document.querySelector('form');
                            if (form) {
                                form.addEventListener('submit', () => {
                                    const fileInputs = form.querySelectorAll('input[type="file"][name="documents"]');
                                    fileInputs.forEach(fileInput => {
                                        const container = fileInput.closest('.flex');
                                        if (container) {
                                            const select = container.querySelector('select[name="document_types"]');
                                            const textInput = container.querySelector('input[name="document_names"]');
                                            if (fileInput.files.length === 0) {
                                                if (select) select.disabled = true;
                                                if (textInput) textInput.disabled = true;
                                            }
                                        }
                                    });
                                });
                            }
                        });
                    </script>
                    <!-- Action Buttons -->
                    <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100/70">
                        <button type="submit" class="btn btn-primary px-6 py-2.5 w-full sm:w-auto justify-center">
                            Update Teacher
                        </button>
                        <a href="/schooladmin/teachers/<%= teacher.id %>" class="btn btn-secondary px-6 py-2.5 text-center w-full sm:w-auto justify-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>

<form id="delete-doc-form" method="POST" style="display:none;">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</form>
<script>
    function deleteDoc(docId) {
        if (confirm('Are you sure you want to delete this document?')) {
            const form = document.getElementById('delete-doc-form');
            form.action = '/schooladmin/teachers/delete-document/' + docId;
            form.submit();
        }
    }
</script>
