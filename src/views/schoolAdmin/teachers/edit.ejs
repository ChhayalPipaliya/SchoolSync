<style>
    .teacher-form-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 12px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .teacher-form-section-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #059669;
        margin-bottom: 12px;
        padding-bottom: 6px;
        border-bottom: 1px solid #F1F5F9;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-group-compact {
        margin-bottom: 0;
    }

    .form-label-compact {
        font-size: 9px;
        font-weight: 700;
        color: #94A3B8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 4px;
    }

    .form-input-compact {
        width: 100%;
        height: 34px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 0 10px;
        font-size: 11px;
        background: #FFFFFF;
        color: #1E293B;
        outline: none;
        transition: border-color 0.15s;
    }

    .form-input-compact:focus {
        border-color: #059669;
    }

    .form-textarea-compact {
        width: 100%;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 11px;
        background: #FFFFFF;
        color: #1E293B;
        outline: none;
        resize: vertical;
        transition: border-color 0.15s;
    }

    .form-textarea-compact:focus {
        border-color: #059669;
    }

    .document-upload-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
        align-items: center;
    }

    @media (max-width: 640px) {
        .document-upload-row {
            grid-template-columns: 1fr;
            gap: 6px;
        }
    }

    [data-theme="dark"] .teacher-form-card,
    .light-mode-disabled .teacher-form-card {
        background-color: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .teacher-form-section-title,
    .light-mode-disabled .teacher-form-section-title {
        border-bottom-color: #242F4D !important;
        color: #34D399 !important;
    }

    [data-theme="dark"] .form-input-compact,
    [data-theme="dark"] .form-textarea-compact,
    .light-mode-disabled .form-input-compact,
    .light-mode-disabled .form-textarea-compact {
        background-color: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
</style>
<%- include('../../partials/head', { title: `${lan.Edit_Teacher_Details || 'Edit Teacher Details'} | SchoolSync` }) %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding: 14px 20px;">
            <div class="card" style="background: linear-gradient(135deg, #059669 0%, #0d9488 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(5, 150, 105, 0.16);">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                            <i class="fa-solid fa-user-pen"></i>
                        </div>
                        <div>
                            <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Edit_Teacher_Details || 'Edit Teacher Details' %></h1>
                            <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Edit_Teacher_Subtitle || 'Update profile, contact, and professional records for' %> <%= teacher.first_name %> <%= teacher.last_name %></p>
                        </div>
                    </div>
                    <a href="/schooladmin/teachers/<%= teacher.id %>" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); font-weight: 700; padding: 7px 12px; font-size: 11px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                        <i class="fa-solid fa-arrow-left"></i> <%- lan.Back_To_Profile || 'Back to Profile' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <form method="POST" action="/schooladmin/teachers/<%= teacher.id %>/edit" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-user"></i> <%- lan.Personal_Information || 'Personal Information' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.First_Name || 'First Name' %> <span style="color: #E11D48;">*</span></label>
                            <input type="text" name="first_name" value="<%= teacher.first_name %>" required class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Last_Name || 'Last Name' %></label>
                            <input type="text" name="last_name" value="<%= teacher.last_name || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Email || 'Email' %> <span style="color: #E11D48;">*</span></label>
                            <input type="email" name="email" value="<%= teacher.email || '' %>" required class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Phone || 'Phone' %></label>
                            <input type="tel" name="phone" value="<%= teacher.phone || '' %>" class="form-input-compact">
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Gender || 'Gender' %></label>
                            <select name="gender" class="form-input-compact">
                                <option value="male" <%= teacher.gender === 'male' ? 'selected' : '' %>><%- lan.Male || 'Male' %></option>
                                <option value="female" <%= teacher.gender === 'female' ? 'selected' : '' %>><%- lan.Female || 'Female' %></option>
                            </select>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Date_Of_Birth || 'Date of Birth' %></label>
                            <input type="date" name="dob" value="<%= teacher.dob ? new Date(teacher.dob).toISOString().split('T')[0] : '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Marital_Status || 'Marital Status' %></label>
                            <select name="marital_status" class="form-input-compact">
                                <option value="single" <%= teacher.marital_status === 'single' ? 'selected' : '' %>><%- lan.Single || 'Single' %></option>
                                <option value="married" <%= teacher.marital_status === 'married' ? 'selected' : '' %>><%- lan.Married || 'Married' %></option>
                            </select>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Status || 'Status' %></label>
                            <select name="status" class="form-input-compact">
                                <option value="active" <%= teacher.status === 'active' ? 'selected' : '' %>><%- lan.Active || 'Active' %></option>
                                <option value="inactive" <%= teacher.status === 'inactive' ? 'selected' : '' %>><%- lan.Inactive || 'Inactive' %></option>
                            </select>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Father_Name || "Father's Name" %></label>
                            <input type="text" name="father_name" value="<%= teacher.father_name || '' %>" placeholder="<%- lan.Father_Name || "Father's Name" %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Mother_Name || "Mother's Name" %></label>
                            <input type="text" name="mother_name" value="<%= teacher.mother_name || '' %>" placeholder="<%- lan.Mother_Name || "Mother's Name" %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Emergency_Contact || 'Emergency Contact' %></label>
                            <input type="tel" name="emergency_contact" value="<%= teacher.emergency_contact || '' %>" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-graduation-cap"></i> <%- lan.Academic_Professional_Details || 'Academic & Professional Details' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Qualification || 'Qualification' %></label>
                            <input type="text" name="qualification" value="<%= teacher.qualification || '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Experience_Years || 'Experience (Years)' %></label>
                            <input type="number" name="experience_years" value="<%= teacher.experience_years || 0 %>" min="0" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Joining_Date || 'Joining Date' %></label>
                            <input type="date" name="joining_date" value="<%= teacher.joining_date ? new Date(teacher.joining_date).toISOString().split('T')[0] : '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Salary_Monthly || 'Salary (Monthly)' %></label>
                            <div style="position: relative;">
                                <span style="position: absolute; left: 10px; top: 8px; color: #94A3B8; font-weight: 700; font-size: 11px;">₹</span>
                                <input type="number" name="salary" value="<%= teacher.salary || 0 %>" class="form-input-compact" style="padding-left: 24px;">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-clock-rotate-left"></i> <%- lan.Previous_Work_Experience || 'Previous Work Experience' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Previous_School_Name || 'Previous School Name' %></label>
                            <input type="text" name="previous_school" value="<%= typeof experience !== 'undefined' && experience.previous_school ? experience.previous_school : '' %>" placeholder="<%- lan.Previous_School_Name || 'Previous School Name' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Previous_Joining_Date || 'Previous Joining Date' %></label>
                            <input type="date" name="prev_joining_date" value="<%= typeof experience !== 'undefined' && experience.joining_date ? new Date(experience.joining_date).toISOString().split('T')[0] : '' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Total_Experience_Years || 'Total Experience (Years)' %></label>
                            <input type="number" step="0.1" name="total_experience" value="<%= typeof experience !== 'undefined' && experience.total_experience ? experience.total_experience : '' %>" placeholder="e.g. 3.5" class="form-input-compact">
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-heart-pulse"></i> <%- lan.Medical_Details || 'Medical Details' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px;">
                        <div class="form-group-compact" style="grid-column: 1 / -1;">
                            <label class="form-label-compact"><%- lan.Medical_Issues || 'Medical Issues' %></label>
                            <input type="text" name="medical_issues" value="<%= typeof medical !== 'undefined' && medical.medical_issues ? medical.medical_issues : '' %>" placeholder="<%- lan.Medical_Issues || 'Any known medical conditions...' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Height_Cm || 'Height (cm)' %></label>
                            <input type="number" step="0.1" name="height" value="<%= typeof medical !== 'undefined' && medical.height ? medical.height : '' %>" placeholder="<%- lan.Height_Cm || 'Height in cm' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Weight_Kg || 'Weight (kg)' %></label>
                            <input type="number" step="0.1" name="weight" value="<%= typeof medical !== 'undefined' && medical.weight ? medical.weight : '' %>" placeholder="<%- lan.Weight_Kg || 'Weight in kg' %>" class="form-input-compact">
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Blood_Group || 'Blood Group' %></label>
                            <% const bg = typeof medical !== 'undefined' && medical.blood_group ? medical.blood_group : '' %>
                            <select name="blood_group" class="form-input-compact">
                                <option value=""><%- lan.Select_Blood_Group || 'Select Blood Group' %></option>
                                <option value="A+" <%= bg === 'A+' ? 'selected' : '' %>>A+</option>
                                <option value="A-" <%= bg === 'A-' ? 'selected' : '' %>>A-</option>
                                <option value="B+" <%= bg === 'B+' ? 'selected' : '' %>>B+</option>
                                <option value="B-" <%= bg === 'B-' ? 'selected' : '' %>>B-</option>
                                <option value="O+" <%= bg === 'O+' ? 'selected' : '' %>>O+</option>
                                <option value="O-" <%= bg === 'O-' ? 'selected' : '' %>>O-</option>
                                <option value="AB+" <%= bg === 'AB+' ? 'selected' : '' %>>AB+</option>
                                <option value="AB-" <%= bg === 'AB-' ? 'selected' : '' %>>AB-</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-location-dot"></i> <%- lan.Contact_Address || 'Contact & Address' %>
                    </h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Current_Address || 'Current Address' %></label>
                            <textarea name="current_address" rows="2" placeholder="<%- lan.Address_Placeholder || 'Street, City, Postal Code...' %>" class="form-textarea-compact"><%= teacher.current_address || teacher.address || '' %></textarea>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Permanent_Address || 'Permanent Address' %></label>
                            <textarea name="permanent_address" rows="2" placeholder="<%- lan.Address_Placeholder || 'Street, City, Postal Code...' %>" class="form-textarea-compact"><%= teacher.permanent_address || teacher.address || '' %></textarea>
                        </div>
                    </div>
                </div>
                <div class="teacher-form-card">
                    <h3 class="teacher-form-section-title">
                        <i class="fa-solid fa-file-arrow-up"></i> <%- lan.Onboarding_Documents || 'Onboarding Documents' %>
                    </h3>
                    <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
                        <div style="margin-bottom: 12px;">
                            <label class="form-label-compact"><%- lan.Existing_Documents || 'Existing Documents' %></label>
                            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                <% documents.forEach(d => { %>
                                    <div style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 6px; font-size: 11px; font-weight: 600; color: #334155;">
                                        <i class="fas fa-file-pdf" style="color: #E11D48;"></i>
                                        <span><%= d.document_name %> (<%= d.document_type %>)</span>
                                        <a href="/uploads/teachers/<%= d.file_path %>" target="_blank" style="color: #0284C7; text-decoration: none;">
                                            <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 9px;"></i>
                                        </a>
                                        <button type="button" onclick="deleteDoc('<%= d.id %>')" style="color: #E11D48; background: none; border: none; padding: 0; cursor: pointer; margin-left: 4px;">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Profile_Photo || 'Profile Photo' %></label>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <% 
                                let profileImg = null;
                                const rawImg = teacher.photo || teacher.image;
                                if (rawImg) {
                                    try {
                                        const imgs = JSON.parse(rawImg);
                                        if (Array.isArray(imgs) && imgs.length) {
                                            profileImg = imgs[0].startsWith('/uploads/') ? imgs[0] : '/uploads/teachers/' + imgs[0].replace(/^\/+/,'');
                                        } else if (typeof imgs === 'string') {
                                            profileImg = imgs.startsWith('/uploads/') ? imgs : '/uploads/teachers/' + imgs.replace(/^\/+/,'');
                                        }
                                    } catch (e) {
                                        profileImg = rawImg.startsWith('/') ? rawImg : '/uploads/teachers/' + rawImg.replace(/^\/+/,'');
                                    }
                                }
                                %>
                                <% if (profileImg) { %>
                                    <img src="<%= profileImg %>" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 1px solid #E2E8F0; flex-shrink: 0;">
                                <% } else { %>
                                    <div style="width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #ECFDF5; color: #059669; font-weight: 800; font-size: 16px; border: 1px solid rgba(5, 150, 105, 0.2); flex-shrink: 0;">
                                        <%= (teacher.first_name || '?').charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                                <div style="flex: 1;">
                                    <input type="file" name="photo" accept="image/*" class="form-input-compact" style="padding-top: 5px;">
                                </div>
                            </div>
                        </div>
                        <div class="form-group-compact">
                            <label class="form-label-compact"><%- lan.Upload_New_Documents || 'Upload New Documents' %></label>
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <div class="document-upload-row">
                                    <input type="file" name="documents" class="form-input-compact" style="padding-top: 5px;">
                                    <select name="document_types" class="form-input-compact">
                                        <option value="aadhaar_card"><%- lan.Aadhaar_Card || 'Aadhaar Card' %></option>
                                        <option value="experience_certificate"><%- lan.Experience_Certificate || 'Experience Certificate' %></option>
                                        <option value="qualification_certificate"><%- lan.Qualification_Certificate || 'Qualification Certificate' %></option>
                                        <option value="joining_letter"><%- lan.Joining_Letter || 'Joining Letter' %></option>
                                        <option value="resume"><%- lan.Resume || 'Resume' %></option>
                                        <option value="pan_card"><%- lan.PAN_Card || 'PAN Card' %></option>
                                        <option value="other"><%- lan.Other_Document || 'Other' %></option>
                                    </select>
                                    <input type="text" name="document_names" placeholder="<%- lan.Document_Name || 'Document Name' %>" class="form-input-compact">
                                </div>
                                <div class="document-upload-row">
                                    <input type="file" name="documents" class="form-input-compact" style="padding-top: 5px;">
                                    <select name="document_types" class="form-input-compact">
                                        <option value="experience_certificate"><%- lan.Experience_Certificate || 'Experience Certificate' %></option>
                                        <option value="aadhaar_card"><%- lan.Aadhaar_Card || 'Aadhaar Card' %></option>
                                        <option value="qualification_certificate"><%- lan.Qualification_Certificate || 'Qualification Certificate' %></option>
                                        <option value="joining_letter"><%- lan.Joining_Letter || 'Joining Letter' %></option>
                                        <option value="resume"><%- lan.Resume || 'Resume' %></option>
                                        <option value="pan_card"><%- lan.PAN_Card || 'PAN Card' %></option>
                                        <option value="other"><%- lan.Other_Document || 'Other' %></option>
                                    </select>
                                    <input type="text" name="document_names" placeholder="<%- lan.Document_Name || 'Document Name' %>" class="form-input-compact">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div style="display: flex; gap: 8px; margin-top: 14px; margin-bottom: 20px;">
                    <button type="submit" class="btn" style="background: #059669; color: #fff; height: 38px; padding: 0 20px; font-size: 12px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; border: none; cursor: pointer; box-shadow: 0 2px 6px rgba(5,150,105,0.2);">
                        <i class="fa-solid fa-floppy-disk"></i> <%- lan.Update_Teacher || 'Update Teacher' %>
                    </button>
                    <a href="/schooladmin/teachers/<%= teacher.id %>" class="btn" style="background: #F1F5F9; color: #475569; border: 1px solid #CBD5E1; height: 38px; padding: 0 16px; font-size: 12px; font-weight: 700; border-radius: 8px; display: inline-flex; align-items: center; text-decoration: none;">
                        <%- lan.Cancel || 'Cancel' %>
                    </a>
                </div>
            </form>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>
<form id="delete-doc-form" method="POST" style="display:none;">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</form>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', () => {
                const fileInputs = form.querySelectorAll('input[type="file"][name="documents"]');
                fileInputs.forEach(fileInput => {
                    const container = fileInput.closest('.document-upload-row');
                    if (container) {
                        const select = container.querySelector('select[name="document_types"]');
                        const textInput = container.querySelector('input[name="document_names"]');
                        if (fileInput.files.length === 0) {
                            if (select) select.disabled = true;
                            if (textInput) textInput.disabled = true;
                        }
                    }
                });
            });
        }
    });

    function deleteDoc(docId) {
        if (confirm('<%- lan.Delete_Document_Confirm || "Are you sure you want to delete this document?" %>')) {
            const form = document.getElementById('delete-doc-form');
            form.action = '/schooladmin/teachers/delete-document/' + docId;
            form.submit();
        }
    }
</script>