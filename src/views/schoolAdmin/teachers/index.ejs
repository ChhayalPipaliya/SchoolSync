<%- include('../../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <!-- Header Section -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Teachers</h2>
                    <p class="text-xs text-gray-500 mt-1">Manage and track your teaching staff and class assignments</p>
                </div>
                <div class="flex flex-wrap gap-2">
                    <a href="/schooladmin/teachers/assignments" class="btn btn-secondary flex items-center gap-1.5 text-xs font-bold">
                        <i class="fa-solid fa-person-chalkboard"></i> Assignments
                    </a>
                    <a href="/schooladmin/teachers/free" class="btn btn-secondary flex items-center gap-1.5 text-xs font-bold">
                        <i class="fa-solid fa-user-slash"></i> Unassigned
                    </a>
                    <a href="/schooladmin/teachers/add" class="btn btn-primary flex items-center gap-1.5 text-xs font-bold">
                        <i class="fa-solid fa-plus"></i> Add Teacher
                    </a>
                </div>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Sub Tabs -->
            <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-4 mb-6">
                <a href="/schooladmin/teachers" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-100/50">All Teachers</a>
                <a href="/schooladmin/teachers/assignments" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-slate-600 hover:bg-slate-50">Assignments</a>
                <a href="/schooladmin/teachers/free" class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg text-slate-600 hover:bg-slate-50">Unassigned</a>
            </div>

            <!-- Filter Card -->
            <div class="card p-5 mb-6">
                <form method="GET" action="/schooladmin/teachers" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Search</label>
                        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Search by name or email..." class="form-input">
                    </div>
                    <div>
                        <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Status</label>
                        <select name="status" class="form-select">
                            <option value="">All Status</option>
                            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>
                    <div class="flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-1">
                            <i class="fas fa-filter mr-1"></i> Filter
                        </button>
                        <a href="/schooladmin/teachers" class="btn btn-secondary btn-sm flex-1">
                            Reset
                        </a>
                    </div>
                </form>
            </div>

            <!-- Teachers Cards Grid -->
            <div class="row g-4">
                <% if (!teachers || teachers.length === 0) { %>
                    <div class="col-12">
                        <div class="card py-16 text-center">
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <i class="fa-solid fa-chalkboard-user"></i>
                                </div>
                                <h3 class="empty-state-title">No teacher records found</h3>
                                <p class="empty-state-text">Get started by onboarding your first teacher to assign subjects and classes.</p>
                                <a href="/schooladmin/teachers/add" class="btn btn-primary btn-sm mt-3">
                                    Add Teacher
                                </a>
                            </div>
                        </div>
                    </div>
                <% } %>
                
                <% (teachers || []).forEach(function(t, i) {
                    const classList = t.classes
                        ? t.classes.split(',').map(c => c.trim()).filter(Boolean)
                        : [];
                    let profileImg = null;
                    if (t.image) {
                        try {
                            const imgs = JSON.parse(t.image);
                            if (Array.isArray(imgs) && imgs.length) {
                                profileImg = imgs[0].startsWith('/uploads/') ? imgs[0] : '/uploads/teachers/' + imgs[0].replace(/^\/+/,'');
                            } else if (typeof imgs === 'string') {
                                profileImg = imgs.startsWith('/uploads/') ? imgs : '/uploads/teachers/' + imgs.replace(/^\/+/,'');
                            }
                        } catch (e) {
                            profileImg = t.image.startsWith('/') ? t.image : '/uploads/teachers/' + t.image.replace(/^\/+/,'');
                        }
                    }
                %>
                    <div class="col-md-4 col-sm-6">
                        <div class="card flex flex-col h-100 overflow-hidden mb-0">
                            <!-- Card Header (ID & Actions) -->
                            <div class="px-5 py-3 border-b border-gray-50 flex items-center justify-between bg-slate-50/30">
                                <span class="text-[10px] font-bold text-slate-400 tracking-wider">#<%= i+1 %></span>
                                <div class="flex items-center gap-1.5">
                                    <a href="/schooladmin/teachers/<%= t.id %>" class="btn-icon" title="View Profile">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <button
                                        type="button"
                                        class="btn-icon id-card-preview-btn"
                                        data-teacher-id="<%= t.id %>"
                                        data-teacher-name="<%= t.first_name %> <%= t.last_name %>"
                                        data-preview-url="/schooladmin/teachers/<%= t.id %>/id-card/preview"
                                        data-download-url="/schooladmin/teachers/<%= t.id %>/id-card/download"
                                        aria-label="Preview ID card for <%= t.first_name %> <%= t.last_name %>"
                                        title="ID Card"
                                        style="color: var(--primary); background: none; border: none; padding: 0; cursor: pointer; border: 1px solid var(--border);"
                                    >
                                        <i class="fa-solid fa-id-card"></i>
                                    </button>
                                    <a href="/schooladmin/teachers/<%= t.id %>/edit" class="btn-icon btn-edit-icon" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form action="/schooladmin/teachers/<%= t.id %>/delete" method="POST" class="inline-block m-0" onsubmit="return confirm('Delete this teacher?')">
                                        <button type="submit" class="btn-icon btn-danger-icon" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            
                            <!-- Card Body -->
                            <div class="p-5 flex-1 flex flex-col">
                                <div class="flex items-center gap-4 mb-4">
                                    <% if (profileImg) { %>
                                        <img src="<%= profileImg %>" class="w-12 h-12 rounded-full object-cover bg-slate-50 border border-slate-100 flex-shrink-0" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;">
                                    <% } else { %>
                                        <div class="w-12 h-12 rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0" style="width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background-color: var(--primary-light); color: var(--primary); font-weight: bold; border: 1px solid rgba(5, 150, 105, 0.1); flex-shrink: 0;">
                                            <%= (t.first_name || '?').charAt(0).toUpperCase() %>
                                        </div>
                                    <% } %>
                                    <div class="min-w-0">
                                        <h3 class="font-bold text-gray-800 text-[14.5px] truncate"><%= t.first_name %> <%= t.last_name %></h3>
                                        <p class="text-[11px] text-gray-400 truncate mt-0.5"><i class="fa-regular fa-envelope mr-1"></i><%= t.email %></p>
                                    </div>
                                </div>
                                
                                <div class="grid grid-cols-2 gap-3 pt-3 border-t border-gray-100/70 text-xs">
                                    <div>
                                        <span class="block text-[10px] font-bold text-gray-400 uppercase tracking-wider">Qualification</span>
                                        <span class="font-semibold text-gray-700 block mt-0.5 truncate"><%= t.qualification || '—' %></span>
                                    </div>
                                    <div>
                                        <span class="block text-[10px] font-bold text-gray-400 uppercase tracking-wider">Experience</span>
                                        <span class="font-semibold text-gray-700 block mt-0.5">
                                            <% if (t.experience) { %>
                                                <span class="badge badge-role-success"><%= t.experience %> yrs</span>
                                            <% } else { %>
                                                —
                                            <% } %>
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="mt-4 pt-3 border-t border-gray-100/70 flex-1 flex flex-col justify-end">
                                    <span class="block text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2">Assigned Classes</span>
                                    <div class="flex flex-wrap gap-1">
                                        <% if (classList.length > 0) { %>
                                            <% classList.forEach(function(cls) { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-cyan-50 text-cyan-700 border border-cyan-100/50">
                                                    <i class="fa-solid fa-chalkboard text-[8px]"></i> <%= cls %>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span class="text-xs text-slate-400 italic">No classes assigned</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- ID Card Preview Modal -->
        <div id="idCardModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-[9999]" role="dialog" aria-modal="true" aria-labelledby="idCardModalTitle">
            <div class="bg-white border border-gray-200 rounded-2xl shadow-xl max-w-3xl w-full mx-4 flex flex-col max-h-[90vh]">
                <!-- Modal Header -->
                <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-gray-800" id="idCardModalTitle">Teacher ID Card</h3>
                        <p class="text-xs text-gray-500 mt-0.5" id="idCardTeacherName"></p>
                    </div>
                    <button type="button" id="closeIdCardModalIcon" class="text-gray-400 hover:text-gray-600 focus:outline-none text-2xl" aria-label="Close modal">
                        &times;
                    </button>
                </div>

                <!-- Modal Body (Iframe) -->
                <div class="p-6 flex-1 overflow-y-auto flex flex-col justify-center items-center min-h-[400px] relative bg-slate-50">
                    <!-- Loader -->
                    <div id="idCardPreviewLoader" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-50 z-10 transition-opacity duration-200">
                        <div class="animate-spin rounded-full h-10 w-10 border-4 border-emerald-500 border-t-transparent mb-3"></div>
                        <span class="text-sm text-gray-500 font-semibold">Loading ID card preview...</span>
                    </div>

                    <!-- Error message (hidden initially) -->
                    <div id="idCardPreviewError" class="hidden absolute inset-0 flex flex-col items-center justify-center bg-slate-50 z-10 p-6 text-center">
                        <i class="fa-solid fa-triangle-exclamation text-red-500 text-3xl mb-3"></i>
                        <span class="text-sm font-semibold text-gray-700">Unable to load the ID card preview.</span>
                    </div>

                    <!-- Iframe preview -->
                    <iframe id="teacherIdCardPreviewFrame" class="w-full flex-1 border border-gray-200 rounded-lg bg-white shadow-sm" title="Teacher ID Card Preview" style="height: 480px; display: none;"></iframe>
                </div>

                <!-- Modal Footer -->
                <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:justify-end gap-3 bg-slate-50/50">
                    <button type="button" id="closeIdCardModalBtn" class="px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg transition">
                        Close
                    </button>
                    <a id="downloadTeacherIdCardBtn" href="" class="px-4 py-2 text-xs font-bold uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg flex items-center justify-center gap-1.5 transition">
                        <i class="fa-solid fa-download"></i> Download ID Card
                    </a>
                </div>
            </div>
        </div>

        <%- include('../../partials/footer') %>
    </div>
</div>
