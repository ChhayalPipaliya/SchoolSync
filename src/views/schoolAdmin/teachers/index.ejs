<%- include('../../partials/head') %>
<style>
    .teachers-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .teachers-page-title {
        font-size: 22px;
        font-weight: 800;
        color: var(--text-primary, #1E293B);
        margin: 0;
        line-height: 1.2;
    }
    .teachers-page-subtitle {
        font-size: 12px;
        color: var(--text-muted);
        margin: 4px 0 0;
    }
    .teachers-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    /* Teacher card */
    .teacher-card {
        background: var(--surface, #fff);
        border: 1px solid var(--border, #E2E8F0);
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: box-shadow 0.2s, transform 0.2s;
        margin-bottom: 0;
    }
    .teacher-card:hover {
        box-shadow: 0 8px 24px rgba(0,0,0,0.10);
        transform: translateY(-2px);
    }
    .teacher-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border, #F1F5F9);
        background: var(--surface-hover, #F8FAFC);
    }
    .teacher-card-num {
        font-size: 10px;
        font-weight: 700;
        color: var(--text-muted, #94A3B8);
        letter-spacing: 0.05em;
    }
    .teacher-card-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .teacher-card-body {
        padding: 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .teacher-avatar-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }
    .teacher-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        background: var(--surface-hover, #F1F5F9);
        border: 2px solid var(--border, #E2E8F0);
        flex-shrink: 0;
    }
    .teacher-avatar-initials {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-light, #D1FAE5);
        color: var(--primary, #059669);
        font-weight: 700;
        font-size: 18px;
        flex-shrink: 0;
        border: 2px solid var(--border, #E2E8F0);
    }
    .teacher-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary, #0F172A);
        margin: 0 0 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .teacher-email {
        font-size: 11px;
        color: var(--text-muted, #94A3B8);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .teacher-meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        padding: 12px 0;
        border-top: 1px solid var(--border, #F1F5F9);
        margin-bottom: 12px;
    }
    .teacher-meta-label {
        font-size: 9.5px;
        font-weight: 700;
        color: var(--text-muted, #94A3B8);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        display: block;
        margin-bottom: 2px;
    }
    .teacher-meta-val {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary, #334155);
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .teacher-classes-label {
        font-size: 9.5px;
        font-weight: 700;
        color: var(--text-muted, #94A3B8);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 8px;
        display: block;
    }
    .teacher-classes-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        flex: 1;
        align-content: flex-start;
    }
    .teacher-class-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 2px 8px;
        border-radius: 9999px;
        font-size: 10px;
        font-weight: 700;
        background: #ECFEFF;
        color: #0891B2;
        border: 1px solid #CFFAFE;
    }
    .teacher-no-class {
        font-size: 11px;
        color: var(--text-muted, #94A3B8);
        font-style: italic;
    }

    /* Tab nav */
    .teacher-tab-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px;
        border-bottom: 1px solid var(--border, #E2E8F0);
        padding-bottom: 12px;
        margin-bottom: 20px;
    }
    .teacher-tab-link {
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-decoration: none;
        color: var(--text-muted, #64748B);
        transition: background 0.15s, color 0.15s;
    }
    .teacher-tab-link:hover { background: var(--surface-hover, #F1F5F9); }
    .teacher-tab-link.active {
        background: rgba(5,150,105,0.10);
        color: #059669;
        border: 1px solid rgba(5,150,105,0.15);
    }

    /* Dark mode */
    [data-theme="dark"] .teacher-card,
    .light-mode-disabled .teacher-card {
        background: #151D30;
        border-color: #242F4D;
    }
    [data-theme="dark"] .teacher-card-header,
    .light-mode-disabled .teacher-card-header {
        background: #101726;
        border-color: #242F4D;
    }
    [data-theme="dark"] .teacher-meta-grid,
    .light-mode-disabled .teacher-meta-grid {
        border-color: #242F4D;
    }
    [data-theme="dark"] .teacher-name,
    .light-mode-disabled .teacher-name { color: #F1F5F9; }
    [data-theme="dark"] .teacher-email,
    [data-theme="dark"] .teacher-meta-label,
    [data-theme="dark"] .teacher-classes-label,
    [data-theme="dark"] .teacher-no-class,
    .light-mode-disabled .teacher-email,
    .light-mode-disabled .teacher-meta-label,
    .light-mode-disabled .teacher-classes-label,
    .light-mode-disabled .teacher-no-class { color: #64748B; }
    [data-theme="dark"] .teacher-meta-val,
    .light-mode-disabled .teacher-meta-val { color: #CBD5E1; }
    [data-theme="dark"] .teacher-avatar,
    [data-theme="dark"] .teacher-avatar-initials,
    .light-mode-disabled .teacher-avatar,
    .light-mode-disabled .teacher-avatar-initials { border-color: #242F4D; }
    [data-theme="dark"] .teacher-class-badge,
    .light-mode-disabled .teacher-class-badge {
        background: rgba(8,145,178,0.12);
        color: #22D3EE;
        border-color: rgba(8,145,178,0.25);
    }
    [data-theme="dark"] .teacher-tab-nav,
    .light-mode-disabled .teacher-tab-nav { border-color: #242F4D; }
    [data-theme="dark"] .teacher-tab-link,
    .light-mode-disabled .teacher-tab-link { color: #64748B; }
    [data-theme="dark"] .teacher-tab-link:hover,
    .light-mode-disabled .teacher-tab-link:hover { background: #1E293B; }
    [data-theme="dark"] .teacher-tab-link.active,
    .light-mode-disabled .teacher-tab-link.active {
        background: rgba(5,150,105,0.15);
        color: #34D399;
        border-color: rgba(5,150,105,0.25);
    }
    [data-theme="dark"] .card,
    .light-mode-disabled .card {
        background: #151D30;
        border-color: #242F4D;
    }

    @media (max-width: 640px) {
        .teachers-page-header { flex-direction: column; align-items: flex-start; }
        .teachers-header-actions { width: 100%; }
        .teachers-header-actions .btn { flex: 1; justify-content: center; min-width: 0; }
        .teachers-page-title { font-size: 20px; }
        .teachers-filter-form { grid-template-columns: 1fr !important; }
        #teacherIdCardPreviewFrame { height: 320px !important; }
    }
    @media (max-width: 768px) and (min-width: 641px) {
        .teachers-filter-form { grid-template-columns: 1fr 1fr !important; }
    }
</style>
<div class="app-wrapper schooladmin-theme">
    <%- include('../../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="teachers-page-header">
                <div>
                    <h2 class="teachers-page-title"><%= lan.Teachers %></h2>
                    <p class="teachers-page-subtitle"><%= lan.Teachers_Index_Subtitle %></p>
                </div>
                <div class="teachers-header-actions">
                    <a href="/schooladmin/teachers/assignments" class="btn btn-secondary flex items-center gap-1.5 text-xs font-bold">
                        <i class="fa-solid fa-person-chalkboard"></i> <%= lan.Assignments %>
                    </a>
                    <a href="/schooladmin/teachers/free" class="btn btn-secondary flex items-center gap-1.5 text-xs font-bold">
                        <i class="fa-solid fa-user-slash"></i> <%= lan.Unassigned %>
                    </a>
                    <a href="/schooladmin/teachers/add" class="btn btn-primary flex items-center gap-1.5 text-xs font-bold">
                        <i class="fa-solid fa-plus"></i> <%= lan.Add_Teacher %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>

            <div class="teacher-tab-nav">
                <a href="/schooladmin/teachers" class="teacher-tab-link active"><%= lan.All_Teachers %></a>
                <a href="/schooladmin/teachers/assignments" class="teacher-tab-link"><%= lan.Assignments %></a>
                <a href="/schooladmin/teachers/free" class="teacher-tab-link"><%= lan.Unassigned %></a>
            </div>

            <div class="card p-4 mb-5">
                <form method="GET" action="/schooladmin/teachers" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end teachers-filter-form">
                    <div>
                        <label class="form-label font-bold text-xs uppercase tracking-wider mb-2"><%= lan.Search %></label>
                        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="<%= lan.Search_Teacher_Placeholder %>" class="form-input">
                    </div>
                    <div>
                        <label class="form-label font-bold text-xs uppercase tracking-wider mb-2"><%= lan.Status %></label>
                        <select name="status" class="form-select">
                            <option value=""><%= lan.All_Status %></option>
                            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= lan.Active %></option>
                            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>><%= lan.Inactive %></option>
                        </select>
                    </div>
                    <div class="flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-1">
                            <i class="fas fa-filter mr-1"></i> <%= lan.Filter %>
                        </button>
                        <a href="/schooladmin/teachers" class="btn btn-secondary btn-sm flex-1"><%= lan.Reset %></a>
                    </div>
                </form>
            </div>

            <div class="row g-4">
                <% if (!teachers || teachers.length === 0) { %>
                    <div class="col-12">
                        <div class="card py-16 text-center">
                            <div class="empty-state">
                                <div class="empty-state-icon"><i class="fa-solid fa-chalkboard-user"></i></div>
                                <h3 class="empty-state-title"><%= lan.No_Teacher_Records_Found %></h3>
                                <p class="empty-state-text"><%= lan.No_Teachers_Found_Subtitle %></p>
                                <a href="/schooladmin/teachers/add" class="btn btn-primary btn-sm mt-3"><%= lan.Add_Teacher %></a>
                            </div>
                        </div>
                    </div>
                <% } %>
                <% (teachers || []).forEach(function(t, i) {
                    const classList = t.classes ? t.classes.split(',').map(c => c.trim()).filter(Boolean) : [];
                    let profileImg = null;
                    if (t.image) {
                        try {
                            const imgs = JSON.parse(t.image);
                            if (Array.isArray(imgs) && imgs.length) {
                                profileImg = imgs[0].startsWith('/uploads/') ? imgs[0] : '/uploads/teachers/' + imgs[0].replace(/^\/+/,'');
                            } else if (typeof imgs === 'string') {
                                profileImg = imgs.startsWith('/uploads/') ? imgs : '/uploads/teachers/' + imgs.replace(/^\/+/,'');
                            }
                        } catch (e) {
                            profileImg = t.image.startsWith('/') ? t.image : '/uploads/teachers/' + t.image.replace(/^\/+/,'');
                        }
                    }
                %>
                    <div class="col-md-4 col-sm-6">
                        <div class="teacher-card">
                            <div class="teacher-card-header">
                                <span class="teacher-card-num">#<%= i+1 %></span>
                                <div class="teacher-card-actions">
                                    <a href="/schooladmin/teachers/<%= t.id %>" class="btn-icon" title="<%= lan.View_Profile %>">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <button type="button" class="btn-icon id-card-preview-btn"
                                        data-teacher-id="<%= t.id %>"
                                        data-teacher-name="<%= t.first_name %> <%= t.last_name %>"
                                        data-preview-url="/schooladmin/teachers/<%= t.id %>/id-card/preview"
                                        data-download-url="/schooladmin/teachers/<%= t.id %>/id-card/download"
                                        title="<%= lan.ID_Card %>">
                                        <i class="fa-solid fa-id-card"></i>
                                    </button>
                                    <a href="/schooladmin/teachers/<%= t.id %>/edit" class="btn-icon btn-edit-icon" title="<%= lan.Edit %>">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form action="/schooladmin/teachers/<%= t.id %>/delete" method="POST" class="inline-block m-0" onsubmit="return confirm('<%= lan.Delete_Teacher_Confirm %>')">
                                        <button type="submit" class="btn-icon btn-danger-icon" title="<%= lan.Delete %>">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="teacher-card-body">
                                <div class="teacher-avatar-wrap">
                                    <% if (profileImg) { %>
                                        <img src="<%= profileImg %>" class="teacher-avatar" onerror="this.onerror=null;this.src='/images/default-avatar.png'">
                                    <% } else { %>
                                        <div class="teacher-avatar-initials">
                                            <%= (t.first_name || '?').charAt(0).toUpperCase() %>
                                        </div>
                                    <% } %>
                                    <div style="min-width:0;">
                                        <h3 class="teacher-name"><%= t.first_name %> <%= t.last_name %></h3>
                                        <p class="teacher-email"><i class="fa-regular fa-envelope" style="margin-right:4px;"></i><%= t.email %></p>
                                    </div>
                                </div>
                                <div class="teacher-meta-grid">
                                    <div>
                                        <span class="teacher-meta-label"><%= lan.Qualification %></span>
                                        <span class="teacher-meta-val"><%= t.qualification || '—' %></span>
                                    </div>
                                    <div>
                                        <span class="teacher-meta-label"><%= lan.Experience %></span>
                                        <span class="teacher-meta-val">
                                            <% if (t.experience) { %>
                                                <span class="badge badge-role-success"><%= t.experience %> yrs</span>
                                            <% } else { %>—<% } %>
                                        </span>
                                    </div>
                                </div>
                                <div style="flex:1; display:flex; flex-direction:column;">
                                    <span class="teacher-classes-label"><%= lan.Assigned_Classes %></span>
                                    <div class="teacher-classes-wrap">
                                        <% if (classList.length > 0) { %>
                                            <% classList.forEach(function(cls) { %>
                                                <span class="teacher-class-badge">
                                                    <i class="fa-solid fa-chalkboard" style="font-size:8px;"></i> <%= cls %>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span class="teacher-no-class"><%= lan.No_Classes_Assigned %></span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>

            <div id="idCardModal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center" style="z-index:999999;" role="dialog" aria-modal="true" aria-labelledby="idCardModalTitle">
                <div style="background:var(--surface,#fff); border:1px solid var(--border,#E2E8F0); border-radius:16px; box-shadow:0 10px 40px rgba(0,0,0,0.18); max-width:780px; width:calc(100% - 32px); max-height:90vh; display:flex; flex-direction:column;">
                    <div style="padding:16px 20px; border-bottom:1px solid var(--border,#E2E8F0); display:flex; align-items:center; justify-content:space-between;">
                        <div>
                            <h3 style="font-size:16px; font-weight:700; color:var(--text-primary,#1E293B); margin:0;" id="idCardModalTitle"><%= lan.Teacher_ID_Card %></h3>
                            <p style="font-size:11px; color:var(--text-muted,#94A3B8); margin:2px 0 0;" id="idCardTeacherName"></p>
                        </div>
                        <button type="button" id="closeIdCardModalIcon" style="color:var(--text-muted,#94A3B8); font-size:22px; background:none; border:none; cursor:pointer; line-height:1;" aria-label="Close">&times;</button>
                    </div>
                    <div style="padding:20px; flex:1; overflow-y:auto; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:400px; position:relative; background:var(--surface-hover,#F8FAFC);">
                        <div id="idCardPreviewLoader" style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--surface-hover,#F8FAFC); z-index:10;">
                            <div class="animate-spin rounded-full h-10 w-10 border-4 border-emerald-500 border-t-transparent mb-3"></div>
                            <span style="font-size:13px; color:var(--text-muted,#94A3B8); font-weight:600;"><%= lan.Loading_ID_Card_Preview %></span>
                        </div>
                        <div id="idCardPreviewError" class="hidden" style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:10; padding:20px; text-align:center;">
                            <i class="fa-solid fa-triangle-exclamation" style="color:#EF4444; font-size:28px; margin-bottom:10px;"></i>
                            <span style="font-size:13px; font-weight:600; color:var(--text-secondary,#334155);"><%= lan.Unable_To_Load_ID_Card_Preview %></span>
                        </div>
                        <iframe id="teacherIdCardPreviewFrame" style="width:100%; flex:1; border:1px solid var(--border,#E2E8F0); border-radius:10px; background:#fff; height:480px; display:none;" title="Teacher ID Card Preview"></iframe>
                    </div>
                    <div style="padding:14px 20px; border-top:1px solid var(--border,#E2E8F0); display:flex; justify-content:flex-end; gap:10px; background:var(--surface-hover,#F8FAFC); border-radius:0 0 16px 16px;">
                        <button type="button" id="closeIdCardModalBtn" class="btn btn-secondary btn-sm"><%= lan.Close %></button>
                        <a id="downloadTeacherIdCardBtn" href="" class="btn btn-primary btn-sm" style="display:inline-flex; align-items:center; gap:6px;">
                            <i class="fa-solid fa-download"></i> <%= lan.Download_ID_Card %>
                        </a>
                    </div>
</div>
        <%- include('../../partials/footer') %>
                </div>
        </div>

    </div>
</div>
