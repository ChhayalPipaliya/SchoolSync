<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terms of Service | SchoolSync</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --primary-soft: #eef2ff;
            --accent: #7c3aed;
            --text: #0f172a;
            --text-soft: #475569;
            --muted: #64748b;
            --border: #e2e8f0;
            --surface: #ffffff;
            --surface-soft: #f8fafc;
            --radius-lg: 20px;
            --radius-md: 14px;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 12px 36px rgba(15, 23, 42, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at 100% 0%, rgba(79, 70, 229, 0.06), transparent 28rem),
                radial-gradient(circle at 0% 20%, rgba(124, 58, 237, 0.05), transparent 26rem),
                var(--surface-soft);
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .topbar {
            height: 68px;
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.92);
            border-bottom: 1px solid rgba(226, 232, 240, 0.9);
            backdrop-filter: blur(14px);
            position: sticky;
            top: 0;
            z-index: 50;
            width: 100%;
        }

        .topbar-inner {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            box-shadow: 0 8px 22px rgba(79, 70, 229, 0.24);
        }

        .brand-icon i {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            line-height: 1;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 40px;
            padding: 0 16px;
            border: 1px solid var(--border);
            border-radius: 12px;
            color: var(--text-soft);
            background: #fff;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .nav-btn:hover {
            color: var(--primary-dark);
            border-color: #c7d2fe;
            background: var(--primary-soft);
            transform: translateY(-1px);
        }

        .page-shell {
            width: 100%;
            max-width: 1280px;
            margin: 28px auto 0;
            padding: 0 24px;
        }

        .hero {
            position: relative;
            overflow: hidden;
            padding: 44px 48px;
            border-radius: 28px;
            color: #fff;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 60%, #9333ea 100%);
            box-shadow: 0 24px 70px rgba(79, 70, 229, 0.20);
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            right: -90px;
            top: -120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            pointer-events: none;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 14px;
            margin-bottom: 16px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .hero h1 {
            font-size: clamp(32px, 3.5vw, 48px);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.04em;
        }

        .hero p {
            max-width: 640px;
            margin-top: 14px;
            color: rgba(255, 255, 255, 0.85);
            font-size: 16px;
        }

        .meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 20px;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.75);
            font-weight: 500;
        }

        .legal-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 36px;
            margin-top: 36px;
            align-items: start;
        }

        .toc-card {
            position: sticky;
            top: 92px;
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--surface);
            box-shadow: var(--shadow-sm);
        }

        .toc-title {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--muted);
            margin-bottom: 14px;
        }

        .toc-nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .toc-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-soft);
            transition: all 0.2s ease;
        }

        .toc-link:hover,
        .toc-link.active {
            color: var(--primary-dark);
            background: var(--primary-soft);
            font-weight: 700;
        }

        .toc-link.active {
            /* border-left: 3px solid var(--primary); */
            padding-left: 9px;
        }

        .toc-link i {
            width: 16px;
            font-size: 13px;
            text-align: center;
            color: var(--primary);
        }

        .content-stack {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .legal-section {
            scroll-margin-top: 85px;
            padding: 32px;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--surface);
            box-shadow: var(--shadow-sm);
            transition: all 0.25s ease;
        }

        .legal-section:hover,
        .legal-section:target,
        .legal-section.active {
            border-color: #a5b4fc;
            box-shadow: 0 12px 32px rgba(79, 70, 229, 0.12);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
        }

        .section-num {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-soft);
            color: var(--primary-dark);
            font-size: 14px;
            font-weight: 800;
            flex-shrink: 0;
        }

        .section-header h2 {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text);
        }

        .legal-section p {
            color: var(--text-soft);
            font-size: 14px;
            line-height: 1.7;
            margin-bottom: 14px;
        }

        .legal-section p:last-child {
            margin-bottom: 0;
        }

        .role-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 10px;
            margin: 16px 0;
        }

        .role-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: 12px;
            background: var(--surface-soft);
            border: 1px solid var(--border);
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text);
        }

        .role-badge i {
            color: var(--primary);
            font-size: 14px;
        }

        .check-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 14px;
        }

        .check-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 14px;
            color: var(--text-soft);
            line-height: 1.6;
        }

        .check-list li i {
            margin-top: 4px;
            font-size: 14px;
            flex-shrink: 0;
        }

        .check-list li i.icon-allowed {
            color: #059669;
        }

        .check-list li i.icon-prohibited {
            color: #dc2626;
        }

        .highlight-box {
            padding: 20px;
            border-radius: 14px;
            background: #f5f3ff;
            border: 1px solid #ddd6fe;
            margin-top: 16px;
        }

        .highlight-box p {
            color: #4c1d95;
            font-size: 13.5px;
            font-weight: 500;
            margin: 0;
        }

        .contact-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 24px;
            border-radius: 18px;
            background: linear-gradient(135deg, #eef2ff 0%, #faf5ff 100%);
            border: 1px solid #c7d2fe;
            margin-top: 10px;
        }

        .contact-card-text h3 {
            font-size: 16px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 4px;
        }

        .contact-card-text p {
            font-size: 13px;
            color: var(--text-soft);
            margin: 0;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 20px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            font-size: 13.5px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(79, 70, 229, 0.35);
        }

        .footer {
            width: 100%;
            max-width: 1280px;
            margin: 40px auto 0;
            padding: 24px 24px 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 13px;
        }

        .footer-links {
            display: flex;
            gap: 20px;
        }

        .footer-links a:hover {
            color: var(--primary);
        }

        @media (max-width: 960px) {
            .legal-grid {
                grid-template-columns: 1fr;
            }

            .toc-card {
                position: static;
            }
        }

        @media (max-width: 640px) {

            .page-shell,
            .topbar-inner,
            .footer {
                padding-left: 16px;
                padding-right: 16px;
            }

            .hero {
                padding: 28px 22px;
                border-radius: 20px;
            }

            .legal-section {
                padding: 20px;
            }

            .contact-card {
                flex-direction: column;
                align-items: flex-start;
            }

            .footer {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a href="/" class="brand" aria-label="SchoolSync Home">
                <span class="brand-icon"><i class="fa-solid fa-school"></i></span>
                <span>SchoolSync</span>
            </a>
            <div class="topbar-actions">
                <a href="/support" class="nav-btn">
                    <i class="fa-solid fa-headset"></i> Support
                </a>
                <a href="/" class="nav-btn">
                    <i class="fa-solid fa-arrow-left"></i> Back to home
                </a>
            </div>
        </div>
    </header>
    <main class="page-shell">
        <section class="hero">
            <span class="eyebrow">
                <i class="fa-solid fa-file-contract"></i> SchoolSync Legal Agreement
            </span>
            <h1>Terms of Service</h1>
            <p>Clear, transparent, and fair rules governing the use of the SchoolSync school management platform and services.</p>
            <div class="meta-pill">
                <i class="fa-solid fa-circle-info"></i> Last updated: June 2026 &bull; Effective for all schools & users
            </div>
        </section>
        <div class="legal-grid">
            <aside class="toc-card" aria-label="Table of Contents">
                <div class="toc-title">Quick Navigation</div>
                <nav class="toc-nav">
                    <a href="#acceptance" class="toc-link"><i class="fa-solid fa-handshake"></i> 1. Acceptance</a>
                    <a href="#accounts" class="toc-link"><i class="fa-solid fa-user-shield"></i> 2. Accounts</a>
                    <a href="#billing" class="toc-link"><i class="fa-solid fa-credit-card"></i> 3. Billing & Fees</a>
                    <a href="#usage" class="toc-link"><i class="fa-solid fa-shield-halved"></i> 4. Acceptable Use</a>
                    <a href="#ownership" class="toc-link"><i class="fa-solid fa-database"></i> 5. Data Ownership</a>
                    <a href="#termination" class="toc-link"><i class="fa-solid fa-ban"></i> 6. Termination</a>
                    <a href="#liability" class="toc-link"><i class="fa-solid fa-scale-balanced"></i> 7. Liability</a>
                    <a href="#contact" class="toc-link"><i class="fa-solid fa-envelope"></i> 8. Contact</a>
                </nav>
            </aside>
            <div class="content-stack">
                <article class="legal-section" id="acceptance">
                    <div class="section-header">
                        <span class="section-num">1</span>
                        <h2>Acceptance of Terms</h2>
                    </div>
                    <p>By accessing, registering, or using the <strong>SchoolSync</strong> platform, software, and services, you agree to be bound by these Terms of Service. If a school or institution registers an account with SchoolSync, these terms apply to all administrators, staff, students, and guardians associated with that school's portal.</p>
                    <div class="role-grid">
                        <div class="role-badge"><i class="fa-solid fa-crown"></i> Super Admin</div>
                        <div class="role-badge"><i class="fa-solid fa-building-columns"></i> School Admin</div>
                        <div class="role-badge"><i class="fa-solid fa-sitemap"></i> Group Admin</div>
                        <div class="role-badge"><i class="fa-solid fa-chalkboard-user"></i> Teacher</div>
                        <div class="role-badge"><i class="fa-solid fa-graduation-cap"></i> Student</div>
                        <div class="role-badge"><i class="fa-solid fa-people-roof"></i> Parent</div>
                        <div class="role-badge"><i class="fa-solid fa-book-open"></i> Librarian</div>
                        <div class="role-badge"><i class="fa-solid fa-bus"></i> Driver</div>
                    </div>
                    <p>If you do not agree to these terms, you must refrain from using the platform.</p>
                </article>
                <article class="legal-section" id="accounts">
                    <div class="section-header">
                        <span class="section-num">2</span>
                        <h2>Account Responsibilities & Roles</h2>
                    </div>
                    <p>Access to SchoolSync modules is strictly role-based. Users are assigned credentials by their designated School Administrator or Super Administrator.</p>
                    <ul class="check-list">
                        <li>
                            <i class="fa-solid fa-circle-check icon-allowed"></i>
                            <span><strong>Credential Security:</strong> You are responsible for keeping your password and login OTP confidential. Any activity conducted under your credentials remains your responsibility.</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check icon-allowed"></i>
                            <span><strong>Administrative Duty:</strong> School Admins are responsible for managing internal permissions, granting role privileges, and revoking credentials when staff or students leave.</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check icon-allowed"></i>
                            <span><strong>Accurate Data:</strong> Schools agree to maintain accurate records, including student contact details, fee structures, and emergency transport details.</span>
                        </li>
                    </ul>
                </article>
                <article class="legal-section" id="billing">
                    <div class="section-header">
                        <span class="section-num">3</span>
                        <h2>Subscriptions, Trial & Payments</h2>
                    </div>
                    <p>SchoolSync provides multi-tier subscription plans (7-Day Trial, Basic, Standard, and Premium) tailored to school sizes and feature requirements.</p>
                    <ul class="check-list">
                        <li>
                            <i class="fa-solid fa-bolt text-amber-500"></i>
                            <span><strong>7-Day Demo Trial:</strong> New schools may test the platform for 7 days without providing credit card details. Full feature access is granted during the trial.</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-shield-halved text-indigo-600"></i>
                            <span><strong>Payment Processing:</strong> All subscription billing and fee collection transactions are securely processed via <strong>Razorpay</strong>. SchoolSync does not store raw credit card or banking secrets on its servers.</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-clock-rotate-left text-violet-600"></i>
                            <span><strong>Renewal & Grace Period:</strong> Failure to renew an active plan before expiration may result in restricted module access until payment confirmation.</span>
                        </li>
                    </ul>
                </article>
                <article class="legal-section" id="usage">
                    <div class="section-header">
                        <span class="section-num">4</span>
                        <h2>Acceptable Use Policy</h2>
                    </div>
                    <p>To ensure system integrity, high availability, and compliance, all users must adhere to acceptable conduct guidelines.</p>
                    <ul class="check-list">
                        <li>
                            <i class="fa-solid fa-circle-check icon-allowed"></i>
                            <span>Use the platform solely for educational, administrative, transport tracking, and fee management operations.</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-xmark icon-prohibited"></i>
                            <span>Do not attempt to bypass role isolation or access data belonging to another school or branch.</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-xmark icon-prohibited"></i>
                            <span>Do not upload malicious scripts, spam messages, or unauthorized commercial promotions via school announcements or chat.</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-xmark icon-prohibited"></i>
                            <span>Automated web scraping, rate-limit bypassing, or reverse-engineering of system APIs is strictly prohibited.</span>
                        </li>
                    </ul>
                </article>
                <article class="legal-section" id="ownership">
                    <div class="section-header">
                        <span class="section-num">5</span>
                        <h2>Data Ownership & Privacy</h2>
                    </div>
                    <p>We respect institutional data sovereignty. Every registered school retains full, exclusive ownership of its student records, grades, attendance logs, and financial transactions.</p>
                    <div class="highlight-box">
                        <p><i class="fa-solid fa-lock mr-2"></i> <strong>Institutional Privacy:</strong> SchoolSync operates as a data processor. We do not sell, license, or monetize student or school data to third-party advertisers.</p>
                    </div>
                </article>
                <article class="legal-section" id="termination">
                    <div class="section-header">
                        <span class="section-num">6</span>
                        <h2>Account Suspension & Termination</h2>
                    </div>
                    <p>We reserve the right to suspend or terminate access to accounts that engage in severe terms violations, security exploitation, or prolonged non-payment.</p>
                    <p>In the event of account termination, School Admins may request a data export of student and fee records prior to account purging.</p>
                </article>
                <article class="legal-section" id="liability">
                    <div class="section-header">
                        <span class="section-num">7</span>
                        <h2>Limitation of Liability</h2>
                    </div>
                    <p>SchoolSync is provided on an "as is" and "as available" basis. While we maintain a 99.9% uptime target with automated backups and cloud redundancy, we are not liable for indirect or incidental damages resulting from third-party network outages or user misconfigurations.</p>
                </article>
                <article class="legal-section" id="contact">
                    <div class="section-header">
                        <span class="section-num">8</span>
                        <h2>Questions & Contact Information</h2>
                    </div>
                    <p>If you have any questions, legal inquiries, or compliance requests regarding these Terms of Service, please reach out to our dedicated support team.</p>
                    <div class="contact-card">
                        <div class="contact-card-text">
                            <h3>Have a legal or account question?</h3>
                            <p>Our team is available Monday to Saturday to assist you.</p>
                        </div>
                        <a href="/support" class="btn-primary"><i class="fa-solid fa-paper-plane"></i> Contact Support</a>
                    </div>
                </article>
            </div>
        </div>
    </main>
    <footer class="footer">
        <div>&copy; <%= new Date().getFullYear() %> SchoolSync. All rights reserved.</div>
        <nav class="footer-links" aria-label="Footer Navigation">
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
            <a href="/support">Support Center</a>
        </nav>
    </footer>
    <script>
        window.addEventListener("DOMContentLoaded", () => {
            const links = document.querySelectorAll(".toc-link");
            const sections = document.querySelectorAll(".legal-section");

            function updateActiveState() {
                let activeId = "";
                const scrollPosition = window.scrollY + 140;

                sections.forEach((section) => {
                    const top = section.offsetTop;
                    const height = section.offsetHeight;
                    if (scrollPosition >= top && scrollPosition < top + height) {
                        activeId = section.getAttribute("id");
                    };
                });

                if (!activeId && window.location.hash) {
                    activeId = window.location.hash.substring(1);
                };

                if (!activeId && sections.length > 0) {
                    activeId = sections[0].getAttribute("id");
                };

                links.forEach((link) => {
                    const targetId = link.getAttribute("href").replace("#", "");
                    if (targetId === activeId) {
                        link.classList.add("active");
                    } else {
                        link.classList.remove("active");
                    };
                });

                sections.forEach((section) => {
                    if (section.getAttribute("id") === activeId) {
                        section.classList.add("active");
                    } else {
                        section.classList.remove("active");
                    };
                });
            };

            window.addEventListener("scroll", updateActiveState);
            window.addEventListener("hashchange", updateActiveState);
            updateActiveState();
        });
    </script>
</body>
</html>