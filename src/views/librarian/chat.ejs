<style>
    .lib-chat-shell {
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .lib-chat-hero {
        background: linear-gradient(135deg, #EC4899, #DB2777);
        border-radius: 16px;
        padding: 20px 24px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(219, 39, 119, 0.18);
    }
    .lib-chat-hero h1 {
        font-size: 24px;
        font-weight: 800;
        margin: 0 0 4px;
        letter-spacing: -0.02em;
    }
    .lib-chat-hero p {
        font-size: 13px;
        opacity: 0.92;
        margin: 0;
        line-height: 1.4;
    }
    .lib-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.28);
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 6px;
    }

    #chatContainer {
        border-radius: 16px !important;
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .lib-chat-hero {
            padding: 16px 16px !important;
            border-radius: 14px !important;
        }
        .lib-chat-hero h1 {
            font-size: 20px !important;
        }
        .lib-chat-hero p {
            font-size: 12px !important;
        }
        #chatContainer {
            height: calc(100vh - 200px) !important;
            min-height: 480px !important;
            border-radius: 14px !important;
        }
    }

    /* Dark Mode Tokens */
    [data-theme="dark"] #chatContainer,
    .light-mode-disabled #chatContainer,
    [data-theme="dark"] #contactsSidebar,
    .light-mode-disabled #contactsSidebar,
    [data-theme="dark"] #chatArea,
    .light-mode-disabled #chatArea {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] #contactsSidebar > div:first-child,
    .light-mode-disabled #contactsSidebar > div:first-child,
    [data-theme="dark"] #activeChat > div:first-child,
    .light-mode-disabled #activeChat > div:first-child {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .contact-item,
    .light-mode-disabled .contact-item {
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .contact-item:hover,
    .light-mode-disabled .contact-item:hover,
    [data-theme="dark"] .contact-item.active,
    .light-mode-disabled .contact-item.active {
        background: #182238 !important;
    }
    [data-theme="dark"] .contact-name,
    .light-mode-disabled .contact-name,
    [data-theme="dark"] #activeName,
    .light-mode-disabled #activeName,
    [data-theme="dark"] #chatPlaceholder h5,
    .light-mode-disabled #chatPlaceholder h5 {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] #searchContacts,
    .light-mode-disabled #searchContacts,
    [data-theme="dark"] #msgSearchInput,
    .light-mode-disabled #msgSearchInput,
    [data-theme="dark"] #messageInput,
    .light-mode-disabled #messageInput {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] #messagesWindow,
    .light-mode-disabled #messagesWindow {
        background: #0B0F19 !important;
    }
    [data-theme="dark"] #activeChat > div:last-child,
    .light-mode-disabled #activeChat > div:last-child {
        background: #101726 !important;
        border-top-color: #242F4D !important;
    }
</style>

<div class="lib-chat-shell">
    <section class="lib-chat-hero">
        <div>
            <span class="lib-eyebrow"><i class="fas fa-comments"></i> Direct Messenger</span>
            <h1>Librarian Chat</h1>
            <p>Direct real-time messaging with School Administration and faculty.</p>
        </div>
    </section>

    <%- include('../partials/chatWindow') %>
</div>