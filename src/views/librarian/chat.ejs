<div class="chat-container bg-white border border-slate-200 shadow-sm rounded-2xl overflow-hidden" id="chatContainer" data-token="<%= typeof token !== 'undefined' ? token : '' %>" data-user-id="<%= user.id %>" data-user-role="<%= user.role %>" style="height: calc(100vh - 140px);">
    <div class="flex w-full h-full overflow-hidden">
        <!-- Contacts Sidebar -->
        <div class="w-2/5 border-r border-slate-200 h-full flex flex-col" id="contactsSidebar">
            <div class="p-4 border-b border-slate-200 bg-slate-50">
                <h5 class="m-0 text-slate-800 font-bold flex items-center gap-2 text-base"><i class="fas fa-comments text-emerald-600"></i>Messages</h5>
                <p class="text-slate-500 text-xs mt-1 mb-0">Select a contact to start messaging</p>
                <div class="mt-3 relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fas fa-search text-xs"></i>
                    </span>
                    <input type="text" class="w-full pl-9 pr-4 py-2 text-xs bg-white border border-slate-200 rounded-full focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" id="searchContacts" placeholder="Search contacts..." onkeyup="filterContacts()">
                </div>
            </div>
            <div class="flex-grow overflow-y-auto" id="contactsList">
                <% if (contacts && contacts.length > 0) { %>
                    <% contacts.forEach(contact => { %>
                        <div class="contact-item contact-item-trigger p-3.5 border-b border-slate-100 flex items-center cursor-pointer hover:bg-slate-50 transition-colors" id="contact-<%= contact.id %>" data-id="<%= contact.id %>" data-user-id="<%= contact.id %>" data-role="<%= contact.role %>" data-fullname="<%= contact.first_name %> <%= contact.last_name %>" data-name="<%= contact.first_name %> <%= contact.last_name %>">
                            <div class="relative flex-shrink-0 mr-3">
                                <% if (contact.image) { %>
                                    <img src="<%= contact.image %>" class="w-10 h-10 rounded-full object-cover">
                                <% } else { %>
                                    <div class="w-10 h-10 rounded-full flex items-center justify-center bg-emerald-600 text-white font-bold text-sm">
                                        <%= contact.first_name.charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                                <span class="status-dot absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full border-2 border-white bg-gray-300 transition-colors" id="dot-<%= contact.id %>"></span>
                            </div>
                            <div class="flex-grow min-w-0">
                                <div class="flex justify-between items-center mb-1">
                                    <h6 class="contact-name m-0 truncate text-slate-800 font-semibold text-sm"><%= contact.first_name %> <%= contact.last_name %></h6>
                                    <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-[9px] font-medium capitalize"><%= contact.role.replace('_', ' ') %></span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <p class="last-message text-slate-500 truncate m-0 text-xs" id="lastMsg-<%= contact.id %>" style="max-width: 180px;">
                                        <%= contact.last_message || 'No messages yet' %>
                                    </p>
                                    <span class="bg-emerald-600 text-white text-[10px] font-bold rounded-full w-5 h-5 items-center justify-center ml-2 <%= contact.unread_count > 0 ? 'flex' : 'hidden' %>" id="unread-<%= contact.id %>"><%= contact.unread_count %></span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="p-6 text-center text-slate-400">
                        <i class="fas fa-users text-2xl mb-2 text-slate-200"></i>
                        <p class="text-xs m-0">No active contacts found</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="w-full h-full flex flex-col bg-slate-50" id="chatArea">
            <!-- Chat Header (Placeholder when no chat selected) -->
            <div class="flex flex-col h-full justify-center items-center p-8 text-center" id="chatPlaceholder">
                <div class="rounded-full p-5 bg-emerald-50 text-emerald-600 mb-4">
                    <i class="fas fa-comments text-3xl"></i>
                </div>
                <h5 class="text-slate-800 font-bold text-lg">Your Conversations</h5>
                <p class="text-slate-500 text-sm mt-1" style="max-width: 320px;">Select a user from the contact list to start a secure internal message.</p>
            </div>

            <!-- Active Chat Interface (Hidden by default) -->
            <div class="flex flex-col h-full hidden" id="activeChat">
                <div class="p-3.5 border-b border-slate-200 flex items-center justify-between bg-white">
                    <div class="flex items-center">
                        <button class="md:hidden text-slate-500 mr-3 p-0 hover:text-slate-800 focus:outline-none" onclick="showContactsSidebar()">
                            <i class="fas fa-arrow-left text-lg"></i>
                        </button>
                        <div class="w-10 h-10 rounded-full flex items-center justify-center bg-emerald-600 text-white font-bold text-sm mr-3 flex-shrink-0" id="activeAvatar">U</div>
                        <div>
                           <h6 class="m-0 text-slate-800 font-bold text-sm" id="activeName">Contact Name</h6>
                            <span class="text-slate-500 text-[10px] capitalize" id="activeRole">Role</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="markAllReadFromActive()"
                                class="btn-icon text-gray-400 hover:text-emerald-600 transition text-xs"
                                title="Mark all as read"
                                style="padding: 4px 8px;">
                          <i class="fas fa-check-double"></i>
                        </button>
                        <button onclick="toggleMsgSearch()"
                                class="btn-icon text-gray-400 hover:text-gray-600 transition"
                                title="Search messages"
                                style="padding: 4px 8px;">
                          <i class="fas fa-search text-xs"></i>
                        </button>
                    </div>
                </div>

                <div id="msgSearchBar" class="hidden px-4 py-2 border-b border-slate-100">
                  <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-xs"></i>
                    <input type="text"
                           id="msgSearchInput"
                           placeholder="Search messages..."
                           class="form-input w-full text-xs pl-8 py-1.5 rounded-lg">
                  </div>
                  <div id="searchResults"
                       class="mt-2 space-y-1 max-h-48 overflow-y-auto hidden">
                  </div>
                </div>

                <!-- Messages Window -->
                <div class="flex-grow p-4 overflow-y-auto bg-chat flex flex-col gap-3" id="messagesWindow">
                    <!-- Dynamic chat messages go here -->
                </div>

                <div id="typingIndicator"
                     class="hidden px-4 py-1 text-xs text-gray-400 italic">
                  <span id="typingName"></span> is typing
                  <span class="inline-flex gap-0.5 ml-1">
                    <span class="w-1 h-1 rounded-full bg-gray-400 animate-bounce" style="animation-delay:0ms"></span>
                    <span class="w-1 h-1 rounded-full bg-gray-400 animate-bounce" style="animation-delay:150ms"></span>
                    <span class="w-1 h-1 rounded-full bg-gray-400 animate-bounce" style="animation-delay:300ms"></span>
                  </span>
                </div>

                <!-- Input Row -->
                <div class="p-3.5 border-t border-slate-200 bg-white relative">
                    <!-- Emoji Picker Popover -->
                    <div id="emojiPicker" class="emoji-picker-card shadow-xl border border-slate-200 bg-white" style="display: none;">
                        <div class="emoji-picker-grid" id="emojiGrid"></div>
                    </div>
                    
                    <form id="messageForm" onsubmit="handleSendMessage(event)" class="m-0">
                        <div class="flex items-center bg-slate-50 rounded-full pl-3 pr-1.5 py-1.5 border border-slate-200 focus-within:border-emerald-500 focus-within:ring-1 focus-within:ring-emerald-500 transition-colors">
                            <button class="text-slate-400 hover:text-slate-600 p-1 mr-2 focus:outline-none" type="button" id="emojiToggleBtn" onclick="toggleEmojiPicker(event)">
                                <i class="far fa-laugh-beam text-lg"></i>
                            </button>
                            <input type="text" class="flex-grow bg-transparent border-0 px-2 py-0.5 text-sm focus:outline-none focus:ring-0 text-slate-800 placeholder-slate-400" id="messageInput" placeholder="Type a message..." autocomplete="off" maxlength="1000" required>
                            <button class="bg-emerald-600 hover:bg-emerald-700 text-white rounded-full w-9 h-9 flex items-center justify-center ml-2 transition-colors focus:outline-none" type="submit">
                                <i class="fas fa-paper-plane text-xs"></i>
                            </button>
                        </div>
                        <div class="flex justify-between items-center mt-1.5 px-2">
                            <span class="text-rose-600 text-xs" id="messageError" style="display: none;"></span>
                            <span class="text-slate-400 text-[10px] ml-auto" id="messageCounter">0/1000</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function() {
    const container = document.getElementById('chatContainer');
    const token = container.getAttribute('data-token') || window.currentUserToken || '';
    const socket = io({
        auth: {
            token: token
        },
        query: {
            token: token
        }
    });
    const rolePathMap = {
        school_admin: 'schooladmin',
        teacher: 'teacher',
        librarian: 'librarian',
        driver: 'driver'
    };
    const getRolePath = (role) => rolePathMap[role] || String(role || '').replace(/_/g, '');
    const currentUserId = Number(container.getAttribute('data-user-id'));
    const userRoleRaw = container.getAttribute('data-user-role');
    const currentRole = getRolePath(userRoleRaw);
    let activeContactId = null;
    let lastDateString = null;

    function getMessageDateString(dateObj) {
        const today = new Date();
        const yesterday = new Date();
        yesterday.setDate(today.getDate() - 1);

        const d = new Date(dateObj);
        if (d.toDateString() === today.toDateString()) {
            return "Today";
        } else if (d.toDateString() === yesterday.toDateString()) {
            return "Yesterday";
        } else {
            return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
        }
    }

    document.getElementById('contactsList')?.addEventListener('click', function(e) {
        const item = e.target.closest('.contact-item-trigger');
        if (item) {
            const id = parseInt(item.getAttribute('data-id'));
            const fullname = item.getAttribute('data-fullname');
            const role = item.getAttribute('data-role');
            selectContact(id, fullname, role);
        }
    });

    // Function to play sound alert
    function playBeep() {
        try {
            const audio = new Audio("https://assets.mixkit.co/active_storage/sfx/2869/2869-like-beep.wav");
            audio.volume = 0.3;
            audio.play().catch(() => {});
        } catch (e) {}
    }

    // Connect and register user-specific socket connection log
    socket.on('connect', () => {
        console.log('Chat socket connected.');
    });

    socket.on('connect_error', (err) => {
        console.error('[Chat Socket] Connection error:', err.message);
    });

    socket.on('chat_error', (data) => {
        showMessageError(data && data.message ? data.message : 'Unable to send message.');
    });

    socket.on('messages_read', (data) => {
        const rcvId = Number(data.receiver_id);
        const activeId = activeContactId ? Number(activeContactId) : null;
        if (activeId && rcvId === activeId) {
            const greyChecks = document.querySelectorAll('#messagesWindow .fa-check-double');
            greyChecks.forEach(check => {
                check.style.color = '#53bdeb';
            });
        }
    });

    // Restore active chat if stored in localStorage
    function restoreActiveChat() {
        const lastContactId = localStorage.getItem('activeChatContactId');
        const lastContactName = localStorage.getItem('activeChatContactName');
        const lastContactRole = localStorage.getItem('activeChatContactRole');
        
        // Check if we need to redirect to the correct role tab (school admin chat only)
        if (userRoleRaw === 'school_admin') {
            const urlParams = new URLSearchParams(window.location.search);
            const currentFilterRole = urlParams.get('role');
            if (lastContactRole && lastContactRole !== 'undefined' && !currentFilterRole && !window.location.search) {
                window.location.href = `/${currentRole}/chat?role=${lastContactRole}`;
                return;
            }
        }

        if (lastContactId && lastContactName) {
            const contactEl = document.getElementById(`contact-${lastContactId}`);
            if (contactEl) {
                selectContact(parseInt(lastContactId), lastContactName, lastContactRole || '');
            }
        }
    }

    if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', restoreActiveChat);
    } else {
        restoreActiveChat();
    }

    // Receive message
    socket.on('chat_message', (msg) => {
        const msgSenderId = Number(msg.sender_id);
        const msgReceiverId = Number(msg.receiver_id);
        const myUserId = Number(currentUserId);
        const activeId = activeContactId ? Number(activeContactId) : null;

        // If message is for active conversation, append it
        if (activeId && (msgSenderId === activeId || msgSenderId === myUserId)) {
            // Mark incoming message as read locally for UI checkmarks
            if (msgSenderId === activeId) {
                msg.is_read = 1;
                socket.emit('read_messages', { sender_id: activeId });
                fetch(`/${currentRole}/chat/history/${activeId}`);
                playBeep();
            }
            appendMessage(msg);
            scrollMessagesToBottom();
        } else {
            // Otherwise increment contact's unread badge
            const badge = document.querySelector(`#contact-${msgSenderId} .unread-badge`) || document.getElementById(`unread-${msgSenderId}`);
            if (badge) {
                let currentCount = parseInt(badge.textContent.trim()) || 0;
                badge.textContent = currentCount + 1;
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            }

            if (msgSenderId !== myUserId) {
                playBeep();
                if (typeof showToast === 'function') {
                    showToast(`New message from ${msg.sender_name || 'User'}: ${msg.message}`, 'info');
                }
            }
        }

        // Update last message preview in sidebar and move it to top
        const targetContactId = (msgSenderId === myUserId) ? msgReceiverId : msgSenderId;
        const lastMsgEl = document.getElementById(`lastMsg-${targetContactId}`);
        if (lastMsgEl) {
            lastMsgEl.textContent = msg.message;
        }
        const contactEl = document.getElementById(`contact-${targetContactId}`);
        const listEl = document.getElementById('contactsList');
        if (contactEl && listEl) {
            listEl.prepend(contactEl);
        }
    });

    function selectContact(contactId, fullName, role) {
        activeContactId = contactId;
        socket.emit('read_messages', { sender_id: contactId });

        // Save active chat state to localStorage
        localStorage.setItem('activeChatContactId', contactId);
        localStorage.setItem('activeChatContactName', fullName);
        localStorage.setItem('activeChatContactRole', role);

        // Visual highlights
        document.querySelectorAll('.contact-item').forEach(item => item.classList.remove('bg-indigo-light'));
        const contactEl = document.getElementById(`contact-${contactId}`);
        if (contactEl) contactEl.classList.add('bg-indigo-light');

        // Hide badge
        const badge = document.getElementById(`unread-${contactId}`);
        if (badge) {
            badge.classList.add('hidden');
            badge.classList.remove('flex');
            badge.textContent = '0';
        }

        // Populate header
        document.getElementById('activeName').textContent = fullName;
        document.getElementById('activeRole').textContent = (role || '').replace('_', ' ');
        document.getElementById('activeAvatar').textContent = fullName.charAt(0).toUpperCase();

        // Switch panels
        document.getElementById('chatPlaceholder').classList.add('hidden');
        document.getElementById('activeChat').classList.remove('hidden');

        // Fetch history
        fetch(`/${currentRole}/chat/history/${contactId}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    renderMessages(data.messages);
                    updateReadReceipts(data.messages);
                }
            })
            .catch(err => console.error('Failed to load chat history:', err));

        // For mobile layout: hide sidebar
        if (window.innerWidth < 768) {
            document.getElementById('contactsSidebar').classList.add('hidden');
            document.getElementById('chatArea').classList.remove('hidden');
        }
    }

    function renderMessages(messages) {
        const win = document.getElementById('messagesWindow');
        win.innerHTML = '';
        lastDateString = null;
        if (messages && messages.length > 0) {
            messages.forEach(msg => appendMessage(msg));
        } else {
            win.innerHTML = `<div class="text-center text-slate-400 my-8 text-xs"><i class="fas fa-hand-sparkles mb-2 text-2xl text-slate-300"></i><p>Say hello! Start your conversation.</p></div>`;
        }
        scrollMessagesToBottom();
    }

    function appendMessage(msg) {
        const win = document.getElementById('messagesWindow');
        
        // Date separator logic
        const msgDateString = getMessageDateString(msg.created_at);
        if (msgDateString !== lastDateString) {
            lastDateString = msgDateString;
            const dateDivider = document.createElement('div');
            dateDivider.className = 'text-center my-3 w-full';
            dateDivider.innerHTML = `<span class="inline-block bg-white text-slate-500 px-3 py-1.5 border border-slate-200 rounded-full shadow-sm" style="font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">${msgDateString}</span>`;
            win.appendChild(dateDivider);
        }

        const isSelf = Number(msg.sender_id) === Number(currentUserId);

        const wrapper = document.createElement('div');
        wrapper.className = `flex mb-3 ${isSelf ? 'justify-end' : 'justify-start'} message-bubble-wrapper`;
        wrapper.id = `msg-wrapper-${msg.id}`;
        wrapper.setAttribute('data-message-id', msg.id);
        wrapper.setAttribute('data-sender-self', isSelf ? 'true' : 'false');

        const card = document.createElement('div');
        card.style.maxWidth = '70%';
        card.style.borderRadius = '12px';
        card.style.padding = '8px 12px';
        card.className = `shadow-sm relative group ${isSelf ? 'bg-whatsapp-sent rounded-br-0 font-sans' : 'bg-whatsapp-received rounded-bl-0 font-sans'}`;

        const text = document.createElement('p');
        text.className = 'mb-1 text-xs text-slate-800';
        text.style.lineHeight = '1.4';
        text.style.whiteSpace = 'pre-wrap';
        text.style.wordBreak = 'break-word';
        text.textContent = msg.message;
        card.appendChild(text);

        const time = document.createElement('span');
        time.className = `text-[9px] flex items-center justify-end text-slate-400`;
        time.style.fontSize = '9px';
        time.style.marginTop = '4px';
        time.textContent = new Date(msg.created_at).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
        
        if (isSelf) {
            const checkmarks = document.createElement('span');
            checkmarks.className = 'ml-1 read-receipt';
            checkmarks.innerHTML = msg.is_read === 1 
                ? '<i class="fas fa-check-double text-blue-400" style="font-size: 10px;"></i>' 
                : '<i class="fas fa-check text-gray-300" style="font-size: 10px;"></i>';
            time.appendChild(checkmarks);

            const deleteBtn = document.createElement('button');
            deleteBtn.onclick = function() { deleteMsg(msg.id, deleteBtn); };
            deleteBtn.className = 'delete-msg-btn absolute -top-2 -right-2 hidden group-hover:flex w-5 h-5 rounded-full bg-red-100 text-red-500 items-center justify-center text-[10px] hover:bg-red-200 transition shadow-sm';
            deleteBtn.title = 'Delete message';
            deleteBtn.innerHTML = '<i class="fas fa-times"></i>';
            card.appendChild(deleteBtn);
        }
        card.appendChild(time);

        wrapper.appendChild(card);
        win.appendChild(wrapper);
    }

    function handleSendMessage(e) {
        e.preventDefault();
        const input = document.getElementById('messageInput');
        const text = input.value.trim();
        clearMessageError();
        if (!activeContactId) {
            showMessageError('Select a contact before sending a message.');
            return;
        }
        if (!text) {
            showMessageError('Message content is required.');
            return;
        }
        if (text.length > 1000) {
            showMessageError('Message must be 1000 characters or fewer.');
            return;
        }

        const messagePayload = {
            receiver_id: activeContactId,
            message: text
        };

        // Emit via Sockets (Real-Time) if connected, otherwise fallback to HTTP POST
        if (socket && socket.connected) {
            socket.emit('send_chat_message', messagePayload);
            input.value = '';
        } else {
            console.warn('[Chat] Socket disconnected. Sending message via HTTP fallback...');
            fetch(`/${currentRole}/chat/send`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(messagePayload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    appendMessage(data.message);
                    scrollMessagesToBottom();
                    input.value = '';
                } else {
                    console.error('[Chat] HTTP send message failed:', data.message);
                    alert('Failed to send message: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(err => {
                console.error('[Chat] HTTP send error:', err);
                alert('Connection error. Failed to send message.');
            });
        }
    }

    function showMessageError(message) {
        const el = document.getElementById('messageError');
        if (el) {
            el.textContent = message;
            el.style.display = 'inline';
        }
    }

    // Clear error
    function clearMessageError() {
        const el = document.getElementById('messageError');
        if (el) {
            el.textContent = '';
            el.style.display = 'none';
        }
    }

    // contacts list filter
    function filterContacts() {
        const query = document.getElementById('searchContacts').value.toLowerCase();
        document.querySelectorAll('.contact-item').forEach(item => {
            const name = item.getAttribute('data-name').toLowerCase();
            if (name.includes(query)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function showContactsSidebar() {
        document.getElementById('contactsSidebar').classList.remove('hidden');
        document.getElementById('chatArea').classList.add('hidden');
    }

    function toggleEmojiPicker(e) {
        if (e) e.stopPropagation();
        const picker = document.getElementById('emojiPicker');
        if (picker) {
            picker.style.display = picker.style.display === 'none' ? 'block' : 'none';
        }
    }

    function initEmojiPicker() {
        const grid = document.getElementById('emojiGrid');
        if (!grid) return;
        
        const emojis = [
            '😀','😃','😄','😁','😆','😅','😂','🤣','😊','😇','🙂','🙃','😉','😌','😍','🥰','😘','😗','😙','😚','😋','😛','😝','😜','🤪','🤨','🧐','🤓','😎','🥸','🤩','🥳','😏','😒','😞','😔','😟','😕','🙁','☹️','😣','😖','😫','😩','🥺','😢','😭','😤','😠','😡','🤬','🤯','😳','🥵','🥶','😱','😨','😰','😥','😓','🤔','🫣','🤭','🫢','🫡','🤫','🫠','🤥','😶','🫥','😐','😑','😬',
            '👍','👎','👌','✌️','🤞','🤟','🤘','🤙','👈','👉','👆','🖕','👇','☝️','🤝','👏','🙌','🫶','👐','🤲','✍️','🙏','💅','🤳','💪','🦾','🦿','🦵','🦶','👂','🦻','👃','🧠','🫀','🫁','🦷','🦴','👀','👁','👅','👄','💋',
            '❤️','🧡','💛','💚','💙','💜','🖤','🤍','🤎','💔','❣️','💕','💞','💓','💗','💖','💘','💝','💟',
            '🔥','✨','🌟','⭐','🎈','🎉','🎊','🚀','💯','🎂','🍕','🍺','☕️','✈️','🚗','📞','💻','📱','🔒','🔑'
        ];
        
        grid.innerHTML = '';
        emojis.forEach(emoji => {
            const el = document.createElement('span');
            el.className = 'emoji-item';
            el.textContent = emoji;
            el.addEventListener('click', () => {
                const input = document.getElementById('messageInput');
                if (input) {
                    const start = input.selectionStart;
                    const end = input.selectionEnd;
                    const text = input.value;
                    input.value = text.substring(0, start) + emoji + text.substring(end);
                    const newPos = start + emoji.length;
                    input.setSelectionRange(newPos, newPos);
                    input.focus();
                }
            });
            grid.appendChild(el);
        });
    }

    // Call initEmojiPicker when document is ready
    if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', initEmojiPicker);
    } else {
        initEmojiPicker();
    }

    // Dismiss picker when clicking elsewhere
    document.addEventListener('click', (event) => {
        const picker = document.getElementById('emojiPicker');
        const btn = document.getElementById('emojiToggleBtn');
        if (picker && btn && !picker.contains(event.target) && !btn.contains(event.target)) {
            picker.style.display = 'none';
        }
    });

    // Auto-adjust layout on resize
    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            document.getElementById('contactsSidebar').classList.remove('hidden');
            document.getElementById('chatArea').classList.remove('hidden');
        }
    });

    const messageInput = document.getElementById('messageInput');
    const messageCounter = document.getElementById('messageCounter');
    if (messageInput && messageCounter) {
        messageInput.addEventListener('input', () => {
            messageCounter.textContent = `${messageInput.value.length}/1000`;
            if (messageInput.value.length <= 1000) clearMessageError();
        });
    }

    // Online status tracking
    const onlineUserIds = new Set();

    function updateStatusDot(userId, isOnline) {
      const dot = document.getElementById(`dot-${userId}`);
      if (!dot) return;
      dot.classList.remove('bg-gray-300', 'bg-emerald-500');
      dot.classList.add(isOnline ? 'bg-emerald-500' : 'bg-gray-300');
      dot.title = isOnline ? 'Online' : 'Offline';
    }

    // Receive initial online list
    socket.on('online_users_list', (data) => {
      (data.userIds || []).forEach(id => {
        onlineUserIds.add(id);
        updateStatusDot(id, true);
      });
    });

    // Someone came online
    socket.on('user_online', (data) => {
      onlineUserIds.add(data.userId);
      updateStatusDot(data.userId, true);
    });

    // Someone went offline
    socket.on('user_offline', (data) => {
      onlineUserIds.delete(data.userId);
      updateStatusDot(data.userId, false);
    });

    // Request online users on page load
    socket.emit('get_online_users');

    let typingTimeout = null;
    let isTyping = false;

    // Get the message input — adjust selector if needed
    const msgInput = document.getElementById('messageInput')
      || document.querySelector('input[name="message"]')
      || document.querySelector('textarea[name="message"]');

    if (msgInput) {
      msgInput.addEventListener('input', () => {
        // Only emit if we have an active contact
        const contactId = getActiveContactId();
        if (!contactId) return;

        if (!isTyping) {
          isTyping = true;
          socket.emit('typing_start', { receiver_id: contactId });
        }

        clearTimeout(typingTimeout);
        typingTimeout = setTimeout(() => {
          isTyping = false;
          socket.emit('typing_stop', { receiver_id: contactId });
        }, 1500);
      });

      // Stop typing on send
      msgInput.closest('form')?.addEventListener('submit', () => {
        isTyping = false;
        clearTimeout(typingTimeout);
        const contactId = getActiveContactId();
        if (contactId) socket.emit('typing_stop', { receiver_id: contactId });
      });
    }

    // Receive typing events
    let typingHideTimeout = null;

    socket.on('user_typing', (data) => {
      // Only show if from active contact
      const contactId = getActiveContactId();
      if (!contactId || data.sender_id !== contactId) return;

      const indicator = document.getElementById('typingIndicator');
      const nameEl = document.getElementById('typingName');
      if (!indicator) return;

      if (nameEl) nameEl.textContent = data.sender_name || 'Contact';
      indicator.classList.remove('hidden');

      clearTimeout(typingHideTimeout);
      typingHideTimeout = setTimeout(() => {
        indicator.classList.add('hidden');
      }, 2000);
    });

    socket.on('user_typing_stopped', (data) => {
      const contactId = getActiveContactId();
      if (!contactId || data.sender_id !== contactId) return;

      const indicator = document.getElementById('typingIndicator');
      if (indicator) indicator.classList.add('hidden');
      clearTimeout(typingHideTimeout);
    });

    // Helper — get active contact id
    // Looks for the most common patterns used in SchoolSync chat views
    function getActiveContactId() {
      // Try global variable first
      if (typeof activeContactId !== 'undefined' && activeContactId) {
        return parseInt(activeContactId, 10);
      }
      // Try selected contact element
      const selected = document.querySelector('.contact-item.active, .contact-item.selected');
      if (selected && selected.dataset.userId) {
        return parseInt(selected.dataset.userId, 10);
      }
      // Try URL param
      const urlParams = new URLSearchParams(window.location.search);
      const withParam = urlParams.get('with') || urlParams.get('contact');
      if (withParam) return parseInt(withParam, 10);

      return null;
    }

    async function deleteMsg(messageId, btn) {
      if (!confirm('Delete this message?')) return;

      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

      try {
        const res = await fetch(`/${currentRole}/chat/message/${messageId}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();

        if (data.success) {
          // Find and hide the message bubble wrapper
          const wrapper = btn.closest('.message-bubble-wrapper');
          if (wrapper) {
            wrapper.innerHTML = `
              <div class="text-[10px] text-gray-300 italic px-2 py-1">
                Message deleted
              </div>`;
          }
        } else {
          btn.disabled = false;
          btn.innerHTML = originalHTML;
          alert(data.message || 'Failed to delete message');
        }
      } catch {
        btn.disabled = false;
        btn.innerHTML = originalHTML;
        alert('Request failed. Try again.');
      }
    }

    // Handle incoming delete event from socket
    // (when the other person deletes a message we received)
    socket.on('chat_message_deleted', (data) => {
      const { message_id } = data;
      if (!message_id) return;

      // Find message element by data-message-id attribute
      const msgEl = document.querySelector(`[data-message-id="${message_id}"]`);
      if (msgEl) {
        const wrapper = msgEl.closest('.message-bubble-wrapper') || msgEl;
        wrapper.innerHTML = `
          <div class="text-[10px] text-gray-300 italic px-2 py-1">
            Message deleted
          </div>`;
      }
    });

    let searchDebounce = null;

    function toggleMsgSearch() {
      const bar = document.getElementById('msgSearchBar');
      if (!bar) return;
      const isHidden = bar.classList.contains('hidden');
      bar.classList.toggle('hidden', !isHidden);
      if (isHidden) {
        document.getElementById('msgSearchInput')?.focus();
      } else {
        // Clear search on close
        const input = document.getElementById('msgSearchInput');
        if (input) input.value = '';
        const results = document.getElementById('searchResults');
        if (results) {
          results.innerHTML = '';
          results.classList.add('hidden');
        }
      }
    }

    document.getElementById('msgSearchInput')?.addEventListener('input', (e) => {
      clearTimeout(searchDebounce);
      const q = e.target.value.trim();
      const results = document.getElementById('searchResults');

      if (q.length < 2) {
        if (results) {
          results.innerHTML = '';
          results.classList.add('hidden');
        }
        return;
      }

      searchDebounce = setTimeout(async () => {
        const contactId = getActiveContactId();
        if (!contactId) return;

        try {
          const res = await fetch(
            `/${currentRole}/chat/search?q=${encodeURIComponent(q)}&with=${contactId}`
          );
          const data = await res.json();
          if (!results) return;

          if (!data.success || data.messages.length === 0) {
            results.innerHTML = `
              <p class="text-xs text-gray-400 px-2 py-1">No messages found</p>`;
            results.classList.remove('hidden');
            return;
          }

          // Highlight matched text
          const highlight = (text, term) => {
            const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return text.replace(
              new RegExp(escaped, 'gi'),
              match => `<mark class="bg-yellow-100 rounded px-0.5">${match}</mark>`
            );
          };

          results.innerHTML = data.messages.map(m => `
            <div class="px-2 py-1.5 rounded hover:bg-slate-50 cursor-pointer text-xs border-b border-slate-50"
                 onclick="scrollToMessage(${m.id})">
              <p class="text-gray-600">${highlight(m.message, q)}</p>
              <p class="text-[10px] text-gray-300 mt-0.5">
                ${new Date(m.created_at).toLocaleString('en-IN', {
                  day: '2-digit', month: 'short',
                  hour: '2-digit', minute: '2-digit'
                })}
              </p>
            </div>
          `).join('');
          results.classList.remove('hidden');

        } catch (err) {
          console.error('Message search failed:', err);
        }
      }, 300);
    });

    function scrollToMessage(messageId) {
      const el = document.querySelector(`[data-message-id="${messageId}"]`);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.add('ring-2', 'ring-yellow-300', 'rounded-lg');
        setTimeout(() => el.classList.remove('ring-2', 'ring-yellow-300', 'rounded-lg'), 2000);
      }
      // Close search bar after clicking result
      toggleMsgSearch();
    }

    async function markAllReadFromActive() {
      const contactId = getActiveContactId();
      if (!contactId) return;

      try {
        const res = await fetch(`/${currentRole}/chat/mark-all-read`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sender_id: contactId })
        });
        const data = await res.json();

        if (data.success) {
          // Clear unread badge on contact
          const badge = document.querySelector(
            `[data-user-id="${contactId}"] .unread-badge`
          ) || document.getElementById(`unread-${contactId}`);
          if (badge) {
            badge.classList.add('hidden');
            badge.classList.remove('flex');
            badge.textContent = '0';
          }

          // Update header unread count to 0
          const countEl = document.getElementById('headerUnreadCount') || document.getElementById('unreadMessagesBadge');
          if (countEl) {
            countEl.textContent = '0';
            countEl.classList.add('hidden');
          }
        }
      } catch (err) {
        console.error('Mark all read failed:', err);
      }
    }

    function updateReadReceipts(messages) {
      messages.forEach(m => {
        const el = document.querySelector(`[data-message-id="${m.id}"]`);
        if (!el) return;

        const tickEl = el.querySelector('.read-receipt');
        if (!tickEl) return;

        if (m.is_read) {
          tickEl.innerHTML = '<i class="fas fa-check-double text-blue-400" style="font-size: 10px;"></i>';
          tickEl.title = 'Read';
        } else {
          tickEl.innerHTML = '<i class="fas fa-check text-gray-300" style="font-size: 10px;"></i>';
          tickEl.title = 'Sent';
        }
      });
    }

    // Listen for real-time read receipt update
    // When receiver reads messages, sender gets notified
    socket.on('messages_read', (data) => {
      const { receiver_id } = data;
      const rcvId = Number(receiver_id || data.sender_id);
      const activeId = activeContactId ? Number(activeContactId) : null;
      if (activeId && rcvId === activeId) {
          document.querySelectorAll('.message-bubble-wrapper[data-sender-self="true"] .read-receipt')
            .forEach(el => {
              el.innerHTML = '<i class="fas fa-check-double text-blue-400" style="font-size: 10px;"></i>';
              el.title = 'Read';
            });
      }
    });

    // Expose interactive functions to the global window object
    window.selectContact = selectContact;
    window.handleSendMessage = handleSendMessage;
    window.filterContacts = filterContacts;
    window.showContactsSidebar = showContactsSidebar;
    window.toggleEmojiPicker = toggleEmojiPicker;
    window.toggleMsgSearch = toggleMsgSearch;
    window.markAllReadFromActive = markAllReadFromActive;
    window.deleteMsg = deleteMsg;
    window.scrollToMessage = scrollToMessage;
})();
</script>

