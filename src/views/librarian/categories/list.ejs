<div class="lib-page-shell">
  <section class="lib-hero">
    <div class="lib-hero-content">
      <div>
        <span class="lib-eyebrow"><i class="fas fa-tags"></i> <%- lan.Library_Taxonomy %></span>
        <h1><%- lan.Book_Categories %></h1>
        <p><%- lan.Book_Categories_Subtitle %></p>
      </div>
    </div>
  </section>
  <div class="lib-panel" style="margin-bottom:18px;">
    <div class="lib-panel-header">
      <h2><i class="fas fa-plus"></i> <%- lan.Add_Category %></h2>
    </div>
    <div class="lib-panel-body">
      <form method="POST" action="/librarian/categories" class="lib-search-form">
        <input type="hidden" name="id" id="catId">
        <input type="text" name="name" placeholder="<%= lan.Category_Name_Placeholder %>" required>
        <select name="type">
          <option value="general"><%- lan.General %></option>
          <option value="subject"><%- lan.Subject %></option>
          <option value="class"><%- lan.Class %></option>
        </select>
        <button class="lib-btn primary"><i class="fas fa-save"></i> <%- lan.Save_Category %></button>
      </form>
    </div>
  </div>
  <div class="lib-table-card">
    <div class="lib-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th><%- lan.Name %></th>
            <th><%- lan.Type %></th>
            <th><%- lan.Status %></th>
            <th><%- lan.Actions %></th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach(c=> { %>
            <tr>
              <td><span class="category-pill"><i class="fas fa-tag"></i>
                  <%= c.name %>
                </span></td>
              <td>
                <%= c.type %>
              </td>
              <td><span class="badge badge-<%= c.status %>">
                  <%= c.status %>
                </span></td>
              <td>
                <form method="POST" action="/librarian/categories/<%= c.id %>/delete" class="inline"
                  onsubmit="return confirm('Delete this category?')">
                  <button class="lib-btn danger" style="min-height:32px;padding:6px 10px;font-size:12px;"><i
                      class="fas fa-trash-can"></i> <%- lan.Delete %></button>
                </form>
              </td>
            </tr>
            <% }) %>
              <% if (!categories.length) { %>
                <tr>
                  <td colspan="4" class="empty">
                    <div class="lib-empty-icon"><i class="fas fa-tags"></i></div>
                    <div class="lib-empty-title"><%- lan.No_Categories_Created %></div>
                  </td>
                </tr>
                <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>