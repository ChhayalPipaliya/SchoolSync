<div class="lib-page-shell">
  <section class="lib-hero">
    <div class="lib-hero-content">
      <div>
        <span class="lib-eyebrow"><i class="fas fa-boxes-stacked"></i> Library Storage</span>
        <h1>Racks & Shelves</h1>
        <p>Organize physical book locations using rack number, shelf number, location and capacity.</p>
      </div>
    </div>
  </section>

  <div class="lib-panel" style="margin-bottom:18px;">
    <div class="lib-panel-header"><h2><i class="fas fa-plus"></i> Add Rack</h2></div>
    <div class="lib-panel-body">
      <form method="POST" action="/librarian/racks" class="lib-search-form">
        <input type="hidden" name="id" id="rackId">
        <input type="text" name="rack_number" placeholder="Rack #" required>
        <input type="text" name="shelf_number" placeholder="Shelf #">
        <input type="text" name="location" placeholder="Location">
        <input type="number" name="capacity" placeholder="Capacity">
        <button class="lib-btn primary"><i class="fas fa-save"></i> Save Rack</button>
      </form>
    </div>
  </div>

  <div class="lib-table-card">
    <div class="lib-table-wrap">
      <table class="data-table">
        <thead><tr><th>Rack</th><th>Shelf</th><th>Location</th><th>Capacity</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% racks.forEach(r => { %>
          <tr>
            <td><span class="rack-badge"><i class="fas fa-boxes-stacked"></i> <%= r.rack_number %></span></td>
            <td><%= r.shelf_number || '-' %></td>
            <td><%= r.location || '-' %></td>
            <td><strong><%= r.capacity || '-' %></strong></td>
            <td><span class="badge badge-<%= r.status %>"><%= r.status %></span></td>
            <td>
              <form method="POST" action="/librarian/racks/<%= r.id %>/delete" class="inline" onsubmit="return confirm('Delete this rack?')">
                <button class="lib-btn danger" style="min-height:32px;padding:6px 10px;font-size:12px;"><i class="fas fa-trash-can"></i> Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if (!racks.length) { %><tr><td colspan="6" class="empty"><div class="lib-empty-icon"><i class="fas fa-box-open"></i></div><div class="lib-empty-title">No racks created</div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
