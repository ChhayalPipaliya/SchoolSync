<div class="lib-page-shell">
  <section class="lib-hero">
    <div class="lib-hero-content">
      <div>
        <span class="lib-eyebrow"><i class="fas fa-boxes-stacked"></i> <%- lan.Library_Storage %></span>
        <h1><%- lan.Racks_And_Shelves %></h1>
        <p><%- lan.Racks_Shelves_Subtitle %></p>
      </div>
    </div>
  </section>
  <div class="lib-panel" style="margin-bottom:18px;">
    <div class="lib-panel-header"><h2><i class="fas fa-plus"></i> <%- lan.Add_Rack %></h2></div>
    <div class="lib-panel-body">
      <form method="POST" action="/librarian/racks" class="lib-search-form">
        <input type="hidden" name="id" id="rackId">
        <input type="text" name="rack_number" placeholder="<%= lan.Rack_Number_Placeholder %>" required>
        <input type="text" name="shelf_number" placeholder="<%= lan.Shelf_Number_Placeholder %>">
        <input type="text" name="location" placeholder="<%= lan.Location %>">
        <input type="number" name="capacity" placeholder="<%= lan.Capacity %>">
        <button class="lib-btn primary"><i class="fas fa-save"></i> <%- lan.Save_Rack %></button>
      </form>
    </div>
  </div>
  <div class="lib-table-card">
    <div class="lib-table-wrap">
      <table class="data-table">
        <thead><tr><th><%- lan.Rack %></th><th><%- lan.Shelf %></th><th><%- lan.Location %></th><th><%- lan.Capacity %></th><th><%- lan.Status %></th><th><%- lan.Actions %></th></tr></thead>
        <tbody>
          <% racks.forEach(r => { %>
          <tr>
            <td><span class="rack-badge"><i class="fas fa-boxes-stacked"></i> <%= r.rack_number %></span></td>
            <td><%= r.shelf_number || '-' %></td>
            <td><%= r.location || '-' %></td>
            <td><strong><%= r.capacity || '-' %></strong></td>
            <td><span class="badge badge-<%= r.status %>"><%= r.status %></span></td>
            <td>
              <form method="POST" action="/librarian/racks/<%= r.id %>/delete" class="inline" onsubmit="return confirm('Delete this rack?')">
                <button class="lib-btn danger" style="min-height:32px;padding:6px 10px;font-size:12px;"><i class="fas fa-trash-can"></i> <%- lan.Delete %></button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if (!racks.length) { %><tr><td colspan="6" class="empty"><div class="lib-empty-icon"><i class="fas fa-box-open"></i></div><div class="lib-empty-title"><%- lan.No_Racks_Created %></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>