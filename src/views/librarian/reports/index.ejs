<div class="lib-page-shell">
  <section class="lib-hero">
    <div class="lib-hero-content">
      <div>
        <span class="lib-eyebrow"><i class="fas fa-chart-line"></i> Library Analytics</span>
        <h1>Reports</h1>
        <p>Monitor monthly circulation, most issued books and recent library activity logs.</p>
      </div>
      <div class="lib-hero-actions">
        <a href="/librarian/books" class="lib-action-btn ghost"><i class="fas fa-book"></i> Inventory</a>
      </div>
    </div>
  </section>

  <div class="lib-grid-2">
    <div class="lib-panel h-100">
      <div class="lib-panel-header"><h2><i class="fas fa-calendar-days"></i> Monthly Activity</h2></div>
      <div class="lib-table-wrap">
        <table class="data-table">
          <thead><tr><th>Month</th><th>Issued</th><th>Returned</th></tr></thead>
          <tbody>
            <% monthly.forEach(m => { %>
            <tr>
              <td><strong><%= m.month %></strong></td>
              <td><span class="badge badge-issued"><%= m.issued %></span></td>
              <td><span class="badge badge-returned"><%= m.returned %></span></td>
            </tr>
            <% }) %>
            <% if (!monthly.length) { %><tr><td colspan="3" class="empty">No data</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="lib-panel">
      <div class="lib-panel-header"><h2><i class="fas fa-star"></i> Most Issued Books</h2></div>
      <div class="lib-panel-body">
        <% if (mostIssued.length) { %>
          <div class="lib-list-stack">
            <% mostIssued.forEach(b => { %>
              <div class="lib-list-item">
                <div>
                  <div class="lib-title-main"><%= b.title %></div>
                  <div class="lib-title-sub"><%= b.author || '-' %></div>
                </div>
                <span class="badge badge-issued"><%= b.issue_count %> issues</span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="lib-empty-state"><div class="lib-empty-icon"><i class="fas fa-chart-simple"></i></div><div class="lib-empty-title">No data</div></div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="lib-panel" style="margin-top:18px;">
    <div class="lib-panel-header"><h2><i class="fas fa-clipboard-list"></i> Recent Activity Logs</h2></div>
    <div class="lib-table-wrap">
      <table class="data-table">
        <thead><tr><th>Action</th><th>Entity</th><th>By</th><th>Time</th></tr></thead>
        <tbody>
          <% activities.forEach(a => { %>
          <tr>
            <td><span class="badge badge-issued"><%= a.action %></span></td>
            <td><%= a.entity_type %> #<%= a.entity_id %></td>
            <td><%= a.first_name || 'System' %> <%= a.last_name || '' %></td>
            <td><%= a.created_at %></td>
          </tr>
          <% }) %>
          <% if (!activities.length) { %><tr><td colspan="4" class="empty">No activity</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
