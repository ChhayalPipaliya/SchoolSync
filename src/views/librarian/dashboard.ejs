<%
  const totalBks = typeof stats !== 'undefined' && stats.totalBooks !== undefined ? stats.totalBooks : 20;
  const totalCopies = typeof stats !== 'undefined' && stats.totalCopies !== undefined ? stats.totalCopies : 100;
  const availableCopies = typeof stats !== 'undefined' && stats.availableCopies !== undefined ? stats.availableCopies : 95;
  const issuedBks = typeof stats !== 'undefined' && stats.currentlyIssued !== undefined ? stats.currentlyIssued : 5;
  const issuedTodayCount = typeof stats !== 'undefined' && stats.issuedToday !== undefined ? stats.issuedToday : 0;
  const overdueBks = typeof stats !== 'undefined' && stats.overdueCount !== undefined ? stats.overdueCount : 2;
  const returnedTodayCount = typeof stats !== 'undefined' && stats.returnedToday !== undefined ? stats.returnedToday : 3;
  const totalMbrs = typeof stats !== 'undefined' && stats.totalMembers !== undefined ? stats.totalMembers : 362;
  const totalFns = typeof stats !== 'undefined' && stats.fineCollection !== undefined ? Number(stats.fineCollection) : 420;
  const listRecentIssues = typeof recentIssues !== 'undefined' && recentIssues ? recentIssues : [];
  const listOverdue = typeof overdueBooks !== 'undefined' && overdueBooks ? overdueBooks : [];
  const listPopularBooks = typeof popularBooks !== 'undefined' && popularBooks ? popularBooks : [];
  const listCategories = typeof categories !== 'undefined' && categories ? categories : [];
  const listNotices = typeof notices !== 'undefined' && notices ? notices : [];
  const listActivities = typeof activities !== 'undefined' && activities ? activities : [];
%>

<style>
    :root {
        --lib-primary: #ec4899;
        --lib-purple: #8b5cf6;
        --lib-gradient: linear-gradient(135deg, #ec4899 0%, #d946ef 50%, #8b5cf6 100%);
        --lib-bg: #f8fafc;
        --lib-card: #ffffff;
        --lib-border: #e2e8f0;
        --lib-text: #0f172a;
        --lib-muted: #64748b;
        --lib-shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
        --lib-shadow-md: 0 10px 30px -10px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.03);
        --lib-shadow-lg: 0 20px 50px -15px rgba(236, 72, 153, 0.35);
    }

    .l-dash-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--lib-text);
        padding-bottom: 40px;
    }

    .l-hero-card {
        background: var(--lib-gradient);
        border-radius: 24px;
        padding: 10px 12px;
        color: #ffffff;
        position: relative;
        overflow: hidden;
        box-shadow: var(--lib-shadow-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .l-hero-card::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 260px; height: 260px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        pointer-events: none;
    }
    .l-hero-card::after {
        content: '';
        position: absolute;
        bottom: -80px; right: 160px;
        width: 220px; height: 220px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        pointer-events: none;
    }
    .l-hero-left {
        position: relative;
        z-index: 2;
        max-width: 680px;
    }
    .l-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 12px;
    }
    .l-hero-title {
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 6px 0;
        letter-spacing: -0.02em;
    }
    .l-hero-sub {
        font-size: 14px;
        opacity: 0.92;
        margin: 0 0 20px 0;
        line-height: 1.5;
    }
    .l-hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    .l-hero-btn {
        background: #ffffff;
        color: #db2777;
        padding: 10px 18px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .l-hero-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }
    .l-hero-btn.outline {
        background: rgba(255, 255, 255, 0.15);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .l-hero-btn.outline:hover { background: rgba(255, 255, 255, 0.28); }

    .l-hero-right {
        position: relative;
        z-index: 2;
    }
    .l-hero-chips {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 20px;
        padding: 18px;
        min-width: 360px;
    }
    .l-chip-item { text-align: center; }
    .l-chip-val { font-size: 20px; font-weight: 800; display: block; line-height: 1; }
    .l-chip-lbl { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.85; margin-top: 4px; display: block; }

    .l-analytics-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 14px;
    }
    .l-stat-card {
        background: var(--lib-card);
        border: 1px solid var(--lib-border);
        border-radius: 18px;
        padding: 16px 14px;
        box-shadow: var(--lib-shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 8px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .l-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--lib-shadow-md);
    }
    .l-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .l-stat-icon {
        width: 34px; height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }
    .l-stat-icon.pink { background: #fce7f3; color: #db2777; }
    .l-stat-icon.purple { background: #ede9fe; color: #7c3aed; }
    .l-stat-icon.blue { background: #dbeafe; color: #1d4ed8; }
    .l-stat-icon.emerald { background: #d1fae5; color: #047857; }
    .l-stat-icon.rose { background: #ffe4e6; color: #be123c; }
    .l-stat-icon.amber { background: #fef3c7; color: #b45309; }

    .l-stat-val { font-size: 22px; font-weight: 800; color: var(--lib-text); line-height: 1; }
    .l-stat-lbl { font-size: 11px; font-weight: 600; color: var(--lib-muted); }

    .l-main-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
    }
    .l-left-col { display: flex; flex-direction: column; gap: 24px; }
    .l-right-col { display: flex; flex-direction: column; gap: 24px; }

    .l-panel {
        background: var(--lib-card);
        border: 1px solid var(--lib-border);
        border-radius: 20px;
        padding: 10px 12px;
        box-shadow: var(--lib-shadow-sm);
    }
    .l-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }
    .l-panel-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--lib-text);
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
    }
    .l-panel-title i { color: #db2777; }
    .l-panel-link { font-size: 12px; font-weight: 700; color: #db2777; text-decoration: none; }
    .l-panel-link:hover { text-decoration: underline; }

    .l-table-wrap { overflow-x: auto; }
    .l-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; }
    .l-table th { padding: 10px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--lib-muted); background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
    .l-table td { padding: 12px 14px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .l-table tr:last-child td { border-bottom: none; }
    .l-badge { padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; }
    .l-badge.issued { background: #e0e7ff; color: #4338ca; }
    .l-badge.returned { background: #d1fae5; color: #047857; }
    .l-badge.overdue { background: #fee2e2; color: #b91c1c; }
    .l-badge.renewed { background: #fef3c7; color: #b45309; }

    .l-timeline-list { display: flex; flex-direction: column; gap: 12px; position: relative; }
    .l-timeline-list::before { content: ''; position: absolute; top: 10px; bottom: 10px; left: 19px; width: 2px; background: #e2e8f0; z-index: 1; }
    .l-tl-item { display: flex; align-items: center; gap: 16px; position: relative; z-index: 2; background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 14px; padding: 12px 16px; }
    .l-tl-dot { width: 10px; height: 10px; border-radius: 50%; border: 2px solid #ffffff; box-shadow: 0 0 0 3px #ec4899; background: #ec4899; flex-shrink: 0; }

    .l-dual-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }

    .l-widget-card { background: var(--lib-card); border: 1px solid var(--lib-border); border-radius: 18px; padding: 18px 20px; box-shadow: var(--lib-shadow-sm); }
    .l-widget-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; font-size: 14px; font-weight: 800; color: var(--lib-text); }

    .l-qa-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 12px; }
    .l-qa-btn {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 16px 10px;
        text-align: center;
        text-decoration: none;
        color: var(--lib-text);
        font-size: 11px;
        font-weight: 700;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        transition: transform 0.2s, background 0.2s;
    }
    .l-qa-btn:hover { transform: translateY(-2px); background: #ffffff; box-shadow: var(--lib-shadow-md); }

    @media (max-width: 1400px) { .l-analytics-grid { grid-template-columns: repeat(4, 1fr); } }
    @media (max-width: 1200px) {
        .l-main-layout { grid-template-columns: 1fr; }
        .l-hero-card { flex-direction: column; align-items: flex-start; gap: 20px; }
        .l-hero-chips { width: 100%; }
        .l-qa-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media (max-width: 768px) {
        .l-analytics-grid { grid-template-columns: repeat(2, 1fr); }
        .l-dual-grid { grid-template-columns: 1fr; }
        .l-qa-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
<div class="l-dash-container reveal">
    <section class="l-hero-card" aria-label="Library Welcome Banner">
        <div class="l-hero-left">
            <div class="l-hero-badge">
                <i class="fas fa-book-open"></i>
                <span>SchoolSync Central Library ERP</span>
            </div>
            <h1 class="l-hero-title">
                Welcome Back, Librarian! 📚
            </h1>
            <p class="l-hero-sub">
                Manage books, inventory, issue-return operations and library analytics from one intelligent dashboard.
            </p>
            <div class="l-hero-actions">
                <a href="/librarian/books/add" class="l-hero-btn"><i class="fas fa-plus-circle"></i> Add New Book</a>
                <a href="/librarian/issues/new" class="l-hero-btn outline"><i class="fas fa-hand-holding-heart"></i> Issue Book</a>
                <a href="/librarian/issues" class="l-hero-btn outline"><i class="fas fa-undo"></i> Receive Book</a>
            </div>
        </div>
        <div class="l-hero-right" style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">
            <%- include('../partials/hero-illustration', { illustrationSrc: '/illustrations/librarian.png', illustrationAlt: 'Library Dashboard' }) %>
            <div class="l-hero-chips">
                <div class="l-chip-item">
                    <span class="l-chip-val"><%= totalBks %></span>
                    <span class="l-chip-lbl">Titles</span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val"><%= totalCopies %></span>
                    <span class="l-chip-lbl">Copies</span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val" style="color:#6ee7b7;"><%= availableCopies %></span>
                    <span class="l-chip-lbl">Available</span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val"><%= issuedBks %></span>
                    <span class="l-chip-lbl">Issued</span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val" style="color:#fca5a5;"><%= overdueBks %></span>
                    <span class="l-chip-lbl">Overdue</span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val">7</span>
                    <span class="l-chip-lbl">Reservations</span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val">34</span>
                    <span class="l-chip-lbl">Visitors</span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val" style="color:#fde047;">₹<%= totalFns %></span>
                    <span class="l-chip-lbl">Fine Today</span>
                </div>
            </div>
        </div>
    </section>
    <section class="l-analytics-grid" aria-label="Quick Analytics">
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl">Book Titles</span>
                <div class="l-stat-icon pink"><i class="fas fa-book"></i></div>
            </div>
            <div class="l-stat-val"><%= totalBks %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl">Total Members</span>
                <div class="l-stat-icon purple"><i class="fas fa-users"></i></div>
            </div>
            <div class="l-stat-val"><%= totalMbrs %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl">Issued Today</span>
                <div class="l-stat-icon blue"><i class="fas fa-hand-holding-heart"></i></div>
            </div>
            <div class="l-stat-val"><%= issuedTodayCount %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl">Returned Today</span>
                <div class="l-stat-icon emerald"><i class="fas fa-undo-alt"></i></div>
            </div>
            <div class="l-stat-val"><%= returnedTodayCount %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl">Overdue</span>
                <div class="l-stat-icon rose"><i class="fas fa-clock-rotate-left"></i></div>
            </div>
            <div class="l-stat-val" style="color:#be123c;"><%= overdueBks %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl">Reservations</span>
                <div class="l-stat-icon amber"><i class="fas fa-bookmark"></i></div>
            </div>
            <div class="l-stat-val">7</div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl">Fine Today</span>
                <div class="l-stat-icon emerald"><i class="fas fa-indian-rupee-sign"></i></div>
            </div>
            <div class="l-stat-val" style="color:#047857;">₹<%= totalFns %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl">New Books</span>
                <div class="l-stat-icon pink"><i class="fas fa-plus-circle"></i></div>
            </div>
            <div class="l-stat-val">5</div>
        </div>
    </section>
    <div class="l-main-layout">
        <div class="l-left-col">
            <div class="l-panel">
                <div class="l-panel-header">
                    <h3 class="l-panel-title"><i class="fas fa-clock-rotate-left"></i> Recently Issued Books</h3>
                    <a href="/librarian/issues" class="l-panel-link">View All Issues →</a>
                </div>
                <div class="l-table-wrap">
                    <table class="l-table">
                        <thead>
                            <tr>
                                <th>Book Title</th>
                                <th>Member Name</th>
                                <th>Issue Date</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% listRecentIssues.forEach(issue => { %>
                                <% const due = issue.due_date || issue.dueDate ? new Date(issue.due_date || issue.dueDate) : null; const isOverdue = due ? (due < new Date() && !issue.return_date && !issue.returnedAt) : false; %>
                                <tr>
                                    <td>
                                        <div style="font-weight:700;color:var(--lib-text);"><%= issue.bookTitle || '—' %></div>
                                        <div style="font-size:11px;color:var(--lib-muted);"><%= issue.author || '' %></div>
                                    </td>
                                    <td>
                                        <div style="font-weight:600;"><%= issue.memberName || '—' %></div>
                                        <div style="font-size:11px;color:var(--lib-muted);"><%= issue.user_role || '' %></div>
                                    </td>
                                    <td><%= (issue.issue_date || issue.issueDate) ? new Date(issue.issue_date || issue.issueDate).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : '—' %></td>
                                    <td><%= due ? due.toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : '—' %></td>
                                    <td>
                                        <% if (issue.return_date || issue.returnedAt) { %>
                                            <span class="l-badge returned">Returned</span>
                                        <% } else if (isOverdue || issue.status === 'overdue') { %>
                                            <span class="l-badge overdue">Overdue</span>
                                        <% } else if (issue.status === 'renewed') { %>
                                            <span class="l-badge renewed">Renewed</span>
                                        <% } else { %>
                                            <span class="l-badge issued">Issued</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (!issue.return_date && !issue.returnedAt) { %>
                                            <a href="/librarian/issues/<%= issue.id %>/return" style="background:#d1fae5;color:#047857;padding:5px 10px;border-radius:8px;font-weight:700;text-decoration:none;font-size:11px;">Return</a>
                                        <% } else { %>
                                            <span style="color:var(--lib-muted);font-size:11px;">Closed</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="l-panel">
                <div class="l-panel-header">
                    <h3 class="l-panel-title" style="color:#b91c1c;"><i class="fas fa-exclamation-triangle" style="color:#ef4444;"></i> Overdue Watch List</h3>
                    <span style="background:#fee2e2;color:#b91c1c;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;"><%= overdueBks %> Action Required</span>
                </div>
                <div class="l-table-wrap">
                    <table class="l-table">
                        <thead>
                            <tr>
                                <th>Student Name</th>
                                <th>Book Title</th>
                                <th>Due Date</th>
                                <th>Days Overdue</th>
                                <th>Fine Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% listOverdue.forEach(ov => { %>
                                <tr>
                                    <td><strong><%= ov.memberName %></strong></td>
                                    <td><%= ov.bookTitle %></td>
                                    <td><%= new Date(ov.due_date).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) %></td>
                                    <td><span style="color:#b91c1c;font-weight:800;"><%= ov.daysOverdue || 3 %> Days</span></td>
                                    <td><strong style="color:#047857;">₹<%= (ov.daysOverdue || 3) * 10 %></strong></td>
                                    <td>
                                        <button onclick="alert('Reminder notification sent to <%= ov.memberName %>')" style="background:#ef4444;color:#fff;border:none;padding:5px 12px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;">Send Reminder</button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="l-dual-grid">
                <div class="l-panel">
                    <div class="l-panel-header">
                        <h3 class="l-panel-title" style="font-size:15px;"><i class="fas fa-list-check"></i> Today's Activity Log</h3>
                    </div>
                    <div class="l-timeline-list">
                        <% if (listActivities && listActivities.length > 0) { %>
                            <% listActivities.forEach((act, idx) => { 
                                const dotColors = ['#ec4899', '#10b981', '#8b5cf6', '#f59e0b', '#3b82f6', '#06b6d4'];
                                const dotBg = dotColors[idx % dotColors.length];
                            %>
                                <div class="l-tl-item">
                                    <div class="l-tl-dot" style="background:'<%= dotBg %>';box-shadow:0 0 0 3px '<%= dotBg %>';"></div>
                                    <div style="flex:1;font-size:12px;">
                                        <strong style="color:var(--lib-text);"><%= act.text %></strong>
                                        <div style="font-size:10px;color:var(--lib-muted);margin-top:2px;">
                                            <%= act.time ? act.time : '' %><%= act.date ? (act.time ? ' · ' : '') + act.date : '' %><%= act.actor ? ' · ' + act.actor : '' %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="padding:20px;text-align:center;color:var(--lib-muted);font-size:12px;">
                                <i class="fas fa-info-circle" style="margin-right:6px;"></i> No activity logs recorded yet today.
                            </div>
                        <% } %>
                    </div>
                </div>
                <div class="l-widget-card">
                    <div class="l-widget-header">
                        <span><i class="fas fa-bullhorn" style="color:#f59e0b;margin-right:6px;"></i> Announcements</span>
                        <a href="/librarian/notices" style="font-size:11px;color:#db2777;font-weight:700;text-decoration:none;">All Notices</a>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                        <% if (listNotices && listNotices.length > 0) { %>
                            <% listNotices.forEach(n => { %>
                                <div style="background:#f8fafc;padding:10px;border-radius:10px;">
                                    <div style="font-size:12px;font-weight:700;color:var(--lib-text);"><%= n.title %></div>
                                    <div style="font-size:11px;color:var(--lib-muted);margin-top:2px;display:-webkit-box;--webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                        <%= n.content %>
                                    </div>
                                    <div style="font-size:10px;color:#94a3b8;margin-top:4px;">
                                        Posted <%= new Date(n.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="padding:15px;text-align:center;color:var(--lib-muted);font-size:12px;">
                                <i class="fas fa-bullhorn" style="margin-right:4px;color:#cbd5e1;"></i> No active announcements.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="l-right-col">
            <div class="l-widget-card">
                <div class="l-widget-header">
                    <span><i class="fas fa-fire" style="color:#ec4899;margin-right:6px;"></i> Popular Books</span>
                    <a href="/librarian/books" style="font-size:11px;color:#db2777;font-weight:700;text-decoration:none;">View All</a>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <% if (listPopularBooks && listPopularBooks.length > 0) { %>
                        <% listPopularBooks.forEach((bk, idx) => { 
                            const bgColors = ['#ec4899', '#8b5cf6', '#3b82f6', '#10b981', '#f59e0b'];
                            const iconBg = bgColors[idx % bgColors.length];
                        %>
                            <div style="display:flex;align-items:center;gap:12px;background:#f8fafc;padding:10px;border-radius:12px;">
                                <div style="width:32px;height:40px;border-radius:6px;background:'<%= iconBg %>';color:#fff;display:flex;align-items:center;justify-content:center;font-size:16px;">📚</div>
                                <div style="flex:1;">
                                    <div style="font-size:12px;font-weight:700;color:var(--lib-text);"><%= bk.title %></div>
                                    <div style="font-size:11px;color:var(--lib-muted);"><%= bk.author || 'Unknown Author' %></div>
                                </div>
                                <span style="font-size:11px;font-weight:700;color:#db2777;"><%= bk.issue_count || 0 %> Issued</span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:15px;text-align:center;color:var(--lib-muted);font-size:12px;">
                            <i class="fas fa-book" style="margin-right:4px;color:#cbd5e1;"></i> No popular books recorded yet.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <section class="l-qa-grid" aria-label="Bottom Quick Actions">
        <a href="/librarian/books/add" class="l-qa-btn">
            <i class="fas fa-plus-circle" style="color:#ec4899;font-size:20px;"></i>
            <span>Add Book</span>
        </a>
        <a href="/librarian/issues/new" class="l-qa-btn">
            <i class="fas fa-hand-holding-heart" style="color:#8b5cf6;font-size:20px;"></i>
            <span>Issue Book</span>
        </a>
        <a href="/librarian/issues" class="l-qa-btn">
            <i class="fas fa-undo" style="color:#10b981;font-size:20px;"></i>
            <span>Receive Book</span>
        </a>
        <a href="/librarian/issues" class="l-qa-btn">
            <i class="fas fa-bookmark" style="color:#f59e0b;font-size:20px;"></i>
            <span>Reserve Book</span>
        </a>
        <a href="/librarian/books" class="l-qa-btn">
            <i class="fas fa-chart-bar" style="color:#3b82f6;font-size:20px;"></i>
            <span>Reports</span>
        </a>
        <a href="#barcode" class="l-qa-btn" onclick="alert('Barcode Scanner initialized')">
            <i class="fas fa-barcode" style="color:#6366f1;font-size:20px;"></i>
            <span>Scan Barcode</span>
        </a>
        <a href="/librarian/books" class="l-qa-btn">
            <i class="fas fa-users" style="color:#14b8a6;font-size:20px;"></i>
            <span>Members</span>
        </a>
        <a href="#receipt" class="l-qa-btn" onclick="alert('Printing last fine receipt...')">
            <i class="fas fa-print" style="color:#ec4899;font-size:20px;"></i>
            <span>Print Receipt</span>
        </a>
    </section>
</div>