            width: 100% !important;
            align-items: stretch !important;
        }

        .l-hero-right .hero-illustration {
            display: none !important;
        }

        .l-hero-chips {
            min-width: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 6px !important;
            padding: 10px 8px !important;
            border-radius: 14px !important;
        }

        .l-chip-val {
            font-size: 15px !important;
        }

        .l-chip-lbl {
            font-size: 8px !important;
        }

        .l-stat-card {
            padding: 12px 14px !important;
            border-radius: 14px !important;
            box-sizing: border-box !important;
        }

        .l-stat-val {
            font-size: 18px !important;
        }

        .l-stat-lbl {
            font-size: 10.5px !important;
        }

        .l-panel {
            padding: 14px 16px !important;
            border-radius: 14px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        .l-widget-card {
            width: 100% !important;
            box-sizing: border-box !important;
        }

        .l-table-wrap {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        .l-table {
            min-width: 500px !important;
        }
    }

    @media (max-width: 480px) {
        .l-hero-chips {
            grid-template-columns: repeat(4, 1fr) !important;
        }

        .l-qa-grid {
            grid-template-columns: repeat(2, 1fr) !important;
        }
    }
</style>
<div class="l-dash-container reveal">
    <section class="l-hero-card" aria-label="Library Welcome Banner">
        <div class="l-hero-left">
            <div class="l-hero-badge">
                <i class="fas fa-book-open"></i>
                <span><%- lan.SchoolSync_Central_Library_ERP %></span>
            </div>
            <h1 class="l-hero-title"><%- lan.Welcome_Back_Librarian %></h1>
            <p class="l-hero-sub"><%- lan.Librarian_Dashboard_Subtitle %></p>
            <div class="l-hero-actions">
                <a href="/librarian/books/add" class="l-hero-btn"><i class="fas fa-plus-circle"></i> <%- lan.Add_New_Book %></a>
                <a href="/librarian/issues/new" class="l-hero-btn outline"><i class="fas fa-hand-holding-heart"></i><%- lan.Issue_Book %></a>
                <a href="/librarian/issues" class="l-hero-btn outline"><i class="fas fa-undo"></i> <%- lan.Receive_Book %></a>
            </div>
        </div>
        <div class="l-hero-right" style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">
            <%- include('../partials/hero-illustration', { illustrationSrc: '/illustrations/librarian.png' , illustrationAlt: 'Library Dashboard' }) %>
            <div class="l-hero-chips">
                <div class="l-chip-item">
                    <span class="l-chip-val"><%= totalBks %></span>
                    <span class="l-chip-lbl"><%- lan.Titles %></span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val"><%= totalCopies %></span>
                    <span class="l-chip-lbl"><%- lan.Copies %></span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val" style="color:#6ee7b7;"><%= availableCopies %></span>
                    <span class="l-chip-lbl"><%- lan.Available %></span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val"><%= issuedBks %></span>
                    <span class="l-chip-lbl"><%- lan.Issued %></span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val" style="color:#fca5a5;"><%= overdueBks %></span>
                    <span class="l-chip-lbl"><%- lan.Overdue %></span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val">7</span>
                    <span class="l-chip-lbl"><%- lan.Reservations %></span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val">34</span>
                    <span class="l-chip-lbl"><%- lan.Visitors %></span>
                </div>
                <div class="l-chip-item">
                    <span class="l-chip-val" style="color:#fde047;">₹<%= fineTodayAmount %></span>
                    <span class="l-chip-lbl"><%- lan.Fine_Today %></span>
                </div>
            </div>
        </div>
    </section>
    <section class="l-analytics-grid" aria-label="Quick Analytics">
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl"><%- lan.Book_Titles %></span>
                <div class="l-stat-icon pink"><i class="fas fa-book"></i></div>
            </div>
            <div class="l-stat-val"><%= totalBks %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl"><%- lan.Total_Members %></span>
                <div class="l-stat-icon purple"><i class="fas fa-users"></i></div>
            </div>
            <div class="l-stat-val"><%= totalMbrs %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl"><%- lan.Issued_Today %></span>
                <div class="l-stat-icon blue"><i class="fas fa-hand-holding-heart"></i></div>
            </div>
            <div class="l-stat-val"><%= issuedTodayCount %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl"><%- lan.Returned_Today %></span>
                <div class="l-stat-icon emerald"><i class="fas fa-undo-alt"></i></div>
            </div>
            <div class="l-stat-val"><%= returnedTodayCount %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl"><%- lan.Overdue %></span>
                <div class="l-stat-icon rose"><i class="fas fa-clock-rotate-left"></i></div>
            </div>
            <div class="l-stat-val" style="color:#be123c;"><%= overdueBks %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl"><%- lan.Reservations %></span>
                <div class="l-stat-icon amber"><i class="fas fa-bookmark"></i></div>
            </div>
            <div class="l-stat-val">7</div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl"><%- lan.Fine_Today %></span>
                <div class="l-stat-icon emerald"><i class="fas fa-indian-rupee-sign"></i></div>
            </div>
            <div class="l-stat-val" style="color:#047857;">₹<%= fineTodayAmount %></div>
        </div>
        <div class="l-stat-card">
            <div class="l-stat-top">
                <span class="l-stat-lbl"><%- lan.New_Books %></span>
                <div class="l-stat-icon pink"><i class="fas fa-plus-circle"></i></div>
            </div>
            <div class="l-stat-val">5</div>
        </div>
    </section>
    <div class="l-main-layout">
        <div class="l-left-col">
            <div class="l-panel">
                <div class="l-panel-header">
                    <h3 class="l-panel-title"><i class="fas fa-clock-rotate-left"></i> <%- lan.Recently_Issued_Books %></h3>
                    <a href="/librarian/issues" class="l-panel-link"><%- lan.View_All_Issues %> →</a>
                </div>
                <div class="l-table-wrap">
                    <table class="l-table">
                        <thead>
                            <tr>
                                <th><%- lan.Book_Title %></th>
                                <th><%- lan.Member_Name %></th>
                                <th><%- lan.Issue_Date %></th>
                                <th><%- lan.Due_Date %></th>
                                <th><%- lan.Status %></th>
                                <th><%- lan.Action %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% listRecentIssues.forEach(issue=> { %>
                            <% const due=issue.due_date || issue.dueDate ? new Date(issue.due_date || issue.dueDate) : null; const isOverdue=due ? (due < new Date() && !issue.return_date && !issue.returnedAt) : false; %>
                                <tr>
                                    <td>
                                        <div style="font-weight:700;color:var(--lib-text);"><%= issue.bookTitle || '—' %></div>
                                        <div style="font-size:11px;color:var(--lib-muted);"><%= issue.author || '' %></div>
                                    </td>
                                    <td>
                                        <div style="font-weight:600;"><%= issue.memberName || '—' %></div>
                                        <div style="font-size:11px;color:var(--lib-muted);"><%= issue.user_role || '' %></div>
                                    </td>
                                    <td>
                                        <%= (issue.issue_date || issue.issueDate) ? new Date(issue.issue_date || issue.issueDate).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : '—' %>
                                    </td>
                                    <td>
                                        <%= due ? due.toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : '—' %>
                                    </td>
                                    <td>
                                        <% if (issue.return_date || issue.returnedAt) { %>
                                            <span class="l-badge returned"><%- lan.Returned %></span>
                                        <% } else if (isOverdue || issue.status==='overdue' ) { %>
                                            <span class="l-badge overdue"><%- lan.Overdue %></span>
                                        <% } else if (issue.status==='renewed' ) { %>
                                            <span class="l-badge renewed"><%- lan.Renewed %></span>
                                        <% } else { %>
                                            <span class="l-badge issued"><%- lan.Issued %></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (!issue.return_date && !issue.returnedAt) { %>
                                            <a href="/librarian/issues/<%= issue.id %>/return" style="background:#d1fae5;color:#047857;padding:5px 10px;border-radius:8px;font-weight:700;text-decoration:none;font-size:11px;"><%- lan.Return %></a>
                                        <% } else { %>
                                            <span style="color:var(--lib-muted);font-size:11px;"><%- lan.Closed %></span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="l-panel">
                <div class="l-panel-header">
                    <h3 class="l-panel-title" style="color:#b91c1c;"><i class="fas fa-exclamation-triangle" style="color:#ef4444;"></i> <%- lan.Overdue_Watch_List %></h3>
                    <span style="background:#fee2e2;color:#b91c1c;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;"><%= overdueBks %> <%- lan.Action_Required %></span>
                </div>
                <div class="l-table-wrap">
                    <table class="l-table">
                        <thead>
                            <tr>
                                <th><%- lan.Student_Name %></th>
                                <th><%- lan.Book_Title %></th>
                                <th><%- lan.Due_Date %></th>
                                <th><%- lan.Days_Overdue %></th>
                                <th><%- lan.Fine_Amount %></th>
                                <th><%- lan.Action %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% listOverdue.forEach(ov=> { %>
                                <tr>
                                    <td><strong><%= ov.memberName %></strong></td>
                                    <td><%= ov.bookTitle %></td>
                                    <td><%= new Date(ov.due_date).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) %></td>
                                    <td><span style="color:#b91c1c;font-weight:800;"><%= ov.daysOverdue || 3 %> <%- lan.Days %></span></td>
                                    <td><strong style="color:#047857;">₹<%= Number(ov.calculatedFine !==undefined ? ov.calculatedFine : ((ov.daysOverdue || 0) * (ov.fine_per_day || 1))).toFixed(2) %></strong></td>
                                    <td>
                                        <button onclick="alert('Reminder notification sent to <%= ov.memberName %>')" style="background:#ef4444;color:#fff;border:none;padding:5px 12px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;"><%- lan.Send_Reminder %></button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="l-dual-grid">
                <div class="l-panel">
                    <div class="l-panel-header">
                        <h3 class="l-panel-title" style="font-size:15px;"><i class="fas fa-list-check"></i> <%- lan.Todays_Activity_Log %></h3>
                    </div>
                    <div class="l-timeline-list">
                        <% if (listActivities && listActivities.length> 0) { %>
                            <% listActivities.forEach((act, idx)=> { %>
                                <div class="l-tl-item">
                                    <div class="l-tl-dot c-<%= idx % 6 %>"></div>
                                    <div style="flex:1;font-size:12px;">
                                        <strong style="color:var(--lib-text);"><%= act.text %></strong>
                                        <div style="font-size:10px;color:var(--lib-muted);margin-top:2px;">
                                            <%= act.time ? act.time : '' %>
                                            <%= act.date ? (act.time ? ' · ' : '' ) + act.date : '' %>
                                            <%= act.actor ? ' · ' + act.actor : '' %>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="padding:20px;text-align:center;color:var(--lib-muted);font-size:12px;">
                                <i class="fas fa-info-circle" style="margin-right:6px;"></i> <%- lan.No_Activity_Logs_Today %>
                            </div>
                        <% } %>
                    </div>
                </div>
                <div class="l-widget-card">
                    <div class="l-widget-header">
                        <span><i class="fas fa-bullhorn" style="color:#f59e0b;margin-right:6px;"></i> <%- lan.Announcements %></span>
                        <a href="/librarian/notices" style="font-size:11px;color:#db2777;font-weight:700;text-decoration:none;"><%- lan.All_Notices %></a>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:10px;">
                        <% if (listNotices && listNotices.length> 0) { %>
                            <% listNotices.forEach(n=> { %>
                                <div class="l-notice-item">
                                    <div style="font-size:12px;font-weight:700;color:var(--lib-text);"><%= n.title %></div>
                                    <div style="font-size:11px;color:var(--lib-muted);margin-top:2px;display:-webkit-box;--webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= n.content %></div>
                                    <div style="font-size:10px;color:#94a3b8;margin-top:4px;">
                                        <%- lan.Posted %>
                                        <%= new Date(n.created_at).toLocaleDateString('en-IN', { day: 'numeric' , month: 'short' }) %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="padding:15px;text-align:center;color:var(--lib-muted);font-size:12px;">
                                <i class="fas fa-bullhorn" style="margin-right:4px;color:#cbd5e1;"></i>
                                <%- lan.No_Active_Announcements %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="l-right-col">
            <div class="l-widget-card">
                <div class="l-widget-header">
                    <span><i class="fas fa-fire" style="color:#ec4899;margin-right:6px;"></i> <%- lan.Popular_Books %></span>
                    <a href="/librarian/books" style="font-size:11px;color:#db2777;font-weight:700;text-decoration:none;"><%- lan.View_All %></a>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <% if (listPopularBooks && listPopularBooks.length> 0) { %>
                        <% listPopularBooks.forEach((bk, idx)=> { %>
                            <div class="l-popular-book-item">
                                <div class="l-book-cover-icon c-<%= idx % 5 %>">📚</div>
                                <div style="flex:1;">
                                    <div style="font-size:12px;font-weight:700;color:var(--lib-text);"><%= bk.title %></div>
                                    <div style="font-size:11px;color:var(--lib-muted);"><%= bk.author || lan.Unknown_Author %></div>
                                </div>
                                <span style="font-size:11px;font-weight:700;color:#db2777;"><%= bk.issue_count || 0 %> <%- lan.Issued %></span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:15px;text-align:center;color:var(--lib-muted);font-size:12px;">
                            <i class="fas fa-book" style="margin-right:4px;color:#cbd5e1;"></i> <%- lan.No_Popular_Books_Yet %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <section class="l-qa-grid" aria-label="Bottom Quick Actions">
        <a href="/librarian/books/add" class="l-qa-btn">
            <i class="fas fa-plus-circle" style="color:#ec4899;font-size:20px;"></i>
            <span><%- lan.Add_Book %></span>
        </a>
        <a href="/librarian/issues/new" class="l-qa-btn">
            <i class="fas fa-hand-holding-heart" style="color:#8b5cf6;font-size:20px;"></i>
            <span><%- lan.Issue_Book %></span>
        </a>
        <a href="/librarian/issues" class="l-qa-btn">
            <i class="fas fa-undo" style="color:#10b981;font-size:20px;"></i>
            <span><%- lan.Receive_Book %></span>
        </a>
        <a href="/librarian/issues" class="l-qa-btn">
            <i class="fas fa-bookmark" style="color:#f59e0b;font-size:20px;"></i>
            <span><%- lan.Reserve_Book %></span>
        </a>
        <a href="/librarian/books" class="l-qa-btn">
            <i class="fas fa-chart-bar" style="color:#3b82f6;font-size:20px;"></i>
            <span><%- lan.Reports %></span>
        </a>
        <a href="#barcode" class="l-qa-btn" onclick="alert('Barcode Scanner initialized')">
            <i class="fas fa-barcode" style="color:#6366f1;font-size:20px;"></i>
            <span><%- lan.Scan_Barcode %></span>
        </a>
        <a href="/librarian/books" class="l-qa-btn">
            <i class="fas fa-users" style="color:#14b8a6;font-size:20px;"></i>
            <span><%- lan.Members %></span>
        </a>
        <a href="#receipt" class="l-qa-btn" onclick="alert('Printing last fine receipt...')">
            <i class="fas fa-print" style="color:#ec4899;font-size:20px;"></i>
            <span><%- lan.Print_Receipt %></span>
        </a>
    </section>
</div>