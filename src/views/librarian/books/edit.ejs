<div class="lib-form-shell">
  <div class="lib-form-heading">
    <h1>Edit Book</h1>
    <p>Update book information, stock count and availability status.</p>
  </div>
  <form method="POST" action="/librarian/books/<%= book.id %>/edit" enctype="multipart/form-data" class="card-form">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="form-grid">
      <div class="form-group">
        <label>Title *</label>
        <input type="text" name="title" value="<%= book.title %>" required maxlength="255">
      </div>
      <div class="form-group">
        <label>Author</label>
        <input type="text" name="author" value="<%= book.author || '' %>" maxlength="180">
      </div>
      <div class="form-group">
        <label>ISBN</label>
        <input type="text" name="isbn" value="<%= book.isbn || '' %>" maxlength="40">
      </div>
      <div class="form-group">
        <label>Barcode</label>
        <input type="text" name="barcode" value="<%= book.barcode || '' %>" maxlength="80">
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="category_id">
          <option value="">Select Category</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= book.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Rack</label>
        <select name="rack_id">
          <option value="">Select Rack</option>
          <% racks.forEach(r => { %>
            <option value="<%= r.id %>" <%= book.rack_id == r.id ? 'selected' : '' %>><%= r.rack_number %> <%= r.shelf_number ? '/ '+r.shelf_number : '' %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Total Copies *</label>
        <input type="number" name="total_copies" value="<%= book.total_copies %>" min="1" required>
      </div>
      <div class="form-group">
        <label>Price (₹)</label>
        <input type="number" name="price" value="<%= book.price || 0 %>" step="0.01" min="0">
      </div>
      <div class="form-group">
        <label>Status</label>
        <select name="status">
          <option value="active" <%= book.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= book.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          <option value="lost" <%= book.status === 'lost' ? 'selected' : '' %>>Lost</option>
          <option value="damaged" <%= book.status === 'damaged' ? 'selected' : '' %>>Damaged</option>
        </select>
      </div>
      <div class="form-group full-width">
        <label>Cover Image</label>
        <% if (book.cover_image) { %>
          <div class="current-image"><img src="<%= book.cover_image %>" height="90" alt="Current cover"></div>
        <% } %>
        <input type="file" name="cover_image" accept="image/*">
      </div>
      <div class="form-group full-width">
        <label>Description</label>
        <textarea name="description" rows="3"><%= book.description || '' %></textarea>
      </div>
    </div>
    <div class="form-actions">
      <a href="/librarian/books" class="lib-btn soft"><i class="fas fa-arrow-left"></i> Cancel</a>
      <button type="submit" class="lib-btn primary"><i class="fas fa-save"></i> Update Book</button>
    </div>
  </form>
</div>