<div class="lib-form-shell">
  <div class="lib-form-heading">
    <h1><%- lan.Edit_Book %></h1>
    <p><%- lan.Edit_Book_Subtitle %></p>
  </div>
  <form method="POST" action="/librarian/books/<%= book.id %>/edit" enctype="multipart/form-data" class="card-form">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="form-grid">
      <div class="form-group">
        <label><%- lan.Title %> *</label>
        <input type="text" name="title" value="<%= book.title %>" required maxlength="255">
      </div>
      <div class="form-group">
        <label><%- lan.Author %></label>
        <input type="text" name="author" value="<%= book.author || '' %>" maxlength="180">
      </div>
      <div class="form-group">
        <label><%- lan.ISBN %></label>
        <input type="text" name="isbn" value="<%= book.isbn || '' %>" maxlength="40">
      </div>
      <div class="form-group">
        <label><%- lan.Barcode %></label>
        <input type="text" name="barcode" value="<%= book.barcode || '' %>" maxlength="80">
      </div>
      <div class="form-group">
        <label><%- lan.Category %></label>
        <select name="category_id">
          <option value=""><%- lan.Select_Category %></option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>" <%= book.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label><%- lan.Rack %></label>
        <select name="rack_id">
          <option value=""><%- lan.Select_Rack %></option>
          <% racks.forEach(r => { %>
            <option value="<%= r.id %>" <%= book.rack_id == r.id ? 'selected' : '' %>><%= r.rack_number %> <%= r.shelf_number ? '/ '+r.shelf_number : '' %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label><%- lan.Total_Copies %> *</label>
        <input type="number" name="total_copies" value="<%= book.total_copies %>" min="1" required>
      </div>
      <div class="form-group">
        <label><%- lan.Price %> (₹)</label>
        <input type="number" name="price" value="<%= book.price || 0 %>" step="0.01" min="0">
      </div>
      <div class="form-group">
        <label><%- lan.Status %></label>
        <select name="status">
          <option value="active" <%= book.status === 'active' ? 'selected' : '' %>><%- lan.Active %></option>
          <option value="inactive" <%= book.status === 'inactive' ? 'selected' : '' %>><%- lan.Inactive %></option>
          <option value="lost" <%= book.status === 'lost' ? 'selected' : '' %>><%- lan.Lost %></option>
          <option value="damaged" <%= book.status === 'damaged' ? 'selected' : '' %>><%- lan.Damaged %></option>
        </select>
      </div>
      <div class="form-group full-width">
        <label><%- lan.Cover_Image %></label>
        <% if (book.cover_image) { %>
          <div class="current-image"><img src="<%= book.cover_image %>" height="90" alt="Current cover"></div>
        <% } %>
        <input type="file" name="cover_image" accept="image/*">
      </div>
      <div class="form-group full-width">
        <label><%- lan.Description %></label>
        <textarea name="description" rows="3"><%= book.description || '' %></textarea>
      </div>
    </div>
    <div class="form-actions">
      <a href="/librarian/books" class="lib-btn soft"><i class="fas fa-arrow-left"></i> <%- lan.Cancel %></a>
      <button type="submit" class="lib-btn primary"><i class="fas fa-save"></i> <%- lan.Update_Book %></button>
    </div>
  </form>
</div>