<div class="lib-form-shell">
  <div class="lib-form-heading">
    <h1>Add New Book</h1>
    <p>Add inventory details, category, rack placement, copies and optional cover image.</p>
  </div>
  <form method="POST" action="/librarian/books/add" enctype="multipart/form-data" class="card-form">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="form-grid">
      <div class="form-group">
        <label>Title *</label>
        <input type="text" name="title" required maxlength="255" placeholder="Book title">
      </div>
      <div class="form-group">
        <label>Author</label>
        <input type="text" name="author" maxlength="180" placeholder="Author name">
      </div>
      <div class="form-group">
        <label>ISBN</label>
        <input type="text" name="isbn" maxlength="40" placeholder="ISBN number">
      </div>
      <div class="form-group">
        <label>Barcode</label>
        <input type="text" name="barcode" maxlength="80" placeholder="Barcode / accession no.">
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="category_id">
          <option value="">Select Category</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Rack</label>
        <select name="rack_id">
          <option value="">Select Rack</option>
          <% racks.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.rack_number %> <%= r.shelf_number ? '/ '+r.shelf_number : '' %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Total Copies *</label>
        <input type="number" name="total_copies" value="1" min="1" required>
      </div>
      <div class="form-group">
        <label>Price (₹)</label>
        <input type="number" name="price" step="0.01" min="0" placeholder="0.00">
      </div>
      <div class="form-group">
        <label>Publisher</label>
        <input type="text" name="publisher" maxlength="180" placeholder="Publisher">
      </div>
      <div class="form-group">
        <label>Language</label>
        <input type="text" name="language" maxlength="80" placeholder="English / Gujarati / Hindi">
      </div>
      <div class="form-group">
        <label>Edition</label>
        <input type="text" name="edition" maxlength="80" placeholder="Edition">
      </div>
      <div class="form-group">
        <label>Publish Year</label>
        <input type="number" name="publish_year" min="1800" max="2099" placeholder="YYYY">
      </div>
      <div class="form-group">
        <label>Purchase Date</label>
        <input type="date" name="purchase_date">
      </div>
      <div class="form-group">
        <label>Cover Image</label>
        <input type="file" name="cover_image" accept="image/*">
      </div>
      <div class="form-group full-width">
        <label>Description</label>
        <textarea name="description" rows="3" placeholder="Short description or notes..."></textarea>
      </div>
    </div>
    <div class="form-actions">
      <a href="/librarian/books" class="lib-btn soft"><i class="fas fa-arrow-left"></i> Cancel</a>
      <button type="submit" class="lib-btn primary"><i class="fas fa-save"></i> Save Book</button>
    </div>
  </form>
</div>