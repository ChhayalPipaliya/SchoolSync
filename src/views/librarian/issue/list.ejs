<div class="lib-page-shell">
  <section class="lib-hero">
    <div class="lib-hero-content">
      <div>
        <span class="lib-eyebrow"><i class="fas fa-right-left"></i> Circulation Desk</span>
        <h1>Issued Books</h1>
        <p>Track active issues, renewals, returns, overdue books and fine amounts from a single circulation screen.</p>
      </div>
      <div class="lib-hero-actions">
        <a href="/librarian/issues/new" class="lib-action-btn ghost"><i class="fas fa-hand-holding-heart"></i> Issue Book</a>
        <a href="/librarian/books" class="lib-action-btn ghost"><i class="fas fa-book"></i> Books</a>
      </div>
    </div>
  </section>
  <div class="lib-metric-grid">
    <div class="lib-metric-card">
      <div class="lib-metric-icon blue"><i class="fas fa-book"></i></div>
      <div><span class="lib-metric-value"><%= stats.total || 0 %></span><span class="lib-metric-label">Total Issues</span></div>
    </div>
    <div class="lib-metric-card">
      <div class="lib-metric-icon amber"><i class="fas fa-bookmark"></i></div>
      <div><span class="lib-metric-value"><%= stats.active || 0 %></span><span class="lib-metric-label">Active</span></div>
    </div>
    <div class="lib-metric-card">
      <div class="lib-metric-icon red"><i class="fas fa-clock"></i></div>
      <div><span class="lib-metric-value"><%= stats.overdue || 0 %></span><span class="lib-metric-label">Overdue</span></div>
    </div>
    <div class="lib-metric-card">
      <div class="lib-metric-icon green"><i class="fas fa-undo"></i></div>
      <div><span class="lib-metric-value"><%= stats.returned || 0 %></span><span class="lib-metric-label">Returned</span></div>
    </div>
    <div class="lib-metric-card">
      <div class="lib-metric-icon slate"><i class="fas fa-trash-can"></i></div>
      <div><span class="lib-metric-value"><%= stats.lost || 0 %></span><span class="lib-metric-label">Lost</span></div>
    </div>
  </div>
  <div class="lib-toolbar">
    <form method="GET" class="lib-search-form">
      <select name="status" aria-label="Filter by issue status">
        <option value="">All Status</option>
        <option value="issued" <%= status === 'issued' ? 'selected' : '' %>>Issued</option>
        <option value="overdue" <%= status === 'overdue' ? 'selected' : '' %>>Overdue</option>
        <option value="returned" <%= status === 'returned' ? 'selected' : '' %>>Returned</option>
        <option value="lost" <%= status === 'lost' ? 'selected' : '' %>>Lost</option>
      </select>
      <input type="hidden" name="book_id" value="<%= book_id || '' %>">
      <input type="hidden" name="member_id" value="<%= member_id || '' %>">
      <input type="text" name="search" value="<%= search || '' %>" placeholder="Search book, author, member or ISBN..." aria-label="Search issued books">
      <button type="submit" class="lib-btn primary"><i class="fas fa-filter"></i> Filter</button>
      <% if (book_id || member_id || search || status) { %>
        <a href="/librarian/issues" class="lib-btn soft"><i class="fas fa-rotate-left"></i> Clear</a>
      <% } %>
    </form>
  </div>
  <div class="lib-table-card">
    <div class="lib-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Book</th>
            <th>Member</th>
            <th>Issue Date</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Fine</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% issues.forEach(i => { %>
            <tr>
              <td>
                <div class="lib-mini-book">
                  <div class="lib-book-thumb">
                    <% if (i.cover_image) { %>
                      <img src="<%= i.cover_image %>" alt="<%= i.book_title %> cover">
                    <% } else { %>
                      <i class="fas fa-book"></i>
                    <% } %>
                  </div>
                  <div>
                    <div class="lib-title-main"><%= i.book_title %></div>
                    <div class="lib-title-sub"><%= i.author || 'Unknown Author' %> · ISBN: <%= i.isbn || 'N/A' %></div>
                  </div>
                </div>
              </td>
              <td>
                <div class="lib-mini-user">
                  <div class="lib-user-avatar"><%= (i.first_name || '?').charAt(0).toUpperCase() %></div>
                  <div>
                    <div class="lib-title-main"><%= i.first_name %> <%= i.last_name %></div>
                    <div class="lib-title-sub"><%= i.user_role || 'Member' %> · <%= i.member_code || 'N/A' %></div>
                  </div>
                </div>
              </td>
              <td><%= i.issue_date ? new Date(i.issue_date).toLocaleDateString('en-GB') : '-' %></td>
              <td><%= i.due_date ? new Date(i.due_date).toLocaleDateString('en-GB') : '-' %></td>
              <td><span class="badge badge-<%= i.status %>"><%= String(i.status || '').replace('_',' ').toUpperCase() %></span></td>
              <td><strong>₹<%= Number(i.fine_amount || 0).toFixed(2) %></strong></td>
              <td class="actions">
                <% if (i.status !== 'returned' && i.status !== 'lost') { %>
                  <a href="/librarian/issues/<%= i.id %>/return" class="lib-btn success" style="min-height:32px;padding:6px 10px;font-size:12px;"><i class="fas fa-undo"></i> Return</a>
                  <form method="POST" action="/librarian/issues/<%= i.id %>/renew" class="inline">
                    <button class="lib-btn soft" style="min-height:32px;padding:6px 10px;font-size:12px;"><i class="fas fa-rotate"></i> Renew</button>
                  </form>
                <% } else { %>
                  <span class="text-muted">Closed</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (!issues.length) { %>
            <tr>
              <td colspan="7" class="empty">
                <div class="lib-empty-icon"><i class="fas fa-inbox"></i></div>
                <div class="lib-empty-title">No issue records found</div>
                <div class="lib-empty-text">Try changing filters or issue a new book.</div>
                <a href="/librarian/issues/new" class="lib-btn primary"><i class="fas fa-hand-holding-heart"></i> Issue Book</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>