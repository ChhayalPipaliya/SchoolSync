<div class="lib-form-shell narrow">
  <div class="lib-form-heading">
    <h1><%- lan.Return_Book %></h1>
    <p><%- lan.Return_Book_Subtitle %></p>
  </div>
  <div class="lib-panel" style="margin-bottom:18px;">
    <div class="lib-panel-header"><h2><i class="fas fa-book"></i> <%- lan.Return_Summary %></h2></div>
    <div class="lib-panel-body">
      <div class="lib-list-stack">
        <div class="lib-list-item">
          <div><div class="lib-title-main"><%= issue.title %></div><div class="lib-title-sub"><%- lan.Title %></div></div>
          <span class="badge badge-<%= issue.status %>"><%= issue.status.toUpperCase() %></span>
        </div>
        <div class="lib-list-item">
          <div><div class="lib-title-main"><%= issue.first_name %> <%= issue.last_name %></div><div class="lib-title-sub"><%= issue.email %></div></div>
          <span class="badge badge-issued"><%- lan.Member %></span>
        </div>
        <div class="lib-list-item">
          <div><div class="lib-title-main"><%= new Date(issue.issue_date).toLocaleDateString('en-GB') %></div><div class="lib-title-sub"><%- lan.Issue_Date %></div></div>
          <div><div class="lib-title-main"><%= new Date(issue.due_date).toLocaleDateString('en-GB') %></div><div class="lib-title-sub"><%- lan.Due_Date %></div></div>
        </div>
        <% if (overdueDays > 0) { %>
          <div class="lib-list-item" style="background:#FEF2F2;border-color:#FECACA;">
            <div><div class="lib-title-main" style="color:#B91C1C;"><%- lan.Overdue_By %> <%= overdueDays %> <%- lan.Days %></div><div class="lib-title-sub"><%- lan.Calculated_Fine %></div></div>
            <span class="badge badge-overdue">₹<%= calculatedFine.toFixed(2) %></span>
          </div>
        <% } %>
        <% if (typeof unpaidFines !== 'undefined' && unpaidFines > 0) { %>
          <div class="lib-list-item" style="background:#FFFBEB;border-color:#FDE68A;">
            <div><div class="lib-title-main" style="color:#92400E;"><%- lan.Previous_Unpaid_Fines %></div><div class="lib-title-sub"><%- lan.Collect_Pending_Fines_Note %></div></div>
            <span class="badge badge-overdue">₹<%= unpaidFines.toFixed(2) %></span>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <form method="POST" action="/librarian/issues/<%= issue.id %>/return" class="card-form">
    <div class="form-grid">
      <div class="form-group">
        <label><%- lan.Fine_Amount %> (₹)</label>
        <input type="number" name="fine_amount" value="<%= calculatedFine.toFixed(2) %>" step="0.01" min="0">
      </div>
      <div class="form-group">
        <label><%- lan.Fine_Paid_Question %></label>
        <select name="fine_paid">
          <option value="0"><%- lan.No_Pending %></option>
          <option value="1"><%- lan.Yes_Paid_Now %></option>
        </select>
      </div>
      <div class="form-group">
        <label><%- lan.Return_Status %></label>
        <select name="status">
          <option value="returned"><%- lan.Returned %></option>
          <option value="lost"><%- lan.Mark_As_Lost %></option>
        </select>
      </div>
      <div class="form-group full-width">
        <label><%- lan.Remarks %></label>
        <textarea name="remarks" rows="2"><%= issue.remarks || '' %></textarea>
      </div>
    </div>
    <div class="form-actions">
      <a href="/librarian/issues" class="lib-btn soft"><i class="fas fa-arrow-left"></i> <%- lan.Cancel %></a>
      <button type="submit" class="lib-btn primary"><i class="fas fa-check"></i> <%- lan.Process_Return %></button>
    </div>
  </form>
</div>