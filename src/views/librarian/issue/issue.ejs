<div class="lib-form-shell narrow">
  <div class="lib-form-heading">
    <h1>Issue Book</h1>
    <p>Select an active member, choose an available book and set due days for return tracking.</p>
  </div>
  <form method="POST" action="/librarian/issues/new" class="card-form">
    <div class="form-grid">
      <div class="form-group full-width">
        <label>Member (Student / Teacher) *</label>
        <select name="user_id" id="memberSelect" required>
          <option value="">Select Member</option>
          <% members.forEach(m => { %>
            <option value="<%= m.id %>"><%= m.first_name %> <%= m.last_name %> — <%= m.email %> (<%= m.role %>)</option>
          <% }) %>
        </select>
        <input type="text" id="memberSearch" placeholder="Type to quickly search members..." class="search-helper">
      </div>
      <div class="form-group full-width">
        <label>Book *</label>
        <select name="book_id" id="bookSelect" required>
          <option value="">Select Book</option>
          <% books.forEach(b => { %>
            <option value="<%= b.id %>"><%= b.title %> — <%= b.author || 'Unknown' %> (Available: <%= b.available_copies %>)</option>
          <% }) %>
        </select>
        <input type="text" id="bookSearch" placeholder="Type to quickly search books..." class="search-helper">
      </div>
      <div class="form-group">
        <label>Due Days</label>
        <input type="number" name="due_days" value="<%= (typeof settings !== 'undefined' && settings && settings.default_due_days) ? settings.default_due_days : 14 %>" min="1">
      </div>
      <div class="form-group">
        <label>Remarks</label>
        <textarea name="remarks" rows="2" placeholder="Optional note..."></textarea>
      </div>
    </div>
    <div class="form-actions">
      <a href="/librarian/issues" class="lib-btn soft"><i class="fas fa-arrow-left"></i> Cancel</a>
      <button type="submit" class="lib-btn primary"><i class="fas fa-hand-holding-heart"></i> Issue Book</button>
    </div>
  </form>
</div>
<script>
    function filterSelect(searchId, selectId) {
        const search = document.getElementById(searchId);
        const select = document.getElementById(selectId);
        if (!search || !select) return;
        search.addEventListener('input', function(e) {
            const val = e.target.value.toLowerCase();
            const opts = select.options;
            for (let i = 1; i < opts.length; i++) {
            opts[i].style.display = opts[i].text.toLowerCase().includes(val) ? '' : 'none';
            }
        });
    };
    filterSelect('memberSearch', 'memberSelect');
    filterSelect('bookSearch', 'bookSelect');
</script>