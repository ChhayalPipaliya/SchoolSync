<div class="lib-page-shell">
  <section class="lib-hero">
    <div class="lib-hero-content">
      <div>
        <span class="lib-eyebrow"><i class="fas fa-users"></i> Library Members</span>
        <h1>Members Directory</h1>
        <p>Find student and teacher library members with member ID and active status.</p>
      </div>
    </div>
  </section>

  <div class="lib-toolbar">
    <form method="GET" class="lib-search-form">
      <select name="type">
        <option value="">All Members</option>
        <option value="student" <%= type==='student'?'selected':'' %>>Students</option>
        <option value="teacher" <%= type==='teacher'?'selected':'' %>>Teachers</option>
      </select>
      <input type="text" name="search" value="<%= search || '' %>" placeholder="Search name, email or library ID...">
      <button class="lib-btn primary"><i class="fas fa-filter"></i> Filter</button>
      <% if (type || search) { %><a href="/librarian/members" class="lib-btn soft"><i class="fas fa-rotate-left"></i> Clear</a><% } %>
    </form>
  </div>

  <div class="lib-table-card">
    <div class="lib-table-wrap">
      <table class="data-table">
        <thead><tr><th>Name</th><th>Email</th><th>Type</th><th>Library ID</th><th>Status</th></tr></thead>
        <tbody>
          <% members.forEach(m => { %>
          <tr>
            <td>
              <div class="lib-mini-user">
                <div class="lib-user-avatar"><%= (m.first_name || '?').charAt(0).toUpperCase() %></div>
                <div>
                  <div class="lib-title-main"><%= m.first_name %> <%= m.last_name %></div>
                  <div class="lib-title-sub"><%= m.member_type || m.role || 'Member' %></div>
                </div>
              </div>
            </td>
            <td><%= m.email %></td>
            <td><span class="badge badge-issued"><%= m.member_type || m.role %></span></td>
            <td><strong><%= m.library_id || '-' %></strong></td>
            <td><span class="badge badge-<%= m.status %>"><%= m.status %></span></td>
          </tr>
          <% }) %>
          <% if(!members.length){ %>
            <tr><td colspan="5" class="empty"><div class="lib-empty-icon"><i class="fas fa-user-slash"></i></div><div class="lib-empty-title">No members found</div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
