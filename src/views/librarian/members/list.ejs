<div class="lib-page-shell">
  <section class="lib-hero">
    <div class="lib-hero-content">
      <div>
        <span class="lib-eyebrow"><i class="fas fa-users"></i> <%- lan.Library_Members %></span>
        <h1><%- lan.Members_Directory %></h1>
        <p><%- lan.Members_Directory_Subtitle %></p>
      </div>
    </div>
  </section>
  <div class="lib-toolbar">
    <form method="GET" class="lib-search-form">
      <select name="type">
        <option value=""><%- lan.All_Members %></option>
        <option value="student" <%= type==='student'?'selected':'' %>><%- lan.Students %></option>
        <option value="teacher" <%= type==='teacher'?'selected':'' %>><%- lan.Teachers %></option>
      </select>
      <input type="text" name="search" value="<%= search || '' %>" placeholder="<%= lan.Search_Members_Placeholder %>">
      <button class="lib-btn primary"><i class="fas fa-filter"></i> <%- lan.Filter %></button>
      <% if (type || search) { %><a href="/librarian/members" class="lib-btn soft"><i class="fas fa-rotate-left"></i> <%- lan.Clear %></a><% } %>
    </form>
  </div>
  <div class="lib-table-card">
    <div class="lib-table-wrap">
      <table class="data-table">
        <thead><tr><th><%- lan.Name %></th><th><%- lan.Email %></th><th><%- lan.Type %></th><th><%- lan.Library_ID %></th><th><%- lan.Status %></th></tr></thead>
        <tbody>
          <% members.forEach(m => { %>
          <tr>
            <td>
              <div class="lib-mini-user">
                <div class="lib-user-avatar"><%= (m.first_name || '?').charAt(0).toUpperCase() %></div>
                <div>
                  <div class="lib-title-main"><%= m.first_name %> <%= m.last_name %></div>
                  <div class="lib-title-sub"><%= m.member_type || m.role || lan.Member %></div>
                </div>
              </div>
            </td>
            <td><%= m.email %></td>
            <td><span class="badge badge-issued"><%= m.member_type || m.role %></span></td>
            <td><strong><%= m.library_id || '-' %></strong></td>
            <td><span class="badge badge-<%= m.status %>"><%= m.status %></span></td>
          </tr>
          <% }) %>
          <% if(!members.length){ %>
            <tr><td colspan="5" class="empty"><div class="lib-empty-icon"><i class="fas fa-user-slash"></i></div><div class="lib-empty-title"><%- lan.No_Members_Found %></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>