<div class="flex justify-between items-center mb-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight">My Video Meetings</h2>
        <p class="text-xs text-gray-500 mt-1">View scheduled online meetings and video conferences</p>
    </div>
</div>

<div class="card">
    <% if (!meetings || meetings.length === 0) { %>
        <div class="empty-state py-8 text-center text-gray-500">
            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3 text-slate-400">
                <i class="fas fa-video-slash fa-2x"></i>
            </div>
            <h4 class="font-bold text-gray-700 mb-1">No Meetings Scheduled</h4>
            <p class="text-xs text-gray-400">There are no upcoming or past video meetings scheduled for you yet.</p>
        </div>
    <% } else { %>
        <div class="table-card overflow-hidden">
            <div class="table-container">
                <table class="data-table w-full">
                    <thead>
                        <tr>
                            <th class="text-left">Meeting Info</th>
                            <th class="text-left">Host</th>
                            <th class="text-left">Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% meetings.forEach(meeting => { %>
                            <%
                                let badgeClass = 'badge-secondary';
                                if (meeting.status === 'scheduled') badgeClass = 'badge-primary';
                                if (meeting.status === 'live') badgeClass = 'badge-success animate-pulse';
                                if (meeting.status === 'completed') badgeClass = 'badge-secondary';

                                const startMs = new Date(meeting.scheduled_at).getTime();
                                const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                                const now = Date.now();
                                const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
                            %>
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-4 py-3">
                                    <div class="font-bold text-gray-800"><%= meeting.title %></div>
                                    <div class="text-[11px] text-gray-400 mt-1 flex items-center gap-2">
                                        <span><i class="fas fa-calendar-alt me-1"></i><%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
                                        <span>·</span>
                                        <span><i class="fas fa-clock me-1"></i><%= meeting.duration_minutes %> mins</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-gray-600 font-semibold text-xs">
                                    <%= meeting.creator_name || 'Admin' %>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="badge <%= badgeClass %>">
                                        <%= meeting.status %>
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/librarian/meetings/<%= meeting.id %>" class="btn btn-sm btn-secondary text-xs">
                                            <i class="fas fa-eye me-1"></i> Details
                                        </a>
                                        <% if (canJoin) { %>
                                            <a href="/librarian/meetings/<%= meeting.id %>/join" class="btn btn-sm btn-primary text-xs">
                                                <i class="fas fa-video me-1"></i> Join
                                            </a>
                                        <% } else { %>
                                            <button class="btn btn-sm btn-secondary text-xs opacity-50 cursor-not-allowed" disabled>
                                                <i class="fas fa-video me-1"></i> Join
                                            </button>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>