<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Privacy Policy | SchoolSync</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --primary-soft: #eef2ff;
            --accent: #7c3aed;
            --text: #0f172a;
            --text-soft: #475569;
            --muted: #64748b;
            --border: #e2e8f0;
            --surface: #ffffff;
            --surface-soft: #f8fafc;
            --radius-lg: 20px;
            --radius-md: 14px;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 12px 36px rgba(15, 23, 42, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at 100% 0%, rgba(79, 70, 229, 0.06), transparent 28rem),
                radial-gradient(circle at 0% 20%, rgba(124, 58, 237, 0.05), transparent 26rem),
                var(--surface-soft);
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* Top Bar */
        .topbar {
            height: 68px;
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.92);
            border-bottom: 1px solid rgba(226, 232, 240, 0.9);
            backdrop-filter: blur(14px);
            position: sticky;
            top: 0;
            z-index: 50;
            width: 100%;
        }

        .topbar-inner {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            box-shadow: 0 8px 22px rgba(79, 70, 229, 0.24);
        }

        .brand-icon i {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            line-height: 1;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 40px;
            padding: 0 16px;
            border: 1px solid var(--border);
            border-radius: 12px;
            color: var(--text-soft);
            background: #fff;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .nav-btn:hover {
            color: var(--primary-dark);
            border-color: #c7d2fe;
            background: var(--primary-soft);
            transform: translateY(-1px);
        }

        .page-shell {
            width: 100%;
            max-width: 1280px;
            margin: 28px auto 0;
            padding: 0 24px;
        }

        .hero {
            position: relative;
            overflow: hidden;
            padding: 44px 48px;
            border-radius: 28px;
            color: #fff;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 60%, #9333ea 100%);
            box-shadow: 0 24px 70px rgba(79, 70, 229, 0.20);
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            right: -90px;
            top: -120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            pointer-events: none;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 14px;
            margin-bottom: 16px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .hero h1 {
            font-size: clamp(32px, 3.5vw, 48px);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.04em;
        }

        .hero p {
            max-width: 640px;
            margin-top: 14px;
            color: rgba(255, 255, 255, 0.85);
            font-size: 16px;
        }

        .meta-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 20px;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.75);
            font-weight: 500;
        }

        .legal-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 36px;
            margin-top: 36px;
            align-items: start;
        }

        .toc-card {
            position: sticky;
            top: 92px;
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--surface);
            box-shadow: var(--shadow-sm);
        }

        .toc-title {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--muted);
            margin-bottom: 14px;
        }

        .toc-nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .toc-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-soft);
            transition: all 0.2s ease;
        }

        .toc-link:hover, .toc-link.active {
            color: var(--primary-dark);
            background: var(--primary-soft);
            font-weight: 700;
        }

        .toc-link.active {
            padding-left: 9px;
        }

        .toc-link i {
            width: 16px;
            font-size: 13px;
            text-align: center;
            color: var(--primary);
        }

        .content-stack {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .legal-section {
            scroll-margin-top: 85px;
            padding: 32px;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--surface);
            box-shadow: var(--shadow-sm);
            transition: all 0.25s ease;
        }

        .legal-section:hover, .legal-section:target, .legal-section.active {
            border-color: #a5b4fc;
            box-shadow: 0 12px 32px rgba(79, 70, 229, 0.12);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
        }

        .section-num {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-soft);
            color: var(--primary-dark);
            font-size: 14px;
            font-weight: 800;
            flex-shrink: 0;
        }

        .section-header h2 {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text);
        }

        .legal-section p {
            color: var(--text-soft);
            font-size: 14px;
            line-height: 1.7;
            margin-bottom: 14px;
        }

        .legal-section p:last-child {
            margin-bottom: 0;
        }

        .check-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 14px;
        }

        .check-list li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 14px;
            color: var(--text-soft);
            line-height: 1.6;
        }

        .check-list li i {
            margin-top: 4px;
            font-size: 14px;
            flex-shrink: 0;
            color: #059669;
        }

        .highlight-box {
            padding: 20px;
            border-radius: 14px;
            background: #f5f3ff;
            border: 1px solid #ddd6fe;
            margin-top: 16px;
        }

        .highlight-box p {
            color: #4c1d95;
            font-size: 13.5px;
            font-weight: 500;
            margin: 0;
        }

        .contact-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 24px;
            border-radius: 18px;
            background: linear-gradient(135deg, #eef2ff 0%, #faf5ff 100%);
            border: 1px solid #c7d2fe;
            margin-top: 10px;
        }

        .contact-card-text h3 {
            font-size: 16px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 4px;
        }

        .contact-card-text p {
            font-size: 13px;
            color: var(--text-soft);
            margin: 0;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 20px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #fff;
            font-size: 13.5px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(79, 70, 229, 0.35);
        }

        .footer {
            width: 100%;
            max-width: 1280px;
            margin: 40px auto 0;
            padding: 24px 24px 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 13px;
        }

        .footer-links {
            display: flex;
            gap: 20px;
        }

        .footer-links a:hover {
            color: var(--primary);
        }

        @media (max-width: 960px) {
            .legal-grid {
                grid-template-columns: 1fr;
            }

            .toc-card {
                position: static;
            }
        }

        @media (max-width: 640px) {
            .page-shell, .topbar-inner, .footer {
                padding-left: 16px;
                padding-right: 16px;
            }

            .hero {
                padding: 28px 22px;
                border-radius: 20px;
            }

            .legal-section {
                padding: 20px;
            }

            .contact-card {
                flex-direction: column;
                align-items: flex-start;
            }

            .footer {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a href="/" class="brand" aria-label="SchoolSync Home">
                <span class="brand-icon"><i class="fa-solid fa-school"></i></span>
                <span>SchoolSync</span>
            </a>
            <div class="topbar-actions">
                <a href="/support" class="nav-btn">
                    <i class="fa-solid fa-headset"></i> <%- (typeof lan !== 'undefined' && lan.Support) ? lan.Support : 'Support' %>
                </a>
                <a href="/" class="nav-btn">
                    <i class="fa-solid fa-arrow-left"></i> <%- (typeof lan !== 'undefined' && lan.Back_To_Home) ? lan.Back_To_Home : 'Back to home' %>
                </a>
            </div>
        </div>
    </header>
    <main class="page-shell">
        <section class="hero">
            <span class="eyebrow">
                <i class="fa-solid fa-user-shield"></i> <%- (typeof lan !== 'undefined' && lan.Data_Protection) ? lan.Data_Protection : 'SchoolSync Data Protection' %>
            </span>
            <h1><%- (typeof lan !== 'undefined' && lan.Privacy_Policy) ? lan.Privacy_Policy : 'Privacy Policy' %></h1>
            <p><%- (typeof lan !== 'undefined' && lan.Privacy_Policy_Subtitle) ? lan.Privacy_Policy_Subtitle : 'How SchoolSync collects, processes, isolates, and protects student, staff, and institutional data.' %></p>
            <div class="meta-pill">
                <i class="fa-solid fa-circle-info"></i> <%- (typeof lan !== 'undefined' && lan.Privacy_Last_Updated) ? lan.Privacy_Last_Updated : 'Last updated: June 2026 • Compliant with educational privacy standards' %>
            </div>
        </section>
        <div class="legal-grid">
            <aside class="toc-card" aria-label="Table of Contents">
                <div class="toc-title"><%- (typeof lan !== 'undefined' && lan.Quick_Navigation) ? lan.Quick_Navigation : 'Quick Navigation' %></div>
                <nav class="toc-nav">
                    <a href="#intro" class="toc-link"><i class="fa-solid fa-circle-info"></i> <%- (typeof lan !== 'undefined' && lan.TOC_Intro) ? lan.TOC_Intro : '1. Introduction' %></a>
                    <a href="#collection" class="toc-link"><i class="fa-solid fa-folder-open"></i> <%- (typeof lan !== 'undefined' && lan.TOC_Data_Collected) ? lan.TOC_Data_Collected : '2. Data Collected' %></a>
                    <a href="#usage" class="toc-link"><i class="fa-solid fa-gears"></i> <%- (typeof lan !== 'undefined' && lan.TOC_Data_Usage) ? lan.TOC_Data_Usage : '3. Data Usage' %></a>
                    <a href="#security" class="toc-link"><i class="fa-solid fa-lock"></i> <%- (typeof lan !== 'undefined' && lan.TOC_Security_Storage) ? lan.TOC_Security_Storage : '4. Security & Storage' %></a>
                    <a href="#sharing" class="toc-link"><i class="fa-solid fa-share-nodes"></i> <%- (typeof lan !== 'undefined' && lan.TOC_Data_Sharing) ? lan.TOC_Data_Sharing : '5. Data Sharing' %></a>
                    <a href="#rights" class="toc-link"><i class="fa-solid fa-user-gear"></i> <%- (typeof lan !== 'undefined' && lan.TOC_User_Rights) ? lan.TOC_User_Rights : '6. User Rights' %></a>
                    <a href="#contact" class="toc-link"><i class="fa-solid fa-envelope"></i> <%- (typeof lan !== 'undefined' && lan.TOC_Contact_Us) ? lan.TOC_Contact_Us : '7. Contact Us' %></a>
                </nav>
            </aside>
            <div class="content-stack">
                <article class="legal-section" id="intro">
                    <div class="section-header">
                        <span class="section-num">1</span>
                        <h2><%- (typeof lan !== 'undefined' && lan.Intro_Heading) ? lan.Intro_Heading : 'Introduction' %></h2>
                    </div>
                    <p><%- (typeof lan !== 'undefined' && lan.Privacy_Intro_Text) ? lan.Privacy_Intro_Text : 'SchoolSync (\"we\", \"our\", \"us\") provides an integrated cloud-based school management platform for educational institutions, administrators, teachers, students, parents, librarians, and transport personnel. This Privacy Policy outlines our commitments regarding the collection, processing, and protection of personal and institutional information.' %></p>
                </article>
                <article class="legal-section" id="collection">
                    <div class="section-header">
                        <span class="section-num">2</span>
                        <h2><%- (typeof lan !== 'undefined' && lan.Info_We_Collect_Heading) ? lan.Info_We_Collect_Heading : 'Information We Collect' %></h2>
                        </div>
                    <p><%- (typeof lan !== 'undefined' && lan.Info_We_Collect_Desc) ? lan.Info_We_Collect_Desc : 'We collect only the essential information necessary to perform school administrative functions, facilitate parent-teacher communication, process fee payments, and operate transport tracking.' %></p>
                    <ul class="check-list">
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span><strong><%- (typeof lan !== 'undefined' && lan.Account_Credentials_Title) ? lan.Account_Credentials_Title : 'Account Credentials:' %></strong> <%- (typeof lan !== 'undefined' && lan.Account_Credentials_Desc) ? lan.Account_Credentials_Desc : 'Full names, official email addresses, mobile numbers, assigned roles, and encrypted authentication secrets.' %></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span><strong><%- (typeof lan !== 'undefined' && lan.Academic_Records_Title) ? lan.Academic_Records_Title : 'Academic & Operational Records:' %></strong> <%- (typeof lan !== 'undefined' && lan.Academic_Records_Desc) ? lan.Academic_Records_Desc : 'Daily student attendance, exam marks, homework assignments, class timetables, and library borrowing logs.' %></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span><strong><%- (typeof lan !== 'undefined' && lan.Financial_Data_Title) ? lan.Financial_Data_Title : 'Financial & Payment Data:' %></strong> <%- (typeof lan !== 'undefined' && lan.Financial_Data_Desc) ? lan.Financial_Data_Desc : 'Fee payment status, receipt references, and Razorpay transaction IDs. (Card secrets are directly handled by Razorpay).' %></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span><strong><%- (typeof lan !== 'undefined' && lan.Admission_Docs_Title) ? lan.Admission_Docs_Title : 'Admission Documents:' %></strong> <%- (typeof lan !== 'undefined' && lan.Admission_Docs_Desc) ? lan.Admission_Docs_Desc : 'Certificates, identity documents, and student photographs stored securely with role-restricted access.' %></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span><strong><%- (typeof lan !== 'undefined' && lan.Transport_Location_Title) ? lan.Transport_Location_Title : 'Transport Location Data:' %></strong> <%- (typeof lan !== 'undefined' && lan.Transport_Location_Desc) ? lan.Transport_Location_Desc : 'Live GPS coordinates emitted during active driver trips for vehicle tracking.' %></span>
                        </li>
                    </ul>
                </article>
                <article class="legal-section" id="usage">
                    <div class="section-header">
                        <span class="section-num">3</span>
                        <h2><%- (typeof lan !== 'undefined' && lan.How_We_Use_Heading) ? lan.How_We_Use_Heading : 'How We Use Information' %></h2>
                    </div>
                    <p><%- (typeof lan !== 'undefined' && lan.How_We_Use_Desc) ? lan.How_We_Use_Desc : 'All collected information is used strictly to power platform features and fulfill educational duties.' %></p>
                    <div class="highlight-box">
                        <p><i class="fa-solid fa-ban mr-2"></i> <strong><%- (typeof lan !== 'undefined' && lan.Zero_Data_Monetization_Title) ? lan.Zero_Data_Monetization_Title : 'Zero Data Monetization:' %></strong> <%- (typeof lan !== 'undefined' && lan.Zero_Data_Monetization_Desc) ? lan.Zero_Data_Monetization_Desc : 'We do not sell, rent, trade, or share student or institutional personal data with third-party advertisers or data brokers under any circumstances.' %></p>
                    </div>
                </article>
                <article class="legal-section" id="security">
                    <div class="section-header">
                        <span class="section-num">4</span>
                        <h2><%- (typeof lan !== 'undefined' && lan.Data_Isolation_Security_Heading) ? lan.Data_Isolation_Security_Heading : 'Data Isolation & Security' %></h2>
                    </div>
                    <p><%- (typeof lan !== 'undefined' && lan.Data_Isolation_Security_Desc) ? lan.Data_Isolation_Security_Desc : 'Security is embedded into every layer of SchoolSync architecture:' %></p>
                    <ul class="check-list">
                        <li>
                            <i class="fa-solid fa-shield-halved text-indigo-600"></i>
                            <span><strong><%- (typeof lan !== 'undefined' && lan.Multi_Tenant_Title) ? lan.Multi_Tenant_Title : 'Multi-Tenant Data Isolation:' %></strong> <%- (typeof lan !== 'undefined' && lan.Multi_Tenant_Desc) ? lan.Multi_Tenant_Desc : 'Data is strictly scoped per school. Users from one institution cannot query or view records belonging to another school.' %></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-key text-amber-600"></i>
                            <span><strong><%- (typeof lan !== 'undefined' && lan.Encrypted_Comm_Title) ? lan.Encrypted_Comm_Title : 'Encrypted Communication:' %></strong> <%- (typeof lan !== 'undefined' && lan.Encrypted_Comm_Desc) ? lan.Encrypted_Comm_Desc : 'All web traffic is transmitted over HTTPS/TLS, with encrypted password hashing and CSRF protections enabled.' %></span>
                        </li>
                    </ul>
                </article>
                <article class="legal-section" id="sharing">
                    <div class="section-header">
                        <span class="section-num">5</span>
                        <h2><%- (typeof lan !== 'undefined' && lan.Third_Party_Sharing_Heading) ? lan.Third_Party_Sharing_Heading : 'Third-Party Data Sharing' %></h2>
                    </div>
                    <p><%- (typeof lan !== 'undefined' && lan.Third_Party_Sharing_Desc) ? lan.Third_Party_Sharing_Desc : 'We share data only with verified service infrastructure partners necessary for operational delivery, such as payment gateways (Razorpay) and transactional notification providers.' %></p>
                </article>
                <article class="legal-section" id="rights">
                    <div class="section-header">
                        <span class="section-num">6</span>
                        <h2><%- (typeof lan !== 'undefined' && lan.Institutional_Rights_Heading) ? lan.Institutional_Rights_Heading : 'Institutional & User Rights' %></h2>
                    </div>
                    <p><%- (typeof lan !== 'undefined' && lan.Institutional_Rights_Desc) ? lan.Institutional_Rights_Desc : 'Students and parents may request correction or deletion of personal information through their school\'s Super Admin or School Admin. School Administrators retain full control over export and deletion of their institution\'s database.' %></p>
                </article>
                <article class="legal-section" id="contact">
                    <div class="section-header">
                        <span class="section-num">7</span>
                        <h2><%- (typeof lan !== 'undefined' && lan.Privacy_Contact_Heading) ? lan.Privacy_Contact_Heading : 'Privacy Questions & Contact' %></h2>
                    </div>
                    <p><%- (typeof lan !== 'undefined' && lan.Privacy_Contact_Desc) ? lan.Privacy_Contact_Desc : 'If you have any privacy questions, data protection inquiries, or security reports, please reach out to our privacy officer through our support desk.' %></p>
                    <div class="contact-card">
                        <div class="contact-card-text">
                            <h3><%- (typeof lan !== 'undefined' && lan.Need_Help_Privacy_Title) ? lan.Need_Help_Privacy_Title : 'Need help with privacy or account data?' %></h3>
                            <p><%- (typeof lan !== 'undefined' && lan.Need_Help_Privacy_Desc) ? lan.Need_Help_Privacy_Desc : 'Contact our support team for prompt assistance.' %></p>
                        </div>
                        <a href="/support" class="btn-primary">
                            <i class="fa-solid fa-paper-plane"></i> <%- (typeof lan !== 'undefined' && lan.Contact_Support) ? lan.Contact_Support : 'Contact Support' %>
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </main>
    <footer class="footer">
        <div>&copy; <%= new Date().getFullYear() %> SchoolSync. <%- (typeof lan !== 'undefined' && lan.Rights_Reserved) ? lan.Rights_Reserved : 'All rights reserved.' %></div>
        <nav class="footer-links" aria-label="Footer Navigation">
            <a href="/privacy"><%- (typeof lan !== 'undefined' && lan.Privacy_Policy) ? lan.Privacy_Policy : 'Privacy Policy' %></a>
            <a href="/terms"><%- (typeof lan !== 'undefined' && lan.Terms_Of_Service) ? lan.Terms_Of_Service : 'Terms of Service' %></a>
            <a href="/support"><%- (typeof lan !== 'undefined' && lan.Support_Center) ? lan.Support_Center : 'Support Center' %></a>
        </nav>
    </footer>
    <script>
        window.addEventListener("DOMContentLoaded", () => {
            const links = document.querySelectorAll(".toc-link");
            const sections = document.querySelectorAll(".legal-section");

            function updateActiveState() {
                let activeId = "";
                const scrollPosition = window.scrollY + 140;

                sections.forEach((section) => {
                    const top = section.offsetTop;
                    const height = section.offsetHeight;
                    if (scrollPosition >= top && scrollPosition < top + height) {
                        activeId = section.getAttribute("id");
                    };
                });

                if (!activeId && window.location.hash) {
                    activeId = window.location.hash.substring(1);
                };

                if (!activeId && sections.length > 0) {
                    activeId = sections[0].getAttribute("id");
                };

                links.forEach((link) => {
                    const targetId = link.getAttribute("href").replace("#", "");
                    if (targetId === activeId) {
                        link.classList.add("active");
                    } else {
                        link.classList.remove("active");
                    };
                });

                sections.forEach((section) => {
                    if (section.getAttribute("id") === activeId) {
                        section.classList.add("active");
                    } else {
                        section.classList.remove("active");
                    };
                });
            };

            window.addEventListener("scroll", updateActiveState);
            window.addEventListener("hashchange", updateActiveState);
            updateActiveState();
        });
    </script>
</body>
</html>