<style>
    .filter-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 20px;
        align-items: center;
    }
    .filter-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        border: 1.5px solid var(--border);
        background: var(--surface);
        color: var(--text-muted);
    }
    .filter-tab:hover {
        background: #f0f4ff;
        color: #4f46e5;
        border-color: #4f46e5;
    }
    .filter-tab.active {
        background: #4f46e5;
        color: white;
        border-color: #4f46e5;
    }
    .table-card {
        background: var(--surface);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
    }
    table {
        width: 100%;
        border-collapse: collapse;
    }
    thead th {
        background: var(--surface-hover);
        padding: 13px 16px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        border-bottom: 1px solid var(--border);
        text-align: left;
        white-space: nowrap;
    }
    tbody td {
        padding: 14px 16px;
        font-size: 13px;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
    }
    tbody tr:last-child td {
        border-bottom: none;
    }
    tbody tr:hover {
        background: var(--surface-hover);
    }
    .applicant-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        color: white;
        flex-shrink: 0;
    }
    .applicant-info .name {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 13px;
    }
    .applicant-info .email {
        font-size: 11px;
        color: var(--text-muted);
    }
    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    .badge-status.pending {
        background: #fff7ed;
        color: #c05621;
    }
    .badge-status.approved {
        background: #f0fdf4;
        color: #15803d;
    }
    .badge-status.rejected {
        background: #fef2f2;
        color: #dc2626;
    }
    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 13px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
        border: none;
    }
    .btn-view {
        background: #eeebff;
        color: #4f46e5;
    }
    .btn-view:hover {
        background: #4f46e5;
        color: white;
    }
    .btn-approve {
        background: #f0fdf4;
        color: #16a34a;
    }
    .btn-approve:hover {
        background: #16a34a;
        color: white;
    }
    .btn-reject {
        background: #fef2f2;
        color: #dc2626;
    }
    .btn-reject:hover {
        background: #dc2626;
        color: white;
    }
    .search-box {
        position: relative;
        margin-left: auto;
    }
    .search-box input {
        padding: 8px 14px 8px 36px;
        border: 1.5px solid var(--border);
        border-radius: 30px;
        font-size: 13px;
        outline: none;
        width: 220px;
        background: var(--surface);
        color: var(--text-primary);
        transition: all 0.2s;
    }
    .search-box input:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }
    .search-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 13px;
    }
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }
    .modal-box {
        background: white;
        border-radius: 16px;
        padding: 30px;
        max-width: 550px;
        width: 90%;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin: 20px 0;
    }
    .info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .info-item label {
        font-size: 10px;
        font-weight: 700;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .info-item span {
        font-size: 13.5px;
        color: #1f2937;
        font-weight: 500;
    }
    .info-item.full-width {
        grid-column: 1 / -1;
    }
    .btn-qr {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 18px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-qr:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 5px 15px rgba(79, 70, 229, 0.3);
        color: white;
    }
</style>
<%- include('../partials/head') %>
<div class="app-wrapper schooladmin-theme">
    <%- include('../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
    <div class="main-panel">
        <%- include('../partials/header') %>
        <div class="content">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Teacher Onboarding</h2>
                    <p class="text-xs text-gray-500 mt-1">Review and manage teacher registration applications</p>
                </div>
                <a href="/schooladmin/admissions/qr" class="btn-qr">
                    <i class="fas fa-qrcode"></i> View QR Portals
                </a>
            </div>
            <%- include('../partials/flashMessages') %>
            <% if (success && success.length) { %>
                <div class="alert-banner success mb-4"><i class="fas fa-check-circle"></i>
                    <%= success[0] %>
                </div>
            <% } %>
            <% if (error && error.length) { %>
                <div class="alert-banner error mb-4">
                    <i class="fas fa-exclamation-triangle"></i>
                    <%= error[0] %>
                </div>
            <% } %>
            <div class="filter-bar">
                <a href="/admin/teachers/applications?status=pending" class="filter-tab <%= currentStatus === 'pending' ? 'active' : '' %>">
                    <i class="fas fa-clock"></i> Pending
                </a>
                <a href="/admin/teachers/applications?status=approved" class="filter-tab <%= currentStatus === 'approved' ? 'active' : '' %>">
                    <i class="fas fa-check-circle"></i> Approved
                </a>
                <a href="/admin/teachers/applications?status=rejected" class="filter-tab <%= currentStatus === 'rejected' ? 'active' : '' %>">
                    <i class="fas fa-times-circle"></i> Rejected
                </a>
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search applicant..." oninput="filterTable()">
                </div>
            </div>
            <div class="table-card">
                <% if (applications && applications.length> 0) { %>
                    <table id="applicationsTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Applicant Details</th>
                                <th>Phone</th>
                                <th>Subjects</th>
                                <th>Qualification</th>
                                <th>Experience</th>
                                <th>Submitted</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% const
                                avatarColors=['#4f46e5','#10b981','#f59e0b','#3b82f6','#ec4899','#8b5cf6'];
                                applications.forEach((a, i)=> {
                                const initials = a.full_name.split(' ').map(w =>
                                w[0]).join('').substring(0,2).toUpperCase();
                                const color = avatarColors[i % avatarColors.length];

                                let extra = a.extra_data;
                                if (typeof extra === 'string') {
                                try { extra = JSON.parse(extra); } catch(e) { extra =
                                {}; }
                                }
                                extra = extra || {};
                                const subjects = extra.subjects || '—';
                                const qualification = extra.qualification || '—';
                                const experience = extra.experience !== undefined ?
                                `${extra.experience} yrs` : '—';
                                const dob = extra.dob ? new
                                Date(extra.dob).toLocaleDateString('en-IN',
                                {day:'2-digit',month:'short',year:'numeric'}) : '—';
                                const address = a.address || '—';
                                const prevSchool = extra.previous_school || '—';
                                %>
                                <tr class="application-row" data-name="<%= a.full_name.toLowerCase() %>" data-email="<%= a.email.toLowerCase() %>">
                                    <td style="color:var(--text-muted);font-size:12px;">
                                        <%= i + 1 %>
                                    </td>
                                    <td>
                                        <div class="applicant-cell">
                                            <div class="avatar" style="background:<%= color %>"><%= initials %></div>
                                            <div class="applicant-info">
                                                <div class="name"><%= a.full_name %></div>
                                                <div class="email"><%= a.email %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><%= a.phone || '—' %></td>
                                    <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= subjects %></td>
                                    <td><%= qualification %></td>
                                    <td><%= experience %></td>
                                    <td style="font-size:12px;color:var(--text-muted);">
                                        <%= new Date(a.submitted_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %>
                                    </td>
                                    <td>
                                        <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                            <button class="action-btn btn-view"
                                                data-id="<%= a.id %>"
                                                data-name="<%= a.full_name %>"
                                                data-email="<%= a.email %>"
                                                data-phone="<%= a.phone || '—' %>"
                                                data-dob="<%= dob %>"
                                                data-address="<%= address %>"
                                                data-subjects="<%= subjects %>"
                                                data-qualification="<%= qualification %>"
                                                data-experience="<%= experience %>"
                                                data-prevschool="<%= prevSchool %>"
                                                data-status="<%= a.status %>"
                                                data-note="<%= a.admin_note || '' %>"
                                                data-marital="<%= extra.marital_status || '—' %>"
                                                data-emergency="<%= extra.emergency_contact || '—' %>"
                                                data-father="<%= extra.father_name || '—' %>"
                                                data-mother="<%= extra.mother_name || '—' %>"
                                                data-joiningdate="<%= extra.joining_date ? new Date(extra.joining_date).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) : '—' %>"
                                                data-salary="<%= extra.salary ? '₹' + extra.salary : '—' %>"
                                                data-prevjoining="<%= extra.prev_joining_date ? new Date(extra.prev_joining_date).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) : '—' %>"
                                                data-totalexp="<%= extra.total_experience !== undefined ? extra.total_experience + ' yrs' : '—' %>"
                                                data-medical="<%= extra.medical_issues || '—' %>"
                                                data-height="<%= extra.height ? extra.height + ' cm' : '—' %>"
                                                data-weight="<%= extra.weight ? extra.weight + ' kg' : '—' %>"
                                                data-blood="<%= extra.blood_group || '—' %>"
                                                data-permaddress="<%= extra.permanent_address || '—' %>"
                                                data-files="<%= JSON.stringify(extra.files || {}) %>"
                                                onclick="showApplicationDetails(this)">
                                                <i class="fas fa-eye"></i> Details
                                            </button>
                                            <% if (a.status==='pending' ) { %>
                                                <button class="action-btn btn-approve" data-id="<%= a.id %>" data-name="<%= a.full_name %>" onclick="quickApproveBtn(this)">
                                                    <i class="fas fa-check"></i> Approve
                                                </button>
                                                <button class="action-btn btn-reject" data-id="<%= a.id %>" data-name="<%= a.full_name %>" onclick="quickRejectBtn(this)">
                                                    <i class="fas fa-times"></i> Reject
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="empty-state" style="text-align:center;padding:50px 20px;color:var(--text-muted);">
                        <div class="empty-state-icon">
                            <i class="fas fa-inbox" style="font-size: 40px; margin-bottom: 12px; color: #cbd5e1;"></i>
                        </div>
                        <h4 class="empty-state-title" style="font-size: 15px; font-weight: 700; margin-bottom: 6px;">No applications found</h4>
                        <p class="empty-state-text" style="font-size: 13px;">There are currently no <%= currentStatus %> teacher onboarding requests.</p>
                    </div>
                <% } %>
            </div>
        </div>
        <%- include('../partials/footer') %>
    </div>
</div>
<div id="detailsModal" class="modal-overlay" onclick="closeDetailsModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1.5px solid #f3f4f6; padding-bottom:12px; margin-bottom:16px;">
            <h3 style="font-size:16px; font-weight:700; color:#1f2937;">Teacher Application Details</h3>
            <button onclick="closeDetailsModal()" style="background:none; border:none; color:#9ca3af; cursor:pointer; font-size:18px;"><i class="fas fa-times"></i><button>
        </div>
        <div class="info-grid">
            <div class="info-item">
                <label>Full Name</label>
                <span id="detailName"></span>
            </div>
            <div class="info-item">
                <label>Email Address</label>
                <span id="detailEmail"></span>
            </div>
            <div class="info-item">
                <label>Phone Number</label>
                <span id="detailPhone"></span>
            </div>
            <div class="info-item">
                <label>Date of Birth</label>
                <span id="detailDob"></span>
            </div>
            <div class="info-item">
                <label>Gender</label>
                <span id="detailGender">—</span>
            </div>
            <div class="info-item">
                <label>Marital Status</label>
                <span id="detailMarital"></span>
            </div>
            <div class="info-item">
                <label>Father's Name</label>
                <span id="detailFather"></span>
            </div>
            <div class="info-item">
                <label>Mother's Name</label>
                <span id="detailMother"></span>
            </div>
            <div class="info-item">
                <label>Emergency Contact</label>
                <span id="detailEmergency"></span>
            </div>
            <div class="info-item full-width" style="border-top:1px solid #f3f4f6; margin-top:5px; padding-top:10px;">
                <label style="color:#4f46e5; font-weight:700;">Professional Details</label>
            </div>
            <div class="info-item">
                <label>Qualifications</label>
                <span id="detailQualification"></span>
            </div>
            <div class="info-item">
                <label>Years of Experience</label>
                <span id="detailExperience"></span>
            </div>
            <div class="info-item">
                <label>Joining Date</label>
                <span id="detailJoiningDate"></span>
            </div>
            <div class="info-item">
                <label>Expected Salary</label>
                <span id="detailSalary"></span>
            </div>
            <div class="info-item full-width">
                <label>Subjects Can Teach</label>
                <span id="detailSubjects"></span>
            </div>
            <div class="info-item full-width" style="border-top:1px solid #f3f4f6; margin-top:5px; padding-top:10px;">
                <label style="color:#4f46e5; font-weight:700;">Previous Work Experience</label>
            </div>
            <div class="info-item full-width">
                <label>Previous School</label>
                <span id="detailPrevSchool"></span>
            </div>
            <div class="info-item">
                <label>Previous Joining Date</label>
                <span id="detailPrevJoining"></span>
            </div>
            <div class="info-item">
                <label>Total Experience</label>
                <span id="detailTotalExp"></span>
            </div>
            <div class="info-item full-width" style="border-top:1px solid #f3f4f6; margin-top:5px; padding-top:10px;">
                <label style="color:#4f46e5; font-weight:700;">Medical Details</label>
            </div>
            <div class="info-item full-width">
                <label>Medical Issues</label>
                <span id="detailMedical"></span>
            </div>
            <div class="info-item">
                <label>Height</label>
                <span id="detailHeight"></span>
            </div>
            <div class="info-item">
                <label>Weight</label>
                <span id="detailWeight"></span>
            </div>
            <div class="info-item">
                <label>Blood Group</label>
                <span id="detailBlood"></span>
            </div>
            <div class="info-item full-width" style="border-top:1px solid #f3f4f6; margin-top:5px; padding-top:10px;">
                <label style="color:#4f46e5; font-weight:700;">Addresses</label>
            </div>
            <div class="info-item full-width">
                <label>Current Address</label>
                <span id="detailAddress"></span>
            </div>
            <div class="info-item full-width">
                <label>Permanent Address</label>
                <span id="detailPermAddress"></span>
            </div>
            <div class="info-item full-width" style="border-top:1px solid #f3f4f6; margin-top:5px; padding-top:10px;">
                <label style="color:#4f46e5; font-weight:700;">Uploaded Documents & Photo</label>
                <div id="detailDocumentsContainer" style="margin-top:8px;"></div>
            </div>
            <div class="info-item full-width" style="border-top:1px solid #f3f4f6; margin-top:5px; padding-top:10px;"></div>
            <div class="info-item">
                <label>Application Status</label>
                <span id="detailStatus"></span>
            </div>
            <div class="info-item" id="adminNoteContainer">
                <label>Decision Reason / Note</label>
                <span id="detailAdminNote"></span>
            </div>
        </div>
        <div id="modalActionButtons" style="display:none; gap:10px; border-top:1.5px solid #f3f4f6; padding-top:16px; margin-top:20px;">
            <button id="modalApproveBtn" class="action-btn btn-approve" style="flex:1; justify-content:center; padding:10px; font-weight:700;">
                <i class="fas fa-check"></i> Approve Application
            </button>
            <button id="modalRejectBtn" class="action-btn btn-reject" style="flex:1; justify-content:center; padding:10px; font-weight:700;">
                <i class="fas fa-times"></i> Reject Application
            </button>
        </div>
    </div>
</div>
<div id="rejectModal" class="modal-overlay" onclick="closeRejectModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()" style="max-width:420px;">
        <h3 style="font-size:16px; font-weight:700; margin-bottom:8px; color:#1f2937;">Reject Application</h3>
        <p style="font-size:13px; color:#6b7280; margin-bottom:18px;">Please state the reason for rejecting this application. This message will be sent to the applicant.</p>
        <form id="rejectForm" method="POST">
            <div style="margin-bottom:16px;">
                <label style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; display:block; margin-bottom:6px;">Rejection Reason <span style="color:#ef4444;">*</span></label>
                <textarea name="reason" rows="3" style="width:100%; border:1.5px solid #e5e7eb; border-radius:8px; padding:10px; font-family:inherit; font-size:13px; outline:none; resize:vertical;" placeholder="e.g. Qualifications do not match requirements..." required></textarea>
            </div>
            <div style="display:flex; gap:10px;">
                    <button type="submit" class="action-btn btn-reject"
                        style="flex:1; justify-content:center; padding:11px; font-weight:700;">Reject Now</button>
                    <button type="button" onclick="closeRejectModal()"
                        style="flex:1; justify-content:center; padding:11px; border:1.5px solid #e5e7eb; border-radius:8px; font-size:13px; font-weight:600; background:white; color:#374151; cursor:pointer;">Cancel</button>
                </div>
            </form>
        </div>
    </div>
    <div id="approveModal" class="modal-overlay" onclick="closeApproveModal(event)">
        <div class="modal-box" onclick="event.stopPropagation()" style="max-width:420px;">
            <h3 style="font-size:16px; font-weight:700; margin-bottom:8px; color:#1f2937;">Approve Application</h3>
            <p style="font-size:13px; color:#6b7280; margin-bottom:18px;">Approving this request will create a new
                Teacher user account with their email and generate an ID. Confirm below.</p>
            <form id="approveForm" method="POST">
                <div style="margin-bottom:16px;">
                    <label
                        style="font-size:11px; font-weight:600; color:#9ca3af; text-transform:uppercase; display:block; margin-bottom:6px;">Admin
                        Note (Optional)</label>
                    <textarea name="admin_note" rows="3"
                        style="width:100%; border:1.5px solid #e5e7eb; border-radius:8px; padding:10px; font-family:inherit; font-size:13px; outline:none; resize:vertical;"
                        placeholder="Add welcoming note or instructions..."></textarea>
                </div>
                <div style="display:flex; gap:10px;">
                    <button type="submit" class="action-btn btn-approve"
                        style="flex:1; justify-content:center; padding:11px; font-weight:700;">Approve Now</button>
                    <button type="button" onclick="closeApproveModal()"
                        style="flex:1; justify-content:center; padding:11px; border:1.5px solid #e5e7eb; border-radius:8px; font-size:13px; font-weight:600; background:white; color:#374151; cursor:pointer;">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function showApplicationDetails(btn) {
            const data = {
                id: btn.getAttribute('data-id'),
                name: btn.getAttribute('data-name'),
                email: btn.getAttribute('data-email'),
                phone: btn.getAttribute('data-phone'),
                dob: btn.getAttribute('data-dob'),
                address: btn.getAttribute('data-address'),
                subjects: btn.getAttribute('data-subjects'),
                qualification: btn.getAttribute('data-qualification'),
                experience: btn.getAttribute('data-experience'),
                prevSchool: btn.getAttribute('data-prevschool'),
                status: btn.getAttribute('data-status'),
                note: btn.getAttribute('data-note'),

                gender: btn.getAttribute('data-gender') || '—',
                marital: btn.getAttribute('data-marital'),
                emergency: btn.getAttribute('data-emergency'),
                father: btn.getAttribute('data-father'),
                mother: btn.getAttribute('data-mother'),
                joiningdate: btn.getAttribute('data-joiningdate'),
                salary: btn.getAttribute('data-salary'),
                prevjoining: btn.getAttribute('data-prevjoining'),
                totalexp: btn.getAttribute('data-totalexp'),
                medical: btn.getAttribute('data-medical'),
                height: btn.getAttribute('data-height'),
                weight: btn.getAttribute('data-weight'),
                blood: btn.getAttribute('data-blood'),
                permaddress: btn.getAttribute('data-permaddress'),
                files: JSON.parse(btn.getAttribute('data-files') || '{}')
            };
            viewDetails(data);
        }

        function quickApproveBtn(btn) {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            quickApprove(id, name);
        }

        function quickRejectBtn(btn) {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            quickReject(id, name);
        }

        function viewDetails(data) {
            document.getElementById('detailName').textContent = data.name;
            document.getElementById('detailEmail').textContent = data.email;
            document.getElementById('detailPhone').textContent = data.phone;
            document.getElementById('detailDob').textContent = data.dob;
            document.getElementById('detailQualification').textContent = data.qualification;
            document.getElementById('detailExperience').textContent = data.experience;
            document.getElementById('detailSubjects').textContent = data.subjects;
            document.getElementById('detailPrevSchool').textContent = data.prevSchool;
            document.getElementById('detailAddress').textContent = data.address;

            document.getElementById('detailGender').textContent = data.gender;
            document.getElementById('detailMarital').textContent = data.marital;
            document.getElementById('detailEmergency').textContent = data.emergency;
            document.getElementById('detailFather').textContent = data.father;
            document.getElementById('detailMother').textContent = data.mother;
            document.getElementById('detailJoiningDate').textContent = data.joiningdate;
            document.getElementById('detailSalary').textContent = data.salary;
            document.getElementById('detailPrevJoining').textContent = data.prevjoining;
            document.getElementById('detailTotalExp').textContent = data.totalexp;
            document.getElementById('detailMedical').textContent = data.medical;
            document.getElementById('detailHeight').textContent = data.height;
            document.getElementById('detailWeight').textContent = data.weight;
            document.getElementById('detailBlood').textContent = data.blood;
            document.getElementById('detailPermAddress').textContent = data.permaddress;

            const docContainer = document.getElementById('detailDocumentsContainer');
            docContainer.innerHTML = '';

            let hasFiles = false;
            if (data.files) {
                if (data.files.photo && data.files.photo.filename) {
                    hasFiles = true;
                    docContainer.innerHTML += `
              <div style="display:flex; justify-content:space-between; align-items:center; background:#f3f4f6; padding:8px 12px; border-radius:6px; margin-bottom:8px; font-size:12px;">
                  <span><b>Profile Photo:</b> ${data.files.photo.originalname}</span>
                  <a href="/uploads/teachers/${data.files.photo.filename}" target="_blank" style="color:#4f46e5; font-weight:600; text-decoration:none;"><i class="fas fa-external-link-alt"></i> View</a>
              </div>
          `;
                }
                if (data.files.documents && data.files.documents.length > 0) {
                    hasFiles = true;
                    data.files.documents.forEach(doc => {
                        docContainer.innerHTML += `
                  <div style="display:flex; justify-content:space-between; align-items:center; background:#f3f4f6; padding:8px 12px; border-radius:6px; margin-bottom:8px; font-size:12px;">
                      <span><b>${doc.docName} (${doc.docType}):</b> ${doc.originalname}</span>
                      <a href="/uploads/teachers/${doc.filename}" target="_blank" style="color:#4f46e5; font-weight:600; text-decoration:none;"><i class="fas fa-external-link-alt"></i> View</a>
                  </div>
              `;
                    });
                }
            }
            if (!hasFiles) {
                docContainer.innerHTML = '<span style="font-size:12px; color:#9ca3af; font-style:italic;">No documents uploaded.</span>';
            }

            const statusEl = document.getElementById('detailStatus');
            statusEl.textContent = data.status.charAt(0).toUpperCase() + data.status.slice(1);
            statusEl.className = 'badge-status ' + data.status;

            const noteContainer = document.getElementById('adminNoteContainer');
            if (data.status !== 'pending') {
                noteContainer.style.display = 'flex';
                document.getElementById('detailAdminNote').textContent = data.note || '—';
                document.getElementById('modalActionButtons').style.display = 'none';
            } else {
                noteContainer.style.display = 'none';
                document.getElementById('modalActionButtons').style.display = 'flex';

                document.getElementById('modalApproveBtn').onclick = () => {
                    closeDetailsModal();
                    quickApprove(data.id, data.name);
                };
                document.getElementById('modalRejectBtn').onclick = () => {
                    closeDetailsModal();
                    quickReject(data.id, data.name);
                };
            }

            document.getElementById('detailsModal').style.display = 'flex';
        }

        function closeDetailsModal(event) {
            document.getElementById('detailsModal').style.display = 'none';
        }

        function quickApprove(id, name) {
            const form = document.getElementById('approveForm');
            form.action = `/admin/teachers/applications/${id}/approve`;
            document.getElementById('approveModal').style.display = 'flex';
        }

        function closeApproveModal() {
            document.getElementById('approveModal').style.display = 'none';
        }

        function quickReject(id, name) {
            const form = document.getElementById('rejectForm');
            form.action = `/admin/teachers/applications/${id}/reject`;
            document.getElementById('rejectModal').style.display = 'flex';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }

        function filterTable() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('.application-row').forEach(row => {
                const name = row.dataset.name || '';
                const email = row.dataset.email || '';
                row.style.display = (name.includes(q) || email.includes(q)) ? '' : 'none';
            });
        }
    </script>

    <%- include('../partials/footer') %>