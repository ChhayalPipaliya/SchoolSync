<style>
    [data-theme="dark"],
    .light-mode-disabled,
    html[data-theme="dark"],
    html.dark {
        --ev-card-bg: #151D30;
        --ev-inner-bg: #101726;
        --ev-border: #242F4D;
        --ev-text: #F8FAFC;
        --ev-muted: #94A3B8;
    }

    [data-theme="dark"] h2.text-gray-800,
    .light-mode-disabled h2.text-gray-800 {
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .event-filter-card,
    [data-theme="dark"] .event-album-card,
    .light-mode-disabled .event-filter-card,
    .light-mode-disabled .event-album-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }

    [data-theme="dark"] .event-album-title,
    .light-mode-disabled .event-album-title {
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .event-album-desc,
    .light-mode-disabled .event-album-desc {
        color: #94A3B8 !important;
    }
</style>
<div class="flex justify-between items-center mb-3">
    <div>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight">School Memories & Events</h2>
        <p class="text-xs text-gray-500 mt-1">Explore media albums of cultural activities, sports events, festivals, and
            academic achievements.</p>
    </div>
</div>
<div class="card event-filter-card p-3 mb-3">
    <form action="/events" method="GET" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-end">
        <div class="form-group mb-0">
            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Search Album</label>
            <div class="relative flex items-center">
                <input type="text" name="search" class="form-input pl-9 text-xs" placeholder="Search albums..."
                    value="<%= search || '' %>">
            </div>
        </div>
        <div class="form-group mb-0">
            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Category</label>
            <select name="type" class="form-select text-xs" onchange="this.form.submit()">
                <option value="">All Categories</option>
                <option value="Cultural" <%=selectedType==='Cultural' ? 'selected' : '' %>>Cultural</option>
                <option value="Sports" <%=selectedType==='Sports' ? 'selected' : '' %>>Sports</option>
                <option value="Academic" <%=selectedType==='Academic' ? 'selected' : '' %>>Academic</option>
                <option value="Festival" <%=selectedType==='Festival' ? 'selected' : '' %>>Festival</option>
            </select>
        </div>
        <div class="form-group mb-0">
            <label class="form-label font-bold text-xs text-gray-400 uppercase tracking-wider mb-2">Year</label>
            <select name="year" class="form-select text-xs" onchange="this.form.submit()">
                <option value="">All Years</option>
                <% years.forEach(y=> { %>
                    <option value="<%= y %>" <%=selectedYear==y ? 'selected' : '' %>><%= y %>
                    </option>
                    <% }); %>
            </select>
        </div>
        <div class="form-group mb-0">
            <a href="/events"
                class="btn btn-secondary w-full text-xs font-bold py-2.5 flex items-center justify-center gap-1.5">
                <i class="fas fa-undo"></i> Reset
            </a>
        </div>
    </form>
</div>
<% if (events && events.length> 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% events.forEach(event=> {
            const typeBgClass = event.event_type === 'Cultural' ? 'bg-blue-500/85'
            : event.event_type === 'Sports' ? 'bg-red-500/85'
            : event.event_type === 'Academic' ? 'bg-emerald-500/85'
            : 'bg-amber-500/85';
            const downloadBgClass = event.download_allowed === 1 ? 'bg-emerald-500/85' : 'bg-slate-900/75';
            %>
            <div class="card event-album-card p-0 overflow-hidden hover:shadow-lg transition-all duration-300 rounded-2xl flex flex-col justify-between">
                <div>
                    <div class="relative bg-slate-100 overflow-hidden h-48">
                        <% if (event.cover_media_id) { %>
                            <img src="/media/<%= event.cover_media_id %>" class="w-full h-full object-cover" alt="<%= event.title %>">
                        <% } else { %>
                            <div class="w-full h-full flex flex-col justify-center items-center text-slate-400 bg-gradient-to-br from-slate-50 to-slate-100">
                                <i class="far fa-images text-4xl mb-2 text-slate-300"></i>
                                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">View Gallery Album</span>
                            </div>
                        <% } %>
                        <div class="absolute inset-0 bg-gradient-to-b from-black/20 to-black/50 pointer-events-none"></div>
                        <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[11px] font-bold text-white shadow-sm backdrop-blur-md border border-white/20 <%= typeBgClass %>">
                            <%= event.event_type %>
                        </span>
                        <span class="absolute top-3 right-3 px-3 py-1 rounded-full text-[11px] font-bold text-white shadow-sm backdrop-blur-md border border-white/20 <%= downloadBgClass %>">
                            <i class="fas <%= event.download_allowed === 1 ? 'fa-unlock' : 'fa-lock' %> me-1"></i>
                            <%= event.download_allowed===1 ? 'Downloads Allowed' : 'View Only' %>
                        </span>
                    </div>
                    <div class="p-5">
                        <h3 class="event-album-title text-base font-bold text-slate-800 mb-2 truncate"><%= event.title %></h3>
                        <div class="flex items-center gap-2 mb-3 text-slate-400 text-xs font-semibold">
                            <span><i class="far fa-calendar-alt me-1 text-orange-500"></i>
                                <%= new Date(event.event_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'short' , day: 'numeric' }) %>
                            </span>
                            <span>•</span>
                            <span class="truncate"><i class="fas fa-map-marker-alt me-1 text-rose-500"></i><%= event.venue %></span>
                        </div>
                        <p class="event-album-desc text-slate-600 text-xs line-clamp-2 min-h-[36px]"><%= event.description || 'No description provided.' %></p>
                    </div>
                </div>
                <div class="p-5 pt-0">
                    <a href="/events/<%= event.id %>" class="btn btn-primary w-full py-2.5 text-xs font-bold flex items-center justify-center gap-2 rounded-xl" style="background: linear-gradient(135deg, #EA580C, #C2410C); border: none;">
                        <i class="far fa-eye"></i> Open Gallery Album
                    </a>
                </div>
            </div>
        <% }); %>
    </div>
    <% if (totalPages> 1) { %>
        <div class="flex justify-center mt-6">
            <div class="flex gap-2">
                <% if (currentPage> 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>" class="btn btn-secondary text-xs">Previous</a>
                <% } %>
                <% for(let i=1; i <=totalPages; i++) { %>
                    <a href="?page=<%= i %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>" class="btn <%= currentPage === i ? 'btn-primary' : 'btn-secondary' %> text-xs">
                        <%= i %>
                    </a>
                <% } %>
                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&type=<%= selectedType %>&year=<%= selectedYear %>" class="btn btn-secondary text-xs">Next</a>
                <% } %>
            </div>
        </div>
    <% } %>
<% } else { %>
    <div class="card p-8 text-center text-gray-500">
        <div class="empty-state">
            <div class="empty-state-icon"><i class="far fa-folder-open"></i></div>
            <h4 class="empty-state-title">No Albums Available</h4>
            <p class="empty-state-text">Check back later for school event memories.</p>
        </div>
    </div>
<% } %>