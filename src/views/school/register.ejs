<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="Register your school on SchoolSync — India's leading school management platform.">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏫</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #4338CA;
            --primary-light: #6366F1;
            --primary-glow: rgba(99,102,241,0.12);
            --amber: #F59E0B;
            --green: #059669;
            --red: #DC2626;
            --ink: #0F0F1A;
            --ink-2: #3D3D52;
            --ink-3: #8585A0;
            --paper: #FAFAF7;
            --paper-2: #F2F2EC;
            --glass: rgba(255,255,255,0.8);
            --glass-border: rgba(255,255,255,0.4);
            --shadow: 0 4px 24px rgba(14,14,26,.08);
            --shadow-lg: 0 20px 60px rgba(14,14,26,.12);
            --radius: 20px;
            --radius-sm: 12px;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--paper);
            color: var(--ink);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── Background ── */
        .bg-gradient {
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background:
                radial-gradient(ellipse 70% 60% at 20% 20%, rgba(99,102,241,0.12) 0%, transparent 60%),
                radial-gradient(ellipse 50% 50% at 80% 80%, rgba(245,158,11,0.08) 0%, transparent 50%),
                radial-gradient(ellipse 40% 40% at 50% 50%, rgba(5,150,105,0.05) 0%, transparent 60%);
        }
        .grid-pattern {
            position: fixed; inset: 0; z-index: 0; pointer-events: none;
            background-image: linear-gradient(rgba(14,14,26,.03) 1px, transparent 1px), linear-gradient(90deg,rgba(14,14,26,.03) 1px,transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 80%);
        }

        nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            height: 68px; padding: 0 5%;
            display: flex; align-items: center; justify-content: space-between;
            background: var(--glass); backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
        }
        .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .nav-logo-mark {
            width: 38px; height: 38px; background: var(--primary);
            border-radius: 10px; display: flex; align-items: center; justify-content: center;
            color: #fff; font-weight: 800; font-size: 17px; font-family: 'Inter', sans-serif;
        }
        .nav-logo-text { font-size: 19px; font-weight: 700; color: var(--ink); font-family: 'Inter', sans-serif; }
        .nav-right { display: flex; align-items: center; gap: 12px; }
        .btn-sm {
            padding: 8px 18px; border-radius: 10px; font-size: 13px; font-weight: 700;
            text-decoration: none; transition: all .2s; border: 1.5px solid transparent; cursor: pointer;
            display: inline-flex; align-items: center; gap: 6px;
        }
        .btn-ghost { background: var(--paper-2); color: var(--ink-2); border-color: rgba(0,0,0,.08); }
        .btn-ghost:hover { background: var(--ink); color: #fff; }
        .btn-primary { background: var(--primary); color: #fff; box-shadow: 0 4px 16px rgba(67,56,202,.25); }
        .btn-primary:hover { background: #3730A3; transform: translateY(-1px); }

        /* ── Wrapper ── */
        .page-wrapper {
            min-height: 100vh; padding-top: 68px;
            display: flex; align-items: center; justify-content: center;
            padding-bottom: 60px; position: relative; z-index: 1;
        }
        .register-container {
            width: 100%; max-width: 780px; margin: 40px 20px;
            background: var(--glass); backdrop-filter: blur(30px);
            border: 1.5px solid var(--glass-border);
            border-radius: 28px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
        }
        .reg-header {
            background: linear-gradient(135deg, #4338CA, #6366F1);
            padding: 36px 44px 32px;
            position: relative; overflow: hidden;
        }
        .reg-header::before {
            content: ''; position: absolute; top: -40px; right: -40px;
            width: 200px; height: 200px;
            background: rgba(255,255,255,0.08); border-radius: 50%;
        }
        .reg-header::after {
            content: ''; position: absolute; bottom: -60px; left: -20px;
            width: 160px; height: 160px;
            background: rgba(255,255,255,0.05); border-radius: 50%;
        }
        .reg-header h1 {
            font-family: 'Inter', sans-serif;
            font-size: 26px; font-weight: 800; color: #fff;
            margin-bottom: 6px; position: relative; z-index: 1;
        }
        .reg-header p { color: rgba(255,255,255,0.75); font-size: 14px; position: relative; z-index: 1; }

        .steps-bar {
            display: flex; align-items: center; justify-content: center;
            padding: 28px 44px 0; gap: 0;
        }
        .step-item {
            display: flex; flex-direction: column; align-items: center;
            gap: 8px; flex: 1; position: relative;
        }
        .step-item:not(:last-child)::after {
            content: ''; position: absolute; top: 18px; left: calc(50% + 22px);
            width: calc(100% - 44px); height: 2px;
            background: #E5E7EB; border-radius: 1px; transition: background 0.4s;
        }
        .step-item.completed:not(:last-child)::after { background: var(--primary); }
        .step-circle {
            width: 36px; height: 36px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 800; transition: all 0.4s;
            background: #F3F4F6; color: #9CA3AF;
            border: 2px solid #E5E7EB; z-index: 1;
        }
        .step-item.active .step-circle {
            background: var(--primary); color: #fff; border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-glow);
        }
        .step-item.completed .step-circle {
            background: var(--primary); color: #fff; border-color: var(--primary);
        }
        .step-label { font-size: 11px; font-weight: 600; color: #9CA3AF; transition: color 0.4s; white-space: nowrap; }
        .step-item.active .step-label, .step-item.completed .step-label { color: var(--primary); }

        .reg-body { padding: 28px 44px 40px; }
        .step-panel { display: none; animation: fadeSlide 0.35s cubic-bezier(0.16,1,0.3,1); }
        .step-panel.active { display: block; }
        @keyframes fadeSlide { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
        @keyframes fadeSlideBack { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }
        .step-panel.back { animation: fadeSlideBack 0.35s cubic-bezier(0.16,1,0.3,1); }

        .panel-title {
            font-family: 'Inter', sans-serif;
            font-size: 18px; font-weight: 700; color: var(--ink);
            margin-bottom: 4px;
        }
        .panel-sub { font-size: 13px; color: var(--ink-3); margin-bottom: 24px; }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
        .form-row.full { grid-template-columns: 1fr; }
        .form-row.three { grid-template-columns: 1fr 1fr 1fr; }
        .field { display: flex; flex-direction: column; gap: 6px; }
        .field label { font-size: 12px; font-weight: 700; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.5px; }
        .field label span.req { color: #EF4444; margin-left: 2px; }
        .field input, .field select, .field textarea {
            padding: 11px 14px; border-radius: 11px;
            border: 1.5px solid #E5E7EB;
            background: rgba(255,255,255,0.8);
            font-family: 'Inter', sans-serif;
            font-size: 14px; color: var(--ink);
            transition: all 0.2s; outline: none; width: 100%;
        }
        .field input:focus, .field select:focus, .field textarea:focus {
            border-color: var(--primary); background: #fff;
            box-shadow: 0 0 0 3px var(--primary-glow);
        }
        .field input.error { border-color: #EF4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.1); }
        .field input.success { border-color: var(--green); }
        .field-hint { font-size: 11px; color: var(--ink-3); margin-top: 2px; }
        .field-error { font-size: 11px; color: #EF4444; margin-top: 2px; display: none; }
        .field.has-error .field-error { display: block; }
        .field.has-error input, .field.has-error select { border-color: #EF4444; }

        .subdomain-wrap { position: relative; }
        .subdomain-wrap input { padding-right: 160px; }
        .subdomain-suffix {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            font-size: 12px; font-weight: 600; color: var(--ink-3);
            pointer-events: none;
        }
        .subdomain-indicator {
            display: flex; align-items: center; gap: 6px;
            font-size: 12px; font-weight: 600; margin-top: 4px;
            min-height: 18px;
        }
        .subdomain-indicator .dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .subdomain-indicator.checking { color: #6B7280; }
        .subdomain-indicator.available { color: var(--green); }
        .subdomain-indicator.unavailable { color: #EF4444; }
        .subdomain-indicator .dot.checking { background: #6B7280; animation: pulse 1.2s infinite; }
        .subdomain-indicator .dot.available { background: var(--green); }
        .subdomain-indicator .dot.unavailable { background: #EF4444; }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

        .pw-strength { margin-top: 6px; }
        .pw-strength-bar { height: 4px; border-radius: 2px; background: #E5E7EB; overflow: hidden; }
        .pw-strength-fill { height: 100%; border-radius: 2px; transition: width 0.3s, background 0.3s; width: 0; }
        .pw-strength-label { font-size: 11px; margin-top: 4px; font-weight: 600; }

        .plans-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 20px; }
        .plan-radio { display: none; }
        .plan-card {
            border: 2px solid #E5E7EB; border-radius: 16px; padding: 20px 16px;
            cursor: pointer; transition: all 0.3s; position: relative;
            background: rgba(255,255,255,0.7); user-select: none;
        }
        .plan-card:hover { border-color: var(--plan-accent, #C7D2FE); box-shadow: 0 4px 16px rgba(99,102,241,0.1); transform: translateY(-2px); }
        .plan-radio:checked + .plan-card {
            border-color: var(--plan-accent, var(--primary)); background: rgba(67,56,202,0.04);
            box-shadow: 0 0 0 4px var(--primary-glow), 0 4px 20px rgba(67,56,202,.12);
        }
        .plan-accent-bar {
            background-color: var(--plan-accent, var(--primary)) !important;
        }
        .plan-price {
            color: var(--plan-accent, var(--primary)) !important;
        }
        .plan-check {
            position: absolute; top: 12px; right: 12px; width: 22px; height: 22px;
            border-radius: 50%; border: 2px solid #E5E7EB; background: #F9FAFB;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.3s; font-size: 11px; color: transparent;
        }
        .plan-radio:checked + .plan-card .plan-check {
            background: var(--primary); border-color: var(--primary); color: #fff;
        }
        .plan-badge-popular {
            display: inline-block; background: linear-gradient(135deg, #F59E0B, #FCD34D);
            color: #78350F; font-size: 10px; font-weight: 800; padding: 2px 8px;
            border-radius: 100px; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px;
        }
        .plan-name { font-family: 'Space Grotesk',sans-serif; font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
        .plan-price-wrap { display: flex; align-items: baseline; gap: 2px; margin-bottom: 6px; }
        .plan-currency { font-size: 16px; font-weight: 700; color: var(--primary); }
        .plan-price { font-family: 'Space Grotesk',sans-serif; font-size: 28px; font-weight: 800; color: var(--ink); }
        .plan-period { font-size: 11px; color: var(--ink-3); font-weight: 500; }
        .plan-limit { font-size: 11px; color: var(--ink-3); margin-bottom: 12px; }
        .plan-features { list-style: none; padding: 0; margin: 0; }
        .plan-features li { font-size: 12px; color: var(--ink-2); padding: 3px 0; display: flex; align-items: center; gap: 6px; }
        .plan-features li i { color: var(--green); font-size: 10px; width: 14px; }
        .trial-badge {
            display: inline-block; background: rgba(5,150,105,0.1); color: var(--green);
            font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 100px;
            margin-bottom: 12px;
        }

        .nav-buttons {
            display: flex; align-items: center; justify-content: space-between;
            margin-top: 28px; padding-top: 24px;
            border-top: 1px solid #F1F5F9;
        }
        .btn-nav {
            padding: 13px 28px; border-radius: 12px; font-size: 14px; font-weight: 700;
            cursor: pointer; border: none; transition: all 0.25s; display: inline-flex; align-items: center; gap: 8px;
            font-family: 'Inter', sans-serif;
        }
        .btn-back { background: #F3F4F6; color: var(--ink-2); }
        .btn-back:hover { background: #E5E7EB; color: var(--ink); }
        .btn-next { background: var(--primary); color: #fff; box-shadow: 0 4px 16px rgba(67,56,202,.3); }
        .btn-next:hover { background: #3730A3; box-shadow: 0 8px 24px rgba(67,56,202,.4); transform: translateY(-1px); }
        .btn-submit { background: var(--green); color: #fff; box-shadow: 0 4px 16px rgba(5,150,105,.3); }
        .btn-submit:hover { background: #047857; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(5,150,105,.4); }
        .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

        .flash-error {
            background: #FFF1F2; border: 1px solid #FECDD3; border-left: 4px solid #DC2626;
            color: #9F1239; border-radius: 12px; padding: 14px 18px;
            font-size: 14px; font-weight: 600; margin-bottom: 20px;
            display: flex; align-items: center; gap: 10px;
            animation: slideDown 0.35s cubic-bezier(0.16,1,0.3,1);
        }
        @keyframes slideDown { from { opacity:0; transform:translateY(-10px); } to { opacity:1; transform:translateY(0); } }

        @media (max-width: 640px) {
            .reg-header { padding: 28px 24px; }
            .reg-body { padding: 20px 24px 32px; }
            .steps-bar { padding: 20px 24px 0; }
            .form-row { grid-template-columns: 1fr; }
            .form-row.three { grid-template-columns: 1fr; }
            .plans-grid { grid-template-columns: 1fr; }
            .register-container { margin: 20px 12px; border-radius: 20px; }
        }
        @media (max-width: 480px) {
            .reg-header h1 { font-size: 21px; }
            .step-label { display: none; }
        }
    </style>
</head>
<body>
    <div class="bg-gradient"></div>
    <div class="grid-pattern"></div>

    <nav>
        <a href="/" class="nav-logo">
            <div class="nav-logo-mark">S</div>
            <span class="nav-logo-text">SchoolSync</span>
        </a>
        <div class="nav-right">
            <a href="/login" class="btn-sm btn-ghost"><i class="fa-solid fa-sign-in-alt"></i> Sign In</a>
        </div>
    </nav>

    <div class="page-wrapper">
        <div class="register-container">
            <div class="reg-header">
                <h1>🏫 Register Your School</h1>
                <p>Join 500+ schools already using SchoolSync — free trial included.</p>
            </div>
            <div class="steps-bar" id="stepsBar">
                <div class="step-item active" data-step="1" id="stepItem1">
                    <div class="step-circle"><i class="fa-solid fa-school"></i></div>
                    <span class="step-label">School Info</span>
                </div>
                <div class="step-item" data-step="2" id="stepItem2">
                    <div class="step-circle"><i class="fa-solid fa-user"></i></div>
                    <span class="step-label">Contact & Auth</span>
                </div>
                <div class="step-item" data-step="3" id="stepItem3">
                    <div class="step-circle"><i class="fa-solid fa-crown"></i></div>
                    <span class="step-label">Choose Plan</span>
                </div>
            </div>

            <div class="reg-body">
                <% if (errors && errors.length > 0) { %>
                <div class="flash-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <%= errors[0] %>
                </div>
                <% } %>

                <form id="registerForm" action="<%= typeof currentPath !== 'undefined' ? currentPath : '/register' %>" method="POST" novalidate>

                    <div class="step-panel active" id="panel1">
                        <div class="panel-title">School Information</div>
                        <div class="panel-sub">Tell us about your school.</div>

                        <div class="form-row full">
                            <div class="field" id="field_school_name">
                                <label>School Name <span class="req">*</span></label>
                                <input type="text" name="school_name" id="school_name"
                                    placeholder="e.g. Sunshine Primary School"
                                    value="<%= old.school_name || '' %>" autocomplete="organization">
                                <span class="field-error">School name must be at least 3 characters.</span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="field" id="field_board">
                                <label>Board <span class="req">*</span></label>
                                <select name="board" id="board">
                                    <option value="">Select Board</option>
                                    <% ['GSEB','CBSE','ICSE','Other'].forEach(b => { %>
                                    <option value="<%= b %>" <%= (old.board === b) ? 'selected' : '' %>><%= b %></option>
                                    <% }); %>
                                </select>
                                <span class="field-error">Please select a board.</span>
                            </div>
                            <div class="field" id="field_city">
                                <label>City <span class="req">*</span></label>
                                <input type="text" name="city" id="city"
                                    placeholder="e.g. Ahmedabad"
                                    value="<%= old.city || '' %>">
                                <span class="field-error">City is required.</span>
                            </div>
                        </div>

                        <div class="form-row three">
                            <div class="field">
                                <label>State</label>
                                <select name="state" id="state">
                                    <option value="">Select State</option>
                                    <% ['Gujarat','Rajasthan','Maharashtra','Delhi','Karnataka','Tamil Nadu','Uttar Pradesh','West Bengal','Telangana','Kerala','Punjab','Haryana','Madhya Pradesh','Andhra Pradesh','Bihar','Other'].forEach(s => { %>
                                    <option value="<%= s %>" <%= (old.state === s) ? 'selected' : '' %>><%= s %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="field">
                                <label>Pincode</label>
                                <input type="text" name="pincode" id="pincode"
                                    placeholder="380001" maxlength="6"
                                    value="<%= old.pincode || '' %>">
                            </div>
                            <div class="field">
                                <label>School Type</label>
                                <select name="school_type">
                                    <option value="primary" <%= old.school_type === 'primary' ? 'selected':'' %>>Primary</option>
                                    <option value="secondary" <%= old.school_type === 'secondary' ? 'selected':'' %>>Secondary</option>
                                    <option value="higher_secondary" <%= old.school_type === 'higher_secondary' ? 'selected':'' %>>Higher Secondary</option>
                                    <option value="all" <%= !old.school_type || old.school_type === 'all' ? 'selected':'' %>>All (1–12)</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row full">
                            <div class="field">
                                <label>School Address</label>
                                <textarea name="address" rows="2" placeholder="Street, Area..."
                                    style="resize:vertical;"><%= old.address || '' %></textarea>
                            </div>
                        </div>

                        <div class="nav-buttons">
                            <div></div>
                            <button type="button" class="btn-nav btn-next" onclick="goToStep(2)">
                                Continue <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                    <div class="step-panel" id="panel2">
                        <div class="panel-title">Contact & Login Details</div>
                        <div class="panel-sub">These will be your admin credentials.</div>

                        <div class="form-row">
                            <div class="field" id="field_principal_name">
                                <label>Principal / Admin Name <span class="req">*</span></label>
                                <input type="text" name="principal_name" id="principal_name"
                                    placeholder="Full name"
                                    value="<%= old.principal_name || '' %>" autocomplete="name">
                                <span class="field-error">Principal name is required.</span>
                            </div>
                            <div class="field" id="field_phone">
                                <label>Mobile Number <span class="req">*</span></label>
                                <input type="tel" name="phone" id="phone"
                                    placeholder="9876543210" maxlength="10"
                                    value="<%= old.phone || '' %>" autocomplete="tel">
                                <span class="field-hint">10-digit Indian mobile number</span>
                                <span class="field-error">Enter a valid 10-digit mobile number.</span>
                            </div>
                        </div>

                        <div class="form-row full">
                            <div class="field" id="field_email">
                                <label>Email Address <span class="req">*</span></label>
                                <input type="email" name="email" id="email"
                                    placeholder="principal@yourschool.com"
                                    value="<%= old.email || '' %>" autocomplete="email">
                                <span class="field-hint">You'll receive login credentials here after approval.</span>
                                <span class="field-error">Enter a valid email address.</span>
                            </div>
                        </div>

                        <div class="form-row full">
                            <div class="field" id="field_subdomain">
                                <label>Subdomain / Portal URL <span class="req">*</span></label>
                                <div class="subdomain-wrap">
                                    <input type="text" name="subdomain" id="subdomain"
                                        placeholder="yourschool"
                                        value="<%= old.subdomain || '' %>"
                                        autocomplete="off" spellcheck="false">
                                    <span class="subdomain-suffix">.schoolsync.in</span>
                                </div>
                                <div class="subdomain-indicator" id="subdomainIndicator"></div>
                                <span class="field-error" id="subdomainFieldError">Please enter a valid subdomain.</span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="field" id="field_password">
                                <label>Password <span class="req">*</span></label>
                                <input type="password" name="password" id="password"
                                    placeholder="Min. 8 characters" autocomplete="new-password">
                                <div class="pw-strength" id="pwStrength" style="display:none;">
                                    <div class="pw-strength-bar"><div class="pw-strength-fill" id="pwFill"></div></div>
                                    <div class="pw-strength-label" id="pwLabel"></div>
                                </div>
                                <span class="field-error">Password must be at least 8 characters.</span>
                            </div>
                            <div class="field" id="field_confirm_password">
                                <label>Confirm Password <span class="req">*</span></label>
                                <input type="password" name="confirm_password" id="confirm_password"
                                    placeholder="Repeat password" autocomplete="new-password">
                                <span class="field-error">Passwords do not match.</span>
                            </div>
                        </div>

                        <div class="nav-buttons">
                            <button type="button" class="btn-nav btn-back" onclick="goToStep(1, true)">
                                <i class="fa-solid fa-arrow-left"></i> Back
                            </button>
                            <button type="button" class="btn-nav btn-next" onclick="goToStep(3)" id="step2Next">
                                Continue <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                    <div class="step-panel" id="panel3">
                        <div class="panel-title">Choose Your Plan</div>
                        <div class="panel-sub">All plans include a free trial. No credit card required.</div>

                        <div class="cycle-selector-container" style="text-align:center; margin-bottom: 24px;">
                            <span style="font-size:12px; font-weight:700; color:var(--ink-2); text-transform:uppercase; letter-spacing:0.5px; margin-right:12px;">Billing Cycle</span>
                            <div style="display:inline-flex; background:rgba(0,0,0,0.04); border-radius:10px; padding:3px; border: 1.5px solid var(--glass-border);">
                                <label style="padding:8px 16px; border-radius:8px; font-size:13px; font-weight:700; cursor:pointer; margin:0; <%= old.billing_cycle === 'yearly' ? 'color: var(--ink-2);' : 'background: var(--primary); color: #fff;' %>" class="cycle-option <%= old.billing_cycle === 'yearly' ? '' : 'active' %>" id="lbl-cycle-monthly">
                                    <input type="radio" name="billing_cycle" value="monthly" <%= old.billing_cycle === 'yearly' ? '' : 'checked' %> style="display:none;" onchange="toggleCycle('monthly')"> Monthly
                                </label>
                                <label style="padding:8px 16px; border-radius:8px; font-size:13px; font-weight:700; cursor:pointer; margin:0; margin-left:4px; <%= old.billing_cycle === 'yearly' ? 'background: var(--primary); color: #fff;' : 'color: var(--ink-2);' %>" class="cycle-option <%= old.billing_cycle === 'yearly' ? 'active' : '' %>" id="lbl-cycle-yearly">
                                    <input type="radio" name="billing_cycle" value="yearly" <%= old.billing_cycle === 'yearly' ? 'checked' : '' %> style="display:none;" onchange="toggleCycle('yearly')"> Yearly <span style="background:var(--green); color:#fff; font-size:9px; padding:2px 4px; border-radius:4px; margin-left:3px;">Save ~20%</span>
                                </label>
                            </div>
                        </div>

                        <div class="plans-grid" id="plansGrid">
                            <% plans.forEach((plan, idx) => {
                                const isPopular = plan.is_popular;
                                const colors = { basic: '#3B82F6', standard: '#F59E0B', premium: '#7C3AED' };
                                const accentColor = plan.color_code || colors[plan.plan_key] || '#3B82F6';
                                
                                let planFeats = [];
                                if (plan.features) {
                                    try {
                                        let parsed = typeof plan.features === 'string' ? JSON.parse(plan.features) : plan.features;
                                        planFeats = Object.entries(parsed)
                                            .filter(([k, v]) => v === true || v === 'true' || v === 'on')
                                            .map(([k]) => k.charAt(0).toUpperCase() + k.slice(1));
                                    } catch (e) {
                                        planFeats = [];
                                    }
                                }
                            %>
                            <input type="radio" name="plan_id" value="<%= plan.id %>" id="plan_<%= plan.id %>" class="plan-radio" <%= (old.plan_id == plan.id || (!old.plan_id && idx === 1)) ? 'checked' : '' %>>
                            <label for="plan_<%= plan.id %>" class="plan-card" data-accent="<%= accentColor %>">
                                <div class="plan-check"><i class="fa-solid fa-check"></i></div>
                                <% if (isPopular) { %><div class="plan-badge-popular">⭐ Most Popular</div><% } %>
                                <div class="plan-accent-bar" style="width:32px;height:4px;border-radius:2px;margin-bottom:12px;"></div>
                                <div class="plan-name"><%= plan.name %></div>
                                <div class="plan-price-wrap">
                                    <span class="plan-currency">₹</span>
                                    <span class="plan-price monthly-price-val"><%= Math.round(plan.monthly_price).toLocaleString('en-IN') %></span>
                                    <span class="plan-price yearly-price-val" style="display:none;"><%= Math.round(plan.yearly_price).toLocaleString('en-IN') %></span>
                                    <span class="plan-period period-text">/mo</span>
                                </div>
                                <div class="plan-limit">
                                    <% if (plan.max_students) { %>Up to <%= plan.max_students.toLocaleString() %> students<% } else { %>Unlimited students<% } %>
                                </div>
                                <div class="trial-badge">
                                    <i class="fa-regular fa-clock"></i> 7-day free trial
                                </div>
                                <ul class="plan-features">
                                    <li><i class="fa-solid fa-check"></i> Max Students: <%= plan.max_students ? plan.max_students : 'Unlimited' %></li>
                                    <li><i class="fa-solid fa-check"></i> Max Teachers: <%= plan.max_teachers ? plan.max_teachers : 'Unlimited' %></li>
                                    <% planFeats.forEach(f => { %>
                                        <li><i class="fa-solid fa-check"></i> <%= f %></li>
                                    <% }); %>
                                </ul>
                            </label>
                            <% }); %>
                        </div>
                        <div id="planSummary" style="background:rgba(67,56,202,0.04);border:1px solid rgba(67,56,202,0.15);border-radius:14px;padding:16px 20px;margin-bottom:16px;display:none;">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <div>
                                    <div style="font-size:12px;font-weight:700;color:var(--ink-3);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Selected Plan</div>
                                    <div style="font-size:16px;font-weight:800;color:var(--ink);" id="summaryName">—</div>
                                </div>
                                <div style="text-align:right;">
                                    <div style="font-size:12px;color:var(--ink-3);">Monthly</div>
                                    <div style="font-size:22px;font-weight:800;color:var(--primary);" id="summaryPrice">—</div>
                                </div>
                            </div>
                        </div>
                        <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:12px;padding:14px 18px;margin-bottom:16px;font-size:13px;color:#92400E;">
                            <i class="fa-solid fa-circle-info" style="margin-right:6px;"></i>
                            Your school will start on a <strong>free trial</strong>. Payment begins after approval and trial period ends.
                        </div>

                        <div class="nav-buttons">
                            <button type="button" class="btn-nav btn-back" onclick="goToStep(2, true)">
                                <i class="fa-solid fa-arrow-left"></i> Back
                            </button>
                            <button type="submit" class="btn-nav btn-submit" id="submitBtn">
                                <i class="fa-solid fa-paper-plane"></i> Submit Registration
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div id="errorHelper" data-errors="<%= (errors && errors.length > 0) ? errors[0] : '' %>"></div>
    <script>
    document.querySelectorAll('.plan-card').forEach(card => {
        const accent = card.getAttribute('data-accent');
        if (accent) {
            card.style.setProperty('--plan-accent', accent);
        }
    });

    let currentStep = 1;
    const subdomainAvailable = { value: false };

    function goToStep(step, isBack = false) {
        if (!isBack && !validateStep(currentStep)) return;

        document.getElementById('panel' + currentStep).classList.remove('active');
        document.getElementById('stepItem' + currentStep).classList.remove('active');

        if (currentStep < step) {
            document.getElementById('stepItem' + currentStep).classList.add('completed');
        } else {
            document.getElementById('stepItem' + currentStep).classList.remove('completed');
        }

        currentStep = step;
        const panel = document.getElementById('panel' + step);
        panel.classList.add('active');
        if (isBack) panel.classList.add('back');
        else panel.classList.remove('back');

        document.getElementById('stepItem' + step).classList.add('active');
        document.querySelector('.register-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function validateStep(step) {
        if (step === 1) {
            const name = document.getElementById('school_name').value.trim();
            const board = document.getElementById('board').value;
            const city = document.getElementById('city').value.trim();
            let ok = true;
            if (name.length < 3) { setFieldError('field_school_name', true); ok = false; }
            else setFieldError('field_school_name', false);
            if (!board) { setFieldError('field_board', true); ok = false; }
            else setFieldError('field_board', false);
            if (!city) { setFieldError('field_city', true); ok = false; }
            else setFieldError('field_city', false);
            return ok;
        }
        if (step === 2) {
            const principal = document.getElementById('principal_name').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const email = document.getElementById('email').value.trim();
            const subdomain = document.getElementById('subdomain').value.trim();
            const pw = document.getElementById('password').value;
            const cpw = document.getElementById('confirm_password').value;
            let ok = true;
            if (principal.length < 2) { setFieldError('field_principal_name', true); ok = false; }
            else setFieldError('field_principal_name', false);
            if (!/^[6-9]\d{9}$/.test(phone)) { setFieldError('field_phone', true); ok = false; }
            else setFieldError('field_phone', false);
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setFieldError('field_email', true); ok = false; }
            else setFieldError('field_email', false);
            if (!subdomain || subdomain.length < 3 || !subdomainAvailable.value) {
                setFieldError('field_subdomain', true);
                document.getElementById('subdomainFieldError').style.display = 'block';
                document.getElementById('subdomainFieldError').textContent = !subdomainAvailable.value && subdomain.length >= 3
                    ? 'Please choose an available subdomain.' : 'Subdomain must be at least 3 characters.';
                ok = false;
            } else {
                setFieldError('field_subdomain', false);
                document.getElementById('subdomainFieldError').style.display = 'none';
            }
            if (pw.length < 8) { setFieldError('field_password', true); ok = false; }
            else setFieldError('field_password', false);
            if (pw !== cpw) { setFieldError('field_confirm_password', true); ok = false; }
            else setFieldError('field_confirm_password', false);
            return ok;
        }
        if (step === 3) {
            const plan = document.querySelector('input[name="plan_id"]:checked');
            if (!plan) { alert('Please select a plan to continue.'); return false; }
            return true;
        }
        return true;
    }

    function setFieldError(fieldId, hasError) {
        const el = document.getElementById(fieldId);
        if (!el) return;
        if (hasError) el.classList.add('has-error');
        else el.classList.remove('has-error');
    }

    let subdomainTimer;
    document.getElementById('subdomain').addEventListener('input', function() {
        const raw = this.value.toLowerCase().replace(/[^a-z0-9-]/g, '');
        this.value = raw;
        subdomainAvailable.value = false;
        clearTimeout(subdomainTimer);
        const indicator = document.getElementById('subdomainIndicator');
        if (raw.length < 3) { indicator.innerHTML = ''; return; }
        indicator.innerHTML = '<div class="dot checking"></div><span>Checking availability…</span>';
        indicator.className = 'subdomain-indicator checking';
        subdomainTimer = setTimeout(async () => {
            try {
                const basePath = '/register';
                const res = await fetch(basePath + '/check-subdomain?subdomain=' + encodeURIComponent(raw));
                const data = await res.json();
                subdomainAvailable.value = data.available;
                indicator.className = 'subdomain-indicator ' + (data.available ? 'available' : 'unavailable');
                indicator.innerHTML = `<div class="dot ${data.available ? 'available' : 'unavailable'}"></div><span>${data.message}</span>`;
            } catch {
                indicator.innerHTML = '';
                subdomainAvailable.value = false;
            }
        }, 550);
    });

    if (document.getElementById('subdomain').value) {
        document.getElementById('subdomain').dispatchEvent(new Event('input'));
    }

    document.getElementById('password').addEventListener('input', function() {
        const pw = this.value;
        const wrap = document.getElementById('pwStrength');
        const fill = document.getElementById('pwFill');
        const label = document.getElementById('pwLabel');
        if (!pw) { wrap.style.display = 'none'; return; }
        wrap.style.display = 'block';
        let score = 0;
        if (pw.length >= 8) score++;
        if (/[A-Z]/.test(pw)) score++;
        if (/[0-9]/.test(pw)) score++;
        if (/[^A-Za-z0-9]/.test(pw)) score++;
        const levels = [
            { label: 'Very Weak', color: '#EF4444', width: '20%' },
            { label: 'Weak', color: '#F97316', width: '40%' },
            { label: 'Fair', color: '#F59E0B', width: '60%' },
            { label: 'Strong', color: '#22C55E', width: '80%' },
            { label: 'Very Strong', color: '#059669', width: '100%' }
        ];
        const lvl = levels[score] || levels[0];
        fill.style.width = lvl.width;
        fill.style.background = lvl.color;
        label.textContent = lvl.label;
        label.style.color = lvl.color;
    });

    function getSelectedCycle() {
        return document.querySelector('input[name="billing_cycle"]:checked')?.value || 'monthly';
    }

    function toggleCycle(cycle) {
        const selectedCycle = cycle === 'yearly' ? 'yearly' : 'monthly';
        document.querySelectorAll('.cycle-option').forEach(label => {
            label.classList.remove('active');
            label.style.background = 'transparent';
            label.style.color = 'var(--ink-2)';
        });
        const activeLabel = document.getElementById('lbl-cycle-' + selectedCycle);
        if (activeLabel) {
            activeLabel.classList.add('active');
            activeLabel.style.background = 'var(--primary)';
            activeLabel.style.color = '#fff';
        }
        document.querySelectorAll('.monthly-price-val').forEach(el => {
            el.style.display = selectedCycle === 'monthly' ? 'inline' : 'none';
        });
        document.querySelectorAll('.yearly-price-val').forEach(el => {
            el.style.display = selectedCycle === 'yearly' ? 'inline' : 'none';
        });
        document.querySelectorAll('.period-text').forEach(el => {
            el.textContent = selectedCycle === 'yearly' ? '/yr' : '/mo';
        });
        updatePlanSummary();
    }

    function updatePlanSummary() {
        const checked = document.querySelector('input[name="plan_id"]:checked');
        const summary = document.getElementById('planSummary');
        if (!checked) { summary.style.display = 'none'; return; }
        const card = checked.nextElementSibling;
        const name = card.querySelector('.plan-name').textContent;
        const selectedCycle = getSelectedCycle();
        const priceEl = card.querySelector(selectedCycle === 'yearly' ? '.yearly-price-val' : '.monthly-price-val');
        const price = priceEl ? priceEl.textContent : '0';
        document.getElementById('summaryName').textContent = name;
        document.getElementById('summaryPrice').textContent = '₹' + parseInt(price.replace(/,/g,'')).toLocaleString('en-IN') + (selectedCycle === 'yearly' ? '/yr' : '/mo');
        summary.style.display = 'block';
    }
    document.querySelectorAll('input[name="plan_id"]').forEach(r => r.addEventListener('change', updatePlanSummary));
    toggleCycle(getSelectedCycle());
    updatePlanSummary();

    document.getElementById('registerForm').addEventListener('submit', function(e) {
        if (!validateStep(3)) { e.preventDefault(); return; }
        document.getElementById('submitBtn').disabled = true;
        document.getElementById('submitBtn').innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting…';
    });

    const errorHelper = document.getElementById('errorHelper');
    const errText = errorHelper ? errorHelper.getAttribute('data-errors') : '';
    if (errText) {
        const errMsg = errText.toLowerCase();
        if (errMsg.includes('email') || errMsg.includes('phone') || errMsg.includes('subdomain') || errMsg.includes('password')) {
            goToStep(2);
        } else if (errMsg.includes('plan')) {
            goToStep(3);
        }
    }
    </script>
</body>
</html>
