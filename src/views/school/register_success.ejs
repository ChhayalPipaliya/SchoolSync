<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏫</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #4338CA;
            --green: #059669;
            --ink: #0F0F1A;
            --ink-2: #3D3D52;
            --ink-3: #8585A0;
            --paper: #FAFAF7;
            --primary-glow: rgba(99,102,241,0.12);
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--paper); color: var(--ink);
            min-height: 100vh;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            padding: 40px 20px;
            position: relative; overflow: hidden;
        }
        .bg-glow {
            position: fixed; inset: 0; pointer-events: none;
            background:
                radial-gradient(ellipse 60% 50% at 50% 0%, rgba(5,150,105,0.12) 0%, transparent 60%),
                radial-gradient(ellipse 40% 40% at 80% 80%, rgba(67,56,202,0.08) 0%, transparent 60%);
        }
        #confetti { position: fixed; inset: 0; pointer-events: none; z-index: 0; }

        .card {
            background: rgba(255,255,255,0.9); backdrop-filter: blur(30px);
            border: 1.5px solid rgba(255,255,255,0.5);
            border-radius: 28px; padding: 56px 52px;
            max-width: 540px; width: 100%;
            box-shadow: 0 24px 64px rgba(14,14,26,0.10);
            text-align: center;
            position: relative; z-index: 1;
            animation: cardIn 0.7s cubic-bezier(0.16,1,0.3,1);
        }
        @keyframes cardIn { from { opacity:0; transform: translateY(32px) scale(0.96); } to { opacity:1; transform:none; } }

        .success-icon {
            width: 88px; height: 88px;
            background: linear-gradient(135deg, #ECFDF5, #D1FAE5);
            border-radius: 50%; margin: 0 auto 28px;
            display: flex; align-items: center; justify-content: center;
            font-size: 40px; color: var(--green);
            border: 3px solid rgba(5,150,105,0.15);
            animation: iconBounce 0.8s 0.3s cubic-bezier(0.16,1,0.3,1) both;
            box-shadow: 0 0 0 12px rgba(5,150,105,0.06);
        }
        @keyframes iconBounce { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }

        h1 {
            font-family: 'Inter', sans-serif;
            font-size: 28px; font-weight: 800; color: var(--ink);
            margin-bottom: 12px; letter-spacing: -0.5px;
        }
        .subtitle { font-size: 15px; color: var(--ink-2); line-height: 1.65; margin-bottom: 32px; }

        .info-box {
            background: rgba(67,56,202,0.05);
            border: 1px solid rgba(67,56,202,0.15);
            border-radius: 14px; padding: 20px 24px;
            text-align: left; margin-bottom: 28px;
        }
        .info-box h3 { font-size: 13px; font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 14px; }
        .info-step {
            display: flex; align-items: flex-start; gap: 14px; margin-bottom: 14px;
        }
        .info-step:last-child { margin-bottom: 0; }
        .info-step-num {
            width: 28px; height: 28px; background: var(--primary); color: #fff;
            border-radius: 50%; font-size: 12px; font-weight: 800;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
            margin-top: 1px;
        }
        .info-step-text { font-size: 14px; color: var(--ink-2); line-height: 1.5; }
        .info-step-text strong { color: var(--ink); }

        .email-badge {
            background: rgba(5,150,105,0.08); border: 1px solid rgba(5,150,105,0.2);
            border-radius: 100px; padding: 8px 18px;
            font-size: 13px; font-weight: 700; color: var(--green);
            display: inline-flex; align-items: center; gap: 8px;
            margin-bottom: 28px;
        }

        .actions { display: flex; flex-direction: column; gap: 12px; }
        .btn-home {
            display: block; padding: 14px 28px; border-radius: 12px;
            background: var(--primary); color: #fff; text-decoration: none;
            font-weight: 700; font-size: 15px;
            box-shadow: 0 4px 16px rgba(67,56,202,0.3);
            transition: all .2s; text-align: center;
        }
        .btn-home:hover { background: #3730A3; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(67,56,202,0.4); }
        .btn-login {
            display: block; padding: 14px 28px; border-radius: 12px;
            background: #F3F4F6; color: var(--ink-2); text-decoration: none;
            font-weight: 600; font-size: 14px; transition: all .2s; text-align: center;
        }
        .btn-login:hover { background: #E5E7EB; color: var(--ink); }

        .timer {
            margin-top: 20px; font-size: 13px; color: var(--ink-3);
        }
        .timer span { font-weight: 700; color: var(--primary); }
        @media (max-width: 480px) {
            .card { padding: 32px 24px; border-radius: 20px; }
            h1 { font-size: 22px; }
            .subtitle { font-size: 13.5px; margin-bottom: 24px; }
            .info-box { padding: 16px; }
        }
    </style>
</head>
<body>
    <div class="bg-glow"></div>
    <canvas id="confetti"></canvas>

    <div class="card">
        <div class="success-icon">🎉</div>
        <h1>Registration Submitted!</h1>
        <p class="subtitle">
            Your school registration has been received successfully. Our team will review your application within <strong>24–48 hours</strong>.
        </p>

        <div class="email-badge">
            <i class="fa-solid fa-envelope-circle-check"></i>
            Confirmation email sent to your inbox
        </div>

        <div class="info-box">
            <h3>What Happens Next?</h3>
            <div class="info-step">
                <div class="info-step-num">1</div>
                <div class="info-step-text"><strong>Review (24–48h):</strong> Our team verifies your application details.</div>
            </div>
            <div class="info-step">
                <div class="info-step-num">2</div>
                <div class="info-step-text"><strong>Approval Email:</strong> You receive login credentials and your portal URL.</div>
            </div>
            <div class="info-step">
                <div class="info-step-num">3</div>
                <div class="info-step-text"><strong>Free Trial Begins:</strong> Start managing your school — no payment needed during the trial.</div>
            </div>
        </div>

        <div class="actions">
            <a href="/" class="btn-home">
                <i class="fa-solid fa-house"></i> Back to Home
            </a>
            <a href="/login" class="btn-login">
                <i class="fa-solid fa-sign-in-alt"></i> Go to Login
            </a>
        </div>

        <div class="timer" id="timer">
            Redirecting to home in <span id="countdown">15</span>s
        </div>
    </div>

    <script>
    const canvas = document.getElementById('confetti');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    window.addEventListener('resize', () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; });

    const pieces = Array.from({ length: 90 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height - canvas.height,
        r: Math.random() * 7 + 4,
        d: Math.random() + 1,
        color: ['#4338CA','#6366F1','#F59E0B','#059669','#EC4899','#F97316'][Math.floor(Math.random()*6)],
        tilt: Math.random() * 10 - 10,
        tiltAngle: 0,
        tiltAngleIncrement: Math.random() * 0.07 + 0.05,
    }));

    let confettiActive = true;
    function drawConfetti() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach(p => {
            p.tiltAngle += p.tiltAngleIncrement;
            p.y += (Math.cos(p.d) + 3 + p.r / 2) / 2;
            p.tilt = Math.sin(p.tiltAngle) * 15;
            ctx.beginPath();
            ctx.lineWidth = p.r / 2;
            ctx.strokeStyle = p.color;
            ctx.moveTo(p.x + p.tilt + p.r / 4, p.y);
            ctx.lineTo(p.x + p.tilt, p.y + p.tilt + p.r / 4);
            ctx.stroke();
            if (p.y > canvas.height) {
                p.x = Math.random() * canvas.width;
                p.y = -10;
            }
        });
        if (confettiActive) requestAnimationFrame(drawConfetti);
    }
    drawConfetti();
    setTimeout(() => { confettiActive = false; ctx.clearRect(0, 0, canvas.width, canvas.height); }, 5000);

    let count = 15;
    const el = document.getElementById('countdown');
    const interval = setInterval(() => {
        count--;
        el.textContent = count;
        if (count <= 0) { clearInterval(interval); window.location.href = '/'; }
    }, 1000);
    </script>
</body>
</html>
