<div class="loader" id="loader">
    <div class="loader-logo">S</div>
    <div class="loader-bar">
        <div class="loader-bar-inner"></div>
    </div>
</div>

<style>
    .loader {
        position: fixed;
        inset: 0;
        background: #ffffff;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 20px;
        transition: opacity 0.5s ease, visibility 0.5s ease;
    }

    .theme-dark-disabled .loader {
        background: #0E0E1A;
    }

    .loader.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .loader-logo {
        width: 60px;
        height: 60px;
        background: #4338CA;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-weight: 800;
        font-size: 28px;
        font-family: 'Inter', sans-serif;
        animation: loaderPulse 1.5s ease infinite;
    }

    @keyframes loaderPulse {
        0%, 100% { 
            transform: scale(1); 
            box-shadow: 0 0 0 0 rgba(67, 56, 202, 0.4); 
        }
        50% { 
            transform: scale(1.05); 
            box-shadow: 0 0 0 20px rgba(67, 56, 202, 0); 
        }
    }

    .loader-bar {
        width: 200px;
        height: 4px;
        background: #f1f5f9;
        border-radius: 2px;
        overflow: hidden;
    }

    .loader-bar-inner {
        height: 100%;
        background: #4338CA;
        border-radius: 2px;
        animation: loaderProgress 1.5s ease forwards;
    }

    @keyframes loaderProgress {
        from { width: 0%; }
        to { width: 100%; }
    }
</style>

<script>
    window.addEventListener('load', () => {
        const loader = document.getElementById('loader');
        if (loader) {
            setTimeout(() => {
                loader.classList.add('hidden');
                setTimeout(() => {
                    loader.remove();
                }, 500);
            }, 800);
        }
    });
</script>
