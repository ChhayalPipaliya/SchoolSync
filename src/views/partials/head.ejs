<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="ie=edge">
<script>
    (function () {
        try {
            var cookieMatch = document.cookie.match(/(?:^|;\s*)theme=([^;]*)/);
            var cookieTheme = cookieMatch ? cookieMatch[1] : null;
            var localTheme = localStorage.getItem('schoolSyncTheme');
            var serverTheme = '<%= typeof theme !== "undefined" && theme ? theme : "" %>';
            var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;

            var activeTheme = cookieTheme || localTheme || serverTheme || (systemDark ? 'dark' : 'light');
            if (activeTheme !== 'dark' && activeTheme !== 'light') {
                activeTheme = systemDark ? 'dark' : 'light';
            }

            if (localTheme !== activeTheme) {
                try { localStorage.setItem('schoolSyncTheme', activeTheme); } catch(e){}
            }

            document.documentElement.setAttribute('data-theme', activeTheme);
            document.documentElement.style.colorScheme = activeTheme;
            document.documentElement.setAttribute('lang', '<%= typeof currentLanguage !== "undefined" ? currentLanguage : "en" %>');

            var isDark = activeTheme === 'dark';
            document.documentElement.classList.toggle('dark', isDark);
            document.documentElement.classList.toggle('light-mode-disabled', isDark);
        } catch (e) { }
    })();
</script>
<script src="/js/theme.js"></script>
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
