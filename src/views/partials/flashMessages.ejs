<% 
  // Flash messages configuration
  const flashMessages = [
    { key: 'success', type: 'success', icon: 'fa-check-circle' },
    { key: 'error',   type: 'danger',  icon: 'fa-exclamation-circle' },
    { key: 'info',    type: 'info',    icon: 'fa-info-circle' },
    { key: 'warning', type: 'warning', icon: 'fa-exclamation-triangle' }
  ];
%>

<% flashMessages.forEach(({ key, type, icon }) => {
     let msgs = [];
     if (typeof locals[key] !== 'undefined' && locals[key]) {
       msgs = Array.isArray(locals[key]) ? locals[key] : [locals[key]];
     }
     if (msgs.length === 0 && typeof locals.messages !== 'undefined' && locals.messages && locals.messages[key]) {
       msgs = Array.isArray(locals.messages[key]) ? locals.messages[key] : [locals.messages[key]];
     }
     if (msgs.length === 0 && typeof messages !== 'undefined' && messages && messages[key]) {
       msgs = Array.isArray(messages[key]) ? messages[key] : [messages[key]];
     }
     
     // Filter out non-strings or empty values
     msgs = msgs.filter(m => m && typeof m === 'string' && m.trim().length > 0);
%>
  <% msgs.forEach((msgText) => { %>
    <div class="toast-flash toast-<%= type %>" role="alert" data-toast-flash>
      <div class="toast-content">
        <i class="fas <%= icon %> toast-icon"></i>
        <span class="toast-message"><%= msgText %></span>
      </div>
      <button type="button" class="toast-close" aria-label="Close" data-toast-close>
        <i class="fas fa-times"></i>
      </button>
      
      <div class="toast-progress" data-toast-progress></div>
    </div>
  <% }) %>
<% }); %>

<style>
  .toast-flash {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    min-width: min(360px, calc(100vw - 32px));
    max-width: min(480px, calc(100vw - 32px));
    padding: 16px 20px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    box-shadow: 0 8px 32px rgba(14, 14, 26, 0.12);
    border: 1px solid transparent;
    animation: toastSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  .toast-success {
    background: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
    border-left: 4px solid #059669;
  }
  .toast-danger {
    background: #FFF1F2;
    color: #9F1239;
    border: 1px solid #FECDD3;
    border-left: 4px solid #DC2626;
  }
  .toast-info {
    background: rgba(2, 132, 199, 0.08);
    color: #0284C7;
    border: 1px solid rgba(2, 132, 199, 0.2);
    border-left: 4px solid #0284C7;
  }
  .toast-warning {
    background: rgba(245, 158, 11, 0.10);
    color: #92400E;
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-left: 4px solid #F59E0B;
  }

  .toast-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }
  .toast-icon {
    font-size: 20px;
    flex-shrink: 0;
  }
  .toast-message {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    word-break: break-word;
    font-family: 'Inter', sans-serif;
  }

  .toast-close {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
    flex-shrink: 0;
    opacity: 0.7;
  }
  .toast-close:hover {
    background: rgba(0, 0, 0, 0.08);
    opacity: 1;
    transform: scale(1.1);
  }
  .toast-close:active {
    transform: scale(0.95);
  }

  .toast-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    background: currentColor;
    opacity: 0.35;
    border-radius: 0 0 0 12px;
    width: 100%;
    transform-origin: left;
  }

  @keyframes toastSlideIn {
    from {
      transform: translateX(120%) scale(0.9);
      opacity: 0;
    }
    to {
      transform: translateX(0) scale(1);
      opacity: 1;
    }
  }

  @keyframes toastSlideOut {
    from {
      transform: translateX(0) scale(1);
      opacity: 1;
    }
    to {
      transform: translateX(120%) scale(0.9);
      opacity: 0;
    }
  }
  .toast-flash.toast-hiding {
    animation: toastSlideOut 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (max-width: 480px) {
    .toast-flash {
      top: 10px;
      right: 10px;
      left: 10px;
      min-width: auto;
      max-width: none;
    }
  }

  .toast-flash:nth-child(2) { top: 100px; }
  .toast-flash:nth-child(3) { top: 180px; }
  .toast-flash:nth-child(4) { top: 260px; }
</style>

<script>
  (function() {
    'use strict';

    const AUTO_DISMISS_TIME = 5000;

    function initToastAlerts() {
      document.querySelectorAll('[data-toast-flash]').forEach(toast => {
        const progressBar = toast.querySelector('[data-toast-progress]');
        const closeBtn = toast.querySelector('[data-toast-close]');
        let remainingTime = AUTO_DISMISS_TIME;
        let isPaused = false;
        let animationId = null;
        let lastTime = Date.now();

        function startProgress() {
          function update() {
            const now = Date.now();
            const delta = now - lastTime;
            lastTime = now;

            if (isPaused) {
              animationId = requestAnimationFrame(update);
              return;
            }
            
            remainingTime -= delta;
            const progress = Math.max(0, remainingTime / AUTO_DISMISS_TIME);
            
            if (progressBar) {
              progressBar.style.transform = `scaleX(${progress})`;
            }
            
            if (remainingTime > 0) {
              animationId = requestAnimationFrame(update);
            } else {
              dismissToast(toast);
            }
          }
          
          animationId = requestAnimationFrame(update);
        }

        function dismissToast(element) {
          if (animationId) cancelAnimationFrame(animationId);
          element.classList.add('toast-hiding');
          element.addEventListener('animationend', () => element.remove(), { once: true });
        }

        if (closeBtn) {
          closeBtn.addEventListener('click', () => dismissToast(toast));
        }

        toast.addEventListener('mouseenter', () => { isPaused = true; });
        toast.addEventListener('mouseleave', () => { 
          isPaused = false; 
          lastTime = Date.now();
        });

        startProgress();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initToastAlerts);
    } else {
      initToastAlerts();
    }
  })();
</script>