<%
  const _src = typeof illustrationSrc !== 'undefined' ? illustrationSrc : '';
  const _alt = typeof illustrationAlt !== 'undefined' ? illustrationAlt : 'Dashboard Illustration';
%>
<% if (_src) { %>
    <div class="hero-illustration" aria-hidden="true">
        <img src="<%= _src %>" alt="<%= _alt %>" class="hero-illustration-img" loading="eager" draggable="false">
    </div>
<% } %> 