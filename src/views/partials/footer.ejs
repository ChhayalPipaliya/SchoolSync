    </div>
    <div class="app-footer-links">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      <a href="/support"><%- (typeof lan !== 'undefined' && lan.Support) ? lan.Support : 'Support' %></a>
