    </div>
  </footer>
  <script src="/js/modal.js"></script>
  <script src="/js/utils.js"></script>
  <script src="/js/validation.js"></script>

  <% 
    const roleJs = { 
      'super_admin': 'superadmin.js',
      'school_admin': 'schooladmin.js',
      'teacher': 'teacher.js',
      'student': 'student.js',
      'driver': 'driver.js',
      'librarian': 'librarian.js'
    };
    const pathJs = {
      '/superadmin': 'superadmin.js',
      '/schooladmin': 'schooladmin.js',
      '/student': 'student.js',
      '/teacher': 'teacher.js',
      '/driver': 'driver.js',
      '/librarian': 'librarian.js'
    };
    let resolvedRoleJs = '';
    if (typeof jsFile !== 'undefined' && jsFile) {
      resolvedRoleJs = jsFile;
    } else if (typeof user !== 'undefined' && user && user.role && roleJs[user.role]) {
      resolvedRoleJs = roleJs[user.role];
    } else if (typeof currentPath !== 'undefined' && currentPath) {
      const matchedPrefix = Object.keys(pathJs).find(prefix => currentPath.toLowerCase().startsWith(prefix));
      resolvedRoleJs = matchedPrefix ? pathJs[matchedPrefix] : '';
    }
  %>
  <% if (resolvedRoleJs) { %>
    <script src="/js/<%= resolvedRoleJs %>"></script>
  <% } %>
  
  <% if (typeof pageJs !== 'undefined' && pageJs) { %>
    <script src="/js/<%= pageJs %>"></script>
  <% } %>
  
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const alerts = document.querySelectorAll('.alert-dismissible');
    alerts.forEach(function(alert) {
      setTimeout(function() {
        alert.style.opacity = '0';
        setTimeout(function() {
          alert.remove();
        }, 300);
      }, 5000);
    });
  
    const sidebarToggle = document.getElementById('sidebarToggleBtn');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
  
    if (sidebarToggle && sidebar) {
      sidebarToggle.setAttribute('aria-expanded', 'false');
      if (!sidebarToggle.getAttribute('onclick')) {
        sidebarToggle.onclick = function(e) {
          if (typeof window.toggleAppSidebar === 'function') {
            window.toggleAppSidebar(e);
          }
        };
      }
  
      if (localStorage.getItem('sidebarCollapsed') === 'true' && window.innerWidth > 1024) {
        sidebar.classList.add('collapsed');
        sidebarToggle.setAttribute('aria-expanded', 'true');
      }
    }

    window.closeSidebar = function() {
      if (sidebar) sidebar.classList.remove('open');
      if (overlay) overlay.classList.remove('active');
      document.body.classList.remove('sidebar-open');
      if (sidebarToggle && !sidebar?.classList.contains('collapsed')) {
        sidebarToggle.setAttribute('aria-expanded', 'false');
      }
    };

    if (sidebar) {
      sidebar.querySelectorAll('a[href]').forEach(function(link) {
        link.addEventListener('click', function(event) {
          if (window.innerWidth <= 1024 && !event.target.closest('.dropdown-arrow-icon')) {
            window.closeSidebar();
          }
        });
      });
    }

  (function initGlobalLiveSearch() {
    var DEBOUNCE_MS = 400;
    var selector = 'form[method="GET"] input[name="search"], form[method="get"] input[name="search"], form[method="GET"] input[name="q"], form[method="get"] input[name="q"], form.header-search input';
    document.querySelectorAll(selector).forEach(function(input) {
      var form   = input.closest('form');
      if (!form) return;
      var timer  = null;
      var lastVal = input.value;

      function doSubmit() {
        if (input.value !== lastVal) {
          lastVal = input.value;
          form.submit();
        }
      }

      input.addEventListener('input', function() {
        clearTimeout(timer);
        timer = setTimeout(doSubmit, DEBOUNCE_MS);
      });

      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          clearTimeout(timer);
          lastVal = input.value;
          form.submit();
        }
        if (e.key === 'Escape') {
          clearTimeout(timer);
          if (input.value !== '') {
            input.value = '';
            lastVal = '';
            form.submit();
          }
        }
      });
    });
  })();

  document.querySelectorAll('table').forEach(function(table) {
      if (table.closest('.table-responsive, .table-container, .table-wrap, .table-scroll-container, .responsive-table-shell')) return;
      const shell = document.createElement('div');
      shell.className = 'responsive-table-shell';
      table.parentNode.insertBefore(shell, table);
      shell.appendChild(table);
    });
  
    const userDropdown = document.getElementById('userDropdown');
    if (userDropdown) {
      const toggle = userDropdown.querySelector('.header-user-toggle');
      const closeUserMenu = function() {
        userDropdown.classList.remove('open');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      };
      const toggleUserMenu = function() {
        const nextOpen = !userDropdown.classList.contains('open');
        userDropdown.classList.toggle('open', nextOpen);
        if (toggle) toggle.setAttribute('aria-expanded', String(nextOpen));
      };
      if (toggle) {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          toggleUserMenu();
        });
        toggle.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            e.stopPropagation();
            toggleUserMenu();
          }
        });
      }
      document.addEventListener('click', function() {
        closeUserMenu();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeUserMenu();
          window.closeSidebar();
        }
      });
    }

    window.addEventListener('resize', function() {
      if (window.innerWidth > 1024) {
        if (overlay) overlay.classList.remove('active');
        if (sidebar) sidebar.classList.remove('open');
        document.body.classList.remove('sidebar-open');
      }
    });
  });
  </script>
  
  <% if (typeof user !== 'undefined' && user) { %>
    <script>
      window.currentUser = {
        id: Number('<%= user.id %>'),
        role: '<%= user.role %>'
      };
    </script>
    <%- include('notification-toast') %>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/notifications.js"></script>
  <% } %>
