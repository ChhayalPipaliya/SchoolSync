<% 
  const defaults = {
    icon: 'fa-inbox',
    title: 'No data found',
    message: 'There are no items to display at the moment.',
    actionText: '',
    actionHref: '',
    actionIcon: 'fa-plus'
  };

  const config = {
    icon: typeof icon !== 'undefined' ? icon : (typeof emptyConfig !== 'undefined' && emptyConfig && emptyConfig.icon ? emptyConfig.icon : defaults.icon),
    title: typeof title !== 'undefined' ? title : (typeof emptyConfig !== 'undefined' && emptyConfig && emptyConfig.title ? emptyConfig.title : defaults.title),
    message: typeof message !== 'undefined' ? message : (typeof emptyConfig !== 'undefined' && emptyConfig && emptyConfig.message ? emptyConfig.message : defaults.message),
    actionText: typeof actionText !== 'undefined' ? actionText : (typeof emptyConfig !== 'undefined' && emptyConfig && emptyConfig.actionText ? emptyConfig.actionText : defaults.actionText),
    actionHref: typeof actionHref !== 'undefined' ? actionHref : (typeof emptyConfig !== 'undefined' && emptyConfig && emptyConfig.actionHref ? emptyConfig.actionHref : defaults.actionHref),
    actionIcon: typeof actionIcon !== 'undefined' ? actionIcon : (typeof emptyConfig !== 'undefined' && emptyConfig && emptyConfig.actionIcon ? emptyConfig.actionIcon : defaults.actionIcon)
  };
%>

<div class="empty-state">
  <div class="empty-state-icon">
    <i class="fas <%= config.icon %>"></i>
  </div>
  <h3 class="empty-state-title"><%= config.title %></h3>
  <p class="empty-state-message"><%= config.message %></p>

  <% if (config.actionText && config.actionHref) { %>
    <a href="<%= config.actionHref %>" class="btn btn-primary empty-state-action">
      <i class="fas <%= config.actionIcon %>"></i>
      <%= config.actionText %>
    </a>
  <% } %>
</div>
