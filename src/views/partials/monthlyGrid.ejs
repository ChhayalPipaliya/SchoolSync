<div class="monthly-grid-container">
  <table class="monthly-grid-table">
    <thead>
      <tr>
        <th class="sticky-col"><%= typeof nameLabel !== 'undefined' ? nameLabel : 'Name' %></th>
        <% (days || []).forEach(d => { %>
          <th class="<%= d.isHoliday ? 'holiday' : '' %> <%= d.date === new Date().toISOString().slice(0,10) ? 'today' : '' %>">
            <div><%= d.day %></div>
            <div style="font-size: 8px; opacity: 0.7; font-weight: 500;"><%= d.dayName %></div>
          </th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% if (!people || people.length === 0) { %>
        <tr>
          <td colspan="<%= (days || []).length + 1 %>" class="text-center py-5" style="color: #94A3B8;">
            <i class="fa-solid fa-user-slash fa-2x mb-2 d-block"></i> No records found for this period.
          </td>
        </tr>
      <% } else { %>
        <% people.forEach(person => { %>
          <tr>
            <td class="sticky-col">
              <div class="monthly-person-cell">
                <div class="monthly-person-avatar">
                  <%= (person.first_name || person.name || '?').charAt(0).toUpperCase() %>
                </div>
                <div class="monthly-person-meta">
                  <div class="monthly-person-name" title="<%= person.first_name || person.name || '' %> <%= person.last_name || '' %>">
                    <%= person.first_name || person.name || '' %> <%= person.last_name || '' %>
                  </div>
                  <% if (person.roll_no || person.roll_number) { %>
                    <div class="monthly-person-sub">Roll No: <%= person.roll_no || person.roll_number %></div>
                  <% } else if (person.email) { %>
                    <div class="monthly-person-sub" title="<%= person.email %>">
                      <%= person.email %>
                    </div>
                  <% } %>
                </div>
              </div>
            </td>
            <% (days || []).forEach(d => { %>
              <% 
                const targetDayKey = String(d.date || '').slice(0, 10);
                const pId = person.id || person.teacher_id || person.driver_id || person.librarian_id || person.student_id;
                const personMap = (attendanceMap && (attendanceMap[pId] || attendanceMap[String(pId)] || (person.id && attendanceMap[person.id]))) || {};
                const status = personMap[targetDayKey] || personMap[d.date] || null;
                let dotClass = 'nd';
                let dotChar = '—';
                if (status) {
                  const s = String(status).toLowerCase().trim();
                  if (s === 'p' || s === 'present') {
                    dotClass = 'p';
                    dotChar = 'P';
                  } else if (s === 'a' || s === 'absent') {
                    dotClass = 'a';
                    dotChar = 'A';
                  } else if (s === 'l' || s === 'late') {
                    dotClass = 'l';
                    dotChar = 'L';
                  } else if (s === 'half-day' || s === 'half_day' || s === 'h') {
                    dotClass = 'h';
                    dotChar = 'H';
                  } else if (s === 'leave' || s === 'lv' || s === 'paid_leave' || s === 'medical_leave') {
                    dotClass = 'lv';
                    dotChar = 'LV';
                  }
                }
              %>
              <td class="<%= d.isHoliday ? 'holiday' : '' %> <%= d.date === new Date().toISOString().slice(0,10) ? 'today' : '' %>">
                <% if (d.isHoliday && dotClass === 'nd') { %>
                  <span style="color: #F87171; font-size: 11px; font-weight: 600; opacity: 0.6;">S</span>
                <% } else { %>
                  <span class="att-dot <%= dotClass %>" title="<%= status ? status : 'Not Marked' %>"><%= dotChar %></span>
                <% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>