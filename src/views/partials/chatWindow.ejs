<% function getAvatarBgColor(name) { if (!name) return '#6b7280' ; const char=name.trim().charAt(0).toUpperCase(); const
    colorMap={ 'A' : '#10b981' , 'B' : '#8b5cf6' , 'C' : '#06b6d4' , 'D' : '#f97316' , 'E' : '#ef4444' , 'F' : '#e11d48'
    , 'G' : '#6366f1' , 'H' : '#14b8a6' , 'I' : '#3b82f6' , 'J' : '#f59e0b' , 'K' : '#8b5cf6' , 'L' : '#10b981' , 'M'
    : '#ec4899' , 'N' : '#6366f1' , 'O' : '#f97316' , 'P' : '#14b8a6' , 'Q' : '#8b5cf6' , 'R' : '#06b6d4' , 'S'
    : '#10b981' , 'T' : '#f59e0b' , 'U' : '#6366f1' , 'V' : '#ec4899' , 'W' : '#3b82f6' , 'X' : '#8b5cf6' , 'Y'
    : '#f97316' , 'Z' : '#14b8a6' }; return colorMap[char] || '#6b7280' ; } %>
    <div class="chat-container bg-white border border-slate-200 shadow-sm rounded-2xl overflow-hidden"
        id="chatContainer" data-user-id="<%= user.id %>" data-user-role="<%= user.role %>"
        style="height: min(760px, calc(100vh - 140px)); min-height: 520px;">
        <div class="flex w-full h-full overflow-hidden relative">
            <div class="w-full md:w-2/5 md:min-w-[300px] md:max-w-[380px] md:border-r border-slate-200 h-full flex flex-col bg-white flex-shrink-0"
                id="contactsSidebar">
                <div class="p-4 border-b border-slate-200 bg-slate-50">
                    <h5 class="m-0 text-slate-800 font-bold flex items-center gap-2 text-base">
                        <i class="fas fa-comments text-emerald-600"></i><%- (typeof lan !=='undefined' && lan.Messages)
                            ? lan.Messages : 'Messages' %>
                    </h5>
                    <p class="text-slate-500 text-xs mt-1 mb-0"><%- (typeof lan !=='undefined' &&
                            lan.Select_Contact_To_Message) ? lan.Select_Contact_To_Message
                            : 'Select a contact to start messaging' %></p>
                    <div class="mt-3 relative">
                        <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="search"
                            class="w-full text-xs pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-full focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"
                            name="q" value=""
                            placeholder="<%- (typeof lan !== 'undefined' && lan.Search_Contacts) ? lan.Search_Contacts : 'Search contacts...' %>"
                            id="searchContacts" oninput="filterContacts()">
                    </div>
                </div>
                <div class="flex-grow overflow-y-auto p-2 space-y-1" id="contactsList">
                    <% if (contacts && contacts.length> 0) { %>
                        <% contacts.forEach(contact=> {
                            const contactName = contact.first_name + ' ' + contact.last_name;
                            const avatarBg = getAvatarBgColor(contact.first_name);
                            %>
                            <div class="contact-item contact-item-trigger p-3 border-b border-slate-100 flex items-center cursor-pointer hover:bg-slate-50 rounded-xl transition-colors"
                                id="contact-<%= contact.id %>" data-id="<%= contact.id %>"
                                data-user-id="<%= contact.id %>" data-role="<%= contact.role %>"
                                data-fullname="<%= contactName %>" data-name="<%= contactName %>"
                                data-search="<%= [contact.first_name, contact.last_name, contact.role, contact.last_message].filter(Boolean).join(' ') %>">
                                <div class="relative flex-shrink-0 mr-3">
                                    <% if (contact.image) { %>
                                        <img src="<%= contact.image %>" alt="<%= contactName %>"
                                            class="w-11 h-11 rounded-xl object-cover">
                                        <% } else { %>
                                            <div class="w-11 h-11 rounded-xl flex items-center justify-center text-white font-bold text-sm shadow-sm avatar-bg-element"
                                                data-avatar-bg="<%= avatarBg %>">
                                                <%= contact.first_name.charAt(0).toUpperCase() %>
                                            </div>
                                            <% } %>
                                                <span
                                                    class="status-dot absolute bottom-0 right-0 w-3 h-3 rounded-full border-2 border-white bg-gray-400 transition-colors"
                                                    id="dot-<%= contact.id %>"></span>
                                </div>
                                <div class="flex-grow min-w-0">
                                    <div class="flex justify-between items-center mb-1">
                                        <h6 class="contact-name m-0 truncate text-slate-800 font-semibold text-sm">
                                            <%= contactName %>
                                        </h6>
                                        <span
                                            class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-[9px] font-medium capitalize ml-1 flex-shrink-0">
                                            <%= contact.role.replace('_', ' ' ) %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <p class="last-message text-slate-500 truncate m-0 text-xs"
                                            id="lastMsg-<%= contact.id %>" style="max-width: 180px;">
                                            <%= contact.last_message || ((typeof lan !=='undefined' &&
                                                lan.No_Messages_Yet) ? lan.No_Messages_Yet : 'No messages yet' ) %>
                                        </p>
                                        <span
                                            class="bg-emerald-600 text-white text-[10px] font-bold rounded-full w-5 h-5 items-center justify-center ml-2 <%= contact.unread_count > 0 ? 'flex' : 'hidden' %>"
                                            id="unread-<%= contact.id %>">
                                            <%= contact.unread_count %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <div id="contactsSearchEmpty" class="hidden p-6 text-center text-slate-400 text-xs"><%-
                                        (typeof lan !=='undefined' && lan.No_Contacts_Match_Search) ?
                                        lan.No_Contacts_Match_Search : 'No contacts match your search.' %></div>
                                <% } else { %>
                                    <div class="p-6 text-center text-slate-400">
                                        <i class="fas fa-users text-2xl mb-2 text-slate-200"></i>
                                        <p class="text-xs m-0"><%- (typeof lan !=='undefined' &&
                                                lan.No_Active_Contacts_Found) ? lan.No_Active_Contacts_Found
                                                : 'No active contacts found' %></p>
                                    </div>
                                    <% } %>
                </div>
            </div>
            <div class="w-full md:flex-1 h-full flex flex-col bg-slate-50 hidden md:flex" id="chatArea">
                <div class="flex flex-col h-full justify-center items-center p-8 text-center" id="chatPlaceholder">
                    <div
                        class="w-20 h-20 rounded-2xl bg-[#e0e7ff] text-indigo-600 flex items-center justify-center mb-3 shadow-sm">
                        <i class="fas fa-hand-sparkles text-3xl"></i>
                    </div>
                    <h5 class="text-slate-800 font-bold text-lg"><%- (typeof lan !=='undefined' &&
                            lan.Say_Hello_Start_Conversation) ? lan.Say_Hello_Start_Conversation
                            : 'Say hello! Start your conversation.' %></h5>
                    <p class="text-slate-500 text-sm mt-1 max-w-[320px]"><%- (typeof lan !=='undefined' &&
                            lan.Select_User_Internal_Message) ? lan.Select_User_Internal_Message
                            : 'Select a user from the contact list to start a secure internal message.' %></p>
                </div>
                <div class="flex flex-col h-full hidden" id="activeChat">
                    <div class="p-3 border-b border-slate-200 flex items-center justify-between bg-white h-[68px]">
                        <div class="flex items-center min-w-0">
                            <button class="md:hidden chat-back-btn" onclick="showContactsSidebar()"
                                aria-label="<%- (typeof lan !== 'undefined' && lan.Back_To_Contacts) ? lan.Back_To_Contacts : 'Back to contacts' %>">
                                <i class="fas fa-arrow-left text-sm"></i>
                            </button>
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-emerald-600 text-white font-bold text-sm mr-2.5 flex-shrink-0 shadow-sm"
                                id="activeAvatar">U</div>
                            <div class="min-w-0">
                                <h6 class="m-0 text-slate-800 font-bold text-sm truncate" id="activeName"><%- (typeof
                                        lan !=='undefined' && lan.Contact_Name) ? lan.Contact_Name : 'Contact Name' %>
                                </h6>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block flex-shrink-0"
                                        id="activeStatusIndicator"></span>
                                    <span class="text-slate-500 text-[10px] capitalize font-medium truncate"
                                        id="activeRole"><%- (typeof lan !=='undefined' && lan.Role) ? lan.Role : 'Role'
                                            %></span>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 flex-shrink-0 ml-2">
                            <button onclick="markAllReadFromActive()"
                                class="w-9 h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-emerald-600 hover:border-emerald-200 transition-colors"
                                aria-label="<%- (typeof lan !== 'undefined' && lan.Mark_All_As_Read) ? lan.Mark_All_As_Read : 'Mark all messages as read' %>"
                                title="<%- (typeof lan !== 'undefined' && lan.Mark_All_As_Read) ? lan.Mark_All_As_Read : 'Mark all as read' %>">
                                <i class="fas fa-check-double text-xs"></i>
                            </button>
                            <button onclick="toggleMsgSearch()"
                                class="w-9 h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:border-slate-300 transition-colors"
                                aria-label="<%- (typeof lan !== 'undefined' && lan.Search_Messages) ? lan.Search_Messages : 'Search messages' %>"
                                title="<%- (typeof lan !== 'undefined' && lan.Search_Messages) ? lan.Search_Messages : 'Search messages' %>">
                                <i class="fas fa-search text-xs"></i>
                            </button>
                        </div>
                    </div>
                    <div id="msgSearchBar" class="hidden px-4 py-2.5 border-b border-slate-100 bg-white">
                        <div class="relative">
                            <i
                                class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="search"
                                aria-label="<%- (typeof lan !== 'undefined' && lan.Search_Messages) ? lan.Search_Messages : 'Search messages' %>"
                                class="w-full text-xs pl-8 py-2 rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors"
                                name="q"
                                placeholder="<%- (typeof lan !== 'undefined' && lan.Search_Messages) ? lan.Search_Messages : 'Search messages...' %>"
                                id="msgSearchInput">
                        </div>
                        <div id="searchResults"
                            class="mt-2 space-y-1 max-h-48 overflow-y-auto hidden bg-slate-50 border border-slate-100 rounded-lg p-1.5">
                        </div>
                    </div>
                    <div class="flex-grow p-4 overflow-y-auto bg-chat flex flex-col gap-3" id="messagesWindow"></div>
                    <div id="typingIndicator"
                        class="hidden px-4 py-1.5 text-xs text-slate-500 italic bg-white/80 backdrop-blur-sm border-t border-slate-100 flex items-center gap-1.5">
                        <span id="typingName" class="font-medium text-slate-700"></span> <%- (typeof lan !=='undefined'
                            && lan.Is_Typing) ? lan.Is_Typing : 'is typing' %>
                            <span class="inline-flex gap-1 ml-1 items-center">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 animate-bounce"
                                    style="animation-delay:0ms"></span>
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 animate-bounce"
                                    style="animation-delay:150ms"></span>
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 animate-bounce"
                                    style="animation-delay:300ms"></span>
                            </span>
                    </div>
                    <div class="p-3.5 border-t border-slate-200 bg-white relative">
                        <div id="emojiPicker" class="emoji-picker-card shadow-xl border border-slate-200 bg-white"
                            style="display: none;">
                            <div class="emoji-picker-grid" id="emojiGrid"></div>
                        </div>
                        <form id="messageForm" onsubmit="handleSendMessage(event)" class="m-0">
                            <div class="flex items-center gap-2">
                                <button
                                    class="w-10 h-10 rounded-xl border border-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-50 transition-colors focus:outline-none flex-shrink-0"
                                    type="button" id="emojiToggleBtn" onclick="toggleEmojiPicker(event)"
                                    aria-label="<%- (typeof lan !== 'undefined' && lan.Open_Emoji_Picker) ? lan.Open_Emoji_Picker : 'Open emoji picker' %>">
                                    <i class="far fa-laugh-beam text-lg"></i>
                                </button>
                                <input type="text"
                                    class="flex-grow bg-slate-50 rounded-2xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-slate-800 placeholder-slate-400 transition-colors"
                                    id="messageInput"
                                    placeholder="<%- (typeof lan !== 'undefined' && lan.Type_A_Message) ? lan.Type_A_Message : 'Type a message...' %>"
                                    aria-label="<%- (typeof lan !== 'undefined' && lan.Message) ? lan.Message : 'Message' %>"
                                    autocomplete="off" maxlength="1000" required>
                                <button
                                    class="w-11 h-11 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white flex items-center justify-center shadow-sm transition-all focus:outline-none flex-shrink-0"
                                    type="submit"
                                    aria-label="<%- (typeof lan !== 'undefined' && lan.Send_Message) ? lan.Send_Message : 'Send message' %>">
                                    <i class="fas fa-paper-plane text-sm"></i>
                                </button>
                            </div>
                            <div class="flex justify-between items-center mt-1.5 px-2">
                                <span class="text-rose-600 text-xs font-medium" id="messageError"
                                    style="display: none;"></span>
                                <span class="text-slate-400 text-[10px] ml-auto" id="messageCounter">0/1000</span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        (function () {
            const container = document.getElementById('chatContainer');

            function applyAvatarBgColors() {
                document.querySelectorAll('.avatar-bg-element[data-avatar-bg]').forEach(el => {
                    const bg = el.getAttribute('data-avatar-bg');
                    if (bg) el.style.backgroundColor = bg;
                });
            };

            function escapeHtml(str) {
                if (typeof str !== 'string') return '';
                return str
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#x27;');
            };

            function getAvatarColor(name) {
                if (!name) return '#6b7280';
                const char = name.trim().charAt(0).toUpperCase();
                const colorMap = {
                    'A': '#10b981', 'B': '#8b5cf6', 'C': '#06b6d4', 'D': '#f97316', 'E': '#ef4444', 'F': '#e11d48', 'G': '#6366f1', 'H': '#14b8a6',
                    'I': '#3b82f6', 'J': '#f59e0b', 'K': '#8b5cf6', 'L': '#10b981', 'M': '#ec4899', 'N': '#6366f1', 'O': '#f97316', 'P': '#14b8a6',
                    'Q': '#8b5cf6', 'R': '#06b6d4', 'S': '#10b981', 'T': '#f59e0b', 'U': '#6366f1', 'V': '#ec4899', 'W': '#3b82f6', 'X': '#8b5cf6',
                    'Y': '#f97316', 'Z': '#14b8a6'
                };
                return colorMap[char] || '#6b7280';
            };

            const socket = io({ withCredentials: true });
            const rolePathMap = {
                school_admin: 'schooladmin',
                teacher: 'teacher',
                librarian: 'librarian',
                driver: 'driver'
            };
            const getRolePath = (role) => rolePathMap[role] || String(role || '').replace(/_/g, '');
            const currentUserId = Number(container.getAttribute('data-user-id'));
            const userRoleRaw = container.getAttribute('data-user-role');
            const currentRole = getRolePath(userRoleRaw);
            let activeContactId = null;
            let lastDateString = null;

            function getMessageDateString(dateObj) {
                const today = new Date();
                const yesterday = new Date();
                yesterday.setDate(today.getDate() - 1);

                const d = new Date(dateObj);
                if (d.toDateString() === today.toDateString()) {
                    return "Today";
                } else if (d.toDateString() === yesterday.toDateString()) {
                    return "Yesterday";
                } else {
                    return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
                };
            };

            document.getElementById('contactsList')?.addEventListener('click', function (e) {
                const item = e.target.closest('.contact-item-trigger');
                if (item) {
                    const id = parseInt(item.getAttribute('data-id'));
                    const fullname = item.getAttribute('data-fullname');
                    const role = item.getAttribute('data-role');
                    selectContact(id, fullname, role);
                };
            });

            function playBeep() {
                try {
                    const audio = new Audio("https://assets.mixkit.co/active_storage/sfx/2869/2869-like-beep.wav");
                    audio.volume = 0.3;
                    audio.play().catch(() => { });
                } catch (e) { }
            };

            socket.on('connect', () => { });
            socket.on('connect_error', (err) => {
                console.error('[Chat Socket] Connection error:', err.message);
            });

            socket.on('chat_error', (data) => {
                showMessageError(data && data.message ? data.message : 'Unable to send message.');
            });

            socket.on('messages_read', (data) => {
                const rcvId = Number(data.receiver_id);
                const activeId = activeContactId ? Number(activeContactId) : null;
                if (activeId && rcvId === activeId) {
                    const greyChecks = document.querySelectorAll('#messagesWindow .fa-check-double');
                    greyChecks.forEach(check => {
                        check.style.color = '#60a5fa';
                    });
                }
            });

            function restoreActiveChat() {
                applyAvatarBgColors();
                const lastContactId = localStorage.getItem('activeChatContactId');
                const lastContactName = localStorage.getItem('activeChatContactName');
                const lastContactRole = localStorage.getItem('activeChatContactRole');

                if (lastContactId && lastContactName) {
                    const contactEl = document.getElementById(`contact-${lastContactId}`);
                    if (contactEl) {
                        selectContact(parseInt(lastContactId), lastContactName, lastContactRole || '');
                    } else if (window.innerWidth < 768) {
                        showContactsSidebar();
                    }
                } else if (window.innerWidth < 768) {
                    showContactsSidebar();
                }
            };

            if (document.readyState === 'loading') {
                window.addEventListener('DOMContentLoaded', restoreActiveChat);
            } else {
                restoreActiveChat();
            };

            socket.on('chat_message', (msg) => {
                const msgSenderId = Number(msg.sender_id);
                const msgReceiverId = Number(msg.receiver_id);
                const myUserId = Number(currentUserId);
                const activeId = activeContactId ? Number(activeContactId) : null;

                if (activeId && (msgSenderId === activeId || msgSenderId === myUserId)) {
                    if (msgSenderId === activeId) {
                        msg.is_read = 1;
                        socket.emit('read_messages', { sender_id: activeId });
                        fetch(`/${currentRole}/chat/history/${activeId}`);
                        playBeep();
                    };
                    appendMessage(msg);
                    scrollMessagesToBottom();
                } else {
                    const badge = document.querySelector(`#contact-${msgSenderId} .unread-badge`) || document.getElementById(`unread-${msgSenderId}`);
                    if (badge) {
                        let currentCount = parseInt(badge.textContent.trim()) || 0;
                        badge.textContent = currentCount + 1;
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                    };

                    if (msgSenderId !== myUserId) {
                        playBeep();
                        if (typeof showToast === 'function') {
                            showToast(`New message from ${msg.sender_name || 'User'}: ${msg.message}`, 'info');
                        };
                    };
                };

                const targetContactId = (msgSenderId === myUserId) ? msgReceiverId : msgSenderId;
                const lastMsgEl = document.getElementById(`lastMsg-${targetContactId}`);
                if (lastMsgEl) {
                    lastMsgEl.textContent = msg.message;
                };
                const contactEl = document.getElementById(`contact-${targetContactId}`);
                const listEl = document.getElementById('contactsList');
                if (contactEl && listEl) {
                    listEl.prepend(contactEl);
                };
            });

            function selectContact(contactId, fullName, role) {
                activeContactId = contactId;
                socket.emit('read_messages', { sender_id: contactId });

                localStorage.setItem('activeChatContactId', contactId);
                localStorage.setItem('activeChatContactName', fullName);
                localStorage.setItem('activeChatContactRole', role);

                document.querySelectorAll('.contact-item').forEach(item => item.classList.remove('bg-indigo-light'));
                const contactEl = document.getElementById(`contact-${contactId}`);
                if (contactEl) contactEl.classList.add('bg-indigo-light');

                const badge = document.getElementById(`unread-${contactId}`);
                if (badge) {
                    badge.classList.add('hidden');
                    badge.classList.remove('flex');
                    badge.textContent = '0';
                };

                document.getElementById('activeName').textContent = fullName;
                document.getElementById('activeRole').textContent = (role || '').replace('_', ' ');
                const avatarEl = document.getElementById('activeAvatar');
                if (avatarEl) {
                    avatarEl.textContent = fullName.charAt(0).toUpperCase();
                    avatarEl.style.backgroundColor = getAvatarColor(fullName);
                };
                document.getElementById('chatPlaceholder').classList.add('hidden');
                document.getElementById('activeChat').classList.remove('hidden');

                fetch(`/${currentRole}/chat/history/${contactId}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            renderMessages(data.messages);
                            updateReadReceipts(data.messages);
                        };
                    })
                    .catch(err => console.error('Failed to load chat history:', err));

                showChatArea();
            };

            function showChatArea() {
                const sidebar = document.getElementById('contactsSidebar');
                const chat = document.getElementById('chatArea');
                const pageHeaders = document.querySelectorAll('#chatPageHeader, .lib-chat-hero, .chat-page-header');
                if (window.innerWidth < 768) {
                    pageHeaders.forEach(h => h.style.setProperty('display', 'none', 'important'));
                    if (sidebar) {
                        sidebar.style.setProperty('display', 'none', 'important');
                        sidebar.classList.add('hidden');
                    }
                    if (chat) {
                        chat.style.setProperty('display', 'flex', 'important');
                        chat.classList.remove('hidden');
                    }
                } else {
                    pageHeaders.forEach(h => h.style.removeProperty('display'));
                    if (sidebar) {
                        sidebar.style.removeProperty('display');
                        sidebar.classList.remove('hidden');
                    }
                    if (chat) {
                        chat.style.removeProperty('display');
                        chat.classList.remove('hidden');
                    }
                }
            };

            function renderMessages(messages) {
                const win = document.getElementById('messagesWindow');
                win.innerHTML = '';
                lastDateString = null;
                if (messages && messages.length > 0) {
                    messages.forEach(msg => appendMessage(msg));
                } else {
                    win.innerHTML = `
                <div class="flex flex-col items-center justify-center my-auto py-12 text-center">
                    <div class="w-16 h-16 rounded-2xl bg-[#e0e7ff] text-indigo-600 flex items-center justify-center mb-3 shadow-sm">
                        <i class="fas fa-hand-sparkles text-2xl"></i>
                    </div>
                    <h6 class="text-slate-800 font-bold text-base mb-1"><%- (typeof lan !== 'undefined' && lan.Say_Hello_Start_Conversation) ? lan.Say_Hello_Start_Conversation : 'Say hello! Start your conversation.' %></h6>
                    <p class="text-slate-500 text-xs m-0"><%- (typeof lan !== 'undefined' && lan.Send_Message_To_Begin) ? lan.Send_Message_To_Begin : 'Send a message to begin chatting.' %></p>
                </div>`;
                };
                scrollMessagesToBottom();
            };

            function scrollMessagesToBottom() {
                const win = document.getElementById('messagesWindow');
                if (win) {
                    win.scrollTop = win.scrollHeight;
                };
            };

            function appendMessage(msg) {
                const win = document.getElementById('messagesWindow');

                const msgDateString = getMessageDateString(msg.created_at);
                if (msgDateString !== lastDateString) {
                    lastDateString = msgDateString;
                    const dateDivider = document.createElement('div');
                    dateDivider.className = 'text-center my-3 w-full';
                    dateDivider.innerHTML = `<span class="inline-block bg-white text-slate-500 px-3 py-1.5 border border-slate-200 rounded-full shadow-sm text-[10px] font-semibold tracking-wide">${msgDateString}</span>`;
                    win.appendChild(dateDivider);
                };

                const isSelf = Number(msg.sender_id) === Number(currentUserId);
                const isDeleted = Boolean(msg.deleted_at);
                const wrapper = document.createElement('div');
                wrapper.className = `flex mb-3 ${isSelf ? 'justify-end' : 'justify-start'} message-bubble-wrapper group`;
                wrapper.id = `msg-wrapper-${msg.id}`;
                wrapper.setAttribute('data-message-id', msg.id);
                wrapper.setAttribute('data-sender-self', isSelf ? 'true' : 'false');

                const card = document.createElement('div');
                card.style.maxWidth = window.innerWidth < 640 ? '84%' : '70%';
                if (isDeleted) {
                    card.className = `shadow-sm relative rounded-2xl px-3.5 py-2 ${isSelf ? 'bg-slate-100 rounded-br-none' : 'bg-slate-100 rounded-bl-none'} border border-dashed border-slate-300`;
                    const text = document.createElement('p');
                    text.className = 'm-0 text-xs italic text-slate-400 flex items-center gap-1.5';
                    text.innerHTML = '<i class="fa-solid fa-ban text-[11px] text-slate-400"></i> <%- (typeof lan !== "undefined" && lan.Message_Deleted) ? lan.Message_Deleted : "This message was deleted" %>';
                    card.appendChild(text);
                } else {
                    card.className = `shadow-sm relative rounded-2xl px-4 py-2.5 ${isSelf ? 'bg-whatsapp-sent rounded-br-none' : 'bg-whatsapp-received rounded-bl-none'}`;
                    const text = document.createElement('p');
                    text.className = 'm-0 text-sm text-slate-800 leading-relaxed break-words';
                    text.style.whiteSpace = 'pre-wrap';
                    text.textContent = msg.message;
                    card.appendChild(text);
                }

                const time = document.createElement('div');
                time.className = `text-[9px] flex items-center justify-end gap-1 mt-1 text-slate-400 font-medium`;
                time.textContent = new Date(msg.created_at).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });

                if (isSelf && !isDeleted) {
                    const checkmarks = document.createElement('span');
                    checkmarks.className = 'ml-1 read-receipt flex items-center';
                    checkmarks.innerHTML = msg.is_read === 1 ? '<i class="fas fa-check-double text-blue-400 text-[10px]"></i>' : '<i class="fas fa-check text-gray-300 text-[10px]"></i>';
                    time.appendChild(checkmarks);

                    const deleteBtn = document.createElement('button');
                    deleteBtn.onclick = function () { deleteMsg(msg.id, deleteBtn); };
                    deleteBtn.className = 'delete-msg-btn absolute -top-2 -right-2 hidden group-hover:flex w-5 h-5 rounded-full bg-red-100 text-rose-600 items-center justify-center text-[10px] hover:bg-red-200 transition shadow-sm';
                    deleteBtn.title = 'Delete message';
                    deleteBtn.innerHTML = '<i class="fas fa-times"></i>';
                    card.appendChild(deleteBtn);
                };
                card.appendChild(time);

                wrapper.appendChild(card);
                win.appendChild(wrapper);
            };

            function handleSendMessage(e) {
                e.preventDefault();
                const input = document.getElementById('messageInput');
                const text = input.value.trim();
                clearMessageError();
                if (!activeContactId) {
                    showMessageError('Select a contact before sending a message.');
                    return;
                };
                if (!text) {
                    showMessageError('Message content is required.');
                    return;
                };
                if (text.length > 1000) {
                    showMessageError('Message must be 1000 characters or fewer.');
                    return;
                };

                const messagePayload = {
                    receiver_id: activeContactId,
                    message: text
                };

                if (socket && socket.connected) {
                    socket.emit('send_chat_message', messagePayload);
                    input.value = '';
                } else {
                    console.warn('[Chat] Socket disconnected. Sending message via HTTP fallback...');
                    fetch(`/${currentRole}/chat/send`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(messagePayload)
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                appendMessage(data.message);
                                scrollMessagesToBottom();
                                input.value = '';
                            } else {
                                console.error('[Chat] HTTP send message failed:', data.message);
                                alert('Failed to send message: ' + (data.message || 'Unknown error'));
                            };
                        })
                        .catch(err => {
                            console.error('[Chat] HTTP send error:', err);
                            alert('Connection error. Failed to send message.');
                        });
                };
            };

            function showMessageError(message) {
                const el = document.getElementById('messageError');
                if (el) {
                    el.textContent = message;
                    el.style.display = 'inline';
                };
            };

            function clearMessageError() {
                const el = document.getElementById('messageError');
                if (el) {
                    el.textContent = '';
                    el.style.display = 'none';
                };
            };

            function normalizeContactSearch(value) {
                return String(value || '').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '');
            };

            function filterContacts() {
                const input = document.getElementById('searchContacts');
                if (!input) return;

                const query = normalizeContactSearch(input.value);
                const contacts = document.querySelectorAll('.contact-item');
                let visibleCount = 0;

                contacts.forEach(item => {
                    const searchableText = normalizeContactSearch(item.getAttribute('data-search') || item.getAttribute('data-name'));
                    const matches = !query || searchableText.includes(query);
                    item.style.display = matches ? 'flex' : 'none';
                    if (matches) visibleCount += 1;
                });

                const emptyState = document.getElementById('contactsSearchEmpty');
                if (emptyState) emptyState.classList.toggle('hidden', !query || visibleCount > 0);
            };

            function showContactsSidebar() {
                activeContactId = null;
                localStorage.removeItem('activeChatContactId');
                localStorage.removeItem('activeChatContactName');
                localStorage.removeItem('activeChatContactRole');
                document.querySelectorAll('.contact-item').forEach(item => item.classList.remove('bg-indigo-light'));

                const sidebar = document.getElementById('contactsSidebar');
                const chat = document.getElementById('chatArea');
                const pageHeaders = document.querySelectorAll('#chatPageHeader, .lib-chat-hero, .chat-page-header');
                if (window.innerWidth < 768) {
                    pageHeaders.forEach(h => h.style.removeProperty('display'));
                    if (sidebar) {
                        sidebar.style.setProperty('display', 'flex', 'important');
                        sidebar.classList.remove('hidden');
                    }
                    if (chat) {
                        chat.style.setProperty('display', 'none', 'important');
                        chat.classList.add('hidden');
                    }
                } else {
                    pageHeaders.forEach(h => h.style.removeProperty('display'));
                    if (sidebar) {
                        sidebar.style.removeProperty('display');
                        sidebar.classList.remove('hidden');
                    }
                    if (chat) {
                        chat.style.removeProperty('display');
                        chat.classList.remove('hidden');
                    }
                }
            };

            function toggleEmojiPicker(e) {
                if (e) e.stopPropagation();
                const picker = document.getElementById('emojiPicker');
                if (picker) {
                    picker.style.display = picker.style.display === 'none' ? 'block' : 'none';
                };
            };

            function initEmojiPicker() {
                const grid = document.getElementById('emojiGrid');
                if (!grid) return;

                const emojis = [
                    '😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣', '😊', '😇', '🙂', '🙃', '😉', '😌', '😍', '🥰', '😘', '😗', '😙', '😚', '😋', '😛', '😝', '😜', '🤪', '🤨', '🧐', '🤓', '😎', '🥸', '🤩', '🥳', '😏', '😒', '😞', '😔', '😟', '😕', '🙁', '☹️', '😣', '😖', '😫', '😩', '🥺', '😢', '😭', '😤', '😠', '😡', '🤬', '🤯', '😳', '🥵', '🥶', '😱', '😨', '😰', '😥', '😓', '🤔', '🫣', '🤭', '🫢', '🫡', '🤫', '🫠', '🤥', '😶', '🫥', '😐', '😑', '😬',
                    '👍', '👎', '👌', '✌️', '🤞', '🤟', '🤘', '🤙', '👈', '👉', '👆', '👇', '☝️', '🤝', '👏', '🙌', '🫶', '👐', '🤲', '✍️', '🙏', '💅', '🤳', '💪', '🦾', '🦿', '🦵', '🦶', '👂', '🦻', '👃', '🧠', '🫀', '🫁', '🦷', '🦴', '👀', '👁', '👅', '👄', '💋',
                    '❤️', '🧡', '💛', '💚', '💙', '💜', '🖤', '🤍', '🤎', '💔', '❣️', '💕', '💞', '💓', '💗', '💖', '💘', '💝', '💟',
                    '🔥', '✨', '🌟', '⭐', '🎈', '🎉', '🎊', '🚀', '💯', '🎂', '🍕', '🍺', '☕️', '✈️', '🚗', '📞', '💻', '📱', '🔒', '🔑'
                ];

                grid.innerHTML = '';
                emojis.forEach(emoji => {
                    const el = document.createElement('span');
                    el.className = 'emoji-item';
                    el.textContent = emoji;
                    el.addEventListener('click', () => {
                        const input = document.getElementById('messageInput');
                        if (input) {
                            const start = input.selectionStart;
                            const end = input.selectionEnd;
                            const text = input.value;
                            input.value = text.substring(0, start) + emoji + text.substring(end);
                            const newPos = start + emoji.length;
                            input.setSelectionRange(newPos, newPos);
                            input.focus();
                        };
                    });
                    grid.appendChild(el);
                });
            };

            if (document.readyState === 'loading') {
                window.addEventListener('DOMContentLoaded', initEmojiPicker);
            } else {
                initEmojiPicker();
            };

            document.addEventListener('click', (event) => {
                const picker = document.getElementById('emojiPicker');
                const btn = document.getElementById('emojiToggleBtn');
                if (picker && btn && !picker.contains(event.target) && !btn.contains(event.target)) {
                    picker.style.display = 'none';
                };
            });

            window.addEventListener('resize', () => {
                if (window.innerWidth >= 768) {
                    document.getElementById('contactsSidebar').classList.remove('hidden');
                    document.getElementById('chatArea').classList.remove('hidden');
                };
            });

            const messageInput = document.getElementById('messageInput');
            const messageCounter = document.getElementById('messageCounter');
            if (messageInput && messageCounter) {
                messageInput.addEventListener('input', () => {
                    messageCounter.textContent = `${messageInput.value.length}/1000`;
                    if (messageInput.value.length <= 1000) clearMessageError();
                });
            };

            const onlineUserIds = new Set();
            function updateStatusDot(userId, isOnline) {
                const dot = document.getElementById(`dot-${userId}`);
                if (!dot) return;
                dot.classList.remove('bg-gray-400', 'bg-emerald-500');
                dot.classList.add(isOnline ? 'bg-emerald-500' : 'bg-gray-400');
                dot.title = isOnline ? 'Online' : 'Offline';
            };

            socket.on('online_users_list', (data) => {
                (data.userIds || []).forEach(id => {
                    onlineUserIds.add(id);
                    updateStatusDot(id, true);
                });
            });

            socket.on('user_online', (data) => {
                onlineUserIds.add(data.userId);
                updateStatusDot(data.userId, true);
            });

            socket.on('user_offline', (data) => {
                onlineUserIds.delete(data.userId);
                updateStatusDot(data.userId, false);
            });

            socket.emit('get_online_users');

            let typingTimeout = null;
            let isTyping = false;

            const msgInput = document.getElementById('messageInput') || document.querySelector('input[name="message"]') || document.querySelector('textarea[name="message"]');
            if (msgInput) {
                msgInput.addEventListener('input', () => {
                    const contactId = getActiveContactId();
                    if (!contactId) return;

                    if (!isTyping) {
                        isTyping = true;
                        socket.emit('typing_start', { receiver_id: contactId });
                    };

                    clearTimeout(typingTimeout);
                    typingTimeout = setTimeout(() => {
                        isTyping = false;
                        socket.emit('typing_stop', { receiver_id: contactId });
                    }, 1500);
                });

                msgInput.closest('form')?.addEventListener('submit', () => {
                    isTyping = false;
                    clearTimeout(typingTimeout);
                    const contactId = getActiveContactId();
                    if (contactId) socket.emit('typing_stop', { receiver_id: contactId });
                });
            };

            let typingHideTimeout = null;

            socket.on('user_typing', (data) => {
                const contactId = getActiveContactId();
                if (!contactId || data.sender_id !== contactId) return;

                const indicator = document.getElementById('typingIndicator');
                const nameEl = document.getElementById('typingName');
                if (!indicator) return;

                if (nameEl) nameEl.textContent = data.sender_name || 'Contact';
                indicator.classList.remove('hidden');

                clearTimeout(typingHideTimeout);
                typingHideTimeout = setTimeout(() => {
                    indicator.classList.add('hidden');
                }, 2000);
            });

            socket.on('user_typing_stopped', (data) => {
                const contactId = getActiveContactId();
                if (!contactId || data.sender_id !== contactId) return;

                const indicator = document.getElementById('typingIndicator');
                if (indicator) indicator.classList.add('hidden');
                clearTimeout(typingHideTimeout);
            });

            function getActiveContactId() {
                if (typeof activeContactId !== 'undefined' && activeContactId) {
                    return parseInt(activeContactId, 10);
                };
                const selected = document.querySelector('.contact-item.active, .contact-item.selected');
                if (selected && selected.dataset.userId) {
                    return parseInt(selected.dataset.userId, 10);
                };
                const urlParams = new URLSearchParams(window.location.search);
                const withParam = urlParams.get('with') || urlParams.get('contact');
                if (withParam) return parseInt(withParam, 10);

                return null;
            };

            async function deleteMsg(messageId, btn) {
                if (!confirm('Delete this message?')) return;

                const originalHTML = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                try {
                    const res = await fetch(`/${currentRole}/chat/message/${messageId}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                            'CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
                        }
                    });
                    const data = await res.json();

                    if (data.success) {
                        const wrapper = btn.closest('.message-bubble-wrapper');
                        if (wrapper) {
                            const isSelf = wrapper.getAttribute('data-sender-self') === 'true';
                            const card = wrapper.querySelector('div');
                            if (card) {
                                card.className = `shadow-sm relative rounded-2xl px-3.5 py-2 ${isSelf ? 'bg-slate-100 rounded-br-none' : 'bg-slate-100 rounded-bl-none'} border border-dashed border-slate-300`;
                                const delBtn = card.querySelector('.delete-msg-btn');
                                if (delBtn) delBtn.remove();
                                const textEl = card.querySelector('p');
                                if (textEl) {
                                    textEl.className = 'm-0 text-xs italic text-slate-400 flex items-center gap-1.5';
                                    textEl.innerHTML = '<i class="fa-solid fa-ban text-[11px] text-slate-400"></i> <%- (typeof lan !== "undefined" && lan.Message_Deleted) ? lan.Message_Deleted : "This message was deleted" %>';
                                }
                            }
                        };
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = originalHTML;
                        alert(data.message || 'Failed to delete message');
                    };
                } catch {
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                    alert('Request failed. Try again.');
                };
            };

            socket.on('chat_message_deleted', (data) => {
                const { message_id } = data;
                if (!message_id) return;

                const wrapper = document.getElementById(`msg-wrapper-${message_id}`) || document.querySelector(`[data-message-id="${message_id}"]`);
                if (wrapper) {
                    const isSelf = wrapper.getAttribute('data-sender-self') === 'true';
                    const card = wrapper.querySelector('div');
                    if (card) {
                        card.className = `shadow-sm relative rounded-2xl px-3.5 py-2 ${isSelf ? 'bg-slate-100 rounded-br-none' : 'bg-slate-100 rounded-bl-none'} border border-dashed border-slate-300`;
                        const delBtn = card.querySelector('.delete-msg-btn');
                        if (delBtn) delBtn.remove();
                        const textEl = card.querySelector('p');
                        if (textEl) {
                            textEl.className = 'm-0 text-xs italic text-slate-400 flex items-center gap-1.5';
                            textEl.innerHTML = '<i class="fa-solid fa-ban text-[11px] text-slate-400"></i> <%- (typeof lan !== "undefined" && lan.Message_Deleted) ? lan.Message_Deleted : "This message was deleted" %>';
                        }
                    }
                };
            });

            let searchDebounce = null;

            function toggleMsgSearch() {
                const bar = document.getElementById('msgSearchBar');
                if (!bar) return;
                const isHidden = bar.classList.contains('hidden');
                bar.classList.toggle('hidden', !isHidden);
                if (isHidden) {
                    document.getElementById('msgSearchInput')?.focus();
                } else {
                    const input = document.getElementById('msgSearchInput');
                    if (input) input.value = '';
                    const results = document.getElementById('searchResults');
                    if (results) {
                        results.innerHTML = '';
                        results.classList.add('hidden');
                    };
                };
            };

            document.getElementById('msgSearchInput')?.addEventListener('input', (e) => {
                clearTimeout(searchDebounce);
                const q = e.target.value.trim();
                const results = document.getElementById('searchResults');

                if (q.length < 2) {
                    if (results) {
                        results.innerHTML = '';
                        results.classList.add('hidden');
                    };
                    return;
                };

                searchDebounce = setTimeout(async () => {
                    const contactId = getActiveContactId();
                    if (!contactId) return;

                    try {
                        const res = await fetch(`/${currentRole}/chat/search?q=${encodeURIComponent(q)}&with=${contactId}`);
                        const data = await res.json();
                        if (!results) return;

                        if (!data.success || data.messages.length === 0) {
                            results.innerHTML = `<p class="text-xs text-gray-400 px-2 py-1">No messages found</p>`;
                            results.classList.remove('hidden');
                            return;
                        };

                        const highlight = (text, term) => {
                            const safeText = escapeHtml(text);
                            const safeTerm = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                            return safeText.replace(new RegExp(safeTerm, 'gi'), match => `<mark class="bg-yellow-100 font-medium rounded px-0.5">${match}</mark>`);
                        };

                        const msgId = (id) => Number.isInteger(id) ? id : 0;
                        results.innerHTML = data.messages.map(m => `
                    <div class="px-2 py-1.5 rounded hover:bg-slate-100 cursor-pointer text-xs border-b border-slate-100 transition-colors"
                        onclick="scrollToMessage(${msgId(m.id)})">
                        <p class="text-slate-700 m-0">${highlight(m.message, q)}</p>
                        <p class="text-[10px] text-slate-400 mt-0.5 m-0">
                            ${new Date(m.created_at).toLocaleString('en-IN', {
                            day: '2-digit', month: 'short',
                            hour: '2-digit', minute: '2-digit'
                        })}
                        </p>
                    </div>
                `).join('');
                        results.classList.remove('hidden');
                    } catch (err) {
                        console.error('Message search failed:', err);
                        if (results) {
                            results.innerHTML = '<p class="text-xs text-rose-500 px-2 py-1">Message search failed. Please try again.</p>';
                            results.classList.remove('hidden');
                        };
                    };
                }, 300);
            });

            function scrollToMessage(messageId) {
                const el = document.querySelector(`[data-message-id="${messageId}"]`);
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    el.classList.add('ring-2', 'ring-yellow-300', 'rounded-lg');
                    setTimeout(() => el.classList.remove('ring-2', 'ring-yellow-300', 'rounded-lg'), 2000);
                };
                toggleMsgSearch();
            };

            async function markAllReadFromActive() {
                const contactId = getActiveContactId();
                if (!contactId) return;
                try {
                    const res = await fetch(`/${currentRole}/chat/mark-all-read`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ sender_id: contactId })
                    });
                    const data = await res.json();

                    if (data.success) {
                        const badge = document.querySelector(`[data-user-id="${contactId}"] .unread-badge`) || document.getElementById(`unread-${contactId}`);

                        if (badge) {
                            badge.classList.add('hidden');
                            badge.classList.remove('flex');
                            badge.textContent = '0';
                        };

                        const countEl = document.getElementById('headerUnreadCount') || document.getElementById('unreadMessagesBadge');
                        if (countEl) {
                            countEl.textContent = '0';
                            countEl.classList.add('hidden');
                        };
                    };
                } catch (err) {
                    console.error('Mark all read failed:', err);
                };
            };

            function updateReadReceipts(messages) {
                messages.forEach(m => {
                    const el = document.querySelector(`[data-message-id="${m.id}"]`);
                    if (!el) return;

                    const tickEl = el.querySelector('.read-receipt');
                    if (!tickEl) return;

                    if (m.is_read) {
                        tickEl.innerHTML = '<i class="fas fa-check-double text-blue-400 text-[10px]"></i>';
                        tickEl.title = 'Read';
                    } else {
                        tickEl.innerHTML = '<i class="fas fa-check text-gray-300 text-[10px]"></i>';
                        tickEl.title = 'Sent';
                    };
                });
            };

            socket.on('messages_read', (data) => {
                const { receiver_id } = data;
                const rcvId = Number(receiver_id || data.sender_id);
                const activeId = activeContactId ? Number(activeContactId) : null;
                if (activeId && rcvId === activeId) {
                    document.querySelectorAll('.message-bubble-wrapper[data-sender-self="true"] .read-receipt')
                        .forEach(el => {
                            el.innerHTML = '<i class="fas fa-check-double text-blue-400 text-[10px]"></i>';
                            el.title = 'Read';
                        });
                };
            });

            window.addEventListener('resize', () => {
                if (window.innerWidth >= 768) {
                    const sidebar = document.getElementById('contactsSidebar');
                    const chat = document.getElementById('chatArea');
                    if (sidebar) {
                        sidebar.style.removeProperty('display');
                        sidebar.classList.remove('hidden');
                    }
                    if (chat) {
                        chat.style.removeProperty('display');
                        chat.classList.remove('hidden');
                    }
                } else {
                    if (activeContactId) {
                        showChatArea();
                    } else {
                        showContactsSidebar();
                    }
                }
            });

            window.selectContact = selectContact;
            window.showChatArea = showChatArea;
            window.handleSendMessage = handleSendMessage;
            window.filterContacts = filterContacts;
            window.showContactsSidebar = showContactsSidebar;
            window.toggleEmojiPicker = toggleEmojiPicker;
            window.toggleMsgSearch = toggleMsgSearch;
            window.markAllReadFromActive = markAllReadFromActive;
            window.deleteMsg = deleteMsg;
            window.scrollToMessage = scrollToMessage;
        })();
    </script>
    <style>
        .cursor-pointer {
            cursor: pointer;
        }

        .chat-container {
            display: flex !important;
            width: 100% !important;
            background: #ffffff !important;
            border: 1px solid #E2E8F0 !important;
            border-radius: 16px !important;
            box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -1px rgba(15, 23, 42, 0.04) !important;
            overflow: hidden !important;
            height: calc(100vh - 165px) !important;
            min-height: 560px !important;
            max-height: 840px !important;
        }

        .chat-container>.flex {
            display: flex !important;
            width: 100% !important;
            height: 100% !important;
        }

        #contactsSidebar {
            width: 360px !important;
            min-width: 300px !important;
            max-width: 380px !important;
            flex: 0 0 360px !important;
            border-right: 1px solid #E2E8F0 !important;
            display: flex !important;
            flex-direction: column !important;
