<% const headerUser=typeof user !=='undefined' ? user : null; const rolePrefixMap={ super_admin: 'superadmin' ,
    school_admin: 'schooladmin' , teacher: 'teacher' , student: 'student' , parent: 'parent' , librarian: 'librarian' ,
    driver: 'driver' }; const headerRole=headerUser && headerUser.role ? headerUser.role : '' ; const
    headerRolePrefix=headerRole ? (rolePrefixMap[headerRole] || String(headerRole).replace(/_/g, '' )) : '' ; const
    headerDashboardPath=headerRolePrefix ? `/${headerRolePrefix}/dashboard` : '/' ; const profilePathByRole={
    teacher: '/teacher/profile' , student: '/student/profile' , librarian: '/librarian/profile' ,
    driver: '/driver/profile' }; const settingsPathByRole={ super_admin: '/superadmin/settings' ,
    school_admin: '/schooladmin/settings' }; const headerProfilePath=profilePathByRole[headerRole]; const
    headerSettingsPath=settingsPathByRole[headerRole]; let defaultPlaceholder=undefined; if (headerRole==='super_admin'
    ) { defaultPlaceholder='Search schools, plans, users…' ; } else if (headerRole==='group_admin' ) {
    defaultPlaceholder='Search branches, students, teachers…' ; } else if (headerRole==='school_admin' ) {
    defaultPlaceholder='Search students, teachers, subjects…' ; } else if (headerRole==='teacher' ) {
    defaultPlaceholder='Search students, leaves, notices, homework…' ; } else if (headerRole==='student' ) {
    defaultPlaceholder='Search homework, library, notices, exams…' ; } else if (headerRole==='parent' ) {
    defaultPlaceholder='Search homework, fees, notices, attendance…' ; } else if (headerRole==='driver' ) {
    defaultPlaceholder='Search routes, students, notices…' ; } else if (headerRole==='librarian' ) {
    defaultPlaceholder='Search books, issues, racks…' ; } const displayPlaceholder=typeof searchPlaceholder
    !=='undefined' ? searchPlaceholder : defaultPlaceholder; %>
<header class="top-header">
    <div class="top-header-left">
        <button class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle sidebar">
            <i class="fas fa-bars"></i>
        </button>
        <a href="<%= headerDashboardPath %>" class="header-brand" aria-label="Go to dashboard">
            <span class="header-brand-text">SchoolSync</span>
        </a>
    </div>
    <div class="header-center">
        <% if (typeof displayPlaceholder !=='undefined' ) { %>
            <form class="header-search" action="/search" method="GET" role="search" id="globalSearchForm">
                <i class="fas fa-search" onclick="document.getElementById('globalSearchForm').submit();" style="cursor: pointer;" title="Search"></i>
                <input type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="<%= displayPlaceholder %>" id="globalSearchInput" autocomplete="off" onfocus="this.setSelectionRange(this.value.length, this.value.length)">
            </form>
        <% } %>
    </div>
    <div class="top-header-right">
        <button type="button" class="header-icon-btn theme-toggle-btn" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Switch Theme" title="Switch Theme">
            <i class="fas fa-moon" aria-hidden="true"></i>
        </button>
        <% if (typeof user !=='undefined' && user) { %>
            <% if (user.role==='driver' ) { %>
                <%- include('driverNotifications') %>
            <% } else { %>
                <%- include('notification-bell') %>
            <% } %>
        <% } %>
        <% if (typeof chatPath !=='undefined' && chatPath) { %>
            <a class="header-icon-btn" id="messageBtn" href="<%= chatPath %>" aria-label="Messages">
                <i class="fas fa-envelope"></i>
                <span class="badge-count <%= typeof unreadMessages !== 'undefined' && unreadMessages > 0 ? '' : 'hidden' %>" id="messageBadge">
                    <%= unreadMessages || 0 %>
                </span>
            </a>
        <% } %>
        <div class="header-user-dropdown" id="userDropdown">
            <div class="header-user-toggle" tabindex="0" role="button" aria-haspopup="true" aria-expanded="false">
                <div class="header-avatar">
                    <% if (typeof user !=='undefined' && user && user.image && user.image.length) { %>
                        <img src="<%= user.image %>" alt="<%= user.first_name || 'User' %>">
                    <% } else { %>
                        <span class="avatar-initials">
                            <%= typeof user !=='undefined' && user ? ((user.first_name?.[0] || '' ) + (user.last_name?.[0] || '' ) || 'U' ) : 'U' %>
                        </span>
                    <% } %>
                </div>
                <div class="header-user-info">
                    <span class="header-user-name">
                        <%= typeof user !=='undefined' && user ? (user.first_name || '' ) + ' ' + (user.last_name || '' ) : 'User' %>
                    </span>
                    <span class="header-user-role"><%= typeof user !=='undefined' && user && user.role ? user.role.replace(/_/g, ' ' ).toUpperCase() : '' %></span>
                </div>
                <i class="fas fa-chevron-down dropdown-arrow"></i>
            </div>
            <div class="header-user-menu">
                <% if (headerProfilePath) { %>
                    <a href="<%= headerProfilePath %>" class="menu-item">
                        <i class="fas fa-user"></i> My Profile
                    </a>
                <% } %>
                <% if (headerSettingsPath) { %>
                    <a href="<%= headerSettingsPath %>" class="menu-item">
                        <i class="fas fa-cog"></i> Settings
                    </a>
                <% } %>
                <% if (headerProfilePath || headerSettingsPath) { %>
                    <div class="menu-divider"></div>
                <% } %>
                <button type="button" class="menu-item theme-toggle-btn" style="width:100%;text-align:left;background:none;border:none;cursor:pointer;" onclick="toggleTheme()">
                    <i class="fas fa-moon"></i> Switch Theme
                </button>
                <div class="menu-divider"></div>
                <a href="/logout" class="menu-item text-danger">
                    <i class="fas fa-sign-out-alt"></i>Logout
                </a>
            </div>
        </div>
    </div>
</header>
<script>
    (function () {
        function moveCursorToEnd(input) {
            if (!input) return;
            const len = input.value.length;
            try {
                input.setSelectionRange(len, len);
            } catch (err) { }
        };

        document.addEventListener('keydown', function (e) {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                const searchInput = document.getElementById('globalSearchInput');
                if (searchInput) {
                    searchInput.focus();
                    moveCursorToEnd(searchInput);
                };
            };
        });

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('input[name="q"]').forEach(input => {
                input.addEventListener('focus', function () {
                    setTimeout(() => moveCursorToEnd(this), 0);
                });
            });
        });
    })();
</script>