<%
    const safeTrendValue = typeof trendValue !== 'undefined' ? trendValue : null;
    const safeTrendIcon = typeof trendIcon !== 'undefined' ? trendIcon : '▲';
    const safeTrendColor = typeof trendColor !== 'undefined' ? trendColor : 'bg-green-50 text-green-700';
    const safeIconBg = typeof iconBg !== 'undefined' ? iconBg : 'bg-blue-50';
    const safeIconColor = typeof iconColor !== 'undefined' ? iconColor : 'text-blue-600';
%>
<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 hover:-translate-y-0.5">
    <div class="flex justify-between items-start">
        <div class="flex-1">
            <div class="text-3xl font-bold text-slate-900" id="<%= id %>"><%= value %></div>
            <div class="text-xs font-medium text-slate-500 uppercase tracking-wider mt-1"><%= label %></div>
            <% if (typeof breakdown !=='undefined' && breakdown) { %>
                <div class="flex items-center gap-3 mt-2 text-xs text-slate-600"><%- breakdown %></div>
            <% } %>
            <% if (safeTrendValue) { %>
                <div class="flex items-center gap-2 mt-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold <%= safeTrendColor %>"><%= safeTrendIcon %><%= safeTrendValue %></span>
                    <span class="text-xs text-slate-500">vs last month</span>
                </div>
            <% } %>
        </div>
        <div class="w-10 h-10 rounded-xl <%= safeIconBg %> flex items-center justify-center flex-shrink-0">
            <i data-lucide="<%= icon %>" class="w-5 h-5 <%= safeIconColor %>"></i>
        </div>
    </div>
    <% if (typeof sparklineData !=='undefined' && sparklineData) { %>
        <svg class="w-full h-12 mt-4" viewBox="0 0 100 30" preserveAspectRatio="none">
            <path d="<%= typeof sparklinePath !== 'undefined' ? sparklinePath : '' %>" fill="none" stroke="<%= typeof sparklineColor !== 'undefined' ? sparklineColor : '#3B82F6' %>" stroke-width="2" stroke-linecap="round" />
        </svg>
    <% } %>
</div>