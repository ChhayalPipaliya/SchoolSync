<!DOCTYPE html>
<html lang="<%= (typeof currentLang !== 'undefined' && currentLang === 'german') ? 'de' : ((typeof currentLang !== 'undefined' && currentLang === 'portuguese') ? 'pt' : ((typeof currentLang !== 'undefined' && currentLang === 'spanish') ? 'es' : ((typeof currentLang !== 'undefined' && currentLang === 'french') ? 'fr' : ((typeof currentLang !== 'undefined' && currentLang === 'arabic') ? 'ar' : ((typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'gu' : ((typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'hi' : 'en')))))) %>" dir="<%= (typeof currentLang !== 'undefined' && currentLang === 'arabic') ? 'rtl' : 'ltr' %>" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>" class="<%= (typeof theme !== 'undefined' && theme === 'dark') ? 'dark light-mode-disabled' : '' %>">
<head>
    <%- include('../partials/head', { title: typeof title !=='undefined' ? title + ' | SchoolSync' : ((typeof lan !=='undefined' && lan && lan.Teacher_Portal) ? lan.Teacher_Portal : 'Teacher Portal' ) + ' | SchoolSync' , needsCharts: typeof needsCharts !=='undefined' ? needsCharts : false }) %>
</head>
<body class="teacher-theme">
    <div class="app-wrapper">
        <%- include('../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
        <main class="main-panel" id="mainPanel">
            <%- include('../partials/header') %>
            <%- include('../partials/flashMessages') %>
            <div class="page-body">
                <%- body %>
            </div>
            <%- include('../partials/footer') %>
        </main>
    </div>
</body>
</html>