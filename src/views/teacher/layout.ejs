<!DOCTYPE html>
<html lang="<%= (typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'gu' : ((typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'hi' : 'en') %>" data-theme="light">
<head>
  <%- include('../partials/head', {
    title: typeof title !== 'undefined' ? title + ' | SchoolSync' : ((typeof lan !== 'undefined' && lan && lan.Teacher_Portal) ? lan.Teacher_Portal : 'Teacher Portal') + ' | SchoolSync',
    needsCharts: typeof needsCharts !== 'undefined' ? needsCharts : false
  }) %>
</head>
<body class="teacher-theme">
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header') %>
    <%- include('../partials/flashMessages') %>
    <div class="page-body">
      <%- body %>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>
</body>
</html>