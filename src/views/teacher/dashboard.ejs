                        <div style="font-size:13px;font-weight:700;color:#475569;">No Class Assigned as Class Teacher</div>
                        <div style="font-size:12px;margin-top:4px;">Attendance overview is available for assigned class teachers.</div>
                    </div>
                <% } %>
            </div>
