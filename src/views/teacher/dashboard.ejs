                                <div style="font-size:12px;color:#64748b;margin-top:4px;">Class 1 - A</div>
                            </div>
                            <div class="t-hw-footer">
                                <span>Submissions: <strong>112 / 126</strong></span>
                                <a href="/teacher/homework" style="color:#4f46e5;font-weight:700;text-decoration:none;">Details →</a>
