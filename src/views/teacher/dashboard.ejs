                                        <i class="fas fa-check-circle"></i> Today Completed (<%= completedWorkDays %>/<%= totalWorkDays %> Days Marked)
                                    </span>
                                <% } else { %>
                                    <span style="background:#f1f5f9;color:#64748b;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;">
                                        <i class="fas fa-umbrella-beach"></i> Non-Working Day
                                    </span>
                                <% } %>
