                                    </span>
                                    <span style="background:#ede9fe;color:#6d28d9;padding:6px 12px;border-radius:10px;font-weight:700;font-size:12px;">
                                        <i class="fas fa-user-clock"></i> <%= countLeave %> On Leave
                                    </span>
                                <% } %>
