<%
    const listClasses = typeof myClasses !== 'undefined' && myClasses ? myClasses : [];
    const listSchedule = typeof todaySchedule !== 'undefined' && todaySchedule ? todaySchedule : [];
    const listHomework = typeof recentHomework !== 'undefined' && recentHomework ? recentHomework : [];
    const listNotices = typeof notices !== 'undefined' && notices ? notices : [];
    const classTeacherClass = typeof attendanceClass !== 'undefined' ? attendanceClass : null;
    const classTeacherLabel = typeof myClassLabel !== 'undefined' ? myClassLabel : 'Not assigned';
    const attendanceLabels = typeof attLabels !== 'undefined' && attLabels ? attLabels : [];
    
    const countStudents = typeof totalStudents !== 'undefined' ? totalStudents : 0;
    const countPendingHw = typeof pendingHomework !== 'undefined' ? pendingHomework : 0;
    const averageAtt = typeof avgAttendance !== 'undefined' ? avgAttendance : 0;
    const countPresent = typeof presentStudentsCount !== 'undefined' ? presentStudentsCount : 0;
    const countAbsent = typeof absentStudentsCount !== 'undefined' ? absentStudentsCount : 0;
    const countLeave = typeof leaveStudentsCount !== 'undefined' ? leaveStudentsCount : 0;
    const completedWorkDays = typeof completedWorkingDaysCount !== 'undefined' ? completedWorkingDaysCount : 0;
    const totalWorkDays = typeof totalWorkingDaysCount !== 'undefined' ? totalWorkingDaysCount : 0;
    const pendingWorkDays = typeof pendingWorkingDaysCount !== 'undefined' ? pendingWorkingDaysCount : 0;
    const attStatus = typeof todayAttendanceStatus !== 'undefined' ? todayAttendanceStatus : 'holiday';
    const examsCount = typeof examsThisWeekRows !== 'undefined' && examsThisWeekRows ? examsThisWeekRows.length : 0;
    const leavesCount = typeof leaveRequestsCount !== 'undefined' ? leaveRequestsCount : 0;
    const bdaysList = typeof birthdaysToday !== 'undefined' && birthdaysToday ? birthdaysToday : [];
    const eventsList = typeof upcomingEvents !== 'undefined' && upcomingEvents ? upcomingEvents : [];
    const examsList = typeof examsThisWeekRows !== 'undefined' && examsThisWeekRows ? examsThisWeekRows : [];
%>

<style>
    :root {
        --primary-blue: #3b82f6;
        --primary-purple: #7c3aed;
        --primary-gradient: linear-gradient(135deg, #3b82f6 0%, #6366f1 50%, #7c3aed 100%);
        --bg-canvas: #f8fafc;
        --card-bg: #ffffff;
        --border-subtle: #e2e8f0;
        --border-hover: #cbd5e1;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
        --shadow-md: 0 10px 30px -10px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.03);
        --shadow-lg: 0 20px 40px -15px rgba(15, 23, 42, 0.12);
    }

    [data-theme="dark"],
    html[data-theme="dark"],
    html.dark {
        --bg-canvas: #0B0F19;
        --card-bg: #151D30;
        --border-subtle: #242F4D;
        --border-hover: #334155;
        --text-main: #F1F5F9;
        --text-muted: #94A3B8;
    }
    [data-theme="dark"] .t-sched-item {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .t-sched-item:hover {
        background: #1E293B !important;
        border-color: #334155 !important;
    }
    [data-theme="dark"] .t-alert-banner {
        background: #450A0A !important;
        border-color: #991B1B !important;
    }
    [data-theme="dark"] .t-alert-title {
        color: #FCA5A5 !important;
    }
    [data-theme="dark"] .t-alert-sub {
        color: #FECACA !important;
    }
    [data-theme="dark"] .t-stat-card,
    [data-theme="dark"] .t-panel {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }

    .t-dash-container {
        display: flex;
        flex-direction: column;
        gap: 15px;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--text-main);
    }

    .t-hero-card {
        background: var(--primary-gradient);
        border-radius: 24px;
        padding: 10px 12px;
        color: #ffffff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 50px -15px rgba(99, 102, 241, 0.4);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .t-hero-card::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 240px; height: 240px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        pointer-events: none;
    }
    .t-hero-card::after {
        content: '';
        position: absolute;
        bottom: -80px; right: 140px;
        width: 200px; height: 200px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        pointer-events: none;
    }
    .t-hero-left {
        position: relative;
        z-index: 2;
        max-width: 680px;
    }
    .t-hero-date-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 14px;
    }
    .t-hero-title {
        font-size: 30px;
        font-weight: 800;
        margin: 0 0 8px 0;
        letter-spacing: -0.02em;
    }
    .t-hero-subtitle {
        font-size: 14px;
        opacity: 0.9;
        margin: 0 0 22px 0;
        line-height: 1.5;
    }
    .t-hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    .t-hero-btn {
        background: #ffffff;
        color: #4f46e5;
        padding: 10px 18px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .t-hero-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        color: #4338ca;
    }
    .t-hero-btn.outline {
        background: rgba(255, 255, 255, 0.15);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .t-hero-btn.outline:hover {
        background: rgba(255, 255, 255, 0.28);
    }
    .t-hero-right {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .t-hero-badges-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        background: rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 18px;
        padding: 18px;
        min-width: 320px;
    }
    .t-hero-chip {
        text-align: center;
    }
    .t-hero-chip-val {
        font-size: 20px;
        font-weight: 800;
        display: block;
        line-height: 1;
    }
    .t-hero-chip-lbl {
        font-size: 10px;
        opacity: 0.85;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 4px;
        display: block;
    }

    .t-alert-banner {
        background: #fef2f2;
        border: 1.5px solid #fca5a5;
        border-radius: 16px;
        padding: 12px 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        box-shadow: 0 4px 16px rgba(239, 68, 68, 0.08);
    }
    .t-alert-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .t-alert-icon {
        width: 44px; height: 44px;
        border-radius: 12px;
        background: #ef4444;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }
    .t-alert-title { margin: 0; font-size: 15px; font-weight: 800; color: #991b1b; }
    .t-alert-sub { margin: 2px 0 0; font-size: 12px; color: #b91c1c; font-weight: 500; }
    .t-alert-btn {
        background: #dc2626;
        color: #fff;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        transition: background 0.2s;
    }
    .t-alert-btn:hover { background: #b91c1c; }

    .t-analytics-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 16px;
    }
    .t-stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 18px;
        padding: 10px 10px;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .t-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: var(--border-hover);
    }
    .t-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .t-stat-icon {
        width: 38px; height: 38px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .t-stat-icon.blue { background: #dbeafe; color: #1d4ed8; }
    .t-stat-icon.indigo { background: #e0e7ff; color: #4338ca; }
    .t-stat-icon.emerald { background: #d1fae5; color: #047857; }
    .t-stat-icon.amber { background: #fef3c7; color: #b45309; }
    .t-stat-icon.violet { background: #ede9fe; color: #6d28d9; }
    .t-stat-icon.rose { background: #ffe4e6; color: #be123c; }

    .t-stat-num {
        font-size: 24px;
        font-weight: 800;
        color: var(--text-main);
        line-height: 1;
    }
    .t-stat-lbl {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
    }

    .t-main-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 15px;
    }
    .t-left-col {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    .t-right-col {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .t-panel {
        background: var(--card-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 20px;
        padding: 10px 10px;
        box-shadow: var(--shadow-sm);
    }
    .t-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }
    .t-panel-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
    }
    .t-panel-title i { color: #6366f1; }
    .t-panel-link {
        font-size: 12px;
        font-weight: 700;
        color: #4f46e5;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .t-panel-link:hover { text-decoration: underline; }

    .t-schedule-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        position: relative;
    }
    .t-schedule-list::before {
        content: '';
        position: absolute;
        top: 10px; bottom: 10px; left: 19px;
        width: 2px;
        background: #e2e8f0;
        z-index: 1;
    }
    .t-sched-item {
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        z-index: 2;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 14px 18px;
        transition: background 0.15s, border-color 0.15s;
    }
    .t-sched-item:hover {
        background: #ffffff;
        border-color: #cbd5e1;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }
    .t-sched-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 3px #6366f1;
        background: #6366f1;
        flex-shrink: 0;
    }
    .t-sched-dot.ongoing { box-shadow: 0 0 0 3px #10b981; background: #10b981; }
    .t-sched-dot.completed { box-shadow: 0 0 0 3px #94a3b8; background: #94a3b8; }

    .t-sched-body {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .t-sched-sub {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-main);
    }
    .t-sched-meta {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .t-sched-badge {
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }
    .t-sched-badge.ongoing { background: #d1fae5; color: #047857; }
    .t-sched-badge.upcoming { background: #e0e7ff; color: #4338ca; }
    .t-sched-badge.completed { background: #f1f5f9; color: #64748b; }

    .t-hw-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }
    .t-hw-card {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        transition: background 0.15s, border-color 0.15s;
    }
    .t-hw-card:hover {
        background: #ffffff;
        border-color: #cbd5e1;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }
    .t-hw-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    .t-hw-subject {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6366f1;
    }
    .t-hw-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-main);
        margin-top: 2px;
    }
    .t-hw-due {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
    }
    .t-hw-due.soon { background: #fef3c7; color: #b45309; }
    .t-hw-due.ok { background: #e0e7ff; color: #4338ca; }
    .t-hw-due.passed { background: #fee2e2; color: #b91c1c; }

    .t-hw-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid #e2e8f0;
        padding-top: 10px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .t-att-wrapper {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 20px;
        align-items: center;
    }
    .t-att-ring-box {
        text-align: center;
        position: relative;
    }
    .t-att-ring-center {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
    }
    .t-att-ring-pct {
        font-size: 26px;
        font-weight: 900;
        color: var(--text-main);
        line-height: 1;
    }
    .t-att-ring-lbl {
        font-size: 10px;
        font-weight: 600;
        color: var(--text-muted);
    }

    .t-activity-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .t-act-item {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13px;
        padding: 8px 0;
        border-bottom: 1px solid #f1f5f9;
    }
    .t-act-item:last-child { border-bottom: none; }
    .t-act-icon {
        width: 32px; height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
    }
    .t-act-text { flex: 1; color: #334155; }
    .t-act-text strong { color: var(--text-main); }
    .t-act-time { font-size: 11px; color: var(--text-muted); white-space: nowrap; }

    .t-checklist {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .t-check-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
        padding: 12px 14px;
        font-size: 13px;
        font-weight: 600;
    }
    .t-check-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .t-check-box {
        width: 18px; height: 18px;
        border-radius: 5px;
        border: 2px solid #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }
    .t-check-box.checked {
        background: #10b981;
        border-color: #10b981;
        color: #fff;
        font-size: 10px;
    }

    .t-widget-card {
        background: var(--card-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 18px;
        padding: 10px 10px;
        box-shadow: var(--shadow-sm);
    }
    .t-widget-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 14px;
        font-weight: 700;
        color: var(--text-main);
    }

    .t-notice-mini {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .t-notice-item {
        background: #f8fafc;
        border-radius: 10px;
        padding: 10px 12px;
        border-left: 3px solid #6366f1;
    }
    .t-notice-item-title { font-size: 12px; font-weight: 700; color: var(--text-main); }
    .t-notice-item-sub { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

    .t-qa-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }
    .t-qa-btn {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 16px;
        text-align: center;
        text-decoration: none;
        color: var(--text-main);
        font-size: 12px;
        font-weight: 700;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        transition: transform 0.2s, background 0.2s;
    }
    .t-qa-btn:hover {
        transform: translateY(-2px);
        background: #ffffff;
        box-shadow: var(--shadow-md);
    }
    .t-qa-btn i {
        font-size: 20px;
    }

    @media (max-width: 1200px) {
        .t-analytics-grid { grid-template-columns: repeat(3, 1fr); }
        .t-main-layout { grid-template-columns: 1fr; }
        .t-hero-card { flex-direction: column; align-items: flex-start; gap: 20px; }
        .t-hero-badges-grid { width: 100%; }
    }
    @media (max-width: 768px) {
        .t-analytics-grid { grid-template-columns: repeat(2, 1fr); }
        .t-hw-grid { grid-template-columns: 1fr; }
        .t-att-wrapper { grid-template-columns: 1fr; }
        .t-qa-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
<div class="t-dash-container reveal">
    <section class="t-hero-card" aria-label="Welcome Banner">
        <div class="t-hero-left">
            <div class="t-hero-date-badge">
                <i class="fas fa-calendar-alt"></i>
                <span id="currentDateText">Tuesday, 28 July 2026</span>
            </div>
            <h1 class="t-hero-title">
                Good <%= new Date().getHours() < 12 ? 'Morning' : new Date().getHours() < 17 ? 'Afternoon' : 'Evening' %>, <%= (typeof user !== 'undefined' && user && user.first_name) ? user.first_name : 'Ketan' %> 👋
            </h1>
            <p class="t-hero-subtitle">
                Welcome back to <strong>SchoolSync Teacher Panel</strong>. Here is your classroom overview for today.
            </p>
            <div class="t-hero-actions">
                <a href="/teacher/attendance" class="t-hero-btn">
                    <i class="fas fa-calendar-check"></i> Take Attendance
                </a>
                <a href="/teacher/homework" class="t-hero-btn outline">
                    <i class="fas fa-plus-circle"></i> Add Homework
                </a>
                <a href="/teacher/marks" class="t-hero-btn outline">
                    <i class="fas fa-pen-nib"></i> Enter Marks
                </a>
                <a href="/teacher/notices" class="t-hero-btn outline">
                    <i class="fas fa-bullhorn"></i> View Notices
                </a>
            </div>
        </div>
        <div class="t-hero-right" style="display:flex;flex-direction:column;align-items:flex-end;gap:12px;">
            <%- include('../partials/hero-illustration', { illustrationSrc: '/illustrations/teacher.png', illustrationAlt: 'Teacher Dashboard' }) %>
            <div class="t-hero-badges-grid">
                <div class="t-hero-chip">
                    <span class="t-hero-chip-val"><%= listSchedule.length %></span>
                    <span class="t-hero-chip-lbl">Today's Classes</span>
                </div>
                <div class="t-hero-chip">
                    <span class="t-hero-chip-val"><%= countStudents %></span>
                    <span class="t-hero-chip-lbl">Students</span>
                </div>
                <div class="t-hero-chip">
                    <span class="t-hero-chip-val"><%= averageAtt %>%</span>
                    <span class="t-hero-chip-lbl">Attendance</span>
                </div>
                <div class="t-hero-chip">
                    <span class="t-hero-chip-val"><%= countPendingHw %></span>
                    <span class="t-hero-chip-lbl">Hw Pending</span>
                </div>
                <div class="t-hero-chip">
                    <span class="t-hero-chip-val"><%= listNotices.length %></span>
                    <span class="t-hero-chip-lbl">Notices</span>
                </div>
                <div class="t-hero-chip">
                    <span class="t-hero-chip-val"><%= examsCount %></span>
                    <span class="t-hero-chip-lbl">Exams</span>
                </div>
            </div>
        </div>
    </section>
