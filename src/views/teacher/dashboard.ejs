<%
  // Resolve teacher stats and list variables defensively
  const listClasses = typeof myClasses !== 'undefined' && myClasses ? myClasses : [];
  const listSchedule = typeof todaySchedule !== 'undefined' && todaySchedule ? todaySchedule : [];
  const listHomework = typeof recentHomework !== 'undefined' && recentHomework ? recentHomework : [];
  const listNotices = typeof notices !== 'undefined' && notices ? notices : [];
  
  const countStudents = typeof totalStudents !== 'undefined' ? totalStudents : 0;
  const countPendingHw = typeof pendingHomework !== 'undefined' ? pendingHomework : 0;
  const averageAtt = typeof avgAttendance !== 'undefined' ? avgAttendance : 0;
%>
    <div class="page-body">

      <div class="teacher-welcome reveal">
        <div style="position:relative;z-index:1;">
          <h2>Good <%= new Date().getHours() < 12 ? 'Morning' : new Date().getHours() < 17 ? 'Afternoon' : 'Evening' %>, <%= (typeof user !== 'undefined' && user && user.first_name) ? user.first_name : 'Teacher' %>! 👋</h2>
          <p id="currentDate" style="opacity:0.85;font-size:13px;margin-top:5px;"></p>
          <div style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap;">
            <% if (listClasses.length > 0) { %>
              <a href="/teacher/attendance" class="welcome-action-btn">
                <i class="fas fa-calendar-check"></i> Mark Attendance
              </a>
            <% } %>
            <a href="/teacher/homework" class="welcome-action-btn">
              <i class="fas fa-book-open"></i> Homework
            </a>
            <a href="/teacher/notices" class="welcome-action-btn">
              <i class="fas fa-bullhorn"></i> Notices
            </a>
          </div>
        </div>
        <div class="teacher-welcome-icon">📚</div>
      </div>

      <div class="stats-row reveal reveal-delay-1">
        <div class="stat-card">
          <div style="display:flex;align-items:center;gap:14px;">
            <div class="stat-icon" style="background:#EEF2FF;color:#4F46E5;">
              <i class="fas fa-chalkboard"></i>
            </div>
            <div>
              <div class="stat-label">My Classes</div>
              <div class="stat-value" data-target="<%= listClasses.length %>">
                <%= listClasses.length %>
              </div>
            </div>
          </div>
        </div>
        <div class="stat-card">
          <div style="display:flex;align-items:center;gap:14px;">
            <div class="stat-icon" style="background:#D1FAE5;color:#059669;">
              <i class="fas fa-users"></i>
            </div>
            <div>
              <div class="stat-label">Total Students</div>
              <div class="stat-value" data-target="<%= countStudents %>">
                <%= countStudents %>
              </div>
            </div>
          </div>
        </div>
        <div class="stat-card">
          <div style="display:flex;align-items:center;gap:14px;">
            <div class="stat-icon" style="background:#FEF3C7;color:#D97706;">
              <i class="fas fa-book-open"></i>
            </div>
            <div>
              <div class="stat-label">Homework Pending</div>
              <div class="stat-value" data-target="<%= countPendingHw %>">
                <%= countPendingHw %>
              </div>
            </div>
          </div>
        </div>
        <div class="stat-card">
          <div style="display:flex;align-items:center;gap:14px;">
            <div class="stat-icon" style="background:#EEF2FF;color:#4F46E5;">
              <i class="fas fa-chart-pie"></i>
            </div>
            <div>
              <div class="stat-label">Avg Attendance</div>
              <div class="stat-value">
                <%= averageAtt %>%
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="dashboard-row dashboard-row-half reveal reveal-delay-2">
        <div class="card">
          <div class="card-header-row">
            <div class="card-title">
              <i class="fas fa-calendar-day"></i> Today's Schedule
            </div>
            <a href="/teacher/timetable" style="font-size:12px;color:#4F46E5;font-weight:600;text-decoration:none;">
              View All <i class="fas fa-arrow-right" style="font-size:10px;"></i>
            </a>
          </div>
          <% const todayDay = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][new Date().getDay()]; %>
          <% if (listSchedule.length > 0) { %>
            <% listSchedule.forEach(period => { %>
              <div class="class-card">
                <div>
                  <div class="class-name"><%= period.subject || '—' %></div>
                  <div class="class-section">
                    <i class="fas fa-clock" style="font-size:10px;margin-right:3px;color:#94A3B8;"></i>
                    <%= period.startTime || '' %> – <%= period.endTime || '' %>
                    &nbsp;·&nbsp; Room <%= period.room || '—' %>
                  </div>
                </div>
                <div class="class-count">
                  <i class="fas fa-users" style="font-size:10px;margin-right:3px;"></i>
                  <%= period.studentCount || 0 %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state" style="padding:32px;">
              <i class="fas fa-calendar-times"></i>
              <p>No classes today.</p>
            </div>
          <% } %>
        </div>
        <div class="card">
          <div class="card-header-row">
            <div class="card-title">
              <i class="fas fa-pencil-alt"></i> Recent Homework
            </div>
            <a href="/teacher/homework" style="font-size:12px;color:#4F46E5;font-weight:600;text-decoration:none;display:flex;align-items:center;gap:4px;">
              <i class="fas fa-plus"></i> Add
            </a>
          </div>
          <% if (listHomework.length > 0) { %>
            <% listHomework.slice(0, 5).forEach(hw => { %>
              <% const due = hw.dueDate || hw.due_date ? new Date(hw.dueDate || hw.due_date) : null; const diff = due ? Math.ceil((due - new Date()) / 86400000) : 999; %>
              <div class="hw-card">
                <div class="hw-card-header">
                  <div>
                    <div class="hw-title"><%= hw.title %></div>
                    <div class="hw-subject"><%= hw.subject %> · Class <%= hw.class %></div>
                  </div>
                  <% if (due && !isNaN(due.getTime())) { %>
                    <span class="hw-due hw-due-<%= diff < 0 ? 'passed' : diff <= 2 ? 'soon' : 'ok' %>">
                      <i class="fas fa-calendar" style="font-size:10px;margin-right:3px;"></i>
                      <%= diff < 0 ? 'Overdue' : diff === 0 ? 'Today' : due.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                    </span>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state" style="padding:28px;">
              <i class="fas fa-book"></i>
              <p>No homework assigned recently.</p>
            </div>
          <% } %>
        </div>
      </div>
      <div class="dashboard-row dashboard-row-3-2 reveal reveal-delay-3">
        <div class="card">
          <div class="card-title" style="margin-bottom:18px;">
            <i class="fas fa-chart-bar"></i> Attendance Overview
          </div>
          <div style="height:220px;">
            <canvas id="attendanceChart"
              data-labels='<%- JSON.stringify(typeof attLabels !== "undefined" && attLabels ? attLabels : []) %>'
              data-present='<%- JSON.stringify(typeof attPresent !== "undefined" && attPresent ? attPresent : []) %>'
              data-absent='<%- JSON.stringify(typeof attAbsent !== "undefined" && attAbsent ? attAbsent : []) %>'>
            </canvas>
          </div>
        </div>
        <div class="card">
          <div class="card-header-row">
            <div class="card-title">
              <i class="fas fa-chalkboard"></i> My Classes
            </div>
          </div>
          <% if (listClasses.length > 0) { %>
            <% listClasses.forEach(cls => { %>
              <a href="/teacher/attendance?classId=<%= cls.id %>" style="text-decoration:none;">
                <div class="class-card">
                  <div>
                    <div class="class-name"><%= cls.name || cls.className %><%= cls.section ? ' – ' + cls.section : '' %></div>
                    <div class="class-section"><%= cls.subject || '' %></div>
                  </div>
                  <div class="class-count">
                    <i class="fas fa-users" style="font-size:10px;margin-right:3px;"></i>
                    <%= cls.studentCount || 0 %>
                  </div>
                </div>
              </a>
            <% }) %>
          <% } else { %>
            <div class="empty-state" style="padding:24px;">
              <i class="fas fa-chalkboard"></i>
              <p>No classes assigned yet. Please contact school admin.</p>
            </div>
          <% } %>
      </div>
      <div class="dashboard-row dashboard-row-full reveal reveal-delay-4" style="margin-top: 20px; margin-bottom: 20px;">
        <div class="card">
          <div class="card-title" style="margin-bottom:18px;">
            <i class="fas fa-chart-bar" style="color:#4F46E5;"></i> Homework Completion Statistics
          </div>
          <div style="height:250px; position:relative;">
            <canvas id="homeworkStatsChart"
              data-labels='<%- JSON.stringify(typeof hwLabels !== "undefined" && hwLabels ? hwLabels : []) %>'
              data-completed='<%- JSON.stringify(typeof hwCompleted !== "undefined" && hwCompleted ? hwCompleted : []) %>'
              data-pending='<%- JSON.stringify(typeof hwPending !== "undefined" && hwPending ? hwPending : []) %>'>
            </canvas>
          </div>
        </div>
      </div>
      <% if (listNotices.length > 0) { %>
        <div class="card reveal" style="margin-bottom:20px;">
          <div class="card-header-row">
            <div class="card-title">
              <i class="fas fa-bullhorn"></i> Notices
            </div>
            <a href="/teacher/notices" style="font-size:12px;color:#4F46E5;font-weight:600;text-decoration:none;">
              <i class="fas fa-plus me-1"></i>Add
            </a>
          </div>
          <% listNotices.slice(0, 3).forEach(n => { %>
            <div class="notice-item">
              <div class="notice-title"><%= n.title %></div>
              <div class="notice-date"><%= n.createdAt || n.created_at ? new Date(n.createdAt || n.created_at).toLocaleDateString('en-IN') : '' %></div>
              <% if (n.message) { %>
                <div class="notice-body"><%= n.message.substring(0, 150) %><%= n.message.length > 150 ? '…' : '' %></div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
<script src="/js/charts.js"></script>
<script src="/js/teacher.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('currentDate');
    const update = () => {
      if(el) el.textContent = new Date().toLocaleDateString('en-IN', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
      });
    };
    update();
    setInterval(update, 60000);

    document.querySelectorAll('[data-target]').forEach(el => {
      const target = parseInt(el.dataset.target, 10);
      if (isNaN(target) || target === 0) return;
      let start = 0;
      const step = Math.ceil(target / 30);
      const interval = setInterval(() => {
        start += step;
        if (start >= target) { el.textContent = target; clearInterval(interval); }
        else el.textContent = start;
      }, 40);
    });

    (function() {
      const canvas = document.getElementById('homeworkStatsChart');
      if (!canvas) return;
      const labels = JSON.parse(canvas.dataset.labels || '[]');
      const completed = JSON.parse(canvas.dataset.completed || '[]');
      const pending = JSON.parse(canvas.dataset.pending || '[]');

      if (labels.length === 0) {
        canvas.parentNode.innerHTML = `<div class="empty-state" style="padding:40px;"><i class="fas fa-book"></i><p>No recent homework data available</p></div>`;
        return;
      }

      new Chart(canvas, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Done ✅',
              data: completed,
              backgroundColor: '#059669',
              borderRadius: 4
            },
            {
              label: 'Pending ❌',
              data: pending,
              backgroundColor: '#DC2626',
              borderRadius: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { stacked: true, grid: { display: false } },
            y: { stacked: true, beginAtZero: true, grid: { color: '#F1F5F9' }, ticks: { stepSize: 1 } }
          },
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 12 } }
          }
        }
      });
    })();
  });
</script>
