                                            <span class="t-hw-due <%= diff < 0 ? 'passed' : diff <= 2 ? 'soon' : 'ok' %>">
                                                <%= diff < 0 ? 'Overdue' : diff === 0 ? 'Due Today' : due.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                                            </span>
                                        <% } %>
                                    </div>
                                    <div class="t-hw-title"><%= hw.title %></div>
                                    <div style="font-size:12px;color:#64748b;margin-top:4px;">Class <%= hw.class || classTeacherLabel %></div>
                                </div>
                                <div class="t-hw-footer">
                                    <span>Submissions: <strong><%= hw.submittedCount || 0 %> / <%= countStudents %></strong></span>
                                    <a href="/teacher/homework" style="color:#4f46e5;font-weight:700;text-decoration:none;">Details →</a>
                                </div>
