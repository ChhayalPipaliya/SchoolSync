                            <div style="display:flex;gap:12px;margin-bottom:14px;flex-wrap:wrap;">
                                <% if (attStatus === 'pending') { %>
                                    <span style="background:#fff7ed;color:#c2410c;padding:6px 12px;border-radius:10px;font-weight:700;font-size:12px;">
                                        <i class="fas fa-clock"></i> Today's Entry Pending
                                    </span>
                                    <a href="/teacher/attendance" style="background:#ea580c;color:#ffffff;padding:6px 14px;border-radius:10px;font-weight:700;font-size:12px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
                                        <i class="fas fa-calendar-check"></i> Mark Today's Attendance
                                    </a>
                                <% } else if (attStatus === 'holiday') { %>
