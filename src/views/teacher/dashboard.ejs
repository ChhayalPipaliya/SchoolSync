                                <% } else if (attStatus === 'completed') { %>
                                    <strong>Working Days:</strong> <%= completedWorkDays %> of <%= totalWorkDays %> working days completed this month.
                                <% } else { %>
                                    <strong>Working Days:</strong> <%= completedWorkDays %> of <%= totalWorkDays %> working days completed this month (Today is a non-working day).
                                <% } %>
