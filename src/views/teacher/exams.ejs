    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div>
            <h2 style="font-size: 22px; font-weight: 700; color: #1E293B; margin: 0;"><i class="fa-solid fa-calendar-alt me-2" style="color: var(--primary);"></i>My Exam Schedule</h2>
            <div style="font-size: 12px; color: #94A3B8; margin-top: 4px;"><%= exams.length %> exam(s) assigned to your classes</div>
        </div>
        <a href="/teacher/marks" class="btn btn-success">
            <i class="fa-solid fa-pen me-1"></i> Enter Marks
        </a>
    </div>

    <% if (exams.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
            <% exams.forEach(e => {
                const typeLabel = { unit_test:'Unit Test', mid_term:'Mid Term', final:'Final', quiz:'Quiz', oral:'Oral', practical:'Practical' }[e.exam_type] || e.exam_type || 'Exam';
                const termLabel = { first_term:'Term 1', mid_term:'Term 2', final_term:'Final Term', annual:'Annual' }[e.term] || e.term || '';
                const startDate = e.start_date ? new Date(e.start_date).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) : 'TBD';
                const endDate = e.end_date ? new Date(e.end_date).toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) : null;
                const today = new Date();
                const start = e.start_date ? new Date(e.start_date) : null;
                const end = e.end_date ? new Date(e.end_date) : null;
                let statusLabel = 'Upcoming';
                let statusBadge = 'badge-info';
                if (start && today >= start && (!end || today <= end)) {
                    statusLabel = 'Ongoing'; statusBadge = 'badge-warning';
                } else if (end && today > end) {
                    statusLabel = 'Completed'; statusBadge = 'badge-success';
                }
            %>
            <div class="card h-100 p-3">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px;">
                    <div style="flex: 1;">
                        <div style="font-size: 15px; font-weight: 700; color: #1E293B; line-height: 1.3;"><%= e.name %></div>
                        <div style="font-size: 12px; color: #94A3B8; margin-top: 3px;"><%= e.class_name %> &mdash; Sec <%= e.section %></div>
                    </div>
                    <span class="badge <%= statusBadge %>" style="white-space: nowrap; margin-left: 8px;">
                        <%= statusLabel %>
                    </span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; font-size: 12px;">
                    <div>
                        <div style="color: #94A3B8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; font-size: 10px;">Type</div>
                        <div style="color: #1E293B; font-weight: 600; margin-top: 2px;"><%= typeLabel %></div>
                    </div>
                    <div>
                        <div style="color: #94A3B8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; font-size: 10px;">Term</div>
                        <div style="color: #1E293B; font-weight: 600; margin-top: 2px;"><%= termLabel %></div>
                    </div>
                    <div>
                        <div style="color: #94A3B8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; font-size: 10px;">Date</div>
                        <div style="color: #1E293B; font-weight: 600; margin-top: 2px;"><%= startDate %><% if (endDate) { %> – <%= endDate %><% } %></div>
                    </div>
                    <div>
                        <div style="color: #94A3B8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; font-size: 10px;">Max / Pass</div>
                        <div style="color: #1E293B; font-weight: 600; margin-top: 2px;"><%= e.max_marks %> / <span style="color: #10B981;"><%= e.pass_marks %></span></div>
                    </div>
                </div>

                <% if (e.total_marked > 0) { %>
                    <div style="font-size: 11px; color: #64748B; margin-bottom: 12px; background: #F8FAFC; border-radius: 8px; padding: 8px 12px;">
                        <i class="fa-solid fa-check-circle me-1" style="color: #10B981;"></i><%= e.total_marked %> student marks entered
                    </div>
                <% } %>

                <a href="/teacher/marks?examId=<%= e.id %>&classId=<%= e.class_id %>" class="btn btn-primary w-100 mt-auto">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Enter Marks
                </a>
            </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-state">
            <i class="fa-solid fa-calendar-xmark"></i>
            <p>No exams scheduled for your classes</p>
            <p style="font-size: 12px; color: #94A3B8; margin-top: 6px;">Contact school admin to assign exams</p>
        </div>
    <% } %>
