<!-- ===== TEACHER PROFILE — MODERN SAAS REDESIGN ===== -->
<style>
  /* ── IMPORT GOOGLE FONT ── */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

  :root {
    --tp-bg:            #f1f5f9;
    --tp-surface:       #ffffff;
    --tp-card:          #f8fafc;
    --tp-border:        rgba(99,130,180,0.18);
    --tp-accent:        #6366f1;
    --tp-accent2:       #8b5cf6;
    --tp-teal:          #0d9488;
    --tp-amber:         #d97706;
    --tp-rose:          #e11d48;
    --tp-emerald:       #059669;
    --tp-text:          #1e293b;
    --tp-muted:         #64748b;
    --tp-radius:        16px;
    --tp-shadow:        0 8px 32px rgba(99,130,180,0.15);
    --tp-shadow-sm:     0 4px 16px rgba(99,130,180,0.10);
    --tp-glow:          0 0 40px rgba(99,102,241,0.08);
    --tp-transition:    all 0.3s cubic-bezier(0.4,0,0.2,1);
  }

  .tp-wrapper { font-family:'Inter',sans-serif; padding:0 0 3rem; color:var(--tp-text); }

  /* ── HERO HEADER CARD ── */
  .tp-hero {
    background: linear-gradient(135deg, #ffffff 0%, #f0f4ff 60%, #eef2ff 100%);
    border: 1px solid var(--tp-border);
    border-radius: var(--tp-radius);
    padding: 2.5rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--tp-shadow), var(--tp-glow);
    position: relative;
    overflow: hidden;
  }
  .tp-hero::before {
    content:'';
    position:absolute; top:-60px; right:-60px;
    width:260px; height:260px;
    background: radial-gradient(circle, rgba(99,102,241,0.10) 0%, transparent 70%);
    border-radius:50%;
    pointer-events:none;
  }
  .tp-hero::after {
    content:'';
    position:absolute; bottom:-80px; left:-40px;
    width:200px; height:200px;
    background: radial-gradient(circle, rgba(13,148,136,0.08) 0%, transparent 70%);
    border-radius:50%;
    pointer-events:none;
  }

  .tp-hero-inner { position:relative; z-index:1; display:flex; flex-direction:row; gap:24px; }
  @media (max-width: 991px) {
    .tp-hero-inner { flex-direction:column; }
  }

  /* Avatar */
  .tp-avatar-wrap {
    position: relative;
    width: 120px; height: 120px;
    flex-shrink: 0;
  }
  .tp-avatar-wrap img {
    width: 120px; height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(99,102,241,0.4);
    box-shadow: 0 0 0 4px rgba(99,102,241,0.10), var(--tp-shadow-sm);
  }
  .tp-avatar-status {
    position: absolute; bottom: 6px; right: 6px;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--tp-emerald);
    border: 3px solid #ffffff;
    box-shadow: 0 0 8px rgba(5,150,105,0.5);
  }
  .tp-avatar-status.inactive { background: var(--tp-rose); box-shadow: 0 0 8px rgba(225,29,72,0.4); }

  /* Hero info */
  .tp-teacher-name { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.35rem; }
  .tp-emp-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(99,102,241,0.10); border: 1px solid rgba(99,102,241,0.25);
    color: #4f46e5; border-radius: 100px; padding: 3px 12px; font-size: 0.78rem; font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .tp-subject-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 0.6rem; }
  .tp-subject-badge {
    background: rgba(13,148,136,0.10); border: 1px solid rgba(13,148,136,0.25);
    color: #0d9488; border-radius: 100px; padding: 3px 12px; font-size: 0.75rem; font-weight: 600;
  }
  .tp-status-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(5,150,105,0.10); border: 1px solid rgba(5,150,105,0.25);
    color: #059669; border-radius: 100px; padding: 4px 14px; font-size: 0.78rem; font-weight: 600;
  }
  .tp-status-badge.inactive { background:rgba(225,29,72,0.08); border-color:rgba(225,29,72,0.25); color:#e11d48; }
  .tp-status-badge .dot { width:7px;height:7px;border-radius:50%;background:var(--tp-emerald); }
  .tp-status-badge.inactive .dot { background:var(--tp-rose); }

  /* Hero right info items */
  .tp-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem 1.5rem; margin-bottom: 1.25rem; }
  .tp-info-item { display: flex; align-items: flex-start; gap: 10px; }
  .tp-info-icon {
    width: 34px; height: 34px; border-radius: 10px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(99,102,241,0.10); color: #4f46e5; font-size: 0.82rem;
  }
  .tp-info-label { font-size: 0.7rem; color: var(--tp-muted); font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; }
  .tp-info-value { font-size: 0.9rem; font-weight: 600; color: var(--tp-text); }
  .tp-action-btns { display: flex; gap: 8px; flex-wrap: wrap; }

  /* Action buttons */
  .tp-action-btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 20px; border-radius: 100px; font-size: 0.83rem; font-weight: 600;
    border: none; cursor: pointer; text-decoration: none; transition: var(--tp-transition);
  }
  .tp-btn-primary {
    background: linear-gradient(135deg, var(--tp-accent), var(--tp-accent2));
    color: #fff; box-shadow: 0 4px 14px rgba(99,102,241,0.35);
  }
  .tp-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(99,102,241,0.5); color:#fff; }
  .tp-btn-outline {
    background: transparent; color: var(--tp-muted);
    border: 1.5px solid var(--tp-border);
  }
  .tp-btn-outline:hover { background: rgba(99,102,241,0.06); color: var(--tp-text); border-color: rgba(99,102,241,0.3); }

  /* ── STATS ROW ── */
  .tp-stats-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .tp-stat-card {
    background: var(--tp-surface); border: 1px solid var(--tp-border);
    border-radius: var(--tp-radius); padding: 1.4rem 1.5rem;
    display: flex; align-items: center; gap: 1rem;
    box-shadow: var(--tp-shadow-sm); transition: var(--tp-transition);
  }
  .tp-stat-card:hover { transform: translateY(-3px); box-shadow: var(--tp-shadow); border-color: rgba(99,130,180,0.3); }
  .tp-stat-icon {
    width: 50px; height: 50px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 1.25rem;
  }
  .si-1 { background: rgba(99,102,241,0.12); color: #4f46e5; }
  .si-2 { background: rgba(13,148,136,0.12); color: #0d9488; }
  .si-3 { background: rgba(217,119,6,0.12);  color: #d97706; }
  .si-4 { background: rgba(225,29,72,0.10);  color: #e11d48; }
  .tp-stat-num { font-size: 1.65rem; font-weight: 800; line-height: 1; }
  .tp-stat-lbl { font-size: 0.78rem; color: var(--tp-muted); font-weight: 500; margin-top: 3px; }

  /* ── PILL TABS ── */
  .tp-tab-bar {
    background: var(--tp-surface); border: 1px solid var(--tp-border);
    border-radius: var(--tp-radius); padding: 6px; margin-bottom: 1.5rem;
    display: flex; gap: 4px; box-shadow: var(--tp-shadow-sm);
  }
  .tp-tab-btn {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 20px; border-radius: 10px; font-size: 0.83rem; font-weight: 600;
    color: var(--tp-muted); border: none; background: transparent; cursor: pointer;
    transition: var(--tp-transition); white-space: nowrap;
  }
  .tp-tab-btn:hover { color: var(--tp-text); background: rgba(99,102,241,0.06); }
  .tp-tab-btn.tp-active {
    background: linear-gradient(135deg, var(--tp-accent), var(--tp-accent2));
    color: #fff; box-shadow: 0 4px 12px rgba(99,102,241,0.35);
  }
  .tp-tab-btn i { font-size: 0.85rem; }

  /* ── TAB PANELS ── */
  .tp-panel { display: none; animation: tpFadeIn 0.35s ease; }
  .tp-panel.tp-show { display: block; }
  @keyframes tpFadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }

  /* ── CONTENT CARDS ── */
  .tp-card {
    background: var(--tp-surface); border: 1px solid var(--tp-border);
    border-radius: var(--tp-radius); padding: 1.75rem;
    box-shadow: var(--tp-shadow-sm); margin-bottom: 1.25rem;
  }
  .tp-card-title {
    font-size: 1rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--tp-border);
    display: flex; align-items: center; gap: 10px;
  }
  .tp-card-title i { color: var(--tp-accent); }

  /* ── FORM FIELDS ── */
  .tp-form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .tp-form-grid.tp-cols-3 { grid-template-columns: repeat(3, 1fr); }
  .tp-fg-full { grid-column: 1 / -1; }
  .tp-field label {
    display: block; font-size: 0.72rem; font-weight: 600; color: var(--tp-muted);
    text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px;
  }
  .tp-input {
    width: 100%; background: #f8fafc; border: 1.5px solid var(--tp-border);
    border-radius: 10px; padding: 10px 14px; color: var(--tp-text); font-size: 0.88rem;
    font-family: 'Inter', sans-serif; transition: var(--tp-transition); outline: none;
  }
  .tp-input:focus { border-color: var(--tp-accent); box-shadow: 0 0 0 3px rgba(99,102,241,0.12); background: #ffffff; }
  .tp-input option { background: #ffffff; }
  textarea.tp-input { resize: vertical; min-height: 80px; }

  /* ── SUBMIT BTN ── */
  .tp-submit-row { margin-top: 1.5rem; display: flex; justify-content: flex-end; }
  .tp-save-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(135deg, var(--tp-accent), var(--tp-accent2));
    color: #fff; border: none; border-radius: 100px;
    padding: 10px 28px; font-size: 0.88rem; font-weight: 700; cursor: pointer;
    box-shadow: 0 4px 14px rgba(99,102,241,0.35); transition: var(--tp-transition);
  }
  .tp-save-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(99,102,241,0.5); }

  /* ── EXPERIENCE LIST ── */
  .tp-exp-item {
    background: #f8fafc; border: 1px solid var(--tp-border);
    border-radius: 12px; padding: 1.1rem 1.3rem;
    display: flex; align-items: center; gap: 1rem; margin-bottom: 0.8rem;
    transition: var(--tp-transition);
  }
  .tp-exp-item:hover { border-color: rgba(99,102,241,0.25); background: #f0f4ff; }
  .tp-exp-icon {
    width: 42px; height: 42px; border-radius: 12px; flex-shrink: 0;
    background: rgba(99,102,241,0.10); color: #4f46e5;
    display: flex; align-items: center; justify-content: center; font-size: 1rem;
  }
  .tp-exp-school { font-size: 0.93rem; font-weight: 700; }
  .tp-exp-meta { font-size: 0.78rem; color: var(--tp-muted); margin-top: 2px; }
  .tp-exp-del {
    margin-left: auto; background: rgba(225,29,72,0.08); border: 1px solid rgba(225,29,72,0.2);
    color: #e11d48; border-radius: 8px; padding: 6px 10px; font-size: 0.78rem;
    cursor: pointer; transition: var(--tp-transition);
  }
  .tp-exp-del:hover { background: rgba(225,29,72,0.15); }

  /* ── DOCUMENT LIST ── */
  .tp-doc-item {
    background: #f8fafc; border: 1px solid var(--tp-border);
    border-radius: 12px; padding: 1rem 1.3rem;
    display: flex; align-items: center; gap: 1rem; margin-bottom: 0.8rem;
    transition: var(--tp-transition);
  }
  .tp-doc-item:hover { border-color: rgba(99,102,241,0.25); background: #f0f4ff; }
  .tp-doc-icon {
    width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
    background: rgba(217,119,6,0.10); color: #d97706;
    display: flex; align-items: center; justify-content: center; font-size: 1rem;
  }
  .tp-doc-type {
    display: inline-block; background: rgba(13,148,136,0.10); color: #0d9488;
    border: 1px solid rgba(13,148,136,0.22); border-radius: 100px;
    padding: 2px 10px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .tp-doc-actions { margin-left: auto; display: flex; gap: 6px; }
  .tp-doc-view {
    background: rgba(99,102,241,0.10); border: 1px solid rgba(99,102,241,0.22);
    color: #4f46e5; border-radius: 8px; padding: 6px 10px; font-size: 0.78rem;
    text-decoration: none; transition: var(--tp-transition);
  }
  .tp-doc-view:hover { background: rgba(99,102,241,0.18); color: #4f46e5; }

  /* ── ACTIVITY TIMELINE ── */
  .tp-timeline { position: relative; padding-left: 2rem; }
  .tp-timeline::before {
    content: ''; position: absolute; left: 10px; top: 0; bottom: 0;
    width: 2px; background: linear-gradient(to bottom, var(--tp-accent), transparent);
  }
  .tp-tl-item { position: relative; margin-bottom: 1.5rem; }
  .tp-tl-dot {
    position: absolute; left: -26px; top: 5px;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--tp-accent); border: 2px solid #ffffff;
    box-shadow: 0 0 8px rgba(99,102,241,0.35);
  }
  .tp-tl-dot.teal { background: var(--tp-teal); box-shadow: 0 0 8px rgba(20,184,166,0.5); }
  .tp-tl-dot.amber { background: var(--tp-amber); box-shadow: 0 0 8px rgba(245,158,11,0.5); }
  .tp-tl-time { font-size: 0.7rem; color: var(--tp-muted); margin-bottom: 3px; }
  .tp-tl-text { font-size: 0.88rem; font-weight: 500; }

  /* ── DIVIDER ── */
  .tp-divider { border: none; border-top: 1px solid var(--tp-border); margin: 1.5rem 0; }

  /* ── SECTION LABEL ── */
  .tp-section-label {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--tp-accent); margin-bottom: 1rem; display: flex; align-items: center; gap: 8px;
  }
  .tp-section-label::after {
    content:''; flex:1; height:1px; background:var(--tp-border);
  }

  /* ── EMPTY STATE ── */
  .tp-empty {
    text-align:center; padding:2rem 1rem; color:var(--tp-muted); font-size:0.88rem;
  }
  .tp-empty i { font-size:2.5rem; display:block; margin-bottom:0.75rem; opacity:0.4; }

  /* ── RESPONSIVE ── */
  @media(max-width:992px) {
    .tp-stats-row { grid-template-columns: repeat(2,1fr); }
    .tp-info-grid { grid-template-columns: 1fr; }
    .tp-form-grid { grid-template-columns: 1fr; }
    .tp-form-grid.tp-cols-3 { grid-template-columns: 1fr; }
    .tp-tab-bar { overflow-x:auto; -webkit-overflow-scrolling:touch; flex-wrap:nowrap; }
  }
  @media(max-width:576px) {
    .tp-hero { padding:1.5rem; }
    .tp-stats-row { grid-template-columns: 1fr 1fr; }
    .tp-teacher-name { font-size:1.35rem; }
    .tp-action-btns { flex-wrap:wrap; }
  }
</style>

<div class="tp-wrapper">

  <!-- ════════════════════════ HERO CARD ════════════════════════ -->
  <div class="tp-hero">
    <div class="tp-hero-inner">

      <!-- LEFT: Avatar + Name + Badges -->
      <div style="display:flex; gap:24px; flex-grow:1;">
        <div class="tp-avatar-wrap">
          <img src="<%= teacher.avatar || '/images/default-avatar.png' %>" alt="<%= teacher.name %>">
          <div class="tp-avatar-status <%= (teacher.status && teacher.status.toLowerCase() === 'inactive') ? 'inactive' : '' %>"></div>
        </div>
        <div>
          <h1 class="tp-teacher-name"><%= teacher.name %></h1>
          <div class="tp-emp-badge">
            <i class="fas fa-id-badge"></i>
            EMP-<%= String(teacher.id).padStart(4,'0') %>
          </div>
          <div class="tp-subject-badges">
            <% if (teacher.subject) { %>
              <% teacher.subject.split(',').forEach(function(s){ %>
                <span class="tp-subject-badge"><i class="fas fa-book-open me-1"></i><%= s.trim() %></span>
              <% }) %>
            <% } else { %>
              <span class="tp-subject-badge">General</span>
            <% } %>
          </div>
          <div>
            <span class="tp-status-badge <%= (teacher.status && teacher.status.toLowerCase() === 'inactive') ? 'inactive' : '' %>">
              <span class="dot"></span>
              <%= (teacher.status && teacher.status.toLowerCase() === 'inactive') ? 'Inactive' : 'Active' %>
            </span>
          </div>
        </div>
      </div>

      <!-- RIGHT: Contact Info + Actions -->
      <div style="display:flex; flex-direction:column; justify-content:space-between; min-width:280px;">
        <div class="tp-info-grid">
          <div class="tp-info-item">
            <div class="tp-info-icon"><i class="fas fa-envelope"></i></div>
            <div>
              <div class="tp-info-label">Email</div>
              <div class="tp-info-value" style="font-size:0.82rem;word-break:break-all;"><%= teacher.email || '—' %></div>
            </div>
          </div>
          <div class="tp-info-item">
            <div class="tp-info-icon" style="background:rgba(20,184,166,0.12);color:#5eead4;"><i class="fas fa-phone"></i></div>
            <div>
              <div class="tp-info-label">Mobile</div>
              <div class="tp-info-value"><%= teacher.phone || '—' %></div>
            </div>
          </div>
          <div class="tp-info-item">
            <div class="tp-info-icon" style="background:rgba(245,158,11,0.12);color:#fcd34d;"><i class="fas fa-calendar-check"></i></div>
            <div>
              <div class="tp-info-label">Joining Date</div>
              <div class="tp-info-value">
                <% if(teacher.joining_date){ %>
                  <%= new Date(teacher.joining_date).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %>
                <% } else { %>—<% } %>
              </div>
            </div>
          </div>
          <div class="tp-info-item">
            <div class="tp-info-icon" style="background:rgba(244,63,94,0.12);color:#fda4af;"><i class="fas fa-graduation-cap"></i></div>
            <div>
              <div class="tp-info-label">Qualification</div>
              <div class="tp-info-value"><%= teacher.qualification || '—' %></div>
            </div>
          </div>
        </div>

        <div class="tp-action-btns">
          <a href="#" class="tp-action-btn tp-btn-primary" onclick="tpSwitchTab('security');return false;">
            <i class="fas fa-key"></i> Change Password
          </a>
          <a href="#" class="tp-action-btn tp-btn-outline" onclick="tpSwitchTab('docs');return false;">
            <i class="fas fa-file-alt"></i> Documents
          </a>
          <a href="/teacher/profile/download" class="tp-action-btn tp-btn-outline" id="tp-download-btn">
            <i class="fas fa-download"></i>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- ════════════════════════ STATS ROW ════════════════════════ -->
  <div class="tp-stats-row">
    <div class="tp-stat-card">
      <div class="tp-stat-icon si-1"><i class="fas fa-chalkboard-teacher"></i></div>
      <div>
        <div class="tp-stat-num" id="tp-stat-classes">—</div>
        <div class="tp-stat-lbl">Classes Assigned</div>
      </div>
    </div>
    <div class="tp-stat-card">
      <div class="tp-stat-icon si-2"><i class="fas fa-book-open"></i></div>
      <div>
        <div class="tp-stat-num" id="tp-stat-subjects">—</div>
        <div class="tp-stat-lbl">Subjects Teaching</div>
      </div>
    </div>
    <div class="tp-stat-card">
      <div class="tp-stat-icon si-3"><i class="fas fa-users"></i></div>
      <div>
        <div class="tp-stat-num" id="tp-stat-students">—</div>
        <div class="tp-stat-lbl">Students Assigned</div>
      </div>
    </div>
    <div class="tp-stat-card">
      <div class="tp-stat-icon si-4"><i class="fas fa-star"></i></div>
      <div>
        <div class="tp-stat-num"><%= teacher.experience || 0 %></div>
        <div class="tp-stat-lbl">Experience (Years)</div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════ PILL TABS ════════════════════════ -->
  <div class="tp-tab-bar" role="tablist">
    <button class="tp-tab-btn tp-active" id="tp-tab-personal" onclick="tpSwitchTab('personal')" role="tab">
      <i class="fas fa-user"></i> Personal Information
    </button>
    <button class="tp-tab-btn" id="tp-tab-professional" onclick="tpSwitchTab('professional')" role="tab">
      <i class="fas fa-briefcase"></i> Professional Details
    </button>
    <button class="tp-tab-btn" id="tp-tab-medical" onclick="tpSwitchTab('medical')" role="tab">
      <i class="fas fa-heartbeat"></i> Medical Information
    </button>
    <button class="tp-tab-btn" id="tp-tab-docs" onclick="tpSwitchTab('docs')" role="tab">
      <i class="fas fa-folder-open"></i> Documents
    </button>
    <button class="tp-tab-btn" id="tp-tab-security" onclick="tpSwitchTab('security')" role="tab">
      <i class="fas fa-key"></i> Change Password
    </button>
    <button class="tp-tab-btn" id="tp-tab-activity" onclick="tpSwitchTab('activity')" role="tab">
      <i class="fas fa-history"></i> Activity Timeline
    </button>
  </div>

  <!-- ════════════ PANEL 1: PERSONAL INFORMATION ════════════ -->
  <div class="tp-panel tp-show" id="tp-panel-personal">
    <div class="tp-card">
      <div class="tp-card-title"><i class="fas fa-user-circle"></i> Personal Information</div>
      <div class="tp-section-label">Basic Details</div>
      <div class="tp-form-grid">
        <div class="tp-field">
          <label>Gender</label>
          <select name="gender" class="tp-input" disabled>
            <option value="">Select Gender</option>
            <option value="male"   <%= teacher.gender === 'male'   ? 'selected' : '' %>>Male</option>
            <option value="female" <%= teacher.gender === 'female' ? 'selected' : '' %>>Female</option>
            <option value="other"  <%= teacher.gender === 'other'  ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <div class="tp-field">
          <label>Date of Birth</label>
          <input type="date" name="dob" class="tp-input" disabled
            value="<%= teacher.dob ? new Date(teacher.dob).toISOString().split('T')[0] : '' %>">
        </div>
        <div class="tp-field">
          <label>Marital Status</label>
          <select name="marital_status" class="tp-input" disabled>
            <option value="">Select</option>
            <option value="single"   <%= teacher.marital_status === 'single'   ? 'selected' : '' %>>Single</option>
            <option value="married"  <%= teacher.marital_status === 'married'  ? 'selected' : '' %>>Married</option>
            <option value="divorced" <%= teacher.marital_status === 'divorced' ? 'selected' : '' %>>Divorced</option>
            <option value="widowed"  <%= teacher.marital_status === 'widowed'  ? 'selected' : '' %>>Widowed</option>
          </select>
        </div>
        <div class="tp-field">
          <label>Qualification</label>
          <input type="text" name="qualification" class="tp-input" disabled
            placeholder="e.g. M.Sc., B.Ed."
            value="<%= teacher.qualification || '' %>">
        </div>
      </div>

      <hr class="tp-divider">
      <div class="tp-section-label">Family & Emergency Contact Details</div>
      <div class="tp-form-grid">
        <div class="tp-field">
          <label>Father's Name</label>
          <input type="text" name="father_name" class="tp-input" disabled value="<%= teacher.father_name || '' %>">
        </div>
        <div class="tp-field">
          <label>Mother's Name</label>
          <input type="text" name="mother_name" class="tp-input" disabled value="<%= teacher.mother_name || '' %>">
        </div>
        <div class="tp-field">
          <label>Emergency Contact</label>
          <input type="text" name="emergency_contact" class="tp-input" disabled value="<%= teacher.emergency_contact || '' %>">
        </div>
      </div>

      <hr class="tp-divider">
      <div class="tp-section-label">Address</div>
      <div class="tp-form-grid">
        <div class="tp-field tp-fg-full">
          <label>Current Address</label>
          <textarea name="current_address" class="tp-input" disabled><%= teacher.current_address || '' %></textarea>
        </div>
        <div class="tp-field tp-fg-full">
          <label>Permanent Address</label>
          <textarea name="permanent_address" class="tp-input" disabled><%= teacher.permanent_address || '' %></textarea>
        </div>
      </div>
      <div style="margin-top:12px; font-size:12px; color:#64748b;">
        <i class="fas fa-info-circle" style="margin-right:4px;"></i> Personal details can only be updated by the School Admin.
      </div>
    </div>
  </div>

  <!-- ════════════ PANEL 2: PROFESSIONAL DETAILS ════════════ -->
  <div class="tp-panel" id="tp-panel-professional">
    <div class="tp-card">
      <div class="tp-card-title"><i class="fas fa-briefcase"></i> Professional Details</div>
      <div class="tp-form-grid tp-cols-3">
        <div class="tp-field">
          <label>Subject(s)</label>
          <input type="text" name="subject" class="tp-input" disabled
            placeholder="e.g. Mathematics, Physics"
            value="<%= teacher.subject || '' %>">
        </div>
        <div class="tp-field">
          <label>Experience (Years)</label>
          <input type="number" step="0.1" name="experience" class="tp-input" disabled
            value="<%= teacher.experience || '' %>">
        </div>
        <div class="tp-field">
          <label>Joining Date</label>
          <input type="date" name="joining_date" class="tp-input" disabled
            value="<%= teacher.joining_date ? new Date(teacher.joining_date).toISOString().split('T')[0] : '' %>">
        </div>
      </div>
      <div style="margin-top:12px; font-size:12px; color:#64748b;">
        <i class="fas fa-info-circle" style="margin-right:4px;"></i> Professional details can only be updated by the School Admin.
      </div>
    </div>

    <!-- Experience Records -->
    <div class="tp-card">
      <div class="tp-card-title"><i class="fas fa-history"></i> Experience Records</div>

      <% if (experiences && experiences.length > 0) { %>
        <% experiences.forEach(function(exp) { %>
          <div class="tp-exp-item">
            <div class="tp-exp-icon"><i class="fas fa-school"></i></div>
            <div>
              <div class="tp-exp-school"><%= exp.previous_school %></div>
              <div class="tp-exp-meta">
                <i class="fas fa-clock me-1"></i><%= exp.total_experience %> yr(s)
                <% if (exp.joining_date) { %>
                  &nbsp;&bull;&nbsp; Joined: <%= new Date(exp.joining_date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="tp-empty">
          <i class="fas fa-briefcase"></i>
          No experience records yet.
        </div>
      <% } %>
    </div>
  </div>

  <!-- ════════════ PANEL 3: MEDICAL INFORMATION ════════════ -->
  <div class="tp-panel" id="tp-panel-medical">
    <div class="tp-card">
      <div class="tp-card-title"><i class="fas fa-heartbeat"></i> Medical Information</div>
      <div class="tp-form-grid tp-cols-3">
        <div class="tp-field">
          <label>Blood Group</label>
          <select name="blood_group" class="tp-input" disabled>
            <option value="">Select</option>
            <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(function(bg){ %>
              <option value="<%= bg %>" <%= medical && medical.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
            <% }) %>
          </select>
        </div>
        <div class="tp-field">
          <label>Height (cm)</label>
          <input type="number" step="0.01" name="height" class="tp-input" disabled
            placeholder="e.g. 170"
            value="<%= medical ? medical.height : '' %>">
        </div>
        <div class="tp-field">
          <label>Weight (kg)</label>
          <input type="number" step="0.01" name="weight" class="tp-input" disabled
            placeholder="e.g. 65"
            value="<%= medical ? medical.weight : '' %>">
        </div>
        <div class="tp-field tp-fg-full">
          <label>Medical Issues / Notes</label>
          <textarea name="medical_issues" class="tp-input" rows="4" disabled
            placeholder="Describe any known medical conditions or allergies…"><%= medical ? (medical.medical_issues || '') : '' %></textarea>
        </div>
      </div>
      <div style="margin-top:12px; font-size:12px; color:#64748b;">
        <i class="fas fa-info-circle" style="margin-right:4px;"></i> Medical details can only be updated by the School Admin.
      </div>
    </div>
  </div>

  <!-- ════════════ PANEL 4: DOCUMENTS ════════════ -->
  <div class="tp-panel" id="tp-panel-docs">
    <div class="tp-card">
      <div class="tp-card-title"><i class="fas fa-folder-open"></i> Uploaded Documents</div>

      <% if (documents && documents.length > 0) { %>
        <% documents.forEach(function(doc) { %>
          <div class="tp-doc-item">
            <div class="tp-doc-icon">
              <% if(['jpg','jpeg','png','gif'].some(function(ext){ return doc.file_path && doc.file_path.endsWith('.'+ext); })){ %>
                <i class="fas fa-image"></i>
              <% } else { %>
                <i class="fas fa-file-pdf"></i>
              <% } %>
            </div>
            <div>
              <div style="font-size:0.9rem;font-weight:700;"><%= doc.document_name %></div>
              <div style="margin-top:4px;">
                <span class="tp-doc-type"><%= doc.document_type %></span>
                <small style="color:var(--tp-muted); margin-left:8px;">
                  <i class="fas fa-clock" style="margin-right:4px;"></i><%= new Date(doc.uploaded_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %>
                </small>
              </div>
            </div>
            <div class="tp-doc-actions">
              <a href="<%= doc.file_path %>" target="_blank" class="tp-doc-view"><i class="fas fa-eye"></i> View</a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="tp-empty">
          <i class="fas fa-folder"></i>
          No documents uploaded yet.
        </div>
      <% } %>
    </div>
  </div>

  <!-- ════════════ PANEL: SECURITY ════════════ -->
  <div class="tp-panel" id="tp-panel-security">
    <div class="tp-card">
      <div class="tp-card-title"><i class="fas fa-key"></i> Change Password</div>
      <form action="/teacher/profile/update" method="POST">
        <div class="tp-form-grid">
          <div class="tp-field">
            <label>Current Password</label>
            <input type="password" name="currentPassword" required class="tp-input" placeholder="Current Password">
          </div>
          <div class="tp-field">
            <label>New Password</label>
            <input type="password" name="newPassword" required class="tp-input" placeholder="New Password">
          </div>
          <div class="tp-field">
            <label>Confirm New Password</label>
            <input type="password" name="confirmPassword" required class="tp-input" placeholder="Confirm New Password">
          </div>
        </div>
        <div class="tp-submit-row">
          <button type="submit" class="tp-save-btn"><i class="fas fa-save"></i> Update Password</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ════════════ PANEL 5: ACTIVITY TIMELINE ════════════ -->
  <div class="tp-panel" id="tp-panel-activity">
    <div class="tp-card">
      <div class="tp-card-title"><i class="fas fa-history"></i> Activity Timeline</div>
      <div class="tp-timeline">
        <div class="tp-tl-item">
          <div class="tp-tl-dot"></div>
          <div class="tp-tl-time"><i class="fas fa-clock me-1"></i>
            <%= new Date(teacher.created_at || Date.now()).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}) %>
          </div>
          <div class="tp-tl-text">🎉 <strong><%= teacher.name %></strong> joined SchoolSync as a teacher.</div>
        </div>
        <% if (teacher.joining_date) { %>
        <div class="tp-tl-item">
          <div class="tp-tl-dot teal"></div>
          <div class="tp-tl-time"><i class="fas fa-calendar me-1"></i>
            <%= new Date(teacher.joining_date).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}) %>
          </div>
          <div class="tp-tl-text">🏫 Officially joined the school on this date.</div>
        </div>
        <% } %>
        <% if (experiences && experiences.length > 0) { %>
          <% experiences.forEach(function(exp){ %>
          <div class="tp-tl-item">
            <div class="tp-tl-dot amber"></div>
            <div class="tp-tl-time"><i class="fas fa-briefcase me-1"></i>
              <% if(exp.joining_date){ %><%= new Date(exp.joining_date).toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'}) %><% } else { %>Past<% } %>
            </div>
            <div class="tp-tl-text">📚 Served at <strong><%= exp.previous_school %></strong> for <%= exp.total_experience %> year(s).</div>
          </div>
          <% }) %>
        <% } %>
        <% if (documents && documents.length > 0) { %>
        <div class="tp-tl-item">
          <div class="tp-tl-dot"></div>
          <div class="tp-tl-time"><i class="fas fa-folder me-1"></i>Recently</div>
          <div class="tp-tl-text">📄 <strong><%= documents.length %></strong> document(s) uploaded to profile.</div>
        </div>
        <% } %>
      </div>
    </div>
  </div>

</div><!-- end .tp-wrapper -->

<script>
  // ── TAB SWITCHING
  function tpSwitchTab(name) {
    document.querySelectorAll('.tp-tab-btn').forEach(function(b){ b.classList.remove('tp-active'); });
    document.querySelectorAll('.tp-panel').forEach(function(p){ p.classList.remove('tp-show'); });
    var btn = document.getElementById('tp-tab-' + name);
    var panel = document.getElementById('tp-panel-' + name);
    if (btn) btn.classList.add('tp-active');
    if (panel) panel.classList.add('tp-show');
  }

  // ── LOAD STATS via fetch
  document.addEventListener('DOMContentLoaded', function() {
    fetch('/teacher/profile/stats')
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){
        if (!d) return;
        var el = function(id){ return document.getElementById(id); };
        if (el('tp-stat-classes'))  el('tp-stat-classes').textContent  = d.assignedClasses  || 0;
        if (el('tp-stat-subjects')) el('tp-stat-subjects').textContent = d.subjects          || 0;
        if (el('tp-stat-students')) el('tp-stat-students').textContent = d.totalStudents     || 0;
      })
      .catch(function(){
        // silently fail – stats remain as —
      });

    // ── animate stat numbers
    document.querySelectorAll('.tp-stat-num').forEach(function(el) {
      var target = parseInt(el.textContent, 10);
      if (!isNaN(target) && target > 0) {
        var count = 0;
        var step = Math.ceil(target / 30);
        var timer = setInterval(function(){
          count = Math.min(count + step, target);
          el.textContent = count;
          if (count >= target) clearInterval(timer);
        }, 40);
      }
    });
  });
</script>