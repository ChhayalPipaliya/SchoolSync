<style>
    .ptm-container {
        font-family: 'Inter', system-ui, sans-serif;
        color: #1e293b;
    }
    .ptm-header {
        background: linear-gradient(135deg, #4f46e5, #3730a3);
        border-radius: 16px;
        padding: 28px;
        color: #fff;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.2);
    }
    .ptm-header::after {
        content: '';
        position: absolute;
        right: -50px;
        top: -50px;
        width: 180px;
        height: 180px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
    }
    .ptm-btn {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.4);
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .ptm-btn:hover {
        background: #fff;
        color: #4f46e5;
        border-color: #fff;
        transform: translateY(-2px);
    }
    .ptm-btn-primary {
        background: #4f46e5;
        color: #fff;
        border: 1px solid #4f46e5;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .ptm-btn-primary:hover {
        background: #3730a3;
        border-color: #3730a3;
        transform: translateY(-2px);
    }
    .ptm-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 24px;
    }
    @media (max-width: 1024px) {
        .ptm-grid {
            grid-template-columns: 1fr;
        }
    }
    .ptm-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        padding: 24px;
        margin-bottom: 24px;
    }
    .ptm-card-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .ptm-card-title i {
        color: #4f46e5;
    }
    .slot-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #475569;
    }
    .slot-badge.booked {
        background: #ecfdf5;
        color: #047857;
        border-color: #a7f3d0;
    }
    .slot-badge.cancelled {
        background: #fef2f2;
        color: #b91c1c;
        border-color: #fca5a5;
    }
    .slot-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
    }
    .ptm-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }
    .ptm-modal-content {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        position: relative;
        animation: modalSlide 0.3s ease;
    }
    @keyframes modalSlide {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    .close-modal {
        position: absolute;
        right: 20px;
        top: 20px;
        font-size: 20px;
        cursor: pointer;
        color: #94a3b8;
    }
    .form-group {
        margin-bottom: 16px;
    }
    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }
    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: border 0.2s;
    }
    .form-control:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #94a3b8;
    }
    .empty-state i {
        font-size: 40px;
        margin-bottom: 12px;
        color: #cbd5e1;
    }
</style>
<div class="ptm-container">
    <div class="ptm-header">
        <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div>
                <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;"><%- lan.PTM_Scheduler %></h1>
                <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;"><%- lan.PTM_Scheduler_Subtitle %></p>
            </div>
            <button class="ptm-btn" onclick="openModal()">
                <i class="fas fa-plus"></i> <%- lan.Generate_Time_Slots %>
            </button>
        </div>
    </div>
    <%- include('../../partials/flashMessages') %>
    <div class="ptm-grid">
        <div>
            <div class="ptm-card">
                <div class="ptm-card-title">
                    <i class="fas fa-calendar-check"></i> <%- lan.Active_PTM_Bookings %>
                </div>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                        <thead>
                            <tr style="border-bottom: 2px solid #f1f5f9; background: #f8fafc;">
                                <th style="padding: 12px 16px; color: #64748b; font-weight: 600;"><%- lan.Date %></th>
                                <th style="padding: 12px 16px; color: #64748b; font-weight: 600;"><%- lan.Time_Slot %></th>
                                <th style="padding: 12px 16px; color: #64748b; font-weight: 600;"><%- lan.Parent %></th>
                                <th style="padding: 12px 16px; color: #64748b; font-weight: 600;"><%- lan.Student %></th>
                                <th style="padding: 12px 16px; color: #64748b; font-weight: 600;"><%- lan.Notes %></th>
                                <th style="padding: 12px 16px; color: #64748b; font-weight: 600; text-align: right;"><%- lan.Action %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% 
                                const bookedSlots = slots.filter(s => s.booking_id);
                                if (bookedSlots.length > 0) { 
                                    bookedSlots.forEach(slot => { 
                            %>
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 14px 16px; font-weight: 600;"><%= slot.formatted_date %></td>
                                    <td style="padding: 14px 16px;">
                                        <span class="slot-badge booked">
                                            <i class="far fa-clock"></i> <%= slot.formatted_start_time %> - <%= slot.formatted_end_time %>
                                        </span>
                                    </td>
                                    <td style="padding: 14px 16px;">
                                        <strong><%= slot.parent_name %></strong><br>
                                        <small style="color: #64748b;"><%= slot.parent_phone %></small>
                                    </td>
                                    <td style="padding: 14px 16px;">
                                        <%= slot.student_name %><br>
                                        <small style="color: #64748b;"><%- lan.Class %>: <%= slot.class_name %> - <%= slot.section %></small>
                                    </td>
                                    <td style="padding: 14px 16px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= slot.notes %>">
                                        <%= slot.notes || '—' %>
                                    </td>
                                    <td style="padding: 14px 16px; text-align: right;">
                                        <form method="POST" action="/teacher/ptm/bookings/cancel/<%= slot.booking_id %>" style="display:inline;" onsubmit="return confirm('<%= lan.Confirm_Cancel_Booking_Parent_Notice %>');">
                                            <button type="submit" style="background:none; border:none; color:#ef4444; font-weight:600; cursor:pointer; font-size:12px;">
                                                <%- lan.Cancel_Booking %>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <%  }); 
                             } else { %>
                                <tr>
                                    <td colspan="6" class="empty-state">
                                        <i class="far fa-calendar-times"></i>
                                        <p><%- lan.No_Active_PTM_Bookings_Found %></p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div>
            <div class="ptm-card">
                <div class="ptm-card-title">
                    <i class="fas fa-history"></i> <%- lan.My_Time_Slots %>
                </div>
                <% 
                    const groupedSlots = {};
                    slots.forEach(slot => {
                        if (!groupedSlots[slot.formatted_date]) {
                            groupedSlots[slot.formatted_date] = [];
                        }
                        groupedSlots[slot.formatted_date].push(slot);
                    });

                    const dates = Object.keys(groupedSlots);
                    if (dates.length > 0) {
                        dates.forEach(date => {
                %>
                    <div style="margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 16px;">
                        <h4 style="font-size: 14px; font-weight: 700; color: #475569; margin: 0 0 10px 0;"><%= date %></h4>
                        <div class="slot-grid">
                            <% groupedSlots[date].forEach(slot => { %>
                                <div style="position: relative; display: inline-flex;">
                                    <span class="slot-badge <%= slot.booking_id ? 'booked' : 'available' %>" style="width: 100%; justify-content: space-between;">
                                        <span><i class="far fa-clock"></i> <%= slot.formatted_start_time %></span>
                                        <% if (!slot.booking_id) { %>
                                            <form method="POST" action="/teacher/ptm/slots/delete/<%= slot.id %>" style="display:inline; margin-left: 8px;" onsubmit="return confirm('<%= lan.Confirm_Delete_Slot %>');">
                                                <button type="submit" style="background:none; border:none; color:#cbd5e1; cursor:pointer; padding:0; line-height:1; font-size:12px;" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='#cbd5e1'">
                                                    <i class="fas fa-times-circle"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <i class="fas fa-check-circle" style="color: #10b981; margin-left: 8px;"></i>
                                        <% } %>
                                    </span>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <%  });
                   } else {  %>
                    <div class="empty-state">
                        <i class="fas fa-clock"></i>
                        <p><%- lan.No_Time_Slots_Configured_Desc || 'No time slots configured. Click &quot;Generate Time Slots&quot; to create slots for parents to book.' %></p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<div class="ptm-modal" id="slotsModal">
    <div class="ptm-modal-content">
        <span class="close-modal" onclick="closeModal()">&times;</span>
        <h3 style="font-size: 18px; font-weight: 700; margin: 0 0 20px 0; color: #0f172a; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-clock" style="color: #4f46e5;"></i> <%- lan.Generate_PTM_Slots || 'Generate PTM Slots' %>
        </h3>
        <form method="POST" action="/teacher/ptm/slots/generate">
            <div class="form-group">
                <label for="date"><%- lan.Date || 'Date' %></label>
                <input type="date" name="date" id="date" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label for="startTime"><%- lan.Start_Time || 'Start Time' %></label>
                    <input type="time" name="startTime" id="startTime" class="form-control" required value="09:00">
                </div>
                <div class="form-group">
                    <label for="endTime"><%- lan.End_Time || 'End Time' %></label>
                    <input type="time" name="endTime" id="endTime" class="form-control" required value="12:00">
                </div>
            </div>
            <div class="form-group">
                <label for="duration"><%- lan.Slot_Duration || 'Slot Duration' %></label>
                <select name="duration" id="duration" class="form-control" required>
                    <option value="10">10 <%- lan.Minutes || 'Minutes' %></option>
                    <option value="15" selected>15 <%- lan.Minutes || 'Minutes' %></option>
                    <option value="20">20 <%- lan.Minutes || 'Minutes' %></option>
                    <option value="30">30 <%- lan.Minutes || 'Minutes' %></option>
                    <option value="45">45 <%- lan.Minutes || 'Minutes' %></option>
                    <option value="60">60 <%- lan.Minutes || 'Minutes' %></option>
                </select>
            </div>
            <div style="margin-top: 24px; text-align: right; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="ptm-btn" style="background:#f1f5f9; color:#475569; border-color:#e2e8f0;" onclick="closeModal()"><%- lan.Cancel || 'Cancel' %></button>
                <button type="submit" class="ptm-btn-primary"><%- lan.Generate_Slots || 'Generate Slots' %></button>
            </div>
        </form>
    </div>
</div>
<script>
    function openModal() {
        document.getElementById('slotsModal').style.display = 'flex';
    };
    function closeModal() {
        document.getElementById('slotsModal').style.display = 'none';
    };

    window.onclick = function(event) {
        const modal = document.getElementById('slotsModal');
        if (event.target == modal) {
            closeModal();
        };
    };
</script>