<div class="page-body">
    <div class="att-filter reveal">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label style="font-size:11px;font-weight:700;color:#64748B;text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:6px;"><%- lan.Class || 'Class' %></label>
                <% if (typeof primaryClasses !== 'undefined' && primaryClasses && primaryClasses.length > 1) { %>
                    <select name="class_id" class="form-select" onchange="this.form.submit()" style="font-weight:700;">
                        <% primaryClasses.forEach(c => { %>
                            <option value="<%= c.class_id %>" <%= (cls && String(cls.class_id) === String(c.class_id)) ? 'selected' : '' %>>
                                <%= c.class_label || (c.class_name + (c.stream && c.stream !== 'General' ? ' - ' + c.stream : '') + ' - ' + c.section) %>
                            </option>
                        <% }) %>
                    </select>
                <% } else if (cls) { %>
                    <input type="hidden" name="class_id" value="<%= cls.class_id %>">
                    <div class="form-input" style="display:flex;align-items:center;font-weight:700;color:#334155;background:#F8FAFC;">
                        <%- lan.Class || 'Class' %>: <%= cls.class_label || cls.label || cls.display_name || cls.name %><%= cls.section_name ? ' - ' + cls.section_name : '' %>
                    </div>
                <% } else { %>
                    <div class="form-input" style="display:flex;align-items:center;font-weight:700;color:#94A3B8;background:#F8FAFC;">
                        <%- lan.Primary_Teacher_Attendance_Only_Notice || 'Only the Primary Teacher assigned to a class can mark student attendance.' %>
                    </div>
                <% } %>
            </div>
            <div class="col-md-3">
                <label style="font-size:11px;font-weight:700;color:#64748B;text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:6px;"><%- lan.Month || 'Month' %></label>
                <input type="month" name="month" value="<%= month %>" class="form-input">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search"></i> <%- lan.View || 'View' %>
                </button>
            </div>
            <% if(cls) { %>
                <div class="col-md-2">
                    <a href="/teacher/attendance?date=<%= new Date().toISOString().slice(0,10) %>" class="btn btn-primary w-100">
                        <i class="fa-solid fa-pen me-1"></i> <%- lan.Mark_Today || 'Mark Today' %>
                    </a>
                </div>
            <% } %>
        </form>
    </div>
    <% if(cls && students && students.length > 0) { %>
        <div class="custom-table reveal reveal-delay-1">
            <div class="p-4 d-flex justify-content-between align-items-center" style="border-bottom:1px solid #E2E8F0;">
                <div>
                    <span style="font-weight:700;color:#1E293B;font-size:15px;"><%= cls.label || cls.class_label || cls.display_name || cls.name %><%= cls.section && !(cls.label || cls.class_label || cls.display_name) ? ' (' + cls.section + ')' : '' %></span>
                    <span style="color:#94A3B8;font-size:12px;margin-left:8px;"><%= month %> — <%= students.length %> <%- lan.Students || 'students' %></span>
                </div>
                <div class="d-flex gap-3" style="font-size:11px;font-weight:600;">
                    <span style="background:#D1FAE5;color:#065F46;padding:3px 10px;border-radius:20px;"><%- lan.P_Present || 'P = Present' %></span>
                    <span style="background:#FEE2E2;color:#991B1B;padding:3px 10px;border-radius:20px;"><%- lan.A_Absent || 'A = Absent' %></span>
                    <span style="background:#FEF3C7;color:#92400E;padding:3px 10px;border-radius:20px;"><%- lan.L_Late || 'L = Late' %></span>
                </div>
            </div>
            <div class="p-3"><%- include('../partials/monthlyGrid', { people: students, attendanceMap, days, nameLabel: (lan.Student || 'Student') }) %></div>
        </div>
    <% } else if(cls) { %>
        <div class="empty-state reveal">
            <i class="fa-solid fa-user-slash"></i>
            <p><%- lan.No_Students_In_This_Class || 'No students in this class.' %></p>
        </div>
    <% } else { %>
        <div class="empty-state reveal">
            <i class="fa-solid fa-filter"></i>
            <p><%- lan.Primary_Teacher_Attendance_Only_Notice || 'Only the Primary Teacher assigned to a class can mark student attendance.' %></p>
        </div>
    <% } %>
</div>