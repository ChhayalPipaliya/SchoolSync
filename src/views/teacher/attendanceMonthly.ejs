<div class="page-body">
  <div class="att-filter reveal">
    <form method="GET" class="row g-3 align-items-end">
      <div class="col-md-3">
        <label style="font-size:11px;font-weight:700;color:#64748B;text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:6px;">Class</label>
        <div class="form-input" style="display:flex;align-items:center;font-weight:700;color:#334155;background:#F8FAFC;">
          <% if (cls) { %>
            Class: <%= cls.label || cls.class_label || cls.display_name || cls.name %><%= cls.section_name ? ' - ' + cls.section_name : '' %>
          <% } else { %>
            No attendance class assigned. Please contact School Admin.
          <% } %>
        </div>
      </div>
      <div class="col-md-3">
        <label style="font-size:11px;font-weight:700;color:#64748B;text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:6px;">Month</label>
        <input type="month" name="month" value="<%= month %>" class="form-input">
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
          <i class="fas fa-search"></i> View
        </button>
      </div>
      <% if(cls) { %>
      <div class="col-md-2">
        <a href="/teacher/attendance?date=<%= new Date().toISOString().slice(0,10) %>"
           class="btn btn-primary w-100">
          <i class="fa-solid fa-pen me-1"></i> Mark Today
        </a>
      </div>
      <% } %>
    </form>
  </div>

  <% if(cls && students && students.length > 0) { %>
    <div class="custom-table reveal reveal-delay-1">
      <div class="p-4 d-flex justify-content-between align-items-center" style="border-bottom:1px solid #E2E8F0;">
        <div>
          <span style="font-weight:700;color:#1E293B;font-size:15px;"><%= cls.label || cls.class_label || cls.display_name || cls.name %><%= cls.section && !(cls.label || cls.class_label || cls.display_name) ? ' (' + cls.section + ')' : '' %></span>
          <span style="color:#94A3B8;font-size:12px;margin-left:8px;"><%= month %> — <%= students.length %> students</span>
        </div>
        <div class="d-flex gap-3" style="font-size:11px;font-weight:600;">
          <span style="background:#D1FAE5;color:#065F46;padding:3px 10px;border-radius:20px;">P = Present</span>
          <span style="background:#FEE2E2;color:#991B1B;padding:3px 10px;border-radius:20px;">A = Absent</span>
          <span style="background:#FEF3C7;color:#92400E;padding:3px 10px;border-radius:20px;">L = Late</span>
        </div>
      </div>
      <div class="p-3">
        <%- include('../partials/monthlyGrid', { people: students, attendanceMap, days, nameLabel: 'Student' }) %>
      </div>
    </div>
  <% } else if(cls) { %>
    <div class="empty-state reveal">
      <i class="fa-solid fa-user-slash"></i>
      <p>No students in this class.</p>
    </div>
  <% } else { %>
    <div class="empty-state reveal">
      <i class="fa-solid fa-filter"></i>
      <p>No attendance class assigned. Please contact School Admin.</p>
    </div>
  <% } %>

</div>
