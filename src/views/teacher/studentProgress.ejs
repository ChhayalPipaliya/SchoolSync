<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'en' %>">
<head>
  <%- include('../partials/head', { title: (lan.Student_Progress || 'Student Progress') + ' | SchoolSync', needsCharts: true }) %>
  <style>
    .progress-header-card {
      background: linear-gradient(135deg, #4F46E5 0%, #3730A3 100%);
      border-radius: 16px;
      padding: 24px 28px;
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 22px;
      box-shadow: 0 4px 20px rgba(79,70,229,0.25);
    }
    .prog-avatar {
      width: 64px; height: 64px;
      border-radius: 50%;
      background: rgba(255,255,255,0.2);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; font-weight: 800;
      flex-shrink: 0;
      border: 3px solid rgba(255,255,255,0.3);
      overflow: hidden;
    }
    .prog-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .prog-header-info h1 {
      font-size: 20px; font-weight: 800;
      color: #fff; margin: 0 0 6px;
    }
    .prog-header-meta {
      display: flex; gap: 12px; flex-wrap: wrap;
      margin-top: 8px;
    }
    .prog-meta-pill {
      background: rgba(255,255,255,0.15);
      color: rgba(255,255,255,0.9);
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 500;
    }
    .prog-back-btn {
      margin-left: auto;
      background: rgba(255,255,255,0.15);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 8px;
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      display: flex; align-items: center; gap: 6px;
      flex-shrink: 0;
      transition: background 0.15s;
    }
    .prog-back-btn:hover { background: rgba(255,255,255,0.25); color: #fff; }

    .prog-metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 22px;
    }
    .prog-metric {
      background: #fff;
      border: 1px solid var(--border, #E4EAF2);
      border-radius: 14px;
      padding: 18px 20px;
      display: flex; align-items: center; gap: 14px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }
    .prog-metric-icon {
      width: 46px; height: 46px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
    }
    .prog-metric-val {
      font-size: 22px; font-weight: 800;
      color: var(--text, #0D1B2A); line-height: 1;
    }
    .prog-metric-lbl {
      font-size: 12px; color: var(--text-muted, #64748B);
      font-weight: 500; margin-top: 4px;
    }

    .charts-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 18px;
    }
    .chart-card {
      background: #fff;
      border: 1px solid var(--border, #E4EAF2);
      border-radius: 14px;
      padding: 20px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }
    .chart-card-full {
      background: #fff;
      border: 1px solid var(--border, #E4EAF2);
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 18px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }
    .chart-title {
      font-size: 14px; font-weight: 700;
      color: var(--text, #0D1B2A);
      margin-bottom: 16px;
      display: flex; align-items: center; gap: 8px;
    }
    .chart-title i { color: #4F46E5; }
    .chart-wrap { position: relative; height: 260px; }
    .chart-wrap-sm { position: relative; height: 200px; }
    .no-data-msg {
      height: 100%;
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 8px;
      color: var(--text-muted, #64748B);
      font-size: 13px;
    }
    .no-data-msg i { font-size: 28px; opacity: 0.4; }

    .heatmap-section {
      background: #fff;
      border: 1px solid var(--border, #E4EAF2);
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 18px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }
    .heatmap-grid {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 5px;
      margin-top: 12px;
    }
    .heatmap-day {
      width: 100%; aspect-ratio: 1;
      border-radius: 5px;
      cursor: default;
      position: relative;
    }
    .heatmap-day[data-status="present"]  { background: #059669; }
    .heatmap-day[data-status="absent"]   { background: #DC2626; }
    .heatmap-day[data-status="late"]     { background: #D97706; }
    .heatmap-day[data-status="no data"]  { background: #E4EAF2; }
    .heatmap-day:hover::after {
      content: attr(data-label);
      position: absolute;
      bottom: calc(100% + 5px);
      left: 50%; transform: translateX(-50%);
      background: #1E293B;
      color: #fff;
      padding: 3px 8px;
      border-radius: 5px;
      font-size: 11px;
      white-space: nowrap;
      z-index: 10;
      pointer-events: none;
    }
    .heatmap-legend {
      display: flex; gap: 14px; margin-top: 10px;
      flex-wrap: wrap;
    }
    .heatmap-legend-item {
      display: flex; align-items: center; gap: 5px;
      font-size: 12px; color: var(--text-muted, #64748B);
    }
    .heatmap-legend-dot {
      width: 12px; height: 12px; border-radius: 3px;
    }

    .marks-section {
      background: #fff;
      border: 1px solid var(--border, #E4EAF2);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 1px 4px rgba(0,0,0,0.05);
      margin-bottom: 18px;
    }

    @media (max-width: 900px) {
      .prog-metrics { grid-template-columns: repeat(2, 1fr); }
      .charts-2col  { grid-template-columns: 1fr; }
      .heatmap-grid { grid-template-columns: repeat(7, 1fr); }
    }
    @media (max-width: 600px) {
      .prog-metrics { grid-template-columns: 1fr 1fr; }
      .progress-header-card { flex-wrap: wrap; }
    }
    .prog-status-active { background: rgba(5,150,105,0.3) !important; }
    .prog-status-inactive { background: rgba(220,38,38,0.3) !important; }
    .prog-state-good { color: #059669 !important; background: #D1FAE5 !important; }
    .prog-state-warning { color: #D97706 !important; background: #FEF3C7 !important; }
    .prog-state-danger { color: #DC2626 !important; background: #FEE2E2 !important; }
    .prog-text-good { color: #059669 !important; }
    .prog-text-warning { color: #D97706 !important; }
    .prog-text-danger { color: #DC2626 !important; }
  </style>
</head>
<body class="teacher-theme">
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPath: '/teacher/students' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header') %>
    <%- include('../partials/flashMessages') %>
    <div class="page-body">
      <div class="card" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 16px; border: none; box-shadow: 0 3px 10px rgba(79, 70, 229, 0.16);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div class="prog-avatar" style="width: 44px; height: 44px; font-size: 18px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.25);">
              <% if (studentInfo.avatar) { %>
                <img src="<%= studentInfo.avatar %>" alt="<%= studentInfo.name %>" style="width:100%; height:100%; border-radius:10px; object-fit:cover;">
              <% } else { %>
                <%= (studentInfo.name || '?').charAt(0).toUpperCase() %>
              <% } %>
            </div>
            <div>
              <h1 style="font-size: 18px; font-weight: 800; margin: 0; color: #fff; letter-spacing: -0.02em;"><%= studentInfo.name %></h1>
              <div style="color: rgba(255,255,255,0.85); font-size: 11.5px; margin: 2px 0 6px;">
                <%= studentInfo.class_name %> — <%= studentInfo.section_name || '' %>
              </div>
              <div class="prog-header-meta" style="margin-top: 4px; gap: 6px;">
                <span class="prog-meta-pill" style="font-size: 11px; padding: 2px 8px;"><i class="fas fa-id-card"></i> <%- lan.Roll_No || 'Roll' %>: <%= studentInfo.roll_no || 'N/A' %></span>
                <span class="prog-meta-pill" style="font-size: 11px; padding: 2px 8px;"><i class="fas fa-file-alt"></i> <%- lan.Admission_No || 'Adm' %>: <%= studentInfo.admission_no %></span>
                <span class="prog-meta-pill" style="font-size: 11px; padding: 2px 8px;"><i class="fas fa-venus-mars"></i> <%= studentInfo.gender || 'N/A' %></span>
                <span class="prog-meta-pill <%= studentInfo.status === 'active' ? 'prog-status-active' : 'prog-status-inactive' %>" style="font-size: 11px; padding: 2px 8px;">
                  <%= studentInfo.status === 'active' ? (lan.Active || 'active') : (lan.Inactive || 'inactive') %>
                </span>
              </div>
            </div>
          </div>
          <a href="/teacher/students" class="btn" style="background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.25); font-weight: 700; padding: 6px 14px; font-size: 12px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
            <i class="fas fa-arrow-left"></i> <%- lan.Back || 'Back' %>
          </a>
        </div>
      </div>
      <div class="prog-metrics reveal reveal-delay-1" style="margin-bottom: 18px;">
        <% const attPct = parseFloat(attendance.percentage).toFixed(1);
           const attColor = attendance.percentage >= 75 ? '#059669' : attendance.percentage >= 60 ? '#D97706' : '#DC2626';
           const attBg    = attendance.percentage >= 75 ? '#D1FAE5' : attendance.percentage >= 60 ? '#FEF3C7' : '#FEE2E2';
        %>
        <div class="prog-metric">
          <div class="prog-metric-icon <%= attendance.percentage >= 75 ? 'prog-state-good' : attendance.percentage >= 60 ? 'prog-state-warning' : 'prog-state-danger' %>">
            <i class="fas fa-calendar-check"></i>
          </div>
          <div>
            <div class="prog-metric-val <%= attendance.percentage >= 75 ? 'prog-text-good' : attendance.percentage >= 60 ? 'prog-text-warning' : 'prog-text-danger' %>"><%= attPct %>%</div>
            <div class="prog-metric-lbl"><%- lan.Attendance || 'Attendance' %></div>
            <div style="font-size:11px;color:var(--text-muted,#64748B);margin-top:3px;">
              <%= attendance.present %>P · <%= attendance.absent %>A · <%= attendance.late %>L
            </div>
          </div>
        </div>
        <% const avgPct = parseFloat(studentAvgFormatted);
           const avgColor = avgPct >= 75 ? '#059669' : avgPct >= 50 ? '#D97706' : '#DC2626';
           const avgBg    = avgPct >= 75 ? '#D1FAE5' : avgPct >= 50 ? '#FEF3C7' : '#FEE2E2';
        %>
        <div class="prog-metric">
          <div class="prog-metric-icon <%= avgPct >= 75 ? 'prog-state-good' : avgPct >= 50 ? 'prog-state-warning' : 'prog-state-danger' %>">
            <i class="fas fa-chart-bar"></i>
          </div>
          <div>
            <div class="prog-metric-val <%= avgPct >= 75 ? 'prog-text-good' : avgPct >= 50 ? 'prog-text-warning' : 'prog-text-danger' %>"><%= avgPct %>%</div>
            <div class="prog-metric-lbl"><%- lan.Avg_Marks || 'Avg Marks' %></div>
            <div style="font-size:11px;color:var(--text-muted,#64748B);margin-top:3px;">
              <%- lan.Class_Avg || 'Class avg' %>: <%= classmatesAvg %>%
            </div>
          </div>
        </div>
        <div class="prog-metric">
          <div class="prog-metric-icon" style="background:#EEF2FF;color:#4F46E5">
            <i class="fas fa-trophy"></i>
          </div>
          <div>
            <div class="prog-metric-val">#<%= rank %></div>
            <div class="prog-metric-lbl"><%- lan.Class_Rank || 'Class Rank' %></div>
            <div style="font-size:11px;color:var(--text-muted,#64748B);margin-top:3px;">
              <%- lan.Of_Students || 'of' %> <%= totalClassmates %> <%- lan.Students || 'students' %>
            </div>
          </div>
        </div>
        <div class="prog-metric">
          <div class="prog-metric-icon" style="background:#FEF3C7;color:#D97706">
            <i class="fas fa-book-open"></i>
          </div>
          <div>
            <div class="prog-metric-val"><%= homeworkCount %></div>
            <div class="prog-metric-lbl"><%- lan.Homeworks || 'Homeworks' %></div>
            <div style="font-size:11px;color:var(--text-muted,#64748B);margin-top:3px;"><%- lan.This_Month || 'this month' %></div>
          </div>
        </div>
      </div>
      <div class="charts-2col reveal reveal-delay-2">
        <div class="chart-card">
          <div class="chart-title">
            <i class="fas fa-chart-line"></i> <%- lan.Marks_Trend_By_Subject || 'Marks Trend by Subject' %>
          </div>
          <div class="chart-wrap">
            <% if (datasets && datasets.length > 0) { %>
              <canvas id="lineChart" data-datasets="<%- JSON.stringify(datasets) %>" data-labels="<%- JSON.stringify(examNames) %>"></canvas>
            <% } else { %>
              <div class="no-data-msg">
                <i class="fas fa-chart-line"></i>
                <span><%- lan.No_Marks_Data_Available || 'No marks data available' %></span>
              </div>
            <% } %>
          </div>
        </div>
        <div class="chart-card">
          <div class="chart-title">
            <i class="fas fa-spider"></i> <%- lan.Subject_Wise_Performance || 'Subject-wise Performance' %>
          </div>
          <div class="chart-wrap">
            <% if (radarLabels && radarLabels.length > 0) { %>
              <canvas id="radarChart" data-labels="<%- JSON.stringify(radarLabels) %>" data-data="<%- JSON.stringify(radarData) %>"></canvas>
            <% } else { %>
              <div class="no-data-msg">
                <i class="fas fa-chart-pie"></i>
                <span><%- lan.No_Subject_Data_Available || 'No subject data available' %></span>
              </div>
            <% } %>
          </div>
        </div>
      </div>
      <div class="chart-card-full reveal reveal-delay-3">
        <div class="chart-title">
          <i class="fas fa-chart-bar"></i> <%- lan.Exam_Wise_Performance || 'Exam-wise Performance' %>
        </div>
        <div class="chart-wrap-sm">
          <% if (barLabels && barLabels.length > 0) { %>
            <canvas id="barChart" data-labels="<%- JSON.stringify(barLabels) %>" data-data="<%- JSON.stringify(barData) %>"></canvas>
          <% } else { %>
            <div class="no-data-msg">
              <i class="fas fa-chart-bar"></i>
              <span><%- lan.No_Exam_Data_Available || 'No exam data available' %></span>
            </div>
          <% } %>
        </div>
      </div>
      <div class="heatmap-section reveal reveal-delay-4">
        <div class="chart-title">
          <i class="fas fa-calendar-alt"></i> <%- lan.Attendance_Last_30_Days || 'Attendance — Last 30 Days' %>
        </div>
        <div class="heatmap-grid">
          <% last30Days.forEach(day => { %>
            <div class="heatmap-day"
                 data-status="<%= day.status %>"
                 data-label="<%= day.displayDate %> · <%= day.status %>">
            </div>
          <% }) %>
        </div>
        <div class="heatmap-legend">
          <div class="heatmap-legend-item">
            <div class="heatmap-legend-dot" style="background:#059669"></div> <%- lan.Present || 'Present' %>
          </div>
          <div class="heatmap-legend-item">
            <div class="heatmap-legend-dot" style="background:#DC2626"></div> <%- lan.Absent || 'Absent' %>
          </div>
          <div class="heatmap-legend-item">
            <div class="heatmap-legend-dot" style="background:#D97706"></div> <%- lan.Late || 'Late' %>
          </div>
          <div class="heatmap-legend-item">
            <div class="heatmap-legend-dot" style="background:#E4EAF2"></div> <%- lan.No_Data || 'No Data' %>
          </div>
        </div>
      </div>
      <div class="marks-section reveal reveal-delay-4">
        <div class="table-header-row" style="padding:16px 20px;border-bottom:1px solid var(--border,#E4EAF2);">
          <h3 class="table-heading"><i class="fas fa-list-alt"></i> <%- lan.Detailed_Marks || 'Detailed Marks' %></h3>
        </div>
        <% if (marks && marks.length > 0) { %>
          <div class="table-container">
            <table class="data-table">
              <thead>
                <tr>
                  <th><%- lan.Exam || 'Exam' %></th>
                  <th><%- lan.Subject || 'Subject' %></th>
                  <th><%- lan.Obtained || 'Obtained' %></th>
                  <th><%- lan.Total || 'Total' %></th>
                  <th>%</th>
                  <th><%- lan.Grade || 'Grade' %></th>
                  <th><%- lan.Status || 'Status' %></th>
                </tr>
              </thead>
              <tbody>
                <% marks.forEach(m => { const pct = m.total_marks > 0 ? ((m.obtained_marks / m.total_marks) * 100).toFixed(1) : '0.0'; %>
                <tr>
                  <td>
                    <strong style="color:var(--text,#0D1B2A)"><%= m.exam_name %></strong>
                    <div style="font-size:11px;color:var(--text-muted,#64748B);margin-top:2px;text-transform:capitalize">
                      <%= m.exam_type %>
                    </div>
                  </td>
                  <td>
                    <span style="font-weight:600;color:var(--text,#0D1B2A)"><%= m.subject_name %></span>
                    <% if (m.subject_code) { %>
                      <span style="font-size:11px;color:var(--text-muted,#64748B);margin-left:4px">(<%= m.subject_code %>)</span>
                    <% } %>
                  </td>
                  <td style="font-weight:700;color:var(--text,#0D1B2A)"><%= m.obtained_marks %></td>
                  <td style="color:var(--text-muted,#64748B)"><%= m.total_marks %></td>
                  <td>
                    <span class="fw-bold <%= parseFloat(pct) >= 75 ? 'text-success' : parseFloat(pct) >= 50 ? 'text-warning' : 'text-danger' %>">
                      <%= pct %>%
                    </span>
                  </td>
                  <td>
                    <span class="badge badge-primary" style="font-size:12px"><%= m.grade %></span>
                  </td>
                  <td>
                    <span class="badge <%= m.pass_fail === 'pass' ? 'badge-success' : 'badge-danger' %>">
                      <%= m.pass_fail === 'pass' ? (lan.Pass || 'Pass') : (lan.Fail || 'Fail') %>
                    </span>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state" style="padding:40px 24px">
            <div class="empty-state-icon"><i class="fas fa-file-alt"></i></div>
            <div class="empty-state-title"><%- lan.No_Marks_Found || 'No marks found' %></div>
            <div class="empty-state-text"><%- lan.No_Exam_Marks_Entered_Yet || 'No exam marks entered for this student yet.' %></div>
          </div>
        <% } %>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>
<script id="progLangData" type="application/json">
  <%- JSON.stringify({
    perfPct: lan.Performance_Percentage || 'Performance %',
    overallPct: lan.Overall_Percentage || 'Overall %',
    score: lan.Score || 'Score'
  }) %>
</script>
<script>
window.ssCharts = {};

const progLang = JSON.parse(document.getElementById('progLangData')?.textContent || '{}');
const COLORS = ['#4F46E5','#059669','#D97706','#DC2626','#0284C7','#DB2777','#EA580C','#7C3AED'];
const chartFont = { family: 'Inter', size: 12 };
const chartDefaults = {
  responsive: true,
  maintainAspectRatio: false,
  plugins: { legend: { labels: { font: chartFont, boxWidth: 12 } } }
};

(function () {
  const ctx = document.getElementById('lineChart');
  if (!ctx) return;
  const datasets = JSON.parse(ctx.dataset.datasets || '[]');
  const labels   = JSON.parse(ctx.dataset.labels || '[]');
  window.ssCharts.line = new Chart(ctx, {
    type: 'line',
    data: { labels, datasets },
    options: {
      ...chartDefaults,
      scales: {
        y: {
          min: 0, max: 100,
          ticks: { font: chartFont, callback: v => v + '%' },
          grid: { color: '#F1F5F9' }
        },
        x: { ticks: { font: chartFont }, grid: { display: false } }
      },
      plugins: {
        legend: { labels: { font: chartFont, boxWidth: 12 } },
        tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y + '%' } }
      }
    }
  });
})();

(function () {
  const ctx = document.getElementById('radarChart');
  if (!ctx) return;
  const labels = JSON.parse(ctx.dataset.labels || '[]');
  const data = JSON.parse(ctx.dataset.data || '[]');
  window.ssCharts.radar = new Chart(ctx, {
    type: 'radar',
    data: {
      labels,
      datasets: [{
        label: progLang.perfPct || 'Performance %',
        data,
        backgroundColor: 'rgba(79,70,229,0.12)',
        borderColor: '#4F46E5',
        pointBackgroundColor: '#4F46E5',
        pointRadius: 4,
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        r: {
          min: 0, max: 100,
          ticks: { font: chartFont, stepSize: 25, callback: v => v + '%' },
          pointLabels: { font: { ...chartFont, size: 11 } },
          grid: { color: '#EEF2FF' }
        }
      },
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => ctx.parsed.r + '%' } }
      }
    }
  });
})();

(function () {
  const ctx = document.getElementById('barChart');
  if (!ctx) return;
  const labels = JSON.parse(ctx.dataset.labels || '[]');
  const data = JSON.parse(ctx.dataset.data || '[]');
  window.ssCharts.bar = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: progLang.overallPct || 'Overall %',
        data,
        backgroundColor: COLORS.map((c, i) => i < data.length ? c + 'CC' : c),
        borderColor: COLORS,
        borderWidth: 1.5,
        borderRadius: 6
      }]
    },
    options: {
      ...chartDefaults,
      scales: {
        y: {
          min: 0, max: 100,
          ticks: { font: chartFont, callback: v => v + '%' },
          grid: { color: '#F1F5F9' }
        },
        x: { ticks: { font: chartFont }, grid: { display: false } }
      },
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => (progLang.score || 'Score') + ': ' + ctx.parsed.y + '%' } }
      }
    }
  });
})();
</script>
</body>
</html>
