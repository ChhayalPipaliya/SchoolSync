        <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;">
            <div>
                <h1 style="font-size:22px; font-weight:800; margin:0; display:flex; align-items:center; gap:10px;">
                    <i class="fa-solid fa-calendar-days"></i> <%- lan.Academic_Calendar || 'Academic Calendar' %>
                </h1>
                <p style="font-size:13px; opacity:0.9; margin:4px 0 0;"><%- lan.Academic_Calendar_Subtitle || 'School events, holidays and exam schedule' %></p>
            </div>
            <button onclick="openSuggestModal()" class="btn t-banner-suggest-btn" id="suggestEventBtn" style="background:#fff; color:#7C3AED; border:none; font-weight:700; padding:9px 16px; font-size:13px; border-radius:10px; display:inline-flex; align-items:center; gap:6px; box-shadow:0 2px 8px rgba(0,0,0,0.1); cursor:pointer;">
                <i class="fa-solid fa-lightbulb"></i> <%- lan.Suggest_Event || 'Suggest Event' %>
            </button>
        </div>
    </div>
    <div class="card mb-3 p-3" style="border-radius:14px;border:1px solid #E2E8F0;box-shadow:0 2px 8px rgba(124,58,237,0.04);">
        <div class="event-legend">
            <span class="legend-badge legend-holiday"><i class="fa-solid fa-umbrella-beach me-1"></i> <%- lan.Holiday || 'Holiday' %></span>
            <span class="legend-badge legend-exam"><i class="fa-solid fa-file-pen me-1"></i> <%- lan.Exam || 'Exam' %></span>
            <span class="legend-badge legend-event"><i class="fa-solid fa-sparkles me-1"></i> <%- lan.Event || 'Event' %></span>
            <span class="legend-badge legend-meeting"><i class="fa-solid fa-comments me-1"></i> <%- lan.Meeting || 'Meeting' %></span>
            <span class="legend-badge legend-suggested"><i class="fa-solid fa-lightbulb me-1"></i> <%- lan.Suggested_Event || 'Suggested Event' %></span>
