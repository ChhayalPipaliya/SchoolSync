</div>
<div id="popupOverlay" style="display:none;position:fixed;inset:0;z-index:1059;" onclick="closePopup()"></div>
<div class="cal-modal-backdrop" id="suggestModal">
    <div class="cal-modal">
        <div class="cal-modal-header">
            <h5><i class="fa-solid fa-lightbulb me-2" style="color:#7C3AED;"></i><%- lan.Suggest_Calendar_Event || 'Suggest Calendar Event' %></h5>
            <button onclick="closeSuggestModal()" style="background:none;border:none;cursor:pointer;color:#94A3B8;font-size:20px;" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="cal-modal-body">
            <div class="cal-form-group">
                <label><%- lan.Event_Title || 'Event Title' %> *</label>
                <input type="text" id="suggestTitle" placeholder="<%- lan.Event_Title_Placeholder || 'e.g. Science Exhibition Trip' %>" maxlength="255">
            </div>
            <div class="cal-form-row-2col" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="cal-form-group">
                    <label><%- lan.Start_Date_Time || 'Start Date & Time' %> *</label>
                    <input type="datetime-local" id="suggestStart">
                </div>
                <div class="cal-form-group">
                    <label><%- lan.End_Date_Time || 'End Date & Time' %></label>
                    <input type="datetime-local" id="suggestEnd">
                </div>
            </div>
            <div class="cal-form-row-2col" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="cal-form-group">
                    <label><%- lan.Event_Type || 'Event Type' %></label>
                    <select id="suggestType">
                        <option value="Event">🎉 <%- lan.Event || 'Event' %></option>
                        <option value="Holiday">🏖️ <%- lan.Holiday || 'Holiday' %></option>
                        <option value="Exam">📝 <%- lan.Exam || 'Exam' %></option>
                        <option value="Meeting">🤝 <%- lan.Meeting || 'Meeting' %></option>
                    </select>
