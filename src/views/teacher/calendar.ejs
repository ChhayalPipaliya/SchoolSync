</div>
<div class="event-popup" id="eventPopup">
    <button class="popup-close" onclick="closePopup()"><i class="fa-solid fa-xmark"></i></button>
    <div id="popupType" class="popup-type-badge"></div>
    <div id="popupTitle" style="font-size:16px;font-weight:700;color:#1E293B;margin-bottom:10px;"></div>
    <div id="popupDates" style="font-size:12px;color:#64748B;margin-bottom:8px;"></div>
    <div id="popupAudience" style="font-size:12px;color:#64748B;margin-bottom:10px;"></div>
    <div id="popupDesc" style="font-size:13px;color:#475569;margin-bottom:10px;"></div>
    <div id="popupDeleteBtnContainer" class="mt-3 text-end" style="display:none; border-top: 1px solid #F1F5F9; padding-top: 10px;">
        <button id="deleteSuggestBtn" class="btn btn-danger btn-xs">
            <i class="fa-solid fa-trash me-1"></i> <%- lan.Delete_Suggestion || 'Delete Suggestion' %>
        </button>
