                <div class="cal-form-group">
                    <label><%- lan.Visible_To || 'Visible To' %></label>
                    <select id="suggestAudience">
                        <option value="All">👥 <%- lan.All || 'All' %></option>
                        <option value="Students">🎓 <%- lan.Students || 'Students' %></option>
                        <option value="Teachers">👨‍🏫 <%- lan.Teachers || 'Teachers' %></option>
                        <option value="Staff">🏢 <%- lan.Staff || 'Staff' %></option>
                    </select>
                </div>
            </div>
            <div class="cal-form-group">
                <label><%- lan.Description || 'Description' %></label>
                <textarea id="suggestDesc" placeholder="<%- lan.Event_Description_Placeholder || 'Briefly describe the holiday or event context...' %>"></textarea>
            </div>
        </div>
        <div class="cal-modal-footer">
            <button onclick="closeSuggestModal()" class="btn btn-sm btn-cancel" style="background:#F1F5F9;color:#475569;border:none; border-radius:8px; padding:6px 12px;"><%- lan.Cancel || 'Cancel' %></button>
            <button onclick="submitSuggestion()" id="submitBtn" class="btn btn-sm btn-primary" style="background:#7C3AED;border-color:#7C3AED;border-radius:8px; padding:6px 12px;min-width:100px;">
                <span id="submitBtnText"><i class="fa-solid fa-check me-1"></i><%- lan.Submit_Suggestion || 'Submit Suggestion' %></span>
                <span id="submitBtnLoading" style="display:none;"><i class="fa-solid fa-spinner fa-spin me-1"></i><%- lan.Submitting || 'Submitting...' %></span>
            </button>
        </div>
    </div>
<script id="calLangData" type="application/json">
    <%- JSON.stringify({
        suggested: lan.Suggested || 'Suggested',
        forLabel: lan.For || 'For',
        confirmDelete: lan.Confirm_Delete_Event_Suggestion || 'Are you sure you want to cancel this event suggestion?',
        failedDelete: lan.Failed_Delete_Suggestion || 'Failed to delete suggestion',
        errorDeleting: lan.Error_Deleting_Suggestion || 'Error deleting suggestion',
        pleaseEnterTitle: lan.Please_Enter_Event_Title || 'Please enter an event title.',
        pleaseSelectStartDate: lan.Please_Select_Start_Date || 'Please select a start date.',
        failedSubmit: lan.Failed_Submit_Suggestion || 'Failed to submit suggestion',
        networkError: lan.Network_Error_Retry || 'Network error. Please try again.',
        today: lan.Today || 'Today',
        month: lan.Month || 'Month',
        week: lan.Week || 'Week',
        day: lan.Day || 'Day',
        list: lan.List || 'List'
    }) %>
</script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script>
    const TYPE_BADGES = {
        Holiday: { icon:'fa-umbrella-beach' },
        Exam:    { icon:'fa-file-pen' },
        Event:   { icon:'fa-sparkles' },
        Meeting: { icon:'fa-comments' }
    };

    const calLang = JSON.parse(document.getElementById('calLangData')?.textContent || '{}');
    const textSuggested = calLang.suggested || 'Suggested';
    const textFor = calLang.forLabel || 'For';
    const textConfirmDelete = calLang.confirmDelete || 'Are you sure you want to cancel this event suggestion?';
    const textFailedDelete = calLang.failedDelete || 'Failed to delete suggestion';
    const textErrorDeleting = calLang.errorDeleting || 'Error deleting suggestion';
    const textPleaseEnterTitle = calLang.pleaseEnterTitle || 'Please enter an event title.';
    const textPleaseSelectStartDate = calLang.pleaseSelectStartDate || 'Please select a start date.';
    const textFailedSubmit = calLang.failedSubmit || 'Failed to submit suggestion';
    const textNetworkError = calLang.networkError || 'Network error. Please try again.';

    let calendar;
    document.addEventListener('DOMContentLoaded', function() {
        const el = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(el, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left:   'prev,next title today',
                center: '',
                right:  'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
            },
            height: 'auto',
            contentHeight: 640,
            editable: false,
            selectable: false,
            nowIndicator: true,
            buttonText: {
                today: calLang.today || 'Today',
                month: calLang.month || 'Month',
                week:  calLang.week || 'Week',
                day:   calLang.day || 'Day',
                list:  calLang.list || 'List'
            },
            buttonIcons: { prev: 'chevron-left', next: 'chevron-right' },

            events: function(fetchInfo, successCb, failureCb) {
                fetch(`/teacher/api/academic-events?start=${fetchInfo.startStr}&end=${fetchInfo.endStr}`)
                    .then(r => r.json())
                    .then(d => { if(d.success) successCb(d.events); else failureCb(new Error(d.message)); })
                    .catch(failureCb);
            },

            eventDidMount: function(info) {
                const ep = info.event.extendedProps || {};
                const type = (ep.event_type || 'Event').toLowerCase();
                const isPending = ep.status === 'pending';

                info.el.classList.add('fc-custom-event');
                if (isPending) {
                    info.el.classList.add('fc-event-pending');
                } else if (type === 'holiday') {
                    info.el.classList.add('fc-event-holiday');
                } else if (type === 'exam') {
                    info.el.classList.add('fc-event-exam');
                } else if (type === 'meeting') {
                    info.el.classList.add('fc-event-meeting');
                } else {
                    info.el.classList.add('fc-event-event');
                }
                info.el.style.borderRadius = '6px';
                info.el.style.fontWeight = '600';
                info.el.style.boxShadow = '0 1px 3px rgba(0,0,0,0.05)';
            },

            eventClick: function(info) {
                const e  = info.event;
                const ep = e.extendedProps;
                const type   = ep.event_type || 'Event';
                const isPending = ep.status === 'pending';
                const typeKey = (type || 'event').toLowerCase();

                const popupType = document.getElementById('popupType');
                popupType.textContent = type + (isPending ? ' (' + textSuggested + ')' : '');
                popupType.className = 'popup-type-badge ' + (isPending ? 'legend-suggested' : (['holiday','exam','event','meeting'].includes(typeKey) ? 'legend-' + typeKey : 'legend-event'));

                document.getElementById('popupTitle').textContent = e.title;

                const startFmt = e.start ? e.start.toLocaleDateString('en-IN', { weekday:'short', day:'2-digit', month:'short', year:'numeric' }) : '';
                const endFmt   = e.end   ? e.end.toLocaleDateString('en-IN', { weekday:'short', day:'2-digit', month:'short', year:'numeric' }) : '';
                document.getElementById('popupDates').innerHTML =
                    `<i class="fa-regular fa-calendar me-1"></i> ${startFmt}${endFmt && endFmt !== startFmt ? ' → ' + endFmt : ''}`;
                document.getElementById('popupAudience').innerHTML =
                    `<i class="fa-solid fa-users me-1"></i> ${textFor}: ${ep.target_audience || 'All'}`;
                document.getElementById('popupDesc').textContent = ep.description || '';

                const deleteContainer = document.getElementById('popupDeleteBtnContainer');
                const deleteBtn = document.getElementById('deleteSuggestBtn');
                if (ep.status === 'pending') {
                    deleteContainer.style.display = 'block';
                    deleteBtn.onclick = async function() {
                        if (!confirm(textConfirmDelete)) return;
                        try {
                            const res = await fetch(`/teacher/api/academic-events/${e.id}`, { method: 'DELETE' });
                            const data = await res.json();
                            if (data.success) {
                                closePopup();
                                calendar.refetchEvents();
                                showAlert(data.message, 'success');
                            } else {
                                showAlert(data.message || textFailedDelete, 'error');
                            }
                        } catch (err) {
                            showAlert(textErrorDeleting, 'error');
                        }
                    };
                } else {
                    deleteContainer.style.display = 'none';
                }

                const popup = document.getElementById('eventPopup');
                const rect  = info.el.getBoundingClientRect();
                const top   = Math.min(rect.bottom + 8, window.innerHeight - 260);
                const left  = Math.min(rect.left, window.innerWidth - 320);
                popup.style.top  = top + 'px';
                popup.style.left = left + 'px';
                popup.classList.add('active');
                document.getElementById('popupOverlay').style.display = 'block';
            },

            eventContent: function(arg) {
                const ep = arg.event.extendedProps || {};
                const type = ep.event_type || 'Event';
                const isPending = ep.status === 'pending';
                const iconClass = isPending ? 'fa-lightbulb' : (TYPE_BADGES[type]?.icon || 'fa-calendar-day');
                return { 
                    html: `<div style="display:flex;align-items:center;gap:5px;padding:2px 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11.5px;color:inherit;">
                        <i class="fa-solid ${iconClass}" style="font-size:10.5px;opacity:0.85;flex-shrink:0;"></i>
                        <span style="overflow:hidden;text-overflow:ellipsis;">${arg.event.title}</span>
                    </div>`
                };
            }
        });
        calendar.render();

        window.addEventListener('themeChanged', function() {
            if (calendar) calendar.render();
        });
    });

    function closePopup() {
        document.getElementById('eventPopup').classList.remove('active');
        document.getElementById('popupOverlay').style.display = 'none';
    }

    function openSuggestModal() {
        document.getElementById('suggestTitle').value = '';
        document.getElementById('suggestStart').value = '';
        document.getElementById('suggestEnd').value = '';
        document.getElementById('suggestType').value = 'Event';
        document.getElementById('suggestAudience').value = 'All';
        document.getElementById('suggestDesc').value = '';
        document.getElementById('suggestModal').classList.add('active');
    }

    function closeSuggestModal() {
        document.getElementById('suggestModal').classList.remove('active');
    }

    async function submitSuggestion() {
        const title = document.getElementById('suggestTitle').value.trim();
        const start = document.getElementById('suggestStart').value;

        if (!title) return showAlert(textPleaseEnterTitle, 'error');
        if (!start) return showAlert(textPleaseSelectStartDate, 'error');

        const payload = {
            title,
            description: document.getElementById('suggestDesc').value,
            start_date: start,
            end_date: document.getElementById('suggestEnd').value || null,
            event_type: document.getElementById('suggestType').value,
            target_audience: document.getElementById('suggestAudience').value
        };

        setSubmittingState(true);

        try {
            const res = await fetch('/teacher/api/academic-events', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();

            if (data.success) {
                closeSuggestModal();
                calendar.refetchEvents();
                showAlert(data.message, 'success');
            } else {
                showAlert(data.message || textFailedSubmit, 'error');
            }
        } catch (err) {
            showAlert(textNetworkError, 'error');
        } finally {
            setSubmittingState(false);
        }
    }

    function setSubmittingState(submitting) {
        document.getElementById('submitBtn').disabled = submitting;
        document.getElementById('submitBtnText').style.display = submitting ? 'none' : 'inline';
        document.getElementById('submitBtnLoading').style.display = submitting ? 'inline' : 'none';
    }

    function showAlert(msg, type) {
        const existing = document.getElementById('calAlert');
        if (existing) existing.remove();

        const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || document.documentElement.classList.contains('light-mode-disabled');
        const div = document.createElement('div');
        div.id = 'calAlert';
        const color = type === 'success' ? '#10B981' : '#EF4444';
        const bg    = isDark ? '#151D30' : (type === 'success' ? '#ECFDF5' : '#FEF2F2');
        const textCol = isDark ? '#F1F5F9' : color;
        div.style.cssText = `
            position:fixed; top:24px; right:24px; z-index:99999;
            background:${bg}; color:${textCol}; border:1.5px solid ${color};
            padding:12px 20px; border-radius:12px; font-size:13px; font-weight:600;
            box-shadow:0 8px 24px rgba(0,0,0,0.2); animation:slideIn 0.3s ease;
        `;
        div.innerHTML = `<i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation'} me-2" style="color:${color};"></i>${msg}`;

        const style = document.createElement('style');
        style.textContent = '@keyframes slideIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}';
        document.head.appendChild(style);

        document.body.appendChild(div);
        setTimeout(() => div.remove(), 4000);
    }
</script>