<div class="card max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-4">
        <div class="card-title">
            <i class="fas fa-info-circle"></i>
            <%- lan.Meeting_Details || 'Meeting Details' %>
        </div>
        <a href="/teacher/meetings" class="btn btn-sm btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> <%- lan.Back_To_List || 'Back to List' %>
        </a>
    </div>
    <div class="space-y-4">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <%
                    let badgeClass = 'badge-secondary';
                    if (meeting.status === 'scheduled') badgeClass = 'badge-primary';
                    if (meeting.status === 'live') badgeClass = 'badge-success animate-pulse';
                    if (meeting.status === 'completed') badgeClass = 'badge-secondary';
                %>
                <span class="badge <%= badgeClass %>"><%= meeting.status === 'scheduled' ? (lan.Scheduled || 'Scheduled') : (meeting.status === 'live' ? (lan.Live || 'Live') : (meeting.status === 'completed' ? (lan.Completed || 'Completed') : (meeting.status === 'cancelled' ? (lan.Cancelled || 'Cancelled') : meeting.status))) %></span>
            </div>
            <h3 class="h4 font-bold text-gray-800"><%= meeting.title %></h3>
            <p class="text-xs text-gray-400 mt-1"><%- lan.Scheduled_By || 'Scheduled by' %> <strong><%= creatorName %></strong></p>
        </div>
        <% if (meeting.description) { %>
            <div class="p-3 bg-slate-50 border border-slate-100 rounded-lg text-sm text-gray-700 leading-relaxed">
                <%= meeting.description %>
            </div>
        <% } %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
            <div class="flex gap-3 items-center p-3 bg-slate-50 rounded-lg border border-slate-100">
                <i class="far fa-calendar text-primary fa-lg"></i>
                <div>
                    <div class="text-[10px] text-gray-400 font-bold uppercase"><%- lan.Scheduled_Time || 'Scheduled Time' %></div>
                    <div class="text-xs font-bold text-gray-700">
                        <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                    </div>
                </div>
            </div>
            <div class="flex gap-3 items-center p-3 bg-slate-50 rounded-lg border border-slate-100">
                <i class="far fa-clock text-purple-600 fa-lg"></i>
                <div>
                    <div class="text-[10px] text-gray-400 font-bold uppercase"><%- lan.Duration || 'Duration' %></div>
                    <div class="text-xs font-bold text-gray-700"><%= meeting.duration_minutes %> <%- lan.Minutes || 'Minutes' %></div>
                </div>
            </div>
            <div class="flex gap-3 items-center p-3 bg-slate-50 rounded-lg border border-slate-100">
                <i class="fas fa-users text-cyan-600 fa-lg"></i>
                <div>
                    <div class="text-[10px] text-gray-400 font-bold uppercase"><%- lan.Audience || 'Audience' %></div>
                    <div class="text-xs font-bold text-gray-700 capitalize"><%= targetDisplay %></div>
                </div>
            </div>
            <div class="flex gap-3 items-center p-3 bg-slate-50 rounded-lg border border-slate-100">
                <i class="fas fa-video text-emerald-600 fa-lg"></i>
                <div>
                    <div class="text-[10px] text-gray-400 font-bold uppercase"><%- lan.Status || 'Status' %></div>
                    <div class="text-xs font-bold text-gray-700 capitalize"><%= meeting.status === 'scheduled' ? (lan.Scheduled || 'Scheduled') : (meeting.status === 'live' ? (lan.Live || 'Live') : (meeting.status === 'completed' ? (lan.Completed || 'Completed') : (meeting.status === 'cancelled' ? (lan.Cancelled || 'Cancelled') : meeting.status))) %></div>
                </div>
            </div>
        </div>
        <% if (attendance) { %>
            <div class="p-3 bg-blue-50 border border-blue-100 rounded-lg mt-4">
                <div class="text-xs font-bold text-blue-800 mb-1"><i class="fas fa-check-circle me-1"></i> <%- lan.Your_Attendance_Log || 'Your Attendance Log' %></div>
                <div class="text-xs text-blue-700">
                    <%- lan.Joined_At || 'Joined at:' %> <%= new Date(attendance.joined_at).toLocaleString('en-IN') %>
                    <% if (attendance.left_at) { %>
                        · <%- lan.Left_At || 'Left at:' %> <%= new Date(attendance.left_at).toLocaleString('en-IN') %>
                    <% } %>
                    · <%- lan.Total_Duration || 'Total duration:' %> <strong><%= attendance.duration_minutes %> <%- lan.Minutes || 'mins' %></strong>
                </div>
            </div>
        <% } %>
        <div class="flex flex-col items-center justify-center border-t border-slate-100 pt-5 mt-5">
            <%
                const startMs = new Date(meeting.scheduled_at).getTime();
                const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                const now = Date.now();
                const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
            %>
            <% if (canJoin) { %>
                <p class="text-xs text-gray-500 mb-3"><%- lan.Meeting_Room_Currently_Open || 'The meeting room is currently open.' %></p>
                <a href="/teacher/meetings/<%= meeting.id %>/join" class="btn btn-success px-5 py-2">
                    <i class="fas fa-video me-1"></i> <%- lan.Join_Meeting_Room || 'Join Meeting Room' %>
                </a>
            <% } else if (meeting.status === 'cancelled') { %>
                <p class="text-xs text-rose-500 font-semibold mb-3"><%- lan.Meeting_Has_Been_Cancelled || 'This meeting has been cancelled.' %></p>
                <button class="btn btn-secondary opacity-50 cursor-not-allowed" disabled><%- lan.Join_Unavailable || 'Join Unavailable' %></button>
            <% } else if (meeting.status === 'completed') { %>
                <p class="text-xs text-gray-400 mb-3"><%- lan.Meeting_Already_Completed || 'This meeting has already completed.' %></p>
                <button class="btn btn-secondary opacity-50 cursor-not-allowed" disabled><%- lan.Meeting_Completed || 'Meeting Completed' %></button>
            <% } else { %>
                <p class="text-xs text-gray-500 mb-3"><%- lan.Join_Window_Opens_Info || 'Join window opens 15 minutes before the start time.' %></p>
                <button class="btn btn-secondary opacity-50 cursor-not-allowed" disabled><%- lan.Join_Not_Open || 'Join Not Open' %></button>
            <% } %>
        </div>
    </div>
</div>