<%- include('../partials/head') %>
    <style>
        .grid-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        .grid-table th {
            background-color: #F1F5F9;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: #475569;
            padding: 12px;
            border: 1px solid #E2E8F0;
        }

        .grid-table td {
            border: 1px solid #E2E8F0;
            padding: 8px;
            vertical-align: top;
        }

        .period-col {
            background-color: #F8FAFC;
            font-weight: 600;
            width: 180px;
        }

        .day-col {
            min-width: 140px;
            background-color: #ffffff;
        }

        .filled-cell {
            background-color: #EEF2FF;
            border: 1px solid #E0E7FF;
            border-radius: 8px;
            padding: 12px;
        }

        .empty-cell {
            border: 1px dashed #F1F5F9;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            min-height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #CBD5E1;
            font-size: 12px;
        }

        .break-cell {
            background-color: #FEF3C7;
            border: 1px solid #FDE68A;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            font-weight: 700;
            color: #D97706;
        }
    </style>
    <div class="app-wrapper teacher-theme">
        <%- include('../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
            <div class="main-panel">
                <%- include('../partials/header') %>
                    <div class="content">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.My_Timetable
                                        || 'My Timetable' %></h2>
                                <p class="text-xs text-gray-500 mt-1"><%- lan.Weekly_Timetable_Subtitle
                                        || 'Your weekly teaching schedule and class timings' %></p>
                            </div>
                        </div>
                        <%- include('../partials/flashMessages') %>
                            <% if (periods.length===0 || !hasEntries) { %>
                                <div class="card text-center py-16">
                                    <div class="empty-state">
                                        <div class="empty-state-icon"
                                            style="background: var(--primary-light); color: var(--primary);">
                                            <i class="fa-solid fa-calendar-alt"></i>
                                        </div>
                                        <h3 class="empty-state-title"><%- lan.No_Timetable_Assigned_Yet
                                                || 'No timetable assigned yet' %></h3>
                                        <p class="empty-state-text"><%- lan.Class_Timetable_Not_Assigned_Notice
                                                || 'Your class timetable schedule has not been assigned by the administrator.'
                                                %></p>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="table-card">
                                        <div class="table-header-row">
                                            <div>
                                                <h5 class="table-heading"><%- lan.Weekly_Schedule || 'Weekly Schedule'
                                                        %></h5>
                                                <span style="font-size:12px;color:#94A3B8;"><%-
                                                        lan.Teaching_Lectures_Across_Week
                                                        || 'Teaching lectures across the week' %></span>
                                            </div>
                                        </div>
                                        <div class="table-container" style="overflow-x: auto;">
                                            <table class="grid-table">
                                                <thead>
                                                    <tr>
                                                        <th class="period-col"><%- lan.Period_Time || 'Period / Time' %>
                                                        </th>
                                                        <% days.forEach(day=> { %>
                                                            <th>
                                                                <%= typeof lan[day] !=='undefined' ? lan[day] : day %>
                                                            </th>
                                                            <% }) %>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% periods.forEach(period=> { %>
                                                        <tr>
                                                            <td class="period-col">
                                                                <div class="font-bold text-gray-800">
                                                                    <%= period.label %>
                                                                </div>
                                                                <div class="text-[11px] text-gray-500 mt-1">
                                                                    <%= period.start_time.slice(0, 5) %> - <%=
                                                                            period.end_time.slice(0, 5) %>
                                                                </div>
                                                                <% if (period.is_break) { %>
                                                                    <div class="mt-1"><span
                                                                            class="badge badge-warning"><%- lan.Break
                                                                                || 'Break' %></span></div>
                                                                    <% } %>
                                                            </td>
                                                            <% days.forEach(day=> { %>
                                                                <td class="day-col">
                                                                    <% if (period.is_break) { %>
                                                                        <div class="break-cell">
                                                                            <i class="fa-solid fa-coffee me-1"></i> <%-
                                                                                lan.Break || 'BREAK' %>
                                                                        </div>
                                                                        <% } else { %>
                                                                            <% const entry=timetableGrid[day] &&
                                                                                timetableGrid[day][period.id]; %>
                                                                                <% if (entry) { %>
                                                                                    <div class="filled-cell">
                                                                                        <div
                                                                                            class="font-bold text-indigo-900 text-sm">
                                                                                            <%= entry.subject_name %>
                                                                                        </div>
                                                                                        <div
                                                                                            class="text-xs text-indigo-600 mt-1">
                                                                                            <i
                                                                                                class="fa-solid fa-graduation-cap me-1"></i>
                                                                                            <%= entry.class_name %> -
                                                                                                <%= entry.section %>
                                                                                        </div>
                                                                                    </div>
                                                                                    <% } else { %>
                                                                                        <div class="empty-cell"><%-
                                                                                                lan.Free_Period
                                                                                                || 'Free Period' %>
                                                                                        </div>
                                                                                        <% } %>
                                                                                            <% } %>
                                                                </td>
                                                                <% }) %>
                                                        </tr>
                                                        <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <% } %>
                    </div>
                    <%- include('../partials/footer') %>
            </div>
    </div>