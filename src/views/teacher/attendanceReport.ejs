<div class="page-body">
  <div class="stats-row reveal" style="grid-template-columns:repeat(4,1fr);margin-bottom:20px;">
    <div class="stat-card text-center">
      <div class="stat-label">Total</div>
      <div class="stat-value"><%= students.length %></div>
    </div>
    <div class="stat-card text-center" style="border-top:3px solid #059669;">
      <div class="stat-label" style="color:#059669;">Present</div>
      <div class="stat-value" style="color:#059669;"><%= present %></div>
    </div>
    <div class="stat-card text-center" style="border-top:3px solid #DC2626;">
      <div class="stat-label" style="color:#DC2626;">Absent</div>
      <div class="stat-value" style="color:#DC2626;"><%= absent %></div>
    </div>
    <div class="stat-card text-center" style="border-top:3px solid #D97706;">
      <div class="stat-label" style="color:#D97706;">Late</div>
      <div class="stat-value" style="color:#D97706;"><%= late %></div>
    </div>
  </div>
  <div class="table-card reveal reveal-delay-1">
    <div class="table-header-row">
      <div class="table-heading">
        <%= cls.name %> — Section <%= cls.section %>
        <span style="color:#94A3B8;font-size:13px;font-weight:400;margin-left:8px;"><%= date %></span>
      </div>
      <a href="/teacher/attendance?date=<%= date %>"
         class="btn btn-primary">
        <i class="fa-solid fa-pen"></i> Edit Attendance
      </a>
    </div>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Student</th>
            <th>Roll No</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(function(s, i) { %>
            <tr>
              <td style="color:#94A3B8;"><%= i + 1 %></td>
              <td style="font-weight:600;color:#1E293B;"><%= s.first_name %> <%= s.last_name %></td>
              <td>
                <span class="badge badge-light">
                  <%= s.roll_no || '—' %>
                </span>
              </td>
              <td>
                <% if(s.attendanceStatus === 'present') { %>
                  <span class="badge badge-success">✓ Present</span>
                <% } else if(s.attendanceStatus === 'absent') { %>
                  <span class="badge badge-danger">✗ Absent</span>
                <% } else if(s.attendanceStatus === 'late') { %>
                  <span class="badge badge-warning">⏱ Late</span>
                <% } else { %>
                  <span style="color:#94A3B8;font-size:12px;">Not marked</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</div>
