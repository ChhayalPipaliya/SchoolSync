<style>
    .fail-row {
        background: #FFF5F5 !important;
    }
</style>
<div class="page-body">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div>
            <h2 style="font-size: 22px; font-weight: 700; color: #1E293B; margin: 0;"><i class="fa-solid fa-chart-bar me-2" style="color: var(--primary);"></i><%- lan.Result_Analysis || 'Result Analysis' %></h2>
            <div style="font-size: 12px; color: #94A3B8; margin-top: 4px;"><%- lan.Result_Analysis_Subtitle || 'View class performance and student analytics' %></div>
        </div>
        <a href="/teacher/marks" class="btn btn-secondary">
            <i class="fa-solid fa-pen me-1"></i> <%- lan.Enter_Marks || 'Enter Marks' %>
        </a>
    </div>
    <div class="card mb-4">
        <form method="GET" action="/teacher/marks/analysis" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;"><%- lan.Exam || 'Exam' %></label>
                <select name="examId" class="form-select">
                    <option value="">-- <%- lan.Select_Exam || 'Select Exam' %> --</option>
                    <% exams.forEach(e => { %>
                        <option value="<%= e.id %>" <%= selectedExam && selectedExam.id == e.id ? 'selected' : '' %>><%= e.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;"><%- lan.Class || 'Class' %></label>
                <select name="classId" class="form-select">
                    <option value="">-- <%- lan.Select_Class || 'Select Class' %> --</option>
                    <% classes.forEach(c => { %>
                        <option value="<%= c.id %>" <%= selectedClass == c.id ? 'selected' : '' %>><%- lan.Class || 'Class' %> <%= c.class_name %> - <%- lan.Section || 'Sec' %> <%= c.section %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-search me-1"></i> <%- lan.View_Analysis || 'View Analysis' %>
                </button>
            </div>
        </form>
    </div>
    <% if (analysisData && selectedExam) { %>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div style="background: var(--primary-gradient); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                <div style="font-size: 30px; font-weight: 800;"><%= analysisData.total %></div>
                <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;"><%- lan.Total_Students || 'Total Students' %></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div style="background: linear-gradient(135deg, #10B981, #059669); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                <div style="font-size: 30px; font-weight: 800;"><%= analysisData.passed %></div>
                <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;"><%- lan.Passed || 'Passed' %></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div style="background: linear-gradient(135deg, #EF4444, #DC2626); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                <div style="font-size: 30px; font-weight: 800;"><%= analysisData.failed %></div>
                <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;"><%- lan.Failed || 'Failed' %></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div style="background: linear-gradient(135deg, #F59E0B, #D97706); border-radius: 12px; padding: 18px; color: white; text-align: center;">
                <div style="font-size: 30px; font-weight: 800;"><%= analysisData.avgMarks %></div>
                <div style="font-size: 11px; opacity: 0.8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;"><%- lan.Class_Avg || 'Class Avg' %></div>
            </div>
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-7">
            <div class="card p-3">
                <h6 style="font-size: 14px; font-weight: 700; color: #1E293B; margin-bottom: 16px;"><%- lan.Grade_Distribution || 'Grade Distribution' %></h6>
                <canvas id="gradeChart" height="100"></canvas>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card p-3">
                <h6 style="font-size: 14px; font-weight: 700; color: #1E293B; margin-bottom: 16px;"><%- lan.Pass_Fail_Ratio || 'Pass / Fail Ratio' %></h6>
                <canvas id="passfailChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="table-card">
        <div class="table-header-row">
            <h3 class="table-heading"><%= selectedExam.name %> — <%= selectedExam.class_name %> (<%- lan.Section || 'Sec' %> <%= selectedExam.section %>)</h3>
        </div>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 80px;"><%- lan.Rank || 'Rank' %></th>
                        <th style="width: 80px;"><%- lan.Roll_No || 'Roll No' %></th>
                        <th><%- lan.Name || 'Name' %></th>
                        <th style="text-align: center; width: 80px;"><%- lan.Marks || 'Marks' %></th>
                        <th style="text-align: center; width: 90px;"><%- lan.Grade || 'Grade' %></th>
                        <th style="text-align: center; width: 100px;"><%- lan.Status || 'Status' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% analysisData.results.forEach((r, i) => { %>
                    <tr class="<%= r.status === 'fail' ? 'fail-row' : '' %>">
                        <td style="font-weight: 700; color: #94A3B8;">#<%= i + 1 %></td>
                        <td style="color: #64748B;">#<%= r.roll_no || '—' %></td>
                        <td style="font-weight: 600; color: #1E293B;"><%= r.first_name %> <%= r.last_name %></td>
                        <td style="text-align: center; font-weight: 700; color: #1E293B;"><%= r.obtained_marks %></td>
                        <td style="text-align: center;">
                            <span class="badge badge-<%= r.status === 'pass' ? 'success' : 'danger' %>">
                                <%= r.grade %>
                            </span>
                        </td>
                        <td style="text-align: center;">
                            <span class="badge badge-<%= r.status === 'pass' ? 'success' : 'danger' %>">
                                <%= r.status === 'pass' ? ('✓ ' + (lan.Pass || 'Pass')) : ('✗ ' + (lan.Fail || 'Fail')) %>
                            </span>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <div id="analysisChartsData"  data-grade-distrib="<%= JSON.stringify(analysisData.gradeDistrib) %>"  data-passed="<%= analysisData.passed %>"  data-failed="<%= analysisData.failed %>"  style="display: none;"></div>

    <% } else { %>
        <div class="empty-state">
            <i class="fa-solid fa-chart-pie"></i>
            <p><%- lan.Select_Exam_And_Class_To_View_Analysis || 'Select Exam and Class to view analysis' %></p>
        </div>
    <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    (function() {
        const chartsDataEl = document.getElementById('analysisChartsData');
        if (!chartsDataEl) return;
        const gradeData = JSON.parse(chartsDataEl.dataset.gradeDistrib || '{}');
        const passed = Number(chartsDataEl.dataset.passed || 0);
        const failed = Number(chartsDataEl.dataset.failed || 0);
        const gradeColors = { A1:'var(--primary)', A2:'var(--primary-dark)', B1:'#10B981', B2:'#34D399', C1:'#F59E0B', C2:'#FBBF24', D:'#94A3B8', E:'#EF4444' };

        new Chart(document.getElementById('gradeChart'), {
            type: 'bar',
            data: {
                labels: Object.keys(gradeData),
                datasets: [{ label: 'Students', data: Object.values(gradeData), backgroundColor: Object.keys(gradeData).map(g => gradeColors[g] || '#CBD5E1'), borderRadius: 6, borderSkipped: false }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
        });
        new Chart(document.getElementById('passfailChart'), {
            type: 'doughnut',
            data: { labels: ['Passed', 'Failed'], datasets: [{ data: [passed, failed], backgroundColor: ['#10B981', '#EF4444'], borderWidth: 0 }] },
            options: { responsive: true, cutout: '60%', plugins: { legend: { position: 'bottom' } } }
        });
    })();
</script>
