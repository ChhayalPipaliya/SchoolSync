<div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
        <h3 class="text-xl font-bold text-slate-800 m-0">Teacher Chat</h3>
        <p class="text-slate-500 text-xs mt-1 m-0">Connect directly with School Administration and fellow Teachers</p>
    </div>
    <% if (typeof allowedChatRoles !== 'undefined' && allowedChatRoles.length > 1) { %>
    <div class="flex items-center gap-1.5 flex-wrap">
        <a href="/teacher/chat" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= !filterRole ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">All Contacts</a>
        <% if (allowedChatRoles.includes('school_admin')) { %>
            <a href="/teacher/chat?role=school_admin" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filterRole === 'school_admin' ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">School Admin</a>
        <% } %>
        <% if (allowedChatRoles.includes('teacher')) { %>
            <a href="/teacher/chat?role=teacher" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition <%= filterRole === 'teacher' ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">Teachers</a>
        <% } %>
    </div>
    <% } %>
</div>
<%- include('../partials/chatWindow') %>