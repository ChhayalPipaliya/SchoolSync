<div class="card" style="background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 12px; border: none; box-shadow: 0 3px 10px rgba(79, 70, 229, 0.16);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                <i class="fa-solid fa-comments"></i>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.Teacher_Chat || 'Teacher Chat' %></h1>
                <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Teacher_Chat_Subtitle || 'Connect directly with School Administration and fellow Teachers' %></p>
            </div>
        </div>
        <% if (typeof allowedChatRoles !== 'undefined' && allowedChatRoles.length > 1) { %>
        <div class="chat-filter-tabs">
            <a href="/teacher/chat" class="chat-tab-btn <%= !filterRole ? 'active' : '' %>">
                <%- lan.All_Contacts || 'All Contacts' %>
            </a>
            <% if (allowedChatRoles.includes('school_admin')) { %>
                <a href="/teacher/chat?role=school_admin" class="chat-tab-btn <%= filterRole === 'school_admin' ? 'active' : '' %>">
                    <%- lan.School_Admin || 'School Admin' %>
                </a>
            <% } %>
            <% if (allowedChatRoles.includes('teacher')) { %>
                <a href="/teacher/chat?role=teacher" class="chat-tab-btn <%= filterRole === 'teacher' ? 'active' : '' %>">
                    <%- lan.Teachers || 'Teachers' %>
                </a>
            <% } %>
        </div>
        <% } %>
    </div>
</div>
<style>
    .chat-filter-tabs {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }
    .chat-tab-btn {
        padding: 6px 13px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
    }
    .chat-tab-btn:hover {
        background: rgba(255, 255, 255, 0.28);
        color: #ffffff;
    }
    .chat-tab-btn.active {
        background: #ffffff;
        border-color: #ffffff;
        color: #4f46e5;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }
</style>
<%- include('../partials/chatWindow') %>