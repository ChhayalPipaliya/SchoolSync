<div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3" style="margin-bottom: 16px;">
    <div>
        <h2 style="font-size: 22px; font-weight: 700; color: #1E293B; margin: 0; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-comments" style="color: #6366F1;"></i> Teacher Chat
        </h2>
        <p style="font-size: 12px; color: #64748B; margin: 4px 0 0;">Connect directly with School Administration and fellow Teachers</p>
    </div>
    <% if (typeof allowedChatRoles !== 'undefined' && allowedChatRoles.length > 1) { %>
    <div class="chat-filter-tabs">
        <a href="/teacher/chat" class="chat-tab-btn <%= !filterRole ? 'active' : '' %>">
            All Contacts
        </a>
        <% if (allowedChatRoles.includes('school_admin')) { %>
            <a href="/teacher/chat?role=school_admin" class="chat-tab-btn <%= filterRole === 'school_admin' ? 'active' : '' %>">
                School Admin
            </a>
        <% } %>
        <% if (allowedChatRoles.includes('teacher')) { %>
            <a href="/teacher/chat?role=teacher" class="chat-tab-btn <%= filterRole === 'teacher' ? 'active' : '' %>">
                Teachers
            </a>
        <% } %>
    </div>
    <% } %>
</div>
<style>
    .chat-filter-tabs {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .chat-tab-btn {
        padding: 6px 14px;
        border-radius: 9999px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        background: #ffffff;
        border: 1px solid #E2E8F0;
        color: #475569;
        display: inline-flex;
        align-items: center;
    }
    .chat-tab-btn:hover {
        background: #F8FAFC;
        color: #1E293B;
    }
    .chat-tab-btn.active {
        background: #4F46E5;
        border-color: #4F46E5;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(79, 70, 229, 0.3);
    }
</style>
<%- include('../partials/chatWindow') %>