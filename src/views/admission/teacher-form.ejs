<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | SchoolSync</title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --primary: #4f46e5;
      --primary-dark: #4338ca;
      --secondary: #7c3aed;
      --success: #10b981;
      --danger: #ef4444;
      --bg: #f5f3ff;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --border: #e5e7eb;
      --radius: 12px;
    }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      min-height: 100vh;
      color: var(--text);
    }

    .admission-hero {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      padding: 50px 20px 70px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .admission-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .school-logo-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 90px; height: 90px;
      background: rgba(255,255,255,0.15);
      border-radius: 50%;
      border: 3px solid rgba(255,255,255,0.3);
      margin-bottom: 16px;
      backdrop-filter: blur(10px);
    }
    .school-logo-wrap img { width: 65px; height: 65px; object-fit: contain; border-radius: 50%; }
    .school-logo-wrap i { font-size: 36px; color: white; }
    .admission-hero h1 {
      color: white;
      font-size: clamp(24px, 4vw, 32px);
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
      position: relative;
    }
    .admission-hero p {
      color: rgba(255,255,255,0.85);
      font-size: 15px;
      position: relative;
    }
    .badge-secure {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(255,255,255,0.15);
      color: white;
      font-size: 12px;
      padding: 5px 14px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.25);
      margin-top: 12px;
      position: relative;
    }

    .form-container {
      max-width: 800px;
      margin: -40px auto 50px;
      padding: 0 20px;
      position: relative;
      z-index: 1;
    }
    .form-card {
      background: var(--card);
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(79, 70, 229, 0.12);
      overflow: hidden;
      border: 1px solid rgba(79, 70, 229, 0.08);
    }
    .form-card-body { padding: 40px; }

    .error-box {
      background: #fef2f2;
      border: 1px solid #fee2e2;
      border-left: 4px solid var(--danger);
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 30px;
    }
    .error-box ul { list-style: none; }
    .error-box li { color: #b91c1c; font-size: 13.5px; padding: 2px 0; font-weight: 500; }
    .error-box li::before { content: '⚠ '; }

    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 32px 0 20px;
      padding-bottom: 12px;
      border-bottom: 2px solid #f3f4f6;
    }
    .section-header:first-child { margin-top: 0; }
    .section-icon {
      width: 40px; height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      display: flex; align-items: center; justify-content: center;
      color: white; font-size: 16px; flex-shrink: 0;
    }
    .section-header h3 {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.2px;
    }

    .form-grid { display: grid; gap: 20px; }
    .form-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
    .form-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
    @media(max-width: 640px) {
      .form-grid.cols-2, .form-grid.cols-3 { grid-template-columns: 1fr; }
      .form-card-body { padding: 24px 20px; }
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }
    .form-group label .req { color: var(--danger); margin-left: 3px; }
    .form-control {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid var(--border);
      border-radius: 9px;
      font-size: 14.5px;
      font-family: 'Inter', sans-serif;
      color: var(--text);
      background: #fafbff;
      transition: all 0.2s;
      outline: none;
    }
    .form-control:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
      background: white;
    }
    .form-control::placeholder {
      color: #9ca3af;
    }
    textarea.form-control { resize: vertical; min-height: 90px; }

    .btn-submit {
      width: 100%;
      margin-top: 36px;
      padding: 16px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      letter-spacing: 0.3px;
    }
    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(79, 70, 229, 0.35);
    }
    .btn-submit:active { transform: translateY(0); }

    .footer-note {
      text-align: center;
      padding: 20px;
      font-size: 12px;
      color: var(--muted);
      border-top: 1px solid var(--border);
    }
    .footer-note a { color: var(--primary); text-decoration: none; font-weight: 600; }

    .steps {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      padding: 24px 40px 0;
      border-bottom: 1px solid #f3f4f6;
    }
    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      flex: 1;
      position: relative;
      padding-bottom: 16px;
    }
    .step::before {
      content: '';
      position: absolute;
      top: 15px;
      left: -50%;
      right: 50%;
      height: 2.5px;
      background: var(--border);
      z-index: 0;
    }
    .step:first-child::before { display: none; }
    .step-circle {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700;
      color: var(--muted);
      position: relative; z-index: 1;
    }
    .step.active .step-circle {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
    }
    .step-label { font-size: 11px; color: var(--muted); font-weight: 500; white-space: nowrap; }
    .step.active .step-label { color: var(--primary); font-weight: 600; }
    
    .form-step { display: none; }
    .form-step.active { display: block; }
    .btn-nav-container { display: flex; justify-content: space-between; margin-top: 36px; gap: 12px; }
    .btn-nav {
      padding: 12px 24px;
      border: none;
      border-radius: 9px;
      font-size: 14.5px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      outline: none;
    }
    .btn-prev { background: #e5e7eb; color: #4b5563; }
    .btn-prev:hover { background: #d1d5db; }
    .btn-next { background: linear-gradient(135deg, var(--primary), var(--secondary)); color: white; }
    .btn-next:hover { opacity: 0.9; transform: translateY(-1px); }
  </style>
</head>
<body>

<div class="admission-hero">
  <div class="school-logo-wrap">
    <% if (school.school_logo) { %>
      <img src="/<%= school.school_logo %>" alt="<%= school.school_name %> Logo">
    <% } else { %>
      <i class="fas fa-school"></i>
    <% } %>
  </div>
  <h1><%= school.school_name %></h1>
  <p><%= school.school_address || 'Teacher Onboarding Portal' %></p>
  <span class="badge-secure"><i class="fas fa-shield-alt"></i> Secure Online Teacher Application</span>
</div>

<div class="form-container">
  <div class="form-card">
    <div class="steps">
      <div class="step active">
        <div class="step-circle">1</div>
        <div class="step-label">Personal Info</div>
      </div>
      <div class="step">
        <div class="step-circle">2</div>
        <div class="step-label">Professional Info</div>
      </div>
      <div class="step">
        <div class="step-circle">3</div>
        <div class="step-label">Medical & Address</div>
      </div>
      <div class="step">
        <div class="step-circle">4</div>
        <div class="step-label">Uploads & Submit</div>
      </div>
    </div>

    <div class="form-card-body">

      <% if (errors && errors.length > 0) { %>
      <div class="error-box">
        <ul>
          <% errors.forEach(e => { %><li><%= e %></li><% }); %>
        </ul>
      </div>
      <% } %>

      <form method="POST" action="/admission/teacher/submit" id="onboardingForm" enctype="multipart/form-data">
        <input type="hidden" name="token" value="<%= token %>">
        <input type="hidden" name="school_id" value="<%= schoolId %>">

        <div class="form-step active" id="step-1">
          <div class="section-header">
            <div class="section-icon"><i class="fas fa-user-tie"></i></div>
            <h3>Personal Details</h3>
          </div>
          
          <div class="form-grid cols-2">
            <div class="form-group">
              <label>First Name <span class="req">*</span></label>
              <input type="text" name="first_name" class="form-control" placeholder="Enter first name"
                value="<%= old.first_name || '' %>" required>
            </div>
            <div class="form-group">
              <label>Last Name <span class="req">*</span></label>
              <input type="text" name="last_name" class="form-control" placeholder="Enter last name"
                value="<%= old.last_name || '' %>" required>
            </div>
            <div class="form-group">
              <label>Email Address <span class="req">*</span></label>
              <input type="email" name="email" class="form-control" placeholder="teacher@example.com"
                value="<%= old.email || '' %>" required>
            </div>
            <div class="form-group">
              <label>Phone Number <span class="req">*</span></label>
              <input type="tel" name="phone" class="form-control" placeholder="10-digit mobile number"
                value="<%= old.phone || '' %>" maxlength="10" required>
            </div>
            <div class="form-group">
              <label>Date of Birth <span class="req">*</span></label>
              <input type="date" name="date_of_birth" class="form-control"
                value="<%= old.date_of_birth || '' %>" required>
            </div>
            <div class="form-group">
              <label>Gender <span class="req">*</span></label>
              <select name="gender" class="form-control" required>
                <option value="">Select Gender</option>
                <option value="male" <%= old.gender === 'male' ? 'selected' : '' %>>Male</option>
                <option value="female" <%= old.gender === 'female' ? 'selected' : '' %>>Female</option>
              </select>
            </div>
            <div class="form-group">
              <label>Marital Status</label>
              <select name="marital_status" class="form-control">
                <option value="single" <%= old.marital_status === 'single' ? 'selected' : '' %>>Single</option>
                <option value="married" <%= old.marital_status === 'married' ? 'selected' : '' %>>Married</option>
              </select>
            </div>
            <div class="form-group">
              <label>Emergency Contact</label>
              <input type="tel" name="emergency_contact" class="form-control" placeholder="Emergency phone"
                value="<%= old.emergency_contact || '' %>" maxlength="10">
            </div>
            <div class="form-group">
              <label>Father's Name</label>
              <input type="text" name="father_name" class="form-control" placeholder="Father's full name"
                value="<%= old.father_name || '' %>">
            </div>
            <div class="form-group">
              <label>Mother's Name</label>
              <input type="text" name="mother_name" class="form-control" placeholder="Mother's full name"
                value="<%= old.mother_name || '' %>">
            </div>
          </div>
        </div>
        <div class="form-step" id="step-2">
          <div class="section-header">
            <div class="section-icon"><i class="fas fa-briefcase"></i></div>
            <h3>Professional & Academic Details</h3>
          </div>

          <div class="form-grid cols-2">
            <div class="form-group" style="grid-column: 1/-1;">
              <label>Subjects you can teach <span class="req">*</span></label>
              <input type="text" name="subjects" class="form-control" placeholder="e.g. Mathematics, Physics, Computer Science"
                value="<%= old.subjects || '' %>" required>
            </div>
            <div class="form-group">
              <label>Highest Qualification <span class="req">*</span></label>
              <input type="text" name="qualification" class="form-control" placeholder="e.g. B.Ed, M.Sc in Physics, Ph.D"
                value="<%= old.qualification || '' %>" required>
            </div>
            <div class="form-group">
              <label>Years of Experience <span class="req">*</span></label>
              <input type="number" name="experience" class="form-control" placeholder="Years of teaching experience"
                value="<%= old.experience || '' %>" min="0" step="0.5" required>
            </div>
            <div class="form-group">
              <label>Joining Date</label>
              <input type="date" name="joining_date" class="form-control" value="<%= old.joining_date || '' %>">
            </div>
            <div class="form-group">
              <label>Salary (Monthly Expected)</label>
              <input type="number" name="salary" class="form-control" placeholder="Expected salary in ₹" value="<%= old.salary || '' %>">
            </div>

            <div class="form-group" style="grid-column: 1/-1; border-top: 1px solid var(--border); margin: 10px 0; padding-top: 15px;">
              <label style="font-weight: 700; color: var(--muted); text-transform: none; letter-spacing: 0;">Previous Experience (If applicable)</label>
            </div>

            <div class="form-group">
              <label>Previous School / Organization Name</label>
              <input type="text" name="previous_school" class="form-control" placeholder="Previous school name"
                value="<%= old.previous_school || '' %>">
            </div>
            <div class="form-group">
              <label>Previous Joining Date</label>
              <input type="date" name="prev_joining_date" class="form-control" value="<%= old.prev_joining_date || '' %>">
            </div>
            <div class="form-group">
              <label>Total Experience (Years)</label>
              <input type="number" step="0.1" name="total_experience" class="form-control" placeholder="e.g. 3.5" value="<%= old.total_experience || '' %>">
            </div>
          </div>
        </div>
        <div class="form-step" id="step-3">
          <div class="section-header">
            <div class="section-icon"><i class="fas fa-heartbeat"></i></div>
            <h3>Medical & Address Details</h3>
          </div>
          
          <div class="form-grid cols-2">
            <div class="form-group">
              <label>Medical Issues</label>
              <input type="text" name="medical_issues" class="form-control" placeholder="Any medical issues or conditions"
                value="<%= old.medical_issues || '' %>">
            </div>
            <div class="form-group">
              <label>Height (cm)</label>
              <input type="number" step="0.1" name="height" class="form-control" placeholder="Height in cm"
                value="<%= old.height || '' %>">
            </div>
            <div class="form-group">
              <label>Weight (kg)</label>
              <input type="number" step="0.1" name="weight" class="form-control" placeholder="Weight in kg"
                value="<%= old.weight || '' %>">
            </div>
            <div class="form-group">
              <label>Blood Group</label>
              <select name="blood_group" class="form-control">
                <option value="">Select Blood Group</option>
                <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(bg => { %>
                  <option value="<%= bg %>" <%= old.blood_group === bg ? 'selected' : '' %>><%= bg %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group" style="grid-column: 1/-1; border-top: 1px solid var(--border); margin: 10px 0; padding-top: 15px;">
              <label style="font-weight: 700; color: var(--muted); text-transform: none; letter-spacing: 0;">Addresses</label>
            </div>

            <div class="form-group" style="grid-column:1/-1;">
              <label>Current Address <span class="req">*</span></label>
              <textarea name="current_address" class="form-control" placeholder="Street, City, Postal Code..." required><%= old.current_address || old.address || '' %></textarea>
            </div>
            <div class="form-group" style="grid-column:1/-1;">
              <label>Permanent Address</label>
              <textarea name="permanent_address" class="form-control" placeholder="Street, City, Postal Code..."><%= old.permanent_address || '' %></textarea>
            </div>
          </div>
        </div>
        <div class="form-step" id="step-4">
          <div class="section-header">
            <div class="section-icon"><i class="fas fa-paperclip"></i></div>
            <h3>Media & Documents</h3>
          </div>

          <div class="form-grid cols-2">
            <div class="form-group" style="grid-column: 1/-1;">
              <label>Profile Photo</label>
              <input type="file" name="photo" accept="image/*" class="form-control">
            </div>

            <div class="form-group" style="grid-column: 1/-1; border-top: 1px solid var(--border); margin: 10px 0; padding-top: 15px;">
              <label style="font-weight: 700; color: var(--muted); text-transform: none; letter-spacing: 0;">Certificates & Onboarding Documents</label>
            </div>

            <div class="form-group" style="grid-column: 1/-1;">
              <div class="form-grid cols-3" style="align-items: center; gap: 10px; margin-bottom: 15px;">
                <input type="file" name="documents" class="form-control">
                <select name="document_types" class="form-control">
                  <option value="aadhaar_card">Aadhaar Card</option>
                  <option value="experience_certificate">Experience Certificate</option>
                  <option value="qualification_certificate">Qualification Certificate</option>
                  <option value="joining_letter">Joining Letter</option>
                  <option value="resume">Resume</option>
                  <option value="pan_card">PAN Card</option>
                  <option value="other">Other</option>
                </select>
                <input type="text" name="document_names" placeholder="Document Name" class="form-control">
              </div>
              <div class="form-grid cols-3" style="align-items: center; gap: 10px; margin-bottom: 15px;">
                <input type="file" name="documents" class="form-control">
                <select name="document_types" class="form-control">
                  <option value="experience_certificate">Experience Certificate</option>
                  <option value="aadhaar_card">Aadhaar Card</option>
                  <option value="qualification_certificate">Qualification Certificate</option>
                  <option value="joining_letter">Joining Letter</option>
                  <option value="resume">Resume</option>
                  <option value="pan_card">PAN Card</option>
                  <option value="other">Other</option>
                </select>
                <input type="text" name="document_names" placeholder="Document Name" class="form-control">
              </div>
              <div class="form-grid cols-3" style="align-items: center; gap: 10px; margin-bottom: 15px;">
                <input type="file" name="documents" class="form-control">
                <select name="document_types" class="form-control">
                  <option value="qualification_certificate">Qualification Certificate</option>
                  <option value="aadhaar_card">Aadhaar Card</option>
                  <option value="experience_certificate">Experience Certificate</option>
                  <option value="joining_letter">Joining Letter</option>
                  <option value="resume">Resume</option>
                  <option value="pan_card">PAN Card</option>
                  <option value="other">Other</option>
                </select>
                <input type="text" name="document_names" placeholder="Document Name" class="form-control">
              </div>
            </div>
          </div>
        </div>
        <div class="btn-nav-container">
          <button type="button" class="btn-nav btn-prev" id="prevBtn">Previous</button>
          <button type="button" class="btn-nav btn-next" id="nextBtn">Next</button>
          <button type="submit" class="btn-submit" id="submitBtn" style="margin-top: 0; width: auto; padding: 12px 30px;">
            <i class="fas fa-paper-plane"></i> &nbsp;Submit Onboarding Application
          </button>
        </div>

      </form>
    </div>

    <div class="footer-note">
      <i class="fas fa-lock" style="color:var(--primary);"></i>
      Your onboarding information is encrypted and secure. Powered by <a href="#">SchoolSync</a>
    </div>
  </div>
</div>

<script>
  const steps = document.querySelectorAll('.step');
  const formSteps = document.querySelectorAll('.form-step');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const submitBtn = document.getElementById('submitBtn');
  let currentStep = 0;

  function updateStepVisibility() {
    formSteps.forEach((step, index) => {
      step.classList.toggle('active', index === currentStep);
    });
    steps.forEach((step, index) => {
      step.className = 'step' + (index === currentStep ? ' active' : (index < currentStep ? ' active' : ''));
    });
    
    if (currentStep === 0) {
      prevBtn.style.display = 'none';
    } else {
      prevBtn.style.display = 'inline-block';
    }
    
    if (currentStep === formSteps.length - 1) {
      nextBtn.style.display = 'none';
      submitBtn.style.display = 'inline-block';
    } else {
      nextBtn.style.display = 'inline-block';
      submitBtn.style.display = 'none';
    }
  }

  nextBtn.addEventListener('click', () => {
    const currentFields = formSteps[currentStep].querySelectorAll('input[required], select[required], textarea[required]');
    let valid = true;
    currentFields.forEach(field => {
      if (!field.reportValidity()) {
        valid = false;
      }
    });
    if (valid) {
      currentStep++;
      updateStepVisibility();
    }
  });

  prevBtn.addEventListener('click', () => {
    currentStep--;
    updateStepVisibility();
  });

  updateStepVisibility();

  document.getElementById('onboardingForm').addEventListener('submit', function(e) {
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> &nbsp;Submitting...';

    const fileInputs = this.querySelectorAll('input[type="file"][name="documents"]');
    fileInputs.forEach(fileInput => {
      const container = fileInput.closest('.form-grid');
      if (container) {
        const select = container.querySelector('select[name="document_types"]');
        const textInput = container.querySelector('input[name="document_names"]');
        if (fileInput.files.length === 0) {
          if (select) select.disabled = true;
          if (textInput) textInput.disabled = true;
        }
      }
    });
  });
