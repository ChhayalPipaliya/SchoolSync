<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | SchoolSync</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            font-family: Inter, Arial, sans-serif;
            background: #f5f7fb;
            color: #172033
        }

        .hero {
            background: #2563eb;
            color: white;
            text-align: center;
            padding: 42px 18px 64px
        }

        .hero h1 {
            margin: 0 0 8px;
            font-size: 28px
        }

        .hero p {
            margin: 0;
            color: #dbeafe
        }

        .wrap {
            max-width: 900px;
            margin: -38px auto 40px;
            padding: 0 16px
        }

        .card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 18px;
            box-shadow: 0 18px 50px rgba(37, 99, 235, .12);
            overflow: hidden
        }

        form {
            padding: 30px
        }

        .section {
            margin: 0 0 24px
        }

        .section h3 {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #475569;
            margin: 0 0 14px
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px
        }

        .full {
            grid-column: 1/-1
        }

        label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            margin-bottom: 7px;
            text-transform: uppercase
        }

        .req {
            color: #ef4444
        }

        input,
        select,
        textarea {
            width: 100%;
            border: 1.5px solid #dbe3ef;
            border-radius: 9px;
            padding: 11px 13px;
            font-size: 14px;
            background: #fbfdff
        }

        textarea {
            min-height: 82px;
            resize: vertical
        }

        .errors {
            background: #fef2f2;
            border-left: 4px solid #ef4444;
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 18px;
            color: #991b1b;
            font-size: 13px
        }

        .btn {
            width: 100%;
            border: 0;
            border-radius: 10px;
            background: #2563eb;
            color: white;
            font-size: 15px;
            font-weight: 800;
            padding: 14px;
            cursor: pointer
        }

        .footer {
            text-align: center;
            border-top: 1px solid #e5e7eb;
            padding: 16px;
            color: #64748b;
            font-size: 12px
        }

        @media(max-width:680px) {
            .grid {
                grid-template-columns: 1fr
            }

            form {
                padding: 22px
            }
        }
    </style>
</head>
<body>
    <div class="hero">
        <h1><i class="fa-solid fa-id-card"></i> Driver Onboarding</h1>
        <p><%= school.school_name %></p>
    </div>
    <div class="wrap">
        <div class="card">
            <form method="POST" action="/admission/driver/submit" enctype="multipart/form-data" id="driverForm">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="token" value="<%= token %>">
                <input type="hidden" name="school_id" value="<%= schoolId %>">
                <% if (errors && errors.length) { %>
                    <div class="errors">
                        <% errors.forEach(e=> { %><div><%= e %></div><% }) %>
                    </div>
                <% } %>
                <div class="section">
                    <h3>Personal Details</h3>
                    <div class="grid">
                        <div>
                            <label>First Name <span class="req">*</span></label>
                            <input name="first_name" required value="<%= old.first_name || '' %>">
                        </div>
                        <div>
                            <label>Last Name <span class="req">*</span></label>
                            <input name="last_name" required value="<%= old.last_name || '' %>">
                        </div>
                        <div>
                            <label>Email <span class="req">*</span></label>
                            <input type="email" name="email" required value="<%= old.email || '' %>">
                        </div>
                        <div>
                            <label>Phone <span class="req">*</span></label>
                            <input name="phone" required value="<%= old.phone || '' %>">
                        </div>
                        <div>
                            <label>Date of Birth</label>
                            <input type="date" name="date_of_birth" value="<%= old.date_of_birth || '' %>">
                        </div>
                        <div>
                            <label>Gender</label>
                            <select name="gender">
                                <option value="">Select</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                            </select>
                        </div>
                        <div>
                            <label>Blood Group</label>
                            <input name="blood_group" value="<%= old.blood_group || '' %>">
                        </div>
                        <div>
                            <label>Emergency Contact</label>
                            <input name="emergency_contact" value="<%= old.emergency_contact || '' %>">
                        </div>
                    </div>
                </div>
                <div class="section">
                    <h3>Address</h3>
                    <div class="grid">
                        <div class="full">
                            <label>Address</label>
                            <textarea name="address"><%= old.address || '' %></textarea>
                        </div>
                        <div>
                            <label>City</label>
                            <input name="city" value="<%= old.city || '' %>">
                        </div>
                        <div>
                            <label>State</label>
                            <input name="state" value="<%= old.state || '' %>">
                        </div>
                        <div><label>Pincode</label>
                            <input name="pincode" value="<%= old.pincode || '' %>">
                        </div>
                        <div>
                            <label>Aadhaar Number</label>
                            <input name="aadhaar_number" value="<%= old.aadhaar_number || '' %>">
                        </div>
                    </div>
                </div>
                <div class="section">
                    <h3>License & Experience</h3>
                    <div class="grid">
                        <div>
                            <label>License Number <span class="req">*</span></label>
                            <input name="license_number" required value="<%= old.license_number || '' %>">
                        </div>
                        <div>
                            <label>License Expiry <span class="req">*</span></label>
                            <input type="date" name="license_expiry" required value="<%= old.license_expiry || '' %>">\
                        </div>
                        <div>
                            <label>License Type</label>
                            <input name="license_type" value="<%= old.license_type || '' %>">
                        </div>
                        <div>
                            <label>Driving Experience</label>
                            <input name="driving_experience" value="<%= old.driving_experience || '' %>">
                        </div>
                        <div>
                            <label>Previous Employer</label>
                            <input name="previous_employer" value="<%= old.previous_employer || '' %>">
                        </div>
                        <div>
                            <label>Reference Phone</label>
                            <input name="reference_phone" value="<%= old.reference_phone || '' %>">
                        </div>
                        <div>
                            <label>Reference Name</label>
                            <input name="reference_name" value="<%= old.reference_name || '' %>">
                        </div>
                    </div>
                    <div class="section">
                        <h3>Uploads</h3>
                        <div class="grid">
                            <div>
                                <label>Driver Photo</label>
                                <input type="file" name="photo" accept="image/*">
                            </div>
                            <div>
                                <label>License Document</label>
                                <input type="file" name="license_document">
                            </div>
                            <div>
                                <label>Aadhaar Document</label>
                                <input type="file" name="aadhaar_document">
                            </div>
                        </div>
                    </div>
                    <button class="btn" id="submitBtn">Submit Driver Application</button>
                </div>
            </form>
            <div class="footer">Your application will be reviewed by the school admin.</div>
        </div>
    </div>
    <script>document.getElementById('driverForm').addEventListener('submit', () => { const b = document.getElementById('submitBtn'); b.disabled = true; b.textContent = 'Submitting...'; });</script>
</body>
</html>