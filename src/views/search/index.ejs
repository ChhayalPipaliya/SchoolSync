<style>
  .global-search-page {
    display: grid;
    gap: 18px;
  }
  .global-search-hero {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 18px;
    box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
  }
  .global-search-form {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .global-search-form input {
    width: 100%;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
    padding: 12px 14px;
    font: inherit;
    outline: none;
  }
  .global-search-form input:focus {
    border-color: #059669;
    box-shadow: 0 0 0 3px rgba(5, 150, 105, .12);
  }
  .global-search-form button {
    border: 0;
    border-radius: 8px;
    background: #059669;
    color: #fff;
    font-weight: 800;
    padding: 12px 16px;
    white-space: nowrap;
  }
  .global-search-meta {
    margin: 10px 0 0;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
  }
  .global-search-group {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 22px rgba(15, 23, 42, .04);
  }
  .global-search-group h2 {
    margin: 0;
    padding: 14px 16px;
    border-bottom: 1px solid #eef2f7;
    font-size: 15px;
    font-weight: 900;
    color: #0f172a;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .global-search-list {
    display: grid;
  }
  .global-search-item {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid #f1f5f9;
  }
  .global-search-item:hover {
    background: #f8fafc;
  }
  .global-search-item:last-child {
    border-bottom: 0;
  }
  .global-search-title {
    font-weight: 900;
    color: #111827;
  }
  .global-search-subtitle {
    margin-top: 3px;
    color: #64748b;
    font-size: 13px;
  }
  .global-search-badge {
    align-self: flex-start;
    border-radius: 999px;
    background: #ecfdf5;
    color: #047857;
    font-size: 11px;
    font-weight: 900;
    padding: 5px 9px;
    white-space: nowrap;
  }
  .global-search-empty {
    background: #fff;
    border: 1px dashed #dbe3ef;
    border-radius: 10px;
    padding: 28px;
    text-align: center;
    color: #64748b;
    font-weight: 700;
  }
  @media (max-width: 640px) {
    .global-search-form {
      flex-direction: column;
      align-items: stretch;
    }
    .global-search-item {
      flex-direction: column;
    }
  }
</style>

<div class="global-search-page">
  <section class="global-search-hero">
    <form class="global-search-form" action="/search" method="GET">
      <input type="search" name="q" value="<%= q || '' %>" placeholder="Search anything..." autofocus>
      <button type="submit"><i class="fas fa-search"></i> Search</button>
    </form>
    <% if (q) { %>
      <p class="global-search-meta"><%= totalResults %> result<%= totalResults === 1 ? '' : 's' %> for "<%= q %>"</p>
    <% } %>
  </section>

  <% if (!q) { %>
    <div class="global-search-empty">Type a keyword to search pages and records.</div>
  <% } else if (!groups.length) { %>
    <div class="global-search-empty">No matching results found.</div>
  <% } %>

  <% groups.forEach(group => { %>
    <section class="global-search-group">
      <h2><i class="fas <%= group.icon %>"></i> <%= group.title %></h2>
      <div class="global-search-list">
        <% group.items.forEach(item => { %>
          <a class="global-search-item" href="<%= item.href %>">
            <div>
              <div class="global-search-title"><%= item.title %></div>
              <% if (item.subtitle) { %>
                <div class="global-search-subtitle"><%= item.subtitle %></div>
              <% } %>
            </div>
            <span class="global-search-badge"><%= item.meta %></span>
          </a>
        <% }) %>
      </div>
    </section>
  <% }) %>
</div>
