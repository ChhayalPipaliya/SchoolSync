<%
    const noticeList = (typeof notices !== 'undefined' && notices) ? notices : [];
    const st = (typeof student !== 'undefined' && student) ? student : {};
    const nowMs = Date.now();
    const oneWeekMs = 7 * 24 * 60 * 60 * 1000;

    let totalCount = noticeList.length;
    let urgentCount = 0;
    let pinnedCount = 0;
    let recentCount = 0;

    noticeList.forEach(function(n) {
        const priority = String(n.priority || '').toLowerCase();
        const isUrgent = (priority === 'high' || priority === 'urgent' || n.is_urgent == 1);
        const isPinned = (n.is_pinned == 1);
        const createdMs = new Date(n.created_at).getTime();
        const isRecent = (nowMs - createdMs <= oneWeekMs);

        if (isUrgent) urgentCount++;
        if (isPinned) pinnedCount++;
        if (isRecent) recentCount++;
    });

    const getPriorityMeta = function(priorityStr, isUrgentFlag) {
        const p = String(priorityStr || '').toLowerCase();
        if (p === 'urgent' || isUrgentFlag == 1) {
            return { cls: 'prio-urgent', label: 'Urgent', icon: 'fa-triangle-exclamation' };
        } else if (p === 'high') {
            return { cls: 'prio-high', label: 'High Priority', icon: 'fa-circle-exclamation' };
        } else if (p === 'medium') {
            return { cls: 'prio-medium', label: 'Important', icon: 'fa-circle-info' };
        } else {
            return { cls: 'prio-normal', label: 'General', icon: 'fa-bullhorn' };
        }
    };

    const getTargetMeta = function(targetType, className, section) {
        const t = String(targetType || 'all').toLowerCase();
        if (t === 'specific_class') {
            return {
                label: className ? ('Class ' + className + (section ? ('-' + section) : '')) : 'My Class',
                icon: 'fa-chalkboard-user',
                cls: 'target-class'
            };
        } else if (t === 'students') {
            return { label: 'All Students', icon: 'fa-user-graduate', cls: 'target-students' };
        } else if (t === 'parents') {
            return { label: 'Parents', icon: 'fa-people-roof', cls: 'target-parents' };
        } else {
            return { label: 'Whole School', icon: 'fa-school', cls: 'target-all' };
        }
    };
%>
