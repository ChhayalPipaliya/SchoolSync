<style>
:root {
    --cal-primary: #059669;
    --cal-today: #ECFDF5;
}

.fc {
    font-family: 'Inter', 'Outfit', sans-serif;
    --fc-border-color: #E2E8F0;
    --fc-today-bg-color: var(--cal-today);
    --fc-button-bg-color: var(--cal-primary);
    --fc-button-border-color: var(--cal-primary);
    --fc-button-hover-bg-color: #047857;
    --fc-button-hover-border-color: #047857;
    --fc-button-active-bg-color: #065F46;
}

.fc .fc-toolbar-title { font-size: 17px; font-weight: 700; color: #1E293B; }
.fc .fc-button {
    border-radius: 8px; font-size: 12px; font-weight: 600;
    padding: 7px 14px; text-transform: capitalize;
}
.fc .fc-button-group .fc-button { border-radius: 0; }
.fc .fc-button-group .fc-button:first-child { border-radius: 8px 0 0 8px; }
.fc .fc-button-group .fc-button:last-child  { border-radius: 0 8px 8px 0; }

.fc .fc-col-header-cell-cushion {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.8px; color: #64748B; padding: 10px 0;
}
.fc .fc-daygrid-day-number { font-size: 13px; font-weight: 600; color: #1E293B; padding: 8px; }
.fc .fc-daygrid-day.fc-day-today .fc-daygrid-day-number {
    background: var(--cal-primary); color: #fff;
    border-radius: 50%; width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    margin: 6px; padding: 0; font-size: 12px;
}
.fc-event {
    border-radius: 6px !important; padding: 2px 6px;
    font-size: 11.5px; font-weight: 600; cursor: pointer;
    border: none !important; transition: opacity 0.2s;
}
.fc-event:hover { opacity: 0.85; }

.event-popup {
    display: none; position: fixed; z-index: 1060;
    background: #fff; border-radius: 16px; width: 300px; padding: 20px;
    box-shadow: 0 16px 60px rgba(0,0,0,0.16); animation: popIn 0.25s ease;
}
@keyframes popIn {
    from { opacity: 0; transform: scale(0.94) translateY(10px); }
    to   { opacity: 1; transform: scale(1)    translateY(0); }
}
.event-popup.active { display: block; }
.popup-close {
    position: absolute; top: 12px; right: 14px;
    background: none; border: none; cursor: pointer; color: #94A3B8; font-size: 18px; padding: 0;
}

.event-legend { display: flex; flex-wrap: wrap; gap: 8px; }
.legend-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px 10px; border-radius: 16px; font-size: 11.5px; font-weight: 600;
}

.calendar-wrapper { animation: fadeIn 0.4s ease; }
@keyframes fadeIn { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
</style>

<div class="calendar-wrapper" style="padding: 0 4px;">
    <!-- Hero Banner -->
    <div style="background:linear-gradient(135deg, #7c3aed, #5b21b6); border-radius:12px; padding:24px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(124,58,237,0.15);">
        <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
        <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
            <div>
                <h1 style="font-size:24px; font-weight:700; margin:0;">Academic Calendar</h1>
                <p style="font-size:13px; opacity:0.9; margin:4px 0 0;">School events, holidays and exam schedule</p>
            </div>
        </div>
    </div>

    <div class="card mb-4 p-3">
        <div class="event-legend">
            <span class="legend-badge" style="background:#FEE2E2;color:#991B1B;"><i class="fa-solid fa-circle-dot"></i> Holiday</span>
            <span class="legend-badge" style="background:#FEF3C7;color:#92400E;"><i class="fa-solid fa-circle-dot"></i> Exam</span>
            <span class="legend-badge" style="background:#DBEAFE;color:#1E3A8A;"><i class="fa-solid fa-circle-dot"></i> Event</span>
            <span class="legend-badge" style="background:#EDE9FE;color:#4C1D95;"><i class="fa-solid fa-circle-dot"></i> Meeting</span>
        </div>
    </div>

    <div class="card" style="padding:20px;box-shadow:0 4px 24px rgba(5,150,105,0.08);">
        <div id="calendar"></div>
    </div>
</div>

<div class="event-popup" id="eventPopup">
    <button class="popup-close" onclick="closePopup()"><i class="fa-solid fa-xmark"></i></button>
    <div id="popupType" class="popup-type-badge" style="display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;margin-bottom:10px;"></div>
    <div id="popupTitle" style="font-size:16px;font-weight:700;color:#1E293B;margin-bottom:10px;"></div>
    <div id="popupDates"    style="font-size:12px;color:#64748B;margin-bottom:8px;"></div>
    <div id="popupAudience" style="font-size:12px;color:#64748B;margin-bottom:10px;"></div>
    <div id="popupDesc"     style="font-size:13px;color:#475569;"></div>
</div>
<div id="popupOverlay" style="display:none;position:fixed;inset:0;z-index:1059;" onclick="closePopup()"></div>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script>
const TYPE_BADGES = {
    Holiday: { bg:'#FEE2E2', color:'#991B1B' },
    Exam:    { bg:'#FEF3C7', color:'#92400E' },
    Event:   { bg:'#DBEAFE', color:'#1E3A8A' },
    Meeting: { bg:'#EDE9FE', color:'#4C1D95' }
};

document.addEventListener('DOMContentLoaded', function() {
    const el = document.getElementById('calendar');
    const cal = new FullCalendar.Calendar(el, {
        initialView: 'dayGridMonth',
        headerToolbar: {
            left:   'prev,next today',
            center: 'title',
            right:  'dayGridMonth,listMonth'
        },
        height: 'auto',
        contentHeight: 640,
        editable: false,
        selectable: false,
        nowIndicator: true,
        dayMaxEvents: 3,
        buttonText: { today:'Today', month:'Month', list:'List' },

        events: function(fetchInfo, successCb, failureCb) {
            fetch(`/student/api/academic-events?start=${fetchInfo.startStr}&end=${fetchInfo.endStr}`)
                .then(r => r.json())
                .then(d => { if(d.success) successCb(d.events); else failureCb(new Error(d.message)); })
                .catch(failureCb);
        },

        eventClick: function(info) {
            const e  = info.event;
            const ep = e.extendedProps;
            const type  = ep.event_type || 'Event';
            const badge = TYPE_BADGES[type] || { bg:'#DBEAFE', color:'#1E3A8A' };

            document.getElementById('popupType').textContent = type;
            const pt = document.getElementById('popupType');
            pt.style.background = badge.bg;
            pt.style.color      = badge.color;

            document.getElementById('popupTitle').textContent = e.title;

            const startFmt = e.start ? e.start.toLocaleDateString('en-IN', { weekday:'short', day:'2-digit', month:'short', year:'numeric' }) : '';
            const endFmt   = e.end   ? e.end.toLocaleDateString('en-IN',   { weekday:'short', day:'2-digit', month:'short', year:'numeric' }) : '';
            document.getElementById('popupDates').innerHTML =
                `<i class="fa-regular fa-calendar me-1"></i>${startFmt}${endFmt && endFmt !== startFmt ? ' → ' + endFmt : ''}`;
            document.getElementById('popupAudience').innerHTML =
                `<i class="fa-solid fa-users me-1"></i> For: ${ep.target_audience || 'All'}`;
            document.getElementById('popupDesc').textContent = ep.description || '';

            const popup = document.getElementById('eventPopup');
            const rect  = info.el.getBoundingClientRect();
            const top   = Math.min(rect.bottom + 8, window.innerHeight - 260);
            const left  = Math.min(rect.left, window.innerWidth - 320);
            popup.style.top  = top + 'px';
            popup.style.left = left + 'px';
            popup.classList.add('active');
            document.getElementById('popupOverlay').style.display = 'block';
        },

        eventContent: function(arg) {
            return { html: `<div style="padding:2px 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">● ${arg.event.title}</div>` };
        }
    });
    cal.render();
});

function closePopup() {
    document.getElementById('eventPopup').classList.remove('active');
    document.getElementById('popupOverlay').style.display = 'none';
}
</script>
