<div class="card p-3">
    <div class="card-title">
        <i class="fas fa-video"></i>
        My Video Meetings
    </div>

    <% if (!meetings || meetings.length === 0) { %>
        <div class="empty-state py-5">
            <i class="fas fa-video-slash fa-3x text-muted mb-3"></i>
            <p>No meetings scheduled for you yet</p>
        </div>
    <% } else { %>
        <div class="table-responsive mt-3">
            <table class="table min-w-full divide-y divide-slate-100">
                <thead>
                    <tr class="bg-slate-50 text-xs font-bold text-gray-500 uppercase">
                        <th class="px-6 py-3 text-left">Meeting Info</th>
                        <th class="px-6 py-3 text-left">Host</th>
                        <th class="px-6 py-3 text-left">Status</th>
                        <th class="px-6 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-100 text-sm">
                    <% meetings.forEach(meeting => { %>
                        <%
                            let badgeClass = 'badge-secondary';
                            if (meeting.status === 'scheduled') badgeClass = 'badge-primary';
                            if (meeting.status === 'live') badgeClass = 'badge-success animate-pulse';
                            if (meeting.status === 'completed') badgeClass = 'badge-secondary';

                            const startMs = new Date(meeting.scheduled_at).getTime();
                            const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                            const now = Date.now();
                            const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
                        %>
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-bold text-gray-800"><%= meeting.title %></div>
                                <div class="text-[11px] text-gray-400 mt-1">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                    · <i class="fas fa-clock me-1"></i><%= meeting.duration_minutes %> mins
                                </div>
                            </td>
                            <td class="px-6 py-4 text-gray-600 font-semibold">
                                <%= meeting.creator_name || 'Admin' %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="badge <%= badgeClass %>">
                                    <%= meeting.status %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/student/meetings/<%= meeting.id %>" class="btn btn-sm btn-secondary">
                                        <i class="fas fa-eye me-1"></i> Details
                                    </a>
                                    <% if (canJoin) { %>
                                        <a href="/student/meetings/<%= meeting.id %>/join" class="btn btn-sm btn-success">
                                            <i class="fas fa-video me-1"></i> Join
                                        </a>
                                    <% } else { %>
                                        <button class="btn btn-sm btn-secondary opacity-50 cursor-not-allowed" disabled>
                                            <i class="fas fa-video me-1"></i> Join
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
