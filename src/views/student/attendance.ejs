<style>
    [data-theme="dark"] .att-stat-card,
    [data-theme="dark"] .att-calendar-card,
    [data-theme="dark"] .att-cal-header,
    [data-theme="dark"] .att-cal-cell {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .att-cal-weekday {
        background: #0F172A !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .att-stat-card strong,
    [data-theme="dark"] .att-cal-header h3,
    [data-theme="dark"] .att-cal-cell span,
    [data-theme="dark"] .att-cal-cell .att-cal-day-num {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .att-cal-cell:hover {
        background: #1E293B !important;
        border-color: #334155 !important;
    }

    .student-attendance-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 10px;
        width: 100%;
    }
    .att-stat-card {
        background: #ffffff;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
    }
    .att-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }
    .att-stat-icon.present { background: #ECFDF5; color: #047857; }
    .att-stat-icon.absent { background: #FFF1F2; color: #BE123C; }
    .att-stat-icon.late { background: #FEF3C7; color: #B45309; }
    .att-stat-icon.percentage { background: #F5F3FF; color: #7C3AED; }

    .att-calendar-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
        margin-bottom: 10px;
        width: 100%;
        display: block;
    }
    .att-cal-header {
        padding: 14px 20px;
        border-bottom: 1px solid #F1F5F9;
        background: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .att-cal-content {
        padding: 20px;
        width: 100%;
        box-sizing: border-box;
        display: block;
    }
    .att-cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 10px;
        width: 100%;
        box-sizing: border-box;
    }
    .att-cal-weekday {
        font-weight: 700;
        font-size: 11px;
        color: #64748B;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 10px 0;
        text-align: center;
        background: #F8FAFC;
        border-radius: 8px;
        border: 1px solid #F1F5F9;
    }
    .att-cal-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 10px;
        width: 100%;
        box-sizing: border-box;
    }
    .att-cal-cell {
        background: #ffffff;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 12px 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        min-height: 64px;
        width: 100%;
        box-sizing: border-box;
        transition: all 0.15s ease;
    }
    .att-cal-cell:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    }
    .att-cal-cell.empty {
        background: transparent;
        border: none;
        min-height: 0;
        pointer-events: none;
    }
    .att-cal-cell.empty:hover {
        transform: none;
        box-shadow: none;
    }
    .att-cal-cell.present { background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; }
    .att-cal-cell.absent { background: #FFF1F2; color: #BE123C; border: 1px solid #FECDD3; }
    .att-cal-cell.late { background: #FEF3C7; color: #B45309; border: 1px solid #FDE68A; }
    .att-cal-cell.holiday { background: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; }
    .att-cal-cell.leave { background: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; }
    .att-cal-cell.not_marked { background: #FFFFFF; color: #334155; border: 1px solid #E2E8F0; }

    .att-cal-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
        padding: 12px 20px;
        border-top: 1px solid #F1F5F9;
        background: #F8FAFC;
        font-size: 12px;
        font-weight: 600;
        color: #64748B;
    }

    @media (max-width: 991px) {
        .student-attendance-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 480px) {
        .student-attendance-grid {
            grid-template-columns: 1fr;
        }
        .att-cal-weekdays,
        .att-cal-grid {
            gap: 4px;
        }
        .att-cal-cell {
            min-height: 48px;
            padding: 6px 2px;
        }
    }
</style>

<div style="background: linear-gradient(135deg, #7c3aed, #5b21b6); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 10px; position: relative; overflow: hidden;">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">My Attendance</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">View monthly attendance percentage, trends, and history</p>
        </div>
        <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
            <select name="month" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #7c3aed; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                <% for(let i=1; i<=12; i++) { %>
                    <option value="<%= i %>" <%= selectedMonth === i ? 'selected' : '' %>>
                        <%= new Date(2000, i-1, 1).toLocaleString('default', { month: 'long' }) %>
                    </option>
                <% } %>
            </select>
            <select name="year" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #7c3aed; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                <% for(let y = new Date().getFullYear(); y >= new Date().getFullYear()-2; y--) { %>
                    <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
                <% } %>
            </select>
        </form>
    </div>
</div>

<div class="student-attendance-grid">
    <div class="att-stat-card">
        <div class="att-stat-icon present">
            <i class="fas fa-check"></i>
        </div>
        <div>
            <div style="font-size: 10.5px; color: #64748B; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Present</div>
            <div style="font-size: 22px; font-weight: 800; color: #047857; line-height: 1.2;"><%= stats.presentDays %></div>
        </div>
    </div>
    <div class="att-stat-card">
        <div class="att-stat-icon absent">
            <i class="fas fa-times"></i>
        </div>
        <div>
            <div style="font-size: 10.5px; color: #64748B; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Absent</div>
            <div style="font-size: 22px; font-weight: 800; color: #BE123C; line-height: 1.2;"><%= stats.absentDays %></div>
        </div>
    </div>
    <div class="att-stat-card">
        <div class="att-stat-icon late">
            <i class="fas fa-clock"></i>
        </div>
        <div>
            <div style="font-size: 10.5px; color: #64748B; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Late</div>
            <div style="font-size: 22px; font-weight: 800; color: #B45309; line-height: 1.2;"><%= stats.lateDays %></div>
        </div>
    </div>
    <div class="att-stat-card">
        <div class="att-stat-icon percentage">
            <i class="fas fa-percentage"></i>
        </div>
        <div>
            <div style="font-size: 10.5px; color: #64748B; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">Percentage</div>
            <div style="font-size: 22px; font-weight: 800; color: #7C3AED; line-height: 1.2;"><%= stats.percentage %>%</div>
        </div>
    </div>
</div>

<div class="att-calendar-card">
    <div class="att-cal-header">
        <h3 style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-calendar-days" style="color: #7C3AED;"></i>
            <%= new Date(selectedYear, selectedMonth-1, 1).toLocaleString('default', { month: 'long', year: 'numeric' }) %> Attendance
        </h3>
        <span style="font-size: 12px; color: #64748B; font-weight: 500;">
            <%= stats.percentage %>% Monthly Attendance
        </span>
    </div>
    <div class="att-cal-content">
        <div class="att-cal-weekdays">
            <div class="att-cal-weekday">Sun</div>
            <div class="att-cal-weekday">Mon</div>
            <div class="att-cal-weekday">Tue</div>
            <div class="att-cal-weekday">Wed</div>
            <div class="att-cal-weekday">Thu</div>
            <div class="att-cal-weekday">Fri</div>
            <div class="att-cal-weekday">Sat</div>
        </div>
        <div class="att-cal-grid">
            <% 
                const firstDay = new Date(selectedYear, selectedMonth-1, 1).getDay();
                for(let i=0; i<firstDay; i++) { %>
                <div class="att-cal-cell empty"></div>
            <% } %>
            <% calendarDays.forEach(day => { %>
                <div class="att-cal-cell <%= day.status %>" title="<%= day.remark || day.status %>">
                    <span style="font-weight: 700; font-size: 14px;"><%= day.day %></span>
                    <% if(day.status === 'present') { %><i class="fas fa-check" style="font-size: 10px;"></i>
                    <% } else if(day.status === 'absent') { %><i class="fas fa-times" style="font-size: 10px;"></i>
                    <% } else if(day.status === 'late') { %><i class="fas fa-clock" style="font-size: 10px;"></i>
                    <% } else if(day.status === 'leave') { %><i class="fas fa-plane-departure" style="font-size: 10px; color: #3B82F6;"></i>
                    <% } else if(day.status === 'holiday') { %><i class="fas fa-umbrella-beach" style="font-size: 10px;"></i>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>
    <div class="att-cal-legend">
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-check" style="color: #10B981;"></i> Present</span>
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-times" style="color: #EF4444;"></i> Absent</span>
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-clock" style="color: #F59E0B;"></i> Late</span>
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-adjust" style="color: #0EA5E9;"></i> Half Day</span>
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-umbrella-beach" style="color: #64748B;"></i> Holiday</span>
    </div>
</div>
<% if (monthlySummary.length > 0) { %>
    <div class="att-calendar-card">
        <div class="att-cal-header">
            <h3 style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-chart-line" style="color: #7C3AED;"></i> 6 Months Attendance Trend
            </h3>
        </div>
        <div style="padding: 20px;">
            <div style="max-height: 220px; width: 100%;">
                <canvas id="attendanceChart" height="80"></canvas>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        new Chart(document.getElementById('attendanceChart'), {
            type: 'line',
            data: {
                labels: JSON.parse('<%- JSON.stringify(monthlySummary.map(m => new Date(m.year, m.month-1).toLocaleString("default", { month: "short" })).reverse()) %>'),
                datasets: [{
                    label: 'Attendance %',
                    data: JSON.parse('<%- JSON.stringify(monthlySummary.map(m => m.total > 0 ? Math.round((m.present/m.total)*100) : 0).reverse()) %>'),
                    borderColor: 'rgb(124, 58, 237)',
                    tension: 0.4,
                    fill: true,
                    backgroundColor: 'rgba(124, 58, 237, 0.1)'
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, scales: { y: { min: 0, max: 100 } } }
        });
    </script>
<% } %>