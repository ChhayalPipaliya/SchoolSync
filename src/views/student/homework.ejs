<%
    const hwList = (typeof homeworks !== 'undefined' && homeworks) ? homeworks : [];
    const curStats = (typeof stats !== 'undefined' && stats) ? stats : { total: 0, pending: 0, overdue: 0, seen: 0 };
    const curStatus = (typeof status !== 'undefined' && status) ? status : 'all';
    const st = (typeof student !== 'undefined' && student) ? student : {};
    const subs = (typeof subjectsList !== 'undefined' && subjectsList) ? subjectsList : [];

    const getSubjectMeta = function(name) {
        if (!name) return { cls: 'subj-default', icon: 'fa-book-open' };
        const n = String(name).toLowerCase();
        if (n.includes('math')) return { cls: 'subj-math', icon: 'fa-calculator' };
        if (n.includes('sci') || n.includes('physic') || n.includes('chem') || n.includes('bio')) return { cls: 'subj-science', icon: 'fa-flask' };
        if (n.includes('eng')) return { cls: 'subj-english', icon: 'fa-book' };
        if (n.includes('social') || n.includes('history') || n.includes('geo') || n.includes('civic')) return { cls: 'subj-social', icon: 'fa-earth-americas' };
        if (n.includes('art') || n.includes('draw') || n.includes('craft')) return { cls: 'subj-art', icon: 'fa-palette' };
        if (n.includes('comp') || n.includes('it') || n.includes('cs') || n.includes('code')) return { cls: 'subj-computer', icon: 'fa-laptop-code' };
        if (n.includes('guj') || n.includes('hin') || n.includes('sansk') || n.includes('lang')) return { cls: 'subj-lang', icon: 'fa-language' };
        if (n.includes('pe') || n.includes('sport') || n.includes('phys') || n.includes('yoga')) return { cls: 'subj-pe', icon: 'fa-person-running' };
        if (n.includes('evs') || n.includes('env')) return { cls: 'subj-evs', icon: 'fa-leaf' };
        if (n.includes('music')) return { cls: 'subj-music', icon: 'fa-music' };
        return { cls: 'subj-default', icon: 'fa-graduation-cap' };
    };

    const getDueStatus = function(dueDateStr, isCompleted) {
        if (isCompleted) return { cls: 'due-completed', label: 'Completed', icon: 'fa-circle-check' };
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const due = new Date(dueDateStr);
        due.setHours(0, 0, 0, 0);

        const diffTime = due.getTime() - today.getTime();
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

        if (diffDays < 0) {
            const overdueDays = Math.abs(diffDays);
            return {
                cls: 'due-overdue',
                label: overdueDays === 1 ? 'Overdue by 1 day' : 'Overdue by ' + overdueDays + ' days',
                icon: 'fa-triangle-exclamation'
            };
        } else if (diffDays === 0) {
            return { cls: 'due-today', label: 'Due Today!', icon: 'fa-clock' };
        } else if (diffDays === 1) {
            return { cls: 'due-soon', label: 'Due Tomorrow', icon: 'fa-hourglass-half' };
        } else {
            return { cls: 'due-normal', label: 'Due in ' + diffDays + ' days', icon: 'fa-calendar-check' };
        }
    };
%>

