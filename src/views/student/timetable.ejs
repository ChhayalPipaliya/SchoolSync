        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
        border-color: #CBD5E1;
    }

    .subj-math     { background: #EEF2FF; }
    .subj-math .lecture-subject-title { color: #4338CA; }
    .subj-science  { background: #ECFDF5; }
    .subj-science .lecture-subject-title { color: #065F46; }
    .subj-english  { background: #EFF6FF; }
    .subj-english .lecture-subject-title { color: #1E40AF; }
    .subj-social   { background: #FEF3C7; }
    .subj-social .lecture-subject-title { color: #92400E; }
    .subj-art      { background: #FDF2F8; }
    .subj-art .lecture-subject-title { color: #9D174D; }
    .subj-computer { background: #F0FDFA; }
    .subj-computer .lecture-subject-title { color: #115E59; }
    .subj-lang     { background: #FFF7ED; }
    .subj-lang .lecture-subject-title { color: #9A3412; }
    .subj-pe       { background: #F0FDF4; }
    .subj-pe .lecture-subject-title { color: #166534; }
    .subj-evs      { background: #F0FDF4; }
    .subj-evs .lecture-subject-title { color: #15803D; }
    .subj-music    { background: #FAF5FF; }
    .subj-music .lecture-subject-title { color: #6B21A8; }
    .subj-default  { background: #F5F3FF; }
    .subj-default .lecture-subject-title { color: #5B21B6; }

    .lecture-subject-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        margin-bottom: 6px;
    }

    .lecture-subject-title {
        font-size: 13px;
        font-weight: 700;
        line-height: 1.3;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .lecture-subject-icon {
        font-size: 11px;
        opacity: 0.85;
    }

    .lecture-room-tag {
        font-size: 10px;
        font-weight: 700;
        color: #64748B;
        background: rgba(255, 255, 255, 0.7);
        padding: 1px 5px;
        border-radius: 4px;
    }

    .lecture-teacher-info {
        font-size: 11.5px;
        color: #475569;
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 4px;
    }

    .lecture-teacher-icon {
        color: #94A3B8;
        font-size: 10px;
    }

    .sub-badge {
        background: #FEF3C7;
        color: #92400E;
        border: 1px solid #FDE68A;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 6px;
    }

    .tt-break-row td {
        background: #FFFBEB !important;
        border-top: 1px solid #FDE68A !important;
        border-bottom: 1px solid #FDE68A !important;
        padding: 10px 14px !important;
    }

    .break-cell-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #B45309;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: #FEF3C7;
        padding: 8px 14px;
        border-radius: 8px;
        border: 1px dashed #FCD34D;
    }

    .break-badge-inline {
        background: #FDE68A;
        color: #78350F;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 800;
    }

    .empty-cell-box {
        background: #FAFBFD;
        border: 1px dashed #E2E8F0;
        border-radius: 8px;
        padding: 12px 8px;
        text-align: center;
        color: #94A3B8;
        font-size: 11.5px;
        font-weight: 500;
    }

    .tt-daily-view {
        padding: 24px 20px;
        display: none;
    }

    .tt-day-selector {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 12px;
        margin-bottom: 20px;
        border-bottom: 1px solid #F1F5F9;
    }

    .tt-day-chip {
        border: 1px solid #E2E8F0;
        background: #FFFFFF;
        color: #475569;
        padding: 8px 18px;
        border-radius: 24px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .tt-day-chip:hover {
        border-color: #C4B5FD;
        color: #7C3AED;
        background: #FAF5FF;
    }

    .tt-day-chip.active {
        background: #7C3AED;
        color: #FFFFFF;
        border-color: #7C3AED;
        box-shadow: 0 4px 10px rgba(124, 58, 237, 0.25);
    }

    .tt-timeline-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }

    .timeline-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 18px;
        position: relative;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .timeline-card:hover {
        border-color: #DDD6FE;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.08);
    }

    .timeline-card.is-break {
        background: #FFFBEB;
        border-color: #FDE68A;
    }

    .badge-completed {
        background: #F1F5F9;
        color: #64748B;
        border: 1px solid #E2E8F0;
    }

    .badge-ongoing {
        background: #ECFDF5;
        color: #059669;
        border: 1px solid #A7F3D0;
        animation: pulseGreen 2s infinite;
    }

    @keyframes pulseGreen {
        0% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
        }
        70% {
            box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }

    .badge-upcoming {
        background: #EFF6FF;
        color: #2563EB;
        border: 1px solid #BFDBFE;
    }

    .day-schedule-container.is-hidden {
        display: none;
    }

    @media print {
        body {
            background: #FFFFFF !important;
            color: #000000 !important;
        }

        .sidebar,
        .navbar,
        .tt-action-btn,
        .tt-tabs,
        .tt-stats-grid,
        .btn,
        .chat-widget,
        header {
            display: none !important;
        }

        .tt-header-banner {
            background: #FFFFFF !important;
            color: #000000 !important;
            border: 2px solid #000000 !important;
            box-shadow: none !important;
            padding: 12px !important;
            margin-bottom: 12px !important;
        }

        .tt-header-title {
            color: #000000 !important;
            font-size: 20px !important;
        }

        .tt-meta-pill {
            background: #F1F5F9 !important;
            color: #000000 !important;
            border: 1px solid #CBD5E1 !important;
        }

        .tt-main-card {
            border: none !important;
            box-shadow: none !important;
        }

        .tt-grid-table {
            border: 1px solid #000000 !important;
            min-width: 100% !important;
        }

        .tt-grid-table th,
        .tt-grid-table td {
            border: 1px solid #CBD5E1 !important;
            padding: 6px 8px !important;
            font-size: 10px !important;
        }

        .lecture-card {
            border: 1px solid #CBD5E1 !important;
            padding: 6px 8px !important;
            box-shadow: none !important;
        }

        .lecture-subject-title {
            font-size: 11px !important;
        }

        .lecture-teacher-info {
            font-size: 9.5px !important;
        }

        .tt-daily-view {
            display: none !important;
        }

        #weeklyMatrixView {
            display: block !important;
        }
    }
</style>
<div class="tt-header-banner">
    <div class="tt-header-decor-1"></div>
    <div class="tt-header-decor-2"></div>
    <div class="tt-header-content">
        <div>
            <h1 class="tt-header-title">
                <i class="fa-solid fa-calendar-week"></i>
                Class Timetable
            </h1>
            <div class="tt-header-subtitle">
                <span>Weekly schedule of lectures and timings</span>
                <% if (st.class_name) { %>
                    <span class="tt-meta-pill">
                        <i class="fa-solid fa-chalkboard"></i> Class <%= st.class_name %> <%= st.section ? ('- ' + st.section) : '' %>
                    </span>
                <% } %>
                <% if (st.roll_no) { %>
                    <span class="tt-meta-pill">
                        <i class="fa-solid fa-id-badge"></i> Roll #<%= st.roll_no %>
                    </span>
                <% } %>
                <% if (curYear) { %>
                    <span class="tt-meta-pill">
                        <i class="fa-solid fa-graduation-cap"></i> <%= curYear %> <%= curTerm ? (' • ' + curTerm) : '' %>
                    </span>
                <% } %>
            </div>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <button type="button" onclick="window.print()" class="tt-action-btn">
                <i class="fa-solid fa-print"></i>
                <span>Print Schedule</span>
            </button>
        </div>
    </div>
</div>
<div class="tt-stats-grid">
    <div class="tt-stat-card">
        <div class="tt-stat-icon purple">
            <i class="fa-solid fa-calendar-day"></i>
        </div>
        <div>
            <div class="tt-stat-value"><%= curToday %></div>
            <div class="tt-stat-label"><%= todayCount %> Lectures Scheduled Today</div>
        </div>
    </div>
    <div class="tt-stat-card">
        <div class="tt-stat-icon blue">
            <i class="fa-solid fa-book-open"></i>
        </div>
        <div>
            <div class="tt-stat-value"><%= subCount %></div>
            <div class="tt-stat-label">Total Unique Subjects</div>
        </div>
    </div>
    <div class="tt-stat-card">
        <div class="tt-stat-icon green">
            <i class="fa-solid fa-clock"></i>
        </div>
        <div>
            <div class="tt-stat-value"><%= weeklyCount %></div>
            <div class="tt-stat-label">Weekly Class Sessions</div>
        </div>
    </div>
    <div class="tt-stat-card">
        <div class="tt-stat-icon amber">
            <i class="fa-solid fa-mug-hot"></i>
        </div>
        <div>
            <div class="tt-stat-value">
                <%= breakInfo ? (((breakInfo.start_time || '').slice(0, 5)) + ' - ' + ((breakInfo.end_time || '').slice(0, 5))) : 'Recess Break' %>
            </div>
            <div class="tt-stat-label">
                <%= breakInfo ? (breakInfo.label || 'Daily Break') : 'Daily Break Interval' %>
            </div>
        </div>
    </div>
</div>
<% if (listPeriods.length === 0 || !hasEntries) { %>
    <div class="tt-main-card" style="padding: 60px 24px; text-align: center;">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: #F5F3FF; color: #7C3AED; display: flex; align-items: center; justify-content: center; font-size: 24px; margin: 0 auto 16px;">
            <i class="fa-solid fa-calendar-xmark"></i>
        </div>
        <h3 style="font-size: 18px; font-weight: 800; color: #1E293B; margin: 0 0 8px;">Timetable Not Published Yet</h3>
        <p style="font-size: 13.5px; color: #64748B; margin: 0 auto; max-width: 420px; line-height: 1.5;">
            Your class timetable has not been published yet by the school administration. Please check back soon or contact your class teacher.
        </p>
    </div>
<% } else { %>
    <div class="tt-main-card">
        <div class="tt-card-toolbar">
            <div class="tt-tabs">
                <button type="button" class="tt-tab-btn active" id="btnWeeklyView" onclick="switchTimetableView('weekly')">
                    <i class="fa-solid fa-table-cells"></i> Weekly Matrix
                </button>
                <button type="button" class="tt-tab-btn" id="btnDailyView" onclick="switchTimetableView('daily')">
                    <i class="fa-solid fa-list-check"></i> Daily Timeline
                </button>
            </div>
            <div class="tt-legend">
                <span class="tt-legend-item">
                    <span class="tt-legend-dot" style="background: #7C3AED;"></span> Current Day
                </span>
                <span class="tt-legend-item">
                    <span class="tt-legend-dot" style="background: #F59E0B;"></span> Break Period
                </span>
                <span class="tt-legend-item">
                    <span class="tt-legend-dot" style="background: #10B981;"></span> Regular Lecture
                </span>
            </div>
        </div>
        <div id="weeklyMatrixView">
            <div class="tt-table-responsive">
                <table class="tt-grid-table">
                    <thead>
                        <tr>
                            <th class="col-period">
                                <i class="fa-regular fa-clock" style="margin-right: 4px;"></i> Period / Time
                            </th>
                            <% listDays.forEach(function(day) { 
                                const isToday = (day.toLowerCase() === curToday.toLowerCase());
                            %>
                                <th class="<%= isToday ? 'col-today' : '' %>">
                                    <span><%= day %></span>
                                    <% if (isToday) { %>
                                        <span class="tt-today-pill">TODAY</span>
                                    <% } %>
                                </th>
                            <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <% listPeriods.forEach(function(period) { 
                            const isBreak = period.is_break || period.slot_type === 'break' || period.slot_type === 'short_break' || period.slot_type === 'lunch_break';
                        %>
                            <% if (isBreak) { %>
                                <tr class="tt-break-row">
                                    <td class="col-period">
                                        <div class="period-meta-box">
                                            <div class="period-number-badge" style="color: #B45309;">
                                                <i class="fa-solid fa-mug-hot"></i>
                                                <%= period.label || 'Break' %>
                                            </div>
                                            <div class="period-time-range break-text">
                                                <%= (period.start_time || '').slice(0, 5) %> - <%= (period.end_time || '').slice(0, 5) %>
                                            </div>
                                        </div>
                                    </td>
                                    <% listDays.forEach(function(day) { %>
                                        <td>
                                            <div class="break-cell-content">
                                                <i class="fa-solid fa-mug-hot"></i>
                                                <span>RECESS BREAK</span>
                                            </div>
                                        </td>
                                    <% }); %>
                                </tr>
                            <% } else { %>
                                <tr>
                                    <td class="col-period">
                                        <div class="period-meta-box">
                                            <div class="period-number-badge">
                                                <span><%= period.label || ('Period ' + (period.period_number || '')) %></span>
                                            </div>
                                            <div class="period-time-range">
                                                <i class="fa-regular fa-clock text-[10px]"></i>
                                                <span><%= (period.start_time || '').slice(0, 5) %> - <%= (period.end_time || '').slice(0, 5) %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <% listDays.forEach(function(day) { 
                                        const isToday = (day.toLowerCase() === curToday.toLowerCase());
                                        const entry = (grid[day] && grid[day][period.id]) ? grid[day][period.id] : null;
                                    %>
                                        <td class="<%= isToday ? 'col-today' : '' %>">
                                            <% if (entry) { 
                                                const sMeta = getSubjectMeta(entry.subject_name);
                                            %>
                                                <div class="lecture-card <%= sMeta.cls %>">
                                                    <div class="lecture-subject-header">
                                                        <span class="lecture-subject-title">
                                                            <i class="fa-solid <%= sMeta.icon %> lecture-subject-icon"></i>
                                                            <span><%= entry.subject_name %></span>
                                                        </span>
                                                        <% if (entry.room_number) { %>
                                                            <span class="lecture-room-tag">
                                                                R-<%= entry.room_number %>
                                                            </span>
                                                        <% } %>
                                                    </div>

                                                    <div class="lecture-teacher-info">
                                                        <i class="fa-solid fa-chalkboard-user lecture-teacher-icon"></i>
                                                        <span style="font-weight: 500;">
                                                            <%= entry.teacher_first_name ? (entry.teacher_first_name + ' ' + (entry.teacher_last_name || '')) : 'Subject Faculty' %>
                                                        </span>
                                                    </div>

                                                    <% if (entry.is_substituted) { %>
                                                        <div>
                                                            <span class="sub-badge" title="Proxy / Substitute Faculty">
                                                                <i class="fa-solid fa-arrows-rotate"></i> Substituted
                                                            </span>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% } else { %>
                                                <div class="empty-cell-box">
                                                    <span>—</span>
                                                </div>
                                            <% } %>
                                        </td>
                                    <% }); %>
                                </tr>
                            <% } %>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <div id="dailyTimelineView" class="tt-daily-view">
            <div class="tt-day-selector">
                <% listDays.forEach(function(day) { 
                    const isToday = (day.toLowerCase() === curToday.toLowerCase());
                %>
                    <button type="button" class="tt-day-chip <%= isToday ? 'active' : '' %>" onclick="selectDaySchedule('<%= day %>')" id="dayChip-<%= day %>">
                        <i class="fa-solid fa-calendar-day"></i>
                        <span><%= day %></span>
                        <% if (isToday) { %>
                            <span style="font-size: 9.5px; opacity: 0.9; margin-left: 2px;">(Today)</span>
                        <% } %>
                    </button>
                <% }); %>
            </div>
            <% listDays.forEach(function(day) { 
                const isToday = (day.toLowerCase() === curToday.toLowerCase());
            %>
                <div class="day-schedule-container <%= isToday ? '' : 'is-hidden' %>" id="daySchedule-<%= day %>">
                    <div style="margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
                        <h4 style="font-size: 15px; font-weight: 800; color: #1E293B; margin: 0; display: flex; align-items: center; gap: 8px;">
                            <i class="fa-solid fa-clock-rotate-left" style="color: #7C3AED;"></i> Schedule for <%= day %>
                        </h4>
                        <span style="font-size: 12px; color: #64748B; font-weight: 500;">
                            <%= listPeriods.length %> Period Slots
                        </span>
                    </div>
                    <div class="tt-timeline-grid">
                        <% listPeriods.forEach(function(period) { 
                            const isBreak = period.is_break || period.slot_type === 'break' || period.slot_type === 'short_break' || period.slot_type === 'lunch_break';
                            const entry = (grid[day] && grid[day][period.id]) ? grid[day][period.id] : null;
                            const timingStatus = isToday ? getLectureTimingStatus(period.start_time, period.end_time) : null;
                        %>
                            <% if (isBreak) { %>
                                <div class="timeline-card is-break">
                                    <div>
                                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                                            <span style="font-size: 12px; font-weight: 800; color: #B45309; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                                                <i class="fa-solid fa-mug-hot"></i> <%= period.label || 'Break Time' %>
                                            </span>
                                            <span class="break-badge-inline">Recess</span>
                                        </div>
                                        <div style="font-size: 14px; font-weight: 700; color: #92400E; margin-bottom: 4px;">
                                            Break & Refreshment
                                        </div>
                                        <div style="font-size: 12px; color: #B45309; display: flex; align-items: center; gap: 5px;">
                                            <i class="fa-regular fa-clock text-[11px]"></i>
                                            <span><%= (period.start_time || '').slice(0, 5) %> - <%= (period.end_time || '').slice(0, 5) %></span>
                                        </div>
                                    </div>
                                </div>
                            <% } else if (entry) { 
                                const sMeta = getSubjectMeta(entry.subject_name);
                            %>
                                <div class="timeline-card <%= sMeta.cls %>">
                                    <div>
                                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                                            <span style="font-size: 11.5px; font-weight: 700; color: #64748B; background: #F1F5F9; padding: 2px 8px; border-radius: 6px;">
                                                <%= period.label || ('Period ' + period.period_number) %>
                                            </span>
                                            <% if (timingStatus) { %>
                                                <span class="tt-meta-pill <%= timingStatus.cls %>" style="font-size: 10px; padding: 2px 8px;">
                                                    <%= timingStatus.label %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="lecture-subject-title" style="font-size: 15px; font-weight: 800; margin-bottom: 6px;">
                                            <i class="fa-solid <%= sMeta.icon %>"></i>
                                            <span><%= entry.subject_name %></span>
                                        </div>
                                        <div style="font-size: 12.5px; color: #475569; display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
                                            <i class="fa-solid fa-chalkboard-user" style="color: #94A3B8; font-size: 11px;"></i>
                                            <span><%= entry.teacher_first_name ? (entry.teacher_first_name + ' ' + (entry.teacher_last_name || '')) : 'Subject Faculty' %></span>
                                        </div>
                                        <div style="font-size: 12px; color: #64748B; display: flex; align-items: center; gap: 5px;">
                                            <i class="fa-regular fa-clock" style="font-size: 11px;"></i>
                                            <span><%= (period.start_time || '').slice(0, 5) %> - <%= (period.end_time || '').slice(0, 5) %></span>
                                            <% if (entry.room_number) { %>
                                                <span style="margin-left: 6px; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 1px 6px; border-radius: 4px; font-size: 10.5px;">
                                                    Room <%= entry.room_number %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <% if (entry.is_substituted) { %>
                                        <div style="margin-top: 10px;">
                                            <span class="sub-badge">
                                                <i class="fa-solid fa-arrows-rotate"></i> Substituted Faculty
                                            </span>
                                        </div>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <div class="timeline-card" style="background: #FAFBFD; border: 1px dashed #E2E8F0;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                                        <span style="font-size: 11.5px; font-weight: 700; color: #94A3B8; background: #F1F5F9; padding: 2px 8px; border-radius: 6px;">
                                            <%= period.label || ('Period ' + period.period_number) %>
                                        </span>
                                        <span style="font-size: 11px; color: #94A3B8;">Free Period</span>
                                    </div>
                                    <div style="font-size: 13.5px; font-weight: 600; color: #94A3B8; margin-bottom: 4px;">
                                        No Class Scheduled
                                    </div>
                                    <div style="font-size: 12px; color: #CBD5E1;">
                                        <%= (period.start_time || '').slice(0, 5) %> - <%= (period.end_time || '').slice(0, 5) %>
                                    </div>
                                </div>
                            <% } %>
                        <% }); %>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
<% } %>
<script>
    function switchTimetableView(view) {
        var weeklyView = document.getElementById('weeklyMatrixView');
        var dailyView = document.getElementById('dailyTimelineView');
        var btnWeekly = document.getElementById('btnWeeklyView');
        var btnDaily = document.getElementById('btnDailyView');

        if (!weeklyView || !dailyView) return;

        if (view === 'weekly') {
            weeklyView.style.display = 'block';
            dailyView.style.display = 'none';
            if (btnWeekly) btnWeekly.classList.add('active');
            if (btnDaily) btnDaily.classList.remove('active');
        } else {
            weeklyView.style.display = 'none';
            dailyView.style.display = 'block';
            if (btnWeekly) btnWeekly.classList.remove('active');
            if (btnDaily) btnDaily.classList.add('active');
        };
    };

    function selectDaySchedule(day) {
        var containers = document.querySelectorAll('.day-schedule-container');
        for (var i = 0; i < containers.length; i++) {
            containers[i].classList.add('is-hidden');
            containers[i].style.display = 'none';
        };

        var chips = document.querySelectorAll('.tt-day-chip');
        for (var j = 0; j < chips.length; j++) {
            chips[j].classList.remove('active');
        };

        var target = document.getElementById('daySchedule-' + day);
        if (target) {
            target.classList.remove('is-hidden');
            target.style.display = 'block';
        };

        var chip = document.getElementById('dayChip-' + day);
        if (chip) chip.classList.add('active');
    };
</script>