    const st = (typeof student !== 'undefined' && student) ? student : {};
    const curYear = (typeof activeYear !== 'undefined' && activeYear) ? (activeYear.academic_year || activeYear.name || '') : '';
    const curTerm = (typeof activeTerm !== 'undefined' && activeTerm) ? (activeTerm.name || '') : '';
    const curToday = (typeof todayDayName !== 'undefined' && todayDayName) ? todayDayName : 'Monday';
    const subCount = (typeof totalSubjectsCount !== 'undefined') ? totalSubjectsCount : 0;
    const weeklyCount = (typeof totalWeeklyLectures !== 'undefined') ? totalWeeklyLectures : 0;
    const todayCount = (typeof todayLecturesCount !== 'undefined') ? todayLecturesCount : 0;
    const breakInfo = (typeof breakSlot !== 'undefined' && breakSlot) ? breakSlot : null;
    const allEntries = (typeof entries !== 'undefined' && entries) ? entries : [];

    const getSubjectMeta = function(name) {
        if (!name) return { cls: 'subj-default', icon: 'fa-book-open' };
        const n = String(name).toLowerCase();
        if (n.includes('math')) return { cls: 'subj-math', icon: 'fa-calculator' };
        if (n.includes('sci') || n.includes('physic') || n.includes('chem') || n.includes('bio')) return { cls: 'subj-science', icon: 'fa-flask' };
        if (n.includes('eng')) return { cls: 'subj-english', icon: 'fa-book' };
        if (n.includes('social') || n.includes('history') || n.includes('geo') || n.includes('civic')) return { cls: 'subj-social', icon: 'fa-earth-americas' };
        if (n.includes('art') || n.includes('draw') || n.includes('craft')) return { cls: 'subj-art', icon: 'fa-palette' };
        if (n.includes('comp') || n.includes('it') || n.includes('cs') || n.includes('code')) return { cls: 'subj-computer', icon: 'fa-laptop-code' };
        if (n.includes('guj') || n.includes('hin') || n.includes('sansk') || n.includes('lang')) return { cls: 'subj-lang', icon: 'fa-language' };
        if (n.includes('pe') || n.includes('sport') || n.includes('phys') || n.includes('yoga')) return { cls: 'subj-pe', icon: 'fa-person-running' };
        if (n.includes('evs') || n.includes('env')) return { cls: 'subj-evs', icon: 'fa-leaf' };
        if (n.includes('music')) return { cls: 'subj-music', icon: 'fa-music' };
        return { cls: 'subj-default', icon: 'fa-graduation-cap' };
    };

    const parseTimeToMinutes = function(tStr) {
        if (!tStr) return 0;
        const str = String(tStr).trim().toUpperCase();
        const isPM = str.includes('PM');
        const isAM = str.includes('AM');
        const clean = str.replace(/AM|PM/g, '').trim();
        const parts = clean.split(':').map(function(n) { return parseInt(n, 10) || 0; });
        let h = parts[0] || 0;
        const m = parts[1] || 0;
        if (isPM && h < 12) h += 12;
        if (isAM && h === 12) h = 0;
        return h * 60 + m;
    };

    const getLectureTimingStatus = function(startTime, endTime) {
        const now = new Date();
        const currentMin = now.getHours() * 60 + now.getMinutes();
        const startMin = parseTimeToMinutes(startTime);
        const endMin = parseTimeToMinutes(endTime);

        if (currentMin >= endMin) {
            return { key: 'completed', label: 'Completed', cls: 'badge-completed' };
        } else if (currentMin >= startMin && currentMin < endMin) {
            return { key: 'ongoing', label: 'In Progress', cls: 'badge-ongoing' };
        } else {
            return { key: 'upcoming', label: 'Upcoming', cls: 'badge-upcoming' };
        }
    };
