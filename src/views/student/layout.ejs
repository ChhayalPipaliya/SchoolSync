<!DOCTYPE html>
<html lang="<%= typeof currentLan !== 'undefined' && currentLan ? (currentLan === 'gujrati' ? 'gu' : (currentLan === 'hindi' ? 'hi' : 'en')) : 'en' %>" data-theme="light">
<head>
  <%- include('../partials/head', {
    title: typeof title !== 'undefined' ? title + ' | SchoolSync' : ((typeof lan !== 'undefined' && lan.Student_Portal) ? lan.Student_Portal : 'Student Portal') + ' | SchoolSync',
    needsCharts: typeof needsCharts !== 'undefined' ? needsCharts : false
  }) %>
</head>
<body class="student-theme">
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header') %>
    <%- include('../partials/flashMessages') %>
    <div class="page-body">
      <%- body %>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>
</body>
</html>