<!DOCTYPE html>
<html lang="<%= (typeof currentLan !== 'undefined' && currentLan) ? (currentLan === 'german' ? 'de' : (currentLan === 'portuguese' ? 'pt' : (currentLan === 'spanish' ? 'es' : (currentLan === 'french' ? 'fr' : (currentLan === 'arabic' ? 'ar' : (currentLan === 'gujrati' ? 'gu' : (currentLan === 'hindi' ? 'hi' : 'en'))))))) : ((typeof currentLang !== 'undefined' && currentLang === 'german') ? 'de' : ((typeof currentLang !== 'undefined' && currentLang === 'portuguese') ? 'pt' : ((typeof currentLang !== 'undefined' && currentLang === 'spanish') ? 'es' : ((typeof currentLang !== 'undefined' && currentLang === 'french') ? 'fr' : ((typeof currentLang !== 'undefined' && currentLang === 'arabic') ? 'ar' : 'en'))))) %>" dir="<%= ((typeof currentLan !== 'undefined' && currentLan === 'arabic') || (typeof currentLang !== 'undefined' && currentLang === 'arabic')) ? 'rtl' : 'ltr' %>" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>" class="<%= (typeof theme !== 'undefined' && theme === 'dark') ? 'dark light-mode-disabled' : '' %>">
<head>
    <%- include('../partials/head', { title: typeof title !=='undefined' ? title + ' | SchoolSync' : ((typeof lan !=='undefined' && lan.Student_Portal) ? lan.Student_Portal : 'Student Portal' ) + ' | SchoolSync' , needsCharts: typeof needsCharts !=='undefined' ? needsCharts : false }) %>
</head>
<body class="student-theme">
    <div class="app-wrapper">
        <%- include('../partials/sidebar', { currentPath: typeof currentPath !=='undefined' ? currentPath : '' }) %>
        <main class="main-panel" id="mainPanel">
            <%- include('../partials/header') %>
            <%- include('../partials/flashMessages') %>
            <div class="page-body">
                <%- body %>
            </div>
            <%- include('../partials/footer') %>
        </main>
    </div>
</body>
</html>