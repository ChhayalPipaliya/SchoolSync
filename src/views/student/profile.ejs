    <% } %>
  </div>
  <div class="sp-panel" id="sp-panel-address" role="tabpanel" aria-labelledby="spt-address">
    <% if(address && address.id){ %>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px;">
      <div>
        <div class="sp-card">
          <div class="sp-card-title"><i class="fas fa-home"></i> Permanent Address</div>
          <p style="font-size:.88rem;line-height:1.6;color:var(--sp-text);">
            <%= esc(address.permanent_address) %>
            <% if(address.permanent_city){ %><br><%= address.permanent_city %><% } %>
            <% if(address.permanent_state){ %>, <%= address.permanent_state %><% } %>
            <% if(address.permanent_pincode){ %> — <%= address.permanent_pincode %><% } %>
            <br><%= address.permanent_country || 'India' %>
          </p>
          <% if(!address.current_address_same){ %>
          <hr class="sp-divider">
          <div class="sp-card-title" style="margin-top:16px;"><i class="fas fa-map-pin"></i> Current Address</div>
          <p style="font-size:.88rem;line-height:1.6;color:var(--sp-text);">
            <%= esc(address.current_address) %>
            <% if(address.current_city){ %><br><%= address.current_city %><% } %>
            <% if(address.current_state){ %>, <%= address.current_state %><% } %>
            <% if(address.current_pincode){ %> — <%= address.current_pincode %><% } %>
          </p>
          <% } else { %>
          <p style="font-size:.78rem;color:var(--sp-muted);font-style:italic;margin-top:8px;"><i class="fas fa-info-circle" style="margin-right:6px;"></i>Current address same as permanent</p>
          <% } %>
        </div>
      </div>
      <div>
        <div class="sp-card">
          <div class="sp-card-title"><i class="fas fa-phone-alt"></i> Contact &amp; Transport</div>
          <div class="sp-info-row"><span class="sp-info-label">Emergency Contact</span><span class="sp-info-value"><%= esc(address.emergency_contact) %></span></div>
          <div class="sp-info-row"><span class="sp-info-label">Transport Required</span><span class="sp-info-value"><span class="sp-chip <%= address.transport_required?'sp-chip-yes':'sp-chip-no'%>"><%= address.transport_required?'Yes':'No'%></span></span></div>
          <% if(address.transport_required){ %>
          <div class="sp-info-row"><span class="sp-info-label">Transport Mode</span><span class="sp-info-value"><%= esc(address.transport_mode) %></span></div>
          <div class="sp-info-row"><span class="sp-info-label">Route</span><span class="sp-info-value"><%= esc(address.transport_route) %></span></div>
          <div class="sp-info-row"><span class="sp-info-label">Vehicle No</span><span class="sp-info-value"><%= esc(address.transport_vehicle_no) %></span></div>
          <% } %>
          <hr class="sp-divider">
          <div class="sp-info-row"><span class="sp-info-label">Hostel Required</span><span class="sp-info-value"><span class="sp-chip <%= address.hostel_required?'sp-chip-yes':'sp-chip-no'%>"><%= address.hostel_required?'Yes':'No'%></span></span></div>
          <% if(address.hostel_required){ %>
          <div class="sp-info-row"><span class="sp-info-label">Hostel Name</span><span class="sp-info-value"><%= esc(address.hostel_name) %></span></div>
          <div class="sp-info-row"><span class="sp-info-label">Room No</span><span class="sp-info-value"><%= esc(address.hostel_room_no) %></span></div>
          <div class="sp-info-row"><span class="sp-info-label">Hostel Phone</span><span class="sp-info-value"><%= esc(address.hostel_phone_number) %></span></div>
          <% } %>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="sp-card"><div class="sp-empty"><i class="fas fa-map-marker-alt"></i>No address details available.</div></div>
    <% } %>
  </div>
  <div class="sp-panel" id="sp-panel-docs" role="tabpanel" aria-labelledby="spt-docs">
    <div class="sp-card">
      <div class="sp-card-title"><i class="fas fa-folder-open"></i> Uploaded Documents</div>
      <% if(documents && documents.length > 0){ %>
      <div class="sp-doc-grid">
        <% documents.forEach(function(doc){ %>
        <%
          var isImg = doc.document_type && ['student_image','father_image','mother_image'].includes(doc.document_type);
          var icon  = isImg ? 'fa-image' :
                      (doc.document_type === 'aadhaar_card' ? 'fa-id-card' :
                      (doc.document_type === 'birth_certificate' ? 'fa-certificate' :
                      (doc.document_type === 'previous_marksheet' ? 'fa-file-alt' : 'fa-file-pdf')));
          var label = doc.document_name || doc.document_type.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
        %>
        <div class="sp-doc-card">
          <div class="sp-doc-icon-wrap"><i class="fas <%= icon %>"></i></div>
          <div class="sp-doc-name"><%= label %></div>
          <div class="sp-doc-date"><i class="fas fa-clock me-1"></i><%= fmt(doc.uploaded_at) %></div>
          <div class="sp-doc-btns">
            <a href="<%= doc.file_url || doc.file_path || '#' %>" target="_blank" class="sp-doc-btn sp-doc-btn-view">
              <i class="fas fa-eye"></i> View
            </a>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <div class="sp-empty"><i class="fas fa-folder"></i>No documents uploaded yet.</div>
      <% } %>
    </div>
  </div>
  <div class="sp-panel" id="sp-panel-medical" role="tabpanel" aria-labelledby="spt-medical">
    <div class="sp-card">
      <div class="sp-card-title"><i class="fas fa-heartbeat"></i> Medical Information</div>
      <div class="sp-medical-grid mb-4">
        <div class="sp-med-card">
          <span class="sp-med-icon">🩸</span>
          <div class="sp-med-val"><%= student.blood_group || '—' %></div>
          <div class="sp-med-key">Blood Group</div>
        </div>
        <div class="sp-med-card">
          <span class="sp-med-icon">📞</span>
          <div class="sp-med-val" style="font-size:.9rem;"><%= address.emergency_contact || '—' %></div>
          <div class="sp-med-key">Emergency Contact</div>
        </div>
        <div class="sp-med-card">
          <span class="sp-med-icon">🏥</span>
          <div class="sp-med-val" style="font-size:.9rem;">As Required</div>
          <div class="sp-med-key">Medical Cover</div>
        </div>
      </div>
      <% if(student.medical_notes){ %>
      <div class="sp-sect-label">Medical Notes</div>
      <div style="background:#faf9ff;border:1px solid rgba(124,58,237,0.12);border-radius:12px;padding:1rem 1.25rem;font-size:.88rem;line-height:1.7;color:var(--sp-text);">
        <%= student.medical_notes %>
      </div>
      <% } else { %>
      <div class="sp-empty" style="padding:1.5rem 1rem;"><i class="fas fa-notes-medical"></i>No medical notes on record.</div>
      <% } %>
    </div>
  </div>
  <div class="sp-panel" id="sp-panel-security" role="tabpanel" aria-labelledby="spt-security">
    <div class="sp-card">
      <div class="sp-card-title"><i class="fas fa-key"></i> Change Password</div>
      <form action="/student/profile" method="POST">
        <div class="sp-form-grid">
          <div class="sp-field">
            <label>Current Password</label>
            <input type="password" name="currentPassword" required class="sp-input" placeholder="Current Password">
          </div>
          <div class="sp-field">
            <label>New Password</label>
            <input type="password" name="newPassword" required class="sp-input" placeholder="New Password">
          </div>
          <div class="sp-field">
            <label>Confirm New Password</label>
            <input type="password" name="confirmPassword" required class="sp-input" placeholder="Confirm New Password">
          </div>
        </div>
        <div class="sp-submit-row">
          <button type="submit" class="sp-save-btn"><i class="fas fa-save"></i> Update Password</button>
        </div>
      </form>
    </div>
  </div>
  <div class="sp-panel" id="sp-panel-timeline" role="tabpanel" aria-labelledby="spt-timeline">
    <div class="sp-card">
      <div class="sp-card-title"><i class="fas fa-history"></i> Activity Timeline</div>
      <div class="sp-timeline">
        <div class="sp-tl-item">
          <div class="sp-tl-dot"></div>
          <div class="sp-tl-time"><i class="fas fa-clock" style="margin-right:6px;"></i><%= fmt(student.created_at) %></div>
          <div class="sp-tl-text">🎉 Student profile created in SchoolSync</div>
          <div class="sp-tl-sub">Admission No: <%= student.admission_no %></div>
        </div>
        <% if(student.admission_date){ %>
        <div class="sp-tl-item">
          <div class="sp-tl-dot tl-teal"></div>
          <div class="sp-tl-time"><i class="fas fa-calendar" style="margin-right:6px;"></i><%= fmt(student.admission_date) %></div>
          <div class="sp-tl-text">🏫 Officially admitted to school</div>
          <div class="sp-tl-sub">Class: <%= student.class_name %> <%= student.section %></div>
        </div>
        <% } %>
        <% if(att.total > 0){ %>
        <div class="sp-tl-item">
          <div class="sp-tl-dot tl-amber"></div>
          <div class="sp-tl-time"><i class="fas fa-chart-bar" style="margin-right:6px;"></i>This Year</div>
          <div class="sp-tl-text">📊 Attendance tracked — <%= att.pct %>% present</div>
          <div class="sp-tl-sub"><%= att.present %> present · <%= att.absent %> absent · <%= att.late %> late out of <%= att.total %> days</div>
        </div>
        <% } %>
        <% if(family && family.id){ %>
        <div class="sp-tl-item">
          <div class="sp-tl-dot tl-teal"></div>
          <div class="sp-tl-time"><i class="fas fa-users" style="margin-right:6px;"></i>On Admission</div>
          <div class="sp-tl-text">👨‍👩‍👦 Family details recorded</div>
          <div class="sp-tl-sub">Father: <%= family.father_name || '—' %> · Mother: <%= family.mother_name || '—' %></div>
        </div>
        <% } %>
        <% if(documents && documents.length > 0){ %>
        <div class="sp-tl-item">
          <div class="sp-tl-dot tl-emerald"></div>
          <div class="sp-tl-time"><i class="fas fa-folder" style="margin-right:6px;"></i>Documents</div>
          <div class="sp-tl-text">📄 <%= documents.length %> document(s) uploaded to profile</div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<script>
    function spTab(name){
        document.querySelectorAll('.sp-tab-btn').forEach(b=>{
            b.classList.remove('sp-active');
            b.setAttribute('aria-selected', 'false');
        });

        document.querySelectorAll('.sp-panel').forEach(p=>p.classList.remove('sp-show'));
        var btn = document.getElementById('spt-'+name);
        var panel = document.getElementById('sp-panel-'+name);
        if(btn) {
            btn.classList.add('sp-active');
            btn.setAttribute('aria-selected', 'true');
        }
        if(panel) panel.classList.add('sp-show');
    }

    document.addEventListener('DOMContentLoaded',function(){
        setTimeout(function(){
            var fill = document.getElementById('spCompFill');
            if(fill) fill.style.width = '<%= completion %>%';
        }, 300);

        // Animate attendance bar
        setTimeout(function(){
            var af = document.getElementById('spAttFill');
            if(af) af.style.width = '<%= att.pct %>%';
        }, 500);
    });
</script>