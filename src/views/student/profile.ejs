<%
    const fmt = (d, opts) => d ? new Date(d).toLocaleDateString('en-IN', opts || {day:'2-digit',month:'short',year:'numeric'}) : '—';
    const esc = v => (v || '—');
    const fallbackAvatar = `https://ui-avatars.com/api/?name=${encodeURIComponent(student.name || 'Student')}&background=6d28d9&color=fff&size=160`;
    const avatar = (student.avatar && student.avatar !== 'null' && student.avatar !== '/images/default-avatar.png') ? student.avatar : fallbackAvatar;

    let filled = 0, total = 10;
    if(student.name)        filled++;
    if(student.email)       filled++;
    if(student.phone)       filled++;
    if(student.dob)         filled++;
    if(student.gender)      filled++;
    if(student.blood_group) filled++;
    if(family && family.father_name) filled++;
    if(family && family.mother_name) filled++;
    if(address && address.permanent_address) filled++;
    if(documents && documents.length > 0) filled++;
    const completion = Math.round((filled/total)*100);

    const acadYear = typeof academicYear !== 'undefined' ? academicYear : '—';

    const att = typeof attendanceStats !== 'undefined' ? attendanceStats : {total:0,present:0,absent:0,late:0,pct:0};
%>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap');

    :root{
        --sp-purple:   #7c3aed;
        --sp-violet:   #8b5cf6;
        --sp-indigo:   #6366f1;
        --sp-teal:     #0d9488;
        --sp-amber:    #d97706;
        --sp-rose:     #e11d48;
        --sp-emerald:  #059669;
        --sp-sky:      #0284c7;
        --sp-text:     #0f172a;
        --sp-muted:    #64748b;
        --sp-border:   rgba(99,102,241,0.14);
        --sp-surface:  #ffffff;
        --sp-bg:       #f5f3ff;
        --sp-radius:   16px;
        --sp-shadow:   0 4px 24px rgba(124,58,237,0.10);
        --sp-shadow-lg:0 8px 40px rgba(124,58,237,0.15);
        --sp-tr:       all .28s cubic-bezier(.4,0,.2,1);
    }

    .sp-wrap{ font-family:'Inter',sans-serif; color:var(--sp-text); padding-bottom:3rem; }

    .sp-hero{
        background: linear-gradient(135deg,#7c3aed 0%,#6366f1 50%,#8b5cf6 100%);
        border-radius:20px; padding:2.25rem 2.5rem;
        position:relative; overflow:hidden; margin-bottom:1.5rem;
        box-shadow:0 12px 48px rgba(124,58,237,0.35);
    }
    .sp-hero-deco{
        position:absolute; pointer-events:none; border-radius:50%;
    }
    .sp-hero-deco-1{top:-80px;right:-80px;width:240px;height:240px;background:rgba(255,255,255,0.06);}
    .sp-hero-deco-2{bottom:-120px;right:60px;width:220px;height:220px;background:rgba(255,255,255,0.04);}
    .sp-hero-deco-3{top:20px;left:180px;width:100px;height:100px;background:rgba(255,255,255,0.03);}

    .sp-avatar-ring{
        position:relative; width:96px; height:96px; flex-shrink:0;
        border-radius: 50%;
        background: #5b21b6;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .sp-avatar-ring img{
        width:96px;height:96px;border-radius:50%;object-fit:cover;aspect-ratio:1;
        border:3px solid rgba(255,255,255,0.85);
        box-shadow:0 0 0 3px rgba(255,255,255,0.2),0 6px 18px rgba(0,0,0,0.2);
        display: block;
    }
    .sp-avatar-online{
        position:absolute;bottom:3px;right:3px;
        width:18px;height:18px;border-radius:50%;
        background:#4ade80;border:2.5px solid white;
        box-shadow:0 0 8px rgba(74,222,128,0.6);
        z-index: 2;
    }
    .sp-avatar-online.inactive{background:#f87171;box-shadow:0 0 8px rgba(248,113,113,0.5);}

    .sp-hero-name{font-size:1.85rem;font-weight:800;color:#fff;letter-spacing:-.02em;margin:0 0 .35rem;}
    .sp-adm-badge{
        display:inline-flex;align-items:center;gap:6px;
        background:rgba(255,255,255,0.18);border:1px solid rgba(255,255,255,0.3);
        color:#fff;border-radius:100px;padding:4px 14px;font-size:.78rem;font-weight:600;
        backdrop-filter:blur(8px);
    }
    .sp-hero-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:.55rem;}
    .sp-hero-chip{
        display:inline-flex;align-items:center;gap:5px;
        background:rgba(255,255,255,0.13);border:1px solid rgba(255,255,255,0.2);
        color:rgba(255,255,255,0.92);border-radius:100px;padding:3px 12px;font-size:.75rem;font-weight:500;
    }
    .sp-status-pill{
        display:inline-flex;align-items:center;gap:6px;
        background:rgba(74,222,128,0.2);border:1px solid rgba(74,222,128,0.35);
        color:#dcfce7;border-radius:100px;padding:4px 14px;font-size:.78rem;font-weight:700;
    }
    .sp-status-pill .dot{width:7px;height:7px;border-radius:50%;background:#4ade80;}

    .sp-hero-info-row{display:grid;grid-template-columns:1fr 1fr;gap:.7rem 1.4rem;}
    .sp-hero-info-item{display:flex;align-items:flex-start;gap:10px;}
    .sp-hero-info-icon{
        width:34px;height:34px;border-radius:10px;flex-shrink:0;
        background:rgba(255,255,255,0.14);backdrop-filter:blur(6px);
        display:flex;align-items:center;justify-content:center;color:#fff;font-size:.82rem;
    }
    .sp-hi-label{font-size:.68rem;color:rgba(255,255,255,.65);font-weight:500;text-transform:uppercase;letter-spacing:.05em;}
    .sp-hi-value{font-size:.88rem;font-weight:700;color:#fff;}

    .sp-hero-btn{
        display:inline-flex;align-items:center;gap:8px;
        padding:9px 20px;border-radius:100px;font-size:.82rem;font-weight:700;
        border:none;cursor:pointer;text-decoration:none;transition:var(--sp-tr);
        white-space:nowrap;
    }
    .sp-btn-white{background:#fff;color:var(--sp-purple);box-shadow:0 4px 14px rgba(0,0,0,0.18);}
    .sp-btn-white:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,0.24);color:var(--sp-purple);}
    .sp-btn-glass{
        background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);color:#fff;
        backdrop-filter:blur(8px);
    }
    .sp-btn-glass:hover{background:rgba(255,255,255,0.25);color:#fff;}

    .sp-completion-bar-wrap{
        background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);
        border-radius:12px;padding:1rem 1.25rem;margin-top:1.25rem;
        backdrop-filter:blur(8px);
    }
    .sp-comp-track{height:8px;border-radius:100px;background:rgba(255,255,255,0.2);overflow:hidden;}
    .sp-comp-fill{height:100%;border-radius:100px;background:linear-gradient(90deg,#4ade80,#22d3ee);transition:width 1s ease;}

    .sp-stats-row{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;margin-bottom:1.5rem;}
    .sp-stat{
        background:#fff;border:1px solid var(--sp-border);border-radius:var(--sp-radius);
        padding:1.25rem 1.3rem;display:flex;align-items:center;gap:.9rem;
        box-shadow:var(--sp-shadow);transition:var(--sp-tr);
    }
    .sp-stat:hover{transform:translateY(-3px);box-shadow:var(--sp-shadow-lg);border-color:rgba(124,58,237,0.25);}
    .sp-stat-icon{
        width:46px;height:46px;border-radius:13px;flex-shrink:0;
        display:flex;align-items:center;justify-content:center;font-size:1.1rem;
    }
    .ssi-1{background:rgba(99,102,241,0.10);color:#4f46e5;}
    .ssi-2{background:rgba(13,148,136,0.10);color:#0d9488;}
    .ssi-3{background:rgba(217,119,6,0.10);color:#d97706;}
    .ssi-4{background:rgba(139,92,246,0.10);color:#7c3aed;}
    .ssi-5{background:rgba(5,150,105,0.10);color:#059669;}
    .sp-stat-num{font-size:1.3rem;font-weight:800;line-height:1;}
    .sp-stat-lbl{font-size:.72rem;color:var(--sp-muted);font-weight:500;margin-top:3px;}

    .sp-tab-bar{
        background:#fff;border:1px solid var(--sp-border);border-radius:var(--sp-radius);
        padding:6px;margin-bottom:1.5rem;display:flex;gap:4px;
        box-shadow:var(--sp-shadow);overflow-x:auto;-webkit-overflow-scrolling:touch;
    }
    .sp-tab-btn{
        display:flex;align-items:center;gap:7px;padding:9px 18px;border-radius:10px;
        font-size:.82rem;font-weight:600;color:var(--sp-muted);border:none;
        background:transparent;cursor:pointer;transition:var(--sp-tr);white-space:nowrap;
    }
    .sp-tab-btn:hover{color:var(--sp-text);background:rgba(124,58,237,0.06);}
    .sp-tab-btn.sp-active{
        background:linear-gradient(135deg,var(--sp-purple),var(--sp-indigo));
        color:#fff;box-shadow:0 4px 12px rgba(124,58,237,0.35);
    }
    .sp-tab-btn i{font-size:.82rem;}

    .sp-panel{display:none;animation:spFadeIn .3s ease;}
    .sp-panel.sp-show{display:block;}
    @keyframes spFadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}

    .sp-card{
        background:#fff;border:1px solid var(--sp-border);border-radius:var(--sp-radius);
        padding:1.6rem;box-shadow:var(--sp-shadow);margin-bottom:1.25rem;
    }
    .sp-card-title{
        font-size:.95rem;font-weight:700;margin-bottom:1.4rem;padding-bottom:.85rem;
        border-bottom:1px solid rgba(99,102,241,0.12);
        display:flex;align-items:center;gap:9px;
    }
    .sp-card-title i{color:var(--sp-purple);}

    .sp-info-row{
        display:flex;justify-content:space-between;align-items:center;
        padding:.6rem 0;border-bottom:1px solid rgba(99,102,241,0.07);
        font-size:.86rem;
    }
    .sp-info-row:last-child{border-bottom:none;}
    .sp-info-label{color:var(--sp-muted);font-weight:500;font-size:.8rem;}
    .sp-info-value{font-weight:700;color:var(--sp-text);text-align:right;max-width:55%;}

    .sp-family-head{
        display:flex;align-items:center;gap:8px;
        font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;
        color:var(--sp-purple);margin-bottom:.85rem;margin-top:1.1rem;
        padding-bottom:.5rem;border-bottom:1px solid rgba(124,58,237,0.12);
    }
    .sp-family-head:first-of-type{margin-top:0;}

    .sp-sect-label{
        font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
        color:var(--sp-purple);margin-bottom:.75rem;display:flex;align-items:center;gap:7px;
    }
    .sp-sect-label::after{content:'';flex:1;height:1px;background:var(--sp-border);}

    .sp-addr-block{
        background:#f8f5ff;border:1px solid rgba(124,58,237,0.12);border-radius:12px;
        padding:.9rem 1.1rem;margin-bottom:.85rem;font-size:.86rem;
    }
    .sp-addr-block strong{display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--sp-purple);margin-bottom:.3rem;}

    .sp-chip{
        display:inline-flex;align-items:center;gap:5px;border-radius:100px;
        padding:3px 12px;font-size:.72rem;font-weight:700;
    }
    .sp-chip-yes{background:rgba(5,150,105,0.10);color:#059669;border:1px solid rgba(5,150,105,0.2);}
    .sp-chip-no{background:rgba(100,116,139,0.08);color:#64748b;border:1px solid rgba(100,116,139,0.15);}
    .sp-chip-status{background:rgba(99,102,241,0.10);color:#4f46e5;border:1px solid rgba(99,102,241,0.2);}

    .sp-doc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;}
    .sp-doc-card{
        background:#faf9ff;border:1px solid rgba(124,58,237,0.12);border-radius:14px;
        padding:1.25rem;transition:var(--sp-tr);display:flex;flex-direction:column;align-items:center;text-align:center;gap:.6rem;
    }
    .sp-doc-card:hover{border-color:rgba(124,58,237,0.3);background:#f5f3ff;transform:translateY(-2px);box-shadow:var(--sp-shadow);}
    .sp-doc-icon-wrap{
        width:54px;height:54px;border-radius:14px;
        background:rgba(124,58,237,0.10);color:var(--sp-purple);
        display:flex;align-items:center;justify-content:center;font-size:1.5rem;
    }
    .sp-doc-name{font-size:.82rem;font-weight:700;color:var(--sp-text);}
    .sp-doc-date{font-size:.7rem;color:var(--sp-muted);}
    .sp-doc-btns{display:flex;gap:6px;}
    .sp-doc-btn{
        display:inline-flex;align-items:center;gap:5px;
        padding:5px 12px;border-radius:100px;font-size:.72rem;font-weight:700;
        text-decoration:none;transition:var(--sp-tr);border:none;cursor:pointer;
    }
    .sp-doc-btn-view{background:rgba(99,102,241,0.10);color:#4f46e5;border:1px solid rgba(99,102,241,0.2);}
    .sp-doc-btn-view:hover{background:rgba(99,102,241,0.18);color:#4f46e5;}

    .sp-medical-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;}
    .sp-med-card{
        background:#faf9ff;border:1px solid rgba(124,58,237,0.12);border-radius:14px;
        padding:1.25rem;text-align:center;
    }
    .sp-med-icon{font-size:1.8rem;margin-bottom:.5rem;display:block;}
    .sp-med-val{font-size:1.15rem;font-weight:800;color:var(--sp-text);}
    .sp-med-key{font-size:.72rem;color:var(--sp-muted);font-weight:500;margin-top:3px;}

    .sp-att-row{display:grid;grid-template-columns:repeat(4,1fr);gap:.85rem;margin-bottom:1.25rem;}
    .sp-att-box{
        background:#fff;border:1px solid var(--sp-border);border-radius:12px;
        padding:.9rem 1rem;text-align:center;box-shadow:var(--sp-shadow);
    }
    .sp-att-num{font-size:1.5rem;font-weight:800;}
    .sp-att-lbl{font-size:.7rem;color:var(--sp-muted);font-weight:500;margin-top:2px;}
    .sp-att-progress{height:10px;border-radius:100px;background:#ede9fe;overflow:hidden;margin-top:.5rem;}
    .sp-att-fill{height:100%;border-radius:100px;background:linear-gradient(90deg,var(--sp-purple),var(--sp-indigo));transition:width 1.2s ease;}

    .sp-timeline{position:relative;padding-left:2rem;}
    .sp-timeline::before{
        content:'';position:absolute;left:10px;top:8px;bottom:8px;
        width:2px;background:linear-gradient(to bottom,var(--sp-purple),rgba(124,58,237,.1));
    }
    .sp-tl-item{position:relative;margin-bottom:1.4rem;}
    .sp-tl-dot{
        position:absolute;left:-26px;top:6px;
        width:14px;height:14px;border-radius:50%;
        background:var(--sp-purple);border:2px solid #fff;
        box-shadow:0 0 0 3px rgba(124,58,237,0.2);
    }
    .sp-tl-dot.tl-teal{background:var(--sp-teal);box-shadow:0 0 0 3px rgba(13,148,136,0.2);}
    .sp-tl-dot.tl-amber{background:var(--sp-amber);box-shadow:0 0 0 3px rgba(217,119,6,0.2);}
    .sp-tl-dot.tl-emerald{background:var(--sp-emerald);box-shadow:0 0 0 3px rgba(5,150,105,0.2);}
    .sp-tl-time{font-size:.7rem;color:var(--sp-muted);margin-bottom:3px;}
    .sp-tl-text{font-size:.88rem;font-weight:600;color:var(--sp-text);}
    .sp-tl-sub{font-size:.78rem;color:var(--sp-muted);margin-top:2px;}

    .sp-qa-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.85rem;}
    .sp-qa-btn{
        display:flex;flex-direction:column;align-items:center;gap:.5rem;
        background:#fff;border:1px solid var(--sp-border);border-radius:14px;
        padding:1.1rem .75rem;font-size:.75rem;font-weight:700;color:var(--sp-text);
        text-decoration:none;transition:var(--sp-tr);cursor:pointer;text-align:center;
    }
    .sp-qa-btn:hover{border-color:rgba(124,58,237,0.3);background:#faf9ff;transform:translateY(-2px);box-shadow:var(--sp-shadow);color:var(--sp-purple);}
    .sp-qa-icon{
        width:42px;height:42px;border-radius:12px;
        background:rgba(124,58,237,0.10);color:var(--sp-purple);
        display:flex;align-items:center;justify-content:center;font-size:1.05rem;
    }

    .sp-overview-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;}

    .sp-empty{text-align:center;padding:2.5rem 1rem;color:var(--sp-muted);}
    .sp-empty i{font-size:2.5rem;display:block;margin-bottom:.75rem;opacity:.3;}

    .sp-divider{border:none;border-top:1px solid rgba(124,58,237,0.1);margin:1.25rem 0;}

    @media(max-width:1100px){
        .sp-stats-row{grid-template-columns:repeat(3,1fr);}
        .sp-overview-grid{grid-template-columns:1fr;}
        .sp-medical-grid{grid-template-columns:1fr 1fr;}
        .sp-qa-grid{grid-template-columns:repeat(2,1fr);}
    }
    @media(max-width:768px){
        .sp-hero{padding:1.5rem 1.25rem;}
        .sp-hero-name{font-size:1.35rem;}
        .sp-stats-row{grid-template-columns:repeat(2,1fr); gap: 10px;}
        .sp-att-row{grid-template-columns:repeat(2,1fr); gap: 8px;}
        .sp-hero-info-row{grid-template-columns:1fr;}
        .sp-medical-grid{grid-template-columns:1fr;}
        .sp-doc-grid{grid-template-columns:repeat(2,1fr);}
        .sp-form-grid { grid-template-columns: 1fr; }
    }
    @media(max-width:640px){
        .sp-hero {
            padding: 18px 16px !important;
            border-radius: 16px !important;
            margin-bottom: 14px !important;
        }
        .sp-avatar-ring {
            width: 76px !important;
            height: 76px !important;
        }
        .sp-avatar-ring img {
            width: 76px !important;
            height: 76px !important;
        }
        .sp-avatar-online {
            width: 16px !important;
            height: 16px !important;
            bottom: 2px !important;
            right: 2px !important;
        }
        .sp-hero-name {
            font-size: 1.25rem !important;
        }
        .sp-stats-row {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
            margin-bottom: 14px !important;
        }
        .sp-stat {
            padding: 12px 14px !important;
            gap: 10px !important;
            border-radius: 12px !important;
        }
        .sp-stat-icon {
            width: 38px !important;
            height: 38px !important;
            font-size: 1rem !important;
            border-radius: 10px !important;
        }
        .sp-stat-num {
            font-size: 1.1rem !important;
        }
        .sp-card {
            padding: 14px 16px !important;
            border-radius: 14px !important;
        }
        .sp-info-row {
            font-size: 13px !important;
            padding: 8px 0 !important;
        }
        .sp-tab-btn {
            padding: 7px 13px !important;
            font-size: 12px !important;
        }
        .sp-qa-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 8px !important;
        }
    }

    /* Dark Mode Theme Tokens */
    [data-theme="dark"],
    .light-mode-disabled {
        --sp-text: #F1F5F9;
        --sp-muted: #94A3B8;
        --sp-border: #242F4D;
        --sp-surface: #151D30;
        --sp-bg: #101726;
    }
    [data-theme="dark"] .sp-stat,
    .light-mode-disabled .sp-stat,
    [data-theme="dark"] .sp-tab-bar,
    .light-mode-disabled .sp-tab-bar,
    [data-theme="dark"] .sp-card,
    .light-mode-disabled .sp-card,
    [data-theme="dark"] .sp-att-box,
    .light-mode-disabled .sp-att-box,
    [data-theme="dark"] .sp-qa-btn,
    .light-mode-disabled .sp-qa-btn,
    [data-theme="dark"] .sp-med-card,
    .light-mode-disabled .sp-med-card,
    [data-theme="dark"] .sp-doc-card,
    .light-mode-disabled .sp-doc-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .sp-stat-num,
    .light-mode-disabled .sp-stat-num,
    [data-theme="dark"] .sp-info-value,
    .light-mode-disabled .sp-info-value,
    [data-theme="dark"] .sp-med-val,
    .light-mode-disabled .sp-med-val,
    [data-theme="dark"] .sp-doc-name,
    .light-mode-disabled .sp-doc-name,
    [data-theme="dark"] .sp-card-title,
    .light-mode-disabled .sp-card-title,
    [data-theme="dark"] .sp-tl-text,
    .light-mode-disabled .sp-tl-text {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .sp-addr-block,
    .light-mode-disabled .sp-addr-block {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .sp-input,
    .light-mode-disabled .sp-input {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .sp-input:focus,
    .light-mode-disabled .sp-input:focus {
        background: #101726 !important;
        border-color: #7C3AED !important;
    }
    [data-theme="dark"] .sp-tab-btn,
    .light-mode-disabled .sp-tab-btn {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .sp-tab-btn.sp-active,
    .light-mode-disabled .sp-tab-btn.sp-active {
        background: linear-gradient(135deg, var(--sp-purple), var(--sp-indigo)) !important;
        color: #FFFFFF !important;
    }
