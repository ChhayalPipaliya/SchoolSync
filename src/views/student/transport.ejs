<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

<% const info = transportInfo || {}; const trip = info.trips || {}; const loc = info.latestLocation || null; %>
<% const badgeClass = (status) => status === 'picked' || status === 'dropped' || status === 'running' ? 'tp-good' : status === 'missed' || status === 'absent' ? 'tp-warn' : 'tp-muted'; %>

<div class="transport-pro" style="padding: 0 4px;">
  <!-- Bus Approaching Banner (shown via socket event) -->
  <div id="busApproachingBanner" style="display:none; align-items:center; gap:12px; background:#f59e0b; color:#1a1a1a; border-radius:12px; padding:14px 18px; margin-bottom:18px; border:1.5px solid #fbbf24; box-shadow:0 2px 8px rgba(245,158,11,0.25);">
    <span style="font-size:1.5rem;">🚌</span>
    <div style="flex:1;">
      <p style="font-weight:800; font-size:15px; margin:0;">Your bus is approaching!</p>
      <p style="font-size:13px; margin:2px 0 0; opacity:0.85;">Stop: <strong id="busApproachingStop">—</strong> &nbsp;|&nbsp; <span id="busApproachingEta"></span></p>
    </div>
    <button onclick="document.getElementById('busApproachingBanner').style.display='none'" style="background:none; border:none; cursor:pointer; font-size:1.2rem; color:#1a1a1a; opacity:0.6;">✕</button>
  </div>

  <!-- Hero Banner -->
  <div style="background:linear-gradient(135deg, #7c3aed, #5b21b6); border-radius:12px; padding:24px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(124,58,237,0.15);">
      <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
      <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
          <div>
              <h1 style="font-size:24px; font-weight:700; margin:0;">My Transport</h1>
              <p style="font-size:13px; opacity:0.9; margin:4px 0 0;">Route, bus, stop, and live tracking details</p>
          </div>
          <button class="btn" onclick="window.location.reload()" style="background:#fff; color:#7c3aed; font-weight:700; padding:8px 16px; font-size:13px; border-radius:8px; border:none; cursor:pointer; display:inline-flex; align-items:center; gap:6px;">
              <i class="fas fa-rotate-right"></i> Refresh
          </button>
      </div>
  </div>

  <% if (info.message) { %>
    <div class="tp-alert"><i class="fas fa-circle-info"></i> <%= info.message %></div>
  <% } %>

  <div class="tp-grid">
    <section class="tp-card tp-main">
      <div class="tp-card-head">
        <div>
          <span class="tp-kicker">Assigned Route</span>
          <h3><%= info.route?.name || 'No route assigned' %></h3>
        </div>
        <span class="tp-badge <%= badgeClass(trip.liveStatus) %>"><%= trip.liveStatus === 'running' ? 'Live Trip' : 'Not Live' %></span>
      </div>

      <div class="tp-stats">
        <div><span>Pickup Status</span><strong class="<%= badgeClass(trip.pickupStatus) %>"><%= trip.pickupStatus || 'pending' %></strong></div>
        <div><span>Drop Status</span><strong class="<%= badgeClass(trip.dropStatus) %>"><%= trip.dropStatus || 'pending' %></strong></div>
        <div><span>Vehicle</span><strong><%= info.vehicle?.number || '—' %></strong></div>
        <div><span>Driver</span><strong><%= info.driver?.name || '—' %></strong></div>
      </div>

      <div class="tp-stop-grid">
        <div>
          <span>Pickup Stop</span>
          <strong><%= info.stops?.pickupName || 'Stop not assigned' %></strong>
          <small><%= info.stops?.pickupTime || 'Time not set' %></small>
        </div>
        <div>
          <span>Drop Stop</span>
          <strong><%= info.stops?.dropName || 'Stop not assigned' %></strong>
          <small><%= info.stops?.dropTime || 'Time not set' %></small>
        </div>
      </div>
    </section>

    <section class="tp-card">
      <div class="tp-card-head compact">
        <h3>Driver & Contact</h3>
      </div>
      <div class="tp-list">
        <div><i class="fas fa-phone"></i><span>Driver Phone</span><strong><%= info.driver?.phone || '—' %></strong></div>
        <div><i class="fas fa-bus"></i><span>Bus Model</span><strong><%= info.vehicle?.model || 'Standard' %></strong></div>
        <div><i class="fas fa-shield-heart"></i><span>Emergency Contact</span><strong><%= info.contact?.phone || 'School office' %></strong></div>
      </div>
    </section>
  </div>

  <div class="tp-grid map-grid">
    <section class="tp-card">
      <div class="tp-card-head">
        <div>
          <span class="tp-kicker">Bus Location</span>
          <h3 id="locationTitle"><%= activeTrip ? 'Connecting to live location' : loc ? 'Last known location' : 'Location unavailable' %></h3>
          <p id="locationSub"><%= activeTrip ? 'Waiting for GPS updates...' : loc ? 'Bus location is not live right now. Showing last known location.' : 'No GPS location has been stored yet.' %></p>
        </div>
        <% if (loc) { %>
          <a id="mapsLink" class="tp-btn" target="_blank" href="https://www.google.com/maps?q=<%= loc.latitude %>,<%= loc.longitude %>"><i class="fas fa-map"></i> Maps</a>
        <% } else { %>
          <a id="mapsLink" class="tp-btn disabled" href="#"><i class="fas fa-map"></i> Maps</a>
        <% } %>
      </div>
      <div id="map" data-active-trip="<%= activeTrip ? activeTrip.trip_id : '' %>" data-token="<%= typeof token !== 'undefined' ? token : '' %>" data-lat="<%= loc ? loc.latitude : '' %>" data-lng="<%= loc ? loc.longitude : '' %>"></div>
      <div class="tp-location-meta">
        <span>Latitude: <strong id="latText"><%= loc ? Number(loc.latitude).toFixed(6) : '—' %></strong></span>
        <span>Longitude: <strong id="lngText"><%= loc ? Number(loc.longitude).toFixed(6) : '—' %></strong></span>
        <span>Updated: <strong id="updatedText"><%= loc?.recordedAt ? new Date(loc.recordedAt).toLocaleString('en-IN') : '—' %></strong></span>
      </div>
    </section>

    <section class="tp-card">
      <div class="tp-card-head compact"><h3>Recent Activity</h3></div>
      <div class="tp-timeline">
        <% if (!info.recentActivity || info.recentActivity.length === 0) { %>
          <div class="tp-empty">No pickup/drop activity yet.</div>
        <% } %>
        <% (info.recentActivity || []).forEach(item => { %>
          <div class="tp-event">
            <span class="tp-dot"></span>
            <div>
              <strong><%= item.status %> • <%= item.trip_type %></strong>
              <small><%= item.updatedAt ? new Date(item.updatedAt).toLocaleString('en-IN') : '' %></small>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<% if (activeTrip) { %><script src="/socket.io/socket.io.js"></script><% } %>
<script>
(function() {
  const mapEl = document.getElementById('map');
  const fallbackLat = Number(mapEl.dataset.lat);
  const fallbackLng = Number(mapEl.dataset.lng);
  const hasFallback = Number.isFinite(fallbackLat) && Number.isFinite(fallbackLng);
  const map = L.map('map').setView(hasFallback ? [fallbackLat, fallbackLng] : [23.0225, 72.5714], hasFallback ? 15 : 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
  let marker = null;

  function setLocation(data, live) {
    const lat = Number(data.latitude);
    const lng = Number(data.longitude);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
    const latlng = [lat, lng];
    if (!marker) marker = L.marker(latlng).addTo(map);
    marker.setLatLng(latlng);
    map.setView(latlng, 16);
    document.getElementById('latText').textContent = lat.toFixed(6);
    document.getElementById('lngText').textContent = lng.toFixed(6);
    document.getElementById('updatedText').textContent = new Date(data.timestamp || data.recordedAt || Date.now()).toLocaleString('en-IN');
    document.getElementById('locationTitle').textContent = live ? 'Live bus location' : 'Last known location';
    document.getElementById('locationSub').textContent = live ? 'Receiving live GPS updates.' : 'Bus location is not live right now. Showing last known location.';
    const link = document.getElementById('mapsLink');
    link.href = `https://www.google.com/maps?q=${lat},${lng}`;
    link.classList.remove('disabled');
  }

  if (hasFallback) setLocation({ latitude: fallbackLat, longitude: fallbackLng, recordedAt: '<%= loc?.recordedAt || '' %>' }, false);

  const tripId = mapEl.dataset.activeTrip;
  if (tripId) {
    const socket = io({ auth: { token: mapEl.dataset.token || '' }, query: { token: mapEl.dataset.token || '' } });
    socket.on('connect', () => socket.emit('join_trip', { trip_id: Number(tripId) }));
    socket.on('location_updated', data => setLocation(data, true));

    // Proximity banner — show when bus is within ~300m of student's stop
    socket.on('bus_approaching', (data) => {
      const banner = document.getElementById('busApproachingBanner');
      if (!banner) return;
      const stopEl = document.getElementById('busApproachingStop');
      const etaEl = document.getElementById('busApproachingEta');
      if (stopEl) stopEl.textContent = data.stopName || 'your stop';
      if (etaEl) etaEl.textContent = data.etaMin > 0 ? `~${data.etaMin} min away` : 'Arriving now!';
      banner.style.display = 'flex';
      // Auto-dismiss after 5 minutes
      setTimeout(() => { banner.style.display = 'none'; }, 5 * 60 * 1000);
    });
  }
})();
</script>

<style>
.transport-pro{font-family:Inter,system-ui,sans-serif;color:#0f172a}.tp-header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px}.tp-header h2{font-weight:800;margin:0}.tp-header p,.tp-card p{color:#64748b;margin:4px 0 0}.tp-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:16px;margin-bottom:16px}.map-grid{grid-template-columns:1fr .7fr}.tp-card{background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 8px 24px rgba(15,23,42,.06);padding:18px}.tp-card-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:16px}.tp-card-head.compact{margin-bottom:10px}.tp-card h3{font-size:18px;font-weight:800;margin:0}.tp-kicker{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#64748b;font-weight:800}.tp-btn{border:1px solid #dbe3ef;background:#f8fafc;color:#334155;border-radius:8px;padding:9px 12px;font-weight:800;font-size:12px;text-decoration:none}.tp-btn.disabled{opacity:.45;pointer-events:none}.tp-badge,.tp-stats strong{display:inline-flex;border-radius:999px;padding:4px 9px;font-size:11px;font-weight:800;text-transform:uppercase}.tp-good{background:#ecfdf5;color:#047857}.tp-warn{background:#fff7ed;color:#c2410c}.tp-muted{background:#f1f5f9;color:#475569}.tp-stats,.tp-stop-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.tp-stop-grid{grid-template-columns:1fr 1fr;margin-top:12px}.tp-stats div,.tp-stop-grid div,.tp-list div{border:1px solid #edf2f7;border-radius:8px;padding:12px;background:#fbfdff}.tp-stats span,.tp-stop-grid span,.tp-list span{display:block;color:#64748b;font-size:12px;font-weight:700}.tp-stop-grid strong,.tp-list strong{display:block;font-size:14px;margin-top:3px}.tp-stop-grid small{color:#64748b}.tp-list{display:grid;gap:10px}.tp-list i{color:#10b981;margin-right:8px}#map{height:430px;border-radius:8px;background:#f1f5f9}.tp-location-meta{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;color:#64748b;font-size:12px}.tp-timeline{display:grid;gap:10px}.tp-event{display:flex;gap:10px;border:1px solid #edf2f7;border-radius:8px;padding:10px}.tp-event small{display:block;color:#64748b}.tp-dot{width:9px;height:9px;border-radius:50%;background:#10b981;margin-top:6px}.tp-empty,.tp-alert{border:1px solid #e2e8f0;background:#f8fafc;border-radius:8px;padding:12px;color:#64748b}.tp-alert{margin-bottom:16px;color:#92400e;background:#fffbeb;border-color:#fde68a}@media(max-width:900px){.tp-grid,.map-grid,.tp-stats,.tp-stop-grid{grid-template-columns:1fr}.tp-header{flex-direction:column}#map{height:340px}}
</style>
