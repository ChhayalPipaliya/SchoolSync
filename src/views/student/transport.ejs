<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<% 
    const info = (typeof transportInfo !== 'undefined' && transportInfo) ? transportInfo : {};
    const trip = info.trips || {};
    const loc = info.latestLocation || null;

    const formatTime = function(t) {
        if (!t) return 'Not Set';
        const str = String(t).trim();
        if (str.includes(':')) {
            const parts = str.split(':');
            let h = parseInt(parts[0], 10);
            if (isNaN(h)) return str;
            const m = parts[1] || '00';
            const ampm = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;
            return `${h}:${m} ${ampm}`;
        }
        return str;
    };

    const formatStatusLabel = function(s) {
        if (!s) return 'Not Started';
        const lower = String(s).toLowerCase().replace(/_/g, ' ');
        return lower.charAt(0).toUpperCase() + lower.slice(1);
    };

    const getStatusBadgeCls = function(status) {
        const s = String(status || '').toLowerCase();
        if (s === 'picked' || s === 'dropped' || s === 'completed' || s === 'running') return 'badge-good';
        if (s === 'missed' || s === 'absent' || s === 'delayed') return 'badge-warn';
        return 'badge-neutral';
    };
%>
