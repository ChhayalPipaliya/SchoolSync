            font-size: 20px !important;
        }
        .transport-header-subtitle {
            font-size: 12px !important;
        }
        .btn-refresh-gps {
            width: 100% !important;
            justify-content: center !important;
        }
        .card-panel {
            padding: 16px 18px !important;
            border-radius: 14px !important;
            margin-bottom: 14px !important;
        }
        .metrics-4-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 8px !important;
        }
        .metric-sub-card {
            padding: 10px 12px !important;
        }
        .stops-info-box {
            grid-template-columns: 1fr !important;
            gap: 8px !important;
            padding: 12px !important;
        }
        #map {
            height: 280px !important;
        }
        .map-meta-strip {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 6px !important;
        }
    }

    .stop-info-item span {
        display: block;
        font-size: 11px;
        color: #64748B;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .stop-info-item strong {
        display: block;
        font-size: 13.5px;
        color: var(--st-text-main);
        font-weight: 800;
    }

    .contact-items-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 12px 14px;
    }

    .contact-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .icon-emerald { background: #ECFDF5; color: #059669; }
    .icon-purple  { background: #F5F3FF; color: #7C3AED; }
    .icon-blue    { background: #EFF6FF; color: #2563EB; }

    #map {
        height: 420px;
        width: 100%;
        border-radius: 12px;
        border: 1px solid #E2E8F0;
        background: #F1F5F9;
        z-index: 1;
    }

    .map-meta-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 12px;
        margin-top: 12px;
        border-top: 1px dashed #E2E8F0;
        font-size: 12px;
        color: #64748B;
        font-weight: 600;
    }

    .activity-timeline {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 440px;
        overflow-y: auto;
    }

    .timeline-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 10px;
        padding: 12px 14px;
        transition: all 0.15s ease;
    }

    .timeline-item:hover {
        background: #FFFFFF;
        border-color: #DDD6FE;
    }

    .timeline-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-top: 5px;
        flex-shrink: 0;
    }

    .dot-green { background: #10B981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); }
    .dot-blue  { background: #3B82F6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2); }
    .dot-gray  { background: #94A3B8; }

    .btn-maps-link {
        background: #F8FAFC;
        color: #475569;
        border: 1px solid #CBD5E1;
        font-weight: 700;
        font-size: 12px;
        padding: 7px 14px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s ease;
    }

    .btn-maps-link:hover {
        background: #7C3AED;
        color: #FFFFFF;
        border-color: #7C3AED;
    }
</style>
<div class="card" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%); border-radius: 12px; padding: 14px 18px; color: #fff; margin-bottom: 14px; border: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;">
                <i class="fa-solid fa-bus-simple"></i>
            </div>
            <div>
                <h1 style="font-size: 18px; font-weight: 800; margin: 0; letter-spacing: -0.02em;"><%- lan.My_Transport_Bus_Tracking || 'My Transport & Bus Tracking' %></h1>
                <p style="font-size: 11px; opacity: 0.92; margin: 2px 0 0;"><%- lan.Transport_Header_Subtitle || 'Real-time GPS tracking, assigned route, driver contact & schedule' %></p>
            </div>
        </div>
        <div>
            <button type="button" class="btn" style="background: #fff; color: #7c3aed; border: none; font-weight: 700; padding: 6px 14px; font-size: 12px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(0,0,0,0.08); cursor: pointer;" onclick="refreshLocation()">
                <i class="fa-solid fa-arrows-rotate" id="refreshIcon"></i>
                <span><%- lan.Refresh_GPS || 'Refresh GPS' %></span>
            </button>
        </div>
    </div>
</div>
<div id="busApproachingBanner" class="bus-approaching-alert">
    <span style="font-size: 24px;">🚌</span>
    <div style="flex: 1;">
        <div style="font-weight: 800; font-size: 15px; color: #92400E;"><%- lan.Bus_Approaching_Stop_Alert || 'Your bus is approaching your stop!' %></div>
        <div style="font-size: 13px; color: #B45309; margin-top: 2px;">
            <%- lan.Stop || 'Stop' %>: <strong id="busApproachingStop">—</strong> &middot; <span id="busApproachingEta"></span>
        </div>
    </div>
    <button type="button" onclick="document.getElementById('busApproachingBanner').style.display='none'" style="background: none; border: none; font-size: 18px; cursor: pointer; color: #92400E;">✕</button>
</div>
<div id="connectionStatus" style="display: none; margin-bottom: 16px; padding: 10px 16px; border-radius: 10px; font-size: 12.5px; font-weight: 700;">
    <span id="connectionText"></span>
</div>
<div class="transport-top-grid">
    <div class="card-panel">
        <div class="panel-head">
            <div>
                <span class="panel-kicker"><%- lan.Assigned_Route || 'Assigned Route' %></span>
                <h2 class="panel-title"><%= info.route?.name || (lan.No_Route_Assigned || 'No Route Assigned') %></h2>
            </div>
            <div>
                <span class="badge-status-pill <%= trip.liveStatus === 'running' ? 'badge-live-pulse' : 'badge-neutral' %>" id="liveStatusBadge">
                    <i class="fa-solid <%= trip.liveStatus === 'running' ? 'fa-tower-broadcast' : 'fa-circle-pause' %>"></i>
                    <span><%= trip.liveStatus === 'running' ? (lan.LIVE_TRIP || 'LIVE TRIP') : (lan.NOT_LIVE || 'NOT LIVE') %></span>
                </span>
            </div>
        </div>
        <div class="metrics-4-grid">
            <div class="metric-sub-card">
                <span class="metric-sub-label"><%- lan.Pickup_Status || 'Pickup Status' %></span>
                <span class="badge-status-pill <%= getStatusBadgeCls(trip.pickupStatus) %>" id="pickupStatus" style="margin-top: 2px;">
                    <%= formatStatusLabel(trip.pickupStatus) %>
                </span>
            </div>
            <div class="metric-sub-card">
                <span class="metric-sub-label"><%- lan.Drop_Status || 'Drop Status' %></span>
                <span class="badge-status-pill <%= getStatusBadgeCls(trip.dropStatus) %>" id="dropStatus" style="margin-top: 2px;">
                    <%= formatStatusLabel(trip.dropStatus) %>
                </span>
            </div>
            <div class="metric-sub-card">
                <span class="metric-sub-label"><%- lan.Vehicle || 'Vehicle' %></span>
                <strong class="metric-sub-value" id="vehicleNumber">
                    <i class="fa-solid fa-bus" style="color: #7C3AED; font-size: 11px; margin-right: 4px;"></i>
                    <%= info.vehicle?.number || '—' %>
                </strong>
            </div>
            <div class="metric-sub-card">
                <span class="metric-sub-label"><%- lan.Driver || 'Driver' %></span>
                <strong class="metric-sub-value" id="driverName">
                    <%= info.driver?.name || '—' %>
                </strong>
            </div>
        </div>
        <div class="stops-info-box">
            <div class="stop-info-item">
                <span><%- lan.Assigned_Stop || 'Assigned Stop' %></span>
                <strong style="color: #059669;">
                    <i class="fa-solid fa-location-dot"></i> <%= info.stops?.stopName || info.stops?.pickupName || (lan.Stop_Not_Assigned || 'Stop Not Assigned') %>
                </strong>
            </div>
            <div class="stop-info-item">
                <span><%- lan.Morning_Pickup || 'Morning Pickup' %></span>
                <strong>
                    <i class="fa-regular fa-clock" style="color: #D97706;"></i> <%= formatTime(info.stops?.pickupTime) %>
                </strong>
            </div>
            <div class="stop-info-item">
                <span><%- lan.Afternoon_Drop || 'Afternoon Drop' %></span>
                <strong>
                    <i class="fa-regular fa-clock" style="color: #2563EB;"></i> <%= formatTime(info.stops?.dropTime) %>
                </strong>
            </div>
        </div>
    </div>
    <div class="card-panel">
        <div class="panel-head">
            <div>
                <span class="panel-kicker"><%- lan.Support_And_Details || 'Support & Details' %></span>
                <h3 class="panel-title"><%- lan.Driver_And_Contact || 'Driver & Contact' %></h3>
            </div>
        </div>
        <div class="contact-items-list">
            <div class="contact-item">
                <div class="contact-icon icon-emerald">
                    <i class="fa-solid fa-phone"></i>
                </div>
                <div>
                    <div style="font-size: 11px; color: #64748B; font-weight: 700; text-transform: uppercase;"><%- lan.Driver_Phone || 'Driver Phone' %></div>
                    <div style="font-size: 13.5px; font-weight: 800; color: #1E293B; margin-top: 1px;">
                        <% if (info.driver?.phone) { %>
                            <a href="tel:<%= info.driver.phone %>" style="color: #059669; text-decoration: none;">
                                <%= info.driver.phone %>
                            </a>
                        <% } else { %>
                            <span><%- lan.Not_Available || 'Not Available' %></span>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="contact-item">
                <div class="contact-icon icon-purple">
                    <i class="fa-solid fa-van-shuttle"></i>
                </div>
                <div>
                    <div style="font-size: 11px; color: #64748B; font-weight: 700; text-transform: uppercase;"><%- lan.Bus_Model || 'Bus Model' %></div>
                    <div style="font-size: 13.5px; font-weight: 800; color: #1E293B; margin-top: 1px;">
                        <%= info.vehicle?.model || (lan.Standard_School_Bus || 'Standard School Bus') %>
                    </div>
                </div>
            </div>
            <div class="contact-item">
                <div class="contact-icon icon-blue">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <div>
                    <div style="font-size: 11px; color: #64748B; font-weight: 700; text-transform: uppercase;"><%- lan.Emergency_Contact || 'Emergency Contact' %></div>
                    <div style="font-size: 13.5px; font-weight: 800; color: #1E293B; margin-top: 1px;">
                        <%= info.contact?.phone || (lan.School_Office || 'School Office') %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="transport-bottom-grid">
    <div class="card-panel">
        <div class="panel-head">
            <div>
                <span class="panel-kicker"><%- lan.GPS_Location || 'GPS Location' %></span>
                <h3 class="panel-title" id="locationTitle">
                    <%= activeTrip ? (lan.Live_Bus_Location || 'Live Bus Location') : loc ? (lan.Last_Known_Location || 'Last Known Location') : (lan.Location_Unavailable || 'Location Unavailable') %>
                </h3>
                <p style="font-size: 12.5px; color: #64748B; margin: 4px 0 0;" id="locationSub">
                    <%= activeTrip ? (lan.GPS_Realtime_Updates_Desc || 'Receiving real-time GPS updates from vehicle.') : loc ? (lan.GPS_Not_Live_Desc || 'Bus location is not live right now. Showing last recorded location.') : (lan.GPS_No_Location_Stored_Desc || 'No GPS location has been stored yet.') %>
                </p>
            </div>
            <div>
                <% if (loc) { %>
                    <a id="mapsLink" class="btn-maps-link" target="_blank" href="https://www.google.com/maps?q=<%= loc.latitude %>,<%= loc.longitude %>">
                        <i class="fa-solid fa-map-location-dot"></i> <%- lan.Open_Google_Maps || 'Open Google Maps' %>
                    </a>
                <% } else { %>
                    <a id="mapsLink" class="btn-maps-link" href="#" style="opacity: 0.5; pointer-events: none;">
                        <i class="fa-solid fa-map-location-dot"></i> <%- lan.Maps || 'Maps' %>
                    </a>
                <% } %>
            </div>
        </div>
        <div id="map" data-active-trip="<%= activeTrip ? activeTrip.trip_id : '' %>" data-lat="<%= loc ? loc.latitude : '' %>" data-lng="<%= loc ? loc.longitude : '' %>"></div>
        <div class="map-meta-strip">
            <span><%- lan.Latitude || 'Latitude' %>: <strong id="latText" style="color: #1E293B;"><%= loc ? Number(loc.latitude).toFixed(6) : '—' %></strong></span>
            <span><%- lan.Longitude || 'Longitude' %>: <strong id="lngText" style="color: #1E293B;"><%= loc ? Number(loc.longitude).toFixed(6) : '—' %></strong></span>
            <span><%- lan.Last_Updated || 'Last Updated' %>: <strong id="updatedText" style="color: #1E293B;"><%= loc?.recordedAt ? new Date(loc.recordedAt).toLocaleString('en-IN') : '—' %></strong></span>
        </div>
    </div>
    <div class="card-panel">
        <div class="panel-head">
            <div>
                <span class="panel-kicker"><%- lan.Logs || 'Logs' %></span>
                <h3 class="panel-title"><%- lan.Recent_Activity || 'Recent Activity' %></h3>
            </div>
        </div>
        <div class="activity-timeline" id="activityTimeline">
            <% if (!info.recentActivity || info.recentActivity.length === 0) { %>
                <div style="text-align: center; padding: 40px 16px; color: #94A3B8;">
                    <i class="fa-solid fa-timeline" style="font-size: 28px; margin-bottom: 8px;"></i>
                    <p style="font-size: 13px; font-weight: 600; margin: 0;"><%- lan.No_Pickup_Drop_Activity || 'No pickup/drop activity recorded yet.' %></p>
                </div>
            <% } else { %>
                <% (info.recentActivity || []).forEach(item => { 
                    const isPickup = String(item.trip_type || '').toLowerCase().includes('pickup');
                    const isDone = String(item.status || '').toLowerCase() === 'picked' || String(item.status || '').toLowerCase() === 'dropped';
                %>
                    <div class="timeline-item">
                        <div class="timeline-dot <%= isDone ? 'dot-green' : isPickup ? 'dot-blue' : 'dot-gray' %>"></div>
                        <div style="flex: 1;">
                            <div style="font-size: 13.5px; font-weight: 700; color: #1E293B; text-transform: capitalize;">
                                <%= item.status %> &middot; <%= item.trip_type %>
                            </div>
                            <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">
                                <i class="fa-regular fa-clock" style="font-size: 10px;"></i>
                                <%= item.updatedAt ? new Date(item.updatedAt).toLocaleString('en-IN') : '' %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</div>
<div style="margin-bottom: 24px;"></div>
<div id="toastContainer" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;"></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<% if (activeTrip) { %><script src="/socket.io/socket.io.js"></script><% } %>
<script>
    (function() {
        var routeStops = [];
        try {
            var rawStops = '<%- JSON.stringify(info.routeStops || []) %>';
            routeStops = JSON.parse(rawStops);
        } catch (e) {
            console.error('[Student Transport] Failed to parse route stops:', e);
            routeStops = [];
        };

        var assignedPickupStopId = '<%= info.allocation?.pickupStopId || "" %>';
        var assignedDropStopId = '<%= info.allocation?.dropStopId || "" %>';
        var mapEl = document.getElementById('map');
        var fallbackLat = Number(mapEl.dataset.lat);
        var fallbackLng = Number(mapEl.dataset.lng);
        var hasFallback = Number.isFinite(fallbackLat) && Number.isFinite(fallbackLng);

        var map = L.map('map').setView(hasFallback ? [fallbackLat, fallbackLng] : [21.1702, 72.8311], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors' }).addTo(map);

        setTimeout(function() {
            map.invalidateSize();
        }, 300);

        var bounds = [];

        if (Array.isArray(routeStops)) {
            routeStops.forEach(function(stop) {
                var sLat = Number(stop.latitude);
                var sLng = Number(stop.longitude);
                if (!Number.isFinite(sLat) || !Number.isFinite(sLng)) return;
                bounds.push([sLat, sLng]);

                var isAssigned = (String(stop.id) === String(assignedPickupStopId) || String(stop.id) === String(assignedDropStopId));
                var icon = isAssigned ? L.divIcon({
                    className: '',
                    html: '<div style="background:#10b981;color:#fff;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 0 0 4px rgba(16,185,129,0.3);border:2px solid #fff;"><i class="fa-solid fa-house-user"></i></div>',
                    iconSize: [30, 30],
                    iconAnchor: [15, 15]
                }) : L.divIcon({
                    className: '',
                    html: '<div style="background:#0f172a;color:#fff;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-size:11px;box-shadow:0 2px 6px rgba(0,0,0,0.2);border:2px solid #fff;"><i class="fa-solid fa-location-dot"></i></div>',
                    iconSize: [24, 24],
                    iconAnchor: [12, 12]
                });

                L.marker([sLat, sLng], { icon: icon }).addTo(map).bindPopup(
                    '<strong>' + (stop.stopName || 'Stop') + '</strong><br>' +
                    '<span style="font-size:11px;color:#64748b;">' + (isAssigned ? '<b>Your Assigned Stop</b><br>' : '') + 'Pickup: ' + (stop.pickupTime || '—') + ' &middot; Drop: ' + (stop.dropTime || '—') + '</span>'
                );
            });
        };

        if (routeStops.length >= 2) {
            var coords = routeStops.map(function(s) { return [Number(s.latitude), Number(s.longitude)]; }).filter(function(c) { return Number.isFinite(c[0]) && Number.isFinite(c[1]); });
            if (coords.length >= 2) {
                var fallbackLine = L.polyline(coords, { color: '#ea580c', weight: 4, opacity: 0.7, dashArray: '6,4' }).addTo(map);
                var osrmCoords = coords.map(function(c) { return c[1] + ',' + c[0]; }).join(';');
                fetch('https://router.project-osrm.org/route/v1/driving/' + osrmCoords + '?overview=full&geometries=geojson')
                    .then(function(r) { return r.json(); })
                    .then(function(d) {
                        if (d.code === 'Ok' && d.routes && d.routes[0]) {
                            map.removeLayer(fallbackLine);
                            var roadCoords = d.routes[0].geometry.coordinates.map(function(c) { return [c[1], c[0]]; });
                            L.polyline(roadCoords, { color: '#ea580c', weight: 5, opacity: 0.8 }).addTo(map);
                        };
                    })
                    .catch(function(e) { console.warn('[OSRM] Route fallback:', e.message); });
            };
        };

        var marker = null;
        var busIcon = L.divIcon({
            className: '',
            html: '<div style="background:#ea580c;color:#fff;border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;font-size:15px;box-shadow:0 3px 8px rgba(234,88,12,0.4);border:2px solid #fff;"><i class="fa-solid fa-bus"></i></div>',
            iconSize: [34, 34],
            iconAnchor: [17, 17]
        });

        function setLocation(data, live) {
            var lat = Number(data.latitude);
            var lng = Number(data.longitude);
            if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
            
            if (!marker) {
                marker = L.marker([lat, lng], { icon: busIcon }).addTo(map);
            } else {
                marker.setLatLng([lat, lng]);
            };
            
            if (live) {
                map.setView([lat, lng], 16);
            } else if (bounds.length) {
                map.fitBounds(bounds, { padding: [40, 40] });
            } else {
                map.setView([lat, lng], 15);
            };

            var latEl = document.getElementById('latText');
            var lngEl = document.getElementById('lngText');
            var updatedEl = document.getElementById('updatedText');
            var titleEl = document.getElementById('locationTitle');
            var subEl = document.getElementById('locationSub');
            var linkEl = document.getElementById('mapsLink');

            if (latEl) latEl.textContent = lat.toFixed(6);
            if (lngEl) lngEl.textContent = lng.toFixed(6);
            if (updatedEl) updatedEl.textContent = new Date(data.timestamp || data.recordedAt || Date.now()).toLocaleString('en-IN');
            if (titleEl) titleEl.textContent = live ? 'Live Bus Location' : 'Last Known Location';
            if (subEl) subEl.textContent = live ? 'Receiving real-time GPS updates from vehicle.' : 'Bus location is not live right now. Showing last recorded location.';
            if (linkEl) {
                linkEl.href = 'https://www.google.com/maps?q=' + lat + ',' + lng;
                linkEl.style.opacity = '1';
                linkEl.style.pointerEvents = 'auto';
            };
        };

        if (hasFallback) {
            setLocation({ latitude: fallbackLat, longitude: fallbackLng, recordedAt: '<%= loc?.recordedAt || "" %>' }, false);
        } else if (bounds.length) {
            map.fitBounds(bounds, { padding: [40, 40] });
        };

        function setConnectionStatus(status, text) {
            var el = document.getElementById('connectionStatus');
            var txt = document.getElementById('connectionText');
            if (!el || !txt) return;
            
            if (status === 'connected') {
                el.style.display = 'block';
                el.style.background = '#ECFDF5';
                el.style.color = '#047857';
                el.style.border = '1px solid #A7F3D0';
                txt.innerHTML = '🟢 ' + text;
            } else if (status === 'disconnected') {
                el.style.display = 'block';
                el.style.background = '#FEF2F2';
                el.style.color = '#DC2626';
                el.style.border = '1px solid #FECACA';
                txt.innerHTML = '🔴 ' + text;
            } else if (status === 'connecting') {
                el.style.display = 'block';
                el.style.background = '#FFFBEB';
                el.style.color = '#D97706';
                el.style.border = '1px solid #FDE68A';
                txt.innerHTML = '🟡 ' + text;
            } else {
                el.style.display = 'none';
            };
        };

        var tripId = mapEl.dataset.activeTrip;
        var socket = null;
        var fallbackInterval = null;

        if (tripId && typeof io !== 'undefined') {
            try {
                socket = io({ withCredentials: true, transports: ['websocket', 'polling'] });
                
                socket.on('connect', function() {
                    setConnectionStatus('connected', 'Live GPS Tracking Active');
                    socket.emit('join_trip', { trip_id: Number(tripId) });
                    if (fallbackInterval) {
                        clearInterval(fallbackInterval);
                        fallbackInterval = null;
                    };
                });

                socket.on('bus_location_update', function(data) {
                    setLocation(data, true);
                    setConnectionStatus('connected', 'Live Tracking Active &middot; Just updated');
                });

                socket.on('location_updated', function(data) {
                    setLocation(data, true);
                });

                socket.on('bus_approaching', function(data) {
                    var banner = document.getElementById('busApproachingBanner');
                    if (!banner) return;
                    
                    var stopEl = document.getElementById('busApproachingStop');
                    var etaEl = document.getElementById('busApproachingEta');
                    
                    if (stopEl) stopEl.textContent = data.stopName || 'your stop';
                    if (etaEl) etaEl.textContent = data.etaMin > 0 ? ('~' + data.etaMin + ' min away') : 'Arriving now!';
                    
                    banner.style.display = 'flex';
                    setTimeout(function() { banner.style.display = 'none'; }, 5 * 60 * 1000);
                });

                socket.on('disconnect', function(reason) {
                    console.warn('[Student Socket] Disconnected:', reason);
                    setConnectionStatus('disconnected', 'Live tracking disconnected. Using auto-refresh...');
                    startFallbackRefresh();
                });

                socket.on('connect_error', function(err) {
                    console.error('[Student Socket] Connection error:', err.message);
                    setConnectionStatus('disconnected', 'Live tracking unavailable. Using auto-refresh...');
                    startFallbackRefresh();
                });
            } catch (err) {
                console.error('[Student Socket] Init error:', err);
                setConnectionStatus('disconnected', 'Live tracking not available');
                startFallbackRefresh();
            };
        } else if (tripId) {
            setConnectionStatus('connecting', 'Starting live tracking...');
            startFallbackRefresh();
        };

        function startFallbackRefresh() {
            if (fallbackInterval) return;
            fallbackInterval = setInterval(function() {
                refreshLocation();
            }, 30000);
        };

        function refreshLocation() {
            fetch('/student/transport/location/latest')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success && data.active && data.bus) {
                        setLocation(data.bus, false);
                        setConnectionStatus('connecting', 'Location refreshed &middot; ' + new Date().toLocaleTimeString('en-IN'));
                    };
                })
                .catch(function(err) {
                    console.error('[Student Fallback] Refresh failed:', err);
                });
        };

        window.refreshLocation = function() {
            var icon = document.getElementById('refreshIcon');
            if (icon) icon.classList.add('fa-spin');
            
            refreshLocation();
            
            setTimeout(function() {
                if (icon) icon.classList.remove('fa-spin');
            }, 1000);
        };
    })();
</script>