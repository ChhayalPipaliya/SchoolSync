<div class="content-container py-6 max-w-4xl mx-auto px-4">
    <div class="mb-3">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <a href="/student/dashboard" class="hover:text-indigo-600"><%- lan.Student_Portal || 'Student Portal' %></a>
            <span>/</span>
            <span class="text-gray-900 font-medium"><%- lan.AI_Assistant || 'AI Assistant' %></span>
        </div>
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                    <i class="fa-solid fa-robot text-indigo-600"></i> <%- lan.SchoolSync_AI || 'SchoolSync AI' %>
                </h1>
                <p class="text-sm text-gray-600 mt-1">
                    <%- lan.Ask_Education_Question || 'Ask an education question...' %>
                </p>
            </div>
            <div
                class="text-xs bg-indigo-50 text-indigo-700 px-3 py-1.5 rounded-full font-medium border border-indigo-100 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-green-500"></span> <%- lan.Education_Mode || 'Education Mode' %>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div
            class="bg-gradient-to-r from-indigo-50/70 to-purple-50/70 p-4 border-b border-gray-100 flex items-start gap-3">
            <i class="fa-solid fa-circle-info text-indigo-600 mt-0.5"></i>
            <div class="text-xs text-gray-600 leading-relaxed">
                <span class="font-semibold text-gray-800"><%- lan.Learning_Assistant_Label || 'Learning Assistant:'
                        %></span> <%- lan.Student_AI_Banner_Desc
                    || 'SchoolSync AI provides concept explanations, study guidance, and learning hints for academic subjects. Direct answers to active homework problems are converted into step-by-step guidance.'
                    %>
            </div>
        </div>
        <div class="p-6 space-y-6">
            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
                    <%- lan.Quick_Education_Examples || 'Quick Education Examples' %>
                </label>
                <div class="flex flex-wrap gap-2">
                    <button type="button"
                        class="quick-prompt-btn text-xs bg-gray-50 hover:bg-indigo-50 hover:text-indigo-700 text-gray-700 px-3 py-2 rounded-lg border border-gray-200 transition-colors text-left"
                        data-prompt="Explain photosynthesis in simple language.">
                        🌱 <%- lan.Explain_Photosynthesis || 'Explain photosynthesis' %>
                    </button>
                    <button type="button"
                        class="quick-prompt-btn text-xs bg-gray-50 hover:bg-indigo-50 hover:text-indigo-700 text-gray-700 px-3 py-2 rounded-lg border border-gray-200 transition-colors text-left"
                        data-prompt="What is the Pythagorean theorem?">
                        📐 <%- lan.Pythagorean_Theorem || 'Pythagorean theorem' %>
                    </button>
                    <button type="button"
                        class="quick-prompt-btn text-xs bg-gray-50 hover:bg-indigo-50 hover:text-indigo-700 text-gray-700 px-3 py-2 rounded-lg border border-gray-200 transition-colors text-left"
                        data-prompt="Give study tips for Class 8 mathematics.">
                        📚 <%- lan.Math_Study_Tips || 'Math study tips' %>
                    </button>
                    <button type="button"
                        class="quick-prompt-btn text-xs bg-gray-50 hover:bg-indigo-50 hover:text-indigo-700 text-gray-700 px-3 py-2 rounded-lg border border-gray-200 transition-colors text-left"
                        data-prompt="Explain the water cycle.">
                        💧 <%- lan.Water_Cycle || 'Water cycle' %>
                    </button>
                </div>
            </div>
            <form id="aiChatForm" class="space-y-4">
                <div>
                    <label for="aiMessageInput" class="block text-sm font-medium text-gray-700 mb-1">
                        <%- lan.Your_Educational_Question || 'Your Educational Question' %>
                    </label>
                    <textarea id="aiMessageInput" name="message" rows="4"
                        class="w-full rounded-xl border border-gray-300 p-3.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none transition-all placeholder:text-gray-400 resize-y"
                        placeholder="<%- lan.AI_Student_Input_Placeholder || 'Ask an education question... e.g. Explain photosynthesis' %>"
                        required></textarea>
                </div>
                <div class="flex items-center justify-between pt-1">
                    <div class="text-xs text-gray-400 flex items-center gap-1">
                        <i class="fa-solid fa-lock text-gray-400"></i> <%- lan.Text_Only_AI_Assistant
                            || 'Text-only educational assistant' %>
                    </div>
                    <button type="submit" id="aiSendBtn"
                        class="inline-flex items-center gap-2 px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium text-sm rounded-xl shadow-sm hover:shadow transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span><%- lan.Send || 'Send' %></span>
                    </button>
                </div>
            </form>
            <div id="aiLoadingIndicator" class="hidden py-8 text-center space-y-3">
                <div
                    class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-200 border-t-indigo-600">
                </div>
                <p class="text-xs text-gray-500 font-medium"><%- lan.Generating_Educational_Response
                        || 'Generating educational response...' %></p>
            </div>
            <div id="aiErrorBanner"
                class="hidden p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex items-start gap-3">
                <i class="fa-solid fa-triangle-exclamation text-amber-600 mt-0.5"></i>
                <div id="aiErrorMessage" class="flex-1"></div>
            </div>
            <div id="aiResponseContainer" class="hidden rounded-2xl bg-gray-50 border border-gray-200 p-6 space-y-3">
                <div class="flex items-center justify-between border-b border-gray-200 pb-3">
                    <div class="flex items-center gap-2 text-sm font-semibold text-gray-900">
                        <i class="fa-solid fa-sparkles text-indigo-600"></i> <%- lan.AI_Response_Label || 'AI Response:'
                            %>
                    </div>
                    <button type="button" id="copyResponseBtn"
                        class="text-xs text-gray-500 hover:text-indigo-600 flex items-center gap-1">
                        <i class="fa-solid fa-copy"></i> <%- lan.Copy || 'Copy' %>
                    </button>
                </div>
                <div id="aiResponseText" class="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap font-sans">
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('aiChatForm');
        const input = document.getElementById('aiMessageInput');
        const sendBtn = document.getElementById('aiSendBtn');
        const loading = document.getElementById('aiLoadingIndicator');
        const errorBanner = document.getElementById('aiErrorBanner');
        const errorMessage = document.getElementById('aiErrorMessage');
        const responseBox = document.getElementById('aiResponseContainer');
        const responseText = document.getElementById('aiResponseText');
        const copyBtn = document.getElementById('copyResponseBtn');
        const quickBtns = document.querySelectorAll('.quick-prompt-btn');

        quickBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                input.value = btn.dataset.prompt;
                input.focus();
            });
        });

        copyBtn?.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(responseText.innerText);
                copyBtn.innerHTML = '<i class="fa-solid fa-check text-green-600"></i> <%- lan.Copied || "Copied!" %>';
                setTimeout(() => {
                    copyBtn.innerHTML = '<i class="fa-solid fa-copy"></i> <%- lan.Copy || "Copy" %>';
                }, 2000);
            } catch (e) {
                console.error('Copy failed', e);
            }
        });

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = input.value.trim();
            if (!message) return;

            sendBtn.disabled = true;
            loading.classList.remove('hidden');
            errorBanner.classList.add('hidden');
            responseBox.classList.add('hidden');

            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || document.querySelector('input[name="_csrf"]')?.value || '';
                const res = await fetch('/api/ai/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-csrf-token': csrfToken
                    },
                    body: JSON.stringify({ message })
                });

                const data = await res.json();
                if (res.ok && data.success) {
                    responseText.innerText = data.response;
                    responseBox.classList.remove('hidden');
                } else if (data && data.response) {
                    responseText.innerText = data.response;
                    responseBox.classList.remove('hidden');
                } else {
                    errorMessage.innerText = data.message || 'Unable to get response from AI. Please try again.';
                    errorBanner.classList.remove('hidden');
                }

            } catch (err) {
                console.error('AI chat error:', err);
                errorMessage.innerText = 'Network error while contacting AI service. Please check your connection.';
                errorBanner.classList.remove('hidden');
            } finally {
                loading.classList.add('hidden');
                sendBtn.disabled = false;
            }
        });
    });
</script>