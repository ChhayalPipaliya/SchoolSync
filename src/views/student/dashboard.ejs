<%
  const libBooks = typeof libraryBooks !== 'undefined' && libraryBooks ? libraryBooks : (typeof myBooks !== 'undefined' && myBooks ? myBooks : []);
  const hwList = typeof homeworks !== 'undefined' && homeworks ? homeworks : (typeof homework !== 'undefined' && homework ? homework : []);
  const examList = typeof exams !== 'undefined' && exams ? exams : [];
  const resultList = typeof results !== 'undefined' && results ? results : [];
  const noticeList = typeof notices !== 'undefined' && notices ? notices : [];
  const presDays = typeof presentDays !== 'undefined' ? presentDays : (typeof monthlyAttendance !== 'undefined' && monthlyAttendance && typeof monthlyAttendance.present !== 'undefined' ? monthlyAttendance.present : 118);
  const totDays = typeof totalDays !== 'undefined' ? totalDays : (typeof monthlyAttendance !== 'undefined' && monthlyAttendance && typeof monthlyAttendance.total !== 'undefined' ? monthlyAttendance.total : 128);
  const attendPct = typeof attendancePct !== 'undefined' ? attendancePct : 92;
  const pendHw = typeof pendingHomework !== 'undefined' ? pendingHomework : 2;
  const bksIssued = typeof booksIssued !== 'undefined' ? booksIssued : (libBooks.length || 1);
  const fStatus = typeof feeStatus !== 'undefined' ? feeStatus : 'paid';
  const fAmount = typeof feeAmount !== 'undefined' ? feeAmount : (typeof pendingFees !== 'undefined' ? pendingFees : 0);
  const stRoll = (typeof student !== 'undefined' && student && student.rollNo) ? student.rollNo : '12';
  const stClass = (typeof student !== 'undefined' && student && (student.class || student.class_name)) ? ((student.class || student.class_name) + '-' + (student.section || 'A')) : '1-A';
%>
<style>
    :root {
        --st-primary: #4f46e5;
        --st-purple: #7c3aed;
        --st-gradient: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #8b5cf6 100%);
        --st-bg: #f8fafc;
        --st-card: #ffffff;
        --st-border: #e2e8f0;
        --st-text: #0f172a;
        --st-muted: #64748b;
        --st-shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
        --st-shadow-md: 0 10px 30px -10px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.03);
        --st-shadow-lg: 0 20px 50px -15px rgba(79, 70, 229, 0.3);
    }

    .s-dash-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--st-text);
        padding-bottom: 40px;
    }

    .s-hero-card {
        background: var(--st-gradient);
        border-radius: 24px;
        padding: 32px 36px;
        color: #ffffff;
        position: relative;
        overflow: hidden;
        box-shadow: var(--st-shadow-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .s-hero-card::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 260px; height: 260px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        pointer-events: none;
    }
    .s-hero-card::after {
        content: '';
        position: absolute;
        bottom: -80px; right: 160px;
        width: 220px; height: 220px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        pointer-events: none;
    }
    .s-hero-left {
        position: relative;
        z-index: 2;
        max-width: 680px;
    }
    .s-hero-top-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 12px;
    }
    .s-hero-title {
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 6px 0;
        letter-spacing: -0.02em;
    }
    .s-hero-quote {
        font-size: 14px;
        opacity: 0.92;
        margin: 0 0 20px 0;
        font-style: italic;
    }
    .s-hero-info-pills {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }
    .s-info-pill {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.28);
        backdrop-filter: blur(8px);
        padding: 6px 14px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
    }

    .s-hero-right {
        position: relative;
        z-index: 2;
    }
    .s-hero-chips-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 20px;
        padding: 20px;
        min-width: 330px;
    }
    .s-chip-item {
        text-align: center;
    }
    .s-chip-val {
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
        display: block;
    }
    .s-chip-lbl {
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.85;
        margin-top: 4px;
        display: block;
    }

    .s-actions-grid {
        display: grid;
        grid-template-columns: repeat(10, 1fr);
        gap: 12px;
    }
    .s-action-card {
        background: var(--st-card);
        border: 1px solid var(--st-border);
        border-radius: 16px;
        padding: 16px 10px;
        text-align: center;
        text-decoration: none;
        color: var(--st-text);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        box-shadow: var(--st-shadow-sm);
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }
    .s-action-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--st-shadow-md);
        border-color: #cbd5e1;
    }
    .s-action-icon {
        width: 38px; height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .s-action-lbl {
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
    }

    .s-main-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 24px;
    }
    .s-left-col {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }
    .s-right-col {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .s-panel {
        background: var(--st-card);
        border: 1px solid var(--st-border);
        border-radius: 20px;
        padding: 22px 24px;
        box-shadow: var(--st-shadow-sm);
    }
    .s-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }
    .s-panel-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--st-text);
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
    }
    .s-panel-title i { color: #6366f1; }
    .s-panel-link {
        font-size: 12px;
        font-weight: 700;
        color: #4f46e5;
        text-decoration: none;
    }
    .s-panel-link:hover { text-decoration: underline; }

    .s-timetable-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        position: relative;
    }
    .s-timetable-list::before {
        content: '';
        position: absolute;
        top: 10px; bottom: 10px; left: 19px;
        width: 2px;
        background: #e2e8f0;
        z-index: 1;
    }
    .s-tt-item {
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        z-index: 2;
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 14px 18px;
        transition: background 0.15s, border-color 0.15s;
    }
    .s-tt-item:hover {
        background: #ffffff;
        border-color: #cbd5e1;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }
    .s-tt-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 3px #6366f1;
        background: #6366f1;
        flex-shrink: 0;
    }
    .s-tt-dot.running { box-shadow: 0 0 0 3px #10b981; background: #10b981; }
    .s-tt-dot.completed { box-shadow: 0 0 0 3px #94a3b8; background: #94a3b8; }

    .s-tt-body {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .s-tt-subject { font-size: 14px; font-weight: 700; color: var(--st-text); }
    .s-tt-meta { font-size: 12px; color: var(--st-muted); margin-top: 2px; display: flex; gap: 10px; }
    .s-tt-badge { padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    .s-tt-badge.running { background: #d1fae5; color: #047857; }
    .s-tt-badge.upcoming { background: #e0e7ff; color: #4338ca; }
    .s-tt-badge.completed { background: #f1f5f9; color: #64748b; }

    .s-hw-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }
    .s-hw-card {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
    }
    .s-hw-card:hover {
        background: #ffffff;
        border-color: #cbd5e1;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }
    .s-hw-sub { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #6366f1; }
    .s-hw-title { font-size: 14px; font-weight: 700; color: var(--st-text); margin-top: 2px; }

    .s-att-grid {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 20px;
        align-items: center;
    }
    .s-ring-box {
        position: relative;
        text-align: center;
    }
    .s-ring-center {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
    }
    .s-ring-pct { font-size: 26px; font-weight: 900; color: var(--st-text); line-height: 1; }
    .s-ring-lbl { font-size: 10px; font-weight: 600; color: var(--st-muted); }

    .s-perf-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .s-perf-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .s-perf-header {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        font-weight: 700;
    }
    .s-perf-track {
        height: 10px;
        background: #f1f5f9;
        border-radius: 999px;
        overflow: hidden;
    }
    .s-perf-fill {
        height: 100%;
        border-radius: 999px;
        transition: width 1s ease;
    }

    .s-dual-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .s-widget-card {
        background: var(--st-card);
        border: 1px solid var(--st-border);
        border-radius: 18px;
        padding: 18px 20px;
        box-shadow: var(--st-shadow-sm);
    }
    .s-widget-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 14px;
        font-weight: 800;
        color: var(--st-text);
    }

    .s-qa-panel {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
    }
    .s-qa-item {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 16px;
        text-align: center;
        text-decoration: none;
        color: var(--st-text);
        font-size: 12px;
        font-weight: 700;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        transition: transform 0.2s, background 0.2s;
    }
    .s-qa-item:hover {
        transform: translateY(-2px);
        background: #ffffff;
        box-shadow: var(--st-shadow-md);
    }

    @media (max-width: 1200px) {
        .s-actions-grid { grid-template-columns: repeat(5, 1fr); }
        .s-main-layout { grid-template-columns: 1fr; }
        .s-hero-card { flex-direction: column; align-items: flex-start; gap: 20px; }
        .s-hero-chips-grid { width: 100%; }
        .s-qa-panel { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 768px) {
        .s-actions-grid { grid-template-columns: repeat(3, 1fr); }
        .s-hw-grid { grid-template-columns: 1fr; }
        .s-dual-grid { grid-template-columns: 1fr; }
        .s-att-grid { grid-template-columns: 1fr; }
        .s-qa-panel { grid-template-columns: repeat(2, 1fr); }
    }
</style>
<div class="s-dash-container reveal">
