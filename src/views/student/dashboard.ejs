    <section class="s-hero-card" aria-label="Student Welcome Banner">
        <div class="s-hero-left">
            <div class="s-hero-top-badge">
                <i class="fas fa-graduation-cap"></i>
                <span>Academic Year 2026-2027</span>
            </div>
            <h1 class="s-hero-title">
                Hello, <%= (typeof user !=='undefined' && user && user.first_name) ? user.first_name : ((typeof student !== 'undefined' && student && student.first_name) ? student.first_name : 'Student') %>! 👋
            </h1>
            <p class="s-hero-quote">
                "Every day is a new opportunity to learn something new."
            </p>
            <div class="s-hero-info-pills">
                <div class="s-info-pill">Roll No: <strong>
                        <%= stRoll %>
                    </strong></div>
                <div class="s-info-pill">Class: <strong>
                        <%= stClass %>
                    </strong></div>
                <div class="s-info-pill">Date: <strong id="currentDateText"></strong></div>
            </div>
        </div>
        <div class="s-hero-right" style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">
            <%- include('../partials/hero-illustration', { illustrationSrc: '/illustrations/student.png' , illustrationAlt: 'Student Dashboard' }) %>
            <div class="s-hero-chips-grid">
                <div class="s-chip-item">
                    <span class="s-chip-val">
                        <%= attendPct %>%
                    </span>
                    <span class="s-chip-lbl">Attendance</span>
                </div>
                <div class="s-chip-item">
                    <span class="s-chip-val">
                        <%= pendHw %>
                    </span>
                    <span class="s-chip-lbl">Hw Pending</span>
                </div>
                <div class="s-chip-item">
                    <span class="s-chip-val">
                        <%= bksIssued %>
                    </span>
                    <span class="s-chip-lbl">Library Book</span>
                </div>
                <div class="s-chip-item">
                    <span class="s-chip-val-text" style="color:#6ee7b7;">
                        <%= fStatus.toUpperCase() %>
                    </span>
                    <span class="s-chip-lbl">Fee Status</span>
                </div>
                <div class="s-chip-item">
                    <span class="s-chip-val">
                        <%= typeof examList !=='undefined' && examList !==null ? examList.length : 0 %>
                    </span>
                    <span class="s-chip-lbl">Exams</span>
                </div>
                <div class="s-chip-item">
                    <span class="s-chip-val">
                        <%= typeof noticeList !=='undefined' && noticeList !==null ? noticeList.length : 0 %>
                    </span>
                    <span class="s-chip-lbl">Notices</span>
                </div>
            </div>
        </div>
    </section>
    <section class="s-actions-grid" aria-label="Quick Actions">
        <a href="/student/timetable" class="s-action-card">
            <div class="s-action-icon" style="background:#e0e7ff;color:#4338ca;"><i class="fas fa-calendar-alt"></i>
            </div>
            <span class="s-action-lbl">Timetable</span>
        </a>
        <a href="/student/homework" class="s-action-card">
            <div class="s-action-icon" style="background:#fef3c7;color:#b45309;"><i class="fas fa-book-reader"></i>
            </div>
            <span class="s-action-lbl">Homework</span>
        </a>
        <a href="/student/results" class="s-action-card">
            <div class="s-action-icon" style="background:#d1fae5;color:#047857;"><i class="fas fa-award"></i></div>
            <span class="s-action-lbl">Results</span>
        </a>
        <a href="/student/exams" class="s-action-card">
            <div class="s-action-icon" style="background:#ede9fe;color:#6d28d9;"><i
                    class="fas fa-clipboard-list"></i></div>
            <span class="s-action-lbl">Exams</span>
        </a>
        <a href="/student/attendance" class="s-action-card">
            <div class="s-action-icon" style="background:#dbeafe;color:#1d4ed8;"><i class="fas fa-user-check"></i>
            </div>
            <span class="s-action-lbl">Attendance</span>
        </a>
        <a href="/student/transport" class="s-action-card">
            <div class="s-action-icon" style="background:#ffedd5;color:#c2410c;"><i class="fas fa-bus"></i></div>
            <span class="s-action-lbl">Track Bus</span>
        </a>
        <a href="/student/library" class="s-action-card">
            <div class="s-action-icon" style="background:#fce7f3;color:#be185d;"><i class="fas fa-book"></i></div>
            <span class="s-action-lbl">Library</span>
        </a>
        <a href="/student/fees" class="s-action-card">
            <div class="s-action-icon" style="background:#dcfce7;color:#15803d;"><i class="fas fa-receipt"></i>
            </div>
            <span class="s-action-lbl">Fee Details</span>
        </a>
        <a href="#idCardModal" class="s-action-card" id="idCardActionBtn"
            data-name="<%= student && student.first_name ? (student.first_name + (student.last_name ? ' ' + student.last_name : '')) : 'Student' %>"
            data-roll="<%= stRoll %>" data-cls="<%= stClass %>">
            <div class="s-action-icon" style="background:#e0f2fe;color:#0369a1;"><i class="fas fa-id-card"></i>
            </div>
            <span class="s-action-lbl">ID Card</span>
        </a>
        <a href="/student/leaves" class="s-action-card">
            <div class="s-action-icon" style="background:#ffe4e6;color:#be123c;"><i class="fas fa-paper-plane"></i>
            </div>
            <span class="s-action-lbl">Apply Leave</span>
        </a>
    </section>
    <div class="s-main-layout">
        <div class="s-left-col">
            <div class="s-panel">
                <div class="s-panel-header">
                    <h3 class="s-panel-title"><i class="fas fa-clock"></i> Today's Timetable</h3>
                    <a href="/student/timetable" class="s-panel-link">Full Schedule →</a>
                </div>
                <div class="s-timetable-list">
                    <% if (todayScheduleList && todayScheduleList.length > 0) { %>
                        <% todayScheduleList.forEach((slot) => { 
                            const slotStat = getSlotStatus(slot.startTime, slot.endTime);
                        %>
                            <div class="s-tt-item">
                                <div class="s-tt-dot <%= slotStat.key %>"></div>
                                <div class="s-tt-body">
                                    <div>
                                        <div class="s-tt-subject"><%= slot.subject || 'Class Subject' %></div>
                                        <div class="s-tt-meta">
                                            <span><i class="fas fa-clock" style="font-size:10px;margin-right:4px;"></i><%= slot.startTime || '' %> – <%= slot.endTime || '' %></span>
                                            <% if (slot.teacher) { %>
                                                <span>·</span>
                                                <span><i class="fas fa-user-tie" style="font-size:10px;margin-right:4px;"></i><%= slot.teacher %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                    <span class="s-tt-badge <%= slotStat.key %>">
                                        <%= slotStat.label %>
                                    </span>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:20px;text-align:center;color:var(--st-muted);font-size:12px;">
                            <i class="fas fa-calendar-day" style="margin-right:6px;color:#cbd5e1;"></i> No classes scheduled for today.
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="s-panel">
                <div class="s-panel-header">
                    <h3 class="s-panel-title"><i class="fas fa-book-reader"></i> Homework Tasks</h3>
                    <a href="/student/homework" class="s-panel-link">View All Homework →</a>
                </div>
                <div class="s-hw-grid">
                    <% if (hwList && hwList.length > 0) { %>
                        <% hwList.forEach(hw => { %>
                            <div class="s-hw-card">
                                <div>
                                    <div style="display:flex;justify-content:space-between;align-items:center;">
                                        <span class="s-hw-sub"><%= hw.subject_name || 'Subject' %></span>
                                        <span class="s-hw-due-badge" style="padding:3px 8px;border-radius:6px;font-size:11px;font-weight:700;">
                                            Due <%= hw.due_date ? new Date(hw.due_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : 'Soon' %>
                                        </span>
                                    </div>
                                    <div class="s-hw-title"><%= hw.title %></div>
                                </div>
                                <div class="s-hw-footer" style="border-top:1px solid #e2e8f0;padding-top:10px;display:flex;justify-content:space-between;align-items:center;font-size:12px;">
                                    <span class="<%= hw.submission_status === 'submitted' ? 'hw-status-submitted' : 'hw-status-pending' %>" style="font-weight:700;">
                                        <%= hw.submission_status === 'submitted' ? '✓ Submitted' : '● Pending Submission' %>
                                    </span>
                                    <a href="/student/homework" style="color:#4f46e5;font-weight:700;text-decoration:none;">View Details →</a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:20px;text-align:center;color:var(--st-muted);font-size:12px;grid-column:1 / -1;">
                            <i class="fas fa-check-circle" style="margin-right:6px;color:#cbd5e1;"></i> No active homework assigned.
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="s-dual-grid">
                <div class="s-panel">
                    <div class="s-panel-header">
                        <h3 class="s-panel-title" style="font-size:15px;"><i class="fas fa-chart-pie"></i> Attendance Analytics</h3>
                    </div>
                    <div class="s-att-grid">
                        <div class="s-ring-box">
                            <svg width="130" height="130" viewBox="0 0 130 130" style="transform:rotate(-90deg);">
                                <circle cx="65" cy="65" r="52" fill="none" stroke="#f1f5f9" stroke-width="12" />
                                <circle cx="65" cy="65" r="52" fill="none" stroke="#4f46e5" stroke-width="12"
                                    stroke-linecap="round" stroke-dasharray="326.7"
                                    stroke-dashoffset="<%= 326.7 * (1 - (attendPct / 100)) %>" />
                            </svg>
                            <div class="s-ring-center">
                                <div class="s-ring-pct">
                                    <%= attendPct %>%
                                </div>
                                <div class="s-ring-lbl">Overall</div>
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:8px;font-size:12px;">
                            <div class="s-att-badge-pres" style="display:flex;justify-content:space-between;background:#ecfdf5;padding:8px 12px;border-radius:10px;color:#047857;font-weight:700;">
                                <span><i class="fas fa-check-circle me-1"></i> Present Days</span>
                                <span><%= presDays %> Days</span>
                            </div>
                            <div class="s-att-badge-tot" style="display:flex;justify-content:space-between;background:#fef2f2;padding:8px 12px;border-radius:10px;color:#b91c1c;font-weight:700;">
                                <span><i class="fas fa-times-circle me-1"></i> Total Working</span>
                                <span><%= totDays %> Days</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="s-panel">
                    <div class="s-panel-header">
                        <h3 class="s-panel-title" style="font-size:15px;"><i class="fas fa-award" style="color:#6366f1;"></i> Performance</h3>
                        <a href="/student/results" class="s-panel-link">View All Marks →</a>
                    </div>
                    <div class="s-perf-list">
                        <% if (resultList && resultList.length > 0) { %>
                            <% if (typeof latestExamName !== 'undefined' && latestExamName) { %>
                                <div style="font-size:11px;font-weight:700;margin-bottom:12px;">
                                    <span style="background:#e0e7ff;color:#4338ca;padding:3px 10px;border-radius:999px;font-size:10px;text-transform:uppercase;letter-spacing:0.04em;"><%= latestExamName %></span>
                                </div>
                            <% } %>
                            <% resultList.forEach(r => { 
                                const obtMarks = parseFloat(r.marks || 0);
                                const totalM = parseFloat(r.outOf || 100);
                                const pct = totalM > 0 ? Math.round((obtMarks / totalM) * 100) : 0;
                                
                                let perfLevel = 'emerald';
                                if (pct < 40) {
                                    perfLevel = 'rose';
                                } else if (pct < 60) {
                                    perfLevel = 'amber';
                                } else if (pct < 80) {
                                    perfLevel = 'indigo';
                                }
                            %>
                                <div class="s-perf-row" style="background:#f8fafc;padding:10px 12px;border-radius:12px;border:1px solid #f1f5f9;margin-bottom:8px;">
                                    <div class="s-perf-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-size:13px;font-weight:700;">
                                        <span style="color:var(--st-text);"><%= r.subject %></span>
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <span style="font-size:12px;font-weight:800;color:var(--st-text);"><%= obtMarks %> / <%= totalM %></span>
                                            <span class="perf-badge-<%= perfLevel %>">
                                                <%= r.grade ? r.grade : (pct + '%') %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="s-perf-track" style="height:7px;background:#e2e8f0;border-radius:999px;overflow:hidden;">
                                        <div class="s-perf-fill perf-bar-<%= perfLevel %>" data-pct="<%= pct %>" style="height:100%;border-radius:999px;transition:width 0.6s ease;"></div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="padding:24px 16px;text-align:center;color:var(--st-muted);font-size:12px;background:#f8fafc;border-radius:14px;border:1px dashed #cbd5e1;">
                                <div style="font-size:28px;margin-bottom:8px;">📊</div>
                                <div style="font-size:13px;font-weight:700;color:var(--st-text);margin-bottom:4px;">No Published Results Yet</div>
                                <p style="margin:0 0 10px 0;font-size:11px;color:#64748b;">Your exam marks &amp; grades will appear here once teachers publish the results.</p>
                                <a href="/student/exams" style="display:inline-block;background:#4f46e5;color:#ffffff;padding:5px 12px;border-radius:8px;font-weight:700;text-decoration:none;font-size:11px;">View Exam Schedule →</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="s-right-col">
            <div class="s-widget-card">
                <div class="s-widget-header">
                    <span><i class="fas fa-clipboard-list" style="color:#7c3aed;margin-right:6px;"></i> Upcoming Exams</span>
                    <a href="/student/exams" style="font-size:11px;color:#4f46e5;font-weight:700;text-decoration:none;">All Exams</a>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <% if (examList && examList.length > 0) { %>
                        <% examList.forEach(e => { %>
                            <div class="s-exam-item" style="border-radius:10px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;">
                                <div>
                                    <div style="font-size:12px;font-weight:700;color:var(--st-text);"><%= e.exam_name || e.name || 'Exam' %></div>
                                    <div style="font-size:11px;color:var(--st-muted);"><%= e.subject_name || 'Subject Exam' %></div>
                                </div>
                                <span style="background:#ede9fe;color:#6d28d9;padding:4px 8px;border-radius:6px;font-size:10px;font-weight:700;white-space:nowrap;">
                                    <%= e.exam_date ? new Date(e.exam_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : 'TBD' %>
                                </span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:15px;text-align:center;color:var(--st-muted);font-size:12px;">
                            <i class="fas fa-calendar-times" style="margin-right:4px;color:#cbd5e1;"></i> No upcoming exams scheduled.
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="s-widget-card">
                <div class="s-widget-header">
                    <span><i class="fas fa-bullhorn" style="color:#f59e0b;margin-right:6px;"></i> Recent Notices</span>
                    <a href="/student/notices" style="font-size:11px;color:#4f46e5;font-weight:700;text-decoration:none;">View All</a>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <% if (noticeList && noticeList.length > 0) { %>
                        <% noticeList.slice(0, 4).forEach(notice => { %>
                            <div class="s-notice-item" style="padding:10px;border-radius:10px;border-left:3px solid #3b82f6;">
                                <div style="font-size:12px;font-weight:700;color:var(--st-text);"><%= notice.title %></div>
                                <div style="font-size:11px;color:var(--st-muted);margin-top:2px;">
                                    <%= notice.message || notice.content %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="text-align:center;padding:16px;color:var(--st-muted);font-size:12px;">
                            No active notices.
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="s-widget-card">
                <div class="s-widget-header">
                    <span><i class="fas fa-calendar-check" style="color:#10b981;margin-right:6px;"></i> Events &amp; Holidays</span>
                    <a href="/student/academic-calendar" style="font-size:11px;color:#4f46e5;font-weight:700;text-decoration:none;">Calendar</a>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;font-size:12px;">
                    <% if (eventList && eventList.length > 0) { %>
                        <% eventList.forEach(evt => { %>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <div class="evt-dot" data-color="<%= evt.color || '#3b82f6' %>" style="width:8px;height:8px;border-radius:50%;"></div>
                                <div style="flex:1;font-weight:600;color:var(--st-text);"><%= evt.title %></div>
                                <span style="font-size:11px;color:var(--st-muted);">
                                    <%= evt.start_date ? new Date(evt.start_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '' %>
                                </span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:10px;text-align:center;color:var(--st-muted);font-size:12px;">
                            No upcoming events.
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="s-widget-card">
                <div class="s-widget-header">
                    <span><i class="fas fa-gift" style="color:#ec4899;margin-right:6px;"></i> Today's Birthdays 🎂</span>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <% if (bdaysList && bdaysList.length > 0) { %>
                        <% bdaysList.forEach(b => { %>
                            <div class="s-bday-item" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:12px;">
                                <div style="width:34px;height:34px;border-radius:50%;background:#fbcfe8;color:#be185d;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;">
                                    <%= b.first_name ? b.first_name.charAt(0).toUpperCase() : '🎂' %>
                                </div>
                                <div style="flex:1;">
                                    <div style="font-size:13px;font-weight:700;color:var(--st-text);"><%= b.first_name %> <%= b.last_name %></div>
                                    <div style="font-size:11px;color:#ec4899;font-weight:700;text-transform:uppercase;">
                                        <%= b.className ? (b.className + (b.section ? ' - ' + b.section : '')) : b.role %>
                                    </div>
                                </div>
                                <span style="font-size:16px;">🎉</span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="text-align:center;padding:14px;color:var(--st-muted);font-size:12px;">
                            <i class="fas fa-cake-candles" style="margin-right:4px;color:#f472b6;"></i> No birthdays today 🎉
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="s-panel">
                <div class="s-panel-header">
                    <h3 class="s-panel-title" style="font-size:15px;"><i class="fas fa-book"></i> Library Books Issued</h3>
                </div>
                <% if (libBooks && libBooks.length > 0) { %>
                    <% libBooks.slice(0, 2).forEach(bk => { %>
                        <div class="s-lib-item" style="display:flex;align-items:center;gap:14px;padding:12px 14px;border-radius:14px;margin-bottom:8px;">
                            <div style="width:40px;height:48px;border-radius:6px;background:#6366f1;color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px;">📖</div>
                            <div style="flex:1;">
                                <div style="font-size:13px;font-weight:700;color:var(--st-text);"><%= bk.title %></div>
                                <div style="font-size:11px;color:var(--st-muted);margin-top:2px;">
                                    Issued: <%= bk.issue_date ? new Date(bk.issue_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '-' %> · Due: <%= bk.due_date ? new Date(bk.due_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '-' %>
                                </div>
                            </div>
                            <a href="/student/library" style="background:#e0e7ff;color:#4338ca;padding:6px 12px;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;">View</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div style="padding:15px;text-align:center;color:var(--st-muted);font-size:12px;">
                        <i class="fas fa-book-open" style="margin-right:4px;color:#cbd5e1;"></i> No books currently issued.
                    </div>
                <% } %>
            </div>
            <div class="s-panel">
                <div class="s-panel-header">
                    <h3 class="s-panel-title" style="font-size:15px;"><i class="fas fa-receipt"></i> Fee Status</h3>
                    <span class="fee-badge-<%= fAmount > 0 ? 'pending' : 'paid' %>">
                        <%= fAmount > 0 ? 'PENDING' : 'PAID' %>
                    </span>
                </div>
                <div class="s-fee-box" style="display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-radius:14px;">
                    <div>
                        <% if (typeof totalFees !== 'undefined' && totalFees > 0) { %>
                            <div style="font-size:11px;color:var(--st-muted);margin-bottom:2px;">
                                Total Annual Fee: <strong style="color:var(--st-text, #1e293b);">₹<%= Math.round(totalFees).toLocaleString('en-IN') %></strong>
                            </div>
                        <% } %>
                        <div style="font-size:12px;color:var(--st-muted);">Current Outstanding: 
                            <strong class="<%= fAmount > 0 ? 'fee-amt-due' : 'fee-amt-paid' %>">
                                ₹<%= Math.round(fAmount).toLocaleString('en-IN') %> <%= fAmount > 0 ? '(Pending Dues)' : '(No Dues)' %>
                            </strong>
                        </div>
                    </div>
                    <a href="/student/fees" style="background:#4f46e5;color:#fff;padding:6px 12px;border-radius:8px;font-size:11px;font-weight:700;text-decoration:none;">Details →</a>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const dateEl = document.getElementById("currentDateText");
        if (dateEl) {
            dateEl.textContent = new Date().toLocaleDateString("en-IN", {
                weekday: "long", year: "numeric", month: "long", day: "numeric"
            });
        }

        document.querySelectorAll(".s-perf-fill[data-pct]").forEach(el => {
            const pct = parseInt(el.dataset.pct, 10) || 0;
            el.style.width = pct + "%";
        });

        document.querySelectorAll(".evt-dot[data-color]").forEach(el => {
            el.style.background = el.dataset.color;
        });

        const idCardActionBtn = document.getElementById("idCardActionBtn");
        if (idCardActionBtn) {
            idCardActionBtn.addEventListener("click", function(e) {
                e.preventDefault();
                const name = this.dataset.name || "Student";
                const roll = this.dataset.roll || "-";
                const cls  = this.dataset.cls  || "-";
                alert("Student ID Card: " + name + " (Roll No " + roll + ", Class " + cls + ")");
            });
        }

        const btnIdCard = document.getElementById("btnDownloadIdCard");
        if (btnIdCard) {
            btnIdCard.addEventListener("click", function(e) {
                e.preventDefault();
                alert("ID Card feature coming soon!");
            });
        }
    });
</script>