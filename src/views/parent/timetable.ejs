<section class="card">
    <h1>Timetable — <%= activeChild.first_name %></h1>
    <% if (!entries.length) { %>
        <p>No timetable entries are available.</p>
    <% } else { %>
        <table class="table-no-min-width">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Period</th>
                    <th>Subject</th>
                    <th>Teacher</th>
                </tr>
            </thead>
            <tbody>
                <% entries.forEach(entry => { %>
                    <tr>
                        <td><%= entry.day_of_week %></td>
                        <td><%= entry.label %></td>
                        <td><%= entry.subject_name || '-' %></td>
                        <td><%= `${entry.teacher_first_name || ''} ${entry.teacher_last_name || ''}`.trim() || '-' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</section>