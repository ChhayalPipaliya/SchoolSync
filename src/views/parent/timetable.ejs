<%
    const listPeriods = typeof periods !== 'undefined' && periods ? periods : [];
    const listEntries = typeof entries !== 'undefined' && entries ? entries : [];
    const kids = typeof children !== 'undefined' && children ? children : [];
    const active = typeof activeChild !== 'undefined' && activeChild ? activeChild : (kids[0] || {});

    const dayNames = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const timetableGrid = {};
    dayNames.forEach(d => { timetableGrid[d] = {}; });

    let hasEntries = false;
    listEntries.forEach(entry => {
        if (entry.day_of_week && entry.period_slot_id) {
            timetableGrid[entry.day_of_week][entry.period_slot_id] = entry;
            hasEntries = true;
        }
    });
%>
<style>
    .tt-header-card {
        background: linear-gradient(135deg, #0891b2, #075985);
        border-radius: 12px;
        padding: 24px;
        color: #ffffff;
        margin-bottom: 10px;
        position: relative;
        overflow: hidden;
    }
    .tt-header-circle {
        position: absolute;
        right: -30px;
        top: -30px;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
    }
    .tt-header-inner {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }
    .tt-content-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
        margin-bottom: 10px;
    }
    .tt-content-header {
        padding: 14px 20px;
        border-bottom: 1px solid #F1F5F9;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .grid-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        text-align: left;
    }
    .grid-table th {
        background-color: #F8FAFC;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748B;
        padding: 12px 14px;
        border-bottom: 1px solid #E2E8F0;
        border-right: 1px solid #F1F5F9;
        letter-spacing: 0.5px;
    }
    .grid-table th:last-child {
        border-right: none;
    }
    .grid-table td {
        border-bottom: 1px solid #F1F5F9;
        border-right: 1px solid #F1F5F9;
        padding: 8px;
        vertical-align: middle;
    }
    .grid-table td:last-child {
        border-right: none;
    }
    .period-col {
        background-color: #FAFAFA;
        width: 150px;
        min-width: 140px;
        padding: 10px 14px !important;
    }
    .day-col {
        min-width: 145px;
        background-color: #ffffff;
    }
    .filled-cell {
        background-color: #EFF6FF;
        border: 1px solid #DBEAFE;
        border-radius: 10px;
        padding: 10px 12px;
        transition: all 0.15s ease;
    }
    .filled-cell:hover {
        background-color: #E0E7FF;
        border-color: #C7D2FE;
    }
    .filled-cell .subject-title {
        font-weight: 700;
        color: #1D4ED8;
        font-size: 12.5px;
        line-height: 1.3;
    }
    .filled-cell .teacher-meta {
        font-size: 11px;
        color: #3B82F6;
        margin-top: 4px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 500;
    }
    .empty-cell {
        border: 1px dashed #E2E8F0;
        border-radius: 10px;
        padding: 14px 10px;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #CBD5E1;
        font-size: 12px;
        background: #FAFBFD;
    }
    .break-cell {
        background-color: #FEF3C7;
        border: 1px solid #FDE68A;
        border-radius: 10px;
        padding: 14px 8px;
        text-align: center;
        font-weight: 800;
        color: #D97706;
        font-size: 11px;
        letter-spacing: 0.8px;
    }

    [data-theme="dark"],
    .light-mode-disabled,
    html[data-theme="dark"],
    html.dark {
        --tt-card-bg: #151D30;
        --tt-inner-bg: #101726;
        --tt-border: #242F4D;
        --tt-text: #F8FAFC;
        --tt-muted: #94A3B8;
    }

    [data-theme="dark"] .tt-content-card,
    .light-mode-disabled .tt-content-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }

    [data-theme="dark"] .tt-content-header,
    .light-mode-disabled .tt-content-header {
        background: #151D30 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .tt-content-header h3,
    .light-mode-disabled .tt-content-header h3 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .tt-content-header span,
    .light-mode-disabled .tt-content-header span {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .grid-table th,
    .light-mode-disabled .grid-table th {
        background-color: #101726 !important;
        color: #94A3B8 !important;
        border-bottom-color: #242F4D !important;
        border-right-color: #242F4D !important;
    }

    [data-theme="dark"] .grid-table td,
    .light-mode-disabled .grid-table td {
        border-bottom-color: #242F4D !important;
        border-right-color: #242F4D !important;
    }

    [data-theme="dark"] .period-col,
    .light-mode-disabled .period-col {
        background-color: #101726 !important;
    }
    [data-theme="dark"] .period-col .period-name,
    .light-mode-disabled .period-col .period-name {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .period-col .period-time,
    .light-mode-disabled .period-col .period-time {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .period-break-badge,
    .light-mode-disabled .period-break-badge {
        background: rgba(245, 158, 11, 0.18) !important;
        color: #FCD34D !important;
    }

    [data-theme="dark"] .day-col,
    .light-mode-disabled .day-col {
        background-color: #151D30 !important;
    }

    [data-theme="dark"] .filled-cell,
    .light-mode-disabled .filled-cell {
        background-color: #101726 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .filled-cell:hover,
    .light-mode-disabled .filled-cell:hover {
        background-color: #1E293B !important;
        border-color: #4F46E5 !important;
    }
    [data-theme="dark"] .filled-cell .subject-title,
    .light-mode-disabled .filled-cell .subject-title {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .filled-cell .teacher-meta,
    .light-mode-disabled .filled-cell .teacher-meta {
        color: #93C5FD !important;
    }

    [data-theme="dark"] .empty-cell,
    .light-mode-disabled .empty-cell {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #64748B !important;
    }

    [data-theme="dark"] .break-cell,
    .light-mode-disabled .break-cell {
        background-color: rgba(245, 158, 11, 0.15) !important;
        border-color: rgba(245, 158, 11, 0.35) !important;
        color: #FCD34D !important;
    }

    [data-theme="dark"] .tt-student-select,
    .light-mode-disabled .tt-student-select {
        background: #101726 !important;
        color: #38bdf8 !important;
        border: 1px solid #242F4D !important;
    }

    [data-theme="dark"] .tt-empty-box,
    .light-mode-disabled .tt-empty-box {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .tt-empty-box h4,
    .light-mode-disabled .tt-empty-box h4 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .tt-empty-box p,
    .light-mode-disabled .tt-empty-box p {
        color: #94A3B8 !important;
    }
</style>
<div class="tt-header-card">
    <div class="tt-header-circle"></div>
    <div class="tt-header-inner">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">Class Timetable</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">
                Weekly class schedule and period timings for <%= active.first_name || 'your child' %> &middot; Class <%= active.class_name || '—' %> (<%= active.section || '' %>)
            </p>
        </div>
        <% if (kids && kids.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <select name="studentId" class="form-select tt-student-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% kids.forEach(child => { %>
                        <option value="<%= child.id %>" <%= active && active.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name || '' %>
                        </option>
                    <% }) %>
                </select>
            </form>
        <% } %>
    </div>
</div>
<div class="ss-card tt-content-card">
    <% if (listPeriods.length === 0 || !hasEntries) { %>
        <div class="tt-empty-box" style="padding: 48px 20px; text-align: center;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 12px auto;">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <h4 style="font-size: 16px; font-weight: 700; color: #1E293B; margin: 0 0 6px 0;">Timetable Not Published Yet</h4>
            <p style="font-size: 13px; color: #64748B; margin: 0; max-width: 360px; margin: 0 auto;">
                The class timetable for <%= active.class_name || 'this class' %> has not been published yet by the administration.
            </p>
        </div>
    <% } else { %>
        <div class="tt-content-header">
            <h3 style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-calendar-week" style="color: #0891B2;"></i> Weekly Schedule
            </h3>
            <span style="font-size: 12px; color: #64748B; font-weight: 500;">
                Class <%= active.class_name || '' %> - <%= active.section || '' %>
            </span>
        </div>
        <div style="overflow-x: auto;">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th class="period-col">Period / Time</th>
                        <% dayNames.forEach(day => { %>
                            <th><%= day %></th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody>
                    <% listPeriods.forEach(period => { %>
                        <tr>
                            <td class="period-col">
                                <div class="period-name" style="font-weight: 700; color: #1E293B; font-size: 12.5px;"><%= period.slot_name || period.label || ('Period ' + period.period_number) %></div>
                                <div class="period-time" style="font-size: 11px; color: #64748B; margin-top: 2px;">
                                    <%= (period.start_time || '').slice(0, 5) %> - <%= (period.end_time || '').slice(0, 5) %>
                                </div>
                                <% if (period.is_break) { %>
                                    <span class="period-break-badge" style="display: inline-block; background: #FEF3C7; color: #D97706; padding: 2px 6px; border-radius: 4px; font-size: 9.5px; font-weight: 700; margin-top: 4px;">Break</span>
                                <% } %>
                            </td>
                            <% dayNames.forEach(day => { %>
                                <td class="day-col">
                                    <% if (period.is_break) { %>
                                        <div class="break-cell">BREAK</div>
                                    <% } else { %>
                                        <% const entry = timetableGrid[day] && timetableGrid[day][period.id]; %>
                                        <% if (entry) { %>
                                            <div class="filled-cell">
                                                <div class="subject-title"><%= entry.subject_name %></div>
                                                <div class="teacher-meta">
                                                    <i class="fas fa-chalkboard-teacher text-[10px]"></i>
                                                    <span><%= entry.teacher_first_name ? (entry.teacher_first_name + ' ' + (entry.teacher_last_name || '')) : 'Staff' %></span>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <div class="empty-cell">
                                                <span>—</span>
                                            </div>
                                        <% } %>
                                    <% } %>
                                </td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>