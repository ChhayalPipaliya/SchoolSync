<!-- Hero Banner -->
<div style="background: linear-gradient(135deg, #0891b2, #075985); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(8,145,178,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">School Notice Board</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">Stay updated with the latest official communications and alerts from SchoolSync</p>
        </div>
        <% if (children && children.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <select name="studentId" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% children.forEach(child => { %>
                        <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name %> (<%= child.class_name %>-<%= child.section %>)
                        </option>
                    <% }) %>
                </select>
            </form>
        <% } %>
    </div>
</div>

<!-- Notices Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
    <% if (notices && notices.length > 0) { %>
        <% notices.forEach((notice, index) => { %>
            <div class="ss-card hover-up" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); position: relative; overflow: hidden; display: flex; flex-direction: column;">
                <div style="position: absolute; top: 12px; right: 12px; color: #ECFEFF; opacity: 0.8; pointer-events: none;">
                    <i class="fas fa-quote-right fa-3x" style="color: #CFFAFE;"></i>
                </div>
                
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px; z-index: 1;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                        <i class="fas fa-info-circle"></i>
                    </div>
                    <div>
                        <h2 style="font-size: 15px; font-weight: 700; color: #1e293b; margin: 0 0 4px 0;"><%= notice.title %></h2>
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <span style="font-size: 11px; color: #64748b;">
                                <i class="fas fa-calendar-alt" style="margin-right: 4px;"></i> <%= new Date(notice.created_at).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %>
                            </span>
                            <span style="color: #cbd5e1; font-size: 11px;">•</span>
                            <span style="font-size: 11px; color: #0891B2; font-weight: 600;">
                                <i class="fas fa-user-edit" style="margin-right: 4px;"></i> <%= notice.author_name || 'Administrator' %>
                            </span>
                        </div>
                    </div>
                </div>
                
                <div style="border-top: 1px solid #F1F5F9; padding-top: 16px; z-index: 1; flex-grow: 1;">
                    <p style="font-size: 13px; color: #475569; margin: 0; line-height: 1.6; white-space: pre-line;"><%= notice.message %></p>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="ss-card" style="grid-column: 1 / -1; padding: 48px; text-align: center; background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="color: #94A3B8; margin-bottom: 16px;"><i class="fas fa-bullhorn fa-4x"></i></div>
            <h5 style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">Notice Board Empty</h5>
            <p style="font-size: 13px; color: #64748b; margin: 0;">No announcements or bulletins have been posted recently.</p>
        </div>
    <% } %>
</div>

<style>
    .hover-up { transition: transform 0.2s; }
    .hover-up:hover { transform: translateY(-4px); }
</style>
