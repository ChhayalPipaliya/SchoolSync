<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', {
    title: typeof title !== 'undefined' ? title + ' | SchoolSync' : 'Parent Portal | SchoolSync',
    needsCharts: typeof needsCharts !== 'undefined' ? needsCharts : false
  }) %>
</head>
<body class="parent-theme">
<div class="app-wrapper">

  <%- include('../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>

  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header') %>

    <%- include('../partials/flashMessages') %>

    <div class="page-body">
      <%- body %>
    </div>

    <%- include('../partials/footer') %>
  </main>
</div>
</body>
</html>
