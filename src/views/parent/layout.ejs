<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <%- include('../partials/head', {
    title: typeof title !== 'undefined' ? title + ' | ' + (lan && lan.Parent_Portal ? lan.Parent_Portal : 'Parent Portal') : (lan && lan.Parent_Portal ? lan.Parent_Portal : 'Parent Portal'),
    needsCharts: typeof needsCharts !== 'undefined' ? needsCharts : false
  }) %>
</head>
<body class="parent-theme">
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header') %>
    <%- include('../partials/flashMessages') %>
    <div class="page-body">
      <%- body %>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>
</body>
</html>