<style>
    .ptm-container {
        font-family: 'Inter', system-ui, sans-serif;
        color: #1e293b;
    }
    .ptm-header {
        background: linear-gradient(135deg, #0891b2, #0e7490);
        border-radius: 16px;
        padding: 28px;
        color: #fff;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(8, 145, 178, 0.2);
    }
    .ptm-header::after {
        content: '';
        position: absolute;
        right: -50px;
        top: -50px;
        width: 180px;
        height: 180px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
    }
    .ptm-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 24px;
    }
    @media (max-width: 1024px) {
        .ptm-grid {
            grid-template-columns: 1fr;
        }
    }
    .ptm-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        padding: 24px;
        margin-bottom: 24px;
    }
    .ptm-card-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .ptm-card-title i {
        color: #0891b2;
    }
    .booking-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fbfdff;
        transition: all 0.2s ease;
    }
    .booking-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        border-color: #cbd5e1;
    }
    .booking-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }
    .date-pill {
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
    }
    .date-pill.active {
        background: #0891b2;
        color: #fff;
        border-color: #0891b2;
    }
    .slot-pill {
        padding: 10px 14px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #1e293b;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
    }
    .slot-pill.active {
        background: #0891b2;
        color: #fff;
        border-color: #0891b2;
        box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.2);
    }
    .slot-pill:hover:not(.active) {
        background: #f1f5f9;
        border-color: #94a3b8;
    }
    .form-group {
        margin-bottom: 18px;
    }
    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }
    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        background: #fff;
        transition: border 0.2s;
    }
    .form-control:focus {
        border-color: #0891b2;
        box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.1);
    }
    .ptm-btn-primary {
        background: #0891b2;
        color: #fff;
        border: 1px solid #0891b2;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        justify-content: center;
        transition: all 0.2s ease;
    }
    .ptm-btn-primary:hover:not(:disabled) {
        background: #0e7490;
        border-color: #0e7490;
        transform: translateY(-2px);
    }
    .ptm-btn-primary:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .empty-state {
        text-align: center;
        padding: 30px 20px;
        color: #94a3b8;
    }
    .empty-state i {
        font-size: 36px;
        margin-bottom: 12px;
        color: #cbd5e1;
    }
</style>
<div class="ptm-container">
    <div class="ptm-header">
        <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;"><%- lan.PTM_Scheduler %></h1>
        <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;"><%- lan.PTM_Scheduler_Subtitle %></p>
    </div>
    <%- include('../../partials/flashMessages') %>
    <div class="ptm-grid">
        <div>
            <div class="ptm-card">
                <div class="ptm-card-title">
                    <i class="fas fa-calendar-check"></i> <%- lan.My_Scheduled_Meetings %>
                </div>
                <% if (bookings.length > 0) { %>
                    <% bookings.forEach(b => { %>
                        <div class="booking-card">
                            <div style="display: flex; gap: 16px; align-items: flex-start;">
                                <div style="background: rgba(8, 145, 178, 0.1); color: #0891b2; border-radius: 8px; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                                    <i class="fas fa-handshake"></i>
                                </div>
                                <div>
                                    <div style="font-weight: 700; font-size: 15px; color: #0f172a;"><%= b.teacher_name %></div>
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;"><%- lan.Subject %>: <%= b.subject_name || lan.Class_Teacher %> &middot; <%- lan.Child %>: <strong><%= b.student_name %></strong></div>
                                    <div style="font-size: 13px; color: #475569; font-weight: 600; margin-top: 8px; display: flex; align-items: center; gap: 6px;">
                                        <i class="far fa-calendar-alt" style="color: #0891b2;"></i> <%= b.formatted_date %>
                                        <span style="color: #cbd5e1;">|</span>
                                        <i class="far fa-clock" style="color: #0891b2;"></i> <%= b.formatted_start_time %> - <%= b.formatted_end_time %>
                                    </div>
                                    <% if (b.notes) { %>
                                        <div style="font-size: 11px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 6px 10px; margin-top: 8px; color: #475569;">
                                            <strong><%- lan.My_Note %>:</strong> <%= b.notes %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 12px;">
                                <span class="booking-badge"><%- lan.Scheduled %></span>
                                <form method="POST" action="/parent/ptm/bookings/cancel/<%= b.id %>" onsubmit="return confirm('<%= lan.Confirm_Cancel_PTM_Booking %>');">
                                    <button type="submit" style="background: none; border: none; color: #ef4444; font-size: 12px; font-weight: 700; cursor: pointer; padding: 0;">
                                        <%- lan.Cancel %>
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state">
                        <i class="far fa-calendar-times"></i>
                        <p><%- lan.No_Upcoming_PTM_Booked %></p>
                    </div>
                <% } %>
            </div>
        </div>
        <div>
            <div class="ptm-card">
                <div class="ptm-card-title">
                    <i class="fas fa-plus-circle"></i> <%- lan.Book_A_New_PTM %>
                </div>
                <form id="ptmBookForm" method="POST" action="/parent/ptm/book">
                    <div class="form-group">
                        <label for="studentSelect"><%- lan.Select_Child %></label>
                        <select name="studentId" id="studentSelect" class="form-control" required onchange="onStudentChange(this.value)">
                            <% children.forEach(child => { %>
                                <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>><%= child.first_name %> <%= child.last_name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="teacherSelect"><%- lan.Select_Teacher %></label>
                        <select name="teacherId" id="teacherSelect" class="form-control" required onchange="onTeacherChange(this.value)" disabled>
                            <option value=""><%- lan.Choose_Child_First %></option>
                        </select>
                    </div>
                    <div class="form-group" id="dateSection" style="display: none;">
                        <label><%- lan.Available_Dates %></label>
                        <div id="datesContainer" style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px;"></div>
                    </div>
                    <div class="form-group" id="slotsSection" style="display: none;">
                        <label><%- lan.Available_Time_Slots %></label>
                        <div id="slotsContainer" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 8px; margin-top: 4px;"></div>
                        <input type="hidden" name="slotId" id="selectedSlotId" required>
                    </div>
                    <div class="form-group" id="notesSection" style="display: none;">
                        <label for="notes"><%- lan.Notes_For_Teacher_Optional %></label>
                        <textarea name="notes" id="notes" class="form-control" rows="3" placeholder="<%= lan.PTM_Notes_Placeholder %>"></textarea>
                    </div>
                    <button type="submit" class="ptm-btn-primary" id="btnBook" disabled style="margin-top: 10px;">
                        <%- lan.Confirm_PTM_Booking %>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    let ptmSlotsData = {};

    document.addEventListener("DOMContentLoaded", () => {
        const studentId = document.getElementById('studentSelect').value;
        if (studentId) {
            onStudentChange(studentId);
        };
    });

    async function onStudentChange(studentId) {
        const teacherSelect = document.getElementById('teacherSelect');
        teacherSelect.disabled = true;
        teacherSelect.innerHTML = '<option value=""><%= lan.Loading_Teachers %></option>';
        
        resetBookingFields();

        try {
            const res = await fetch(`/parent/ptm/api/teachers?studentId=${studentId}`);
            const data = await res.json();
            
            if (data.success && data.teachers.length > 0) {
                let options = '<option value=""><%= lan.Select_A_Teacher %></option>';
                data.teachers.forEach(t => {
                    options += `<option value="${t.teacher_id}">${t.name} (${t.subject_name || '<%= lan.Class_Teacher %>'})</option>`;
                });
                teacherSelect.innerHTML = options;
                teacherSelect.disabled = false;
            } else {
                teacherSelect.innerHTML = '<option value=""><%= lan.No_Teachers_Found_For_Student %></option>';
            };
        } catch (err) {
            console.error(err);
            teacherSelect.innerHTML = '<option value=""><%= lan.Error_Loading_Teachers %></option>';
        };
    };

    async function onTeacherChange(teacherId) {
        resetBookingFields();
        if (!teacherId) return;

        try {
            const res = await fetch(`/parent/ptm/api/slots?teacherId=${teacherId}`);
            const data = await res.json();
            
            if (data.success && Object.keys(data.slots).length > 0) {
                ptmSlotsData = data.slots;
                renderDates();
                document.getElementById('dateSection').style.display = 'block';
            } else {
                alert('<%= lan.No_PTM_Slots_Configured %>');
            };
        } catch (err) {
            console.error(err);
            alert('<%= lan.Failed_To_Load_PTM_Slots %>');
        };
    };

    function renderDates() {
        const container = document.getElementById('datesContainer');
        container.innerHTML = '';
        
        Object.keys(ptmSlotsData).forEach(dateStr => {
            const pill = document.createElement('div');
            pill.className = 'date-pill';
            pill.textContent = dateStr;
            pill.onclick = () => selectDate(dateStr, pill);
            container.appendChild(pill);
        });
    };

    function selectDate(dateStr, element) {
        document.querySelectorAll('.date-pill').forEach(el => el.classList.remove('active'));
        element.classList.add('active');

        document.getElementById('selectedSlotId').value = '';
        document.getElementById('btnBook').disabled = true;
        
        const container = document.getElementById('slotsContainer');
        container.innerHTML = '';

        const slots = ptmSlotsData[dateStr] || [];
        slots.forEach(slot => {
            const pill = document.createElement('div');
            pill.className = 'slot-pill';
            pill.textContent = slot.time;
            pill.onclick = () => selectSlot(slot.id, pill);
            container.appendChild(pill);
        });

        document.getElementById('slotsSection').style.display = 'block';
        document.getElementById('notesSection').style.display = 'block';
    };

    function selectSlot(slotId, element) {
        document.querySelectorAll('.slot-pill').forEach(el => el.classList.remove('active'));
        element.classList.add('active');

        document.getElementById('selectedSlotId').value = slotId;
        document.getElementById('btnBook').disabled = false;
    };

    function resetBookingFields() {
        ptmSlotsData = {};
        document.getElementById('dateSection').style.display = 'none';
        document.getElementById('slotsSection').style.display = 'none';
        document.getElementById('notesSection').style.display = 'none';
        document.getElementById('selectedSlotId').value = '';
        document.getElementById('btnBook').disabled = true;
        document.getElementById('datesContainer').innerHTML = '';
        document.getElementById('slotsContainer').innerHTML = '';
        document.getElementById('notes').value = '';
    };
</script>