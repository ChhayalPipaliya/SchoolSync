    }
    [data-theme="dark"] .lib-stat-lbl,
    .light-mode-disabled .lib-stat-lbl {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .lib-stat-val,
    .light-mode-disabled .lib-stat-val {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .lib-stat-icon.cyan,
    .light-mode-disabled .lib-stat-icon.cyan {
        background: rgba(8, 145, 178, 0.15) !important;
        color: #38bdf8 !important;
    }
    [data-theme="dark"] .lib-stat-icon.rose,
    .light-mode-disabled .lib-stat-icon.rose {
        background: rgba(225, 29, 72, 0.15) !important;
