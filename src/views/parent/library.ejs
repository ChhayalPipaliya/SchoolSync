    }

    [data-theme="dark"] .lib-content-card,
    .light-mode-disabled .lib-content-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .lib-content-header,
    .light-mode-disabled .lib-content-header {
        background: #151D30 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .lib-content-header h3,
    .light-mode-disabled .lib-content-header h3 {
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .student-book-card,
    .light-mode-disabled .student-book-card {
        background: #101726 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .book-cover-wrapper,
    .light-mode-disabled .book-cover-wrapper {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .student-book-card h4,
    .light-mode-disabled .student-book-card h4 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .student-book-card p,
    .light-mode-disabled .student-book-card p {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .library-info-row span.font-bold,
    .light-mode-disabled .library-info-row span.font-bold {
        color: #CBD5E1 !important;
    }
    [data-theme="dark"] .student-book-card .border-t,
    .light-mode-disabled .student-book-card .border-t {
        border-top-color: #242F4D !important;
    }

    [data-theme="dark"] .lib-student-select,
    .light-mode-disabled .lib-student-select {
        background: #101726 !important;
        color: #38bdf8 !important;
        border: 1px solid #242F4D !important;
    }

    @media (max-width: 640px) {
        .lib-header-card {
            padding: 18px 16px !important;
            border-radius: 14px !important;
            margin-bottom: 12px !important;
        }
        .lib-header-card h1 {
            font-size: 20px !important;
        }
        .lib-header-card p {
            font-size: 12px !important;
        }
        .lib-stats-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
            margin-bottom: 12px !important;
        }
        .lib-stats-grid > div:last-child {
            grid-column: span 2 !important;
        }
        .lib-stat-card {
            padding: 12px 14px !important;
            border-radius: 12px !important;
            gap: 12px !important;
        }
        .lib-stat-icon {
            width: 40px !important;
            height: 40px !important;
            font-size: 16px !important;
            border-radius: 10px !important;
        }
        .lib-stat-lbl {
            font-size: 10px !important;
        }
        .lib-stat-val {
            font-size: 18px !important;
        }
        .library-book-grid {
            grid-template-columns: 1fr !important;
            padding: 12px !important;
            gap: 10px !important;
        }
        .lib-empty-box {
            padding: 36px 16px !important;
        }
    }

    [data-theme="dark"] .lib-empty-box,
    .light-mode-disabled .lib-empty-box {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .lib-empty-box h4,
    .light-mode-disabled .lib-empty-box h4 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .lib-empty-box p,
    .light-mode-disabled .lib-empty-box p {
        color: #94A3B8 !important;
    }
</style>
<div class="lib-header-card">
    <div class="lib-header-circle"></div>
    <div class="lib-header-inner">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;"><%- lan.Library_Records %></h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">
                <%- lan.Library_Subtitle %> <%= active.first_name || lan.Your_Child %> &middot; <%- lan.Class %> <%= active.class_name || '—' %> (<%= active.section || '' %>)
            </p>
        </div>
        <% if (kids && kids.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <select name="studentId" class="form-select lib-student-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% kids.forEach(child => { %>
                        <option value="<%= child.id %>" <%= active && active.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name || '' %>
                        </option>
                    <% }) %>
                </select>
            </form>
        <% } %>
    </div>
</div>
<div class="lib-stats-grid">
    <div class="ss-card lib-stat-card">
        <div class="lib-stat-icon cyan">
            <i class="fas fa-book-reader"></i>
        </div>
        <div>
            <div class="lib-stat-lbl"><%- lan.Total_Borrowed %></div>
            <div class="lib-stat-val"><%= countTotalIssued %></div>
        </div>
    </div>
    <div class="ss-card lib-stat-card">
        <div class="lib-stat-icon rose">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div>
            <div class="lib-stat-lbl"><%- lan.Overdue_Books %></div>
            <div class="lib-stat-val" style="color: #E11D48;"><%= countOverdue %></div>
        </div>
    </div>
    <div class="ss-card lib-stat-card">
        <div class="lib-stat-icon amber">
            <i class="fas fa-indian-rupee-sign"></i>
        </div>
        <div>
            <div class="lib-stat-lbl"><%- lan.Total_Fines %></div>
            <div class="lib-stat-val" style="color: #D97706;">₹<%= totalFines.toFixed(2) %></div>
        </div>
    </div>
</div>
<div class="ss-card lib-content-card">
    <div class="lib-content-header">
        <h3 style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-book-bookmark" style="color: #0891B2;"></i> <%- lan.Borrowed_Book_Records %>
        </h3>
    </div>
    <% if (listIssues.length > 0) { %>
        <div class="library-book-grid">
            <% listIssues.forEach(issue => { %>
                <%
                    const dueDate = new Date(issue.due_date);
                    const isReturned = !!issue.return_date;
                    const isOverdue = !isReturned && dueDate < now;
                    const diffTime = dueDate.getTime() - now.getTime();
                    const diffDays = Math.ceil(diffTime / (1000 * 3600 * 24));
                    const isDueSoon = !isReturned && !isOverdue && diffDays <= 3;
                    const borderClass = isOverdue ? 'border-overdue' : (isDueSoon ? 'border-duesoon' : 'border-normal');
                %>
                <div class="student-book-card <%= borderClass %>">
                    <div class="book-cover-wrapper">
                        <i class="fas fa-book text-slate-400 text-2xl"></i>
                    </div>
                    <div class="book-detail-wrapper">
                        <div>
                            <h4 class="text-xs font-bold text-slate-800 m-0 truncate" title="<%= issue.title %>"><%= issue.title %></h4>
                            <p class="text-[11px] text-slate-500 m-0 mt-0.5"><%= issue.author || lan.Author_NA %></p>
                        </div>
                        <div class="mt-3 pt-2 border-t border-dashed border-slate-200 text-xs">
                            <div class="library-info-row">
                                <span><i class="far fa-calendar-alt"></i> <%- lan.Issued %>:</span>
                                <span class="font-bold text-slate-700"><%= fmtDate(issue.issue_date) %></span>
                            </div>
                            <div class="library-info-row">
                                <span><i class="far fa-calendar-times"></i> <%- lan.Due %>:</span>
                                <span class="font-bold <%= isOverdue ? 'text-rose-600' : (isDueSoon ? 'text-amber-600' : 'text-slate-700') %>"><%= fmtDate(issue.due_date) %></span>
                            </div>
                            <% if (isOverdue) { %>
                                <div class="mt-2 px-2 py-1 rounded bg-rose-50 border border-rose-200 text-rose-600 text-[10px] font-bold flex items-center gap-1">
                                    <i class="fas fa-exclamation-circle"></i> <%- lan.Overdue_Record %>
                                </div>
                            <% } else if (isDueSoon) { %>
                                <div class="mt-2 px-2 py-1 rounded bg-amber-50 border border-amber-200 text-amber-700 text-[10px] font-bold flex items-center gap-1">
                                    <i class="fas fa-clock"></i> <%- lan.Due_Soon %> (<%= diffDays %> <%= diffDays === 1 ? lan.Day : lan.Days %>)
                                </div>
                            <% } else if (isReturned) { %>
                                <div class="mt-2 px-2 py-1 rounded bg-emerald-50 border border-emerald-200 text-emerald-600 text-[10px] font-bold flex items-center gap-1">
                                    <i class="fas fa-check-circle"></i> <%- lan.Returned_On %> <%= fmtDate(issue.return_date) %>
                                </div>
                            <% } %>
                            <% if (issue.fine_amount > 0) { %>
                                <div class="library-info-row mt-1 text-amber-600 font-bold">
                                    <span><%- lan.Fine %>:</span>
                                    <span>₹<%= Number(issue.fine_amount).toFixed(2) %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="lib-empty-box" style="padding: 48px 20px; text-align: center;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 12px auto;">
                <i class="fas fa-book-open"></i>
            </div>
            <h4 style="font-size: 16px; font-weight: 700; color: #1E293B; margin: 0 0 6px 0;"><%- lan.No_Books_Borrowed %></h4>
            <p style="font-size: 13px; color: #64748B; margin: 0; max-width: 360px; margin: 0 auto;">
                <%- lan.No_Books_Borrowed_Desc %> <%= active.first_name || lan.Your_Child %>.
            </p>
        </div>
    <% } %>
</div>