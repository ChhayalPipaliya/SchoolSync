<%
    const listIssues = typeof issues !== 'undefined' && issues ? issues : [];
    const kids = typeof children !== 'undefined' && children ? children : [];
    const active = typeof activeChild !== 'undefined' && activeChild ? activeChild : (kids[0] || {});
    const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
    const now = new Date();

    let countTotalIssued = listIssues.length;
    let countOverdue = 0;
    let totalFines = 0;

    listIssues.forEach(item => {
        const dueDate = new Date(item.due_date);
        const isOverdue = !item.return_date && dueDate < now;
        if (isOverdue) countOverdue++;
        if (item.fine_amount) totalFines += Number(item.fine_amount);
    });
%>

<style>
    .lib-header-card {
        background: linear-gradient(135deg, #0891b2, #075985);
        border-radius: 12px;
        padding: 10px;
        color: #ffffff;
        margin-bottom: 10px;
        position: relative;
        overflow: hidden;
    }
    .lib-header-circle {
        position: absolute;
        right: -30px;
        top: -30px;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
    }
    .lib-header-inner {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }
    .lib-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 10px;
    }
    .lib-stat-card {
        background: #ffffff;
        padding: 10px;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .lib-stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }
    .lib-stat-icon.cyan {
        background: #ECFEFF;
        color: #0891B2;
    }
    .lib-stat-icon.rose {
        background: #FFE4E6;
        color: #E11D48;
    }
    .lib-stat-icon.amber {
        background: #FEF3C7;
        color: #D97706;
    }
    .lib-stat-lbl {
        font-size: 11px;
        text-transform: uppercase;
        color: #64748B;
        font-weight: 700;
        margin: 0 0 2px 0;
        letter-spacing: 0.5px;
    }
    .lib-stat-val {
        font-size: 22px;
        font-weight: 800;
        color: #0F172A;
    }
    .lib-content-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
        margin-bottom: 10px;
    }
    .lib-content-header {
        padding: 10px;
        border-bottom: 1px solid #F1F5F9;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .library-book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
        padding: 20px;
    }
    .student-book-card {
        border-radius: 12px;
        padding: 16px;
        background: #ffffff;
        border: 1px solid #E2E8F0;
        display: flex;
        gap: 16px;
        transition: all 0.2s ease;
    }
    .student-book-card.border-overdue {
        border-left: 4px solid #EF4444;
    }
    .student-book-card.border-duesoon {
        border-left: 4px solid #F59E0B;
    }
    .student-book-card.border-normal {
        border-left: 4px solid #10B981;
    }
    .student-book-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.05);
    }
    .book-cover-wrapper {
        width: 68px;
        height: 94px;
        background: #F8FAFC;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #E2E8F0;
    }
    .book-detail-wrapper {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .library-info-row {
        display: flex;
        justify-content: space-between;
        font-size: 11.5px;
        color: #64748B;
        margin-bottom: 4px;
    }

    [data-theme="dark"],
    .light-mode-disabled,
    html[data-theme="dark"],
    html.dark {
        --lib-card-bg: #151D30;
        --lib-inner-bg: #101726;
        --lib-border: #242F4D;
        --lib-text: #F8FAFC;
