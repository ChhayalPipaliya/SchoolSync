<section class="card">
    <h1>Library Records — <%= activeChild.first_name %></h1>
    <% if (!issues.length) { %>
        <p>No library records found.</p>
    <% } else { %>
        <table class="table-no-min-width">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Issued</th>
                    <th>Due</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% issues.forEach(issue => { %>
                    <tr> 
                        <td><%= issue.title %> — <%= issue.author || '' %></td>
                        <td><%= issue.issue_date %></td>
                        <td><%= issue.due_date %></td>
                        <td><%= issue.status %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</section>