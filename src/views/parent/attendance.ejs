<div style="background: linear-gradient(135deg, #0891b2, #075985); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(8,145,178,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">Attendance History</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">Monthly attendance log for <%= activeChild.first_name %> <%= activeChild.last_name %></p>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 0;">
            <% if (children && children.length > 1) { %>
                <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                    <select name="studentId" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                        <% children.forEach(child => { %>
                            <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                                <%= child.first_name %> <%= child.last_name %>
                            </option>
                        <% }) %>
                    </select>
                    <input type="hidden" name="month" value="<%= selectedMonth %>">
                    <input type="hidden" name="year" value="<%= selectedYear %>">
                </form>
            <% } %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <input type="hidden" name="studentId" value="<%= activeChild.id %>">
                <select name="month" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% for(let i=1; i<=12; i++) { %>
                        <option value="<%= i %>" <%= selectedMonth === i ? 'selected' : '' %>>
                            <%= new Date(2000, i-1, 1).toLocaleString('default', { month: 'long' }) %>
                        </option>
                    <% } %>
                </select>
                <select name="year" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% for(let y = new Date().getFullYear(); y >= new Date().getFullYear()-2; y--) { %>
                        <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                </select>
            </form>
        </div>
    </div>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #E6F4EA; color: #137333; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-check"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Present</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.presentDays %></span>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-times"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Absent</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.absentDays %></span>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-clock"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Late</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.lateDays %></span>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-percentage"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Percentage</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.percentage %>%</span>
        </div>
    </div>
</div>
<div class="ss-card" style="background: #fff; padding: 24px; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 24px;">
    <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 20px 0;">
        <%= new Date(selectedYear, selectedMonth-1, 1).toLocaleString('default', { month: 'long', year: 'numeric' }) %>
    </h2>
    <div style="display: flex; flex-direction: column; gap: 8px;">
        <div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-weight: 700; color: #64748b; font-size: 13px; margin-bottom: 8px;">
            <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; text-align: center;">
            <% 
                const firstDay = new Date(selectedYear, selectedMonth-1, 1).getDay();
                for(let i=0; i<firstDay; i++) { %>
                <div style="height: 60px; border-radius: 12px; background: #F8FAFC; border: 1px dashed #E2E8F0;"></div>
            <% } %>
            <% calendarDays.forEach(day => { %>
                <div class="calendar-day style-<%= day.status %>" 
                     title="<%= day.remark || day.status %>"
                     style="height: 60px; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8px; position: relative;">
                    <span style="font-size: 14px; font-weight: 700; color: #1e293b; margin-bottom: 4px;"><%= day.day %></span>
                    <% if(day.status === 'present') { %><i class="fas fa-check text-success" style="font-size: 11px;"></i>
                    <% } else if(day.status === 'absent') { %><i class="fas fa-times text-danger" style="font-size: 11px;"></i>
                    <% } else if(day.status === 'late') { %><i class="fas fa-clock text-warning" style="font-size: 11px;"></i>
                    <% } else if(day.status === 'leave') { %><i class="fas fa-plane-departure text-primary" style="font-size: 11px;"></i>
                    <% } else if(day.status === 'holiday') { %><i class="fas fa-umbrella-beach text-muted" style="font-size: 11px;"></i>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>
    <div style="border-top: 1px solid #F1F5F9; margin-top: 24px; padding-top: 16px; display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; font-size: 12px; font-weight: 600; color: #475569;">
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-check text-success"></i> Present</span>
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-times text-danger"></i> Absent</span>
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-clock text-warning"></i> Late</span>
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-adjust text-info"></i> Half Day</span>
        <span style="display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-umbrella-beach text-muted"></i> Holiday</span>
    </div>
</div>
<style>
    .bg-success-light { background-color: rgba(16, 185, 129, 0.1); }
    .bg-danger-light { background-color: rgba(244, 63, 94, 0.1); }
    .bg-warning-light { background-color: rgba(245, 158, 11, 0.1); }
    .bg-indigo-light { background-color: rgba(99, 102, 241, 0.1); }
    .text-indigo { color: #6366F1 !important; }
    .style-present { background-color: rgba(16, 185, 129, 0.08) !important; border: 1px solid rgba(16, 185, 129, 0.15) !important; }
    .style-absent { background-color: rgba(244, 63, 94, 0.08) !important; border: 1px solid rgba(244, 63, 94, 0.15) !important; }
    .style-late { background-color: rgba(245, 158, 11, 0.08) !important; border: 1px solid rgba(245, 158, 11, 0.15) !important; }
    .style-half_day { background-color: rgba(6, 182, 212, 0.08) !important; border: 1px solid rgba(6, 182, 212, 0.15) !important; }
    .style-holiday { background-color: rgba(100, 116, 139, 0.08) !important; border: 1px solid rgba(100, 116, 139, 0.15) !important; }
    .style-not_marked { background-color: #F8FAFC !important; border: 1px solid #E2E8F0 !important; }
</style>