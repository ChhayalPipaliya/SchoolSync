<style>
    .att-parent-wrapper {
        animation: fadeIn 0.35s ease-out;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .att-parent-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 10px;
    }
    .att-filter-select {
        background: #ffffff;
        border: 1.5px solid #E2E8F0;
        color: #0F172A;
        font-weight: 600;
        padding: 8px 14px;
        font-size: 13px;
        border-radius: 10px;
        outline: none;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .att-filter-select:focus, .att-filter-select:hover {
        border-color: #0D9488;
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.12);
    }
    .att-stat-card {
        background: #ffffff;
        padding: 18px 20px;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .att-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px -4px rgba(13, 148, 136, 0.1);
    }
    .att-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }
    .att-grid-header {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-weight: 700;
        color: #64748B;
        font-size: 11.5px;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        margin-bottom: 10px;
        padding: 4px 0;
    }
    .att-grid-body {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 10px;
    }
    .att-day-card {
        min-height: 70px;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 8px 6px;
        position: relative;
        transition: all 0.2s ease;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    }
    .att-day-card:hover {
        transform: scale(1.04);
        z-index: 3;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
    }
    .att-day-number {
        font-size: 14px;
        font-weight: 800;
        color: #0F172A;
        line-height: 1;
    }
    .att-day-status-label {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 999px;
        line-height: 1.2;
    }

    .att-day-card.status-present {
        background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
        border: 1.5px solid #10B981;
    }
    .att-day-card.status-present .att-day-number { color: #065F46; }
    .att-day-card.status-present .att-day-status-label { background: #10B981; color: #ffffff; }

    .att-day-card.status-absent {
        background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
        border: 1.5px solid #EF4444;
    }
    .att-day-card.status-absent .att-day-number { color: #991B1B; }
    .att-day-card.status-absent .att-day-status-label { background: #EF4444; color: #ffffff; }

    .att-day-card.status-late {
        background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
        border: 1.5px solid #F59E0B;
    }
    .att-day-card.status-late .att-day-number { color: #92400E; }
    .att-day-card.status-late .att-day-status-label { background: #F59E0B; color: #ffffff; }

    .att-day-card.status-half_day, .att-day-card.status-half-day {
        background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
        border: 1.5px solid #6366F1;
    }
    .att-day-card.status-half_day .att-day-number { color: #3730A3; }
    .att-day-card.status-half_day .att-day-status-label { background: #6366F1; color: #ffffff; }

    .att-day-card.status-leave {
        background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
        border: 1.5px solid #22C55E;
    }
    .att-day-card.status-leave .att-day-number { color: #14532D; }
    .att-day-card.status-leave .att-day-status-label { background: #22C55E; color: #ffffff; }

    .att-day-card.status-holiday {
        background: #F8FAFC;
        border: 1.5px solid #E2E8F0;
    }
    .att-day-card.status-holiday .att-day-number { color: #64748B; }
    .att-day-card.status-holiday .att-day-status-label { background: #E2E8F0; color: #475569; }

    .att-day-card.status-not_marked {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
    }
    .att-day-card.status-not_marked .att-day-number { color: #94A3B8; }

    [data-theme="dark"],
    .light-mode-disabled,
    html[data-theme="dark"],
    html.dark {
        --att-bg: #0B0F19;
        --att-card: #151D30;
        --att-inner: #101726;
        --att-border: #242F4D;
        --att-text: #F8FAFC;
        --att-muted: #94A3B8;
    }

    [data-theme="dark"] .att-parent-header h2,
    .light-mode-disabled .att-parent-header h2 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .att-parent-header p,
    .light-mode-disabled .att-parent-header p {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .att-parent-header p strong,
    .light-mode-disabled .att-parent-header p strong {
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .att-filter-select,
    .light-mode-disabled .att-filter-select {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .att-stat-card,
    .light-mode-disabled .att-stat-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .att-stat-lbl,
    .light-mode-disabled .att-stat-lbl {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .att-stat-val,
    .light-mode-disabled .att-stat-val {
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .att-cal-panel,
    .light-mode-disabled .att-cal-panel {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .att-cal-title,
    .light-mode-disabled .att-cal-title {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .att-cal-header-border,
    .light-mode-disabled .att-cal-header-border {
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .att-total-logged-badge,
    .light-mode-disabled .att-total-logged-badge {
        background: rgba(13, 148, 136, 0.15) !important;
        border-color: rgba(13, 148, 136, 0.35) !important;
        color: #2dd4bf !important;
    }

    [data-theme="dark"] .att-grid-header,
    .light-mode-disabled .att-grid-header {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .att-empty-slot,
    .light-mode-disabled .att-empty-slot {
        background: #101726 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .att-day-card.status-present,
    .light-mode-disabled .att-day-card.status-present {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(5, 150, 105, 0.25) 100%) !important;
        border: 1.5px solid #10B981 !important;
    }
    [data-theme="dark"] .att-day-card.status-present .att-day-number,
    .light-mode-disabled .att-day-card.status-present .att-day-number {
        color: #6ee7b7 !important;
    }

    [data-theme="dark"] .att-day-card.status-absent,
    .light-mode-disabled .att-day-card.status-absent {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.15) 0%, rgba(220, 38, 38, 0.25) 100%) !important;
        border: 1.5px solid #EF4444 !important;
    }
    [data-theme="dark"] .att-day-card.status-absent .att-day-number,
    .light-mode-disabled .att-day-card.status-absent .att-day-number {
        color: #fca5a5 !important;
    }

    [data-theme="dark"] .att-day-card.status-late,
    .light-mode-disabled .att-day-card.status-late {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.25) 100%) !important;
        border: 1.5px solid #F59E0B !important;
    }
    [data-theme="dark"] .att-day-card.status-late .att-day-number,
    .light-mode-disabled .att-day-card.status-late .att-day-number {
        color: #fcd34d !important;
    }

    [data-theme="dark"] .att-day-card.status-half_day,
    [data-theme="dark"] .att-day-card.status-half-day,
    .light-mode-disabled .att-day-card.status-half_day,
    .light-mode-disabled .att-day-card.status-half-day {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(79, 70, 229, 0.25) 100%) !important;
        border: 1.5px solid #6366F1 !important;
    }
    [data-theme="dark"] .att-day-card.status-half_day .att-day-number,
    [data-theme="dark"] .att-day-card.status-half-day .att-day-number,
    .light-mode-disabled .att-day-card.status-half_day .att-day-number,
    .light-mode-disabled .att-day-card.status-half-day .att-day-number {
        color: #a5b4fc !important;
    }

    [data-theme="dark"] .att-day-card.status-leave,
    .light-mode-disabled .att-day-card.status-leave {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.15) 0%, rgba(22, 163, 74, 0.25) 100%) !important;
        border: 1.5px solid #22C55E !important;
    }
    [data-theme="dark"] .att-day-card.status-leave .att-day-number,
    .light-mode-disabled .att-day-card.status-leave .att-day-number {
        color: #86efac !important;
    }

    [data-theme="dark"] .att-day-card.status-holiday,
    .light-mode-disabled .att-day-card.status-holiday {
        background: #101726 !important;
        border: 1.5px solid #242F4D !important;
    }
    [data-theme="dark"] .att-day-card.status-holiday .att-day-number,
    .light-mode-disabled .att-day-card.status-holiday .att-day-number {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .att-day-card.status-holiday .att-day-status-label,
    .light-mode-disabled .att-day-card.status-holiday .att-day-status-label {
        background: #1E293B !important;
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .att-day-card.status-not_marked,
    .light-mode-disabled .att-day-card.status-not_marked {
        background: #101726 !important;
        border: 1px solid #242F4D !important;
    }
    [data-theme="dark"] .att-day-card.status-not_marked .att-day-number,
    .light-mode-disabled .att-day-card.status-not_marked .att-day-number {
        color: #64748B !important;
    }

    [data-theme="dark"] .att-legend-bar,
    .light-mode-disabled .att-legend-bar {
        border-top-color: #242F4D !important;
    }
    [data-theme="dark"] .att-legend-holiday,
    .light-mode-disabled .att-legend-holiday {
        background: #101726 !important;
        color: #94A3B8 !important;
        border-color: #242F4D !important;
    }

    .att-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 1rem;
    }
    @media (max-width: 1024px) {
        .att-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .att-parent-header {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 10px !important;
            margin-bottom: 12px !important;
        }
        .att-filter-container {
            width: 100% !important;
            display: flex !important;
            flex-direction: column !important;
            gap: 8px !important;
        }
        .att-filter-form {
            width: 100% !important;
            display: flex !important;
            gap: 8px !important;
        }
        .att-filter-select {
            flex: 1 !important;
            font-size: 12px !important;
            padding: 7px 10px !important;
        }
        .att-stats-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
            margin-bottom: 12px !important;
        }
        .att-stat-card {
            padding: 12px 10px !important;
            border-radius: 12px !important;
            gap: 10px !important;
        }
        .att-stat-icon {
            width: 38px !important;
            height: 38px !important;
            font-size: 15px !important;
            border-radius: 10px !important;
        }
        .att-stat-val {
            font-size: 17px !important;
        }
        .att-stat-lbl {
            font-size: 9.5px !important;
        }
        .att-cal-panel {
            padding: 14px 10px !important;
            border-radius: 14px !important;
        }
        .att-cal-title {
            font-size: 15px !important;
        }
        .att-total-logged-badge {
            font-size: 10.5px !important;
            padding: 3px 8px !important;
        }
        .att-grid-body {
            gap: 6px;
        }
        .att-day-card {
            min-height: 60px;
            padding: 6px 2px;
        }
        .att-day-number {
            font-size: 12px;
        }
        .att-day-status-label {
            font-size: 8.5px;
            padding: 1px 4px;
        }
        .att-empty-slot {
            min-height: 60px !important;
        }
    }
</style>
<div class="att-parent-wrapper">
    <div class="att-parent-header">
        <div>
            <h2 style="font-size: 22px; font-weight: 800; color: #0F172A; margin: 0; font-family: 'Outfit', sans-serif; display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-calendar-check" style="color: #0D9488;"></i>
                <%- lan.Attendance_History %>
            </h2>
            <p style="font-size: 13px; color: #64748B; margin: 4px 0 0 0;">
                <%- lan.Monthly_Attendance_Log_For %> <strong><%= activeChild.first_name %> <%= activeChild.last_name %></strong>
            </p>
        </div>
        <div class="att-filter-container" style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
            <% if (children && children.length > 1) { %>
                <form method="GET" class="att-filter-form" style="margin: 0;">
                    <select name="studentId" class="att-filter-select" onchange="this.form.submit()">
                        <% children.forEach(child => { %>
                            <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                                👤 <%= child.first_name %> <%= child.last_name %>
                            </option>
                        <% }) %>
                    </select>
                    <input type="hidden" name="month" value="<%= selectedMonth %>">
                    <input type="hidden" name="year" value="<%= selectedYear %>">
                </form>
            <% } %>
            <form method="GET" class="att-filter-form" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <input type="hidden" name="studentId" value="<%= activeChild.id %>">
                <select name="month" class="att-filter-select" onchange="this.form.submit()">
                    <% for(let i=1; i<=12; i++) { %>
                        <option value="<%= i %>" <%= selectedMonth === i ? 'selected' : '' %>>
                            🗓️ <%= new Date(2000, i-1, 1).toLocaleString('default', { month: 'long' }) %>
                        </option>
                    <% } %>
                </select>
                <select name="year" class="att-filter-select" onchange="this.form.submit()">
                    <% for(let y = new Date().getFullYear(); y >= new Date().getFullYear()-2; y--) { %>
                        <option value="<%= y %>" <%= selectedYear === y ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                </select>
            </form>
        </div>
    </div>
    <div class="att-stats-grid">
        <div class="att-stat-card">
            <div class="att-stat-icon" style="background: #D1FAE5; color: #059669;">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <div class="att-stat-lbl" style="font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700; letter-spacing: 0.5px;"><%- lan.Present %></div>
                <div class="att-stat-val" style="font-size: 22px; font-weight: 800; color: #0F172A; line-height: 1.2;"><%= stats.presentDays %> <span style="font-size: 12px; font-weight: 600; color: #059669;"><%- lan.Days %></span></div>
            </div>
        </div>
        <div class="att-stat-card">
            <div class="att-stat-icon" style="background: #FEE2E2; color: #DC2626;">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <div>
                <div class="att-stat-lbl" style="font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700; letter-spacing: 0.5px;"><%- lan.Absent %></div>
                <div class="att-stat-val" style="font-size: 22px; font-weight: 800; color: #0F172A; line-height: 1.2;"><%= stats.absentDays %> <span style="font-size: 12px; font-weight: 600; color: #DC2626;"><%- lan.Days %></span></div>
            </div>
        </div>
        <div class="att-stat-card">
            <div class="att-stat-icon" style="background: #FEF3C7; color: #D97706;">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div>
                <div class="att-stat-lbl" style="font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700; letter-spacing: 0.5px;"><%- lan.Late %></div>
                <div class="att-stat-val" style="font-size: 22px; font-weight: 800; color: #0F172A; line-height: 1.2;"><%= stats.lateDays %> <span style="font-size: 12px; font-weight: 600; color: #D97706;"><%- lan.Days %></span></div>
            </div>
        </div>
        <div class="att-stat-card">
            <div class="att-stat-icon" style="background: #CCFBF1; color: #0D9488;">
                <i class="fa-solid fa-chart-pie"></i>
            </div>
            <div>
                <div class="att-stat-lbl" style="font-size: 11px; text-transform: uppercase; color: #64748B; font-weight: 700; letter-spacing: 0.5px;"><%- lan.Attendance_Rate %></div>
                <div class="att-stat-val" style="font-size: 22px; font-weight: 800; color: #0F172A; line-height: 1.2;">
                    <%= stats.percentage %>%
                    <% if (stats.percentage >= 85) { %>
                        <span style="font-size: 10px; font-weight: 800; background: #D1FAE5; color: #047857; padding: 2px 8px; border-radius: 999px; vertical-align: middle; margin-left: 4px;"><%- lan.Excellent %></span>
                    <% } else if (stats.percentage >= 75) { %>
                        <span style="font-size: 10px; font-weight: 800; background: #CCFBF1; color: #0F766E; padding: 2px 8px; border-radius: 999px; vertical-align: middle; margin-left: 4px;"><%- lan.Good %></span>
                    <% } else { %>
                        <span style="font-size: 10px; font-weight: 800; background: #FEE2E2; color: #B91C1C; padding: 2px 8px; border-radius: 999px; vertical-align: middle; margin-left: 4px;"><%- lan.Low %></span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <div class="att-cal-panel" style="background: #ffffff; padding: 24px; border-radius: 20px; border: 1px solid #E2E8F0; box-shadow: 0 4px 24px -4px rgba(13, 148, 136, 0.06); margin-bottom: 10px;">
        <div class="att-cal-header-border" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 5px; padding-bottom: 5px; border-bottom: 1px solid #F1F5F9;">
            <h3 class="att-cal-title" style="font-size: 18px; font-weight: 800; color: #0F172A; margin: 0; font-family: 'Outfit', sans-serif; display: flex; align-items: center; gap: 8px;">
                <i class="fa-regular fa-calendar" style="color: #0D9488;"></i>
                <%= new Date(selectedYear, selectedMonth-1, 1).toLocaleString('default', { month: 'long', year: 'numeric' }) %>
            </h3>
            <span class="att-total-logged-badge" style="font-size: 12px; font-weight: 700; background: #F0FDFA; color: #0D9488; border: 1px solid #CCFBF1; padding: 4px 12px; border-radius: 999px;">
                <%= stats.totalDays || calendarDays.length %> <%- lan.Total_Days_Logged %>
            </span>
        </div>
        <div class="att-grid-header">
            <div><%- lan.Sun %></div>
            <div><%- lan.Mon %></div>
            <div><%- lan.Tue %></div>
            <div><%- lan.Wed %></div>
            <div><%- lan.Thu %></div>
            <div><%- lan.Fri %></div>
            <div><%- lan.Sat %></div>
        </div>
        <div class="att-grid-body">
            <% 
                const firstDay = new Date(selectedYear, selectedMonth-1, 1).getDay();
                for(let i=0; i<firstDay; i++) { %>
                <div class="att-empty-slot" style="min-height: 74px; border-radius: 14px; background: #F8FAFC; border: 1px dashed #E2E8F0; opacity: 0.5;"></div>
            <% } %>
            <% (calendarDays || []).forEach(day => { %>
                <% 
                    const st = (day.status || 'not_marked').toLowerCase();
                    let iconHtml = '';
                    let labelText = '';
                    
                    if (st === 'present') {
                        iconHtml = '<i class="fa-solid fa-check" style="font-size: 14px; color: #059669;"></i>';
                        labelText = lan.Present || 'Present';
                    } else if (st === 'absent') {
                        iconHtml = '<i class="fa-solid fa-xmark" style="font-size: 14px; color: #DC2626;"></i>';
                        labelText = lan.Absent || 'Absent';
                    } else if (st === 'late') {
                        iconHtml = '<i class="fa-solid fa-clock" style="font-size: 13px; color: #D97706;"></i>';
                        labelText = lan.Late || 'Late';
                    } else if (st === 'half_day' || st === 'half-day') {
                        iconHtml = '<i class="fa-solid fa-circle-half-stroke" style="font-size: 13px; color: #4F46E5;"></i>';
                        labelText = lan.Half_Day || 'Half Day';
                    } else if (st === 'leave') {
                        iconHtml = '<i class="fa-solid fa-plane-departure" style="font-size: 12px; color: #16A34A;"></i>';
                        labelText = lan.Leave || 'Leave';
                    } else if (st === 'holiday') {
                        iconHtml = '<i class="fa-solid fa-umbrella-beach" style="font-size: 12px; color: #94A3B8;"></i>';
                        labelText = lan.Holiday || 'Holiday';
                    } else {
                        iconHtml = '<i class="fa-solid fa-minus" style="font-size: 11px; color: #CBD5E1;"></i>';
                        labelText = '—';
                    }
                %>
                <div class="att-day-card status-<%= st %>" title="<%= day.date %>: <%= labelText %> <%= day.remark ? '(' + day.remark + ')' : '' %>">
                    <span class="att-day-number"><%= day.day %></span>
                    <div><%- iconHtml %></div>
                    <span class="att-day-status-label"><%= labelText %></span>
                </div>
            <% }) %>
        </div>
        <div class="att-legend-bar" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 7px; padding-top: 10px; border-top: 1px solid #F1F5F9; font-size: 12px; font-weight: 600; color: #475569;">
            <span style="display: inline-flex; align-items: center; gap: 6px; background: #ECFDF5; color: #047857; padding: 4px 12px; border-radius: 999px; border: 1px solid #A7F3D0;">
                <i class="fa-solid fa-check" style="color: #059669;"></i> <%- lan.Present %>
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; background: #FEF2F2; color: #B91C1C; padding: 4px 12px; border-radius: 999px; border: 1px solid #FECACA;">
                <i class="fa-solid fa-xmark" style="color: #DC2626;"></i> <%- lan.Absent %>
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; background: #FFFBEB; color: #B45309; padding: 4px 12px; border-radius: 999px; border: 1px solid #FDE68A;">
                <i class="fa-solid fa-clock" style="color: #D97706;"></i> <%- lan.Late %>
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; background: #EEF2FF; color: #3730A3; padding: 4px 12px; border-radius: 999px; border: 1px solid #C7D2FE;">
                <i class="fa-solid fa-circle-half-stroke" style="color: #4F46E5;"></i> <%- lan.Half_Day %>
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px; background: #F0FDF4; color: #14532D; padding: 4px 12px; border-radius: 999px; border: 1px solid #BBF7D0;">
                <i class="fa-solid fa-plane-departure" style="color: #16A34A;"></i> <%- lan.Leave %>
            </span>
            <span class="att-legend-holiday" style="display: inline-flex; align-items: center; gap: 6px; background: #F8FAFC; color: #475569; padding: 4px 12px; border-radius: 999px; border: 1px solid #E2E8F0;">
                <i class="fa-solid fa-umbrella-beach" style="color: #94A3B8;"></i> <%- lan.Holiday %>
            </span>
        </div>
    </div>
</div>