<%
    const certs = typeof certificates !== 'undefined' && certificates ? certificates : [];
    const kids = typeof children !== 'undefined' && children ? children : [];
    const active = typeof activeChild !== 'undefined' ? activeChild : (kids[0] || {});
    const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
%>
<div class="space-y-6 pb-8">
    <nav class="flex text-xs font-semibold text-slate-500 gap-2" aria-label="Breadcrumb">
        <a href="/parent/dashboard" class="hover:text-blue-600">Home</a>
        <span>/</span>
        <span class="text-slate-800">Certificates</span>
    </nav>
    <div class="rounded-2xl p-6 text-white shadow-lg relative overflow-hidden" style="background:linear-gradient(135deg, #0d9488, #0f766e);">
        <div class="absolute -right-8 -top-8 w-36 h-36 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div>
                <h1 class="text-xl font-bold m-0">My Children's Certificates</h1>
                <p class="text-xs text-blue-100 mt-1 m-0">View and download official certificates issued by the school for your child</p>
            </div>
            <% if (active && active.id) { %>
            <div class="bg-white/15 backdrop-blur-md border border-white/20 px-3.5 py-1.5 rounded-xl text-xs font-semibold flex items-center gap-2">
                <i class="fas fa-user-graduate text-blue-200"></i>
                <span><%= (active.first_name || '') + ' ' + (active.last_name || '') %></span>
                <span class="text-blue-200 text-[10px]">(Class <%= active.class_name || '—' %>)</span>
            </div>
            <% } %>
        </div>
    </div>
    <% if (kids.length > 1) { %>
        <div class="flex items-center gap-2 overflow-x-auto pb-1">
            <span class="text-xs font-bold text-slate-500 mr-2 flex-shrink-0">Select Child:</span>
            <% kids.forEach(child => { %>
                <% const isSelected = active && Number(active.id) === Number(child.id); %>
                <button data-child-id="<%= child.id %>" onclick="switchChildForCerts(this.dataset.childId)" class="px-3 py-1.5 rounded-xl text-xs font-bold transition cursor-pointer border-0 flex-shrink-0 <%= isSelected ? 'bg-blue-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
                    <%= child.first_name %> <%= child.last_name || '' %>
                </button>
            <% }) %>
        </div>
    <% } %>
    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
        <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-100">
            <h3 class="text-sm font-bold text-slate-800 m-0 uppercase tracking-wider flex items-center gap-2">
                <i class="fas fa-certificate text-blue-600"></i> Issued Certificates (<%= certs.length %>)
            </h3>
            <span class="text-xs text-slate-400">Total: <%= certs.length %> Document<%= certs.length === 1 ? '' : 's' %></span>
        </div>
        <% if (certs.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <% certs.forEach(cert => { %>
                    <div class="border border-slate-200 hover:border-blue-300 rounded-2xl p-5 bg-white shadow-sm hover:shadow-md transition-all flex flex-col justify-between group">
                        <div>
                            <div class="flex items-start justify-between gap-3 mb-3">
                                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg flex-shrink-0 group-hover:scale-105 transition-transform">
                                    <i class="fas fa-award"></i>
                                </div>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider <%= cert.status === 'issued' || cert.status === 'active' ? 'bg-emerald-50 text-emerald-600 border border-emerald-200' : 'bg-slate-100 text-slate-600' %>">
                                    <%= cert.status || 'Issued' %>
                                </span>
                            </div>
                            <h4 class="text-sm font-bold text-slate-800 m-0 leading-snug"><%= (cert.certificate_type || cert.certificate_name || 'Official Certificate').replace(/_/g, ' ').toUpperCase() %></h4>
                            <p class="text-xs text-slate-500 mt-1 mb-2">No: <span class="font-mono text-slate-700 font-semibold"><%= cert.certificate_no || cert.id || 'N/A' %></span></p>              
                            <div class="text-[11px] text-slate-400 space-y-1 pt-2 border-t border-slate-100">
                                <div><i class="far fa-calendar-alt mr-1"></i> Issued: <span class="font-semibold text-slate-600"><%= fmtDate(cert.issue_date || cert.created_at) %></span></div>
                                <div><i class="fas fa-building mr-1"></i> Issued by: <span class="font-semibold text-slate-600">School Administration</span></div>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-[10px] text-slate-400">PDF Document</span>
                            <a href="<%= cert.file_url || cert.file_path || ('/uploads/certificates/' + (cert.certificate_no || cert.id) + '.pdf') %>" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs border-0 text-decoration-none shadow-sm transition">
                                <i class="fas fa-download text-[11px]"></i> Download
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-12 text-slate-400">
                <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-300 flex items-center justify-center text-3xl mx-auto mb-3">
                    <i class="fas fa-certificate"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-600 m-0">No Certificates Available</h4>
                <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">There are currently no issued certificates for <%= active.first_name || 'your child' %>. Issued certificates will automatically appear here.</p>
            </div>
        <% } %>
    </div>
</div>
<script>
    function switchChildForCerts(childId) {
        fetch('/parent/children/switch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_id: childId })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                window.location.reload();
            };
        })
        .catch(err => console.error('Switch child error:', err));
    };
</script>