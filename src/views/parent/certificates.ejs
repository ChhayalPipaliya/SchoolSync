<section class="card">
    <h1>Certificates — <%= activeChild.first_name %></h1>
    <% if (!certificates.length) { %>
        <p>No certificates have been issued.</p>
    <% } else { %>
        <table class="table-no-min-width">
            <thead>
                <tr>
                    <th>Number</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
        <tbody>
    <% certificates.forEach(item => { %>
        <tr>
            <td><%= item.certificate_no %></td>
            <td><%= item.certificate_type %></td>
            <td><%= item.issue_date %></td>
            <td><%= item.status %></td>
        </tr>
    <% }) %>
        </tbody>
        </table>
    <% } %>
</section>