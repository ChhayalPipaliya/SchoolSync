<%
    const certs = typeof certificates !== 'undefined' && certificates ? certificates : [];
    const kids = typeof children !== 'undefined' && children ? children : [];
    const active = typeof activeChild !== 'undefined' && activeChild ? activeChild : (kids[0] || {});
    const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
%>

<style>
    .cert-header-card {
        background: linear-gradient(135deg, #0891b2, #075985);
        border-radius: 12px;
        padding: 24px;
        color: #ffffff;
        margin-bottom: 10px;
        position: relative;
        overflow: hidden;
    }
    .cert-header-circle {
        position: absolute;
        right: -30px;
        top: -30px;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
    }
    .cert-header-inner {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }
    .cert-content-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        overflow: hidden;
        margin-bottom: 10px;
    }
    .cert-content-header {
        padding: 14px 20px;
        border-bottom: 1px solid #F1F5F9;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .cert-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 16px;
        padding: 20px;
    }
    .cert-card-item {
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 18px;
        background: #ffffff;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .cert-card-item:hover {
        border-color: #0891B2;
        box-shadow: 0 6px 16px rgba(8, 145, 178, 0.08);
        transform: translateY(-2px);
    }
    .cert-badge {
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .cert-badge.issued {
        background: #E6F4EA;
        color: #137333;
    }
    .cert-badge.pending {
        background: #FEF3C7;
        color: #D97706;
    }

    [data-theme="dark"],
    .light-mode-disabled,
    html[data-theme="dark"],
    html.dark {
        --cert-card-bg: #151D30;
        --cert-inner-bg: #101726;
        --cert-border: #242F4D;
        --cert-text: #F8FAFC;
        --cert-muted: #94A3B8;
    }

    [data-theme="dark"] .cert-content-card,
    .light-mode-disabled .cert-content-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .cert-content-header,
    .light-mode-disabled .cert-content-header {
        background: #151D30 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .cert-content-header h3,
    .light-mode-disabled .cert-content-header h3 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .cert-content-header span,
    .light-mode-disabled .cert-content-header span {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .cert-card-item,
    .light-mode-disabled .cert-card-item {
        background: #101726 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .cert-card-icon,
    .light-mode-disabled .cert-card-icon {
        background: rgba(8, 145, 178, 0.15) !important;
        color: #38bdf8 !important;
    }
    [data-theme="dark"] .cert-card-item h4,
    .light-mode-disabled .cert-card-item h4 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .cert-card-item p,
    .light-mode-disabled .cert-card-item p {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .cert-card-item .cert-meta-row,
    .light-mode-disabled .cert-card-item .cert-meta-row {
        color: #94A3B8 !important;
        border-top-color: #242F4D !important;
    }
    [data-theme="dark"] .cert-card-item .cert-meta-val,
    .light-mode-disabled .cert-card-item .cert-meta-val {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .cert-card-footer,
    .light-mode-disabled .cert-card-footer {
        border-top-color: #242F4D !important;
    }

    [data-theme="dark"] .cert-student-select,
    .light-mode-disabled .cert-student-select {
        background: #101726 !important;
        color: #38bdf8 !important;
        border: 1px solid #242F4D !important;
    }

    [data-theme="dark"] .cert-empty-box,
    .light-mode-disabled .cert-empty-box {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .cert-empty-box h4,
    .light-mode-disabled .cert-empty-box h4 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .cert-empty-box p,
    .light-mode-disabled .cert-empty-box p {
        color: #94A3B8 !important;
    }
</style>
<div class="cert-header-card">
    <div class="cert-header-circle"></div>
    <div class="cert-header-inner">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">My Children's Certificates</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">
                View and download official certificates issued for <%= active.first_name || 'your child' %> &middot; Class <%= active.class_name || '—' %> (<%= active.section || '' %>)
            </p>
        </div>
        <% if (kids && kids.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <select name="studentId" class="form-select cert-student-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% kids.forEach(child => { %>
                        <option value="<%= child.id %>" <%= active && active.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name || '' %>
                        </option>
                    <% }) %>
                </select>
            </form>
        <% } %>
    </div>
</div>
<div class="ss-card cert-content-card">
    <div class="cert-content-header">
        <h3 style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-certificate" style="color: #0891B2;"></i> Issued Certificates (<%= certs.length %>)
        </h3>
        <span style="font-size: 12px; color: #64748B; font-weight: 500;">
            Total: <%= certs.length %> Document<%= certs.length === 1 ? '' : 's' %>
        </span>
    </div>
    <% if (certs.length > 0) { %>
        <div class="cert-grid">
            <% certs.forEach(cert => { %>
                <% const isIssued = cert.status === 'issued' || cert.status === 'active'; %>
                <div class="cert-card-item">
                    <div>
                        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 12px;">
                            <div class="cert-card-icon" style="width: 42px; height: 42px; border-radius: 12px; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                                <i class="fas fa-award"></i>
                            </div>
                            <span class="cert-badge <%= isIssued ? 'issued' : 'pending' %>">
                                <%= cert.status || 'Issued' %>
                            </span>
                        </div>
                        <h4 style="font-size: 14px; font-weight: 700; color: #0F172A; margin: 0; line-height: 1.4;">
                            <%= (cert.certificate_type || cert.certificate_name || 'Official Certificate').replace(/_/g, ' ').toUpperCase() %>
                        </h4>
                        <p style="font-size: 12px; color: #64748B; margin: 4px 0 8px 0;">
                            No: <span class="cert-meta-val" style="font-family: monospace; font-weight: 700; color: #334155;"><%= cert.certificate_no || cert.id || 'N/A' %></span>
                        </p>
                        <div class="cert-meta-row" style="font-size: 11.5px; color: #64748B; border-top: 1px solid #F1F5F9; padding-top: 8px; display: flex; flex-direction: column; gap: 4px;">
                            <div><i class="far fa-calendar-alt" style="margin-right: 4px;"></i> Issued: <span class="cert-meta-val" style="font-weight: 600; color: #334155;"><%= fmtDate(cert.issue_date || cert.created_at) %></span></div>
                            <div><i class="fas fa-building" style="margin-right: 4px;"></i> Issued by: <span class="cert-meta-val" style="font-weight: 600; color: #334155;">School Administration</span></div>
                        </div>
                    </div>
                    <div class="cert-card-footer" style="margin-top: 16px; border-top: 1px solid #F1F5F9; padding-top: 12px; display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-size: 11px; color: #94A3B8; font-weight: 500;">PDF Document</span>
                        <a href="<%= cert.file_url || cert.file_path || ('/uploads/certificates/' + (cert.certificate_no || cert.id) + '.pdf') %>" target="_blank" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 8px; background: #0891B2; color: #ffffff; font-size: 12px; font-weight: 700; text-decoration: none; transition: background 0.15s ease;">
                            <i class="fas fa-download text-[11px]"></i> Download
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="cert-empty-box" style="padding: 48px 20px; text-align: center;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 12px auto;">
                <i class="fas fa-certificate"></i>
            </div>
            <h4 style="font-size: 16px; font-weight: 700; color: #1E293B; margin: 0 0 6px 0;">No Certificates Available</h4>
            <p style="font-size: 13px; color: #64748B; margin: 0; max-width: 360px; margin: 0 auto;">
                There are currently no issued certificates for <%= active.first_name || 'your child' %>. Issued certificates will automatically appear here.
            </p>
        </div>
    <% } %>
</div>