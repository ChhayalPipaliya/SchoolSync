<div style="background: linear-gradient(135deg, #0891b2, #075985); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(8,145,178,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">Fees Status</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">Track payment records and pending dues for <%= activeChild.first_name %> <%= activeChild.last_name %></p>
        </div>
        <% if (children && children.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <select name="studentId" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% children.forEach(child => { %>
                        <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name %> (<%= child.class_name %>-<%= child.section %>)
                        </option>
                    <% }) %>
                </select>
            </form>
        <% } %>
    </div>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-calculator"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Total Demand</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;">₹<%= summary.totalFees.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #E6F4EA; color: #137333; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-check-circle"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Paid Fees</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;">₹<%= summary.totalPaid.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Pending Amount</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;">₹<%= summary.pendingAmount.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
        </div>
    </div>
</div>
<div class="fees-grid">
    <div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden; display: flex; flex-direction: column;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9; background: #fff;">
            <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-table" style="color: #0891B2;"></i> Fee Demand Breakdown
            </h3>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                <thead>
                    <tr style="border-bottom: 1px solid #F1F5F9; background: #F8FAFC;">
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Month</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Fee Type</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Total Demand</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Paid</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Balance</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Status</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (fees && fees.length > 0) { %>
                        <% fees.forEach(fee => { 
                            const balance = Math.max(0, parseFloat(fee.amount || 0) - parseFloat(fee.paid_amount || 0));
                            const balanceAttr = `style="padding: 14px 20px; font-weight: 700; color: ${balance > 0 ? '#DC2626' : '#137333'};"`;
                        %>
                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                <td style="padding: 14px 20px;">
                                    <span style="color: #1e293b; font-weight: 700; text-transform: capitalize;"><%= fee.fee_name %></span>
                                </td>
                                <td style="padding: 14px 20px;">
                                    <span style="background: #ECFEFF; color: #0891B2; border: 1px solid #A5F3FC; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: capitalize;">
                                        <%= fee.fee_type %>
                                    </span>
                                </td>
                                <td style="padding: 14px 20px; color: #1e293b;">₹<%= parseFloat(fee.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 14px 20px; color: #475569;">₹<%= parseFloat(fee.paid_amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td <%- balanceAttr %>>₹<%= balance.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 14px 20px;">
                                    <% if (fee.status === 'paid' || balance === 0) { %>
                                        <span style="background: #E6F4EA; color: #137333; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-check-circle"></i> Paid
                                        </span>
                                    <% } else if (fee.status === 'partial' || (parseFloat(fee.paid_amount || 0) > 0 && balance > 0)) { %>
                                        <span style="background: #FEF3C7; color: #D97706; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-adjust"></i> Partial
                                        </span>
                                    <% } else { %>
                                        <span style="background: #FEE2E2; color: #DC2626; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-clock"></i> Unpaid
                                        </span>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 20px;">
                                    <% if (balance > 0) { %>
                                        <button type="button" onclick="payFee('<%= fee.id %>, <%= activeChild.id %>')" style="background: #0891B2; border: none; font-size: 11px; font-weight: 700; color: #fff; padding: 6px 12px; border-radius: 6px; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#0369a1'" onmouseout="this.style.background='#0891B2'">
                                            Pay Now
                                        </button>
                                    <% } else { %>
                                        <span style="color: #64748b; font-size: 11px; font-style: italic;">Cleared</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="7" style="text-align: center; padding: 24px; color: #64748b;">No active fee demands.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden; display: flex; flex-direction: column;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9; background: #fff;">
            <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-history" style="color: #0891B2;"></i> Payment Transactions
            </h3>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                <thead>
                    <tr style="border-bottom: 1px solid #F1F5F9; background: #F8FAFC;">
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Receipt & Date</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Fees Covered</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Amount</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Method</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (payments && payments.length > 0) { %>
                        <% payments.forEach(pay => { %>
                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                <td style="padding: 14px 20px;">
                                    <div style="display: flex; flex-direction: column; gap: 2px;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span style="color: #1e293b; font-weight: 700;"><%= pay.receipt_no || 'N/A' %></span>
                                            <a href="/parent/fees/receipts/<%= pay.id %>" style="display: inline-flex; align-items: center; gap: 4px; background: #0891B2; color: #fff; text-decoration: none; padding: 3px 8px; font-size: 11px; font-weight: 600; border-radius: 4px; transition: background 0.2s;" onmouseover="this.style.background='#0369a1'" onmouseout="this.style.background='#0891B2'" title="Download Receipt">
                                                <i class="fas fa-download"></i> Receipt
                                            </a>
                                        </div>
                                        <span style="font-size: 11px; color: #64748b;"><%= new Date(pay.payment_date).toLocaleDateString('en-IN') %></span>
                                    </div>
                                </td>
                                <td style="padding: 14px 20px; color: #475569; text-transform: capitalize;"><%= pay.fee_name || 'Generic' %></td>
                                <td style="padding: 14px 20px; font-weight: 700; color: #137333;">₹<%= parseFloat(pay.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 14px 20px;">
                                    <span style="background: #F1F5F9; color: #334155; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase;">
                                        <%= pay.payment_method || 'Online' %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="4" style="text-align: center; padding: 24px; color: #64748b;">No payment transactions recorded yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('../partials/razorpay-checkout') %>
<script>
    async function payFee(feeId, studentId) {
        try {
            const response = await fetch('/parent/fees/razorpay/order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    studentId: studentId,
                    fee_ids: [feeId]
                })
            });
            const result = await response.json();
            
            if (!result.success) {
                alert(result.message || 'Failed to create payment order');
                return;
            };

            const orderData = result.data;
            orderData.prefill = {
                name: '<%= activeChild.first_name + " " + activeChild.last_name %>',
                email: '<%= user.email %>'
            };

            window.openRazorpayCheckout(orderData, function(successData) {
                alert('Payment successful! Receipt: ' + (successData.receiptNo || successData.receiptId));
                window.location.reload();
            }, function(errorMsg) {
                alert(errorMsg || 'Payment was not completed. Please try Netbanking test mode.');
            });

        } catch (err) {
            console.error('[Parent Fee Checkout Error]', err);
            alert('An error occurred while initiating payment.');
        };
    };
</script>
<style>
    .fees-grid {
        display: grid;
        grid-template-columns: 7fr 5fr;
        gap: 24px;
    }
    @media (max-width: 1199px) {
        .fees-grid {
            grid-template-columns: 1fr;
        }
    }
</style>