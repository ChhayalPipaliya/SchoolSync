<div class="parent-fees-banner" style="background: linear-gradient(135deg, #0891b2, #075985); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(8,145,178,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">Fees Status</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">Track payment records and pending dues for <%= activeChild.first_name %> <%= activeChild.last_name %></p>
        </div>
        <% if (children && children.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <select name="studentId" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% children.forEach(child => { %>
                        <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name %> (<%= child.class_name %>-<%= child.section %>)
                        </option>
                    <% }) %>
                </select>
            </form>
        <% } %>
    </div>
</div>
<div class="parent-stat-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-calendar-alt"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">
                Total Yearly Fees (<%= activeChild.class_name %><%= activeChild.section ? ' ' + activeChild.section : '' %>)
            </h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;">₹<%= parseFloat((summary && summary.totalFees) || (typeof classAnnualFee !== 'undefined' && classAnnualFee) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
            <% if (typeof feeStructure !== 'undefined' && feeStructure && feeStructure.academic_year) { %>
                <div style="font-size: 11px; color: #0891B2; font-weight: 600; margin-top: 2px;">AY <%= feeStructure.academic_year %></div>
            <% } %>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #E6F4EA; color: #137333; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-check-circle"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Paid Fees</h3>
            <span style="font-size: 20px; font-weight: 700; color: #137333;">₹<%= parseFloat(summary.totalPaid || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Pending Balance</h3>
            <span style="font-size: 20px; font-weight: 700; color: #DC2626;">₹<%= parseFloat(summary.pendingAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
        </div>
    </div>
</div>
<div class="fees-grid">
    <div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden; display: flex; flex-direction: column;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9; background: #fff; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-table" style="color: #0891B2;"></i> Fee Demand Breakdown
            </h3>
        </div>
        <div style="overflow-x: auto;">
            <table class="parent-fees-table res-desktop-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                <thead>
                    <tr style="border-bottom: 1px solid #F1F5F9; background: #F8FAFC;">
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Academic Year</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Fee Type</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Annual Demand</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Paid</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Remaining Balance</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Status</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Payment Options</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (fees && fees.length > 0) { %>
                        <% fees.forEach(fee => { 
                            const balance = Math.max(0, parseFloat(fee.amount || 0) - parseFloat(fee.paid_amount || 0));
                            const balanceAttr = `style="padding: 14px 20px; font-weight: 700; color: ${balance > 0 ? '#DC2626' : '#137333'};"`;
                        %>
                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                <td style="padding: 14px 20px;">
                                    <span style="color: #1e293b; font-weight: 700; text-transform: capitalize;"><%= fee.fee_name %></span>
                                </td>
                                <td style="padding: 14px 20px;">
                                    <span style="background: #ECFEFF; color: #0891B2; border: 1px solid #A5F3FC; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: capitalize;">
                                        <%= fee.fee_type %>
                                    </span>
                                </td>
                                <td style="padding: 14px 20px; color: #1e293b;">₹<%= parseFloat(fee.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 14px 20px; color: #475569;">₹<%= parseFloat(fee.paid_amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td <%- balanceAttr %>>₹<%= balance.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 14px 20px;">
                                    <% if (fee.status === 'paid' || balance === 0) { %>
                                        <span style="background: #E6F4EA; color: #137333; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-check-circle"></i> Paid
                                        </span>
                                    <% } else if (fee.status === 'partial' || (parseFloat(fee.paid_amount || 0) > 0 && balance > 0)) { %>
                                        <span style="background: #FEF3C7; color: #D97706; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-adjust"></i> Partial
                                        </span>
                                    <% } else { %>
                                        <span style="background: #FEE2E2; color: #DC2626; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-clock"></i> Unpaid
                                        </span>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 20px;">
                                    <% if (balance > 0) { %>
                                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                            <button type="button" onclick="payOnline('<%= fee.id %>', '<%= activeChild.id %>', '<%= balance %>')" style="background: #0891B2; border: none; font-size: 11px; font-weight: 700; color: #fff; padding: 6px 12px; border-radius: 6px; cursor: pointer; transition: background 0.2s; display: inline-flex; align-items: center; gap: 4px;" onmouseover="this.style.background='#0369a1'" onmouseout="this.style.background='#0891B2'">
                                                <i class="fas fa-credit-card"></i> Pay Online
                                            </button>

                                            <% if (typeof schoolUpiQr !== 'undefined' && schoolUpiQr && schoolUpiQr.enabled) { %>
                                                <button type="button" onclick="payViaSchoolQR('<%= fee.id %>', '<%= activeChild.id %>', '<%= balance %>')" style="background: #4F46E5; border: none; font-size: 11px; font-weight: 700; color: #fff; padding: 6px 12px; border-radius: 6px; cursor: pointer; transition: background 0.2s; display: inline-flex; align-items: center; gap: 4px;" onmouseover="this.style.background='#4338CA'" onmouseout="this.style.background='#4F46E5'">
                                                    <i class="fas fa-qrcode"></i> Pay via QR
                                                </button>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <span style="color: #64748b; font-size: 11px; font-style: italic;">Cleared</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 24px; color: #64748b;">No active fee demands.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            <div class="fee-demand-cards-mobile" style="display: none; flex-direction: column; gap: 12px; padding: 12px;">
                <% if (fees && fees.length > 0) { %>
                    <% fees.forEach(fee => { 
                        const balance = Math.max(0, parseFloat(fee.amount || 0) - parseFloat(fee.paid_amount || 0));
                    %>
                        <div class="fee-card-item-mobile" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 10px;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                <div>
                                    <div style="font-size: 14px; font-weight: 800; color: #0F172A; text-transform: capitalize;"><%= fee.fee_name %></div>
                                    <span style="background: #ECFEFF; color: #0891B2; border: 1px solid #A5F3FC; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: 600; text-transform: capitalize; margin-top: 4px; display: inline-block;">
                                        <%= fee.fee_type %>
                                    </span>
                                </div>
                                <% if (fee.status === 'paid' || balance === 0) { %>
                                    <span style="background: #E6F4EA; color: #137333; padding: 3px 8px; border-radius: 9999px; font-size: 10px; font-weight: 700;">
                                        <i class="fas fa-check-circle"></i> Paid
                                    </span>
                                <% } else if (fee.status === 'partial' || (parseFloat(fee.paid_amount || 0) > 0 && balance > 0)) { %>
                                    <span style="background: #FEF3C7; color: #D97706; padding: 3px 8px; border-radius: 9999px; font-size: 10px; font-weight: 700;">
                                        <i class="fas fa-adjust"></i> Partial
                                    </span>
                                <% } else { %>
                                    <span style="background: #FEE2E2; color: #DC2626; padding: 3px 8px; border-radius: 9999px; font-size: 10px; font-weight: 700;">
                                        <i class="fas fa-clock"></i> Unpaid
                                    </span>
                                <% } %>
                            </div>
                            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; font-size: 11px; text-align: center;">
                                <div>
                                    <div style="color: #64748B; font-size: 9.5px; text-transform: uppercase;">Annual</div>
                                    <div style="font-weight: 700; color: #0F172A; margin-top: 2px;">₹<%= parseFloat(fee.amount || 0).toLocaleString('en-IN') %></div>
                                </div>
                                <div>
                                    <div style="color: #64748B; font-size: 9.5px; text-transform: uppercase;">Paid</div>
                                    <div style="font-weight: 700; color: #137333; margin-top: 2px;">₹<%= parseFloat(fee.paid_amount || 0).toLocaleString('en-IN') %></div>
                                </div>
                                <div>
                                    <div style="color: #64748B; font-size: 9.5px; text-transform: uppercase;">Balance</div>
                                    <div class="<%= balance > 0 ? 'text-rose-600' : 'text-emerald-700' %>" style="font-weight: 800; margin-top: 2px;">₹<%= balance.toLocaleString('en-IN') %></div>
                                </div>
                            </div>
                            <% if (balance > 0) { %>
                                <div style="display: flex; gap: 8px;">
                                    <button type="button" onclick="payOnline('<%= fee.id %>', '<%= activeChild.id %>', '<%= balance %>')" style="flex: 1; background: #0891B2; border: none; font-size: 12px; font-weight: 700; color: #fff; padding: 8px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 4px;">
                                        <i class="fas fa-credit-card"></i> Pay Online
                                    </button>
                                    <% if (typeof schoolUpiQr !== 'undefined' && schoolUpiQr && schoolUpiQr.enabled) { %>
                                        <button type="button" onclick="payViaSchoolQR('<%= fee.id %>', '<%= activeChild.id %>', '<%= balance %>')" style="flex: 1; background: #4F46E5; border: none; font-size: 12px; font-weight: 700; color: #fff; padding: 8px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 4px;">
                                            <i class="fas fa-qrcode"></i> Pay via QR
                                        </button>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div style="text-align: center; padding: 16px; color: #64748b; font-size: 13px;">No active fee demands.</div>
                <% } %>
            </div>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden; display: flex; flex-direction: column;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9; background: #fff;">
            <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-history" style="color: #0891B2;"></i> Payment Transactions
            </h3>
        </div>
        <div style="overflow-x: auto;">
            <table class="res-desktop-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                <thead>
                    <tr style="border-bottom: 1px solid #F1F5F9; background: #F8FAFC;">
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Receipt / Ref & Date</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Fees Covered</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Amount</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Method & Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (payments && payments.length > 0) { %>
                        <% payments.forEach(pay => { 
                            const statusColor = pay.status === 'pending_verification' ? '#D97706' : '#137333';
                        %>
                            <tr style="border-bottom: 1px solid #F1F5F9;">
                                <td style="padding: 14px 20px;">
                                    <div style="display: flex; flex-direction: column; gap: 2px;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <% if (pay.status === 'pending_verification') { %>
                                                <span style="color: #1e293b; font-weight: 700; font-family: monospace; font-size: 11px;"><%= pay.payment_reference || pay.transaction_id || 'Ref #' + pay.id %></span>
                                            <% } else { %>
                                                <span style="color: #1e293b; font-weight: 700;"><%= pay.receipt_no || 'N/A' %></span>
                                                <a href="/parent/fees/receipts/<%= pay.id %>" style="display: inline-flex; align-items: center; gap: 4px; background: #0891B2; color: #fff; text-decoration: none; padding: 3px 8px; font-size: 11px; font-weight: 600; border-radius: 4px; transition: background 0.2s;" onmouseover="this.style.background='#0369a1'" onmouseout="this.style.background='#0891B2'" title="Download Receipt">
                                                    <i class="fas fa-download"></i> Receipt
                                                </a>
                                            <% } %>
                                        </div>
                                        <span style="font-size: 11px; color: #64748b;"><%= new Date(pay.payment_date).toLocaleDateString('en-IN') %></span>
                                    </div>
                                </td>
                                <td style="padding: 14px 20px; color: #475569; text-transform: capitalize;"><%= pay.fee_name || 'Generic' %></td>
                                <td style="padding: 14px 20px; font-weight: 700;" class="<%= pay.status === 'pending_verification' ? 'text-amber-600' : 'text-emerald-700' %>">₹<%= parseFloat(pay.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 14px 20px;">
                                    <% if (pay.status === 'pending_verification') { %>
                                        <span style="background: #FEF3C7; color: #D97706; border: 1px solid #FDE68A; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-hourglass-half"></i> Pending Verification
                                        </span>
                                    <% } else { %>
                                        <span style="background: #F1F5F9; color: #334155; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: uppercase;">
                                            <%= pay.payment_method === 'school_upi_qr' ? 'School UPI QR' : (pay.payment_method || 'Online') %>
                                        </span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 24px; color: #64748b;">No payment transactions recorded yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            <div class="fee-trans-cards-mobile" style="display: none; flex-direction: column; gap: 10px; padding: 12px;">
                <% if (payments && payments.length > 0) { %>
                    <% payments.forEach(pay => { %>
                        <div class="fee-trans-item-mobile" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                                <div>
                                    <% if (pay.status === 'pending_verification') { %>
                                        <span style="font-family: monospace; font-size: 11px; font-weight: 700; color: #0F172A;"><%= pay.payment_reference || pay.transaction_id || 'Ref #' + pay.id %></span>
                                    <% } else { %>
                                        <span style="font-weight: 800; font-size: 13px; color: #0F172A;"><%= pay.receipt_no || 'Receipt' %></span>
                                    <% } %>
                                    <div style="font-size: 11px; color: #64748B;"><%= new Date(pay.payment_date).toLocaleDateString('en-IN') %></div>
                                </div>
                                <div>
                                    <span class="<%= pay.status === 'pending_verification' ? 'text-amber-600' : 'text-emerald-700' %>" style="font-size: 15px; font-weight: 800;">
                                        ₹<%= parseFloat(pay.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                                    </span>
                                </div>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #F1F5F9; padding-top: 8px; font-size: 11px;">
                                <span style="color: #64748B; text-transform: capitalize;"><%= pay.fee_name || 'Generic' %></span>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="background: #F1F5F9; color: #334155; padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 10px; text-transform: uppercase;">
                                        <%= pay.payment_method === 'school_upi_qr' ? 'UPI QR' : (pay.payment_method || 'Online') %>
                                    </span>
                                    <% if (pay.receipt_no && pay.status !== 'pending_verification') { %>
                                        <a href="/parent/fees/receipts/<%= pay.id %>" style="display: inline-flex; align-items: center; gap: 3px; background: #0891B2; color: #fff; text-decoration: none; padding: 3px 8px; font-size: 10px; font-weight: 700; border-radius: 4px;">
                                            <i class="fas fa-download"></i> Receipt
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div style="text-align: center; padding: 16px; color: #64748b; font-size: 13px;">No payment transactions recorded yet.</div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<div id="schoolUpiQrModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #fff; width: 100%; max-width: 440px; border-radius: 20px; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); text-align: center; animation: modalPop 0.25s ease-out;">
        <div style="background: linear-gradient(135deg, #4F46E5, #3730A3); padding: 20px; color: #fff; position: relative;">
            <button type="button" onclick="closeSchoolQrModal()" style="position: absolute; right: 16px; top: 16px; background: rgba(255,255,255,0.2); border: none; color: #fff; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                <i class="fas fa-times"></i>
            </button>
            <h3 style="margin: 0; font-size: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px;">
                <i class="fas fa-qrcode"></i> Scan & Pay
            </h3>
            <p style="margin: 4px 0 0; font-size: 12px; opacity: 0.9;">School Official UPI QR Code</p>
        </div>
        <div style="padding: 24px;">
            <div id="schoolQrLoadingState" style="padding: 40px 20px;">
                <i class="fas fa-circle-notch fa-spin" style="font-size: 36px; color: #4F46E5; margin-bottom: 12px;"></i>
                <p style="color: #64748b; font-weight: 600; margin: 0; font-size: 14px;">Loading School QR Code...</p>
            </div>
            <div id="schoolQrContentState" style="display: none;">
                <div style="background: #F8FAFC; border: 2px dashed #E2E8F0; border-radius: 16px; padding: 16px; display: inline-block; margin-bottom: 12px; position: relative;">
                    <img id="schoolUpiQrImage" src="" alt="School UPI QR" style="width: 210px; height: 210px; display: block; border-radius: 8px; margin: 0 auto; object-fit: contain;">
                </div>
                <div style="margin-bottom: 12px;">
                    <span style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px;">Amount Payable</span>
                    <h2 id="schoolUpiAmountText" style="margin: 2px 0 0; font-size: 26px; font-weight: 800; color: #0F172A;">₹0.00</h2>
                    <p id="schoolUpiIdBox" style="margin: 4px 0 0; font-size: 12px; font-weight: 700; color: #4F46E5; background: #EEF2FF; padding: 4px 10px; border-radius: 6px; display: inline-block;"></p>
                </div>
                <div style="background: #F1F5F9; border-radius: 12px; padding: 12px; margin-bottom: 16px; text-align: left;">
                    <div style="font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 4px;">Payment Reference</div>
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                        <span id="schoolUpiRefText" style="font-family: monospace; font-size: 13px; font-weight: 800; color: #059669; word-break: break-all;"></span>
                        <button type="button" onclick="copyPaymentRef()" style="background: #059669; color: #fff; border: none; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer; white-space: nowrap;">
                            <i class="fas fa-copy"></i> Copy
                        </button>
                    </div>
                    <p style="font-size: 11px; color: #475569; margin: 6px 0 0 0;">
                        <i class="fas fa-info-circle" style="color: #4F46E5;"></i> Please include this reference in your UPI payment note.
                    </p>
                </div>
                <form id="schoolQrSubmitForm" onsubmit="submitSchoolQrPaymentForm(event)" class="space-y-3" style="text-align: left;">
                    <input type="hidden" id="schoolQrPaymentId" name="paymentId" value="">
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; margin-bottom: 4px;">UPI UTR / Transaction ID (Optional)</label>
                        <input type="text" id="schoolQrUtr" name="utrNumber" placeholder="e.g. 421812345678" style="width: 100%; border: 1px solid #CBD5E1; border-radius: 8px; padding: 8px 12px; font-size: 13px; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; margin-bottom: 4px;">Payment Screenshot Proof (Optional)</label>
                        <input type="file" id="schoolQrProof" name="proof_image" accept="image/*" style="width: 100%; font-size: 12px; color: #64748b;">
                    </div>
                    <div style="margin-top: 16px;">
                        <button type="submit" id="schoolQrSubmitBtn" style="width: 100%; background: #059669; color: #fff; border: none; padding: 12px; border-radius: 10px; font-weight: 700; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 12px rgba(5,150,105,0.25);">
                            <i class="fas fa-check-circle"></i> I Have Completed Payment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/razorpay-checkout') %>
<script>
    let activeSchoolPaymentId = null;
    let activeSchoolPaymentRef = null;

    async function payOnline(feeId, studentId, maxBalance) {
        try {
            let amountToPay = maxBalance;
            if (maxBalance && maxBalance > 0) {
                const promptVal = prompt(`Remaining Balance: ₹${parseFloat(maxBalance).toLocaleString('en-IN', {minimumFractionDigits: 2})}\nEnter amount to pay (or press OK to pay full remaining amount):`, parseFloat(maxBalance).toFixed(2));
                if (promptVal === null) return;
                const parsed = parseFloat(promptVal);
                if (isNaN(parsed) || parsed <= 0) {
                    alert('Please enter a valid payment amount.');
                    return;
                }
                if (parsed > parseFloat(maxBalance) + 0.01) {
                    alert(`Payment amount (₹${parsed.toFixed(2)}) cannot exceed remaining balance (₹${parseFloat(maxBalance).toFixed(2)}).`);
                    return;
                }
                amountToPay = parsed;
            }

            const response = await fetch('/parent/fees/razorpay/order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    studentId: studentId,
                    fee_ids: [feeId],
                    amount: amountToPay
                })
            });
            const result = await response.json();
            
            if (!result.success) {
                alert(result.message || 'Failed to create payment order');
                return;
            };

            const orderData = result.data;
            orderData.prefill = {
                name: '<%= activeChild.first_name + " " + activeChild.last_name %>',
                email: '<%= user.email %>'
            };

            window.openRazorpayCheckout(orderData, function(successData) {
                alert('Payment successful! Receipt: ' + (successData.receiptNo || successData.receiptId));
                window.location.reload();
            }, function(errorMsg) {
                alert(errorMsg || 'Payment was not completed.');
            });

        } catch (err) {
            console.error('[Parent Fee PayOnline Error]', err);
            alert('An error occurred while initiating online payment.');
        };
    };

    async function payViaSchoolQR(feeId, studentId, maxBalance) {
        try {
            let amountToPay = maxBalance;
            if (maxBalance && maxBalance > 0) {
                const promptVal = prompt(`Remaining Balance: ₹${parseFloat(maxBalance).toLocaleString('en-IN', {minimumFractionDigits: 2})}\nEnter amount to pay (or press OK to pay full remaining amount):`, parseFloat(maxBalance).toFixed(2));
                if (promptVal === null) return;
                const parsed = parseFloat(promptVal);
                if (isNaN(parsed) || parsed <= 0) {
                    alert('Please enter a valid payment amount.');
                    return;
                }
                if (parsed > parseFloat(maxBalance) + 0.01) {
                    alert(`Payment amount (₹${parsed.toFixed(2)}) cannot exceed remaining balance (₹${parseFloat(maxBalance).toFixed(2)}).`);
                    return;
                }
                amountToPay = parsed;
            }

            showSchoolQrLoading();

            const response = await fetch('/parent/fees/school-qr/initiate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    studentId: studentId,
                    fee_ids: [feeId],
                    amount: amountToPay
                })
            });
            const result = await response.json();

            if (!result.success || !result.data) {
                closeSchoolQrModal();
                alert(result.message || 'Failed to initiate School QR payment');
                return;
            };

            const data = result.data;
            activeSchoolPaymentId = data.payment_id;
            activeSchoolPaymentRef = data.payment_reference;

            document.getElementById('schoolQrPaymentId').value = data.payment_id;
            document.getElementById('schoolUpiQrImage').src = data.qr_image_url;
            document.getElementById('schoolUpiAmountText').innerText = `₹${parseFloat(data.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
            document.getElementById('schoolUpiIdBox').innerText = data.upi_id ? `UPI ID: ${data.upi_id}` : '';
            document.getElementById('schoolUpiRefText').innerText = data.payment_reference;

            document.getElementById('schoolQrLoadingState').style.display = 'none';
            document.getElementById('schoolQrContentState').style.display = 'block';

        } catch (err) {
            console.error('[payViaSchoolQR Error]', err);
            closeSchoolQrModal();
            alert('An error occurred while opening School QR Code.');
        };
    };

    function showSchoolQrLoading() {
        document.getElementById('schoolQrLoadingState').style.display = 'block';
        document.getElementById('schoolQrContentState').style.display = 'none';
        document.getElementById('schoolUpiQrModal').style.display = 'flex';
    };

    function closeSchoolQrModal() {
        document.getElementById('schoolUpiQrModal').style.display = 'none';
    };

    function copyPaymentRef() {
        if (!activeSchoolPaymentRef) return;
        navigator.clipboard.writeText(activeSchoolPaymentRef).then(() => {
            alert('Payment reference copied to clipboard!');
        }).catch(err => {
            console.error('Failed to copy reference:', err);
        });
    };

    async function submitSchoolQrPaymentForm(event) {
        event.preventDefault();
        try {
            const submitBtn = document.getElementById('schoolQrSubmitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';

            const paymentId = document.getElementById('schoolQrPaymentId').value;
            const utrNumber = document.getElementById('schoolQrUtr').value;
            const proofFile = document.getElementById('schoolQrProof').files[0];

            const formData = new FormData();
            formData.append('paymentId', paymentId);
            if (utrNumber) formData.append('utrNumber', utrNumber);
            if (proofFile) formData.append('proof_image', proofFile);

            const response = await fetch('/parent/fees/school-qr/submit', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (!result.success) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check-circle"></i> I Have Completed Payment';
                alert(result.message || 'Failed to submit payment confirmation.');
                return;
            };

            alert(result.message || 'Payment submitted successfully for admin verification!');
            closeSchoolQrModal();
            window.location.reload();

        } catch (err) {
            console.error('[submitSchoolQrPaymentForm Error]', err);
            alert('An error occurred while submitting payment proof.');
            const submitBtn = document.getElementById('schoolQrSubmitBtn');
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-check-circle"></i> I Have Completed Payment';
        };
    };
</script>
