<style>
    .hw-parent-wrap {
        animation: fadeIn 0.35s ease-out;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .hw-hero {
        background: linear-gradient(135deg, #0891b2, #075985);
        border-radius: 16px;
        padding: 24px;
        color: #fff;
        margin-bottom: 12px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px -10px rgba(8, 145, 178, 0.35);
    }
    .hw-hero-deco {
        position: absolute;
        right: -30px;
        top: -30px;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        pointer-events: none;
    }

    .hw-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 12px;
    }
    @media (max-width: 1024px) {
        .hw-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .hw-stat-card {
        background: #ffffff;
        padding: 18px 20px;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hw-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px -4px rgba(8, 145, 178, 0.12);
    }

    .hw-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .hw-filters-scroll {
        display: flex;
        gap: 10px;
        margin-bottom: 14px;
        overflow-x: auto;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
    }
    .hw-filters-scroll::-webkit-scrollbar {
        display: none;
    }

    .filter-btn {
        text-decoration: none;
        padding: 8px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
        white-space: nowrap;
    }
    .filter-active {
        background: #0891B2;
        color: #fff;
        box-shadow: 0 4px 12px rgba(8, 145, 178, 0.25);
    }
    .filter-inactive {
        background: #fff;
        color: #64748B;
        border: 1.5px solid #E2E8F0;
    }
    .filter-inactive:hover {
        border-color: #0891B2;
        color: #0891B2;
    }

    .homework-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    .hw-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #E2E8F0;
        padding: 22px;
        box-shadow: 0 4px 16px -4px rgba(15, 23, 42, 0.04);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .hw-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px -4px rgba(8, 145, 178, 0.1);
    }

    .due-date {
        font-size: 13px;
        font-weight: 700;
    }
    .due-overdue {
        color: #DC2626;
    }
    .due-normal {
        color: #1e293b;
    }

    @media (max-width: 991px) {
        .homework-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .sidebar-info {
            border-left: none !important;
            padding-left: 0 !important;
            border-top: 1px solid #F1F5F9;
            padding-top: 16px;
        }
    }

    @media (max-width: 640px) {
        .hw-hero {
            padding: 18px 16px !important;
            border-radius: 14px !important;
            margin-bottom: 10px !important;
        }
        .hw-hero h1 {
            font-size: 20px !important;
        }
        .hw-hero p {
            font-size: 12px !important;
        }
        .hw-hero-select-form {
            width: 100% !important;
        }
        .hw-hero-select {
            width: 100% !important;
        }

        .hw-stats-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
            margin-bottom: 10px !important;
        }
        .hw-stat-card {
            padding: 12px 10px !important;
            border-radius: 12px !important;
            gap: 10px !important;
        }
        .hw-stat-icon {
            width: 38px !important;
            height: 38px !important;
            font-size: 15px !important;
            border-radius: 10px !important;
        }
        .hw-stat-val {
            font-size: 18px !important;
        }
        .hw-stat-lbl {
            font-size: 9.5px !important;
        }

        .filter-btn {
            padding: 6px 14px !important;
            font-size: 12px !important;
        }

        .hw-card {
            padding: 16px 14px !important;
            border-radius: 14px !important;
        }
    }

    [data-theme="dark"],
    .light-mode-disabled,
    html[data-theme="dark"],
    html.dark {
        --hw-card: #151D30;
        --hw-inner: #101726;
        --hw-border: #242F4D;
        --hw-text: #F8FAFC;
        --hw-muted: #94A3B8;
    }

    [data-theme="dark"] .hw-stat-card,
    .light-mode-disabled .hw-stat-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .hw-stat-lbl,
    .light-mode-disabled .hw-stat-lbl {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .hw-stat-val,
    .light-mode-disabled .hw-stat-val {
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .filter-inactive,
    .light-mode-disabled .filter-inactive {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .hw-card,
    .light-mode-disabled .hw-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .hw-card h2,
    .light-mode-disabled .hw-card h2 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .hw-card p,
    .light-mode-disabled .hw-card p {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .sidebar-info,
    .light-mode-disabled .sidebar-info {
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .sidebar-box,
    .light-mode-disabled .sidebar-box {
        background: #101726 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .due-normal,
    .light-mode-disabled .due-normal {
        color: #F8FAFC !important;
    }
</style>
<div class="hw-parent-wrap">
    <div class="hw-hero">
        <div class="hw-hero-deco"></div>
        <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div>
                <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;"><%- lan.Homework_And_Assignments %></h1>
                <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;"><%- lan.Homework_Subtitle %> <%= activeChild.first_name %> <%= activeChild.last_name %></p>
            </div>
            <% if (children && children.length > 1) { %>
                <form method="GET" class="hw-hero-select-form" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                    <select name="studentId" class="form-select hw-hero-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                        <% children.forEach(child => { %>
                            <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                                <%= child.first_name %> <%= child.last_name %> (<%= child.class_name %>-<%= child.section %>)
                            </option>
                        <% }) %>
                    </select>
                    <input type="hidden" name="status" value="<%= status %>">
                </form>
            <% } %>
        </div>
    </div>
    <div class="hw-stats-grid">
        <div class="hw-stat-card ss-card">
            <div class="hw-stat-icon" style="background: #ECFEFF; color: #0891B2;">
                <i class="fas fa-list-ol"></i>
            </div>
            <div>
                <h3 class="hw-stat-lbl" style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;"><%- lan.Total_Assignments %></h3>
                <span class="hw-stat-val" style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.total %></span>
            </div>
        </div>
        <div class="hw-stat-card ss-card">
            <div class="hw-stat-icon" style="background: #FEF3C7; color: #D97706;">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <h3 class="hw-stat-lbl" style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;"><%- lan.Pending %></h3>
                <span class="hw-stat-val" style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.pending %></span>
            </div>
        </div>
        <div class="hw-stat-card ss-card">
            <div class="hw-stat-icon" style="background: #E6F4EA; color: #137333;">
                <i class="fas fa-check-double"></i>
            </div>
            <div>
                <h3 class="hw-stat-lbl" style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;"><%- lan.Submitted %></h3>
                <span class="hw-stat-val" style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.submitted %></span>
            </div>
        </div>
        <div class="hw-stat-card ss-card">
            <div class="hw-stat-icon" style="background: #FEE2E2; color: #DC2626;">
                <i class="fas fa-calendar-times"></i>
            </div>
            <div>
                <h3 class="hw-stat-lbl" style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;"><%- lan.Overdue %></h3>
                <span class="hw-stat-val" style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.overdue %></span>
            </div>
        </div>
    </div>
    <div class="hw-filters-scroll">
        <a href="/parent/homework?status=all<%= activeChild ? '&studentId=' + activeChild.id : '' %>" class="filter-btn <%= status === 'all' ? 'filter-active' : 'filter-inactive' %>">
           <%- lan.All_Assignments %>
        </a>
        <a href="/parent/homework?status=pending<%= activeChild ? '&studentId=' + activeChild.id : '' %>" class="filter-btn <%= status === 'pending' ? 'filter-active' : 'filter-inactive' %>">
           <%- lan.Pending %> (<%= stats.pending %>)
        </a>
        <a href="/parent/homework?status=submitted<%= activeChild ? '&studentId=' + activeChild.id : '' %>" class="filter-btn <%= status === 'submitted' ? 'filter-active' : 'filter-inactive' %>">
           <%- lan.Submitted %> (<%= stats.submitted %>)
        </a>
    </div>
    <div style="display: flex; flex-direction: column; gap: 16px;">
        <% if (homeworks && homeworks.length > 0) { %>
            <% homeworks.forEach(hw => { 
                const isOverdue = new Date(hw.due_date) < new Date() && (!hw.submission_id || hw.submission_status === 'pending');
            %>
                <div class="hw-card ss-card">
                    <div class="homework-grid">
                        <div>
                            <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 12px;">
                                <span style="background: #ECFEFF; color: #0891B2; border: 1px solid #A5F3FC; padding: 4px 10px; border-radius: 9999px; font-size: 11px; font-weight: 600;">
                                    <%= hw.subject_name %> (<%= hw.subject_code %>)
                                </span>
                                <span style="font-size: 12px; color: #64748b;"><i class="fas fa-user-tie" style="margin-right: 4px;"></i><%= hw.teacher_name %></span>
                                <span style="font-size: 12px; color: #64748b;"><i class="fas fa-calendar-alt" style="margin-right: 4px;"></i><%- lan.Assigned %>: <%= new Date(hw.created_at).toLocaleDateString() %></span>
                            </div>
                            <h2 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;"><%= hw.title %></h2>
                            <p style="font-size: 13px; color: #475569; margin: 0 0 16px 0; line-height: 1.5;"><%= hw.description %></p>
                            
                            <% if (hw.homework_file) { %>
                                <a href="/<%= hw.homework_file %>" target="_blank" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-size: 12px; font-weight: 600; color: #0891B2; background: #ECFEFF; border: 1px solid #A5F3FC; padding: 6px 16px; border-radius: 20px;">
                                    <i class="fas fa-paperclip"></i> <%- lan.Download_Attachment %>
                                </a>
                            <% } %>
                        </div>
                        <div class="sidebar-info" style="border-left: 1px solid #F1F5F9; padding-left: 24px; display: flex; flex-direction: column; gap: 16px;">
                            <div>
                                <h4 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 6px 0; letter-spacing: 0.5px;"><%- lan.Due_Date %></h4>
                                <span class="due-date <%= isOverdue ? 'due-overdue' : 'due-normal' %>">
                                    <i class="fas fa-calendar-times" style="margin-right: 4px;"></i> <%= new Date(hw.due_date).toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %>
                                </span>
                                <% if (isOverdue) { %>
                                    <span style="background: #FEE2E2; color: #DC2626; padding: 2px 8px; border-radius: 9999px; font-size: 10px; font-weight: 600; margin-left: 6px; display: inline-block;"><%- lan.Overdue %></span>
                                <% } %>
                            </div>
                            <div class="sidebar-box" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 14px; border-radius: 12px;">
                                <h4 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 10px 0; letter-spacing: 0.5px;"><%- lan.Submission_Status %></h4>
                                <% if (hw.submission_id && hw.submission_status !== 'pending') { %>
                                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
                                        <span style="background: #E6F4EA; color: #137333; padding: 2px 10px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-check-circle"></i> <%- lan.Submitted %>
                                        </span>
                                        <span style="font-size: 11px; color: #64748b;"><%= new Date(hw.submitted_at).toLocaleDateString() %></span>
                                    </div>
                                    <% if (hw.submission_status === 'graded') { %>
                                        <div style="border-top: 1px solid #E2E8F0; margin-top: 8px; padding-top: 8px;">
                                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                                <span style="font-size: 12px; font-weight: 600; color: #475569;"><%- lan.Marks %>:</span>
                                                <span style="background: #0891B2; color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700;"><%= hw.marks_obtained %> <%- lan.Marks %></span>
                                            </div>
                                            <% if (hw.teacher_remark) { %>
                                                <p style="font-size: 11px; color: #64748b; font-style: italic; margin: 0;">"<%= hw.teacher_remark %>"</p>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <div style="font-size: 11px; color: #64748b; font-style: italic;"><%- lan.Waiting_For_Grading %></div>
                                    <% } %>
                                    <% if (hw.submitted_file) { %>
                                        <div style="margin-top: 8px;">
                                            <a href="/<%= hw.submitted_file %>" target="_blank" style="color: #0891B2; text-decoration: none; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                                <i class="fas fa-file-download"></i> <%- lan.View_Submitted_File %>
                                            </a>
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <span style="background: #FEF3C7; color: #D97706; padding: 2px 10px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                        <i class="fas fa-clock"></i> <%- lan.Not_Submitted %>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="hw-card ss-card" style="padding: 48px; text-align: center;">
                <div style="color: #94A3B8; margin-bottom: 16px;"><i class="fas fa-book fa-4x"></i></div>
                <h5 style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;"><%- lan.No_Assignments_Found %></h5>
                <p style="font-size: 13px; color: #64748b; margin: 0;"><%- lan.No_Homework_Tasks_Matching %></p>
            </div>
        <% } %>
    </div>
</div>