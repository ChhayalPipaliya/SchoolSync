<!-- Hero Banner -->
<div style="background: linear-gradient(135deg, #0891b2, #075985); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(8,145,178,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">Homework & Assignments</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">Track assignments, submissions, and grades for <%= activeChild.first_name %> <%= activeChild.last_name %></p>
        </div>
        <% if (children && children.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <select name="studentId" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% children.forEach(child => { %>
                        <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name %> (<%= child.class_name %>-<%= child.section %>)
                        </option>
                    <% }) %>
                </select>
                <input type="hidden" name="status" value="<%= status %>">
            </form>
        <% } %>
    </div>
</div>

<!-- Stats summary Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <!-- Card 1: Total Assigned -->
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-list-ol"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Total Assigned</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.total %></span>
        </div>
    </div>
    <!-- Card 2: Pending -->
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-clock"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Pending</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.pending %></span>
        </div>
    </div>
    <!-- Card 3: Submitted -->
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #E6F4EA; color: #137333; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-check-double"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Submitted</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.submitted %></span>
        </div>
    </div>
    <!-- Card 4: Overdue -->
    <div class="ss-card" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fas fa-calendar-times"></i>
        </div>
        <div>
            <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Overdue</h3>
            <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= stats.overdue %></span>
        </div>
    </div>
</div>

<!-- Navigation Filter Tabs -->
<div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
    <a href="/parent/homework?status=all<%= activeChild ? '&studentId=' + activeChild.id : '' %>" 
       style="text-decoration: none; padding: 8px 20px; border-radius: 20px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; transition: all 0.2s;
              <%= status === 'all' ? 'background: #0891B2; color: #fff; box-shadow: 0 4px 6px rgba(8,145,178,0.25);' : 'background: #fff; color: #64748b; border: 1px solid #E2E8F0;' %>">
       All Assignments
    </a>
    <a href="/parent/homework?status=pending<%= activeChild ? '&studentId=' + activeChild.id : '' %>" 
       style="text-decoration: none; padding: 8px 20px; border-radius: 20px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; transition: all 0.2s;
              <%= status === 'pending' ? 'background: #0891B2; color: #fff; box-shadow: 0 4px 6px rgba(8,145,178,0.25);' : 'background: #fff; color: #64748b; border: 1px solid #E2E8F0;' %>">
       Pending (<%= stats.pending %>)
    </a>
    <a href="/parent/homework?status=submitted<%= activeChild ? '&studentId=' + activeChild.id : '' %>" 
       style="text-decoration: none; padding: 8px 20px; border-radius: 20px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; transition: all 0.2s;
              <%= status === 'submitted' ? 'background: #0891B2; color: #fff; box-shadow: 0 4px 6px rgba(8,145,178,0.25);' : 'background: #fff; color: #64748b; border: 1px solid #E2E8F0;' %>">
       Submitted (<%= stats.submitted %>)
    </a>
</div>

<!-- Homework List -->
<div style="display: flex; flex-direction: column; gap: 20px;">
    <% if (homeworks && homeworks.length > 0) { %>
        <% homeworks.forEach(hw => { 
            const isOverdue = new Date(hw.due_date) < new Date() && (!hw.submission_id || hw.submission_status === 'pending');
        %>
            <div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
                <div class="homework-grid">
                    <div>
                        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 12px;">
                            <span style="background: #ECFEFF; color: #0891B2; border: 1px solid #A5F3FC; padding: 4px 10px; border-radius: 9999px; font-size: 11px; font-weight: 600;">
                                <%= hw.subject_name %> (<%= hw.subject_code %>)
                            </span>
                            <span style="font-size: 12px; color: #64748b;"><i class="fas fa-user-tie" style="margin-right: 4px;"></i><%= hw.teacher_name %></span>
                            <span style="font-size: 12px; color: #64748b;"><i class="fas fa-calendar-alt" style="margin-right: 4px;"></i>Assigned: <%= new Date(hw.created_at).toLocaleDateString() %></span>
                        </div>
                        <h2 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;"><%= hw.title %></h2>
                        <p style="font-size: 13px; color: #475569; margin: 0 0 16px 0; line-height: 1.5;"><%= hw.description %></p>
                        
                        <% if (hw.homework_file) { %>
                            <a href="/<%= hw.homework_file %>" target="_blank" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-size: 12px; font-weight: 600; color: #0891B2; background: #ECFEFF; border: 1px solid #A5F3FC; padding: 6px 16px; border-radius: 20px;">
                                <i class="fas fa-paperclip"></i> Download Attachment
                            </a>
                        <% } %>
                    </div>

                    <div class="sidebar-info" style="border-left: 1px solid #F1F5F9; padding-left: 24px; display: flex; flex-direction: column; gap: 16px;">
                        <div>
                            <h4 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 6px 0; letter-spacing: 0.5px;">Due Date</h4>
                            <span style="font-size: 13px; font-weight: 700; color: <%= isOverdue ? '#DC2626' : '#1e293b' %>;">
                                <i class="fas fa-calendar-times" style="margin-right: 4px;"></i> <%= new Date(hw.due_date).toLocaleDateString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %>
                            </span>
                            <% if (isOverdue) { %>
                                <span style="background: #FEE2E2; color: #DC2626; padding: 2px 8px; border-radius: 9999px; font-size: 10px; font-weight: 600; margin-left: 6px; display: inline-block;">Overdue</span>
                            <% } %>
                        </div>

                        <div style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 14px; border-radius: 12px;">
                            <h4 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 10px 0; letter-spacing: 0.5px;">Submission Status</h4>
                            <% if (hw.submission_id && hw.submission_status !== 'pending') { %>
                                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
                                    <span style="background: #E6F4EA; color: #137333; padding: 2px 10px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                        <i class="fas fa-check-circle"></i> Submitted
                                    </span>
                                    <span style="font-size: 11px; color: #64748b;"><%= new Date(hw.submitted_at).toLocaleDateString() %></span>
                                </div>

                                <% if (hw.submission_status === 'graded') { %>
                                    <div style="border-top: 1px solid #E2E8F0; margin-top: 8px; padding-top: 8px;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                            <span style="font-size: 12px; font-weight: 600; color: #475569;">Marks:</span>
                                            <span style="background: #0891B2; color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 700;"><%= hw.marks_obtained %> Marks</span>
                                        </div>
                                        <% if (hw.teacher_remark) { %>
                                            <p style="font-size: 11px; color: #64748b; font-style: italic; margin: 0;">"<%= hw.teacher_remark %>"</p>
                                        <% } %>
                                    </div>
                                <% } else { %>
                                    <div style="font-size: 11px; color: #64748b; font-style: italic;">Waiting for grading...</div>
                                <% } %>

                                <% if (hw.submitted_file) { %>
                                    <div style="margin-top: 8px;">
                                        <a href="/<%= hw.submitted_file %>" target="_blank" style="color: #0891B2; text-decoration: none; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-file-download"></i> View Submitted File
                                        </a>
                                    </div>
                                <% } %>
                            <% } else { %>
                                <span style="background: #FEF3C7; color: #D97706; padding: 2px 10px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                    <i class="fas fa-clock"></i> Not Submitted
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="ss-card" style="padding: 48px; text-align: center; background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <div style="color: #94A3B8; margin-bottom: 16px;"><i class="fas fa-book fa-4x"></i></div>
            <h5 style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">No Assignments Found</h5>
            <p style="font-size: 13px; color: #64748b; margin: 0;">No active homework tasks matching this filter are registered for your child.</p>
        </div>
    <% } %>
</div>

<style>
    .homework-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }
    @media (max-width: 991px) {
        .homework-grid {
            grid-template-columns: 1fr;
        }
        .sidebar-info {
            border-left: none !important;
            padding-left: 0 !important;
            border-top: 1px solid #F1F5F9;
            padding-top: 16px;
        }
    }
</style>
