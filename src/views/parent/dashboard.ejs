                    <img src="<%= activeStudent.image %>" alt="<%= childName %>" style="width:100%;height:100%;object-fit:cover;">
                <% } else { %>
                    <%= childName.charAt(0).toUpperCase() %>
                <% } %>
            </div>
            <div>
                <h2 class="p-profile-name"><%= childName %></h2>
                <div class="p-profile-meta">
                    <span>Adm No: <strong><%= childAdm %></strong></span>
                    <span>·</span>
                    <span>Roll No: <strong><%= childRoll %></strong></span>
                    <span>·</span>
                    <span>Academic Year: <strong>2026-2027</strong></span>
                </div>
                <div class="p-profile-pills">
                    <span class="p-pill active"><i class="fas fa-check-circle"></i> Active Student</span>
                    <span class="p-pill info"><i class="fas fa-graduation-cap"></i> Class <%= childClass %></span>
                    <span class="p-pill purple"><i class="fas fa-shield-halved"></i> House: Blue Dragons</span>
                    <span class="p-pill info"><i class="fas fa-droplet"></i> Blood Group: O+</span>
                </div>
            </div>
        </div>
        <div>
            <a href="/parent/profile" style="background:#e0e7ff;color:#4338ca;padding:10px 18px;border-radius:12px;font-size:12px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
                View Full Profile →
            </a>
        </div>
    </section>
    <section class="p-summary-grid" aria-label="Quick Summary">
        <a href="/parent/attendance" class="p-stat-card">
