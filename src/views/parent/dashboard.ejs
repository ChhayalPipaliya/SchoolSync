    .p-tl-dot.running {
        box-shadow: 0 0 0 3px #10b981;
        background: #10b981;
    }

    .p-widget-card {
        background: var(--pr-card);
        border: 1px solid var(--pr-border);
        border-radius: 18px;
        padding: 18px 20px;
        box-shadow: var(--pr-shadow-sm);
    }

    .p-widget-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 14px;
        font-weight: 800;
        color: var(--pr-text);
    }

    .p-qa-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 12px;
    }

    .p-qa-btn {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 16px 10px;
        text-align: center;
        text-decoration: none;
        color: var(--pr-text);
        font-size: 11px;
        font-weight: 700;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        transition: transform 0.2s, background 0.2s;
    }

    .p-qa-btn:hover {
        transform: translateY(-2px);
        background: #ffffff;
        box-shadow: var(--pr-shadow-md);
    }

    @media (max-width: 1400px) {
        .p-summary-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @media (max-width: 1200px) {
        .p-main-layout {
            grid-template-columns: 1fr;
        }

        .p-hero-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .p-hero-chips {
            width: 100%;
        }

        .p-profile-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .p-qa-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @media (max-width: 768px) {
        .p-dash-container {
            gap: 16px !important;
            padding-bottom: 12px !important;
        }

        .p-hero-card {
            padding: 20px 16px !important;
            border-radius: 18px !important;
            gap: 16px !important;
        }

        .p-hero-title {
            font-size: 22px !important;
            line-height: 1.25 !important;
        }

        .p-hero-sub {
            font-size: 12.5px !important;
            margin-bottom: 16px !important;
        }

        .p-hero-actions {
            display: grid !important;
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 8px !important;
            width: 100% !important;
        }

        .p-hero-btn {
            width: 100% !important;
            justify-content: center !important;
            font-size: 11.5px !important;
            padding: 9px 8px !important;
            border-radius: 10px !important;
            box-sizing: border-box !important;
            text-align: center !important;
        }

        .p-hero-right {
            width: 100% !important;
            align-items: stretch !important;
        }

        .p-hero-chips {
            min-width: 0 !important;
            width: 100% !important;
            padding: 12px 10px !important;
            border-radius: 14px !important;
            display: grid !important;
            grid-template-columns: repeat(4, 1fr) !important;
            gap: 8px 4px !important;
            box-sizing: border-box !important;
        }

        .p-chip-val {
            font-size: 16px !important;
        }

        .p-chip-lbl {
            font-size: 8.5px !important;
        }

        .p-profile-card {
            padding: 16px 14px !important;
            border-radius: 16px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 14px !important;
        }

        .p-profile-left {
            display: flex !important;
            align-items: flex-start !important;
            gap: 14px !important;
            width: 100% !important;
        }

        .p-profile-avatar-large {
            width: 52px !important;
            height: 52px !important;
            font-size: 20px !important;
            flex-shrink: 0 !important;
        }

        .p-profile-name {
            font-size: 18px !important;
        }

        .p-profile-meta {
            font-size: 11px !important;
            gap: 6px 8px !important;
        }

        .p-profile-pills {
            display: flex !important;
            flex-wrap: wrap !important;
            gap: 6px !important;
            margin-top: 8px !important;
        }

        .p-pill {
            font-size: 10.5px !important;
            padding: 3px 8px !important;
        }

        .p-profile-btn-link {
            width: 100% !important;
            justify-content: center !important;
            text-align: center !important;
            padding: 9px 16px !important;
            border-radius: 10px !important;
            box-sizing: border-box !important;
        }

        .p-summary-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
        }

        .p-stat-card {
            padding: 12px 12px !important;
            border-radius: 14px !important;
        }

        .p-stat-val {
            font-size: 18px !important;
        }

        .p-stat-lbl {
            font-size: 10.5px !important;
        }

        .p-stat-icon {
            width: 32px !important;
            height: 32px !important;
            font-size: 13px !important;
        }

        .p-panel {
            padding: 16px 14px !important;
            border-radius: 16px !important;
        }

        .p-panel-title {
            font-size: 14.5px !important;
        }

        .p-dual-grid {
            grid-template-columns: 1fr !important;
            gap: 14px !important;
        }

        .p-att-grid {
            grid-template-columns: 1fr !important;
            gap: 12px !important;
        }

        .p-qa-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
        }
    }

    .p-hw-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .p-hw-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 13px 16px;
        background: #f8fafc;
        border: 1.5px solid #f1f5f9;
        border-radius: 16px;
        transition: transform 0.18s, box-shadow 0.18s, background 0.18s;
    }

    .p-hw-card:hover {
        transform: translateY(-2px);
        background: #ffffff;
        box-shadow: 0 6px 20px rgba(79,70,229,0.08);
        border-color: #e0e7ff;
    }

    .p-hw-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg,#ede9fe,#ddd6fe);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 17px;
        color: #7c3aed;
    }

    .p-hw-main {
        flex: 1;
        min-width: 0;
    }

    .p-hw-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--pr-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 3px;
    }

    .p-hw-meta {
        font-size: 11px;
        color: var(--pr-muted);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .p-hw-meta i {
        font-size: 10px;
    }

    .p-hw-badge {
        flex-shrink: 0;
        font-size: 10px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        letter-spacing: 0.04em;
    }

    .p-hw-badge.completed {
        background: #dcfce7;
        color: #15803d;
    }

    .p-hw-badge.pending {
        background: #fef9c3;
        color: #854d0e;
    }

    .p-hw-badge.overdue {
        background: #fee2e2;
        color: #b91c1c;
    }
</style>
<div class="p-dash-container">
    <section class="p-hero-card" aria-label="Parent Welcome Banner">
