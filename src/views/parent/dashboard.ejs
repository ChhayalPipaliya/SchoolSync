                <span class="p-stat-lbl">Attendance</span>
                <div class="p-stat-icon blue"><i class="fas fa-calendar-check"></i></div>
            </div>
            <div class="p-stat-val"><%= attStats.percentage %>%</div>
        </a>
        <a href="/parent/homework" class="p-stat-card">
            <div class="p-stat-top">
                <span class="p-stat-lbl">Hw Pending</span>
                <div class="p-stat-icon amber"><i class="fas fa-book-open"></i></div>
            </div>
            <div class="p-stat-val" style="color:#b45309;"><%= typeof hwList !=='undefined' && hwList !==null ? hwList.length : 0 %></div>
        </a>
        <a href="/parent/fees" class="p-stat-card">
            <div class="p-stat-top">
                <span class="p-stat-lbl">Fee Status</span>
                <div class="p-stat-icon rose"><i class="fas fa-receipt"></i></div>
            </div>
            <div class="p-stat-val" style="color:#be123c;">₹<%= feeInfo.pending %></div>
        </a>
        <a href="/parent/transport" class="p-stat-card">
            <div class="p-stat-top">
                <span class="p-stat-lbl">Live Bus</span>
                <div class="p-stat-icon emerald"><i class="fas fa-bus"></i></div>
            </div>
            <% if (tInfo && tInfo.active_trip_id) { %>
                <div class="p-stat-val" style="font-size:15px;color:#047857;">On Route</div>
            <% } else if (tInfo) { %>
                <div class="p-stat-val" style="font-size:14px;color:#64748b;">No Active Trip</div>
            <% } else { %>
                <div class="p-stat-val" style="font-size:14px;color:#94a3b8;">Not Assigned</div>
            <% } %>
        </a>
        <a href="/parent/results" class="p-stat-card">
            <div class="p-stat-top">
                <span class="p-stat-lbl">Upcoming Exams</span>
                <div class="p-stat-icon purple"><i class="fas fa-clipboard-list"></i></div>
            </div>
            <div class="p-stat-val"><%= (typeof upcomingExams !== 'undefined' && upcomingExams) ? upcomingExams.length : 0 %></div>
        </a>
        <a href="/parent/notices" class="p-stat-card">
            <div class="p-stat-top">
                <span class="p-stat-lbl">Notices</span>
                <div class="p-stat-icon amber"><i class="fas fa-bullhorn"></i></div>
            </div>
            <div class="p-stat-val"><%= typeof noticeList !=='undefined' && noticeList !==null ? noticeList.length : 0 %></div>
        </a>
        <a href="/parent/library" class="p-stat-card">
            <div class="p-stat-top">
                <span class="p-stat-lbl">Library Book</span>
                <div class="p-stat-icon indigo"><i class="fas fa-book"></i></div>
            </div>
            <div class="p-stat-val">1</div>
        </a>
        <a href="/parent/certificates" class="p-stat-card">
            <div class="p-stat-top">
                <span class="p-stat-lbl">Certificates</span>
                <div class="p-stat-icon emerald"><i class="fas fa-award"></i></div>
            </div>
            <div class="p-stat-val">6</div>
        </a>
    </section>
    <div class="p-main-layout">
        <div class="p-left-col">
            <div class="p-dual-grid">
                <div class="p-panel">
                    <div class="p-panel-header">
                        <h3 class="p-panel-title" style="font-size:15px;"><i class="fas fa-chart-pie"></i>Attendance Analytics</h3>
                    </div>
                    <div class="p-att-grid">
                        <div class="p-ring-box">
                            <svg width="120" height="120" viewBox="0 0 120 120" style="transform:rotate(-90deg);">
                                <circle cx="60" cy="60" r="48" fill="none" stroke="#f1f5f9" stroke-width="12" />
                                <circle cx="60" cy="60" r="48" fill="none" stroke="#4f46e5" stroke-width="12" stroke-linecap="round" stroke-dasharray="301.5" stroke-dashoffset="<%= 301.5 * (1 - (attStats.percentage / 100)) %>" />
                            </svg>
                            <div class="p-ring-center">
                                <div class="p-ring-pct"><%= attStats.percentage %>%</div>
                                <div class="p-ring-lbl">Overall</div>
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:8px;font-size:12px;">
                            <div style="display:flex;justify-content:space-between;background:#ecfdf5;padding:8px 12px;border-radius:10px;color:#047857;font-weight:700;">
                                <span><i class="fas fa-check-circle me-1"></i> Present Days</span>
                                <span><%= attStats.present || attStats.presentDays || 0 %> Days</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;background:#fef2f2;padding:8px 12px;border-radius:10px;color:#b91c1c;font-weight:700;">
                                <span><i class="fas fa-times-circle me-1"></i> Absent Days</span>
                                <span><%= attStats.absent || attStats.absentDays || 0 %> Days</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;background:#f8fafc;padding:8px 12px;border-radius:10px;color:#64748b;font-weight:700;">
                                <span><i class="fas fa-calendar me-1"></i> Total Working</span>
                                <span><%= attStats.totalDays || attStats.totalWorkingDays || 0 %> Days</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="p-panel">
                    <div class="p-panel-header">
                        <h3 class="p-panel-title" style="font-size:15px;"><i class="fas fa-award"></i> Academic Performance</h3>
                        <% if (typeof academicPerf !== 'undefined' && academicPerf && academicPerf.subjects && academicPerf.subjects.length > 0) { %>
                            <span style="font-size:11px;font-weight:700;background:#d1fae5;color:#047857;padding:3px 10px;border-radius:999px;"><%= academicPerf.overallGrade %></span>
                        <% } else { %>
                            <span style="font-size:11px;font-weight:700;background:#e0e7ff;color:#4338ca;padding:3px 10px;border-radius:999px;">Term Active</span>
                        <% } %>
                    </div>
                    <div class="p-perf-list">
                        <% if (typeof academicPerf !== 'undefined' && academicPerf && academicPerf.subjects && academicPerf.subjects.length > 0) { %>
                            <% academicPerf.subjects.forEach((sub) => { %>
                                <div class="p-perf-row">
                                    <div class="p-perf-header">
                                        <span><%= sub.subject %></span>
                                        <span class="p-perf-val" data-color="<%= sub.color || '#4f46e5' %>"><%= sub.percentage %>%</span>
                                    </div>
                                    <div class="p-perf-track">
                                        <div class="p-perf-fill" data-pct="<%= Math.min(100, Math.max(0, sub.percentage)) %>" data-color="<%= sub.color || '#4f46e5' %>"></div>
                                    </div>
                                </div>
                            <% }) %>
                            <script>
                            (function() {
                                document.querySelectorAll('.p-perf-val[data-color]').forEach(function(el) { el.style.color = el.getAttribute('data-color'); });
                                document.querySelectorAll('.p-perf-fill[data-pct]').forEach(function(el) { el.style.width = el.getAttribute('data-pct') + '%'; el.style.background = el.getAttribute('data-color'); });
                            })();
                            </script>
                        <% } else { %>
                            <div style="padding:30px 0;text-align:center;color:var(--pr-muted);font-size:12px;">
                                <i class="fas fa-chart-line" style="font-size:26px;color:#e2e8f0;display:block;margin-bottom:8px;"></i>
                                No published exam marks recorded yet.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="p-panel">
                <div class="p-panel-header">
                    <h3 class="p-panel-title"><i class="fas fa-clock"></i> Today's Schedule</h3>
                    <a href="/parent/timetable" class="p-panel-link">Full Schedule →</a>
                </div>
                <div class="p-timeline-list">
                    <% if (typeof todayScheduleList !== 'undefined' && todayScheduleList && todayScheduleList.length > 0) { %>
                        <% todayScheduleList.forEach((slot) => { const slotStat = getSlotStatus(slot.startTime, slot.endTime); %>
                            <div class="p-tl-item">
                                <% if (slotStat.key === 'completed') { %>
                                    <div class="p-tl-dot" style="background:#94a3b8;box-shadow:0 0 0 3px #94a3b8;"></div>
                                <% } else if (slotStat.key === 'running') { %>
                                    <div class="p-tl-dot running"></div>
                                <% } else { %>
                                    <div class="p-tl-dot"></div>
                                <% } %>
                                <div style="flex:1;display:flex;justify-content:space-between;align-items:center;">
                                    <div>
                                        <div style="font-size:14px;font-weight:700;"><%= slot.subject || 'Subject' %></div>
                                        <div style="font-size:12px;color:var(--pr-muted);">
                                            <%= slot.startTime || '' %> – <%= slot.endTime || '' %>
                                            <% if (slot.teacher) { %> · <%= slot.teacher %><% } %>
                                            <% if (slot.room) { %> · Room <%= slot.room %><% } %>
                                        </div>
                                    </div>
                                    <% if (slotStat.key === 'completed') { %>
                                        <span style="background:#f1f5f9;color:#64748b;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;"><%= slotStat.label %></span>
                                    <% } else if (slotStat.key === 'running') { %>
                                        <span style="background:#d1fae5;color:#047857;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;"><%= slotStat.label %></span>
                                    <% } else { %>
                                        <span style="background:#e0e7ff;color:#4338ca;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;"><%= slotStat.label %></span>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="padding:24px 0;text-align:center;color:var(--pr-muted);font-size:12px;">
                            <i class="fas fa-calendar-day" style="font-size:28px;color:#e2e8f0;display:block;margin-bottom:8px;"></i>
                            No classes scheduled for today.
                        </div>
                    <% } %>
                </div>
            </div>
            <% if (typeof transportInfo !== 'undefined' && transportInfo) { const tInfo = transportInfo; %>
                <div class="p-panel" style="background:linear-gradient(135deg,#f0f9ff 0%,#e0f2fe 100%);border:1.5px solid #bae6fd;">
                    <div class="p-panel-header">
                        <h3 class="p-panel-title" style="color:#0369a1;"><i class="fas fa-bus" style="color:#0284c7;"></i> Transport Info</h3>
                        <a href="/parent/transport" class="p-panel-link" style="color:#0284c7;">Track Live Map →</a>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:center;">
                        <div>
                            <div style="font-size:14px;font-weight:800;color:#0c4a6e;">Bus No: <%= tInfo.vehicle_number || 'N/A' %></div>
                            <div style="font-size:12px;color:#0369a1;margin-top:2px;">Route: <%= tInfo.route_name || 'N/A' %></div>
                            <div style="font-size:11px;color:#64748b;margin-top:2px;"><%= tInfo.start_point || '' %><% if (tInfo.start_point && tInfo.end_point) { %> → <% } %><%= tInfo.end_point || '' %></div>
                            <% if (tInfo.driver_name) { %>
                                <div style="font-size:12px;color:#0369a1;margin-top:4px;">Driver: <strong><%= tInfo.driver_name %></strong><% if (tInfo.driver_phone) { %> (<%= tInfo.driver_phone %>)<% } %></div>
                            <% } %>
                        </div>
                        <div style="background:#ffffff;padding:14px;border-radius:14px;border:1px solid #bae6fd;text-align:center;">
                            <% if (tInfo.active_trip_id) { %>
                                <div style="font-size:11px;font-weight:700;color:#059669;text-transform:uppercase;letter-spacing:0.05em;">Trip Active</div>
                                <div style="font-size:13px;font-weight:800;color:#065f46;margin-top:4px;"><%= tInfo.trip_type === 'pickup' ? 'Pickup in progress' : 'Drop in progress' %></div>
                                <div style="margin-top:4px;"><a href="/parent/transport" style="font-size:11px;color:#0284c7;text-decoration:none;">View Live Map →</a></div>
                            <% } else { %>
                                <div style="font-size:11px;font-weight:700;color:#0284c7;text-transform:uppercase;letter-spacing:0.05em;">Transport</div>
                                <div style="font-size:13px;font-weight:700;color:#0369a1;margin-top:4px;">Assigned</div>
                                <div style="font-size:11px;color:#64748b;margin-top:2px;">No active trip now</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
            <div class="p-panel">
                <div class="p-panel-header">
                    <h3 class="p-panel-title" style="font-size:15px;"><i class="fas fa-book-reader"></i> Recent Homework</h3>
                    <a href="/parent/homework" class="p-panel-link">View All →</a>
                </div>
                <div class="p-hw-list">
                    <% if (typeof homeworks !== 'undefined' && homeworks && homeworks.length > 0) { %>
                        <% homeworks.forEach(hw => {
                            const today = new Date(); today.setHours(0,0,0,0);
                            const due = hw.due_date ? new Date(hw.due_date) : null;
                            if (due) due.setHours(0,0,0,0);
                            const isSubmitted = hw.submission_status === 'submitted';
                            const isOverdue = !isSubmitted && due && due < today;
                            const badgeClass = isSubmitted ? 'completed' : (isOverdue ? 'overdue' : 'pending');
                            const badgeLabel = isSubmitted ? 'Done' : (isOverdue ? 'Overdue' : 'Pending');
                            const dueFmt = due ? due.toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : 'N/A';
                        %>
                            <div class="p-hw-card">
                                <div class="p-hw-icon"><i class="fas fa-book-open"></i></div>
                                <div class="p-hw-main">
                                    <div class="p-hw-title"><%= hw.title %></div>
                                    <div class="p-hw-meta">
                                        <i class="fas fa-atom"></i><%= hw.subject_name %>
                                        &nbsp;·&nbsp;
                                        <i class="fas fa-calendar-alt"></i> Due: <%= dueFmt %>
                                    </div>
                                </div>
                                <span class="p-hw-badge <%= badgeClass %>"><%= badgeLabel %></span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="text-align:center;padding:28px 0;color:var(--pr-muted);font-size:12px;">
                            <i class="fas fa-folder-open" style="font-size:28px;color:#e2e8f0;display:block;margin-bottom:8px;"></i>
                            No homework assigned yet
                        </div>
                    <% } %>
                </div>
            </div>
            <% if (typeof feeInfo !== 'undefined' && feeInfo) { %>
                <% 
                    const isFeeDue = Number(feeInfo.pending || 0) > 0;
                %>
                <div class="p-panel">
                    <div class="p-panel-header">
                        <h3 class="p-panel-title" style="font-size:15px;"><i class="fas fa-receipt"></i> Fee Status</h3>
                        <span class="<%= isFeeDue ? 'p-fee-badge-pending' : 'p-fee-badge-cleared' %>">
                            <%= isFeeDue ? 'PENDING' : 'CLEARED' %>
                        </span>
                    </div>
                    <div style="background:#f8fafc;padding:14px;border-radius:14px;display:flex;justify-content:space-between;align-items:center;">
                        <div>
                            <% if (Number(feeInfo.total || 0) > 0) { %>
                                <div style="font-size:11px;color:var(--pr-muted);margin-bottom:2px;">
                                    Total Annual Fee: <strong style="color:var(--pr-text, #1e293b);">₹<%= parseFloat(feeInfo.total).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></strong>
                                </div>
                            <% } %>
                            <div style="font-size:12px;color:var(--pr-muted);">
                                Outstanding: <strong class="<%= isFeeDue ? 'p-fee-amt-due' : 'p-fee-amt-paid' %>">₹<%= parseFloat(feeInfo.pending || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></strong>
                            </div>
                            <div style="font-size:11px;color:var(--pr-muted);margin-top:2px;"><%= isFeeDue ? 'Please clear your dues' : 'All dues cleared' %></div>
                        </div>
                        <a href="/parent/fees" style="background:#4f46e5;color:#fff;padding:8px 14px;border-radius:10px;font-size:12px;font-weight:700;text-decoration:none;"><%= isFeeDue ? 'Pay Now →' : 'View Ledger →' %></a>
                    </div>
                </div>
            <% } %>
        </div>
        <div class="p-right-col">
            <div class="p-widget-card">
                <div class="p-widget-header">
                    <span><i class="fas fa-clipboard-list" style="color:#7c3aed;margin-right:6px;"></i>Upcoming Exams</span>
                    <a href="/parent/results" style="font-size:11px;color:#4f46e5;font-weight:700;text-decoration:none;">Details</a>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <% if (typeof upcomingExams !== 'undefined' && upcomingExams && upcomingExams.length > 0) { %>
                        <% upcomingExams.forEach(ex => {
                            const exDate = ex.exam_date ? new Date(ex.exam_date) : null;
                            const todayEx = new Date(); todayEx.setHours(0,0,0,0);
                            const daysLeft = exDate ? Math.ceil((exDate - todayEx) / 86400000) : null;
                            const dateFmt = exDate ? exDate.toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) : 'TBD';
                        %>
                            <div style="background:#f8fafc;border-radius:10px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;border:1px solid #f1f5f9;transition:background 0.18s;" onmouseover="this.style.background='#fff'" onmouseout="this.style.background='#f8fafc'">
                                <div style="min-width:0;flex:1;margin-right:8px;">
                                    <div style="font-size:12px;font-weight:700;color:#0f172a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= ex.exam_name %></div>
                                    <div style="font-size:11px;color:#64748b;margin-top:2px;">
                                        <% if (ex.subject_name) { %><i class="fas fa-atom" style="margin-right:3px;"></i><%= ex.subject_name %> · <% } %>
                                        <i class="fas fa-calendar" style="margin-right:3px;"></i><%= dateFmt %>
                                    </div>
                                </div>
                                <% if (daysLeft !== null) { %>
                                    <span style="background:#ede9fe;color:#6d28d9;padding:4px 8px;border-radius:6px;font-size:10px;font-weight:700;white-space:nowrap;flex-shrink:0;">
                                        <% if (daysLeft === 0) { %>Today<% } else if (daysLeft === 1) { %>Tomorrow<% } else { %><%= daysLeft %> Days<% } %>
                                    </span>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="text-align:center;padding:24px 0;color:#64748b;font-size:12px;">
                            <i class="fas fa-calendar-check" style="font-size:26px;color:#e2e8f0;display:block;margin-bottom:8px;"></i>
                            No upcoming exams scheduled
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="p-widget-card">
                <div class="p-widget-header">
                    <span><i class="fas fa-bullhorn" style="color:#f59e0b;margin-right:6px;"></i>School Notices</span>
                    <a href="/parent/notices" style="font-size:11px;color:#4f46e5;font-weight:700;text-decoration:none;">View All</a>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <% const todayMidnight2 = new Date(); todayMidnight2.setHours(0,0,0,0);
                       const activeParentNotices = (noticeList || []).filter(n => !n.expiry_date || new Date(n.expiry_date) >= todayMidnight2);
                    %>
                    <% if (activeParentNotices && activeParentNotices.length > 0) { %>
                        <% activeParentNotices.slice(0, 5).forEach(notice => {
                            const noticeClass = (notice.priority === 'high' || notice.priority === 'urgent') ? 'p-notice-urgent' : ((notice.priority === 'medium') ? 'p-notice-medium' : 'p-notice-normal');
                        %>
                            <div class="<%= noticeClass %>">
                                <div style="font-size:12px;font-weight:700;"><%= notice.title %></div>
                                <div style="font-size:11px;color:var(--pr-muted);margin-top:2px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;line-clamp:2;-webkit-box-orient:vertical;"><%= notice.content || notice.message %></div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="text-align:center;padding:20px;color:var(--pr-muted);font-size:12px;">
                            <i class="fas fa-bell-slash" style="font-size:26px;color:#e2e8f0;display:block;margin-bottom:8px;"></i>
                            No active notices
                        </div>
                    <% } %>
                </div>
            </div>
            <div class="p-widget-card">
                <div class="p-widget-header">
                    <span><i class="fas fa-calendar-alt" style="color:#10b981;margin-right:6px;"></i>Upcoming Events</span>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;font-size:12px;">
                    <% if (typeof upcomingEvents !== 'undefined' && upcomingEvents && upcomingEvents.length > 0) { %>
                        <% upcomingEvents.forEach(ev => {
                            const evDate = ev.start_date ? new Date(ev.start_date).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : '';
                            const dotColor = ev.color || '#3b82f6';
                        %>
                            <div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:#f8fafc;border-radius:10px;">
                                <div class="p-ev-dot" data-color="<%= dotColor %>" style="width:8px;height:8px;border-radius:50%;background:#3b82f6;flex-shrink:0;"></div>
                                <div style="flex:1;font-weight:600;color:#0f172a;"><%= ev.title %></div>
                                <span style="font-size:11px;color:var(--pr-muted);white-space:nowrap;"><%= evDate %></span>
                            </div>
                        <% }) %>
                        <script>
                        (function() {
                            document.querySelectorAll('.p-ev-dot[data-color]').forEach(function(el) {
                                el.style.background = el.getAttribute('data-color');
                            });
                        })();
                        </script>
                    <% } else { %>
                        <div style="text-align:center;padding:16px 0;color:var(--pr-muted);">
                            <i class="fas fa-calendar" style="font-size:24px;color:#e2e8f0;display:block;margin-bottom:6px;"></i>
                            No upcoming events
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <section class="p-qa-grid" aria-label="Bottom Quick Actions">
        <button onclick="showIdCardModal()" class="p-qa-btn">
            <i class="fas fa-id-card" style="color:#3b82f6;font-size:20px;"></i>
            <span>Download ID Card</span>
        </button>
        <a href="/parent/fees" class="p-qa-btn">
            <i class="fas fa-receipt" style="color:#10b981;font-size:20px;"></i>
            <span>Pay Fees</span>
        </a>
        <a href="/parent/leaves" class="p-qa-btn">
            <i class="fas fa-paper-plane" style="color:#ec4899;font-size:20px;"></i>
            <span>Apply Leave</span>
        </a>
        <a href="/parent/transport" class="p-qa-btn">
            <i class="fas fa-bus" style="color:#f59e0b;font-size:20px;"></i>
            <span>Track Bus</span>
        </a>
        <a href="/parent/results" class="p-qa-btn">
            <i class="fas fa-award" style="color:#7c3aed;font-size:20px;"></i>
            <span>View Report Card</span>
        </a>
        <a href="/parent/certificates" class="p-qa-btn">
            <i class="fas fa-certificate" style="color:#06b6d4;font-size:20px;"></i>
            <span>Certificates</span>
        </a>
        <a href="/parent/chat" class="p-qa-btn">
            <i class="fas fa-comment-dots" style="color:#8b5cf6;font-size:20px;"></i>
            <span>Message Teacher</span>
        </a>
        <a href="/parent/chat" class="p-qa-btn">
            <i class="fas fa-headset" style="color:#3b82f6;font-size:20px;"></i>
            <span>Contact School</span>
        </a>
    </section>
</div>