<% const childList=typeof children !=='undefined' && children ? children : []; const activeStudent=typeof activeChild
    !=='undefined' && activeChild ? activeChild : (childList[0] || {}); const attStats=typeof attendanceStats
    !=='undefined' && attendanceStats ? attendanceStats : { percentage: 0, presentDays: 0, totalWorkingDays: 0 };
    const hwList=typeof homeworks !=='undefined' && homeworks ? homeworks : []; const feeInfo=typeof feeSummary
    !=='undefined' && feeSummary ? feeSummary : { pending: 0, total: 0, paid: 0 }; const noticeList=typeof notices
    !=='undefined' && notices ? notices : []; const parentName=(typeof user !=='undefined' && user && user.first_name) ?
    (user.first_name + ' ' + (user.last_name || '' )) : '' ; const childName=(activeStudent.first_name ?
    (activeStudent.first_name + ' ' + (activeStudent.last_name || '' )) : '' ); const
    childClass=(activeStudent.class_name ? (activeStudent.class_name + (activeStudent.section ? '-' + activeStudent.section : '' )) : '' );
    const childRoll=activeStudent.roll_no || activeStudent.rollNo || '' ; const childAdm=activeStudent.admission_no || '' ;
    const tInfo=typeof transportInfo !=='undefined' ? transportInfo : null;

  const parseMin = (tStr) => {
      if (!tStr) return 0;
      const str = String(tStr).trim().toUpperCase();
      const isPM = str.includes('PM');
      const isAM = str.includes('AM');
      const clean = str.replace(/AM|PM/g, '').trim();
      const parts = clean.split(':').map(n => parseInt(n, 10) || 0);
      let h = parts[0] || 0;
      const m = parts[1] || 0;
      if (isPM && h < 12) h += 12;
      if (isAM && h === 12) h = 0;
      return h * 60 + m;
  };

  const getSlotStatus = (startTime, endTime) => {
      const now = new Date();
      const currentMin = now.getHours() * 60 + now.getMinutes();
      const startMin = parseMin(startTime);
      const endMin = parseMin(endTime);

      if (currentMin >= endMin) {
          return { key: 'completed', label: 'Completed' };
      } else if (currentMin >= startMin && currentMin < endMin) {
          return { key: 'running', label: 'Running' };
      } else {
          return { key: 'upcoming', label: 'Upcoming' };
      }
  };
