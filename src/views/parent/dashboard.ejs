        display: flex;
        flex-direction: column;
        gap: 12px;
        position: relative;
    }

    .p-timeline-list::before {
        content: '';
        position: absolute;
        top: 10px;
        bottom: 10px;
        left: 19px;
        width: 2px;
        background: #e2e8f0;
        z-index: 1;
    }

