                <a href="/parent/dashboard?studentId=<%= child.id %>" class="p-child-tab <%= activeStudent && activeStudent.id === child.id ? 'active' : '' %>">
                    <div class="p-child-avatar">
                        <% if (child.image) { %>
                            <img src="<%= child.image %>" alt="<%= child.first_name %>" style="width:100%;height:100%;object-fit:cover;">
                        <% } else { %>
                            <%= child.first_name.charAt(0).toUpperCase() %>
                        <% } %>
                    </div>
                    <div>
                        <div style="font-size:13px;font-weight:700;color:var(--pr-text);">
                            <%= child.first_name %>
                            <%= child.last_name || '' %>
