                <span><%- lan.SchoolSync_Parent_Portal_ERP %></span>
            </div>
            <h1 class="p-hero-title">
                <%- lan.Good_Afternoon %>, <%= parentName %>! 👋
            </h1>
            <p class="p-hero-sub">
                <%- lan.Parent_Dashboard_Hero_Sub %>
            </p>
            <div class="p-hero-actions">
                <a href="#idCard" onclick="alert('Student ID Card: <%= childName %> (Roll No <%= childRoll %>, Class <%= childClass %>)')" class="p-hero-btn"><i class="fas fa-id-card"></i> <%- lan.Download_ID_Card %></a>
                <a href="/parent/fees" class="p-hero-btn outline"><i class="fas fa-receipt"></i> <%- lan.Pay_Fees %></a>
                <a href="/parent/chat" class="p-hero-btn outline"><i class="fas fa-headset"></i> <%- lan.Contact_School %></a>
                <a href="/parent/chat" class="p-hero-btn outline"><i class="fas fa-comment-dots"></i> <%- lan.Message_Teacher %></a>
            </div>
        </div>
        <div class="p-hero-right" style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;">
            <%- include('../partials/hero-illustration', { illustrationSrc: '/illustrations/parent.png' , illustrationAlt: 'Parent Dashboard' }) %>
            <div class="p-hero-chips">
                <div class="p-chip-item">
                    <span class="p-chip-val">
                        <%= attStats.percentage %>%
                    </span>
                    <span class="p-chip-lbl"><%- lan.Attendance %></span>
                </div>
                <div class="p-chip-item">
                    <span class="p-chip-val">
                        <%= typeof hwList !=='undefined' && hwList !==null ? hwList.length : 0 %>
                    </span>
                    <span class="p-chip-lbl"><%- lan.Hw_Pending %></span>
                </div>
                <div class="p-chip-item">
                    <span class="p-chip-val" style="color:#fca5a5;">₹<%= feeInfo.pending %></span>
                    <span class="p-chip-lbl"><%- lan.Fee_Due %></span>
                </div>
                <div class="p-chip-item">
                    <span class="p-chip-val" style="color:#6ee7b7;font-size:14px;">
                        <% if (tInfo && tInfo.active_trip_id) { %><%- lan.On_Route %><% } else if (tInfo) { %><%- lan.No_Trip %><% } else { %><%- lan.Not_Assigned %><% } %>
                    </span>
                    <span class="p-chip-lbl"><%- lan.Bus_Status %></span>
                </div>
                <div class="p-chip-item">
                    <span class="p-chip-val">
                        <%= (typeof upcomingExams !== 'undefined' && upcomingExams) ? upcomingExams.length : 0 %>
                    </span>
                    <span class="p-chip-lbl"><%- lan.Exams %></span>
                </div>
                <div class="p-chip-item">
                    <span class="p-chip-val">
                        <%= typeof noticeList !=='undefined' && noticeList !==null ? noticeList.length : 0 %>
                    </span>
                    <span class="p-chip-lbl"><%- lan.Notices %></span>
                </div>
                <div class="p-chip-item">
                    <span class="p-chip-val">1</span>
                    <span class="p-chip-lbl"><%- lan.Library %></span>
                </div>
                <div class="p-chip-item">
                    <span class="p-chip-val" style="color:#fde047;">6</span>
                    <span class="p-chip-lbl"><%- lan.Certificates %></span>
                </div>
            </div>
        </div>
    </section>
