<!-- Hero Banner -->
<div style="background: linear-gradient(135deg, #0891b2, #075985); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(8,145,178,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1;">
        <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">Parent Dashboard</h1>
        <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">Overview of your children's academics, attendance, and fees</p>
    </div>
</div>

<% if (children && children.length > 1) { %>
    <!-- Child Switcher cards grid -->
    <div class="parent-child-switcher" style="display: flex; gap: 16px; margin-bottom: 24px; overflow-x: auto; padding-bottom: 8px;">
        <% children.forEach(child => { %>
            <a href="/parent/dashboard?studentId=<%= child.id %>" style="text-decoration: none; flex: 0 0 250px;">
                <div class="card child-switcher-card <%= activeChild && activeChild.id === child.id ? 'active' : '' %>" style="border-radius: 12px; padding: 16px; transition: all 0.2s; border: 2px solid <%= activeChild && activeChild.id === child.id ? '#0891B2' : '#E2E8F0' %>; background: #fff; display: flex; align-items: center; gap: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
                    <div style="width: 48px; height: 48px; border-radius: 50%; background: <%= activeChild && activeChild.id === child.id ? 'linear-gradient(135deg, #0891B2, #0E7490)' : '#E2E8F0' %>; color: <%= activeChild && activeChild.id === child.id ? '#fff' : '#475569' %>; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px; overflow: hidden; flex-shrink: 0;">
                        <% if (child.image) { %>
                            <img src="<%= child.image %>" alt="<%= child.first_name %>" style="width: 48px; height: 48px; object-fit: cover;">
                        <% } else { %>
                            <%= child.first_name.charAt(0).toUpperCase() %>
                        <% } %>
                    </div>
                    <div style="overflow: hidden;">
                        <h4 style="font-size: 14px; font-weight: 700; margin: 0; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= child.first_name %> <%= child.last_name %></h4>
                        <span style="font-size: 12px; color: #64748b;">Class: <%= child.class_name %> - <%= child.section %></span>
                    </div>
                </div>
            </a>
        <% }) %>
    </div>
<% } %>

<% if (activeChild) { %>
    <!-- Active Child Detail -->
    <div class="ss-card parent-active-child" style="margin-bottom: 24px; padding: 24px; border-radius: 16px; background: #fff; display: flex; justify-content: space-between; align-items: center; gap: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div>
            <h2 style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">Tracking Student: <%= activeChild.first_name %> <%= activeChild.last_name %></h2>
            <p style="font-size: 13px; color: #64748b; margin: 0 0 16px 0;">Admission Number: <strong><%= activeChild.admission_no %></strong> | Roll Number: <strong><%= activeChild.roll_no %></strong></p>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <span style="background: #ECFEFF; color: #0891B2; border: 1px solid #A5F3FC; padding: 6px 12px; border-radius: 9999px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fas fa-school"></i> Class: <%= activeChild.class_name %> - <%= activeChild.section %>
                </span>
                <span style="background: #E6F4EA; color: #137333; border: 1px solid #C2E7D9; padding: 6px 12px; border-radius: 9999px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fas fa-check-circle"></i> Status: Active
                </span>
            </div>
        </div>
        <div style="flex-shrink: 0; width: 64px; height: 64px; border-radius: 50%; background: #ECFEFF; border: 2px solid #0891B2; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; overflow: hidden;">
            <% if (activeChild.image) { %>
                <img src="<%= activeChild.image %>" alt="<%= activeChild.first_name %>" style="width: 64px; height: 64px; object-fit: cover;">
            <% } else { %>
                <%= activeChild.first_name.charAt(0).toUpperCase() %>
            <% } %>
        </div>
    </div>

    <!-- Stats row -->
    <div class="parent-stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px;">
        <!-- Card 1: Attendance -->
        <a href="/parent/attendance" style="text-decoration: none;">
            <div class="ss-card hover-up" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); height: 100%;">
                <div style="width: 48px; height: 48px; border-radius: 50%; background: #ECFEFF; color: #0891B2; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div>
                    <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Attendance %</h3>
                    <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= attendanceStats.percentage %>%</span>
                </div>
            </div>
        </a>
        <!-- Card 2: Pending Fees -->
        <a href="/parent/fees" style="text-decoration: none;">
            <div class="ss-card hover-up" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); height: 100%;">
                <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <div>
                    <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Pending Fees</h3>
                    <span style="font-size: 20px; font-weight: 700; color: #0f172a;">₹<%= feeSummary.pending %></span>
                </div>
            </div>
        </a>
        <!-- Card 3: Homework Tasks -->
        <a href="/parent/homework" style="text-decoration: none;">
            <div class="ss-card hover-up" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); height: 100%;">
                <div style="width: 48px; height: 48px; border-radius: 50%; background: #E6F4EA; color: #137333; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                    <i class="fas fa-book"></i>
                </div>
                <div>
                    <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Homework</h3>
                    <span style="font-size: 20px; font-weight: 700; color: #0f172a;"><%= homeworks.length %> Recent</span>
                </div>
            </div>
        </a>
        <!-- Card 4: GPS Tracking -->
        <a href="/parent/transport" style="text-decoration: none;">
            <div class="ss-card hover-up" style="background: #fff; padding: 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); height: 100%;">
                <div style="width: 48px; height: 48px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">
                    <i class="fas fa-bus animate-pulse"></i>
                </div>
                <div>
                    <h3 style="font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; margin: 0 0 4px 0; letter-spacing: 0.5px;">Live Bus GPS</h3>
                    <span style="font-size: 14px; font-weight: 700; color: #0891B2; display: flex; align-items: center; gap: 4px;">Track Bus <i class="fas fa-arrow-right"></i></span>
                </div>
            </div>
        </a>
    </div>

    <!-- Details Grid -->
    <div class="parent-details-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        <!-- Homework Panel -->
        <div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden; display: flex; flex-direction: column;">
            <div style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9; display: flex; justify-content: space-between; align-items: center; background: #fff;">
                <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-tasks" style="color: #0891B2;"></i> Recent Homework
                </h3>
                <a href="/parent/homework" style="color: #0891B2; font-size: 13px; font-weight: 600; text-decoration: none;">View All</a>
            </div>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                    <thead>
                        <tr style="border-bottom: 1px solid #F1F5F9; background: #F8FAFC;">
                            <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Subject</th>
                            <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Title</th>
                            <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Due Date</th>
                            <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (homeworks && homeworks.length > 0) { %>
                            <% homeworks.forEach(hw => { %>
                                <tr style="border-bottom: 1px solid #F1F5F9;">
                                    <td style="padding: 14px 20px;">
                                        <span style="background: #ECFEFF; color: #0891B2; border: 1px solid #A5F3FC; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; text-transform: capitalize;">
                                            <%= hw.subject_name %>
                                        </span>
                                    </td>
                                    <td style="padding: 14px 20px; color: #1e293b; font-weight: 600;"><%= hw.title %></td>
                                    <td style="padding: 14px 20px; color: #64748b;"><%= new Date(hw.due_date).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) %></td>
                                    <td style="padding: 14px 20px;">
                                        <% if (hw.submission_status === 'completed' || hw.submission_status === 'graded' || hw.submission_status === 'submitted') { %>
                                            <span style="background: #E6F4EA; color: #137333; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                                <i class="fas fa-check"></i> Submitted
                                            </span>
                                        <% } else { %>
                                            <span style="background: #FEF3C7; color: #D97706; padding: 4px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                                <i class="fas fa-clock"></i> Pending
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 24px; color: #64748b;">No homework assigned recently.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Notices Panel -->
        <div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); display: flex; flex-direction: column;">
            <div style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9; display: flex; justify-content: space-between; align-items: center; background: #fff;">
                <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-bullhorn" style="color: #0891B2;"></i> School Notice Board
                </h3>
                <a href="/parent/notices" style="color: #0891B2; font-size: 13px; font-weight: 600; text-decoration: none;">View All</a>
            </div>
            <div style="padding: 20px; display: flex; flex-direction: column; gap: 16px;">
                <% if (notices && notices.length > 0) { %>
                    <% notices.forEach(notice => { %>
                        <div style="border-bottom: 1px solid #F1F5F9; padding-bottom: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                <h4 style="font-size: 13px; font-weight: 700; color: #1e293b; margin: 0;"><%= notice.title %></h4>
                                <span style="font-size: 10px; color: #64748b;"><%= new Date(notice.created_at).toLocaleDateString() %></span>
                            </div>
                            <p style="font-size: 13px; color: #64748b; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= notice.message %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div style="text-align: center; padding: 24px; color: #64748b; font-size: 13px;">No school notices published.</div>
                <% } %>
            </div>
        </div>
    </div>
<% } else { %>
    <div class="ss-card" style="padding: 48px; text-align: center; background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="color: #94A3B8; margin-bottom: 16px;"><i class="fas fa-user-friends fa-4x"></i></div>
        <h5 style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">No Registered Children Found</h5>
        <p style="font-size: 13px; color: #64748b; margin: 0;">Please verify that your email is registered as the parent email inside your children's profiles.</p>
    </div>
<% } %>

<style>
    .hover-up { transition: transform 0.2s; }
    .hover-up:hover { transform: translateY(-4px); }

    @media (max-width: 480px) {
        .parent-child-switcher a {
            flex-basis: 220px !important;
        }

        .parent-active-child {
            flex-direction: column !important;
            align-items: flex-start !important;
            padding: 18px !important;
        }

        .parent-active-child > div:last-child {
            align-self: center;
        }

        .parent-stats-grid,
        .parent-details-grid {
            grid-template-columns: 1fr !important;
            gap: 16px !important;
        }

        .parent-details-grid table {
            min-width: 560px;
        }
    }
</style>
