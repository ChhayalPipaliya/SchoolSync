<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | SchoolSync</title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #f8fafc;
            font-family: 'Inter', sans-serif;
            color: #111827;
        }
        #container {
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
        }
        #header {
            height: 50px;
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            box-shadow: 0 1px 8px rgba(15,23,42,0.12); border-bottom: 1px solid #e5e7eb;
            z-index: 10;
        }
        #title-area {
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 1;
            overflow: hidden;
            margin-right: 10px;
        }
        #meeting-title {
            font-weight: 700;
            font-size: 14px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        #badge {
            background-color: #ECFEFF;
            border: 1px solid #A5F3FC;
            color: #0891B2;
            font-size: 10px;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            text-transform: uppercase;
        }
        #meet {
            flex: 1;
            width: 100%;
            height: 100%;
        }
        .btn-leave {
            background-color: #e11d48;
            color: #ffffff;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.2s;
        }
        .btn-leave:hover {
            background-color: #be123c;
        }
        .btn-confirm {
            background-color: #059669;
            color: #ffffff;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.2s;
        }
        .btn-confirm:hover {
            background-color: #047857;
        }
        .btn-confirmed {
            background-color: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: default;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-confirm:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .status-msg {
            font-size: 12px;
            color: #94A3B8;
        }
        .status-msg.success {
            color: #047857;
        }
        .status-msg.error {
            color: #be123c;
        }
    </style>
    <!-- Jitsi External API Script -->
    <script src="https://<%= jitsiDomain %>/external_api.js"></script>
</head>
<body>
    <div id="container">
        <div id="header">
            <div id="title-area">
                <span id="badge">Parent</span>
                <span id="meeting-title"><%= meeting.title %></span>
            </div>
            <button class="btn-leave" onclick="confirmLeave()">
                <i class="fa-solid fa-phone-slash"></i> Leave Room
            </button>
        </div>
        <div id="meet"></div>
        <!-- Confirm Attendance -->
        <div style="display: flex; align-items: center; gap: 12px; padding: 16px; background: #ffffff; border-top: 1px solid #e5e7eb;" id="confirmAttendanceSection">
          <button id="confirmBtn" onclick="confirmMyAttendance()" class="btn-confirm">
            <i class="fas fa-check-circle"></i> Confirm I'm Present
          </button>
          <span id="confirmStatus" class="status-msg" style="display: none;"></span>
        </div>
    </div>

    <script>
        const meetingId = '<%= meeting.id %>';
        let api = null;
        let isLeaving = false;

        document.addEventListener("DOMContentLoaded", () => {
            const domain = '<%= jitsiDomain %>';
            const options = {
                roomName: '<%= meeting.room_name %>',
                width: '100%',
                height: '100%',
                parentNode: document.querySelector('#meet'),
                userInfo: {
                    displayName: '<%= user.name || (user.first_name + " " + (user.last_name || "")) %>'
                },
                configOverwrite: {
                    startWithAudioMuted: false,
                    startWithVideoMuted: false,
                    prejoinPageEnabled: false
                },
                interfaceConfigOverwrite: {
                    TOOLBAR_BUTTONS: [
                        'microphone', 'camera', 'closedcaptions', 'fullscreen',
                        'fodeviceselection', 'hangup', 'profile', 'chat', 'settings',
                        'videoquality', 'filmstrip', 'feedback', 'stats', 'shortcuts',
                        'tileview', 'videobackgroundblur', 'download', 'help'
                    ]
                }
            };

            api = new JitsiMeetExternalAPI(domain, options);

            api.addEventListener('readyToClose', () => {
                triggerLeaveAndExit();
            });

            startHeartbeat();
        });

        function startHeartbeat() {
            setInterval(() => {
                if (isLeaving) return;
                fetch(`/api/meetings/${meetingId}/heartbeat`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                }).catch(err => console.error('Heartbeat failed:', err));
            }, 60000);
        }

        function triggerLeaveAndExit() {
            if (isLeaving) return;
            isLeaving = true;
            
            fetch(`/api/meetings/${meetingId}/leave`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).finally(() => {
                window.location.href = '/parent/meetings/' + meetingId;
            });
        }

        function confirmLeave() {
            if (confirm("Are you sure you want to leave the meeting room?")) {
                triggerLeaveAndExit();
            }
        }

        window.addEventListener('beforeunload', () => {
            if (!isLeaving) {
                navigator.sendBeacon(`/api/meetings/${meetingId}/leave`);
            }
        });
    </script>

<script>
async function confirmMyAttendance() {
  const btn = document.getElementById('confirmBtn');
  const status = document.getElementById('confirmStatus');
  if (!btn || !status) return;

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Confirming...';

  try {
    const res = await fetch(`/api/meetings/<%= meeting.id %>/confirm-attendance`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();

    status.style.display = 'inline';
    if (data.success) {
      btn.innerHTML = '<i class="fas fa-check-circle"></i> Present';
      btn.className = 'btn-confirmed';
      btn.disabled = true;
      status.textContent = 'Attendance confirmed successfully';
      status.className = 'status-msg success';
    } else {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirm I\'m Present';
      status.textContent = data.message || 'Failed to confirm';
      status.className = 'status-msg error';
    }
  } catch {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirm I\'m Present';
    status.textContent = 'Request failed. Try again.';
    status.style.display = 'inline';
    status.className = 'status-msg error';
  }
}
</script>
</body>
</html>
