<style>
  .meeting-badge {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .badge-scheduled {
    background: #ECFEFF;
    color: #0891B2;
    border: 1px solid #A5F3FC;
  }
  .badge-live {
    background: #E6F4EA;
    color: #137333;
    border: 1px solid #C2E7D9;
  }
  .badge-completed {
    background: #F1F5F9;
    color: #475569;
  }
  .badge-default {
    background: #F1F5F9;
    color: #475569;
  }

  [data-theme="dark"],
  .light-mode-disabled,
  html[data-theme="dark"],
  html.dark {
      --meet-card-bg: #151D30;
      --meet-inner-bg: #101726;
      --meet-border: #242F4D;
      --meet-text: #F8FAFC;
      --meet-muted: #94A3B8;
  }

  [data-theme="dark"] .ss-card,
  .light-mode-disabled .ss-card {
      background: #151D30 !important;
      border-color: #242F4D !important;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
  }

  [data-theme="dark"] h2,
  [data-theme="dark"] h3,
  .light-mode-disabled h2,
  .light-mode-disabled h3 {
      color: #F8FAFC !important;
  }

  [data-theme="dark"] .meeting-desc-box,
  .light-mode-disabled .meeting-desc-box {
      background: #101726 !important;
      border-color: #242F4D !important;
      color: #CBD5E1 !important;
  }

  [data-theme="dark"] .meeting-grid-item,
  .light-mode-disabled .meeting-grid-item {
      background: #101726 !important;
      border-color: #242F4D !important;
  }
  [data-theme="dark"] .meeting-grid-item .m-title,
  .light-mode-disabled .meeting-grid-item .m-title {
      color: #F8FAFC !important;
  }
  [data-theme="dark"] .meeting-grid-item .m-label,
  .light-mode-disabled .meeting-grid-item .m-label {
      color: #94A3B8 !important;
  }

  [data-theme="dark"] .meeting-btn-back,
  .light-mode-disabled .meeting-btn-back {
      background: #101726 !important;
      border-color: #242F4D !important;
      color: #CBD5E1 !important;
  }
</style>
<div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); max-width: 768px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-info-circle" style="color: #0891B2;"></i> Meeting Details
        </h2>
        <a href="/parent/meetings" class="meeting-btn-back" style="text-decoration: none; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; color: #475569; background: #F1F5F9; border: 1px solid #E2E8F0; display: inline-flex; align-items: center; gap: 4px;">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
    <div style="display: flex; flex-direction: column; gap: 20px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <span class="meeting-badge <%= meeting.status === 'scheduled' ? 'badge-scheduled' : meeting.status === 'live' ? 'badge-live' : meeting.status === 'completed' ? 'badge-completed' : 'badge-default' %>">
                    <%= meeting.status %>
                </span>
            </div>
            <h3 style="font-size: 20px; font-weight: 700; color: #1e293b; margin: 0 0 4px 0;"><%= meeting.title %></h3>
            <p style="font-size: 12px; color: #64748b; margin: 0;">Scheduled by <strong><%= creatorName %></strong></p>
        </div>
        <% if (meeting.description) { %>
            <div class="meeting-desc-box" style="padding: 16px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; font-size: 13px; color: #475569; line-height: 1.6;">
                <%= meeting.description %>
            </div>
        <% } %>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
            <div class="meeting-grid-item" style="display: flex; gap: 12px; align-items: center; padding: 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px;">
                <i class="far fa-calendar text-primary fa-lg" style="color: #0891B2; font-size: 20px;"></i>
                <div>
                    <div class="m-label" style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Scheduled Time</div>
                    <div class="m-title" style="font-size: 13px; font-weight: 700; color: #1e293b; margin-top: 2px;">
                        <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                    </div>
                </div>
            </div>
            <div class="meeting-grid-item" style="display: flex; gap: 12px; align-items: center; padding: 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px;">
                <i class="far fa-clock fa-lg" style="color: #7C3AED; font-size: 20px;"></i>
                <div>
                    <div class="m-label" style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Duration</div>
                    <div class="m-title" style="font-size: 13px; font-weight: 700; color: #1e293b; margin-top: 2px;"><%= meeting.duration_minutes %> Minutes</div>
                </div>
            </div>
            <div class="meeting-grid-item" style="display: flex; gap: 12px; align-items: center; padding: 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px;">
                <i class="fas fa-users fa-lg" style="color: #0891B2; font-size: 20px;"></i>
                <div>
                    <div class="m-label" style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Audience</div>
                    <div class="m-title" style="font-size: 13px; font-weight: 700; color: #1e293b; margin-top: 2px; text-transform: capitalize;"><%= targetDisplay %></div>
                </div>
            </div>
            <div class="meeting-grid-item" style="display: flex; gap: 12px; align-items: center; padding: 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px;">
                <i class="fas fa-video fa-lg" style="color: #10B981; font-size: 20px;"></i>
                <div>
                    <div class="m-label" style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Status</div>
                    <div class="m-title" style="font-size: 13px; font-weight: 700; color: #1e293b; margin-top: 2px; text-transform: capitalize;"><%= meeting.status %></div>
                </div>
            </div>
        </div>
        <% if (attendance) { %>
            <div style="background: #ECFEFF; border: 1px solid #A5F3FC; border-left: 4px solid #0891B2; border-radius: 12px; padding: 16px; margin-top: 16px;">
                <div style="font-size: 12px; font-weight: 700; color: #0891B2; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                    <i class="fas fa-check-circle"></i> Your Attendance Log
                </div>
                <div style="font-size: 12px; color: #0E7490; opacity: 0.9;">
                    Joined at: <%= new Date(attendance.joined_at).toLocaleString('en-IN') %>
                    <% if (attendance.left_at) { %>
                        · Left at: <%= new Date(attendance.left_at).toLocaleString('en-IN') %>
                    <% } %>
                    · Total duration: <strong><%= attendance.duration_minutes %> mins</strong>
                </div>
            </div>
        <% } %>
        <div style="border-top: 1px solid #F1F5F9; padding-top: 24px; margin-top: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;">
            <%
                const startMs = new Date(meeting.scheduled_at).getTime();
                const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                const now = Date.now();
                const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
            %>
            <% if (canJoin) { %>
                <p style="font-size: 12px; color: #64748b; margin: 0;">The meeting room is currently open.</p>
                <a href="/parent/meetings/<%= meeting.id %>/join" style="text-decoration: none; padding: 10px 32px; border-radius: 8px; font-size: 13px; font-weight: 700; color: #fff; background: #137333; border: 1px solid #137333; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 6px rgba(19,115,51,0.25);">
                    <i class="fas fa-video"></i> Join Meeting Room
                </a>
            <% } else if (meeting.status === 'cancelled') { %>
                <p style="font-size: 12px; color: #DC2626; font-weight: 600; margin: 0;">This meeting has been cancelled.</p>
                <button style="padding: 10px 32px; border-radius: 8px; font-size: 13px; font-weight: 700; color: #94A3B8; background: #F1F5F9; border: 1px solid #E2E8F0; cursor: not-allowed; opacity: 0.6;" disabled>Join Unavailable</button>
            <% } else if (meeting.status === 'completed') { %>
                <p style="font-size: 12px; color: #64748b; margin: 0;">This meeting has already completed.</p>
                <button style="padding: 10px 32px; border-radius: 8px; font-size: 13px; font-weight: 700; color: #94A3B8; background: #F1F5F9; border: 1px solid #E2E8F0; cursor: not-allowed; opacity: 0.6;" disabled>Meeting Completed</button>
            <% } else { %>
                <p style="font-size: 12px; color: #64748b; margin: 0;">Join window opens 15 minutes before the start time.</p>
                <button style="padding: 10px 32px; border-radius: 8px; font-size: 13px; font-weight: 700; color: #94A3B8; background: #F1F5F9; border: 1px solid #E2E8F0; cursor: not-allowed; opacity: 0.6;" disabled>Join Not Open</button>
            <% } %>
        </div>
    </div>
</div>