<style>
    .res-header-card {
        background: linear-gradient(135deg, #0891b2, #075985);
        border-radius: 12px;
        padding: 24px;
        color: #ffffff;
        margin-bottom: 10px;
        position: relative;
        overflow: hidden;
    }
    .res-header-bg-circle {
        position: absolute;
        right: -30px;
        top: -30px;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
    }
    .res-header-inner {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }
    .res-select-card {
        background: #ffffff;
        padding: 14px 20px;
        border-radius: 14px;
        border: 1px solid #E2E8F0;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }
    .res-summary-card {
        background: linear-gradient(135deg, #0891b2, #075985);
        color: #ffffff;
        padding: 22px 24px;
        border-radius: 16px;
        margin-bottom: 10px;
        position: relative;
        overflow: hidden;
    }
    .res-summary-c1 {
        position: absolute;
        top: -20px;
        right: -20px;
        width: 120px;
        height: 120px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
    }
    .res-summary-c2 {
        position: absolute;
        bottom: -30px;
        left: 40%;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
    }
    .res-summary-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 20px;
        align-items: center;
        text-align: center;
    }
    .res-status-text {
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 2px;
    }
    .res-status-text.pass {
        color: #86EFAC;
    }
    .res-status-text.fail {
        color: #FCA5A5;
    }
    .res-progress-container {
        position: relative;
        z-index: 1;
        margin-top: 18px;
    }
    .res-progress-track {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        height: 8px;
        overflow: hidden;
    }
    .res-progress-bar {
        height: 100%;
        border-radius: 10px;
        transition: width 0.8s ease;
    }
    .res-progress-bar.pass {
        background: #86EFAC;
    }
    .res-progress-bar.fail {
        background: #FCA5A5;
    }
    .res-status-pill {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }
    .res-status-pill.pass {
        background: #E6F4EA;
        color: #137333;
    }
    .res-status-pill.fail {
        background: #FEE2E2;
        color: #DC2626;
    }
    .grade-ref-box {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1.5px solid #F1F5F9;
        background: #F8FAFC;
        transition: all 0.2s ease;
    }
    .grade-ref-box .g-name {
        font-size: 12px;
        font-weight: 800;
        color: #334155;
        min-width: 22px;
    }
    .grade-ref-box .g-range {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
    }
    .grade-ref-box.active {
        border-color: #0891B2;
        background: #ECFEFF;
    }
    .grade-ref-box.active .g-name,
    .grade-ref-box.active .g-range {
        color: #0891B2;
    }

    [data-theme="dark"],
    .light-mode-disabled,
    html[data-theme="dark"],
    html.dark {
        --res-card-bg: #151D30;
        --res-inner-bg: #101726;
        --res-border: #242F4D;
        --res-text: #F8FAFC;
        --res-muted: #94A3B8;
    }

    [data-theme="dark"] .res-select-card,
    .light-mode-disabled .res-select-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .res-select-label,
    .light-mode-disabled .res-select-label {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .res-select-input,
    .light-mode-disabled .res-select-input {
        background: #101726 !important;
        border-color: #242F4D !important;
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .res-table-card,
    .light-mode-disabled .res-table-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .res-table-header-box,
    .light-mode-disabled .res-table-header-box {
        background: #151D30 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .res-table-title,
    .light-mode-disabled .res-table-title {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .res-table-thead-tr,
    .light-mode-disabled .res-table-thead-tr {
        background: #101726 !important;
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .res-table-thead-tr th,
    .light-mode-disabled .res-table-thead-tr th {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .res-table-tbody-tr,
    .light-mode-disabled .res-table-tbody-tr {
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .res-table-subject,
    [data-theme="dark"] .res-table-marks,
    .light-mode-disabled .res-table-subject,
    .light-mode-disabled .res-table-marks {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .res-table-muted,
    .light-mode-disabled .res-table-muted {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .res-grade-pill,
    .light-mode-disabled .res-grade-pill {
        background: #101726 !important;
        color: #F8FAFC !important;
        border: 1px solid #242F4D !important;
    }

    [data-theme="dark"] .res-detail-card,
    .light-mode-disabled .res-detail-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    }
    [data-theme="dark"] .res-detail-title,
    .light-mode-disabled .res-detail-title {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .res-detail-row,
    .light-mode-disabled .res-detail-row {
        border-bottom-color: #242F4D !important;
    }
    [data-theme="dark"] .res-detail-label,
    .light-mode-disabled .res-detail-label {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .res-detail-val,
    .light-mode-disabled .res-detail-val {
        color: #F8FAFC !important;
    }

    [data-theme="dark"] .grade-ref-box,
    .light-mode-disabled .grade-ref-box {
        background: #101726 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .grade-ref-box .g-name,
    .light-mode-disabled .grade-ref-box .g-name {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .grade-ref-box .g-range,
    .light-mode-disabled .grade-ref-box .g-range {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .grade-ref-box.active,
    .light-mode-disabled .grade-ref-box.active {
        background: rgba(8, 145, 178, 0.2) !important;
        border-color: #0891B2 !important;
    }
    [data-theme="dark"] .grade-ref-box.active .g-name,
    .light-mode-disabled .grade-ref-box.active .g-name {
        color: #38bdf8 !important;
    }
    [data-theme="dark"] .grade-ref-box.active .g-range,
    .light-mode-disabled .grade-ref-box.active .g-range {
        color: #7dd3fc !important;
    }

    [data-theme="dark"] .res-empty-card,
    .light-mode-disabled .res-empty-card {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }
    [data-theme="dark"] .res-empty-card h5,
    .light-mode-disabled .res-empty-card h5 {
        color: #F8FAFC !important;
    }
    [data-theme="dark"] .res-empty-card p,
    .light-mode-disabled .res-empty-card p {
        color: #94A3B8 !important;
    }
</style>
<div class="res-header-card">
    <div class="res-header-bg-circle"></div>
    <div class="res-header-inner">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">Academic Results</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">
                Academic results for <%= activeChild.first_name %> <%= activeChild.last_name %> &middot; Class <%= activeChild.class_name %> (<%= activeChild.section %>)
            </p>
        </div>
        <% if (children && children.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <% if (selectedExam) { %>
                    <input type="hidden" name="exam_id" value="<%= selectedExam.id %>">
                <% } %>
                <select name="studentId" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% children.forEach(child => { %>
                        <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name %>
                        </option>
                    <% }) %>
                </select>
            </form>
        <% } %>
    </div>
</div>
<% if (exams.length > 0) { %>
    <div class="ss-card res-select-card">
        <label class="res-select-label" style="font-size: 13px; font-weight: 700; color: #475569; margin: 0; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-clipboard-list" style="color: #0891B2;"></i>Select Exam:
        </label>
        <select onchange="window.location.href='/parent/results?studentId=<%= activeChild.id %>&exam_id='+this.value" class="form-select res-select-input" style="flex: 1; min-width: 200px; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; border: 1.5px solid #E2E8F0; outline: none;">
            <% exams.forEach(exam => { %>
                <option value="<%= exam.id %>" <%= selectedExam && selectedExam.id == exam.id ? 'selected' : '' %>>
                    <%= exam.name %> — <%= new Date(exam.start_date).toLocaleDateString('en-GB', { month:'short', year:'numeric' }) %>
                </option>
            <% }) %>
        </select>
    </div>
<% } %>
<% if (selectedExam && marks.length > 0) { %>
    <div class="res-summary-card">
        <div class="res-summary-c1"></div>
        <div class="res-summary-c2"></div>
        <div class="res-summary-grid">
            <div>
                <div style="font-size: 38px; font-weight: 900; margin-bottom: 2px;"><%= gradeInfo ? gradeInfo.grade : grade %></div>
                <div style="text-transform: uppercase; font-size: 11px; font-weight: 700; opacity: 0.85; letter-spacing: 0.5px;"><%= gradeInfo ? gradeInfo.description : 'Grade' %></div>
            </div>
            <div>
                <div style="font-size: 30px; font-weight: 800; margin-bottom: 2px;"><%= obtainedMarks %><span style="font-size: 16px; opacity: 0.8;">/<%= totalMarks %></span></div>
                <div style="text-transform: uppercase; font-size: 11px; font-weight: 700; opacity: 0.85; letter-spacing: 0.5px;">Marks Scored</div>
            </div>
            <div>
                <div style="font-size: 30px; font-weight: 800; margin-bottom: 2px;"><%= percentage %>%</div>
                <div style="text-transform: uppercase; font-size: 11px; font-weight: 700; opacity: 0.85; letter-spacing: 0.5px;">Percentage</div>
            </div>
            <div>
                <div class="res-status-text <%= resultStatus === 'Pass' ? 'pass' : 'fail' %>">
                    <%= resultStatus === 'Pass' ? '✓ PASS' : '✗ FAIL' %>
                </div>
                <div style="text-transform: uppercase; font-size: 11px; font-weight: 700; opacity: 0.85; letter-spacing: 0.5px;">Overall Result</div>
            </div>
        </div>
        <div class="res-progress-container">
            <div class="res-progress-track">
                <div id="resultsProgressBar" class="res-progress-bar <%= resultStatus === 'Pass' ? 'pass' : 'fail' %>"></div>
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 6px; font-size: 11px; opacity: 0.85;">
                <span>0%</span>
                <span>Pass (<%= selectedExam.pass_marks %>/<%= selectedExam.max_marks %>)</span>
                <span>100%</span>
            </div>
        </div>
    </div>
    <div class="ss-card res-table-card" style="background: #fff; border-radius: 14px; border: 1px solid #E2E8F0; overflow: hidden; margin-bottom: 10px; display: flex; flex-direction: column;">
        <div class="res-table-header-box" style="padding: 14px 20px; border-bottom: 1px solid #F1F5F9; background: #fff;">
            <h3 class="res-table-title" style="font-size: 15px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-list-check" style="color: #0891B2;"></i> Subject-wise Breakdown
            </h3>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                <thead>
                    <tr class="res-table-thead-tr" style="border-bottom: 1px solid #F1F5F9; background: #F8FAFC;">
                        <th style="padding: 11px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Subject</th>
                        <th style="padding: 11px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Code</th>
                        <th style="padding: 11px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: center;">Marks Obtained</th>
                        <th style="padding: 11px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: center;">Max Marks</th>
                        <th style="padding: 11px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: center;">Grade</th>
                        <th style="padding: 11px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: center;">Status</th>
                        <th style="padding: 11px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    <% marks.forEach(m => { %>
                        <tr class="res-table-tbody-tr" style="border-bottom: 1px solid #F1F5F9;">
                            <td class="res-table-subject" style="padding: 13px 20px; color: #1e293b; font-weight: 700;">
                                <%= m.subject_name || (selectedExam ? selectedExam.name : 'General') %>
                            </td>
                            <td class="res-table-muted" style="padding: 13px 20px; color: #64748b;">
                                <%= m.subject_code || (selectedExam && selectedExam.name ? selectedExam.name.substring(0, 4).toUpperCase() : '-') %>
                            </td>
                            <td class="res-table-marks" style="padding: 13px 20px; text-align: center; color: #1e293b; font-weight: 700;"><%= m.obtained_marks %></td>
                            <td class="res-table-muted" style="padding: 13px 20px; text-align: center; color: #64748b;"><%= selectedExam.max_marks %></td>
                            <td style="padding: 13px 20px; text-align: center;">
                                <span class="res-grade-pill" style="background: #F1F5F9; color: #1e293b; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                                    <%= m.grade || '-' %>
                                </span>
                            </td>
                            <td style="padding: 13px 20px; text-align: center;">
                                <% const isPass = String(m.status).toLowerCase() === 'pass'; %>
                                <span class="res-status-pill <%= isPass ? 'pass' : 'fail' %>">
                                    <%= m.status %>
                                </span>
                            </td>
                            <td class="res-table-muted" style="padding: 13px 20px; color: #64748b; font-style: italic;"><%= m.remarks || '-' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-bottom: 10px;">
        <div class="ss-card res-detail-card" style="background: #fff; padding: 20px; border-radius: 14px; border: 1px solid #E2E8F0; display: flex; flex-direction: column;">
            <h3 class="res-detail-title" style="font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 16px 0;">
                <i class="fa-solid fa-info-circle" style="color: #0891B2; margin-right: 8px;"></i>Exam Details
            </h3>
            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 13px;">
                <div class="res-detail-row" style="display: flex; justify-content: space-between; border-bottom: 1px solid #F1F5F9; padding-bottom: 8px;">
                    <span class="res-detail-label" style="color: #64748b;">Exam Name</span>
                    <span class="res-detail-val" style="color: #1e293b; font-weight: 700;"><%= selectedExam.name %></span>
                </div>
                <div class="res-detail-row" style="display: flex; justify-content: space-between; border-bottom: 1px solid #F1F5F9; padding-bottom: 8px;">
                    <span class="res-detail-label" style="color: #64748b;">Type</span>
                    <span class="res-detail-val" style="color: #1e293b; font-weight: 700;"><%= (selectedExam.exam_type || 'N/A').replace('_', ' ').toUpperCase() %></span>
                </div>
                <div class="res-detail-row" style="display: flex; justify-content: space-between; border-bottom: 1px solid #F1F5F9; padding-bottom: 8px;">
                    <span class="res-detail-label" style="color: #64748b;">Max Marks</span>
                    <span class="res-detail-val" style="color: #1e293b; font-weight: 700;"><%= selectedExam.max_marks %></span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span class="res-detail-label" style="color: #64748b;">Passing Marks</span>
                    <span style="color: #137333; font-weight: 700;"><%= selectedExam.pass_marks %></span>
                </div>
            </div>
        </div>
        <div class="ss-card res-detail-card" style="background: #fff; padding: 20px; border-radius: 14px; border: 1px solid #E2E8F0; display: flex; flex-direction: column;">
            <h3 class="res-detail-title" style="font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 16px 0;">
                <i class="fa-solid fa-star" style="color: #D97706; margin-right: 8px;"></i>Grading Reference
            </h3>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
                <% const gradeRef = [['A1','91-100%'],['A2','81-90%'],['B1','71-80%'],['B2','61-70%'],['C1','51-60%'],['C2','41-50%'],['D','33-40%'],['E','0-32%']]; %>
                <% const activeG = gradeInfo ? gradeInfo.grade : grade; %>
                <% gradeRef.forEach(([g, range]) => { %>
                    <% const isActiveGrading = g === activeG; %>
                    <div class="grade-ref-box <%= isActiveGrading ? 'active' : '' %>">
                        <span class="g-name"><%= g %></span>
                        <span class="g-range"><%= range %></span>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
<% } else if (selectedExam) { %>
    <div class="ss-card res-empty-card" style="padding: 40px 20px; text-align: center; background: #fff; border-radius: 14px; border: 1px solid #E2E8F0; margin-bottom: 10px;">
        <div style="color: #94A3B8; margin-bottom: 12px;"><i class="fa-solid fa-hourglass-half fa-3x"></i></div>
        <h5 style="font-size: 17px; font-weight: 700; color: #1e293b; margin: 0 0 6px 0;">Marks not entered yet</h5>
        <p style="font-size: 13px; color: #64748b; margin: 0;">Please wait for the teacher to enter and publish results for this child.</p>
    </div>
<% } else if (exams.length === 0) { %>
    <div class="ss-card res-empty-card" style="padding: 40px 20px; text-align: center; background: #fff; border-radius: 14px; border: 1px solid #E2E8F0; margin-bottom: 10px;">
        <div style="color: #94A3B8; margin-bottom: 12px;"><i class="fa-solid fa-clipboard-list fa-3x"></i></div>
        <h5 style="font-size: 17px; font-weight: 700; color: #1e293b; margin: 0 0 6px 0;">No published results yet</h5>
        <p style="font-size: 13px; color: #64748b; margin: 0;">Results will appear here once the school admin publishes them.</p>
    </div>
<% } %>
<script>
    (function() {
        var bar = document.getElementById('resultsProgressBar');
        if (bar) {
            bar.style.width = '<%= Math.min(percentage, 100) %>%';
        }
    })();
</script>