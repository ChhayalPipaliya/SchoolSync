<div style="background: linear-gradient(135deg, #0891b2, #075985); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(8,145,178,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff;">Academic Results</h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">
                Academic results for <%= activeChild.first_name %> <%= activeChild.last_name %> &middot; Class <%= activeChild.class_name %> (<%= activeChild.section %>)
            </p>
        </div>
        <% if (children && children.length > 1) { %>
            <form method="GET" style="display: flex; gap: 8px; margin: 0; align-items: center;">
                <% if (selectedExam) { %>
                    <input type="hidden" name="exam_id" value="<%= selectedExam.id %>">
                <% } %>
                <select name="studentId" class="form-select" onchange="this.form.submit()" style="background: #fff; color: #0891B2; border: none; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; min-height: 34px;">
                    <% children.forEach(child => { %>
                        <option value="<%= child.id %>" <%= activeChild && activeChild.id === child.id ? 'selected' : '' %>>
                            <%= child.first_name %> <%= child.last_name %>
                        </option>
                    <% }) %>
                </select>
            </form>
        <% } %>
    </div>
</div>
<% if (exams.length > 0) { %>
    <div class="ss-card" style="background: #fff; padding: 16px 20px; border-radius: 16px; border: 1px solid #E2E8F0; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <label style="font-size: 13px; font-weight: 700; color: #475569; margin: 0;"><i class="fa-solid fa-clipboard-list" style="color: #0891B2; margin-right: 8px;"></i>Select Exam:</label>
        <select onchange="window.location.href='/parent/results?studentId=<%= activeChild.id %>&exam_id='+this.value" class="form-select" style="flex: 1; min-width: 200px; font-weight: 600; padding: 8px 12px; font-size: 13px; border-radius: 8px; border: 1px solid #E2E8F0;">
            <% exams.forEach(exam => { %>
                <option value="<%= exam.id %>" <%= selectedExam && selectedExam.id == exam.id ? 'selected' : '' %>>
                    <%= exam.name %> — <%= new Date(exam.start_date).toLocaleDateString('en-GB', { month:'short', year:'numeric' }) %>
                </option>
            <% }) %>
        </select>
    </div>
<% } %>
<% if (selectedExam && marks.length > 0) { %>
    <div style="background: linear-gradient(135deg, #0891b2, #075985); color: #fff; padding: 24px; border-radius: 16px; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(8,145,178,0.15);">
        <div style="position: absolute; top: -20px; right: -20px; width: 120px; height: 120px; background: rgba(255,255,255,0.08); border-radius: 50%;"></div>
        <div style="position: absolute; bottom: -30px; left: 40%; width: 150px; height: 150px; background: rgba(255,255,255,0.05); border-radius: 50%;"></div>
        <div style="position: relative; z-index: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 24px; align-items: center; text-align: center;">
            <div>
                <div style="font-size: 40px; font-weight: 900; margin-bottom: 4px;"><%= gradeInfo ? gradeInfo.grade : grade %></div>
                <div style="text-transform: uppercase; font-size: 11px; font-weight: 700; opacity: 0.8; letter-spacing: 0.5px;"><%= gradeInfo ? gradeInfo.description : 'Grade' %></div>
            </div>
            <div>
                <div style="font-size: 32px; font-weight: 800; margin-bottom: 4px;"><%= obtainedMarks %><span style="font-size: 18px; opacity: 0.8;">/<%= totalMarks %></span></div>
                <div style="text-transform: uppercase; font-size: 11px; font-weight: 700; opacity: 0.8; letter-spacing: 0.5px;">Marks Scored</div>
            </div>
            <div>
                <div style="font-size: 32px; font-weight: 800; margin-bottom: 4px;"><%= percentage %>%</div>
                <div style="text-transform: uppercase; font-size: 11px; font-weight: 700; opacity: 0.8; letter-spacing: 0.5px;">Percentage</div>
            </div>
            <div>
                <div style="font-size: 24px; font-weight: 800; margin-bottom: 4px; color: '<%= resultStatus === 'Pass' ? '#86EFAC' : '#FCA5A5' %>';">
                    <%= resultStatus === 'Pass' ? '✓ PASS' : '✗ FAIL' %>
                </div>
                <div style="text-transform: uppercase; font-size: 11px; font-weight: 700; opacity: 0.8; letter-spacing: 0.5px;">Overall Result</div>
            </div>
        </div>
        <div style="position: relative; z-index: 1; margin-top: 24px;">
            <div style="background: rgba(255,255,255,0.2); border-radius: 10px; height: 8px; overflow: hidden;">
                <div style="background: '<%= resultStatus === 'Pass' ? '#86EFAC' : '#FCA5A5' %>'; height: 100%; width: '<%= Math.min(percentage, 100) %>'; border-radius: 10px; transition: width 1s ease;"></div>
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 8px; font-size: 11px; opacity: 0.8;">
                <span>0%</span>
                <span>Pass (<%= selectedExam.pass_marks %>/<%= selectedExam.max_marks %>)</span>
                <span>100%</span>
            </div>
        </div>
    </div>
    <div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden; margin-bottom: 24px; display: flex; flex-direction: column;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9; background: #fff;">
            <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-list-check" style="color: #0891B2;"></i> Subject-wise Breakdown
            </h3>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                <thead>
                    <tr style="border-bottom: 1px solid #F1F5F9; background: #F8FAFC;">
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Subject</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Code</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: center;">Marks Obtained</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: center;">Max Marks</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: center;">Grade</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: center;">Status</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    <% marks.forEach(m => { %>
                        <tr style="border-bottom: 1px solid #F1F5F9;">
                            <td style="padding: 14px 20px; color: #1e293b; font-weight: 700;"><%= m.subject_name || 'N/A' %></td>
                            <td style="padding: 14px 20px; color: #64748b;"><%= m.subject_code || 'N/A' %></td>
                            <td style="padding: 14px 20px; text-align: center; color: #1e293b; font-weight: 700;"><%= m.obtained_marks %></td>
                            <td style="padding: 14px 20px; text-align: center; color: #64748b;"><%= selectedExam.max_marks %></td>
                            <td style="padding: 14px 20px; text-align: center;">
                                <span style="background: #F1F5F9; color: #1e293b; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 700;">
                                    <%= m.grade || '-' %>
                                </span>
                            </td>
                            <td style="padding: 14px 20px; text-align: center;">
                                <span style="background: '<%= String(m.status).toLowerCase() === 'pass' ? '#E6F4EA' : '#FEE2E2' %>'; 
                                             color: '<%= String(m.status).toLowerCase() === 'pass' ? '#137333' : '#DC2626' %>'; 
                                             padding: 4px 10px; border-radius: 9999px; font-size: 11px; font-weight: 600; text-transform: uppercase;">
                                    <%= m.status %>
                                </span>
                            </td>
                            <td style="padding: 14px 20px; color: #64748b; font-style: italic;"><%= m.remarks || '-' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-bottom: 24px;">
        <div class="ss-card" style="background: #fff; padding: 24px; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); display: flex; flex-direction: column;">
            <h3 style="font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 20px 0;"><i class="fa-solid fa-info-circle" style="color: #0891B2; margin-right: 8px;"></i>Exam Details</h3>
            <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #F1F5F9; padding-bottom: 8px;">
                    <span style="color: #64748b;">Exam Name</span>
                    <span style="color: #1e293b; font-weight: 700;"><%= selectedExam.name %></span>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #F1F5F9; padding-bottom: 8px;">
                    <span style="color: #64748b;">Type</span>
                    <span style="color: #1e293b; font-weight: 700;"><%= (selectedExam.exam_type || 'N/A').replace('_', ' ').toUpperCase() %></span>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #F1F5F9; padding-bottom: 8px;">
                    <span style="color: #64748b;">Max Marks</span>
                    <span style="color: #1e293b; font-weight: 700;"><%= selectedExam.max_marks %></span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: #64748b;">Passing Marks</span>
                    <span style="color: #137333; font-weight: 700;"><%= selectedExam.pass_marks %></span>
                </div>
            </div>
        </div>
        <div class="ss-card" style="background: #fff; padding: 24px; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); display: flex; flex-direction: column;">
            <h3 style="font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 20px 0;"><i class="fa-solid fa-star" style="color: #D97706; margin-right: 8px;"></i>Grading Reference</h3>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                <% const gradeRef = [['A1','91-100%'],['A2','81-90%'],['B1','71-80%'],['B2','61-70%'],['C1','51-60%'],['C2','41-50%'],['D','33-40%'],['E','0-32%']]; %>
                <% const activeG = gradeInfo ? gradeInfo.grade : grade; %>
                <% gradeRef.forEach(([g, range]) => { %>
                    <% const isActiveGrading = g === activeG; %>
                    <div class="grade-ref-item <%= isActiveGrading ? 'active' : '' %>" style="display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 8px; border: 1px solid '<%= isActiveGrading ? '#0891B2' : '#E2E8F0' %>'; background: '<%= isActiveGrading ? '#ECFEFF' : '#fff' %>';">
                        <span style="font-size: 13px; font-weight: 700; color: '<%= isActiveGrading ? '#0891B2' : '#334155' %>'; min-width: 22px;"><%= g %></span>
                        <span style="font-size: 11px; color: '<%= isActiveGrading ? '#0891B2' : '#64748b' %>';"><%= range %></span>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
    <% if (marks[0] && marks[0].remarks) { %>
        <div style="background: #FFFBEB; border-left: 4px solid #D97706; padding: 20px; border-radius: 12px; margin-bottom: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
            <h4 style="font-size: 11px; text-transform: uppercase; color: #D97706; font-weight: 700; margin: 0 0 8px 0; letter-spacing: 0.5px;">
                <i class="fa-solid fa-comment" style="margin-right: 6px;"></i>Teacher Remarks
            </h4>
            <p style="font-size: 13px; color: #475569; margin: 0; font-style: italic; line-height: 1.6;"><%= marks[0].remarks %></p>
        </div>
    <% } %>
<% } else if (selectedExam) { %>
    <div class="ss-card" style="padding: 48px; text-align: center; background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="color: #94A3B8; margin-bottom: 16px;"><i class="fa-solid fa-hourglass-half fa-4x"></i></div>
        <h5 style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">Marks not entered yet</h5>
        <p style="font-size: 13px; color: #64748b; margin: 0;">Please wait for the teacher to enter and publish results for this child.</p>
    </div>
<% } else if (exams.length === 0) { %>
    <div class="ss-card" style="padding: 48px; text-align: center; background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div style="color: #94A3B8; margin-bottom: 16px;"><i class="fa-solid fa-clipboard-list fa-4x"></i></div>
        <h5 style="font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">No published results yet</h5>
        <p style="font-size: 13px; color: #64748b; margin: 0;">Results will appear here once the school admin publishes them.</p>
    </div>
<% } %>
