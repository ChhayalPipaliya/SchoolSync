            align-items: center;
            justify-content: center;
            margin-right: -10px;
            transition: transform 0.3s ease;
        }

        .hero-trust .avatars span:nth-child(2) {
            background: var(--amber);
        }

        .hero-trust .avatars span:nth-child(3) {
            background: var(--green);
        }

        .hero-trust .avatars:hover span {
            margin-right: 2px;
        }

        .hero-trust .avatars:hover span:nth-child(1) {
            transform: translateY(-4px);
        }

        .hero-trust .avatars:hover span:nth-child(2) {
            transform: translateY(-8px);
        }

        .hero-trust .avatars:hover span:nth-child(3) {
            transform: translateY(-4px);
        }

        .hero-right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 5px 5% 80px 2%;
            position: relative;
            z-index: 2;
            perspective: 1200px;
            min-height: 100vh;
            overflow: visible;
        }

        @keyframes mockupFloat {

            0%,
            100% {
                transform: translateY(0) rotateX(0deg);
            }

            50% {
                transform: translateY(-10px) rotateX(2deg);
            }
        }

        .mockup-row:nth-child(2) {
            animation-delay: .1s;
        }

        .mockup-row:nth-child(3) {
            animation-delay: .2s;
        }

        .mockup-row:nth-child(4) {
            animation-delay: .3s;
        }

        @keyframes row-in {
            from {
                opacity: 0;
                transform: translateX(20px)
            }

            to {
                opacity: 1;
                transform: translateX(0)
            }
        }

        .float-card {
            position: absolute;
            background: rgba(255, 255, 255, 0.85);
            border-radius: 16px;
            padding: 0;
            box-shadow: 0 8px 32px rgba(14, 14, 26, 0.12), 0 2px 8px rgba(14, 14, 26, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.6);
            font-size: 13px;
            z-index: 3;
            backdrop-filter: blur(20px);
