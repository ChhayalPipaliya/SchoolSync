<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SchoolSync — Complete School Management Platform</title>
    <meta name="description"
        content="SchoolSync is a complete school management platform for Indian schools. Manage attendance, fees, library, transport & more with a 7-day full-access demo.">
    <meta name="keywords"
        content="school management system, school ERP, attendance system, fee management, library management, Indian schools">
    <meta name="author" content="SchoolSync">
    <meta property="og:title" content="SchoolSync — Complete School Management Platform">
    <meta property="og:description" content="Manage your entire school on one platform. Built for Indian schools.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://schoolsync.com">
    <link rel="icon" type="image/svg+xml"
        href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏫</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/landing.css">
    <script>
      (function() {
        try {
          var savedTheme = localStorage.getItem('schoolSyncTheme') || 'light';
          document.documentElement.setAttribute('data-theme', savedTheme);
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.add('light-mode-disabled');
          }
        } catch(e) {}
      })();
    </script>
    <script src="/js/theme.js"></script>
    <style>
        :root {
            --font-primary: 'Plus Jakarta Sans', 'Inter', sans-serif;
            --font-mono: 'Space Grotesk', monospace;
            --ink: #0F0F1A;
            --ink-2: #3D3D52;
            --ink-3: #8585A0;
            --paper: #FAFAF7;
            --paper-2: #F2F2EC;
            --primary: #4338CA;
            --primary-light: #6366F1;
            --primary-glow: rgba(99, 102, 241, 0.15);
            --amber: #F59E0B;
            --amber-light: #FCD34D;
            --green: #059669;
            --red: #DC2626;
            --radius: 20px;
            --radius-sm: 12px;
            --shadow: 0 4px 24px rgba(14, 14, 26, .08);
            --shadow-lg: 0 20px 60px rgba(14, 14, 26, .14);
            --shadow-xl: 0 32px 80px rgba(14, 14, 26, .18);
            --glass: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(255, 255, 255, 0.3);
            --nav-bg: rgba(255, 255, 255, 0.86);
            --nav-border: rgba(14, 14, 26, 0.08);
            --card-bg: rgba(255, 255, 255, 0.86);
            --card-bg-strong: #FFFFFF;
            --card-border: rgba(14, 14, 26, 0.08);
            --section-a: #F8FAFC;
            --section-b: #EEF2F7;
            --dark-section: #0B0B16;
            --dark-section-2: #17172A;
            --dark-section-text: #FFFFFF;
            --dark-section-muted: rgba(255, 255, 255, 0.66);
            --mockup-surface: #FFFFFF;
            --mockup-surface-2: #F8FAFC;
            --mockup-surface-3: #F1F5F9;
            --mockup-border: #E2E8F0;
            --mockup-text: #0F172A;
            --mockup-muted: #64748B;
            --mockup-faint: #94A3B8;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-primary);
            background: var(--paper);
            color: var(--ink);
            line-height: 1.6;
            overflow-x: hidden;
            transition: background 0.4s ease, color 0.4s ease;
        }

        ::selection {
            background: var(--primary);
            color: #fff;
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--primary) 0%, #8B5CF6 50%, var(--primary-light) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            background-size: 200% 200%;
            animation: gradientShift 4s ease infinite;
        }

        @keyframes gradientShift {

            0%,
            100% {
                background-position: 0% 50%
            }

            50% {
                background-position: 100% 50%
            }
        }

        .hero-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 1;
        }

        .hero-orb-1 {
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, transparent 70%);
            top: -100px;
            right: -100px;
            animation: orbFloat1 8s ease-in-out infinite;
        }

        .hero-orb-2 {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.12) 0%, transparent 70%);
            bottom: 0;
            left: -100px;
            animation: orbFloat2 10s ease-in-out infinite;
        }

        .hero-orb-3 {
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.10) 0%, transparent 70%);
            top: 30%;
            left: 30%;
            animation: orbFloat3 7s ease-in-out infinite;
        }

        @keyframes orbFloat1 {

            0%,
            100% {
                transform: translate(0, 0) scale(1)
            }

            50% {
                transform: translate(-30px, 40px) scale(1.1)
            }
        }

        @keyframes orbFloat2 {

            0%,
            100% {
                transform: translate(0, 0) scale(1)
            }

            50% {
                transform: translate(30px, -30px) scale(0.95)
            }
        }

        @keyframes orbFloat3 {

            0%,
            100% {
                transform: translate(0, 0)
            }

            33% {
                transform: translate(-20px, 20px)
            }

            66% {
                transform: translate(20px, -10px)
            }
        }

        .hero-micro-stats {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 16px 24px;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 100px;
            width: fit-content;
            backdrop-filter: blur(12px);
        }

        .micro-stat {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink-2);
        }

        .micro-stat i {
            font-size: 14px;
        }

        .micro-stat-divider {
            width: 1px;
            height: 16px;
            background: var(--glass-border);
        }

        .hero-subtitle-line {
            opacity: 0.85;
        }

        .trust-rating {
            color: var(--amber);
            font-size: 13px;
            letter-spacing: 2px;
        }

        .trust-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .trust-text span {
            font-size: 13px;
            color: var(--ink-3);
        }

        .trust-text span strong {
            color: var(--ink);
        }

        .float-card-4 {
            top: 62%;
            left: -2%;
            animation: float-4 8s ease-in-out infinite;
        }

        @keyframes float-4 {

            0%,
            100% {
                transform: translateY(0) rotate(-1deg)
            }

            50% {
                transform: translateY(-14px) rotate(1deg)
            }
        }

        .feature-tag-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 16px;
        }

        .feature-tag {
            display: inline-block;
            padding: 4px 10px;
            background: rgba(67, 56, 202, .08);
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
            border-radius: 20px;
            letter-spacing: 0.3px;
        }

        .features-highlight {
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
            padding: 28px 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            backdrop-filter: blur(10px);
            flex-wrap: wrap;
            gap: 20px;
        }

        .fh-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            font-weight: 700;
            color: var(--ink-2);
            transition: all 0.3s;
        }

        .fh-item:hover {
            color: var(--primary);
            transform: translateY(-2px);
        }

        .fh-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: var(--primary-glow);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: all 0.3s;
        }

        .fh-item:hover .fh-icon {
            background: var(--primary);
            color: #fff;
        }

        .fh-divider {
            width: 1px;
            height: 28px;
            background: var(--glass-border);
        }

        .step-card {
            position: relative;
        }
        
        .step-cta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 20px;
            font-size: 13px;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.5);
            transition: color 0.3s;
        }

        .step-card:hover .step-cta {
            color: var(--amber-light);
        }

        .step-cta i {
            font-size: 11px;
            transition: transform 0.3s;
        }

        .step-card:hover .step-cta i {
            transform: translateX(4px);
        }

        .cta-section {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 30%, #1e1b4b 60%, #0a0a1a 100%);
            padding: 50px 8%;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .cta-bg-orb {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .cta-bg-orb-1 {
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
            top: -200px;
            left: -200px;
            animation: orbFloat1 9s ease-in-out infinite;
        }

        .cta-bg-orb-2 {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 70%);
            bottom: -150px;
            right: -150px;
            animation: orbFloat2 11s ease-in-out infinite;
        }

        .cta-bg-orb-3 {
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, transparent 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation: orbFloat3 7s ease-in-out infinite;
        }

        .cta-trust-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 32px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .cta-trust-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.7);
        }

        .cta-trust-item i {
            font-size: 16px;
        }

        .btn-cta-primary {
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            color: #fff;
            box-shadow: 0 8px 32px rgba(79, 70, 229, 0.5), 0 0 0 0 rgba(79, 70, 229, 0.4);
            animation: ctaBtnPulse 3s ease infinite;
            position: relative;
            overflow: hidden;
        }

        @keyframes ctaBtnPulse {

            0%,
            100% {
                box-shadow: 0 8px 32px rgba(79, 70, 229, .5), 0 0 0 0 rgba(79, 70, 229, .4)
            }

            50% {
                box-shadow: 0 8px 48px rgba(79, 70, 229, .6), 0 0 0 12px rgba(79, 70, 229, 0)
            }
        }

        .btn-cta-primary:hover {
            background: linear-gradient(135deg, #4338CA, #6D28D9);
            transform: translateY(-3px) scale(1.02);
        }

        .btn-cta-ghost {
            background: rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.9);
            border: 1.5px solid rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
        }

        .btn-cta-ghost:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            transform: translateY(-2px);
        }

        .btn-shine {
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
            animation: btnShine 3s ease infinite;
        }

        @keyframes btnShine {
            0% {
                left: -100%
            }

            100% {
                left: 200%
            }
        }

        .btn-glow {
            position: relative;
        }

        .btn-glow::before {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--primary), #8B5CF6, var(--primary-light));
            z-index: -1;
            opacity: 0;
            transition: opacity 0.3s;
            filter: blur(8px);
        }

        .btn-glow:hover::before {
            opacity: 1;
        }

        .cursor-dot,
        .cursor-outline {
            position: fixed;
            top: 0;
            left: 0;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            z-index: 9998;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
            will-change: left, top, transform;
        }

        .cursor-dot {
            width: 8px;
            height: 8px;
            background: var(--primary);
            transition: opacity 0.3s ease, transform 0.15s ease;
        }

        .cursor-outline {
            width: 40px;
            height: 40px;
            border: 2px solid var(--primary);
            transition: width 0.2s cubic-bezier(0.25, 1, 0.5, 1),
                        height 0.2s cubic-bezier(0.25, 1, 0.5, 1),
                        background 0.2s ease,
                        border-color 0.2s ease,
                        opacity 0.3s ease,
                        transform 0.15s ease;
        }

        .cursor-outline.hover {
            width: 60px;
            height: 60px;
            background: var(--primary-glow);
            border-color: transparent;
        }

        @media (pointer: coarse) {

            .cursor-dot,
            .cursor-outline {
                display: none;
            }
        }

        .display {
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3,
        h4 {
            font-family: 'Inter', sans-serif;
            line-height: 1.15;
            font-weight: 700;
        }

        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: var(--primary);
            color: #fff;
            padding: 8px 16px;
            z-index: 1000;
            transition: top 0.3s;
            font-weight: 600;
        }

        .skip-link:focus {
            top: 0;
        }

        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            padding: 0 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 72px;
            background: var(--glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            transition: all 0.3s ease;
        }

        nav.scrolled {
            box-shadow: var(--shadow);
            background: var(--glass);
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .nav-logo-mark {
            width: 40px;
            height: 40px;
            background: var(--primary);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 18px;
            font-family: 'Inter', sans-serif;
            transition: transform 0.3s ease;
        }

        .nav-logo:hover .nav-logo-mark {
            transform: rotate(-5deg) scale(1.05);
        }

        .nav-logo-text {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
            font-family: 'Inter', sans-serif;
            transition: color 0.3s;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .nav-links a {
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            color: var(--ink-2);
            text-decoration: none;
            transition: all .2s;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 4px;
            left: 50%;
            width: 0;
            height: 2px;
            background: var(--primary);
            border-radius: 1px;
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        .nav-links a:hover {
            color: var(--ink);
        }

        .nav-links a:hover::after {
            width: 60%;
        }

        .nav-links a:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .nav-cta {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .lang-switcher {
            position: relative;
        }

        .lang-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 10px;
            border: 1.5px solid var(--glass-border);
            background: var(--glass);
            color: var(--ink-2);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            backdrop-filter: blur(10px);
        }

        .lang-btn:hover {
            background: var(--paper-2);
            color: var(--ink);
        }

        .lang-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            margin-top: 8px;
            background: var(--glass);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            padding: 8px;
            min-width: 160px;
            box-shadow: var(--shadow-lg);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px) scale(0.95);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 200;
            backdrop-filter: blur(20px);
        }

        .lang-dropdown.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .lang-dropdown button {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            padding: 10px 14px;
            border: none;
            background: none;
            color: var(--ink-2);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            border-radius: 10px;
            transition: all 0.15s;
        }

        .lang-dropdown button:hover {
            background: var(--paper-2);
            color: var(--ink);
        }

        .lang-dropdown button.active {
            background: rgba(67, 56, 202, .1);
            color: var(--primary);
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            color: var(--ink);
            cursor: pointer;
            padding: 8px;
        }

        .mobile-menu {
            position: fixed;
            top: 72px;
            left: 0;
            right: 0;
            background: var(--glass);
            backdrop-filter: blur(20px);
            padding: 24px 5%;
            border-bottom: 1px solid var(--glass-border);
            z-index: 99;
            transform: translateY(-100%);
            visibility: hidden;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
        }

        .mobile-menu.open {
            visibility: visible;
            transform: translateY(0);
        }

        .mobile-menu a {
            display: block;
            padding: 14px 18px;
            color: var(--ink-2);
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            border-radius: 12px;
            transition: all .15s;
        }

        .mobile-menu a:hover {
            background: var(--paper-2);
            color: var(--ink);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .25s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .btn:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }

        .btn-ghost {
            background: var(--paper-2);
            color: var(--ink-2);
            border: 1.5px solid var(--glass-border);
        }

        .btn-ghost:hover {
            background: var(--dark-section);
            color: #fff;
            border-color: var(--dark-section);
            transform: translateY(-2px);
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 4px 20px rgba(67, 56, 202, .3);
        }

        .btn-primary:hover {
            background: #3730A3;
            box-shadow: 0 8px 30px rgba(67, 56, 202, .4);
            transform: translateY(-2px);
        }

        .btn-primary::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .2), transparent);
            transform: translateX(-100%);
            transition: transform 0.5s;
        }

        .btn-primary:hover::after {
            transform: translateX(100%);
        }

        .btn-lg {
            padding: 16px 36px;
            font-size: 16px;
            border-radius: 14px;
        }

        .btn-amber {
            background: var(--amber);
            color: #fff;
        }

        .btn-amber:hover {
            background: #D97706;
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(245, 158, 11, .3);
        }

        .btn-outline {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
        }

        .btn-outline:hover {
            background: var(--primary);
            color: #fff;
            transform: translateY(-2px);
        }

        .hero {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            padding-top: 60px;
            position: relative;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 70% 40%, var(--primary-glow) 0%, transparent 60%),
                radial-gradient(ellipse 50% 50% at 20% 80%, rgba(245, 158, 11, .08) 0%, transparent 50%),
                radial-gradient(ellipse 40% 40% at 50% 10%, rgba(5, 150, 105, .05) 0%, transparent 50%);
