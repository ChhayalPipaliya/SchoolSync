        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 72px;
        }

        .feature-card {
            background: var(--glass);
            border-radius: var(--radius);
            padding: 32px;
            border: 1px solid var(--glass-border);
            transition: all .4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .feature-card::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 100% 0%, rgba(99, 102, 241, 0.04), transparent 60%);
            opacity: 0;
            transition: opacity 0.4s;
        }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-xl);
            border-color: rgba(67, 56, 202, .25);
        }

        .feature-card:hover::before {
            transform: scaleX(1);
        }

        .feature-card:hover::after {
            opacity: 1;
        }

        .feature-card:nth-child(1) {
            --gradient: linear-gradient(90deg, #4338CA, #6366F1);
        }

        .feature-card:nth-child(2) {
            --gradient: linear-gradient(90deg, #059669, #34D399);
        }

        .feature-card:nth-child(3) {
            --gradient: linear-gradient(90deg, #F59E0B, #FCD34D);
        }

        .feature-card:nth-child(4) {
            --gradient: linear-gradient(90deg, #DC2626, #F87171);
        }

        .feature-card:nth-child(5) {
            --gradient: linear-gradient(90deg, #7C3AED, #A78BFA);
        }

        .feature-card:nth-child(6) {
            --gradient: linear-gradient(90deg, #0891B2, #38BDF8);
        }

        .feature-icon {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            margin-bottom: 24px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        }

        .feature-card:hover .feature-icon {
            transform: scale(1.15) rotate(-8deg);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        }

        .feature-title {
            font-size: 20px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 12px;
            transition: color 0.3s;
            letter-spacing: -0.3px;
        }

        .feature-desc {
            font-size: 14.5px;
            color: var(--ink-2);
            line-height: 1.75;
            transition: color 0.3s;
        }

        .how-section {
            background: var(--dark-section);
            position: relative;
            overflow: hidden;
            transition: background 0.3s;
        }

        .how-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 50% 60% at 80% 50%, rgba(99, 102, 241, .12) 0%, transparent 60%),
                radial-gradient(ellipse 40% 40% at 10% 80%, rgba(245, 158, 11, .08) 0%, transparent 50%);
            pointer-events: none;
        }

        .how-section .section-tag {
            background: rgba(255, 255, 255, .1);
            color: rgba(255, 255, 255, .8);
            border-color: rgba(255, 255, 255, .1);
        }

        .how-section .section-title {
            color: var(--dark-section-text);
        }

        .how-section .section-sub {
            color: var(--dark-section-muted);
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 32px;
            margin-top: 20px;
            position: relative;
            z-index: 1;
        }

        .step-card {
            background: rgba(255, 255, 255, .05);
            border: 1px solid rgba(255, 255, 255, .1);
            border-radius: var(--radius);
            padding: 40px 32px;
            position: relative;
            backdrop-filter: blur(10px);
            transition: all .4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .step-card:hover {
            background: rgba(255, 255, 255, .1);
            transform: translateY(-8px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, .3);
        }

        .step-num {
            font-family: 'Inter', sans-serif;
            font-size: 72px;
            font-weight: 800;
            color: rgba(255, 255, 255, .06);
            line-height: 1;
            margin-bottom: 20px;
            transition: color 0.3s;
        }

        .step-card:hover .step-num {
            color: rgba(255, 255, 255, .12);
        }

        .step-icon {
            font-size: 40px;
            margin-bottom: 20px;
            filter: grayscale(0.3);
            transition: all 0.3s;
        }

        .step-card:hover .step-icon {
            filter: grayscale(0);
            transform: scale(1.1);
        }

        .step-title {
            font-size: 22px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 14px;
        }

        .step-desc {
            font-size: 15px;
            color: rgba(255, 255, 255, .6);
            line-height: 1.7;
        }

        /* ===== PRICING ===== */
        .pricing-section {
            background: var(--paper-2);
            transition: background 0.3s;
            position: relative;
            overflow: hidden;
        }

        .pricing-section::before {
            content: '';
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.05) 0%, transparent 70%);
            top: -400px;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 32px;
            margin-top: 50px;
        }

        .plan-card {
            background: var(--paper);
            border-radius: 24px;
            padding: 40px 36px;
            border: 1.5px solid var(--glass-border);
            position: relative;
            transition: all .4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .plan-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl);
        }

        .plan-card.featured {
            background: linear-gradient(135deg, var(--primary) 0%, #3730A3 100%);
            border-color: transparent;
            transform: scale(1.05);
            box-shadow: 0 20px 60px rgba(67, 56, 202, .4);
        }

        .plan-card.featured:hover {
            transform: scale(1.05) translateY(-8px);
        }

        .plan-card.featured::before {
            content: '';
            position: absolute;
            inset: -1px;
            border-radius: 24px;
            background: linear-gradient(135deg, var(--primary-light), var(--amber-light));
            z-index: -1;
            opacity: 0.5;
            filter: blur(20px);
        }

        .plan-badge {
            position: absolute;
            top: -16px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--amber);
            color: #fff;
            padding: 6px 20px;
            border-radius: 100px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            white-space: nowrap;
            box-shadow: 0 4px 16px rgba(245, 158, 11, .3);
        }

        .plan-name {
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--ink-3);
            margin-bottom: 10px;
        }

        .plan-card.featured .plan-name {
            color: rgba(255, 255, 255, .7);
        }

        .plan-price {
            font-family: 'Inter', sans-serif;
            font-size: 56px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1;
            margin-bottom: 6px;
        }

        .plan-card.featured .plan-price {
            color: #fff;
        }

        .plan-price span {
            font-size: 24px;
            font-weight: 600;
            vertical-align: top;
            margin-top: 8px;
            display: inline-block;
        }

        .plan-period {
            font-size: 14px;
            color: var(--ink-3);
            margin-bottom: 28px;
            font-weight: 500;
        }

        .plan-card.featured .plan-period {
            color: rgba(255, 255, 255, .6);
        }

        .plan-divider {
            height: 1px;
            background: rgba(14, 14, 26, .08);
            margin: 28px 0;
        }

        .plan-card.featured .plan-divider {
            background: rgba(255, 255, 255, .15);
        }

        .plan-features {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 36px;
        }

        .plan-features li {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 15px;
            color: var(--ink-2);
            font-weight: 500;
        }

        .plan-card.featured .plan-features li {
            color: rgba(255, 255, 255, .9);
        }

        .plan-features li i {
            width: 20px;
            text-align: center;
            font-size: 14px;
        }

        .plan-features li .check {
            color: var(--green);
        }

        .plan-features li .cross {
            color: var(--ink-3);
        }

        .plan-card.featured .plan-features li .check {
            color: var(--amber-light);
        }

        .comparison-section {
            background: var(--paper);
            transition: background 0.3s;
        }

        .comparison-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 72px;
            background: var(--glass);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(10px);
        }

        .comparison-table th,
        .comparison-table td {
            padding: 20px 28px;
            text-align: left;
            border-bottom: 1px solid rgba(14, 14, 26, .06);
        }

        .comparison-table th {
            background: var(--dark-section);
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .comparison-table td {
            font-size: 15px;
            color: var(--ink-2);
            font-weight: 500;
        }

        .comparison-table tr {
            transition: all 0.3s;
        }

        .comparison-table tr:hover td {
            background: rgba(67, 56, 202, .04);
        }

        .comparison-table .check-green {
            color: var(--green);
            font-size: 18px;
        }

        .comparison-table .check-amber {
            color: var(--amber);
            font-size: 18px;
        }

        .comparison-table .cross-red {
            color: var(--red);
            font-size: 18px;
        }

        .partners-section {
            background: var(--paper-2);
            padding: 80px 8%;
            overflow: hidden;
            transition: background 0.3s;
        }

        .partners-track {
            display: flex;
            gap: 80px;
            animation: scroll-logos 35s linear infinite;
            width: max-content;
            margin-top: 48px;
        }

        .partners-track:hover {
            animation-play-state: paused;
        }

        @keyframes scroll-logos {
            from {
                transform: translateX(0)
            }

            to {
                transform: translateX(-50%)
            }
        }

        .partner-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 180px;
            height: 64px;
            background: var(--paper);
            border-radius: 14px;
            padding: 14px 28px;
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            font-size: 16px;
            color: var(--ink-3);
            border: 1px solid var(--glass-border);
            opacity: 0.7;
            transition: all 0.4s;
            margin-bottom: 5px;
        }

        .partner-logo:hover {
            opacity: 1;
            transform: scale(1.08);
            box-shadow: var(--shadow);
            border-color: var(--primary);
            color: var(--primary);
        }

        .testimonials-section {
            background: var(--paper);
            overflow: hidden;
            transition: background 0.3s;
        }

        .testimonials-track {
            display: flex;
            gap: 24px;
            margin-top: 72px;
            animation: scroll-left 45s linear infinite;
            width: max-content;
        }

        .testimonials-track:hover {
            animation-play-state: paused;
        }

        @keyframes scroll-left {
            from {
                transform: translateX(0)
            }

            to {
                transform: translateX(-50%)
            }
        }

        .testimonial-card {
            background: var(--glass);
            border-radius: var(--radius);
            padding: 32px;
            border: 1px solid var(--glass-border);
            width: 380px;
            flex-shrink: 0;
            backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .testimonial-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(67, 56, 202, .2);
        }

        .t-stars {
            color: var(--amber);
            font-size: 14px;
            margin-bottom: 16px;
            letter-spacing: 3px;
        }

        .t-quote {
            font-size: 16px;
            color: var(--ink-2);
            line-height: 1.7;
            margin-bottom: 24px;
            font-style: italic;
            transition: color 0.3s;
        }

        .t-author {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .t-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 18px;
            font-family: 'Inter', sans-serif;
            flex-shrink: 0;
            transition: transform 0.3s;
        }

        .testimonial-card:hover .t-avatar {
            transform: scale(1.1);
        }

        .t-name {
            font-size: 15px;
            font-weight: 800;
            color: var(--ink);
            transition: color 0.3s;
        }

        .t-school {
            font-size: 13px;
            color: var(--ink-3);
            font-weight: 500;
        }

        .faq-section {
            background: var(--paper-2);
            transition: background 0.3s;
        }

        .faq-list {
            max-width: 850px;
            margin: 72px auto 0;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .faq-item {
            background: var(--glass);
            border-radius: 16px;
            border: 1px solid var(--glass-border);
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(10px);
        }

        .faq-item.active {
            box-shadow: var(--shadow);
            border-color: rgba(67, 56, 202, .2);
            transform: translateY(-2px);
        }

        .faq-question {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 24px 28px;
            cursor: pointer;
            font-size: 17px;
            font-weight: 700;
            color: var(--ink);
            transition: all 0.3s;
        }

        .faq-question:hover {
            color: var(--primary);
        }

        .faq-question i {
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            color: var(--primary);
            font-size: 18px;
        }

        .faq-item.active .faq-question i {
            transform: rotate(180deg);
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1), padding 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .faq-item.active .faq-answer {
            max-height: 1000px;
            padding: 0 28px 24px;
        }

        .faq-answer p {
            font-size: 15px;
            color: var(--ink-2);
            line-height: 1.8;
        }

        .blog-section {
            background: var(--paper);
            transition: background 0.3s;
        }

        .blog-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
            margin-top: 30px;
        }

        .blog-card {
            background: var(--glass);
            border-radius: var(--radius);
            overflow: hidden;
            border: 1px solid var(--glass-border);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(10px);
        }

        .blog-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl);
            border-color: rgba(67, 56, 202, .2);
        }

        .blog-image {
            height: 200px;
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 56px;
            transition: all 0.4s;
        }

        .blog-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .blog-card:hover .blog-image {
            transform: scale(1.05);
        }

        .blog-content {
            padding: 28px;
        }

        .blog-tag {
            display: inline-block;
            padding: 6px 14px;
            background: var(--primary-glow);
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 20px;
            margin-bottom: 14px;
        }

        .blog-title {
            font-size: 19px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 12px;
            line-height: 1.4;
            transition: color 0.3s;
        }

        .blog-excerpt {
            font-size: 15px;
            color: var(--ink-2);
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .blog-meta {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 13px;
            color: var(--ink-3);
            font-weight: 500;
        }

        .team-section {
            background: var(--paper-2);
            transition: background 0.3s;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 28px;
            margin-top: 72px;
        }

        .team-card {
            text-align: center;
            padding: 40px 28px;
            background: var(--glass);
            border-radius: var(--radius);
            border: 1px solid var(--glass-border);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(10px);
        }

        .team-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl);
            border-color: rgba(67, 56, 202, .2);
        }

        .team-avatar {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 36px;
            color: #fff;
            transition: all 0.4s;
        }

        .team-card:hover .team-avatar {
            transform: scale(1.1) rotate(-5deg);
            box-shadow: 0 8px 24px rgba(67, 56, 202, .3);
        }

        .team-name {
            font-size: 19px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 4px;
            transition: color 0.3s;
        }

        .team-role {
            font-size: 14px;
            color: var(--primary);
            font-weight: 700;
            margin-bottom: 14px;
        }

        .team-bio {
            font-size: 14px;
            color: var(--ink-2);
            line-height: 1.7;
        }

        .contact-section {
            background: var(--paper);
            transition: background 0.3s;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            margin-top: 72px;
            align-items: start;
        }

        .contact-info h3 {
            font-size: 28px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 20px;
            transition: color 0.3s;
        }

        .contact-info p {
            font-size: 16px;
            color: var(--ink-2);
            line-height: 1.8;
            margin-bottom: 32px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
            font-size: 15px;
            color: var(--ink-2);
            font-weight: 500;
        }

        .contact-item i {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: var(--primary-glow);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: all 0.3s;
        }

        .contact-item:hover i {
            background: var(--primary);
            color: #fff;
            transform: scale(1.1);
        }

        .contact-form {
            background: var(--glass);
            border-radius: var(--radius);
            padding: 20px;
            border: 1px solid var(--glass-border);
            box-shadow: var(--shadow);
            backdrop-filter: blur(20px);
        }

        .form-group {
            margin-bottom: 10px;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 8px;
            transition: color 0.3s;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1.5px solid var(--glass-border);
            background: var(--paper);
            color: var(--ink);
            font-size: 15px;
            font-family: 'Inter', sans-serif;
            transition: all 0.3s;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-glow);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 120px;
        }

        .cta-section .section-title {
            max-width: 750px;
            margin: 0 auto 20px;
        }

        .cta-section .section-sub {
            margin: 0 auto 48px;
        }

        .cta-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .cta-note {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.5);
            margin-top: 24px;
            font-weight: 500;
        }

        footer {
            background: linear-gradient(180deg, var(--dark-section-2) 0%, var(--dark-section) 100%);
            padding: 50px 8% 20px;
            color: rgba(255, 255, 255, .62);
            transition: background 0.3s;
        }

        .footer-top {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 60px;
