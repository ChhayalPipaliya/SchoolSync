            flex-direction: column;
            justify-content: center;
            padding: 0px 5% 100px 8%;
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--primary-glow);
            border: 1px solid rgba(67, 56, 202, .2);
            color: var(--primary);
