            border-radius: 8px;
        }

        .float-card-amount {
            font-weight: 800;
            color: var(--ink);
            font-size: 20px;
            font-family: 'Inter', sans-serif;
            letter-spacing: -0.5px;
        }

        .float-card-trend {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            color: var(--green);
            font-weight: 700;
            background: rgba(5, 150, 105, 0.08);
            padding: 4px 8px;
            border-radius: 6px;
            width: fit-content;
        }

        .float-card-trend i {
            font-size: 12px;
        }

        .float-card-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            flex-shrink: 0;
        }

        .float-card-info {
            display: flex;
            flex-direction: column;
        }

        .float-card-name {
            font-weight: 700;
            font-size: 13px;
            color: var(--ink);
            letter-spacing: -0.2px;
        }

        .float-card-action {
            font-size: 11px;
            color: var(--ink-3);
            font-weight: 500;
        }

        .float-card-time {
            font-size: 10px;
            color: var(--ink-3);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid rgba(14, 14, 26, 0.06);
        }

        .float-card-1 {
            top: 10%;
            left: 2%;
            animation: float-1 6s ease-in-out infinite;
        }

        .float-card-2 {
            bottom: 18%;
            right: 4%;
            animation: float-2 7s ease-in-out infinite;
        }

        .float-card-3 {
            top: 35%;
            right: 0%;
            animation: float-3 6s ease-in-out infinite;
            min-width: 220px;
            margin-right: 20px;
        }

        @keyframes float-1 {

            0%,
            100% {
                transform: translateY(0) rotate(-2deg);
            }

            50% {
                transform: translateY(-12px) rotate(0deg);
            }
        }

        @keyframes float-2 {

            0%,
            100% {
                transform: translateY(0) rotate(2deg);
            }

            50% {
                transform: translateY(-16px) rotate(0deg);
            }
        }

        @keyframes float-3 {

            0%,
            100% {
                transform: translateY(0) rotate(1deg);
            }

            33% {
                transform: translateY(-10px) rotate(-1deg);
            }

            66% {
                transform: translateY(-6px) rotate(0deg);
            }
        }

