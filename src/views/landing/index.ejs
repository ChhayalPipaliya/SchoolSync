            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
        }

        .float-card-dot {
            width: 10px;
            height: 10px;
            background: var(--green);
            border-radius: 50%;
            animation: pulse 2s infinite;
            box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.2);
            flex-shrink: 0;
        }

        .float-card-title {
            font-weight: 800;
            font-size: 14px;
            color: var(--ink);
            letter-spacing: -0.2px;
        }

        .float-card-body {
            font-size: 12px;
            color: var(--ink-3);
            margin-bottom: 10px;
            font-weight: 500;
            line-height: 1.5;
        }

        .float-card-progress {
            height: 4px;
            background: rgba(14, 14, 26, 0.06);
