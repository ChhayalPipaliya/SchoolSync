            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
            min-width: 200px;
        }

        .float-card:hover {
            transform: scale(1.05) translateY(-6px);
            box-shadow: 0 20px 48px rgba(14, 14, 26, 0.18);
            border-color: rgba(67, 56, 202, 0.25);
        }

