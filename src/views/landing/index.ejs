                height: 52px;
            }

            .mobile-menu {
                top: 52px;
                max-height: 70vh;
                overflow-y: auto;
            }
        }

        @media (-webkit-min-device-pixel-ratio: 2),
        (min-resolution: 192dpi) {
            .hero-grid-pattern {
                background-size: 30px 30px;
            }

            .mockup-bar {
                border-bottom-width: 0.5px;
            }
        }

        @media (hover: hover) and (pointer: fine) {
            .feature-card:hover {
                transform: translateY(-8px);
            }

            .plan-card:hover {
                transform: translateY(-8px);
            }

            .plan-card.featured:hover {
                transform: scale(1.05) translateY(-8px);
            }

            .testimonial-card:hover {
                transform: translateY(-8px);
            }

            .blog-card:hover {
                transform: translateY(-8px);
            }

            .team-card:hover {
                transform: translateY(-8px);
            }

            .mockup-row:hover {
                transform: translateX(6px);
            }

            .stat-mini:hover {
                transform: translateY(-6px);
            }
        }

        @media (hover: none) and (pointer: coarse) {

            .feature-card,
            .plan-card,
            .testimonial-card,
            .blog-card,
            .team-card,
            .step-card {
                transform: none !important;
            }

            .feature-card:active,
            .plan-card:active,
            .testimonial-card:active,
            .blog-card:active,
            .team-card:active {
                transform: scale(0.98) !important;
                transition: transform 0.1s;
            }

            .cursor-dot,
            .cursor-outline {
                display: none !important;
            }

            .float-card {
                animation: none !important;
            }

            .hero-mockup {
                animation: none !important;
            }
        }

        @media print {

            nav,
            .chat-widget,
            .cookie-banner,
            .sticky-cta,
            .back-to-top,
            .hero-right,
            .float-card {
                display: none !important;
            }

            .hero {
                min-height: auto;
                grid-template-columns: 1fr;
            }

            .hero-left {
                padding: 40px 20px;
            }

            .section {
                padding: 40px 20px;
                page-break-inside: avoid;
            }

            body {
                background: white;
                color: black;
            }

            .feature-card,
            .plan-card,
            .step-card,
            .testimonial-card,
            .blog-card,
            .team-card {
                break-inside: avoid;
                box-shadow: none;
                border: 1px solid #ddd;
            }

            a {
                text-decoration: none;
                color: black;
            }

            .comparison-table {
                font-size: 12px;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }

            html {
                scroll-behavior: auto;
            }

            .reveal,
            .reveal-scale {
                opacity: 1;
                transform: none;
            }

            .float-card,
            .hero-mockup,
            .mockup-row,
            .stat-mini,
            .chart-bar-present,
            .chart-bar-absent {
                animation: none !important;
                transition: none !important;
            }

            .partners-track,
            .testimonials-track {
                animation: none !important;
                width: 100%;
                flex-wrap: wrap;
                justify-content: center;
            }

            .partners-track .partner-logo,
            .testimonials-track .testimonial-card {
                margin: 10px;
            }

            .cursor-dot,
            .cursor-outline {
                display: none !important;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }

            html {
                scroll-behavior: auto;
            }

            .reveal,
            .reveal-scale {
                opacity: 1;
                transform: none;
            }

            .float-card,
            .hero-mockup,
            .mockup-row,
            .stat-mini,
            .chart-bar-present,
            .chart-bar-absent {
                animation: none !important;
                transition: none !important;
            }
        }

