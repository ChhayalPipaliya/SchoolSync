<%
    const planOrder = ['Basic', 'Standard', 'Premium'];
    const fallbackPlans = [
        { name: 'Basic', plan_key: 'basic', slug: 'basic', monthly_price: 999, yearly_price: 9999, max_students: 200, max_teachers: 20, max_classes: 20, description: 'Starter plan for small schools', featuresList: ['Student management', 'Attendance', 'Fees', 'Notices', 'Basic reports'] },
        { name: 'Standard', plan_key: 'standard', slug: 'standard', monthly_price: 2499, yearly_price: 24999, max_students: 800, max_teachers: 60, max_classes: 60, description: 'Best plan for growing schools', featuresList: ['Everything in Basic', 'Library', 'Transport', 'Reports', 'Online fees', 'Chat'], is_popular: true },
        { name: 'Premium', plan_key: 'premium', slug: 'premium', monthly_price: 4999, yearly_price: 49999, max_students: 2500, max_teachers: 200, max_classes: 120, description: 'Advanced plan for full ERP usage', featuresList: ['Everything in Standard', 'Meetings', 'Analytics', 'Payroll', 'Admissions', 'Priority support'] }
    ];

    const normalizePlanKey = (value) => String(value || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const publicPlanKeys = new Set(['basic', 'standard', 'premium']);
    const excludedPlanKeys = new Set(['starter', 'professional', 'enterprise', 'basic-monthly', 'standard-monthly', 'premium-monthly', 'basic_monthly', 'standard_monthly', 'premium_monthly']);
    const sourcePlans = Array.isArray(plans) ? plans : [];
    let dbPlans = sourcePlans.filter(plan => {
        const nameKey = normalizePlanKey(plan.name);
        const slugKey = normalizePlanKey(plan.slug);
        const planKey = normalizePlanKey(plan.plan_key);
        const activeValue = plan.is_active;
        const statusValue = String(plan.status || '').toLowerCase();
        const isInactive = activeValue === 0 || activeValue === false || activeValue === '0' || statusValue === 'inactive';
        const isDemoOrTrial = [nameKey, slugKey, planKey].some(key => key.includes('demo') || key.includes('trial'));
        const isExcluded = [nameKey, slugKey, planKey].some(key => excludedPlanKeys.has(key));
        const isPublic = [nameKey, slugKey, planKey].some(key => publicPlanKeys.has(key));
        return !isInactive && !isDemoOrTrial && !isExcluded && isPublic;
    });

    const usingFallbackPlans = dbPlans.length === 0;

    if (usingFallbackPlans) {
        dbPlans = fallbackPlans;
    }

    const hasDisplayValue = (value) => value !== '' && value !== null && value !== undefined;
    const valueOrFallback = (value, fallback) => hasDisplayValue(value) ? value : fallback;

    const displayPlans = dbPlans.map((plan) => {
        const baseKey = normalizePlanKey(plan.slug || plan.plan_key || plan.name)
            .replace(/-(monthly|yearly)$/, '')
            .replace(/_(monthly|yearly)$/, '');

        const matchedFallback = fallbackPlans.find(fallback =>
            normalizePlanKey(fallback.name) === baseKey ||
            normalizePlanKey(fallback.slug) === baseKey ||
            normalizePlanKey(fallback.plan_key) === baseKey
        ) || {};

        const monthlyPriceValue = valueOrFallback(plan.monthly_price, matchedFallback.monthly_price);
        const yearlyPriceValue = valueOrFallback(plan.yearly_price, matchedFallback.yearly_price);
        const maxStudentsValue = valueOrFallback(plan.max_students, matchedFallback.max_students);

        return {
            id: plan.id,
            name: valueOrFallback(plan.name, matchedFallback.name),
            plan_key: valueOrFallback(plan.plan_key, matchedFallback.plan_key),
            slug: valueOrFallback(plan.slug, matchedFallback.slug),
            monthly_price: monthlyPriceValue,
            yearly_price: yearlyPriceValue,
            max_students: maxStudentsValue,
            max_teachers: valueOrFallback(plan.max_teachers, matchedFallback.max_teachers),
            max_classes: valueOrFallback(plan.max_classes, matchedFallback.max_classes),
            display_student_limit: valueOrFallback(plan.display_student_limit, maxStudentsValue),
            student_limit: valueOrFallback(plan.student_limit, matchedFallback.student_limit),
            description: valueOrFallback(plan.description, matchedFallback.description),
            is_popular: valueOrFallback(plan.is_popular, matchedFallback.is_popular),
            has_price: hasDisplayValue(monthlyPriceValue),
            baseKey,
            featuresList: usingFallbackPlans
                ? (matchedFallback.featuresList || plan.featuresList || [])
                : (plan.featuresList || [])
        };
    });

    displayPlans.sort((a, b) => planOrder.map(normalizePlanKey).indexOf(a.baseKey) - planOrder.map(normalizePlanKey).indexOf(b.baseKey));

    const recommendedKey = 'standard';
    const FEATURE_LABELS = {
        dashboard: "Dashboard",
        students: "Students",
        teachers: "Teachers",
        classes: "Classes",
        subjects: "Subjects",
        attendance: "Attendance",
        fees: "Fees",
        exams: "Exams",
        homework: "Homework",
        timetable: "Timetable",
        library: "Library",
        transport: "Transport",
        salary: "Salary",
        certificates: "Certificates",
        reports: "Reports",
        parent_portal: "Parent Portal",
        student_portal: "Student Portal",
        messaging: "Messaging",
        settings: "Settings",
        analytics: "Analytics",
        notices: "Notices",
        events: "Events",
        admissions: "Admissions",
        meetings: "Meetings",
        leaves: "Leaves",
        portal: "Portal"
    };
    const normalizeFeatureKey = (feature) => String(feature || '')
        .trim()
        .toLowerCase()
        .replace(/&/g, 'and')
        .replace(/[^a-z0-9]+/g, '_')
        .replace(/^_+|_+$/g, '');
    const cleanFeatureLabel = (feature) => {
        const key = normalizeFeatureKey(feature);
        return FEATURE_LABELS[key] || String(feature || '')
            .replace(/[_-]/g, ' ')
            .replace(/\b\w/g, char => char.toUpperCase());
    };
    const cleanFeatures = (plan) => {
        const ignored = new Set(['students', 'student', 'attendance', 'fees', 'fee']);
        const seen = new Set();
        return (plan.featuresList || [])
            .filter(feature => {
                const key = normalizeFeatureKey(feature);
                if (!key || ignored.has(key) || seen.has(key)) return false;
                seen.add(key);
                return true;
            })
            .map(cleanFeatureLabel);
    };
    const planParam = (plan) => normalizePlanKey(plan.slug || plan.plan_key || plan.name);
%>

<section class="section pricing-section" id="pricing">
    <div class="reveal" style="text-align:center;">
        <div class="section-tag" style="margin:0 auto 20px;"><i class="fa-solid fa-tag" aria-hidden="true"></i> Simple Pricing</div>
        <h2 class="section-title">Plans for Every School Size</h2>
        <p class="section-sub" style="margin:0 auto;">Start with a 7-day free demo. No credit card required.</p>
    </div>

    <div class="pricing-cycle-selector" role="group" aria-label="Billing cycle">
        <button type="button" class="cycle-btn active" id="btn-monthly" data-cycle="monthly" onclick="togglePricingCycle('monthly')">Monthly</button>
        <button type="button" class="cycle-btn" id="btn-yearly" data-cycle="yearly" onclick="togglePricingCycle('yearly')">
            Yearly <span class="save-badge">Save 20%</span>
        </button>
    </div>

    <div class="pricing-grid">
        <% displayPlans.forEach((plan, index) => {
            const key = planParam(plan);
            const popular = Boolean(plan.is_popular) || plan.baseKey === recommendedKey;
            const studentLimit = plan.display_student_limit || plan.max_students || plan.student_limit || 'Unlimited';
            const monthlyPrice = Math.round(Number(plan.monthly_price || 0));
            const yearlyPrice = Math.round(Number(plan.yearly_price || (monthlyPrice * 12 * 0.8)));
            const features = cleanFeatures(plan);
            const showContactPricing = !plan.has_price;
        %>
            <article class="plan-card <%= popular ? 'featured' : '' %> reveal reveal-delay-<%= Math.min(index + 1, 6) %>">
                <% if (popular) { %>
                    <div class="plan-badge">Most Popular</div>
                <% } %>
                <div class="plan-card-body">
                    <div class="plan-name"><%= plan.name %></div>
                    <p class="plan-description"><%= plan.description || 'Complete school management tools for your team.' %></p>
                    <div class="plan-price-block">
                        <% if (showContactPricing) { %>
                            <div class="plan-price monthly-price">Contact us<small> for pricing</small></div>
                            <div class="plan-price yearly-price" hidden>Contact us<small> for pricing</small></div>
                        <% } else { %>
                            <div class="plan-price monthly-price"><span>₹</span><%= monthlyPrice.toLocaleString('en-IN') %><small>/month</small></div>
                            <div class="plan-price yearly-price" hidden><span>₹</span><%= yearlyPrice.toLocaleString('en-IN') %><small>/year</small></div>
                        <% } %>
                    </div>
                    <div class="plan-period">Up to <%= studentLimit === 'Unlimited' ? 'unlimited students' : studentLimit + ' students' %></div>
                    <div class="plan-divider"></div>
                    <ul class="plan-features">
                        <li><i class="fa-solid fa-check check" aria-hidden="true"></i> Student limit: <%= studentLimit %></li>
                        <% const visibleFeatures = features.slice(0, 8); const extraCount = features.length - visibleFeatures.length; %>
                        <% visibleFeatures.forEach(feature => { %>
                            <li><i class="fa-solid fa-check check" aria-hidden="true"></i> <%= feature %></li>
                        <% }) %>
                        <% if (extraCount > 0) { %>
                            <li class="plan-features-more"><i class="fa-solid fa-plus check" aria-hidden="true"></i> +<%= extraCount %> more features</li>
                        <% } %>
                    </ul>
                </div>
                <div class="plan-actions">
                    <a href="/start-demo?plan=<%= encodeURIComponent(key) %>&billing=monthly" data-plan="<%= key %>" data-billing-base="monthly" class="btn btn-outline plan-cta-link">Choose Plan</a>
                </div>
            </article>
        <% }) %>
    </div>

    <script>
        function togglePricingCycle(cycle) {
            const isYearly = cycle === 'yearly';
            document.querySelectorAll('.monthly-price').forEach(el => { el.hidden = isYearly; });
            document.querySelectorAll('.yearly-price').forEach(el => { el.hidden = !isYearly; });
            document.querySelectorAll('.cycle-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.cycle === cycle));
            document.querySelectorAll('.plan-cta-link').forEach(link => {
                if (link.textContent.trim() === 'Choose Plan') {
                    const plan = link.dataset.plan || '';
                    link.href = '/start-demo?plan=' + encodeURIComponent(plan) + '&billing=' + encodeURIComponent(cycle);
                } else {
                    link.href = '#pricing';
                }
            });
        }
    </script>
</section>

