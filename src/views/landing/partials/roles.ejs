        <%
            const landingRoles = [
                { title: 'Super Admin', icon: 'fa-crown', text: 'Manage schools, plans, subscriptions, billing, support, and SaaS analytics.' },
                { title: 'School Admin', icon: 'fa-school', text: 'Run students, staff, classes, attendance, fees, reports, and school operations.' },
                { title: 'Group Admin', icon: 'fa-building', text: 'Multi-branch overview, consolidated reports, meetings, and cross-school management for school chains.' },
                { title: 'Student', icon: 'fa-user-graduate', text: 'View attendance, homework, notices, exam results, and profile details.' },
                { title: 'Teacher', icon: 'fa-chalkboard-user', text: 'Take attendance, assign homework, manage marks, and track student progress.' },
                { title: 'Librarian', icon: 'fa-book-open-reader', text: 'Manage books, issue-return records, fines, and library reports.' },
                { title: 'Driver', icon: 'fa-bus', text: 'Manage route, vehicle, pickup/drop details, and transport updates.' },
                { title: 'Parent', icon: 'fa-users', text: 'Track attendance, fees, notices, homework, and school updates in one place.' }
            ];
        %>

        <section class="section roles-section" id="roles">
            <div class="reveal" style="text-align:center;">
                <div class="section-tag" style="margin:0 auto 20px;"><i class="fa-solid fa-user-shield" aria-hidden="true"></i> Built for Every Role</div>
                <h2 class="section-title">Dashboards for the Whole School</h2>
                <p class="section-sub" style="margin:0 auto;">Each user gets a focused workspace, so daily work stays simple and accountable.</p>
            </div>
            <div class="roles-grid" aria-label="SchoolSync role dashboards">
                <div class="roles-track">
                    <% for (const role of landingRoles) { %>
                        <article class="role-card">
                            <div class="role-icon"><i class="fa-solid <%= role.icon %>"></i></div>
                            <h3><%= role.title %></h3>
                            <p><%= role.text %></p>
                        </article>
                    <% } %>
                    <% for (const role of landingRoles) { %>
                        <article class="role-card" aria-hidden="true">
                            <div class="role-icon"><i class="fa-solid <%= role.icon %>"></i></div>
                            <h3><%= role.title %></h3>
                            <p><%= role.text %></p>
                        </article>
                    <% } %>
                </div>
            </div>
        </section>
