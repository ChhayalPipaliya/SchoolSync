<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#2563EB">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="SchoolSync">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <title>Start 7-Day Demo | SchoolSync</title>
    <script src="/js/pwa.js" defer></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        };
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('schoolSyncTheme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.add('light-mode-disabled');
                }
            } catch (e) { }
        })();
    </script>
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        * {
            font-family: 'Inter', sans-serif;
        }

        [data-theme="dark"] body {
            background: #0B0F19 !important;
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .form-panel {
            background: #0B0F19 !important;
        }

        [data-theme="dark"] .register-card {
            background: #151D30 !important;
            border-color: #242F4D !important;
            color: #F1F5F9 !important;
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.4) !important;
        }

        [data-theme="dark"] .text-gray-900,
        [data-theme="dark"] .text-gray-800 {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .text-gray-700,
        [data-theme="dark"] .text-gray-600 {
            color: #CBD5E1 !important;
        }

        [data-theme="dark"] .text-gray-500 {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .input-field {
            background: #0F172A !important;
            border-color: #334155 !important;
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .input-field:focus {
            background: #111827 !important;
            border-color: #6366F1 !important;
        }

        body {
            background: #F8FAFC;
            color: #0F172A;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .demo-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(0, .92fr) minmax(420px, 1.08fr);
        }

        .benefit-panel {
            background: linear-gradient(135deg, #4338CA 0%, #5B21B6 100%);
            color: #fff;
            padding: 48px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .benefit-panel::before {
            content: '';
            position: absolute;
            inset: -160px -120px auto auto;
            width: 360px;
            height: 360px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .08);
            pointer-events: none;
        }

        .brand-mark {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: rgba(255, 255, 255, .18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .benefit-list {
            display: grid;
            gap: 16px;
            margin-top: 28px;
        }

        .benefit-item {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .benefit-icon {
            width: 28px;
            height: 28px;
            border-radius: 9px;
            background: rgba(255, 255, 255, .16);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            font-size: 12px;
        }

        .quote-box {
            border: 1px solid rgba(255, 255, 255, .18);
            background: rgba(255, 255, 255, .1);
            border-radius: 14px;
            padding: 18px;
            backdrop-filter: blur(10px);
        }

        .form-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            background: #FFFFFF;
            position: relative;
        }

        .register-card {
            width: 100%;
            max-width: 560px;
            border: 1px solid #E2E8F0;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, .06);
            padding: 32px 28px;
            background: #fff;
            transition: all .25s ease;
        }

        .input-field {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            font-size: 14px;
            background: #F8FAFC;
            transition: all .2s;
            outline: none;
        }

        .input-field:focus {
            border-color: #4F46E5;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, .1);
        }

        .btn-primary {
            width: 100%;
            padding: 13px;
            background: #4338CA;
            border: 0;
            border-radius: 10px;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
        }

        .btn-primary:hover {
            background: #3730A3;
            transform: translateY(-1px);
            box-shadow: 0 10px 28px rgba(67, 56, 202, .25);
        }

        .flash-msg {
            position: relative;
            pointer-events: auto;
            min-width: 280px;
            max-width: min(460px, calc(100vw - 32px));
            border-radius: 12px;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22), 0 2px 8px rgba(0, 0, 0, 0.08);
            animation: flashSlideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            transition: all 0.3s ease;
            border: 1px solid transparent;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .flash-msg.hiding {
            opacity: 0;
            transform: translateY(-12px) scale(0.96);
        }

        .flash-success {
            background: #ECFDF5;
            color: #065F46;
            border-color: #A7F3D0;
        }

        .flash-error {
            background: #FFF1F2;
            color: #9F1239;
            border-color: #FECDD3;
        }

        [data-theme="dark"] .flash-success,
        .light-mode-disabled .flash-success,
        html.dark .flash-success {
            background: #064E3B !important;
            color: #ECFDF5 !important;
            border-color: #059669 !important;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65) !important;
        }

        [data-theme="dark"] .flash-error,
        .light-mode-disabled .flash-error,
        html.dark .flash-error {
            background: #7F1D1D !important;
            color: #FEF2F2 !important;
            border-color: #DC2626 !important;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65) !important;
        }

        @keyframes flashSlideDown {
            from {
                transform: translateY(-20px) scale(0.95);
                opacity: 0;
            }

            to {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }

        .auth-top-nav {
            position: absolute;
            top: 24px;
            right: 24px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            z-index: 50;
        }

        .auth-top-nav .mobile-brand-logo {
            display: none;
        }

        .auth-top-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mobile-brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #0F172A;
            font-weight: 800;
            font-size: 19px;
            flex-shrink: 0;
        }

        [data-theme="dark"] .mobile-brand-logo {
            color: #F8FAFC !important;
        }

        .mobile-brand-mark {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4338CA, #7C3AED);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 4px 12px rgba(67, 56, 202, 0.25);
            flex-shrink: 0;
        }

        @media (max-width: 1024px) {
            .benefit-panel {
                display: none !important;
            }

            .demo-shell {
                grid-template-columns: 1fr !important;
                min-height: 100vh;
            }

            .auth-top-nav {
                position: static !important;
                top: auto !important;
                right: auto !important;
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
                width: 100% !important;
                max-width: 560px !important;
                margin-bottom: 16px !important;
                padding: 0 2px !important;
            }

            .auth-top-nav .mobile-brand-logo {
                display: inline-flex !important;
            }

            .form-panel {
                min-height: 100vh;
                padding: max(16px, env(safe-area-inset-top, 16px)) 16px max(32px, env(safe-area-inset-bottom, 32px)) !important;
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                justify-content: flex-start !important;
                width: 100% !important;
            }

            .register-card {
                padding: 26px 22px !important;
                border-radius: 18px !important;
                width: 100% !important;
                max-width: 560px !important;
            }

            .flash-msg {
                top: 14px;
                left: 14px;
                right: 14px;
                min-width: auto;
            }
        }

        @media (max-width: 640px) {
            .form-panel {
                padding: max(12px, env(safe-area-inset-top, 12px)) 12px max(24px, env(safe-area-inset-bottom, 24px)) !important;
            }

            .auth-top-nav {
                margin-bottom: 12px !important;
            }

            .mobile-brand-logo {
                font-size: 17px !important;
                gap: 8px !important;
            }

            .mobile-brand-mark {
                width: 32px !important;
                height: 32px !important;
                font-size: 14px !important;
                border-radius: 8px !important;
            }

            .register-card {
                padding: 20px 16px !important;
                border-radius: 16px !important;
            }

            .register-card h2 {
                font-size: 20px !important;
            }

            .register-card p.text-sm {
                font-size: 12.5px !important;
            }

            .input-field {
                padding: 10px 12px;
                font-size: 13.5px;
            }
        }

        .auth-lang-menu {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 6px);
            width: 140px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            padding: 6px;
            z-index: 9999;
        }

        [data-theme="dark"] .auth-lang-menu,
        .light-mode-disabled .auth-lang-menu,
        html.dark .auth-lang-menu {
            background: #151D30 !important;
            border-color: #242F4D !important;
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.65) !important;
        }

        .auth-lang-opt {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .auth-lang-opt:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

        .auth-lang-opt.active {
            background: #eef2ff;
            color: #4f46e5;
        }

        [data-theme="dark"] .auth-lang-opt,
        .light-mode-disabled .auth-lang-opt,
        html.dark .auth-lang-opt {
            color: #CBD5E1 !important;
        }

        [data-theme="dark"] .auth-lang-opt:hover,
        .light-mode-disabled .auth-lang-opt:hover,
        html.dark .auth-lang-opt:hover {
            background: #242F4D !important;
            color: #FFFFFF !important;
        }

        [data-theme="dark"] .auth-lang-opt.active,
        .light-mode-disabled .auth-lang-opt.active,
        html.dark .auth-lang-opt.active {
            background: rgba(99, 102, 241, 0.25) !important;
            color: #818cf8 !important;
        }
    </style>
</head>

<body>
    <%- include('../partials/flashMessages') %>
        <div id="flashContainer"
            class="fixed top-5 left-1/2 -translate-x-1/2 z-[999999] flex flex-col items-center gap-2 pointer-events-none w-max max-w-[90vw]">
        </div>
        <main class="demo-shell">
            <aside class="benefit-panel">
                <div class="relative z-10">
                    <a href="/" class="inline-flex items-center gap-3 text-white no-underline">
                        <span class="brand-mark">S</span>
                        <span class="font-bold text-xl">SchoolSync</span>
                    </a>
                </div>
                <div class="relative z-10 my-10">
                    <p class="text-white/70 text-xs font-bold uppercase tracking-widest mb-3"><%-
                            lan.Full_Access_Demo_7_Days %></p>
                    <h1 class="text-4xl font-extrabold leading-tight mb-4"><%- lan.Start_Clean_Title %></h1>
                    <p class="text-white/78 text-sm leading-7 max-w-md"><%- lan.Start_Clean_Desc %></p>
                    <div class="benefit-list">
                        <div class="benefit-item">
                            <span class="benefit-icon"><i class="fa-solid fa-check"></i></span>
                            <div>
                                <div class="font-bold text-sm"><%- lan.No_Credit_Card_Required %></div>
                                <p class="text-white/65 text-xs mt-1"><%- lan.No_Credit_Card_Desc %></p>
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon"><i class="fa-solid fa-bolt"></i></span>
                            <div>
                                <div class="font-bold text-sm"><%- lan.Fast_School_Admin_Access %></div>
                                <p class="text-white/65 text-xs mt-1"><%- lan.Fast_School_Admin_Desc %></p>
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon"><i class="fa-solid fa-shield-halved"></i></span>
                            <div>
                                <div class="font-bold text-sm"><%- lan.School_Wise_Isolation %></div>
                                <p class="text-white/65 text-xs mt-1"><%- lan.School_Wise_Isolation_Desc %></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="quote-box relative z-10">
                    <p class="text-white/88 text-sm italic leading-6"><%- lan.Start_Demo_Quote %></p>
                    <div class="mt-3 text-white/65 text-xs font-bold">SchoolSync onboarding team</div>
                </div>
            </aside>
            <section class="form-panel relative">
                <div class="auth-top-nav">
                    <a href="/" class="mobile-brand-logo">
                        <span class="mobile-brand-mark">S</span>
                        <span>SchoolSync</span>
                    </a>
                    <div class="auth-top-actions">
                        <div class="relative" id="authLangDropdown" style="position:relative;display:inline-block;">
                            <button type="button"
                                class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 text-xs font-semibold hover:bg-gray-200 dark:hover:bg-slate-700 transition-all cursor-pointer shadow-sm h-9"
                                onclick="toggleAuthLang(event)"
                                aria-label="<%- (typeof lan !== 'undefined' && lan.Change_Language) ? lan.Change_Language : 'Change Language' %>">
                                <i class="fas fa-globe text-indigo-500"></i>
                                <span>
                                    <%= (typeof currentLang !=='undefined' && currentLang==='gujrati' ) ? 'ગુજરાતી' :
                                        ((typeof currentLang !=='undefined' && currentLang==='hindi' ) ? 'हिन्दी'
                                        : 'English' ) %>
                                </span>
                                <i class="fas fa-chevron-down text-[10px] text-gray-400"></i>
                            </button>
                            <div id="authLangMenu" class="auth-lang-menu">
                                <a href="javascript:void(0)" onclick="setAppLanguage('english')"
                                    class="auth-lang-opt <%= (typeof currentLang === 'undefined' || currentLang === 'english') ? 'active' : '' %>">
                                    <span>English</span>
                                    <span style="font-size:10px;opacity:0.6;">EN</span>
                                </a>
                                <a href="javascript:void(0)" onclick="setAppLanguage('gujrati')"
                                    class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'active' : '' %>">
                                    <span>ગુજરાતી</span>
                                    <span style="font-size:10px;opacity:0.6;">GU</span>
                                </a>
                                <a href="javascript:void(0)" onclick="setAppLanguage('hindi')"
                                    class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'active' : '' %>">
                                    <span>हिन्दी</span>
                                    <span style="font-size:10px;opacity:0.6;">HI</span>
                                </a>
                            </div>
                        </div>
                        <button type="button"
                            class="theme-toggle-btn w-9 h-9 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:scale-105 transition-all cursor-pointer shadow-sm"
                            id="themeToggleBtn" onclick="toggleTheme()"
                            aria-label="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>"
                            title="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>">
                            <i class="fas fa-moon"></i>
                        </button>
                    </div>
                </div>
                <div class="register-card">
                    <div class="mb-3">
                        <h2 class="text-2xl font-extrabold text-gray-900 mb-1"><%- lan.Create_Demo_Account %></h2>
                        <p class="text-gray-500 text-sm"><%- lan.Start_7_Day_Demo_Desc %></p>
                    </div>
                    <form action="/start-demo" method="POST" id="demoForm" class="space-y-4">
                        <input type="hidden" name="_csrf"
                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.School_Name %> *</label>
                            <input type="text" name="school_name" required class="input-field"
                                placeholder="e.g. Gujarat Public School">
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.School_Type %>
                                        *</label>
                                <select name="school_type" required class="input-field">
                                    <option value="KG to 12"><%- lan.KG_To_12 %></option>
                                    <option value="Pre-Primary"><%- lan.Pre_Primary %></option>
                                    <option value="Primary"><%- lan.Primary %></option>
                                    <option value="Secondary"><%- lan.Secondary %></option>
                                    <option value="Higher Secondary"><%- lan.Higher_Secondary %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.Medium %> *</label>
                                <select name="medium" required class="input-field">
                                    <option value="ENGLISH"><%- lan.English %></option>
                                    <option value="GUJARATI"><%- lan.Gujarati %></option>
                                    <option value="HINDI"><%- lan.Hindi %></option>
                                </select>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.Admin_First_Name %>
                                        *</label>
                                <input type="text" name="first_name" required class="input-field"
                                    placeholder="<%- lan.Enter_First_Name %>">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.Admin_Last_Name %>
                                        *</label>
                                <input type="text" name="last_name" required class="input-field"
                                    placeholder="<%- lan.Enter_Last_Name %>">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.Admin_Email %>
                                        *</label>
                                <input type="email" name="admin_email" required class="input-field"
                                    placeholder="admin@school.com">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.Admin_Phone %>
                                        *</label>
                                <input type="tel" name="admin_phone" required class="input-field"
                                    placeholder="+91 XXXXX XXXXX">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.Password %>
                                        *</label>
                                <input type="password" name="password" id="passwordInput" required class="input-field"
                                    placeholder="<%- lan.Password_Min_Length %>">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5"><%- lan.Confirm_Password %>
                                        *</label>
                                <input type="password" name="confirm_password" id="confirmPasswordInput" required
                                    class="input-field" placeholder="<%- lan.Reenter_New_Password %>">
                            </div>
                        </div>
                        <label class="flex items-center gap-2 text-xs text-gray-600 cursor-pointer">
                            <input type="checkbox" name="terms" value="accepted" required
                                class="w-4 h-4 w-auto flex-shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
                            <span><%- lan.I_Agree_To_The %> <a href="/terms"
                                        class="font-bold text-indigo-600 hover:underline"><%- lan.Terms %></a> <%-
                                        lan.And %> <a href="/privacy"
                                            class="font-bold text-indigo-600 hover:underline"><%- lan.Privacy_Policy
                                                %></a>.</span>
                        </label>
                        <button type="submit" class="btn-primary flex items-center justify-center gap-2">
                            <i class="fa-solid fa-rocket"></i> <%- lan.Start_7_Day_Full_Access_Demo %>
                        </button>
                    </form>
                    <p class="text-center text-sm text-gray-500 mt-5"><%- lan.Already_Have_An_Account %>
                            <a href="/login" class="font-semibold text-indigo-600 hover:text-indigo-700"><%- lan.Sign_In
                                    %></a>
                    </p>
                </div>
            </section>
        </main>
        <script>
            window.addEventListener("DOMContentLoaded", () => {
                const form = document.getElementById('demoForm');
                if (!form) return;

                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const pass = document.getElementById("passwordInput").value;
                    const confirmPass = document.getElementById("confirmPasswordInput").value;
                    if (pass !== confirmPass) {
                        showFlash('error', 'Passwords do not match.');
                        return;
                    };

                    const submitBtn = this.querySelector('button[type="submit"]');
                    const originalBtnText = submitBtn.innerHTML;
                    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating Demo...';
                    submitBtn.disabled = true;
                    try {
                        const res = await fetch('/start-demo', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(Object.fromEntries(new FormData(this).entries()))
                        });
                        const data = await res.json();
                        if (data.success) {
                            showFlash('success', data.message || 'Demo started successfully!');
                            setTimeout(() => { window.location.href = data.redirectTo || '/login'; }, 1200);
                        } else {
                            showFlash('error', data.message || 'Registration failed.');
                            submitBtn.innerHTML = originalBtnText;
                            submitBtn.disabled = false;
                        };
                    } catch (err) {
                        showFlash('error', 'Server error. Please try again.');
                        submitBtn.innerHTML = originalBtnText;
                        submitBtn.disabled = false;
                    };
                });
            });

            function showFlash(type, message) {
                const container = document.getElementById("flashContainer");
                if (!container) return;
                container.innerHTML = "";
                const div = document.createElement("div");
                div.className = `flash-msg ${type === "success" ? "flash-success" : "flash-error"}`;
                const icon = type === "success" ? "fa-circle-check" : "fa-circle-exclamation";
                div.innerHTML = `<i class="fa-solid ${icon} text-base flex-shrink-0"></i> <span>${message}</span>`;
                container.appendChild(div);
                setTimeout(() => {
                    div.classList.add("hiding");
                    setTimeout(() => div.remove(), 300);
                }, 3000);
            };

            function toggleAuthLang(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                };
                const menu = document.getElementById('authLangMenu');
                if (!menu) return;
                const isHidden = menu.style.display === 'none' || menu.style.display === '';
                menu.style.display = isHidden ? 'block' : 'none';
            };

            window.setAppLanguage = async function (lang) {
                try {
                    const response = await fetch('/language/set', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ language: lang })
                    });
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        window.location.href = '/language/change/' + encodeURIComponent(lang);
                    };
                } catch (err) {
                    window.location.href = '/language/change/' + encodeURIComponent(lang);
                };
            };

            document.addEventListener('click', function (e) {
                const dropdown = document.getElementById('authLangDropdown');
                const menu = document.getElementById('authLangMenu');
                if (dropdown && menu && !dropdown.contains(e.target)) {
                    menu.style.display = 'none';
                };
            });
        </script>
</body>

</html>