<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Start 7-Day Demo | SchoolSync</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        };
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('schoolSyncTheme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.add('light-mode-disabled');
                }
            } catch (e) { }
        })();
    </script>
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        * {
            font-family: 'Inter', sans-serif;
        }

        [data-theme="dark"] body {
            background: #0B0F19 !important;
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .form-panel {
            background: #0B0F19 !important;
        }

        [data-theme="dark"] .register-card {
            background: #151D30 !important;
            border-color: #242F4D !important;
            color: #F1F5F9 !important;
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.4) !important;
        }

        [data-theme="dark"] .text-gray-900,
        [data-theme="dark"] .text-gray-800 {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .text-gray-700,
        [data-theme="dark"] .text-gray-600 {
            color: #CBD5E1 !important;
        }

        [data-theme="dark"] .text-gray-500 {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .input-field {
            background: #0F172A !important;
            border-color: #334155 !important;
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .input-field:focus {
            background: #111827 !important;
            border-color: #6366F1 !important;
        }

        body {
            background: #F8FAFC;
            color: #0F172A;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .demo-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(0, .92fr) minmax(420px, 1.08fr);
        }

        .benefit-panel {
            background: linear-gradient(135deg, #4338CA 0%, #5B21B6 100%);
            color: #fff;
            padding: 48px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .benefit-panel::before {
            content: '';
            position: absolute;
            inset: -160px -120px auto auto;
            width: 360px;
            height: 360px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .08);
            pointer-events: none;
        }

        .brand-mark {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: rgba(255, 255, 255, .18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .benefit-list {
            display: grid;
            gap: 16px;
            margin-top: 28px;
        }

        .benefit-item {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .benefit-icon {
            width: 28px;
            height: 28px;
            border-radius: 9px;
            background: rgba(255, 255, 255, .16);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            font-size: 12px;
        }

        .quote-box {
            border: 1px solid rgba(255, 255, 255, .18);
            background: rgba(255, 255, 255, .1);
            border-radius: 14px;
            padding: 18px;
            backdrop-filter: blur(10px);
        }

        .form-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            background: #FFFFFF;
            position: relative;
        }

        .register-card {
            width: 100%;
            max-width: 560px;
            border: 1px solid #E2E8F0;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(15, 23, 42, .06);
            padding: 32px 28px;
            background: #fff;
            transition: all .25s ease;
        }

        .input-field {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            font-size: 14px;
            background: #F8FAFC;
            transition: all .2s;
            outline: none;
        }

        .input-field:focus {
            border-color: #4F46E5;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, .1);
        }

        .btn-primary {
            width: 100%;
            padding: 13px;
            background: #4338CA;
            border: 0;
            border-radius: 10px;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
        }

        .btn-primary:hover {
            background: #3730A3;
            transform: translateY(-1px);
            box-shadow: 0 10px 28px rgba(67, 56, 202, .25);
        }

        .flash-msg {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            min-width: 280px;
            max-width: min(420px, calc(100vw - 32px));
            border-radius: 12px;
            padding: 12px 18px;
            font-size: 13.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, .15);
            border: 1px solid transparent;
        }

        .flash-success {
            background: #ECFDF5;
            color: #065F46;
            border-color: #A7F3D0;
        }

        .flash-error {
            background: #FFF1F2;
            color: #9F1239;
            border-color: #FECDD3;
        }

        [data-theme="dark"] .flash-success,
        .light-mode-disabled .flash-success,
        html.dark .flash-success {
            background: #064E3B !important;
            color: #ECFDF5 !important;
            border-color: #059669 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
        }

        [data-theme="dark"] .flash-error,
        .light-mode-disabled .flash-error,
        html.dark .flash-error {
            background: #7F1D1D !important;
            color: #FEF2F2 !important;
            border-color: #DC2626 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
        }

        @media (max-width: 480px) {
            .flash-msg {
                top: 14px;
                right: 14px;
                left: 14px;
                min-width: auto;
                max-width: none;
                justify-content: center;
            }
        }

        .mobile-brand-bar {
            display: none;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 560px;
            margin-bottom: 16px;
        }

        .mobile-brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #0F172A;
            font-weight: 800;
            font-size: 19px;
        }

        [data-theme="dark"] .mobile-brand-logo {
            color: #F8FAFC !important;
        }

        .mobile-brand-mark {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4338CA, #7C3AED);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 4px 12px rgba(67, 56, 202, 0.25);
        }

        @media (max-width: 1024px) {
            .benefit-panel {
                display: none !important;
            }

            .demo-shell {
                grid-template-columns: 1fr !important;
                min-height: 100vh;
            }

            .mobile-brand-bar {
                display: flex !important;
            }

            .form-panel {
                min-height: 100vh;
                padding: 24px 16px 40px !important;
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                justify-content: center !important;
                width: 100% !important;
            }

            .form-panel > .theme-toggle-btn {
                display: none !important;
            }

            .register-card {
                padding: 26px 22px !important;
                border-radius: 18px !important;
                width: 100% !important;
                max-width: 560px !important;
            }

            .flash-msg {
                top: 14px;
                left: 14px;
                right: 14px;
                min-width: auto;
            }
        }

        @media (max-width: 640px) {
            .form-panel {
                padding: 16px 12px 32px !important;
            }

            .register-card {
                padding: 20px 16px !important;
                border-radius: 16px !important;
            }

            .register-card h2 {
                font-size: 20px !important;
            }

            .register-card p.text-sm {
                font-size: 12.5px !important;
            }

            .input-field {
                padding: 10px 12px;
                font-size: 13.5px;
            }
        }

        .auth-lang-opt {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .auth-lang-opt:hover {
            background: #f1f5f9;
        }
        .auth-lang-opt.active {
            background: #eef2ff;
            color: #4f46e5;
        }
        [data-theme="dark"] .auth-lang-opt,
        html.dark .auth-lang-opt {
            color: #f1f5f9;
        }
        [data-theme="dark"] .auth-lang-opt:hover,
        html.dark .auth-lang-opt:hover {
            background: #334155;
        }
        [data-theme="dark"] .auth-lang-opt.active,
        html.dark .auth-lang-opt.active {
            background: rgba(99, 102, 241, 0.2);
            color: #818cf8;
        }
    </style>
</head>

<body>
    <%- include('../partials/flashMessages') %>
        <div id="flashContainer" class="fixed top-5 right-5 z-50"></div>
        <main class="demo-shell">
            <aside class="benefit-panel">
                <div class="relative z-10">
                    <a href="/" class="inline-flex items-center gap-3 text-white no-underline">
                        <span class="brand-mark">S</span>
                        <span class="font-bold text-xl">SchoolSync</span>
                    </a>
                </div>
                <div class="relative z-10 my-10">
                    <p class="text-white/70 text-xs font-bold uppercase tracking-widest mb-3">7-Day Full Access Demo</p>
                    <h1 class="text-4xl font-extrabold leading-tight mb-4">Start clean. Set up the rest after login.
                    </h1>
                    <p class="text-white/78 text-sm leading-7 max-w-md">Create your school account with only the
                        essentials. Address, board, medium, and class setup can be completed from the admin panel later.
                    </p>
                    <div class="benefit-list">
                        <div class="benefit-item">
                            <span class="benefit-icon"><i class="fa-solid fa-check"></i></span>
                            <div>
                                <div class="font-bold text-sm">No credit card required</div>
                                <p class="text-white/65 text-xs mt-1">Try the full school workflow before choosing
                                    billing.</p>
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon"><i class="fa-solid fa-bolt"></i></span>
                            <div>
                                <div class="font-bold text-sm">Fast school admin access</div>
                                <p class="text-white/65 text-xs mt-1">Use one admin account to start configuring
                                    modules.</p>
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon"><i class="fa-solid fa-shield-halved"></i></span>
                            <div>
                                <div class="font-bold text-sm">School-wise isolation</div>
                                <p class="text-white/65 text-xs mt-1">Your trial data stays scoped to your school.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="quote-box relative z-10">
                    <p class="text-white/88 text-sm italic leading-6">“A short registration form is exactly how school
                        demos should begin. Everything else can wait until setup.”</p>
                    <div class="mt-3 text-white/65 text-xs font-bold">SchoolSync onboarding team</div>
                </div>
            </aside>
            <section class="form-panel relative">
                <div class="absolute top-6 right-6 flex items-center gap-2" style="z-index: 50;">
                    <div class="relative" id="authLangDropdown" style="position:relative;display:inline-block;">
                        <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 text-xs font-semibold hover:bg-gray-200 dark:hover:bg-slate-700 transition-all cursor-pointer shadow-sm h-9" onclick="toggleAuthLang(event)" aria-label="<%- (typeof lan !== 'undefined' && lan.Change_Language) ? lan.Change_Language : 'Change Language' %>">
                            <i class="fas fa-globe text-indigo-500"></i>
                            <span><%= (typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'ગુજરાતી' : ((typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'हिन्दी' : 'English') %></span>
                            <i class="fas fa-chevron-down text-[10px] text-gray-400"></i>
                        </button>
                        <div id="authLangMenu" style="display:none;position:absolute;right:0;top:calc(100% + 6px);width:140px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 10px 25px -5px rgba(0,0,0,0.1);padding:6px;z-index:9999;">
                            <a href="javascript:void(0)" onclick="setAppLanguage('english')" class="auth-lang-opt <%= (typeof currentLang === 'undefined' || currentLang === 'english') ? 'active' : '' %>">
                                <span>English</span>
                                <span style="font-size:10px;opacity:0.6;">EN</span>
                            </a>
                            <a href="javascript:void(0)" onclick="setAppLanguage('gujrati')" class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'active' : '' %>">
                                <span>ગુજરાતી</span>
                                <span style="font-size:10px;opacity:0.6;">GU</span>
                            </a>
                            <a href="javascript:void(0)" onclick="setAppLanguage('hindi')" class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'active' : '' %>">
                                <span>हिन्दी</span>
                                <span style="font-size:10px;opacity:0.6;">HI</span>
                            </a>
                        </div>
                    </div>
                    <button type="button"
                        class="theme-toggle-btn w-9 h-9 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:scale-105 transition-all cursor-pointer shadow-sm"
                        id="themeToggleBtn" onclick="toggleTheme()" aria-label="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>" title="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>">
                        <i class="fas fa-moon"></i>
                    </button>
                </div>

                <div class="mobile-brand-bar">
                    <a href="/" class="mobile-brand-logo">
                        <span class="mobile-brand-mark">S</span>
                        <span>SchoolSync</span>
                    </a>
                    <div class="flex items-center gap-2">
                        <button type="button"
                            class="w-9 h-9 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:scale-105 transition-all cursor-pointer shadow-sm"
                            onclick="toggleTheme()" aria-label="Switch Theme" title="Switch Theme">
                            <i class="fas fa-moon"></i>
                        </button>
                    </div>
                </div>

                <div class="register-card">
                    <div class="mb-5">
                        <h2 class="text-2xl font-extrabold text-gray-900 mb-1">Create your demo account</h2>
                        <p class="text-gray-500 text-sm">Start your 7-day free demo. No credit card required. Full
                            access during trial. Upgrade anytime after trial.</p>
                    </div>
                    <form action="/start-demo" method="POST" id="demoForm" class="space-y-4">
                        <input type="hidden" name="_csrf"
                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1.5">School Name *</label>
                            <input type="text" name="school_name" required class="input-field"
                                placeholder="e.g. Gujarat Public School">
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5">School Type *</label>
                                <select name="school_type" required class="input-field">
                                    <option value="KG to 12">KG to 12</option>
                                    <option value="Pre-Primary">Pre-Primary</option>
                                    <option value="Primary">Primary</option>
                                    <option value="Secondary">Secondary</option>
                                    <option value="Higher Secondary">Higher Secondary</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5">Medium *</label>
                                <select name="medium" required class="input-field">
                                    <option value="ENGLISH">English</option>
                                    <option value="GUJARATI">Gujarati</option>
                                    <option value="HINDI">Hindi</option>
                                </select>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5">Admin First Name *</label>
                                <input type="text" name="first_name" required class="input-field"
                                    placeholder="First name">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5">Admin Last Name *</label>
                                <input type="text" name="last_name" required class="input-field"
                                    placeholder="Last name">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5">Admin Email *</label>
                                <input type="email" name="admin_email" required class="input-field"
                                    placeholder="admin@school.com">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5">Admin Phone *</label>
                                <input type="tel" name="admin_phone" required class="input-field"
                                    placeholder="+91 XXXXX XXXXX">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5">Password *</label>
                                <input type="password" name="password" id="passwordInput" required class="input-field"
                                    placeholder="Min 8 characters">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-700 mb-1.5">Confirm Password *</label>
                                <input type="password" name="confirm_password" id="confirmPasswordInput" required
                                    class="input-field" placeholder="Re-enter password">
                            </div>
                        </div>
                        <label class="flex items-center gap-2 text-xs text-gray-600 cursor-pointer">
                            <input type="checkbox" name="terms" value="accepted" required
                                class="w-4 h-4 w-auto flex-shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
                            <span>I agree to the <a href="/terms"
                                    class="font-bold text-indigo-600 hover:underline">Terms</a> and <a href="/privacy"
                                    class="font-bold text-indigo-600 hover:underline">Privacy Policy</a>.</span>
                        </label>
                        <button type="submit" class="btn-primary flex items-center justify-center gap-2">
                            <i class="fa-solid fa-rocket"></i> Start 7-Day Full Access Demo
                        </button>
                    </form>
                    <p class="text-center text-sm text-gray-500 mt-5">Already have an account?
                        <a href="/login" class="font-semibold text-indigo-600 hover:text-indigo-700">Sign in</a>
                    </p>
                </div>
            </section>
        </main>
        <script>
            window.addEventListener("DOMContentLoaded", () => {
                const form = document.getElementById('demoForm');
                if (!form) return;

                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const pass = document.getElementById("passwordInput").value;
                    const confirmPass = document.getElementById("confirmPasswordInput").value;
                    if (pass !== confirmPass) {
                        showFlash('error', 'Passwords do not match.');
                        return;
                    };

                    const submitBtn = this.querySelector('button[type="submit"]');
                    const originalBtnText = submitBtn.innerHTML;
                    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating Demo...';
                    submitBtn.disabled = true;
                    try {
                        const res = await fetch('/start-demo', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(Object.fromEntries(new FormData(this).entries()))
                        });
                        const data = await res.json();
                        if (data.success) {
                            showFlash('success', data.message || 'Demo started successfully!');
                            setTimeout(() => { window.location.href = data.redirectTo || '/login'; }, 1200);
                        } else {
                            showFlash('error', data.message || 'Registration failed.');
                            submitBtn.innerHTML = originalBtnText;
                            submitBtn.disabled = false;
                        }
                    } catch (err) {
                        showFlash('error', 'Server error. Please try again.');
                        submitBtn.innerHTML = originalBtnText;
                        submitBtn.disabled = false;
                    };
                });
            });

            function showFlash(type, message) {
                const container = document.getElementById("flashContainer");
                const div = document.createElement("div");
                div.className = `flash-msg ${type === "success" ? "flash-success" : "flash-error"}`;
                div.innerHTML = `<i class="fa-solid ${type === "success" ? "fa-circle-check" : "fa-circle-exclamation"}"></i> ${message}`;
                container.appendChild(div);
                setTimeout(() => div.remove(), 3500);
            };

            function toggleAuthLang(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                const menu = document.getElementById('authLangMenu');
                if (!menu) return;
                const isHidden = menu.style.display === 'none' || menu.style.display === '';
                menu.style.display = isHidden ? 'block' : 'none';
            }

            window.setAppLanguage = async function(lang) {
                try {
                    const response = await fetch('/language/set', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ language: lang })
                    });
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        window.location.href = '/language/change/' + encodeURIComponent(lang);
                    }
                } catch (err) {
                    window.location.href = '/language/change/' + encodeURIComponent(lang);
                }
            };

            document.addEventListener('click', function(e) {
                const dropdown = document.getElementById('authLangDropdown');
                const menu = document.getElementById('authLangMenu');
                if (dropdown && menu && !dropdown.contains(e.target)) {
                    menu.style.display = 'none';
                }
            });
        </script>
</body>

</html>