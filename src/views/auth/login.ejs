<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#2563EB">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="SchoolSync">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <title>Login | SchoolSync</title>
    <script src="/js/pwa.js" defer></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        };
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('schoolSyncTheme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.add('light-mode-disabled');
                }
            } catch (e) { }
        })();
    </script>
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        [data-theme="dark"],
        .light-mode-disabled,
        html[data-theme="dark"],
        html.dark {
            --login-bg: #0B0F19;
            --login-card: #151D30;
            --login-inner: #101726;
            --login-border: #242F4D;
            --login-text: #F8FAFC;
            --login-muted: #94A3B8;
        }

        [data-theme="dark"] body,
        .light-mode-disabled body {
            background-color: #0B0F19 !important;
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .login-right-pane,
        .light-mode-disabled .login-right-pane {
            background-color: #0B0F19 !important;
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .login-title,
        .light-mode-disabled .login-title {
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .login-subtitle,
        .light-mode-disabled .login-subtitle {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .login-label,
        .light-mode-disabled .login-label {
            color: #CBD5E1 !important;
        }

        [data-theme="dark"] .input-field,
        .light-mode-disabled .input-field {
            background: #101726 !important;
            border-color: #242F4D !important;
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .input-field:focus,
        .light-mode-disabled .input-field:focus {
            background: #151D30 !important;
            border-color: #6366F1 !important;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25) !important;
        }

        [data-theme="dark"] .password-toggle-btn,
        .light-mode-disabled .password-toggle-btn {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .password-toggle-btn:hover,
        .light-mode-disabled .password-toggle-btn:hover {
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .remember-label,
        .light-mode-disabled .remember-label {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .forgot-link,
        [data-theme="dark"] .demo-link,
        .light-mode-disabled .forgot-link,
        .light-mode-disabled .demo-link {
            color: #818CF8 !important;
        }

        [data-theme="dark"] .forgot-link:hover,
        [data-theme="dark"] .demo-link:hover,
        .light-mode-disabled .forgot-link:hover,
        .light-mode-disabled .demo-link:hover {
            color: #A5B4FC !important;
        }

        [data-theme="dark"] .divider-line,
        .light-mode-disabled .divider-line {
            background-color: #242F4D !important;
        }

        [data-theme="dark"] .divider-text,
        .light-mode-disabled .divider-text {
            color: #64748B !important;
        }

        [data-theme="dark"] .google-btn,
        .light-mode-disabled .google-btn {
            background: #101726 !important;
            border-color: #242F4D !important;
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .google-btn:hover,
        .light-mode-disabled .google-btn:hover {
            background: #151D30 !important;
            border-color: #3B82F6 !important;
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .signup-prompt,
        .light-mode-disabled .signup-prompt {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .quick-login-section,
        .light-mode-disabled .quick-login-section {
            border-top-color: #242F4D !important;
        }

        [data-theme="dark"] .quick-login-label,
        .light-mode-disabled .quick-login-label {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .quick-btn,
        .light-mode-disabled .quick-btn {
            background: #101726 !important;
            border-color: #242F4D !important;
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .quick-btn:hover,
        .light-mode-disabled .quick-btn:hover {
            border-color: #6366F1 !important;
            background: #151D30 !important;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.25) !important;
        }

        [data-theme="dark"] .quick-btn .btn-text,
        .light-mode-disabled .quick-btn .btn-text {
            color: #F8FAFC !important;
        }

        [data-theme="dark"] .quick-btn .btn-text span,
        .light-mode-disabled .quick-btn .btn-text span {
            color: #94A3B8 !important;
        }

        * {
            font-family: 'Inter', sans-serif;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 60%, #A855F7 100%);
        }

        .input-field {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            font-size: 14px;
            background: #F8FAFC;
            transition: all 0.2s;
            outline: none;
        }

        .input-field:focus {
            border-color: #4F46E5;
            background: white;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .btn-primary {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.35);
        }

        .btn-primary:disabled {
            opacity: 0.7;
            transform: none;
        }

        .flash-msg {
            position: relative;
            pointer-events: auto;
            min-width: 280px;
            max-width: min(460px, calc(100vw - 32px));
            border-radius: 12px;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22), 0 2px 8px rgba(0, 0, 0, 0.08);
            animation: flashSlideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            transition: all 0.3s ease;
            border: 1px solid transparent;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .flash-msg.hiding {
            opacity: 0;
            transform: translateY(-12px) scale(0.96);
        }

        .flash-success {
            background: #ECFDF5;
            color: #065F46;
            border-color: #A7F3D0;
        }

        .flash-error {
            background: #FFF1F2;
            color: #9F1239;
            border-color: #FECDD3;
        }

        [data-theme="dark"] .flash-success,
        .light-mode-disabled .flash-success,
        html.dark .flash-success {
            background: #064E3B !important;
            color: #ECFDF5 !important;
            border-color: #059669 !important;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65) !important;
        }

        [data-theme="dark"] .flash-error,
        .light-mode-disabled .flash-error,
        html.dark .flash-error {
            background: #7F1D1D !important;
            color: #FEF2F2 !important;
            border-color: #DC2626 !important;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65) !important;
        }

        @keyframes flashSlideDown {
            from {
                transform: translateY(-20px) scale(0.95);
                opacity: 0;
            }

            to {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 16px;
            backdrop-filter: blur(10px);
        }

        .blob1 {
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            top: -100px;
            right: -100px;
        }

        .blob2 {
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            bottom: -80px;
            left: -80px;
        }

        .quick-login-section {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #F1F5F9;
        }

        .quick-login-label {
            text-align: center;
            font-size: 11px;
            font-weight: 600;
            color: #94A3B8;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .quick-login-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .quick-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            border-radius: 10px;
            border: 1.5px solid transparent;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: left;
            position: relative;
            overflow: hidden;
        }

        .quick-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .quick-btn:hover::before {
            opacity: 1;
        }

        .quick-btn:hover {
            transform: translateY(-1px);
        }

        .quick-btn:active {
            transform: translateY(0);
        }

        .quick-btn .btn-icon {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            flex-shrink: 0;
        }

        .quick-btn .btn-text {
            line-height: 1.2;
        }

        .quick-btn .btn-text span {
            display: block;
            font-size: 10px;
            font-weight: 400;
            opacity: 0.7;
            margin-top: 1px;
        }

        .btn-student .btn-icon {
            background: #D97706;
            color: rgb(255, 255, 255);
        }

        .btn-student:hover {
            background: #FEF3C7;
            border-color: #FCD34D;
            box-shadow: 0 4px 12px rgba(217, 119, 6, 0.15);
        }

        .btn-superadmin {
            background: #EEF2FF;
            border-color: #C7D2FE;
            color: #3730A3;
        }

        .btn-superadmin .btn-icon {
            background: #4F46E5;
            color: white;
        }

        .btn-superadmin:hover {
            background: #E0E7FF;
            border-color: #A5B4FC;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.15);
        }

        .btn-schooladmin {
            background: #F5F3FF;
            border-color: #DDD6FE;
            color: #5B21B6;
        }

        .btn-schooladmin .btn-icon {
            background: #7C3AED;
            color: white;
        }

        .btn-schooladmin:hover {
            background: #EDE9FE;
            border-color: #C4B5FD;
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.15);
        }

        .btn-groupadmin {
            background: #ECFEFF;
            border-color: #A5F3FC;
            color: #155E75;
        }

        .btn-groupadmin .btn-icon {
            background: #0891B2;
            color: white;
        }

        .btn-groupadmin:hover {
            background: #CFFAFE;
            border-color: #67E8F9;
            box-shadow: 0 4px 12px rgba(8, 145, 178, 0.15);
        }

        .btn-teacher {
            background: #ECFDF5;
            border-color: #A7F3D0;
            color: #065F46;
        }

        .btn-teacher .btn-icon {
            background: #059669;
            color: white;
        }

        .btn-teacher:hover {
            background: #D1FAE5;
            border-color: #6EE7B7;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.15);
        }

        .btn-student {
            background: #FFFBEB;
            border-color: #FDE68A;
            color: #92400E;
        }

        .btn-student .btn-icon {
            background: #D97706;
            color: white;
        }

        .btn-student:hover {
            background: #FEF3C7;
            border-color: #FCD34D;
            box-shadow: 0 4px 12px rgba(217, 119, 6, 0.15);
        }

        .btn-librarian {
            background: #F0F9FF;
            border-color: #BAE6FD;
            color: #075985;
        }

        .btn-librarian .btn-icon {
            background: #0284C7;
            color: white;
        }

        .btn-librarian:hover {
            background: #E0F2FE;
            border-color: #7DD3FC;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.15);
        }

        .btn-driver {
            background: #F8FAFC;
            border-color: #E2E8F0;
            color: #1E293B;
        }

        .btn-driver .btn-icon {
            background: #475569;
            color: white;
        }

        .btn-driver:hover {
            background: #F1F5F9;
            border-color: #CBD5E1;
            box-shadow: 0 4px 12px rgba(71, 85, 105, 0.15);
        }

        .btn-parent {
            background: #FFF1F2;
            border-color: #FECDD3;
            color: #9F1239;
        }

        .btn-parent .btn-icon {
            background: #E11D48;
            color: white;
        }

        .btn-parent:hover {
            background: #FFE4E6;
            border-color: #FDA4AF;
            box-shadow: 0 4px 12px rgba(225, 29, 72, 0.15);
        }

        .quick-btn.loading {
            opacity: 0.7;
            pointer-events: none;
        }

        .quick-btn.loading .btn-icon i {
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @media (max-width: 375px) {
            .quick-login-grid {
                grid-template-columns: 1fr;
            }
        }

        .auth-lang-menu {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 6px);
            width: 140px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            padding: 6px;
            z-index: 9999;
        }

        [data-theme="dark"] .auth-lang-menu,
        .light-mode-disabled .auth-lang-menu,
        html.dark .auth-lang-menu {
            background: #151D30 !important;
            border-color: #242F4D !important;
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.65) !important;
        }

        .auth-lang-opt {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .auth-lang-opt:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

        .auth-lang-opt.active {
            background: #eef2ff;
            color: #4f46e5;
        }

        [data-theme="dark"] .auth-lang-opt,
        .light-mode-disabled .auth-lang-opt,
        html.dark .auth-lang-opt {
            color: #CBD5E1 !important;
        }

        [data-theme="dark"] .auth-lang-opt:hover,
        .light-mode-disabled .auth-lang-opt:hover,
        html.dark .auth-lang-opt:hover {
            background: #242F4D !important;
            color: #FFFFFF !important;
        }

        [data-theme="dark"] .auth-lang-opt.active,
        .light-mode-disabled .auth-lang-opt.active,
        html.dark .auth-lang-opt.active {
            background: rgba(99, 102, 241, 0.25) !important;
            color: #818cf8 !important;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">
    <%- include('../partials/flashMessages') %>
        <div id="flashContainer"
            class="fixed top-5 left-1/2 -translate-x-1/2 z-[999999] flex flex-col items-center gap-2 pointer-events-none w-max max-w-[90vw]">
        </div>
        <div class="flex min-h-screen">
            <div class="hidden lg:flex lg:w-1/2 gradient-bg flex-col justify-between p-12 relative overflow-hidden">
                <div class="blob1"></div>
                <div class="blob2"></div>
                <div class="relative z-10 flex items-center gap-3">
                    <div
                        class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center text-white font-bold text-lg backdrop-blur">
                        S</div>
                    <span class="text-white font-bold text-xl">SchoolSync</span>
                </div>
                <div class="relative z-10">
                    <div
                        class="inline-flex items-center gap-2 bg-white/15 text-white text-sm px-4 py-2 rounded-full mb-3 backdrop-blur">
                        <i class="fa-solid fa-shield-halved"></i><%- lan.Trusted_By_Schools %>
                    </div>
                    <h2 class="text-4xl font-bold text-white mb-4 leading-tight"><%-
                            lan.Complete_School_Management_Platform %></h2>
                    <p class="text-white/80 text-base mb-8 leading-relaxed"><%- lan.Login_Hero_Desc %></p>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="feature-card">
                            <i class="fa-solid fa-users text-white/80 mb-2 text-lg"></i>
                            <div class="text-white font-semibold text-sm"><%- lan.Student_Management %></div>
                            <div class="text-white/60 text-xs mt-1"><%- lan.Track_Manage_All_Students %></div>
                        </div>
                        <div class="feature-card">
                            <i class="fa-solid fa-clipboard-check text-white/80 mb-2 text-lg"></i>
                            <div class="text-white font-semibold text-sm"><%- lan.Attendance_System %></div>
                            <div class="text-white/60 text-xs mt-1"><%- lan.Daily_Attendance_Tracking %></div>
                        </div>
                        <div class="feature-card">
                            <i class="fa-solid fa-indian-rupee-sign text-white/80 mb-2 text-lg"></i>
                            <div class="text-white font-semibold text-sm"><%- lan.Fee_Management %></div>
                            <div class="text-white/60 text-xs mt-1"><%- lan.Collect_Track_Payments %></div>
                        </div>
                        <div class="feature-card">
                            <i class="fa-solid fa-chart-bar text-white/80 mb-2 text-lg"></i>
                            <div class="text-white font-semibold text-sm"><%- lan.Analytics_And_Reports %></div>
                            <div class="text-white/60 text-xs mt-1"><%- lan.Detailed_Insights_And_Data %></div>
                        </div>
                    </div>
                </div>
                <div class="relative z-10 flex gap-8">
                    <div>
                        <div class="text-white font-bold text-2xl">500+</div>
                        <div class="text-white/60 text-sm"><%- lan.Schools %></div>
                    </div>
                    <div>
                        <div class="text-white font-bold text-2xl">50K+</div>
                        <div class="text-white/60 text-sm"><%- lan.Students %></div>
                    </div>
                    <div>
                        <div class="text-white font-bold text-2xl">99.9%</div>
                        <div class="text-white/60 text-sm"><%- lan.Uptime %></div>
                    </div>
                </div>
            </div>
            <div class="w-full lg:w-1/2 flex items-center justify-center p-6 bg-white login-right-pane relative">
                <div class="absolute top-6 right-6 flex items-center gap-2" style="z-index: 50;">
                    <div class="relative" id="authLangDropdown" style="position:relative;display:inline-block;">
                        <button type="button"
                            class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 text-xs font-semibold hover:bg-gray-200 dark:hover:bg-slate-700 transition-all cursor-pointer shadow-sm h-9"
                            onclick="toggleAuthLang(event)"
                            aria-label="<%- (typeof lan !== 'undefined' && lan.Change_Language) ? lan.Change_Language : 'Change Language' %>">
                            <i class="fas fa-globe text-indigo-500"></i>
                            <span>
                                <%= (typeof currentLang !=='undefined' && currentLang==='gujrati' ) ? 'ગુજરાતી' :
                                    ((typeof currentLang !=='undefined' && currentLang==='hindi' ) ? 'हिन्दी'
                                    : 'English' ) %>
                            </span>
                            <i class="fas fa-chevron-down text-[10px] text-gray-400"></i>
                        </button>
                        <div id="authLangMenu" class="auth-lang-menu">
                            <a href="javascript:void(0)" onclick="setAppLanguage('english')"
                                class="auth-lang-opt <%= (typeof currentLang === 'undefined' || currentLang === 'english') ? 'active' : '' %>">
                                <span>English</span>
                                <span style="font-size:10px;opacity:0.6;">EN</span>
                            </a>
                            <a href="javascript:void(0)" onclick="setAppLanguage('gujrati')"
                                class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'active' : '' %>">
                                <span>ગુજરાતી</span>
                                <span style="font-size:10px;opacity:0.6;">GU</span>
                            </a>
                            <a href="javascript:void(0)" onclick="setAppLanguage('hindi')"
                                class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'active' : '' %>">
                                <span>हिन्दी</span>
                                <span style="font-size:10px;opacity:0.6;">HI</span>
                            </a>
                        </div>
                    </div>
                    <button type="button"
                        class="theme-toggle-btn w-9 h-9 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:scale-105 transition-all cursor-pointer shadow-sm"
                        id="themeToggleBtn" onclick="toggleTheme()" aria-label="<%- lan.Switch_Theme %>"
                        title="<%- lan.Switch_Theme %>">
                        <i class="fas fa-moon"></i>
                    </button>
                </div>
                <div class="w-full max-w-md">
                    <div class="flex lg:hidden items-center gap-2 mb-8">
                        <div
                            class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">
                            S</div>
                        <span class="font-bold text-gray-800">SchoolSync</span>
                    </div>
                    <div class="mb-8">
                        <h1 class="login-title text-2xl font-bold text-gray-900 mb-1"><%- lan.Welcome_Back %> 👋</h1>
                        <p class="login-subtitle text-gray-500 text-sm"><%- lan.Sign_In_To_Account %></p>
                    </div>
                    <form id="loginForm" class="space-y-5">
                        <input type="hidden" name="_csrf"
                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <div>
                            <label class="login-label block text-sm font-semibold text-gray-700 mb-1.5"><%- lan.Email
                                    %></label>
                            <input type="email" name="email" id="emailInput" required class="input-field"
                                placeholder="admin@schoolsync.com">
                        </div>
                        <div>
                            <label class="login-label block text-sm font-semibold text-gray-700 mb-1.5"><%- lan.Password
                                    %></label>
                            <div class="relative">
                                <input type="password" name="password" id="passwordInput" required
                                    class="input-field pr-10" placeholder="<%- lan.Enter_Password %>">
                                <button type="button" onclick="togglePass()"
                                    class="password-toggle-btn absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                    <i class="fa-solid fa-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                        </div>
                        <div class="flex items-center justify-between">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" id="rememberMe"
                                    class="w-4 h-4 rounded border-gray-300 text-indigo-600">
                                <span class="remember-label text-sm text-gray-600"><%- lan.Remember_Me %></span>
                            </label>
                            <a href="/forgot-password"
                                class="forgot-link text-sm font-medium text-indigo-600 hover:text-indigo-700"><%-
                                    lan.Forgot_Password %></a>
                        </div>
                        <button type="submit" id="loginBtn" class="btn-primary">
                            <i class="fa-solid fa-arrow-right-to-bracket mr-2"></i> <%- lan.Sign_In %>
                        </button>
                    </form>
                    <div class="flex items-center gap-3 my-5">
                        <div class="divider-line flex-1 h-px bg-gray-200"></div>
                        <span class="divider-text text-xs text-gray-400 font-medium">OR</span>
                        <div class="divider-line flex-1 h-px bg-gray-200"></div>
                    </div>
                    <a href="/auth/google"
                        class="google-btn flex items-center justify-center gap-3 w-full py-3 border-1.5 border-gray-200 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 transition-all"
                        style="border: 1.5px solid #E2E8F0; border-radius: 10px; text-decoration: none;">
                        <img src="https://www.google.com/favicon.ico" width="18" height="18" alt="G"><%-
                            lan.Continue_With_Google %>
                    </a>
                    <p class="signup-prompt text-center text-sm text-gray-500 mt-6"><%-
                            lan.Want_To_Create_School_Account %>
                            <a href="/start-demo"
                                class="demo-link font-semibold text-indigo-600 hover:text-indigo-700"><%- lan.Start_Demo
                                    %></a>
                    </p>
                    <div class="quick-login-section">
                        <div class="quick-login-label">⚡ <%- lan.Quick_Login_Demo_Access %></div>
                        <div class="quick-login-grid">
                            <button class="quick-btn btn-superadmin" onclick="quickLogin('superadmin')"
                                id="qbtn-superadmin">
                                <div class="btn-icon"><i class="fa-solid fa-crown"></i></div>
                                <div class="btn-text"><%- lan.Super_Admin %><span><%- lan.Full_System_Access %></span>
                                </div>
                            </button>
                            <button class="quick-btn btn-schooladmin" onclick="quickLogin('schooladmin')"
                                id="qbtn-schooladmin">
                                <div class="btn-icon"><i class="fa-solid fa-building-columns"></i></div>
                                <div class="btn-text"><%- lan.School_Admin %><span><%- lan.School_Management %></span>
                                </div>
                            </button>
                            <button class="quick-btn btn-groupadmin" onclick="quickLogin('groupadmin')"
                                id="qbtn-groupadmin">
                                <div class="btn-icon"><i class="fa-solid fa-sitemap"></i></div>
                                <div class="btn-text"><%- lan.Group_Admin %><span><%- lan.All_Branches %></span></div>
                            </button>
                            <button class="quick-btn btn-teacher" onclick="quickLogin('teacher')" id="qbtn-teacher">
                                <div class="btn-icon"><i class="fa-solid fa-chalkboard-user"></i></div>
                                <div class="btn-text"><%- lan.Teacher %><span><%- lan.Class_And_Attendance %></span>
                                </div>
                            </button>
                            <button class="quick-btn btn-student" onclick="quickLogin('student')" id="qbtn-student">
                                <div class="btn-icon"><i class="fa-solid fa-graduation-cap"></i></div>
                                <div class="btn-text"><%- lan.Student %><span><%- lan.View_Grades_And_Fees %></span>
                                </div>
                            </button>
                            <button class="quick-btn btn-librarian" onclick="quickLogin('librarian')"
                                id="qbtn-librarian">
                                <div class="btn-icon"><i class="fa-solid fa-book-open"></i></div>
                                <div class="btn-text"><%- lan.Librarian %><span><%- lan.Books_And_Catalog %></span>
                                </div>
                            </button>
                            <button class="quick-btn btn-driver" onclick="quickLogin('driver')" id="qbtn-driver">
                                <div class="btn-icon"><i class="fa-solid fa-bus"></i></div>
                                <div class="btn-text"><%- lan.Driver %><span><%- lan.Route_And_Transport %></span></div>
                            </button>
                            <button class="quick-btn btn-parent" onclick="quickLogin('parent')" id="qbtn-parent">
                                <div class="btn-icon"><i class="fa-solid fa-people-roof"></i></div>
                                <div class="btn-text"><%- lan.Parent %><span><%- lan.Childs_Progress %></span></div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script>
            const ROLE_CREDENTIALS = {
                superadmin: { email: 'admin@schoolsync.com', password: 'Admin@123', label: 'Super Admin' },
                schooladmin: { email: 'kevalpandav@gmail.com', password: '12345678', label: 'School Admin' },
                groupadmin: { email: 'groupadmin@schoolsync.com', password: 'GroupAdmin@123', label: 'Group Admin' },
                teacher: { email: 'teacher1@schoolsync.com', password: 'SchoolSync@123', label: 'Teacher' },
                student: { email: 'student.10023.2@schoolsync.com', password: 'SchoolSync@123', label: 'Student' },
                driver: { email: 'driver.ramesh@schoolsync.com', password: '123456', label: 'Driver' },
                librarian: { email: 'librarian@gmail.com', password: '123', label: 'Librarian' },
                parent: { email: 'parent1@schoolsync.com', password: 'SchoolSync@123', label: 'Parent' }
            };

            window.addEventListener("DOMContentLoaded", () => {
                document.getElementById("loginForm").addEventListener("submit", function (e) {
                    e.preventDefault();
                    doLogin();
                });
            });

            async function quickLogin(role) {
                const creds = ROLE_CREDENTIALS[role];
                if (!creds) return;

                const emailVal = creds.email.trim();
                document.getElementById('emailInput').value = emailVal;
                document.getElementById('passwordInput').value = creds.password;
                const btn = document.getElementById('qbtn-' + role);
                const origHTML = btn.innerHTML;
                btn.classList.add('loading');
                btn.querySelector('.btn-icon').innerHTML = '<i class="fa-solid fa-spinner"></i>';

                showFlash('success', `Signing in as ${creds.label}...`);
                const csrfToken = document.querySelector('[name="_csrf"]')?.value || '';
                try {
                    const res = await fetch('/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': csrfToken
                        },
                        body: JSON.stringify({
                            email: emailVal,
                            password: creds.password,
                            rememberMe: false,
                            role,
                            _csrf: csrfToken
                        })
                    });

                    const data = await res.json();
                    if (data.success) {
                        showFlash('success', `Welcome, ${creds.label}! Redirecting...`);
                        setTimeout(() => {
                            window.location.href = data.redirectTo || `/${role}/dashboard`;
                        }, 800);
                    } else {
                        showFlash('error', data.message || 'Quick login failed');
                        btn.classList.remove('loading');
                        btn.innerHTML = origHTML;
                    };
                } catch (err) {
                    showFlash('error', 'Server error. Try again.');
                    btn.classList.remove('loading');
                    btn.innerHTML = origHTML;
                };
            };

            async function doLogin() {
                const email = document.querySelector('[name="email"]').value.trim();
                const password = document.querySelector('[name="password"]').value;
                const rememberMe = document.getElementById("rememberMe").checked;
                const btn = document.getElementById("loginBtn");

                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Signing in...';
                btn.disabled = true;

                const csrfToken = document.querySelector('[name="_csrf"]')?.value || '';
                try {
                    const res = await fetch("/login", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "X-CSRF-Token": csrfToken
                        },
                        body: JSON.stringify({ email, password, rememberMe, _csrf: csrfToken })
                    });
                    const data = await res.json();

                    if (data.success) {
                        showFlash("success", "Login successful! Redirecting...");
                        setTimeout(() => {
                            window.location.href = data.redirectTo || "/";
                        }, 900);
                    } else {
                        showFlash("error", data.message || "Login failed");
                        btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket mr-2"></i> Sign In';
                        btn.disabled = false;
                    };
                } catch (err) {
                    showFlash("error", "Server error. Try again.");
                    btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket mr-2"></i> Sign In';
                    btn.disabled = false;
                };
            };

            function togglePass() {
                const input = document.getElementById("passwordInput");
                const icon = document.getElementById("eyeIcon");
                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.replace("fa-eye", "fa-eye-slash");
                } else {
                    input.type = "password";
                    icon.classList.replace("fa-eye-slash", "fa-eye");
                };
            };

            function showFlash(type, message) {
                const container = document.getElementById("flashContainer");
                if (!container) return;
                container.innerHTML = "";
                const div = document.createElement("div");
                div.className = `flash-msg ${type === "success" ? "flash-success" : "flash-error"}`;
                const icon = type === "success" ? "fa-circle-check" : "fa-circle-exclamation";
                div.innerHTML = `<i class="fa-solid ${icon} text-base flex-shrink-0"></i> <span>${message}</span>`;
                container.appendChild(div);
                setTimeout(() => {
                    div.classList.add("hiding");
                    setTimeout(() => div.remove(), 300);
                }, 3000);
            };

            function toggleAuthLang(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                };
                const menu = document.getElementById('authLangMenu');
                if (!menu) return;
                const isHidden = window.getComputedStyle(menu).display === 'none';
                menu.style.display = isHidden ? 'block' : 'none';
            };

            window.setAppLanguage = async function (lang) {
                try {
                    const response = await fetch('/language/set', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ language: lang })
                    });
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        window.location.href = '/language/change/' + encodeURIComponent(lang);
                    };
                } catch (err) {
                    window.location.href = '/language/change/' + encodeURIComponent(lang);
                };
            };

            document.addEventListener('click', function (e) {
                const dropdown = document.getElementById('authLangDropdown');
                const menu = document.getElementById('authLangMenu');
                if (dropdown && menu && !dropdown.contains(e.target)) {
                    menu.style.display = 'none';
                };
            });
        </script>
        <script src="/js/utils.js"></script>
        <script src="/js/validation.js"></script>
</body>

</html>