<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#2563EB">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="SchoolSync">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <title>Reset Password | SchoolSync</title>
    <script src="/js/pwa.js" defer></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        };
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('schoolSyncTheme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.classList.add('light-mode-disabled');
                }
            } catch (e) { }
        })();
    </script>
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

        * {
            font-family: 'Inter', sans-serif;
            box-sizing: border-box;
        }

        :root {
            --bg-page: #F8FAFC;
            --bg-card: #FFFFFF;
            --border-card: #E2E8F0;
            --text-title: #0F172A;
            --text-sub: #64748B;
            --text-label: #334155;
            --bg-input: #F8FAFC;
            --border-input: #E2E8F0;
            --text-input: #0F172A;
            --primary: #4338CA;
            --primary-hover: #3730A3;
            --shadow-card: 0 20px 60px rgba(15, 23, 42, .07);
        }

        [data-theme="dark"],
        .light-mode-disabled,
        html[data-theme="dark"],
        html.dark {
            --bg-page: #0B0F19;
            --bg-card: #151D30;
            --border-card: #242F4D;
            --text-title: #F8FAFC;
            --text-sub: #94A3B8;
            --text-label: #CBD5E1;
            --bg-input: #0F172A;
            --border-input: #334155;
            --text-input: #F8FAFC;
            --primary: #6366F1;
            --primary-hover: #4F46E5;
            --shadow-card: 0 24px 70px rgba(0, 0, 0, 0.4);
        }

        body {
            background-color: var(--bg-page);
            color: var(--text-title);
            min-height: 100vh;
            overflow-x: hidden;
            transition: background-color .3s ease, color .3s ease;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 60%, #A855F7 100%);
        }

        .auth-right-pane {
            background-color: var(--bg-page);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            min-height: 100vh;
            position: relative;
        }

        .auth-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 20px;
            box-shadow: var(--shadow-card);
            padding: 36px 32px;
            width: 100%;
            max-width: 460px;
            transition: all .25s ease;
        }

        .input-field {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid var(--border-input);
            border-radius: 10px;
            font-size: 14px;
            background-color: var(--bg-input);
            color: var(--text-input);
            transition: all 0.2s;
            outline: none;
        }

        .input-field:focus {
            border-color: var(--primary);
            background-color: var(--bg-card);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        .input-field::placeholder {
            color: var(--text-sub);
            opacity: 0.7;
        }

        .otp-row {
            display: flex;
            gap: 8px;
            justify-content: center;
            width: 100%;
        }

        .otp-box {
            flex: 1 1 0;
            max-width: 48px;
            min-width: 36px;
            height: 50px;
            border: 1.5px solid var(--border-input);
            border-radius: 10px;
            font-size: 20px;
            font-weight: 700;
            text-align: center;
            background-color: var(--bg-input);
            color: var(--text-input);
            outline: none;
            transition: all 0.2s;
        }

        .otp-box:focus {
            border-color: var(--primary);
            background-color: var(--bg-card);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        .otp-box.filled {
            border-color: var(--primary);
            background-color: rgba(99, 102, 241, 0.15);
            color: var(--primary);
        }

        .btn-primary {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4338CA, #6366F1);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(67, 56, 202, 0.25);
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(67, 56, 202, 0.35);
        }

        .btn-otp {
            padding: 11px 16px;
            background: rgba(99, 102, 241, 0.12);
            color: var(--primary);
            border: 1px solid rgba(99, 102, 241, 0.25);
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-otp:hover {
            background: var(--primary);
            color: white;
        }

        .btn-otp:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .flash-msg {
            position: relative;
            pointer-events: auto;
            min-width: 280px;
            max-width: min(460px, calc(100vw - 32px));
            border-radius: 12px;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22), 0 2px 8px rgba(0, 0, 0, 0.08);
            animation: flashSlideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            transition: all 0.3s ease;
            border: 1px solid transparent;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .flash-msg.hiding {
            opacity: 0;
            transform: translateY(-12px) scale(0.96);
        }

        .flash-success {
            background: #ECFDF5;
            color: #065F46;
            border-color: #A7F3D0;
        }

        .flash-error {
            background: #FFF1F2;
            color: #9F1239;
            border-color: #FECDD3;
        }

        [data-theme="dark"] .flash-success,
        .light-mode-disabled .flash-success,
        html.dark .flash-success {
            background: #064E3B !important;
            color: #ECFDF5 !important;
            border-color: #059669 !important;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65) !important;
        }

        [data-theme="dark"] .flash-error,
        .light-mode-disabled .flash-error,
        html.dark .flash-error {
            background: #7F1D1D !important;
            color: #FEF2F2 !important;
            border-color: #DC2626 !important;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65) !important;
        }

        @keyframes flashSlideDown {
            from {
                transform: translateY(-20px) scale(0.95);
                opacity: 0;
            }

            to {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }

        .theme-toggle-btn {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            color: var(--text-sub);
            cursor: pointer;
            transition: all .2s;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .theme-toggle-btn:hover {
            color: var(--primary);
            border-color: var(--primary);
            transform: translateY(-1px);
        }

        .mobile-header-bar {
            display: none;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 460px;
            margin-bottom: 16px;
        }

        .mobile-brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--text-title);
            font-weight: 800;
            font-size: 19px;
        }

        .mobile-brand-mark {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4338CA, #7C3AED);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 4px 12px rgba(67, 56, 202, 0.25);
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 16px;
            backdrop-filter: blur(10px);
        }

        .blob1 {
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            top: -100px;
            right: -100px;
        }

        .blob2 {
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            bottom: -80px;
            left: -80px;
        }

        @media (max-width: 1024px) {
            .auth-right-pane {
                min-height: 100vh;
                padding: 24px 16px 36px;
                flex-direction: column;
                justify-content: center;
            }

            .auth-right-pane>.desktop-theme-btn {
                display: none !important;
            }

            .mobile-header-bar {
                display: flex !important;
            }

            .auth-card {
                padding: 26px 20px;
                border-radius: 18px;
            }
        }

        @media (max-width: 420px) {
            .otp-row {
                gap: 5px;
            }

            .otp-box {
                min-width: 32px;
                height: 44px;
                font-size: 17px;
                border-radius: 8px;
            }

            .auth-card {
                padding: 22px 16px;
            }
        }

        .auth-lang-menu {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 6px);
            width: 140px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            padding: 6px;
            z-index: 9999;
        }

        [data-theme="dark"] .auth-lang-menu,
        .light-mode-disabled .auth-lang-menu,
        html.dark .auth-lang-menu {
            background: #151D30 !important;
            border-color: #242F4D !important;
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.65) !important;
        }

        .auth-lang-opt {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .auth-lang-opt:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

        .auth-lang-opt.active {
            background: #eef2ff;
            color: #4f46e5;
        }

        [data-theme="dark"] .auth-lang-opt,
        .light-mode-disabled .auth-lang-opt,
        html.dark .auth-lang-opt {
            color: #CBD5E1 !important;
        }

        [data-theme="dark"] .auth-lang-opt:hover,
        .light-mode-disabled .auth-lang-opt:hover,
        html.dark .auth-lang-opt:hover {
            background: #242F4D !important;
            color: #FFFFFF !important;
        }

        [data-theme="dark"] .auth-lang-opt.active,
        .light-mode-disabled .auth-lang-opt.active,
        html.dark .auth-lang-opt.active {
            background: rgba(99, 102, 241, 0.25) !important;
            color: #818cf8 !important;
        }
    </style>
</head>

<body>
    <%- include('../partials/flashMessages') %>
        <div id="flashContainer"
            class="fixed top-5 left-1/2 -translate-x-1/2 z-[999999] flex flex-col items-center gap-2 pointer-events-none w-max max-w-[90vw]">
        </div>
        <div class="flex min-h-screen">
            <div class="hidden lg:flex lg:w-1/2 gradient-bg flex-col justify-between p-12 relative overflow-hidden">
                <div class="blob1"></div>
                <div class="blob2"></div>
                <div class="relative z-10 flex items-center gap-3">
                    <div
                        class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center text-white font-bold text-lg backdrop-blur">
                        S</div>
                    <span class="text-white font-bold text-xl">SchoolSync</span>
                </div>
                <div class="relative z-10">
                    <div
                        class="inline-flex items-center gap-2 bg-white/15 text-white text-sm px-4 py-2 rounded-full mb-6 backdrop-blur">
                        <i class="fa-solid fa-lock-open"></i><%- lan.Secure_Recovery_Protocol %>
                    </div>
                    <h2 class="text-4xl font-bold text-white mb-4 leading-tight"><%- lan.Secure_Account_Recovery %></h2>
                    <p class="text-white/80 text-base mb-8 leading-relaxed"><%- lan.Forgot_Password_Hero_Desc %></p>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="feature-card">
                            <i class="fa-solid fa-user-shield text-white/80 mb-2 text-lg"></i>
                            <div class="text-white font-semibold text-sm"><%- lan.Identity_Verification %></div>
                            <div class="text-white/60 text-xs mt-1"><%- lan.Identity_Verification_Desc %></div>
                        </div>
                        <div class="feature-card">
                            <i class="fa-solid fa-key text-white/80 mb-2 text-lg"></i>
                            <div class="text-white font-semibold text-sm"><%- lan.Access_Protection %></div>
                            <div class="text-white/60 text-xs mt-1"><%- lan.Access_Protection_Desc %></div>
                        </div>
                        <div class="feature-card">
                            <i class="fa-solid fa-clock-rotate-left text-white/80 mb-2 text-lg"></i>
                            <div class="text-white font-semibold text-sm"><%- lan.Instant_Recovery %></div>
                            <div class="text-white/60 text-xs mt-1"><%- lan.Instant_Recovery_Desc %></div>
                        </div>
                        <div class="feature-card">
                            <i class="fa-solid fa-headset text-white/80 mb-2 text-lg"></i>
                            <div class="text-white font-semibold text-sm"><%- lan.Support_Desk_247 %></div>
                            <div class="text-white/60 text-xs mt-1"><%- lan.Support_Desk_Desc %></div>
                        </div>
                    </div>
                </div>
                <div class="relative z-10 flex gap-8">
                    <div>
                        <div class="text-white font-bold text-2xl">MFA</div>
                        <div class="text-white/60 text-sm"><%- lan.Multi_Factor_Auth %></div>
                    </div>
                    <div>
                        <div class="text-white font-bold text-2xl">256-bit</div>
                        <div class="text-white/60 text-sm"><%- lan.AES_Encryption %></div>
                    </div>
                    <div>
                        <div class="text-white font-bold text-2xl">100%</div>
                        <div class="text-white/60 text-sm"><%- lan.Secure_And_Private %></div>
                    </div>
                </div>
            </div>
            <div class="w-full lg:w-1/2 auth-right-pane">
                <div class="desktop-theme-btn absolute top-6 right-6 flex items-center gap-2" style="z-index: 50;">
                    <div class="relative" id="authLangDropdown" style="position:relative;display:inline-block;">
                        <button type="button"
                            class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 text-xs font-semibold hover:bg-gray-200 dark:hover:bg-slate-700 transition-all cursor-pointer shadow-sm h-9"
                            onclick="toggleAuthLang(event)"
                            aria-label="<%- (typeof lan !== 'undefined' && lan.Change_Language) ? lan.Change_Language : 'Change Language' %>">
                            <i class="fas fa-globe text-indigo-500"></i>
                            <span>
                                <%= (typeof currentLang !=='undefined' && currentLang==='gujrati' ) ? 'ગુજરાતી' :
                                    ((typeof currentLang !=='undefined' && currentLang==='hindi' ) ? 'हिन्दी'
                                    : 'English' ) %>
                            </span>
                            <i class="fas fa-chevron-down text-[10px] text-gray-400"></i>
                        </button>
                        <div id="authLangMenu" class="auth-lang-menu">
                            <a href="javascript:void(0)" onclick="setAppLanguage('english')"
                                class="auth-lang-opt <%= (typeof currentLang === 'undefined' || currentLang === 'english') ? 'active' : '' %>">
                                <span>English</span>
                                <span style="font-size:10px;opacity:0.6;">EN</span>
                            </a>
                            <a href="javascript:void(0)" onclick="setAppLanguage('gujrati')"
                                class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'active' : '' %>">
                                <span>ગુજરાતી</span>
                                <span style="font-size:10px;opacity:0.6;">GU</span>
                            </a>
                            <a href="javascript:void(0)" onclick="setAppLanguage('hindi')"
                                class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'active' : '' %>">
                                <span>हिन्दी</span>
                                <span style="font-size:10px;opacity:0.6;">HI</span>
                            </a>
                        </div>
                    </div>
                    <button type="button"
                        class="theme-toggle-btn w-9 h-9 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:scale-105 transition-all cursor-pointer shadow-sm"
                        id="themeToggleBtn" onclick="toggleTheme()"
                        aria-label="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>"
                        title="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>">
                        <i class="fas fa-moon"></i>
                    </button>
                </div>
                <div class="mobile-header-bar">
                    <a href="/" class="mobile-brand-logo">
                        <span class="mobile-brand-mark">S</span>
                        <span>SchoolSync</span>
                    </a>
                    <div class="flex items-center gap-2">
                        <button type="button"
                            class="theme-toggle-btn w-9 h-9 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:scale-105 transition-all cursor-pointer shadow-sm"
                            onclick="toggleTheme()"
                            aria-label="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>"
                            title="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>">
                            <i class="fas fa-moon"></i>
                        </button>
                    </div>
                </div>
                <div class="auth-card">
                    <div class="mb-6">
                        <h1 class="text-2xl font-bold mb-1" style="color: var(--text-title);"><%- lan.Reset_Password %>
                                🔒</h1>
                        <p class="text-sm" style="color: var(--text-sub);"><%- lan.Enter_Email_For_OTP %></p>
                    </div>
                    <form id="resetForm" method="POST" action="/reset-password" class="space-y-4">
                        <input type="hidden" name="_csrf"
                            value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <div>
                            <label class="block text-xs font-bold mb-1.5" style="color: var(--text-label);"><%-
                                    lan.Email %> *</label>
                            <div class="flex gap-2">
                                <input type="email" name="email" id="emailInput" required class="input-field"
                                    placeholder="your@email.com">
                                <button type="button" id="sendOtpBtn" onclick="sendOtp()" class="btn-otp"><%-
                                        lan.Send_OTP %></button>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-2" style="color: var(--text-label);"><%-
                                    lan.Enter_OTP %></label>
                            <div class="otp-row">
                                <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                                <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                                <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                                <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                                <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                                <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            </div>
                            <input type="hidden" name="otp" id="finalOtp">
                            <div class="flex justify-between items-center mt-2">
                                <span id="timerText" class="text-xs text-red-500 font-semibold"></span>
                                <a href="#" id="resendLink" onclick="resendOtp(event)"
                                    class="text-xs font-semibold text-indigo-600 opacity-40 pointer-events-none hover:text-indigo-700"><%-
                                        lan.Resend_OTP %></a>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 my-2">
                            <div class="flex-1 h-px" style="background-color: var(--border-card);"></div>
                            <span class="text-xs font-medium flex items-center gap-1" style="color: var(--text-sub);">
                                <i class="fa-solid fa-lock text-indigo-500"></i> <%- lan.New_Password %>
                            </span>
                            <div class="flex-1 h-px" style="background-color: var(--border-card);"></div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5" style="color: var(--text-label);"><%-
                                    lan.New_Password %> *</label>
                            <div class="relative">
                                <input type="password" name="newPassword" id="newPass" required
                                    class="input-field pr-10" placeholder="<%- lan.Password_Min_Length %>">
                                <button type="button" onclick="togglePass('newPass', this)"
                                    class="absolute right-3 top-1/2 -translate-y-1/2" style="color: var(--text-sub);">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1.5" style="color: var(--text-label);"><%-
                                    lan.Confirm_Password %> *</label>
                            <div class="relative">
                                <input type="password" name="confirmPassword" id="confirmPass" required
                                    class="input-field pr-10" placeholder="<%- lan.Reenter_New_Password %>">
                                <button type="button" onclick="togglePass('confirmPass', this)"
                                    class="absolute right-3 top-1/2 -translate-y-1/2" style="color: var(--text-sub);">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="btn-primary"><i class="fa-solid fa-shield-halved mr-1"></i> <%-
                                lan.Reset_Password %></button>
                    </form>
                    <p class="text-center text-sm mt-5" style="color: var(--text-sub);"> <%- lan.Remember_Your_Password
                            %>
                            <a href="/login"
                                class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline"><%-
                                    lan.Sign_In %></a>
                    </p>
                </div>
            </div>
        </div>
        <script>
            const otpBoxes = document.querySelectorAll(".otp-box");
            const sendOtpBtn = document.getElementById("sendOtpBtn");
            const resendLink = document.getElementById("resendLink");
            const timerText = document.getElementById("timerText");
            let countdownInterval;

            otpBoxes.forEach((box, i) => {
                box.addEventListener("input", (e) => {
                    e.target.value = e.target.value.replace(/[^0-9]/g, "");
                    if (e.target.value) {
                        e.target.classList.add("filled");
                        if (i < otpBoxes.length - 1) otpBoxes[i + 1].focus();
                    } else {
                        e.target.classList.remove("filled");
                    };
                });
                box.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !box.value && i > 0) {
                        otpBoxes[i - 1].focus();
                        otpBoxes[i - 1].classList.remove("filled");
                    };
                });
            });

            function startCooldown() {
                let seconds = 30;
                sendOtpBtn.disabled = true;
                resendLink.classList.add("opacity-40", "pointer-events-none");
                resendLink.classList.remove("opacity-100");

                clearInterval(countdownInterval);
                countdownInterval = setInterval(() => {
                    seconds--;
                    timerText.textContent = `Resend in ${seconds}s`;
                    if (seconds <= 0) {
                        clearInterval(countdownInterval);
                        timerText.textContent = "";
                        sendOtpBtn.disabled = false;
                        resendLink.classList.remove("opacity-40", "pointer-events-none");
                    };
                }, 1000);
            };

            async function requestOtp(isResend = false) {
                const email = document.getElementById("emailInput").value.trim();
                if (!email) { showFlash("error", "Enter email first"); return; }

                const res = await fetch("/send-otp", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email })
                });
                const data = await res.json();

                if (data.success) {
                    showFlash("success", isResend ? "OTP Resent!" : "OTP sent to your email!");
                    startCooldown();
                } else {
                    showFlash("error", data.message);
                };
            };

            function sendOtp() { requestOtp(false); }
            function resendOtp(e) { e.preventDefault(); requestOtp(true); }
            document.getElementById("resetForm").addEventListener("submit", function (e) {
                let otp = "";
                otpBoxes.forEach(box => otp += box.value);
                document.getElementById("finalOtp").value = otp;

                if (otp.length !== 6) {
                    e.preventDefault();
                    showFlash("error", "Enter complete 6-digit OTP");
                    return;
                };

                const newPass = document.getElementById("newPass").value;
                const confirmPass = document.getElementById("confirmPass").value;
                if (newPass !== confirmPass) {
                    e.preventDefault();
                    showFlash("error", "Passwords do not match!");
                };
            });

            function togglePass(id, btn) {
                const input = document.getElementById(id);
                const icon = btn.querySelector("i");
                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.replace("fa-eye", "fa-eye-slash");
                } else {
                    input.type = "password";
                    icon.classList.replace("fa-eye-slash", "fa-eye");
                };
            };

            function showFlash(type, message) {
                const container = document.getElementById("flashContainer");
                if (!container) return;
                container.innerHTML = "";
                const div = document.createElement("div");
                div.className = `flash-msg ${type === "success" ? "flash-success" : "flash-error"}`;
                const icon = type === "success" ? "fa-circle-check" : "fa-circle-exclamation";
                div.innerHTML = `<i class="fa-solid ${icon} text-base flex-shrink-0"></i> <span>${message}</span>`;
                container.appendChild(div);
                setTimeout(() => {
                    div.classList.add("hiding");
                    setTimeout(() => div.remove(), 300);
                }, 3000);
            };

            function toggleAuthLang(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                const menu = document.getElementById('authLangMenu');
                if (!menu) return;
                const isHidden = menu.style.display === 'none' || menu.style.display === '';
                menu.style.display = isHidden ? 'block' : 'none';
            }

            window.setAppLanguage = async function (lang) {
                try {
                    const response = await fetch('/language/set', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ language: lang })
                    });
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        window.location.href = '/language/change/' + encodeURIComponent(lang);
                    }
                } catch (err) {
                    window.location.href = '/language/change/' + encodeURIComponent(lang);
                }
            };

            document.addEventListener('click', function (e) {
                const dropdown = document.getElementById('authLangDropdown');
                const menu = document.getElementById('authLangMenu');
                if (dropdown && menu && !dropdown.contains(e.target)) {
                    menu.style.display = 'none';
                }
            });
        </script>
        <script src="/js/utils.js"></script>
        <script src="/js/validation.js"></script>
</body>

</html>