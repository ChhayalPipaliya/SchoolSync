<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | SchoolSync</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class'
      };
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <script>
      (function() {
        try {
          var savedTheme = localStorage.getItem('schoolSyncTheme') || 'light';
          document.documentElement.setAttribute('data-theme', savedTheme);
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.add('light-mode-disabled');
          }
        } catch(e) {}
      })();
    </script>
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        [data-theme="dark"] body {
            background-color: #0B0F19 !important;
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .bg-white {
            background-color: #151D30 !important;
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .bg-gray-50 {
            background-color: #0B0F19 !important;
        }
        [data-theme="dark"] .text-gray-900,
        [data-theme="dark"] .text-gray-800 {
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .text-gray-700,
        [data-theme="dark"] .text-gray-600 {
            color: #CBD5E1 !important;
        }
        [data-theme="dark"] .text-gray-500 {
            color: #94A3B8 !important;
        }
        [data-theme="dark"] .input-field {
            background: #0F172A !important;
            border-color: #334155 !important;
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .input-field:focus {
            background: #111827 !important;
            border-color: #6366F1 !important;
        }
        [data-theme="dark"] .otp-box {
            background: #0F172A !important;
            border-color: #334155 !important;
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .otp-box:focus {
            background: #111827 !important;
            border-color: #6366F1 !important;
        }
        [data-theme="dark"] .otp-box.filled {
            background: rgba(99, 102, 241, 0.2) !important;
            border-color: #6366F1 !important;
            color: #A5B4FC !important;
        }

        * {
            font-family: 'Inter', sans-serif;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 60%, #A855F7 100%);
        }

        .input-field {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            font-size: 14px;
            background: #F8FAFC;
            transition: all 0.2s;
            outline: none;
        }

        .input-field:focus {
            border-color: #4F46E5;
            background: white;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .otp-box {
            width: 48px;
            height: 52px;
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            font-size: 20px;
            font-weight: 700;
            text-align: center;
            background: #F8FAFC;
            outline: none;
            transition: all 0.2s;
        }

        .otp-box:focus {
            border-color: #4F46E5;
            background: white;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .otp-box.filled {
            border-color: #4F46E5;
            background: #EEF2FF;
            color: #4F46E5;
        }

        .btn-primary {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.35);
        }

        .btn-otp {
            padding: 11px 18px;
            background: #EEF2FF;
            color: #4F46E5;
            border: none;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .btn-otp:hover {
            background: #4F46E5;
            color: white;
        }

        .btn-otp:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .flash-msg {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            min-width: 300px;
            border-radius: 10px;
            padding: 14px 18px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            animation: slideIn 0.3s ease;
        }

        .flash-success {
            background: #DCFCE7;
            color: #16A34A;
            border: 1px solid #BBF7D0;
        }

        .flash-error {
            background: #FEE2E2;
            color: #DC2626;
            border: 1px solid #FECACA;
        }

        @keyframes slideIn {
            from {
                transform: translateX(100px);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 16px;
            backdrop-filter: blur(10px);
        }

        .blob1 {
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            top: -100px;
            right: -100px;
        }

        .blob2 {
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            bottom: -80px;
            left: -80px;
        }

        @media (max-width: 375px) {
            .otp-box {
                width: 36px;
                height: 42px;
                font-size: 16px;
            }
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">
    <%- include('../partials/flashMessages') %>
    <div id="flashContainer" class="fixed top-5 right-5 z-50"></div>
    <div class="flex min-h-screen">
        <div class="hidden lg:flex lg:w-1/2 gradient-bg flex-col justify-between p-12 relative overflow-hidden">
            <div class="blob1"></div>
            <div class="blob2"></div>
            <div class="relative z-10 flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center text-white font-bold text-lg backdrop-blur"> S</div>
                <span class="text-white font-bold text-xl">SchoolSync</span>
            </div>
            <div class="relative z-10">
                <div
                    class="inline-flex items-center gap-2 bg-white/15 text-white text-sm px-4 py-2 rounded-full mb-6 backdrop-blur">
                    <i class="fa-solid fa-lock-open"></i>Secure Recovery Protocol
                </div>
                <h2 class="text-4xl font-bold text-white mb-4 leading-tight">Secure Account<br>Recovery</h2>
                <p class="text-white/80 text-base mb-8 leading-relaxed">Verify your identity and configure a new password to safely regain access to your SchoolSync dashboard.</p>
                <div class="grid grid-cols-2 gap-3">
                    <div class="feature-card">
                        <i class="fa-solid fa-user-shield text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">Identity Verification</div>
                        <div class="text-white/60 text-xs mt-1">Secure OTP sent directly to your registered email</div>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-key text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">Access Protection</div>
                        <div class="text-white/60 text-xs mt-1">Ensure security compliance with strong password controls</div>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-clock-rotate-left text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">Instant Recovery</div>
                        <div class="text-white/60 text-xs mt-1">No waiting period. Regain full access immediately</div>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-headset text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">24/7 Support Desk</div>
                        <div class="text-white/60 text-xs mt-1">Contact your school administrator if you need help</div>
                    </div>
                </div>
            </div>
            <div class="relative z-10 flex gap-8">
                <div>
                    <div class="text-white font-bold text-2xl">MFA</div>
                    <div class="text-white/60 text-sm">Multi-Factor Auth</div>
                </div>
                <div>
                    <div class="text-white font-bold text-2xl">256-bit</div>
                    <div class="text-white/60 text-sm">AES Encryption</div>
                </div>
                <div>
                    <div class="text-white font-bold text-2xl">100%</div>
                    <div class="text-white/60 text-sm">Secure & Private</div>
                </div>
            </div>
        </div>
        <div class="w-full lg:w-1/2 flex items-center justify-center p-6 bg-white relative">
            <button type="button" class="theme-toggle-btn absolute top-6 right-6 w-9 h-9 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:scale-105 transition-all cursor-pointer shadow-sm" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Switch Theme" title="Switch Theme">
                <i class="fas fa-moon"></i>
            </button>
            <div class="w-full max-w-md">
                <div class="flex lg:hidden items-center gap-2 mb-8">
                    <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-sm"> S</div>
                    <span class="font-bold text-gray-800">SchoolSync</span>
                </div>
                <div class="mb-8">
                    <h1 class="text-2xl font-bold text-gray-900 mb-1">Reset Password 🔒</h1>
                    <p class="text-gray-500 text-sm">Enter your email to receive a verification code</p>
                </div>
                <form id="resetForm" method="POST" action="/reset-password" class="space-y-5">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Email Address *</label>
                        <div class="flex gap-2">
                            <input type="email" name="email" id="emailInput" required class="input-field" placeholder="your@email.com">
                            <button type="button" id="sendOtpBtn" onclick="sendOtp()" class="btn-otp">Send OTP</button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Enter OTP</label>
                        <div class="flex gap-2 justify-center">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                        </div>
                        <input type="hidden" name="otp" id="finalOtp">
                        <div class="flex justify-between items-center mt-2">
                            <span id="timerText" class="text-xs text-red-500 font-semibold"></span>
                            <a href="#" id="resendLink" onclick="resendOtp(event)" class="text-xs font-semibold text-indigo-600 opacity-40 pointer-events-none hover:text-indigo-700">Resend OTP</a>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex-1 h-px bg-gray-200"></div>
                        <span class="text-xs text-gray-400 font-medium flex items-center gap-1">
                            <i class="fa-solid fa-lock text-indigo-500"></i> New Password
                        </span>
                        <div class="flex-1 h-px bg-gray-200"></div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">New Password *</label>
                        <div class="relative">
                            <input type="password" name="newPassword" id="newPass" required
                                class="input-field pr-10" placeholder="Min 8 characters">
                            <button type="button" onclick="togglePass('newPass', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Confirm Password *</label>
                        <div class="relative">
                            <input type="password" name="confirmPassword" id="confirmPass" required
                                class="input-field pr-10" placeholder="Re-enter password">
                            <button type="button" onclick="togglePass('confirmPass', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary"><i class="fa-solid fa-shield-halved mr-2"></i> Reset Password</button>
                </form>
                <p class="text-center text-sm text-gray-500 mt-6"> Remember your password?
                    <a href="/login" class="font-semibold text-indigo-600 hover:text-indigo-700">Sign in</a>
                </p>
            </div>
        </div>
    </div>
    <script>
        const otpBoxes = document.querySelectorAll(".otp-box");
        const sendOtpBtn = document.getElementById("sendOtpBtn");
        const resendLink = document.getElementById("resendLink");
        const timerText = document.getElementById("timerText");
        let countdownInterval;

        otpBoxes.forEach((box, i) => {
            box.addEventListener("input", (e) => {
                e.target.value = e.target.value.replace(/[^0-9]/g, "");
                if (e.target.value) {
                    e.target.classList.add("filled");
                    if (i < otpBoxes.length - 1) otpBoxes[i + 1].focus();
                } else {
                    e.target.classList.remove("filled");
                };
            });
            box.addEventListener("keydown", (e) => {
                if (e.key === "Backspace" && !box.value && i > 0) {
                    otpBoxes[i - 1].focus();
                    otpBoxes[i - 1].classList.remove("filled");
                };
            });
        });

        function startCooldown() {
            let seconds = 30;
            sendOtpBtn.disabled = true;
            resendLink.classList.add("opacity-40", "pointer-events-none");
            resendLink.classList.remove("opacity-100");

            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                seconds--;
                timerText.textContent = `Resend in ${seconds}s`;
                if (seconds <= 0) {
                    clearInterval(countdownInterval);
                    timerText.textContent = "";
                    sendOtpBtn.disabled = false;
                    resendLink.classList.remove("opacity-40", "pointer-events-none");
                };
            }, 1000);
        };

        async function requestOtp(isResend = false) {
            const email = document.getElementById("emailInput").value.trim();
            if (!email) { showFlash("error", "Enter email first"); return; }

            const res = await fetch("/send-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email })
            });
            const data = await res.json();

            if (data.success) {
                showFlash("success", isResend ? "OTP Resent!" : "OTP sent to your email!");
                startCooldown();
            } else {
                showFlash("error", data.message);
            };
        };

        function sendOtp() { requestOtp(false); }
        function resendOtp(e) { e.preventDefault(); requestOtp(true); }
        document.getElementById("resetForm").addEventListener("submit", function (e) {
            let otp = "";
            otpBoxes.forEach(box => otp += box.value);
            document.getElementById("finalOtp").value = otp;

            if (otp.length !== 6) {
                e.preventDefault();
                showFlash("error", "Enter complete 6-digit OTP");
                return;
            };

            const newPass = document.getElementById("newPass").value;
            const confirmPass = document.getElementById("confirmPass").value;
            if (newPass !== confirmPass) {
                e.preventDefault();
                showFlash("error", "Passwords do not match!");
            };
        });

        function togglePass(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector("i");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("fa-eye-slash", "fa-eye");
            };
        };

        function showFlash(type, message) {
            const container = document.getElementById("flashContainer");
            const div = document.createElement("div");
            div.className = `flash-msg ${type === "success" ? "flash-success" : "flash-error"}`;
            div.innerHTML = `<i class="fa-solid ${type === "success" ? "fa-circle-check" : "fa-circle-exclamation"}"></i> ${message}`;
            container.appendChild(div);
            setTimeout(() => div.remove(), 3000);
        };
    </script>
    <script src="/js/utils.js"></script>
    <script src="/js/validation.js"></script>
</body>
</html>