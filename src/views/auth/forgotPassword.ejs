<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | SchoolSync</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class'
      };
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <script>
      (function() {
        try {
          var savedTheme = localStorage.getItem('schoolSyncTheme') || 'light';
          document.documentElement.setAttribute('data-theme', savedTheme);
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.add('light-mode-disabled');
          }
        } catch(e) {}
      })();
    </script>
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        * {
            font-family: 'Inter', sans-serif;
            box-sizing: border-box;
        }

        :root {
            --bg-page: #F8FAFC;
            --bg-card: #FFFFFF;
            --border-card: #E2E8F0;
            --text-title: #0F172A;
            --text-sub: #64748B;
            --text-label: #334155;
            --bg-input: #F8FAFC;
            --border-input: #E2E8F0;
            --text-input: #0F172A;
            --primary: #4338CA;
            --primary-hover: #3730A3;
            --shadow-card: 0 20px 60px rgba(15, 23, 42, .07);
        }

        [data-theme="dark"],
        .light-mode-disabled,
        html[data-theme="dark"],
        html.dark {
            --bg-page: #0B0F19;
            --bg-card: #151D30;
            --border-card: #242F4D;
            --text-title: #F8FAFC;
            --text-sub: #94A3B8;
            --text-label: #CBD5E1;
            --bg-input: #0F172A;
            --border-input: #334155;
            --text-input: #F8FAFC;
            --primary: #6366F1;
            --primary-hover: #4F46E5;
            --shadow-card: 0 24px 70px rgba(0, 0, 0, 0.4);
        }

        body {
            background-color: var(--bg-page);
            color: var(--text-title);
            min-height: 100vh;
            overflow-x: hidden;
            transition: background-color .3s ease, color .3s ease;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 60%, #A855F7 100%);
        }

        .auth-right-pane {
            background-color: var(--bg-page);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            min-height: 100vh;
            position: relative;
        }

        .auth-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 20px;
            box-shadow: var(--shadow-card);
            padding: 36px 32px;
            width: 100%;
            max-width: 460px;
            transition: all .25s ease;
        }

        .input-field {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid var(--border-input);
            border-radius: 10px;
            font-size: 14px;
            background-color: var(--bg-input);
            color: var(--text-input);
            transition: all 0.2s;
            outline: none;
        }

        .input-field:focus {
            border-color: var(--primary);
            background-color: var(--bg-card);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        .input-field::placeholder {
            color: var(--text-sub);
            opacity: 0.7;
        }

        .otp-row {
            display: flex;
            gap: 8px;
            justify-content: center;
            width: 100%;
        }

        .otp-box {
            flex: 1 1 0;
            max-width: 48px;
            min-width: 36px;
            height: 50px;
            border: 1.5px solid var(--border-input);
            border-radius: 10px;
            font-size: 20px;
            font-weight: 700;
            text-align: center;
            background-color: var(--bg-input);
            color: var(--text-input);
            outline: none;
            transition: all 0.2s;
        }

        .otp-box:focus {
            border-color: var(--primary);
            background-color: var(--bg-card);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        .otp-box.filled {
            border-color: var(--primary);
            background-color: rgba(99, 102, 241, 0.15);
            color: var(--primary);
        }

        .btn-primary {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4338CA, #6366F1);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(67, 56, 202, 0.25);
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(67, 56, 202, 0.35);
        }

        .btn-otp {
            padding: 11px 16px;
            background: rgba(99, 102, 241, 0.12);
            color: var(--primary);
            border: 1px solid rgba(99, 102, 241, 0.25);
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-otp:hover {
            background: var(--primary);
            color: white;
        }

        .btn-otp:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .flash-msg {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            min-width: 280px;
            max-width: min(420px, calc(100vw - 32px));
            border-radius: 12px;
            padding: 12px 18px;
            font-size: 13.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            border: 1px solid transparent;
        }

        .flash-success {
            background: #ECFDF5;
            color: #065F46;
            border-color: #A7F3D0;
        }

        .flash-error {
            background: #FFF1F2;
            color: #9F1239;
            border-color: #FECDD3;
        }

        [data-theme="dark"] .flash-success,
        .light-mode-disabled .flash-success,
        html.dark .flash-success {
            background: #064E3B !important;
            color: #ECFDF5 !important;
            border-color: #059669 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
        }

        [data-theme="dark"] .flash-error,
        .light-mode-disabled .flash-error,
        html.dark .flash-error {
            background: #7F1D1D !important;
            color: #FEF2F2 !important;
            border-color: #DC2626 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
        }

        @media (max-width: 480px) {
            .flash-msg {
                top: 14px;
                right: 14px;
                left: 14px;
                min-width: auto;
                max-width: none;
                justify-content: center;
            }
        }

        .theme-toggle-btn {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            color: var(--text-sub);
            cursor: pointer;
            transition: all .2s;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .theme-toggle-btn:hover {
            color: var(--primary);
            border-color: var(--primary);
            transform: translateY(-1px);
        }

        .mobile-header-bar {
            display: none;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            max-width: 460px;
            margin-bottom: 16px;
        }

        .mobile-brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--text-title);
            font-weight: 800;
            font-size: 19px;
        }

        .mobile-brand-mark {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4338CA, #7C3AED);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 4px 12px rgba(67, 56, 202, 0.25);
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 16px;
            backdrop-filter: blur(10px);
        }

        .blob1 {
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            top: -100px;
            right: -100px;
        }

        .blob2 {
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            bottom: -80px;
            left: -80px;
        }

        @media (max-width: 1024px) {
            .auth-right-pane {
                min-height: 100vh;
                padding: 24px 16px 36px;
                flex-direction: column;
                justify-content: center;
            }

            .auth-right-pane > .desktop-theme-btn {
                display: none !important;
            }

            .mobile-header-bar {
                display: flex !important;
            }

            .auth-card {
                padding: 26px 20px;
                border-radius: 18px;
            }
        }

        @media (max-width: 420px) {
            .otp-row {
                gap: 5px;
            }

            .otp-box {
                min-width: 32px;
                height: 44px;
                font-size: 17px;
                border-radius: 8px;
            }

            .auth-card {
                padding: 22px 16px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/flashMessages') %>
    <div id="flashContainer" class="fixed top-5 right-5 z-50"></div>
    <div class="flex min-h-screen">
        <div class="hidden lg:flex lg:w-1/2 gradient-bg flex-col justify-between p-12 relative overflow-hidden">
            <div class="blob1"></div>
            <div class="blob2"></div>
            <div class="relative z-10 flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center text-white font-bold text-lg backdrop-blur">S</div>
                <span class="text-white font-bold text-xl">SchoolSync</span>
            </div>
            <div class="relative z-10">
                <div class="inline-flex items-center gap-2 bg-white/15 text-white text-sm px-4 py-2 rounded-full mb-6 backdrop-blur">
                    <i class="fa-solid fa-lock-open"></i>Secure Recovery Protocol
                </div>
                <h2 class="text-4xl font-bold text-white mb-4 leading-tight">Secure Account<br>Recovery</h2>
                <p class="text-white/80 text-base mb-8 leading-relaxed">Verify your identity and configure a new password to safely regain access to your SchoolSync dashboard.</p>
                <div class="grid grid-cols-2 gap-3">
                    <div class="feature-card">
                        <i class="fa-solid fa-user-shield text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">Identity Verification</div>
                        <div class="text-white/60 text-xs mt-1">Secure OTP sent directly to your registered email</div>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-key text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">Access Protection</div>
                        <div class="text-white/60 text-xs mt-1">Ensure security compliance with strong password controls</div>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-clock-rotate-left text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">Instant Recovery</div>
                        <div class="text-white/60 text-xs mt-1">No waiting period. Regain full access immediately</div>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-headset text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">24/7 Support Desk</div>
                        <div class="text-white/60 text-xs mt-1">Contact your school administrator if you need help</div>
                    </div>
                </div>
            </div>
            <div class="relative z-10 flex gap-8">
                <div>
                    <div class="text-white font-bold text-2xl">MFA</div>
                    <div class="text-white/60 text-sm">Multi-Factor Auth</div>
                </div>
                <div>
                    <div class="text-white font-bold text-2xl">256-bit</div>
                    <div class="text-white/60 text-sm">AES Encryption</div>
                </div>
                <div>
                    <div class="text-white font-bold text-2xl">100%</div>
                    <div class="text-white/60 text-sm">Secure & Private</div>
                </div>
            </div>
        </div>
        <div class="w-full lg:w-1/2 auth-right-pane">
            <button type="button" class="theme-toggle-btn desktop-theme-btn absolute top-6 right-6" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Switch Theme" title="Switch Theme">
                <i class="fas fa-moon"></i>
            </button>
            <div class="mobile-header-bar">
                <a href="/" class="mobile-brand-logo">
                    <span class="mobile-brand-mark">S</span>
                    <span>SchoolSync</span>
                </a>
                <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" aria-label="Switch Theme" title="Switch Theme">
                    <i class="fas fa-moon"></i>
                </button>
            </div>
            <div class="auth-card">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold mb-1" style="color: var(--text-title);">Reset Password 🔒</h1>
                    <p class="text-sm" style="color: var(--text-sub);">Enter your email to receive a verification code</p>
                </div>
                <form id="resetForm" method="POST" action="/reset-password" class="space-y-4">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div>
                        <label class="block text-xs font-bold mb-1.5" style="color: var(--text-label);">Email Address *</label>
                        <div class="flex gap-2">
                            <input type="email" name="email" id="emailInput" required class="input-field" placeholder="your@email.com">
                            <button type="button" id="sendOtpBtn" onclick="sendOtp()" class="btn-otp">Send OTP</button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold mb-2" style="color: var(--text-label);">Enter OTP</label>
                        <div class="otp-row">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                            <input type="text" maxlength="1" class="otp-box" inputmode="numeric">
                        </div>
                        <input type="hidden" name="otp" id="finalOtp">
                        <div class="flex justify-between items-center mt-2">
                            <span id="timerText" class="text-xs text-red-500 font-semibold"></span>
                            <a href="#" id="resendLink" onclick="resendOtp(event)" class="text-xs font-semibold text-indigo-600 opacity-40 pointer-events-none hover:text-indigo-700">Resend OTP</a>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 my-2">
                        <div class="flex-1 h-px" style="background-color: var(--border-card);"></div>
                        <span class="text-xs font-medium flex items-center gap-1" style="color: var(--text-sub);">
                            <i class="fa-solid fa-lock text-indigo-500"></i> New Password
                        </span>
                        <div class="flex-1 h-px" style="background-color: var(--border-card);"></div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold mb-1.5" style="color: var(--text-label);">New Password *</label>
                        <div class="relative">
                            <input type="password" name="newPassword" id="newPass" required
                                class="input-field pr-10" placeholder="Min 8 characters">
                            <button type="button" onclick="togglePass('newPass', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2" style="color: var(--text-sub);">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold mb-1.5" style="color: var(--text-label);">Confirm Password *</label>
                        <div class="relative">
                            <input type="password" name="confirmPassword" id="confirmPass" required
                                class="input-field pr-10" placeholder="Re-enter password">
                            <button type="button" onclick="togglePass('confirmPass', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2" style="color: var(--text-sub);">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary"><i class="fa-solid fa-shield-halved mr-1"></i> Reset Password</button>
                </form>
                <p class="text-center text-sm mt-5" style="color: var(--text-sub);"> Remember your password?
                    <a href="/login" class="font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">Sign in</a>
                </p>
            </div>
        </div>
    </div>
    <script>
        const otpBoxes = document.querySelectorAll(".otp-box");
        const sendOtpBtn = document.getElementById("sendOtpBtn");
        const resendLink = document.getElementById("resendLink");
        const timerText = document.getElementById("timerText");
        let countdownInterval;

        otpBoxes.forEach((box, i) => {
            box.addEventListener("input", (e) => {
                e.target.value = e.target.value.replace(/[^0-9]/g, "");
                if (e.target.value) {
                    e.target.classList.add("filled");
                    if (i < otpBoxes.length - 1) otpBoxes[i + 1].focus();
                } else {
                    e.target.classList.remove("filled");
                };
            });
            box.addEventListener("keydown", (e) => {
                if (e.key === "Backspace" && !box.value && i > 0) {
                    otpBoxes[i - 1].focus();
                    otpBoxes[i - 1].classList.remove("filled");
                };
            });
        });

        function startCooldown() {
            let seconds = 30;
            sendOtpBtn.disabled = true;
            resendLink.classList.add("opacity-40", "pointer-events-none");
            resendLink.classList.remove("opacity-100");

            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                seconds--;
                timerText.textContent = `Resend in ${seconds}s`;
                if (seconds <= 0) {
                    clearInterval(countdownInterval);
                    timerText.textContent = "";
                    sendOtpBtn.disabled = false;
                    resendLink.classList.remove("opacity-40", "pointer-events-none");
                };
            }, 1000);
        };

        async function requestOtp(isResend = false) {
            const email = document.getElementById("emailInput").value.trim();
            if (!email) { showFlash("error", "Enter email first"); return; }

            const res = await fetch("/send-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email })
            });
            const data = await res.json();

            if (data.success) {
                showFlash("success", isResend ? "OTP Resent!" : "OTP sent to your email!");
                startCooldown();
            } else {
                showFlash("error", data.message);
            };
        };

        function sendOtp() { requestOtp(false); }
        function resendOtp(e) { e.preventDefault(); requestOtp(true); }
        document.getElementById("resetForm").addEventListener("submit", function (e) {
            let otp = "";
            otpBoxes.forEach(box => otp += box.value);
            document.getElementById("finalOtp").value = otp;

            if (otp.length !== 6) {
                e.preventDefault();
                showFlash("error", "Enter complete 6-digit OTP");
                return;
            };

            const newPass = document.getElementById("newPass").value;
            const confirmPass = document.getElementById("confirmPass").value;
            if (newPass !== confirmPass) {
                e.preventDefault();
                showFlash("error", "Passwords do not match!");
            };
        });

        function togglePass(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector("i");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("fa-eye-slash", "fa-eye");
            };
        };

        function showFlash(type, message) {
            const container = document.getElementById("flashContainer");
            const div = document.createElement("div");
            div.className = `flash-msg ${type === "success" ? "flash-success" : "flash-error"}`;
            div.innerHTML = `<i class="fa-solid ${type === "success" ? "fa-circle-check" : "fa-circle-exclamation"}"></i> ${message}`;
            container.appendChild(div);
            setTimeout(() => div.remove(), 3000);
        };
    </script>
    <script src="/js/utils.js"></script>
    <script src="/js/validation.js"></script>
</body>
</html>