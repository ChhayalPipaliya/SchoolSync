<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password | SchoolSync</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class'
      };
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/common.css">
    <script>
      (function() {
        try {
          var savedTheme = localStorage.getItem('schoolSyncTheme') || 'light';
          document.documentElement.setAttribute('data-theme', savedTheme);
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.add('light-mode-disabled');
          }
        } catch(e) {}
      })();
    </script>
    <script src="/js/theme.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        [data-theme="dark"] body {
            background-color: #0B0F19 !important;
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .bg-white {
            background-color: #151D30 !important;
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .bg-gray-50 {
            background-color: #0B0F19 !important;
        }
        [data-theme="dark"] .text-gray-900,
        [data-theme="dark"] .text-gray-800 {
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .text-gray-700,
        [data-theme="dark"] .text-gray-600 {
            color: #CBD5E1 !important;
        }
        [data-theme="dark"] .text-gray-500 {
            color: #94A3B8 !important;
        }
        [data-theme="dark"] .input-field {
            background: #0F172A !important;
            border-color: #334155 !important;
            color: #F1F5F9 !important;
        }
        [data-theme="dark"] .input-field:focus {
            background: #111827 !important;
            border-color: #6366F1 !important;
        }

        * {
            font-family: 'Inter', sans-serif;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 60%, #A855F7 100%);
        }

        .input-field {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #E2E8F0;
            border-radius: 10px;
            font-size: 14px;
            background: #F8FAFC;
            transition: all 0.2s;
            outline: none;
        }

        .input-field:focus {
            border-color: #4F46E5;
            background: white;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .btn-primary {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.35);
        }

        .flash-msg {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            min-width: 280px;
            max-width: min(420px, calc(100vw - 32px));
            border-radius: 12px;
            padding: 12px 18px;
            font-size: 13.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid transparent;
        }

        .flash-success {
            background: #ECFDF5;
            color: #065F46;
            border-color: #A7F3D0;
        }

        .flash-error {
            background: #FFF1F2;
            color: #9F1239;
            border-color: #FECDD3;
        }

        [data-theme="dark"] .flash-success,
        .light-mode-disabled .flash-success,
        html.dark .flash-success {
            background: #064E3B !important;
            color: #ECFDF5 !important;
            border-color: #059669 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
        }

        [data-theme="dark"] .flash-error,
        .light-mode-disabled .flash-error,
        html.dark .flash-error {
            background: #7F1D1D !important;
            color: #FEF2F2 !important;
            border-color: #DC2626 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5) !important;
        }

        @media (max-width: 480px) {
            .flash-msg {
                top: 14px;
                right: 14px;
                left: 14px;
                min-width: auto;
                max-width: none;
                justify-content: center;
            }
        }

        @keyframes slideIn {
            from {
                transform: translateY(-20px) scale(0.95);
                opacity: 0;
            }
            to {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 16px;
            backdrop-filter: blur(10px);
        }

        .blob1 {
            position: absolute;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            top: -100px;
            right: -100px;
        }

        .blob2 {
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
            bottom: -80px;
            left: -80px;
        }

        .auth-lang-opt {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .auth-lang-opt:hover {
            background: #f1f5f9;
        }
        .auth-lang-opt.active {
            background: #eef2ff;
            color: #4f46e5;
        }
        [data-theme="dark"] .auth-lang-opt,
        html.dark .auth-lang-opt {
            color: #f1f5f9;
        }
        [data-theme="dark"] .auth-lang-opt:hover,
        html.dark .auth-lang-opt:hover {
            background: #334155;
        }
        [data-theme="dark"] .auth-lang-opt.active,
        html.dark .auth-lang-opt.active {
            background: rgba(99, 102, 241, 0.2);
            color: #818cf8;
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <%- include('../partials/flashMessages') %>
    <div id="flashContainer" class="fixed top-5 right-5 z-50"></div>
    <div class="flex min-h-screen">
        <div class="hidden lg:flex lg:w-1/2 gradient-bg flex-col justify-between p-12 relative overflow-hidden">
            <div class="blob1"></div>
            <div class="blob2"></div>
            <div class="relative z-10 flex items-center gap-3">
                <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center text-white font-bold text-lg backdrop-blur"> S</div>
                <span class="text-white font-bold text-xl">SchoolSync</span>
            </div>
            <div class="relative z-10">
                <div class="inline-flex items-center gap-2 bg-white/15 text-white text-sm px-4 py-2 rounded-full mb-6 backdrop-blur">
                    <i class="fa-solid fa-key"></i> Password Setup Compliance
                </div>
                <h2 class="text-4xl font-bold text-white mb-4 leading-tight">Secure Your<br>Account</h2>
                <p class="text-white/80 text-base mb-8 leading-relaxed">Since you logged in using shared credentials, you are required to set a strong, personal password for your profile before proceeding.</p>
                <div class="grid grid-cols-2 gap-3">
                    <div class="feature-card">
                        <i class="fa-solid fa-user-shield text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">Personal Privacy</div>
                        <div class="text-white/60 text-xs mt-1">Ensures your session actions are uniquely attributed to you</div>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-key text-white/80 mb-2 text-lg"></i>
                        <div class="text-white font-semibold text-sm">Strong Controls</div>
                        <div class="text-white/60 text-xs mt-1">Protects system endpoints with modern standards</div>
                    </div>
                </div>
            </div>
            <div class="relative z-10 flex gap-8">
                <div>
                    <div class="text-white font-bold text-2xl">MFA</div>
                    <div class="text-white/60 text-sm">Multi-Factor Auth</div>
                </div>
                <div>
                    <div class="text-white font-bold text-2xl">256-bit</div>
                    <div class="text-white/60 text-sm">AES Encryption</div>
                </div>
                <div>
                    <div class="text-white font-bold text-2xl">100%</div>
                    <div class="text-white/60 text-sm">Secure & Private</div>
                </div>
            </div>
        </div>
        <div class="w-full lg:w-1/2 flex items-center justify-center p-6 bg-white relative">
            <div class="absolute top-6 right-6 flex items-center gap-2" style="z-index: 50;">
                <div class="relative" id="authLangDropdown" style="position:relative;display:inline-block;">
                    <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 text-xs font-semibold hover:bg-gray-200 dark:hover:bg-slate-700 transition-all cursor-pointer shadow-sm h-9" onclick="toggleAuthLang(event)" aria-label="<%- (typeof lan !== 'undefined' && lan.Change_Language) ? lan.Change_Language : 'Change Language' %>">
                        <i class="fas fa-globe text-indigo-500"></i>
                        <span><%= (typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'ગુજરાતી' : ((typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'हिन्दी' : 'English') %></span>
                        <i class="fas fa-chevron-down text-[10px] text-gray-400"></i>
                    </button>
                    <div id="authLangMenu" style="display:none;position:absolute;right:0;top:calc(100% + 6px);width:140px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 10px 25px -5px rgba(0,0,0,0.1);padding:6px;z-index:9999;">
                        <a href="javascript:void(0)" onclick="setAppLanguage('english')" class="auth-lang-opt <%= (typeof currentLang === 'undefined' || currentLang === 'english') ? 'active' : '' %>">
                            <span>English</span>
                            <span style="font-size:10px;opacity:0.6;">EN</span>
                        </a>
                        <a href="javascript:void(0)" onclick="setAppLanguage('gujrati')" class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'gujrati') ? 'active' : '' %>">
                            <span>ગુજરાતી</span>
                            <span style="font-size:10px;opacity:0.6;">GU</span>
                        </a>
                        <a href="javascript:void(0)" onclick="setAppLanguage('hindi')" class="auth-lang-opt <%= (typeof currentLang !== 'undefined' && currentLang === 'hindi') ? 'active' : '' %>">
                            <span>हिन्दी</span>
                            <span style="font-size:10px;opacity:0.6;">HI</span>
                        </a>
                    </div>
                </div>
                <button type="button" class="theme-toggle-btn w-9 h-9 rounded-xl flex items-center justify-center bg-gray-100 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:scale-105 transition-all cursor-pointer shadow-sm" id="themeToggleBtn" onclick="toggleTheme()" aria-label="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>" title="<%- (typeof lan !== 'undefined' && lan.Switch_Theme) ? lan.Switch_Theme : 'Switch Theme' %>">
                    <i class="fas fa-moon"></i>
                </button>
            </div>
            <div class="w-full max-w-md">
                <div class="flex lg:hidden items-center gap-2 mb-8">
                    <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-sm"> S</div>
                    <span class="font-bold text-gray-800">SchoolSync</span>
                </div>
                <div class="mb-8">
                    <h1 class="text-2xl font-bold text-gray-900 mb-1">Set Personal Password 🔒</h1>
                    <p class="text-gray-500 text-sm">Configure a unique password for your account</p>
                </div>
                <form id="changePasswordForm" method="POST" action="/change-password" class="space-y-5">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">New Password *</label>
                        <div class="relative">
                            <input type="password" name="newPassword" id="newPass" required class="input-field pr-10" placeholder="Min 8 characters, letters & numbers">
                            <button type="button" onclick="togglePass('newPass', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Confirm Password *</label>
                        <div class="relative">
                            <input type="password" name="confirmPassword" id="confirmPass" required class="input-field pr-10" placeholder="Re-enter new password">
                            <button type="button" onclick="togglePass('confirmPass', this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary">
                        <i class="fa-solid fa-shield-halved mr-2"></i> Update Password
                    </button>
                </form>
                <p class="text-center text-sm text-gray-500 mt-6"> Want to log out?
                    <a href="/logout" class="font-semibold text-indigo-600 hover:text-indigo-700">Logout</a>
                </p>
            </div>
        </div>
    </div>
    <script>
        document.getElementById("changePasswordForm").addEventListener("submit", function (e) {
            const newPass = document.getElementById("newPass").value;
            const confirmPass = document.getElementById("confirmPass").value;
            if (newPass !== confirmPass) {
                e.preventDefault();
                showFlash("error", "Passwords do not match!");
                return;
            };
            if (newPass.length < 8) {
                e.preventDefault();
                showFlash("error", "Password must be at least 8 characters long.");
                return;
            };
        });

        function togglePass(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector("i");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("fa-eye-slash", "fa-eye");
            };
        };

        function showFlash(type, message) {
            const container = document.getElementById("flashContainer");
            const div = document.createElement("div");
            div.className = `flash-msg ${type === "success" ? "flash-success" : "flash-error"}`;
            div.innerHTML = `<i class="fa-solid ${type === "success" ? "fa-circle-check" : "fa-circle-exclamation"}"></i> ${message}`;
            container.appendChild(div);
            setTimeout(() => div.remove(), 3000);
        };

        function toggleAuthLang(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const menu = document.getElementById('authLangMenu');
            if (!menu) return;
            const isHidden = menu.style.display === 'none' || menu.style.display === '';
            menu.style.display = isHidden ? 'block' : 'none';
        }

        window.setAppLanguage = async function(lang) {
            try {
                const response = await fetch('/language/set', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ language: lang })
                });
                if (response.ok) {
                    window.location.reload();
                } else {
                    window.location.href = '/language/change/' + encodeURIComponent(lang);
                }
            } catch (err) {
                window.location.href = '/language/change/' + encodeURIComponent(lang);
            }
        };

        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('authLangDropdown');
            const menu = document.getElementById('authLangMenu');
            if (dropdown && menu && !dropdown.contains(e.target)) {
                menu.style.display = 'none';
            }
        });
    </script>
</body>
</html>