<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : '403 - Access Denied' %></title>
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ffffff;
        }

        .container {
            text-align: center;
            padding: 3rem 2rem;
            max-width: 600px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 45px rgba(0,0,0,0.2);
        }

        lottie-player {
            width: 260px;
            height: 260px;
            margin: 0 auto;
        }

        h1 {
            font-size: 2.8rem;
            margin: 1rem 0;
            color: #ff6b6b;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        p {
            font-size: 1.1rem;
            margin-bottom: 2.5rem;
            opacity: 0.9;
            line-height: 1.6;
        }

        .btn-group {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 12px 30px;
            background: #ff6b6b;
            color: #fff;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            box-shadow: 0 8px 20px rgba(255, 107, 107, 0.3);
            border: none;
            cursor: pointer;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(255, 107, 107, 0.4);
            background: #ff5252;
        }

        .btn-outline {
            background: transparent;
            color: #fff;
            border: 2px solid rgba(255, 255, 255, 0.5);
            box-shadow: none;
        }

        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #fff;
        }

        .error-code {
            font-size: 1.2rem;
            opacity: 0.5;
            margin-top: 2rem;
            letter-spacing: 3px;
            font-family: monospace;
        }
        @media (max-width: 480px) {
            .container { padding: 2rem 1.5rem; }
            h1 { font-size: 2rem; }
            p { font-size: 1rem; margin-bottom: 1.5rem; }
            lottie-player { width: 180px; height: 180px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <lottie-player src="https://assets4.lottiefiles.com/packages/lf20_tno6cgib.json" background="transparent" speed="1" loop autoplay></lottie-player>
        <h1>Access Denied!</h1>
        <p><%= typeof message !== 'undefined' ? message : "Sorry, you don't have permission to access this page. Please check your credentials or contact the administrator." %></p>
        <div class="btn-group">
            <a href="/" class="btn">← Back to Home</a>
            <a href="/login" class="btn btn-outline">🔒 Login Again</a>
        </div>
        <div class="error-code">Error Code: <%= typeof errorCode !== 'undefined' ? errorCode : '403' %></div>
    </div>
</body>
</html>