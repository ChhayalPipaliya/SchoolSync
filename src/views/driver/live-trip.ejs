          <% if (typeof stopGroups !== 'undefined' && Object.keys(stopGroups).length > 0) { %>
            <div class="student-boarding-list" id="studentBoardingList">
              <% 
                const isDropTrip = activeTrip && activeTrip.trip_type === 'drop';
                Object.keys(stopGroups).forEach(stopId => {
                  const item = stopGroups[stopId];
                  const stop = item.stop;
                  const stopStudents = item.students || [];
              %>
                <div class="stop-group-header" data-stop-id="<%= stop.id %>" style="display: flex; justify-content: space-between; align-items: center; background: #f1f5f9; padding: 10px 16px; font-weight: 700; font-size: 13px; color: #475569; border-left: 4px solid #ea580c;">
                  <span><i class="fas fa-map-pin mr-1" style="color: #ea580c;"></i> <%= stop.stop_name || stop.stopName %></span>
                  <span style="font-size: 11px; background: rgba(234,88,12,0.1); color: #ea580c; padding: 2px 6px; border-radius: 4px;"><%= stopStudents.length %> Students</span>
