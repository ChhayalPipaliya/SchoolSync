<div class="driver">
  <div style="background:linear-gradient(135deg, #ea580c, #9a3412); border-radius:12px; padding:24px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(234,88,12,0.15);">
    <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
    <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <h1 style="font-size:24px; font-weight:700; margin:0; color:#fff;">Live Trip Operations</h1>
            <p style="font-size:13px; opacity:0.9; margin:4px 0 0;" id="currentDate"></p>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
            <span id="liveClock" style="font-size:16px; font-weight:700; color:#fff; font-family:monospace; background:rgba(255,255,255,0.15); padding:6px 12px; border-radius:8px; border:1px solid rgba(255,255,255,0.25);"></span>
            <button onclick="triggerSOS()" class="btn btn-sos" style="background:#ef4444; color:#fff; border:none; padding:8px 16px; border-radius:8px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:8px;">
              <i class="fas fa-phone-alt"></i> SOS
            </button>
        </div>
    </div>
  </div>
  <%- include('../partials/flashMessages') %>
  <div class="driver-dashboard-grid" style="display: grid; grid-template-columns: 1fr; gap: 24px;">    
    <% if (activeTrip) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        <div class="d-card reveal" style="display: flex; flex-direction: column;">
          <div class="d-card-head">
            <div class="d-card-title">
              <div class="d-section-icon"><i class="fas fa-map-location-dot"></i></div>
              <span>Live Route Progress Map</span>
            </div>
            <span class="trip-active-pill">
              <span class="pulse-dot"></span>
              <%= labelTransportTrip(activeTrip) %>
            </span>
          </div>
          <div class="d-card-body" style="padding: 12px; flex: 1;">
            <div id="driverLiveMap"></div>
            <div id="mapPermissionNotice" class="map-permission-notice">
              <i class="fas fa-location-slash" style="margin-bottom:4px;"></i><br>
              Location permission is required for live tracking.
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; flex-wrap: wrap; gap: 8px;">
              <div style="font-size: 13px; color: #64748b;">
                <strong>Route:</strong> <%= activeTrip.routeName || driver.routeName %> &middot; 
