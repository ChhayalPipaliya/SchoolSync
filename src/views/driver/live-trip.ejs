  #driverLiveMap {
    height: 380px;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #f1f5f9;
  }
  .map-permission-notice {
    text-align: center;
    padding: 12px;
    font-size: 13px;
    color: #64748b;
    background: #f8fafc;
    border-radius: 8px;
    margin-top: 8px;
