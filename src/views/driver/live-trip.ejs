                        </div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-boarding-prompt" style="padding: 40px; text-align: center; color: #64748b;">
              <i class="fas fa-users-slash" style="font-size: 32px; margin-bottom: 12px; color: #94a3b8;"></i>
