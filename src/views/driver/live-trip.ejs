                                                <div>
                                                    <div style="font-weight: 800; font-size: 15px; color: #1e293b;">
                                                        <%= student.first_name %>
                                                        <%= student.last_name %>
                                                    </div>
                                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">Class: <strong> <%= student.className || '—' %></strong> &middot; Roll No: <strong><%= student.roll_no || '—' %></strong></div>
                                                    <div style="font-size: 11px; color: #64748b; margin-top: 4px; display: flex; gap: 12px; flex-wrap: wrap;">
                                                        <span><i class="fas fa-phone text-blue-500 mr-1"></i>Parent: <a href="tel:<%= student.parentPhone %>" style="color: #2563eb; font-weight: 700; text-decoration: none;"><%= student.parentPhone %></a></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                                <span id="badge-<%= student.id %>" class="px-3 py-1 text-xs font-extrabold rounded-full border <%= statusBadgeClass %>">
                                                    <%= statusText %>
                                                </span>
                                                <% if (status === 'pending') { %>
                                                    <div class="action-btn-group" id="actions-<%= student.id %>" style="display: flex; gap: 6px;">
                                                        <button onclick="markStudentBoarding('<%= student.id %>', 'pickup')" class="btn btn-sm" style="background: #10b981; color: #ffffff; font-weight: 800; border: none; padding: 6px 12px; border-radius: 8px; font-size: 12px; cursor: pointer;">
                                                            <i class="fas fa-check-circle mr-1"></i>Mark Picked Up
                                                        </button>
                                                        <button onclick="markStudentBoarding('<%= student.id %>', 'absent')" class="btn btn-sm" style="background: #ef4444; color: #ffffff; font-weight: 700; border: none; padding: 6px 10px; border-radius: 8px; font-size: 12px; cursor: pointer;">
                                                            <i class="fas fa-times-circle mr-1"></i>Absent
                                                        </button>
                                                    </div>
                                                <% } else if (status === 'picked') { %>
                                                    <div class="action-btn-group" id="actions-<%= student.id %>" style="display: flex; gap: 6px;">
                                                        <button onclick="markStudentBoarding('<%= student.id %>', 'drop')" class="btn btn-sm" style="background: #2563eb; color: #ffffff; font-weight: 800; border: none; padding: 6px 12px; border-radius: 8px; font-size: 12px; cursor: pointer;">
                                                            <i class="fas fa-flag-checkered mr-1"></i>
                                                            Mark Dropped
                                                        </button>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="text-align: center; padding: 40px 20px; color: #64748b;">
                                <i class="fas fa-users-slash" style="font-size: 36px; color: #cbd5e1; margin-bottom: 12px; display: block;"></i>
                                No students assigned to your route trip yet.
                            </div>
                        <% } %>
                    </div>
                </div>
                <div style="text-align: right; margin-top: 10px;">
                    <button id="btnEndTrip" class="btn btn-danger" style="background: linear-gradient(135deg, #dc2626, #b91c1c); color: #fff; font-weight: 800; padding: 14px 28px; border-radius: 12px; font-size: 15px; border: none; box-shadow: 0 4px 14px rgba(220, 38, 38, 0.3); cursor: pointer;" data-trip-id="<%= activeTrip.id %>">
                        <i class="fas fa-flag-checkered mr-2"></i> End Current Trip
                    </button>
                </div>
            </div>
        <% } else { %>
            <div style="background: var(--brand-card-bg); border-radius: 16px; border: 1px solid var(--brand-border); padding: 42px 28px; text-align: center; max-width: 680px; margin: 20px auto; box-shadow: 0 8px 24px rgba(0,0,0,0.04);">
                <div style="background: #fff7ed; width: 84px; height: 84px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; border: 4px solid #ffedd5; box-shadow: 0 4px 12px rgba(234, 88, 12, 0.15);">
                    <i class="fas fa-bus-alt" style="font-size: 38px; color: #ea580c;"></i>
                </div>
                <h2 style="font-size: 22px; font-weight: 800; color: var(--brand-text-main); margin: 0 0 8px;">No Active Trip Running</h2>
                <p style="color: var(--brand-text-sub); font-size: 14px; margin: 0 0 20px; line-height: 1.6;">You must start a trip first to enable live GPS tracking, view real-time student pickup status, and manage route stops.</p>
                <% if (driver && (driver.routeName || driver.vehicleNumber)) { %>
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 18px; display: inline-flex; align-items: center; gap: 16px; margin-bottom: 24px; font-size: 13px; color: #334155; flex-wrap: wrap; justify-content: center;">
                        <span><i class="fas fa-route text-orange-600 mr-1"></i> Route: <strong>
                            <%= driver.routeName || 'Assigned Route' %>
                        </strong></span>
                        <span style="color:#cbd5e1;">|</span>
                        <span><i class="fas fa-bus text-blue-600 mr-1"></i> Bus: <strong>
                            <%= driver.vehicleNumber || 'Assigned Vehicle' %>
                        </strong></span>
                    </div>
                <% } %>
                <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
                    <button class="btn start-trip-btn" data-trip-type="pickup" style="background: linear-gradient(135deg, #ea580c, #c2410c); color: #ffffff; font-weight: 800; padding: 14px 26px; border-radius: 12px; border: none; font-size: 15px; box-shadow: 0 4px 14px rgba(234, 88, 12, 0.3); cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
                        <i class="fas fa-sun"></i> Start <%= pickupTripLabel %>
                    </button>
                    <button class="btn start-trip-btn" data-trip-type="drop" style="background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #ffffff; font-weight: 800; padding: 14px 26px; border-radius: 12px; border: none; font-size: 15px; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3); cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
                        <i class="fas fa-moon"></i> Start <%= dropTripLabel %>
                    </button>
                </div>
            </div>
        <% } %>
    </div>
    <button id="floatingSosBtn" onmousedown="startSosHold(event)" onmouseup="cancelSosHold()" onmouseleave="cancelSosHold()" ontouchstart="startSosHold(event)" ontouchend="cancelSosHold()" class="sos-floating-btn" title="Press & Hold 3 Seconds for SOS Emergency">
        <i class="fas fa-exclamation-triangle" style="font-size: 20px;"></i>
        <span>🚨 SOS</span>
    </button>
    <div id="sosCategoryModal" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.7); backdrop-filter: blur(4px); z-index: 99999; display: none; align-items: center; justify-content: center; padding: 16px;">
        <div style="background: #ffffff; border-radius: 24px; max-width: 500px; width: 100%; padding: 26px; box-shadow: 0 20px 40px rgba(220, 38, 38, 0.3); text-align: center; border: 3px solid #dc2626; animation: modalPop 0.25s ease;">
            <div style="background: #fef2f2; width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; border: 3px solid #fca5a5;">
                <i class="fas fa-exclamation-triangle" style="font-size: 30px; color: #dc2626;"></i>
            </div>
            <h2 style="font-size: 22px; font-weight: 900; color: #1e293b; margin: 0 0 6px;">Select Emergency Type</h2>
            <p style="font-size: 13px; color: #64748b; margin: 0 0 20px;"> Tap the emergency category to broadcast alert & start live GPS tracking.</p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px;">
                <button onclick="triggerSosCategory('accident')" class="btn" style="background: #fef2f2; border: 2px solid #fca5a5; color: #991b1b; padding: 18px 12px; border-radius: 16px; font-weight: 800; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; transition: transform 0.15s ease;">
                    <i class="fas fa-car-crash" style="font-size: 28px; color: #dc2626;"></i>
                    <span>🚨 Accident<br><small style="font-weight: 600; opacity: 0.85;">Vehicle Collision</small></span>
                </button>
                <button onclick="triggerSosCategory('breakdown')" class="btn" style="background: #fff7ed; border: 2px solid #fed7aa; color: #9a3412; padding: 18px 12px; border-radius: 16px; font-weight: 800; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; transition: transform 0.15s ease;">
                    <i class="fas fa-wrench" style="font-size: 28px; color: #ea580c;"></i>
                    <span>🔧 Breakdown<br><small style="font-weight: 600; opacity: 0.85;">Engine/Tire Issue</small></span>
                </button>
                <button onclick="triggerSosCategory('medical')" class="btn" style="background: #eff6ff; border: 2px solid #bfdbfe; color: #1e40af; padding: 18px 12px; border-radius: 16px; font-weight: 800; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; transition: transform 0.15s ease;">
                    <i class="fas fa-notes-medical" style="font-size: 28px; color: #2563eb;"></i>
                    <span>🏥 Medical<br><small style="font-weight: 600; opacity: 0.85;">Student/Driver Health</small></span>
                </button>
                <button onclick="triggerSosCategory('hazard')" class="btn" style="background: #f8fafc; border: 2px solid #cbd5e1; color: #334155; padding: 18px 12px; border-radius: 16px; font-weight: 800; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; transition: transform 0.15s ease;">
                    <i class="fas fa-road-barrier" style="font-size: 28px; color: #475569;"></i>
                    <span>🚧 Route Hazard<br><small style="font-weight: 600; opacity: 0.85;">Road Blocked/Flooded</small></span>
                </button>
            </div>
            <button onclick="closeSosCategoryModal()" style="background: #f1f5f9; border: none; color: #475569; font-weight: 800; padding: 10px 20px; border-radius: 10px; cursor: pointer; width: 100%;">
                Cancel
            </button>
        </div>
    </div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
    let tripTimerInterval;
    let activeTabState = 'current';
    let watchPositionId = null;
    let gpsPostTimer = null;
    let socketClient = null;
    let simulationTimer = null;
    let simulatedCurrentLat = null;
    let simulatedCurrentLng = null;
    let simulatedCurrentHeading = null;
    let gpsSimulationActive = false;

    function calculateBearing(lat1, lng1, lat2, lng2) {
        const dLng = (lng2 - lng1) * Math.PI / 180;
        const y = Math.sin(dLng) * Math.cos(lat2 * Math.PI / 180);
        const x = Math.cos(lat1 * Math.PI / 180) * Math.sin(lat2 * Math.PI / 180) -
                    Math.sin(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.cos(dLng);
        const brng = Math.atan2(y, x) * 180 / Math.PI;
        return (brng + 360) % 360;
    };

    function haversineDistanceMeters(lat1, lon1, lat2, lon2) {
        const R = 6371000;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return R * c;
    };

    function getPointAtDistance(path, targetDistMeters) {
        if (!Array.isArray(path) || path.length === 0) return null;
        if (path.length === 1 || targetDistMeters <= 0) {
            return { lat: Number(path[0][0]), lng: Number(path[0][1]), bearing: 0, isEnd: false };
        };

        let accumulated = 0;
        for (let i = 0; i < path.length - 1; i++) {
            const p1 = path[i];
            const p2 = path[i + 1];
            const segDist = haversineDistanceMeters(p1[0], p1[1], p2[0], p2[1]);
            if (accumulated + segDist >= targetDistMeters) {
                const rem = targetDistMeters - accumulated;
                const frac = segDist > 0 ? (rem / segDist) : 0;
                const lat = Number(p1[0]) + (Number(p2[0]) - Number(p1[0])) * frac;
                const lng = Number(p1[1]) + (Number(p2[1]) - Number(p1[1])) * frac;
                const bearing = calculateBearing(Number(p1[0]), Number(p1[1]), Number(p2[0]), Number(p2[1]));
                return { lat, lng, bearing, isEnd: false };
            };
            accumulated += segDist;
        };

        const last = path[path.length - 1];
        const prev = path[path.length - 2] || last;
        const bearing = calculateBearing(Number(prev[0]), Number(prev[1]), Number(last[0]), Number(last[1]));
        return { lat: Number(last[0]), lng: Number(last[1]), bearing, isEnd: true };
    };

    function stopGpsSimulation() {
        if (simulationTimer) {
            clearInterval(simulationTimer);
            simulationTimer = null;
        };
        gpsSimulationActive = false;
    };

    document.addEventListener("DOMContentLoaded", () => {
        updateClock();
        setInterval(updateClock, 1000);

        const dateDisplay = document.getElementById("currentDate");
        if (dateDisplay) {
            dateDisplay.textContent = new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        };

        const tripTimer = document.getElementById("tripDuration");
        if (tripTimer && tripTimer.dataset.start) {
            runTripTimer(new Date(tripTimer.dataset.start));
        };

        document.querySelectorAll('.start-trip-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                startTrip(btn.dataset.tripType, btn);
            });
        });

        const btnEndTrip = document.getElementById("btnEndTrip");
        if (btnEndTrip) {
            btnEndTrip.addEventListener("click", endTrip);
        };

        const searchInput = document.getElementById("studentSearch");
        if (searchInput) {
            searchInput.addEventListener("input", (e) => {
                const query = e.target.value.toLowerCase().trim();
                const cards = document.querySelectorAll(".student-boarding-card");
                cards.forEach(card => {
                    const name = card.dataset.name || "";
                    if (name.includes(query)) {
                        card.style.display = "flex";
                    } else {
                        card.style.display = "none";
                    };
                });
            });
        };
        initLiveMap();
    });

    function updateClock() {
        const clockDisplay = document.getElementById("liveClock");
        if (clockDisplay) {
            clockDisplay.textContent = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        };
    };

    function runTripTimer(startTime) {
        clearInterval(tripTimerInterval);
        const tripTimer = document.getElementById("tripDuration");
        if (!tripTimer) return;

        tripTimerInterval = setInterval(() => {
            const elapsedMs = new Date() - startTime;
            const hours = Math.floor(elapsedMs / 3600000);
            const minutes = Math.floor((elapsedMs % 3600000) / 60000);
            const seconds = Math.floor((elapsedMs % 60000) / 1000);
            const pad = (num) => String(num).padStart(2, "0");
            tripTimer.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        }, 1000);
    };

    const DRIVER_ROUTE_SHIFT = '<%= driverRouteShift %>';
    async function startTrip(tripType, btn) {
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Starting…';
        };

        try {
            const response = await fetch("/driver/transport/trip/start", {
                method: "POST",
                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                body: JSON.stringify({ trip_type: tripType, trip_shift: DRIVER_ROUTE_SHIFT })
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message || "Trip started successfully!", "success");
                setTimeout(() => window.location.reload(), 800);
            } else {
                showToast(data.message || "Failed to start trip", "error");
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = `Start ${tripType}`;
                };
            };
        } catch (err) {
            console.error(err);
            showToast("Server connection error", "error");
            if (btn) btn.disabled = false;
        };
    };

    async function endTrip() {
        const btn = document.getElementById("btnEndTrip");
        if (!btn) return;
        const tripId = btn.dataset.tripId;
        if (!tripId) return;

        if (!confirm("Are you sure you want to end the current trip?")) return;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Ending Trip…';

        try {
            stopGpsSimulation();
            if (watchPositionId !== null) navigator.geolocation.clearWatch(watchPositionId);
            if (gpsPostTimer !== null) clearInterval(gpsPostTimer);

            const response = await fetch('/driver/transport/trip/end', {
                method: "POST",
                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                body: JSON.stringify({ tripId })
            });
            const data = await response.json();
            if (data.success) {
                showToast(data.message || "Trip completed!", "success");
                clearInterval(tripTimerInterval);
                setTimeout(() => window.location.href = "/driver/dashboard", 1000);
            } else {
                showToast(data.message || "Failed to end trip", "error");
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-flag-checkered"></i> End Current Trip';
            };
        } catch (err) {
            console.error(err);
            showToast("Server connection failure", "error");
            btn.disabled = false;
        };
    };

    async function markStudentBoarding(studentId, eventType) {
        const tripId = '<%= activeTrip ? activeTrip.id : "" %>';
        const status = eventType === 'pickup' ? 'picked' : (eventType === 'drop' ? 'dropped' : 'absent');
        if (!tripId) {
            showToast('Start a trip before marking student attendance.', 'error');
            return;
        };

        try {
            const response = await fetch(`/driver/transport/student/${studentId}/status`, {
                method: "POST",
                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                body: JSON.stringify({ status })
            });
            const data = await response.json();

            if (data.success) {
                showToast(data.message || "Attendance updated", "success");

                const badge = document.getElementById(`badge-${studentId}`);
                const actionsGroup = document.getElementById(`actions-${studentId}`);

                if (badge) {
                    if (eventType === 'pickup') {
                        badge.className = "px-3 py-1 text-xs font-extrabold rounded-full border bg-emerald-100 text-emerald-800 border-emerald-300";
                        badge.textContent = "Picked Up";
                    } else if (eventType === 'drop') {
                        badge.className = "px-3 py-1 text-xs font-extrabold rounded-full border bg-blue-100 text-blue-800 border-blue-300";
                        badge.textContent = "Dropped Off";
                    } else if (eventType === 'absent') {
                        badge.className = "px-3 py-1 text-xs font-extrabold rounded-full border bg-rose-100 text-rose-800 border-rose-300";
                        badge.textContent = "Absent";
                    };
                };

                if (actionsGroup) {
                    if (eventType === 'pickup') {
                        actionsGroup.innerHTML = `
                            <button onclick="markStudentBoarding('${studentId}', 'drop')" class="btn btn-sm" style="background: #2563eb; color: #ffffff; font-weight: 800; border: none; padding: 6px 12px; border-radius: 8px; font-size: 12px; cursor: pointer;">
                                <i class="fas fa-flag-checkered mr-1"></i> Mark Dropped
                            </button>
                        `;
                        actionsGroup.style.display = "flex";
                    } else {
                        actionsGroup.style.display = "none";
                    };
                };
                updateDashboardCounters(eventType);
                if (window.updateMarkerStatusLocal) {
                    window.updateMarkerStatusLocal(studentId, status);
                };
            } else {
                showToast(data.message || "Failed to update status", "error");
            };
        } catch (err) {
            console.error(err);
            showToast("Connection failure", "error");
        };
    };

    function updateDashboardCounters(type) {
        const countB = document.getElementById("countBoarded");
        const countD = document.getElementById("countDropped");
        if (type === "pickup" && countB) {
            countB.textContent = Number(countB.textContent) + 1;
        } else if (type === "drop" && countD) {
            countD.textContent = Number(countD.textContent) + 1;
        };
    };

    let sosHoldTimer = null;
    let sosHoldCount = 3;
    function startSosHold(e) {
        if (e && e.preventDefault && e.type === 'touchstart') e.preventDefault();
        sosHoldCount = 3;
        const btn = document.getElementById('floatingSosBtn');
        if (btn) btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> HOLD: 3s`;

        sosHoldTimer = setInterval(() => {
            sosHoldCount--;
            if (btn) btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> HOLD: ${sosHoldCount}s`;
            if (sosHoldCount <= 0) {
                clearInterval(sosHoldTimer);
                sosHoldTimer = null;
                if (btn) btn.innerHTML = `<i class="fas fa-exclamation-triangle"></i> 🚨 SOS`;
                openSosCategoryModal();
            };
        }, 1000);
    };

    function cancelSosHold() {
        if (sosHoldTimer) {
            clearInterval(sosHoldTimer);
            sosHoldTimer = null;
            const btn = document.getElementById('floatingSosBtn');
            if (btn) btn.innerHTML = `<i class="fas fa-exclamation-triangle"></i> <span>🚨 SOS</span>`;
        };
    };

    function openSosCategoryModal() {
        document.getElementById('sosCategoryModal').style.display = 'flex';
    };

    function closeSosCategoryModal() {
        document.getElementById('sosCategoryModal').style.display = 'none';
    };

    function triggerSosCategory(alertType) {
        closeSosCategoryModal();
        const tripId = '<%= activeTrip ? activeTrip.id : "" %>';

        const sendPayload = (lat, lng) => {
            fetch('/driver/sos/trigger', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    alert_type: alertType,
                    latitude: lat,
                    longitude: lng,
                    trip_id: tripId || null
                })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast('🚨 SOS Emergency Triggered! Live Location Shared.', 'error', 5000);
                    if (data.redirectUrl) {
                        setTimeout(() => window.location.href = data.redirectUrl, 800);
                    };
                } else {
                    showToast(data.message || 'SOS activation failed', 'error');
                };
            })
            .catch(() => showToast('Server connection failure', 'error'));
        };

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                pos => sendPayload(pos.coords.latitude, pos.coords.longitude),
                () => sendPayload(null, null),
                { enableHighAccuracy: true, timeout: 5000 }
            );
        } else {
            sendPayload(null, null);
        };
    };

    function switchStudentTab(tab) {
        activeTabState = tab;
        document.getElementById('tabCurrentStop').classList.toggle('active', tab === 'current');
        document.getElementById('tabAllStops').classList.toggle('active', tab === 'all');
        if (window.refreshNextStopDisplay) {
            window.refreshNextStopDisplay();
        };
    };

    function arriveAtCurrentStop() {
        if (window.currentActiveStop) {
            showToast(`📍 Arrived at stop: ${window.currentActiveStop.stop_name || 'Current Stop'}`, "success");
            if (window.mapRef && window.currentActiveStop.latitude && window.currentActiveStop.longitude) {
                window.mapRef.setView([Number(window.currentActiveStop.latitude), Number(window.currentActiveStop.longitude)], 16, { animate: true });
            };
        } else {
            showToast("All stops completed for this route!", "info");
        };
    };

    function skipCurrentStop() {
        if (window.currentActiveStop) {
            if (confirm(`Skip stop "${window.currentActiveStop.stop_name}"?`)) {
                window.skippedStops = window.skippedStops || {};
                window.skippedStops[window.currentActiveStop.id] = true;
                showToast(`⏭️ Skipped stop: ${window.currentActiveStop.stop_name}`, "info");
                if (window.refreshNextStopDisplay) window.refreshNextStopDisplay();
            };
        } else {
            showToast("No remaining stops to skip.", "info");
        };
    };

    function initLiveMap() {
        if (typeof L === 'undefined' || !window.liveTripData || !window.liveTripData.activeTrip) {
            return;
        };

        const tripData = window.liveTripData;
        const activeTrip = tripData.activeTrip;
        const routeStops = tripData.routeStops || [];
        const latestDriverLoc = tripData.latestDriverLocation;
        const TRIP_ID = activeTrip.id;
        const TRIP_TYPE = activeTrip.trip_type;

        const gpsBar = document.getElementById('gpsStatusBar');
        const gpsTxt = document.getElementById('gpsStatusText');

        function setGpsStatus(state, text) {
            if (!gpsBar || !gpsTxt) return;
            gpsBar.className = 'gps-' + state;
            gpsTxt.textContent = text;
        };

        const esc = val => String(val || '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
        const schLat = (tripData && tripData.schoolLocation) ? Number(tripData.schoolLocation.latitude) : null;
        const schLng = (tripData && tripData.schoolLocation) ? Number(tripData.schoolLocation.longitude) : null;
        const hasSchoolLocation = Number.isFinite(schLat) && Number.isFinite(schLng);

        const map = L.map('driverLiveMap', { zoomControl: true, scrollWheelZoom: false });
        if (hasSchoolLocation) {
            map.setView([schLat, schLng], 14);
        } else {
            map.setView([0, 0], 2);
        };
        window.mapRef = map;

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(map);

        function busIconForHeading(heading) {
            const rot = Number.isFinite(heading) ? heading : 0;
            return L.divIcon({
                className: '',
                html: `<div class="bus-marker-div" style="transform: rotate(${rot}deg);"><i class="fas fa-bus"></i></div>`,
                iconSize: [44, 44],
                iconAnchor: [22, 22],
                popupAnchor: [0, -24]
            });
        };

        const stopIcon = L.divIcon({
            className: '',
            html: '<div style="background:#0f172a;color:#fff;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;font-size:13px;box-shadow:0 2px 6px rgba(0,0,0,0.3);border:2px solid #fff;"><i class="fas fa-map-pin"></i></div>',
            iconSize: [30, 30],
            iconAnchor: [15, 15],
            popupAnchor: [0, -16]
        });

        const nextStopIcon = L.divIcon({
            className: '',
            html: '<div class="next-stop-marker-div"><i class="fas fa-location-crosshairs"></i></div>',
            iconSize: [36, 36],
            iconAnchor: [18, 18],
            popupAnchor: [0, -20]
        });

        const schoolIcon = L.divIcon({
            className: '',
            html: '<div style="background:#6b21a8;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;font-size:16px;box-shadow:0 3px 10px rgba(107,33,168,0.4);border:2px solid #fff;"><i class="fas fa-school"></i></div>',
            iconSize: [36, 36],
            iconAnchor: [18, 18],
            popupAnchor: [0, -20]
        });

        let busMarker = null;
        let currentLat = null;
        let currentLng = null;
        const bounds = [];
        const stopMarkers = {};
        window.skippedStops = {};

        let studentMarkerLayerGroup = L.layerGroup().addTo(map);

        function renderStudentMarkers(studentsList, tripType) {
            studentMarkerLayerGroup.clearLayers();
            if (!studentsList || studentsList.length === 0) return;

            const isDrop = tripType === 'drop';
            const hasCoords = (lat, lng) => {
                if (lat === null || lat === undefined || lat === '' || lat === 0 || lat === '0' || Number(lat) === 0) return false;
                if (lng === null || lng === undefined || lng === '' || lng === 0 || lng === '0' || Number(lng) === 0) return false;
                const nLat = Number(lat);
                const nLng = Number(lng);
                return Number.isFinite(nLat) && Number.isFinite(nLng) && nLat !== 0 && nLng !== 0;
            };

            const markersByCoords = {};
            studentsList.forEach(student => {
                const allocLat = isDrop ? (student.dropLatitude || student.drop_latitude) : (student.pickupLatitude || student.pickup_latitude);
                const allocLng = isDrop ? (student.dropLongitude || student.drop_longitude) : (student.pickupLongitude || student.pickup_longitude);
                const stopLat = isDrop ? (student.dropStopLatitude || student.drop_stop_latitude) : (student.pickupStopLatitude || student.pickup_stop_latitude);
                const stopLng = isDrop ? (student.dropStopLongitude || student.drop_stop_longitude) : (student.pickupStopLongitude || student.pickup_stop_longitude);
                const lat = hasCoords(allocLat, allocLng) ? Number(allocLat) : (hasCoords(stopLat, stopLng) ? Number(stopLat) : null);
                const lng = hasCoords(allocLat, allocLng) ? Number(allocLng) : (hasCoords(stopLat, stopLng) ? Number(stopLng) : null);

                if (lat !== null && lng !== null) {
                    student._computedLat = lat;
                    student._computedLng = lng;
                    const key = `${lat.toFixed(6)},${lng.toFixed(6)}`;
                    if (!markersByCoords[key]) markersByCoords[key] = [];
                    markersByCoords[key].push(student);
                    bounds.push([lat, lng]);
                };
            });

            Object.keys(markersByCoords).forEach(key => {
                const group = markersByCoords[key];
                const count = group.length;

                group.forEach((student, idx) => {
                    const baseLat = student._computedLat;
                    const baseLng = student._computedLng;

                    let lat = baseLat;
                    let lng = baseLng;
                    if (count > 1) {
                        const angle = (idx / count) * 2 * Math.PI;
                        const radius = 0.00015;
                        lat = baseLat + radius * Math.sin(angle);
                        lng = baseLng + radius * Math.cos(angle);
                    };

                    const stStatus = student.status || 'pending';
                    let color = '#2563eb';
                    let shadowColor = 'rgba(37,99,235,0.3)';
                    if (stStatus === 'picked') {
                        color = '#10b981';
                        shadowColor = 'rgba(16,185,129,0.3)';
                    } else if (stStatus === 'dropped') {
                        color = '#ea580c';
                        shadowColor = 'rgba(234,88,12,0.3)';
                    } else if (stStatus === 'absent') {
                        color = '#ef4444';
                        shadowColor = 'rgba(239,68,68,0.3)';
                    };

                    const studentIcon = L.divIcon({
                        className: '',
                        html: `<div style="background:${color};color:#ffffff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:12px;box-shadow:0 3px 8px ${shadowColor};border:2px solid #ffffff;"><i class="fas fa-user-graduate"></i></div>`,
                        iconSize: [28, 28],
                        iconAnchor: [14, 14],
                        popupAnchor: [0, -15]
                    });

                    const nameStr = `${student.first_name || ''} ${student.last_name || ''}`.trim() || student.name || 'Student';
                    const classStr = student.className ? `${student.className}${student.section ? ' - ' + student.section : ''}` : '—';
                    const rollStr = student.roll_no || '—';
                    const pickupStopStr = student.pickupStopName || student.pickup_stop || '—';
                    const dropStopStr = student.dropStopName || student.drop_stop || '—';
                    const parentNameStr = student.parentName || 'Parent/Guardian';
                    const parentPhoneStr = student.parentPhone || '—';

                    const photoUrl = student.photo || student.profile_image;
                    const photoHtml = photoUrl
                        ? `<img src="${esc(photoUrl)}" alt="${esc(nameStr)}" style="width:42px; height:42px; border-radius:50%; object-fit:cover; border:2px solid ${color}; flex-shrink:0;">`
                        : `<div style="width:42px; height:42px; border-radius:50%; background:${color}; color:#ffffff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px; flex-shrink:0;">${esc((student.first_name || 'S').charAt(0).toUpperCase())}</div>`;

                    const pickupStatusLbl = (stStatus === 'picked' || stStatus === 'dropped') ? 'Picked Up' : (stStatus === 'absent' ? 'Absent' : 'Waiting');
                    const dropStatusLbl = stStatus === 'dropped' ? 'Dropped Off' : (stStatus === 'absent' ? 'Absent' : 'Pending');

                    const popupContent = `
                        <div style="font-size:12px; line-height:1.4; min-width:210px; padding:4px;">
                            <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px; border-bottom:1px solid #e2e8f0; padding-bottom:8px;">${photoHtml}
                                <div>
                                    <strong style="color:#0f172a; font-size:14px; display:block; font-weight:800;">${esc(nameStr)}</strong>
                                    <span style="font-size:11px; color:#64748b;">Class: <strong>${esc(classStr)}</strong> | Roll: <strong>${esc(rollStr)}</strong></span>
                                </div>
                            </div>
                            <div style="display:grid; grid-template-columns:1fr; gap:4px; font-size:11px; color:#334155;">
                                <div><strong>📍 Pickup Stop:</strong> ${esc(pickupStopStr)}</div>
                                <div><strong>🏁 Drop Stop:</strong> ${esc(dropStopStr)}</div>
                                <div><strong>👨‍👩‍👦 Parent:</strong> ${esc(parentNameStr)} (${esc(parentPhoneStr)})</div>
                                <div style="margin-top:6px; display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                                    <span style="font-size:10px; font-weight:800; padding:3px 8px; border-radius:9999px; background:${stStatus === 'picked' || stStatus === 'dropped' ? '#dcfce7; color:#15803d; border:1px solid #a7f3d0;' : stStatus === 'absent' ? '#fee2e2; color:#991b1b; border:1px solid #fca5a5;' : '#dbeafe; color:#1e40af; border:1px solid #bfdbfe;'};">
                                        Pickup: ${esc(pickupStatusLbl)}
                                    </span>
                                    <span style="font-size:10px; font-weight:800; padding:3px 8px; border-radius:9999px; background:${stStatus === 'dropped' ? '#ffedd5; color:#c2410c; border:1px solid #fed7aa;' : stStatus === 'absent' ? '#fee2e2; color:#991b1b; border:1px solid #fca5a5;' : '#f1f5f9; color:#475569; border:1px solid #cbd5e1;'};">
                                        Drop: ${esc(dropStatusLbl)}
                                    </span>
                                </div>
                            </div>
                        </div>
                    `;

                    const m = L.marker([lat, lng], { icon: studentIcon }).bindPopup(popupContent);
                    studentMarkerLayerGroup.addLayer(m);
                });
            });
        };

        renderStudentMarkers(tripData.students || [], TRIP_TYPE);
        let roadPolyline = null;
        async function loadRealRoadRoute() {
            try {
                const routeId = (activeTrip && activeTrip.route_id) || (tripData && tripData.driver && tripData.driver.route_id) || (tripData && tripData.driver && tripData.driver.routeId);
                if (!routeId) {
                    drawFallbackDashedPolyline();
                    return;
                };
                const resp = await fetch(`/driver/api/route-path?routeId=${routeId}`);
                const data = await resp.json();
                if (data.success && Array.isArray(data.path) && data.path.length >= 2) {
                    if (roadPolyline) map.removeLayer(roadPolyline);
                    roadPolyline = L.polyline(data.path, {
                        color: '#ea580c',
                        weight: 6,
                        opacity: 0.9,
                        lineCap: 'round',
                        lineJoin: 'round'
                    }).addTo(map);

                    if (bounds.length > 0) {
                        map.fitBounds(L.latLngBounds(bounds), { padding: [40, 40], maxZoom: 15 });
                    } else if (roadPolyline) {
                        map.fitBounds(roadPolyline.getBounds(), { padding: [40, 40], maxZoom: 15 });
                    };
                } else {
                    drawFallbackDashedPolyline();
                };
            } catch (e) {
                console.warn('[Real Road Route load error, falling back]:', e);
                drawFallbackDashedPolyline();
            };
        };

        function drawFallbackDashedPolyline() {
            const routeCoordinates = [];
            routeStops.forEach(st => {
                const sLat = Number(st.latitude);
                const sLng = Number(st.longitude);
                if (Number.isFinite(sLat) && Number.isFinite(sLng)) {
                    routeCoordinates.push([sLat, sLng]);
                    bounds.push([sLat, sLng]);
                };
            });
            if (routeCoordinates.length > 1) {
                if (roadPolyline) map.removeLayer(roadPolyline);
                roadPolyline = L.polyline(routeCoordinates, {
                    color: '#ea580c',
                    weight: 5,
                    opacity: 0.85,
                    dashArray: '10, 10',
                    lineCap: 'round'
                }).addTo(map);
            };
        };

        loadRealRoadRoute();

        if (tripData.schoolLocation && Number.isFinite(Number(tripData.schoolLocation.latitude))) {
            const schLat = Number(tripData.schoolLocation.latitude);
            const schLng = Number(tripData.schoolLocation.longitude);
            bounds.push([schLat, schLng]);
            L.marker([schLat, schLng], { icon: schoolIcon }).addTo(map).bindPopup("<strong>School Campus</strong>");
        };

        function createStopMarkerIcon(stop, statusState, totalCount, remainingCount) {
            let bgColor = '#475569';
            let iconClass = 'fa-map-pin';
            let pulseStyle = '';
            let badgeBg = '#64748b';

            if (statusState === 'completed') {
                bgColor = '#10b981';
                iconClass = 'fa-check';
                badgeBg = '#059669';
            } else if (statusState === 'current') {
                bgColor = '#2563eb';
                iconClass = 'fa-location-crosshairs';
                pulseStyle = 'box-shadow: 0 0 0 8px rgba(37, 99, 235, 0.35); animation: nextStopGlow 1.8s infinite ease-in-out;';
                badgeBg = '#ea580c';
            };

            return L.divIcon({
                className: '',
                html: `<div style="background:${bgColor}; color:#ffffff; border-radius:50%; width:34px; height:34px; display:flex; align-items:center; justify-content:center; font-size:14px; border:2.5px solid #ffffff; box-shadow:0 3px 10px rgba(0,0,0,0.25); position:relative; ${pulseStyle}">
                    <i class="fas ${iconClass}"></i>
                    <span style="position:absolute; top:-6px; right:-6px; background:${badgeBg}; color:#ffffff; font-size:10px; font-weight:800; border-radius:9999px; padding:1px 5px; border:1px solid #ffffff; line-height:1;">${remainingCount > 0 ? remainingCount : '✓'}</span>
                </div>`,
                iconSize: [34, 34],
                iconAnchor: [17, 17],
                popupAnchor: [0, -18]
            });
        };

        function buildStopPopupContent(stop, stopInfo) {
            const students = (stopInfo && stopInfo.students) ? stopInfo.students : [];
            const totalCount = students.length;
            const pickedCount = students.filter(s => s.status === 'picked' || s.status === 'dropped').length;
            const remainingCount = students.filter(s => s.status === 'pending').length;
            const isCompleted = totalCount > 0 && remainingCount === 0;
            const isNext = window.currentActiveStop && String(window.currentActiveStop.id) === String(stop.id);

            let statusBadge = isCompleted
                ? '<span style="background:#dcfce7; color:#15803d; border:1px solid #a7f3d0; font-size:10px; font-weight:800; padding:2px 8px; border-radius:9999px;">🟢 Completed</span>'
                : (isNext
                    ? '<span style="background:#fef3c7; color:#92400e; border:1px solid #fde68a; font-size:10px; font-weight:800; padding:2px 8px; border-radius:9999px;">🟡 Current Stop</span>'
                    : '<span style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; font-size:10px; font-weight:800; padding:2px 8px; border-radius:9999px;">⚪ Upcoming Stop</span>');

            let studentListHtml = '';
            if (students.length === 0) {
                studentListHtml = '<div style="font-size:11px; color:#94a3b8; font-style:italic; padding:6px 0;">No students assigned to this stop.</div>';
            } else {
                studentListHtml = students.map(st => {
                    const stStatus = st.status || 'pending';
                    let stBadge = '<span style="color:#2563eb; font-weight:700;">Waiting</span>';
                    if (stStatus === 'picked') stBadge = '<span style="color:#10b981; font-weight:800;">Picked Up</span>';
                    if (stStatus === 'dropped') stBadge = '<span style="color:#ea580c; font-weight:800;">Dropped Off</span>';
                    if (stStatus === 'absent') stBadge = '<span style="color:#ef4444; font-weight:800;">Absent</span>';

                    const photoUrl = st.photo || st.profile_image;
                    const avatar = photoUrl
                        ? `<img src="${esc(photoUrl)}" style="width:24px; height:24px; border-radius:50%; object-fit:cover;">`
                        : `<div style="width:24px; height:24px; border-radius:50%; background:#ea580c; color:#ffffff; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:800;">${esc((st.first_name || 'S').charAt(0).toUpperCase())}</div>`;

                    return `
                        <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; padding:5px 0; border-bottom:1px dashed #e2e8f0; font-size:11px;">
                            <div style="display:flex; align-items:center; gap:6px;">${avatar}
                                <div>
                                    <strong style="color:#1e293b;">${esc(st.first_name)} ${esc(st.last_name || '')}</strong>
                                    <span style="color:#64748b; font-size:10px;">(${esc(st.className || '—')})</span>
                                </div>
                            </div>
                            <div style="font-size:10px;">${stBadge}</div>
                        </div>
                    `;
                }).join('');
            };

            return `
                <div style="font-size:12px; line-height:1.4; min-width:230px; padding:2px;">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px; border-bottom:1px solid #e2e8f0; padding-bottom:6px; margin-bottom:8px;">
                        <div>
                            <strong style="color:#ea580c; font-size:13.5px; display:block;">📍 ${esc(stop.stop_name || 'Stop')}</strong>
                            <span style="font-size:10px; color:#64748b;">Stop #${stop.sequence_number || stop.stop_order || 1}</span>
                        </div>
                        ${statusBadge}
                    </div>
                    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:6px; background:#f8fafc; padding:6px; border-radius:8px; text-align:center; margin-bottom:8px; font-size:10px; border:1px solid #e2e8f0;">
                        <div><strong style="display:block; font-size:13px; color:#1e293b;">${totalCount}</strong> Total</div>
                        <div><strong style="display:block; font-size:13px; color:#10b981;">${pickedCount}</strong> Picked</div>
                        <div><strong style="display:block; font-size:13px; color:#ea580c;">${remainingCount}</strong> Remaining</div>
                    </div>
                    <div style="font-weight:800; font-size:11px; color:#475569; margin-bottom:4px;">Assigned Students (${totalCount}):</div>
                    <div style="max-height:150px; overflow-y:auto; padding-right:4px;">
                        ${studentListHtml}
                    </div>
                </div>
            `;
        };

        function updateNextStopHighlight() {
            let nextStop = null;
            for (const stop of routeStops) {
                if (window.skippedStops[stop.id]) continue;
                const stopInfo = window.liveTripData.stopGroups[stop.id];
                if (stopInfo && stopInfo.students.some(s => s.status === 'pending')) {
                    nextStop = stop;
                    break;
                };
            };

            window.currentActiveStop = nextStop;

            const titleEl = document.getElementById('nextStopTitle');
            const etaEl = document.getElementById('nextStopEta');
            const countEl = document.getElementById('nextStopStudentCount');

            if (nextStop) {
                const stopInfo = window.liveTripData.stopGroups[nextStop.id] || { students: [] };
                const waitingCount = stopInfo.students.filter(s => s.status === 'pending').length;

                if (titleEl) titleEl.textContent = `#${nextStop.sequence_number || nextStop.stop_order || 1} ${nextStop.stop_name || 'Stop'}`;
                if (etaEl) {
                    if (currentLat && currentLng && nextStop.latitude && nextStop.longitude) {
                        const distKm = getDistanceKm(currentLat, currentLng, Number(nextStop.latitude), Number(nextStop.longitude));
                        const estMins = Math.max(1, Math.round((distKm / 25) * 60));
                        etaEl.innerHTML = `<i class="far fa-clock mr-1"></i> ~${estMins} mins away (${distKm.toFixed(1)} km)`;
                    } else {
                        etaEl.innerHTML = `<i class="far fa-clock mr-1"></i> Scheduled: ${TRIP_TYPE === 'drop' ? (nextStop.drop_time || '—') : (nextStop.pickup_time || '—')}`;
                    };
                };
                if (countEl) countEl.innerHTML = `<i class="fas fa-user-group mr-1"></i> ${waitingCount} students waiting`;
            } else {
                if (titleEl) titleEl.textContent = '🎉 Route Completed!';
                if (etaEl) etaEl.innerHTML = '<i class="fas fa-check-circle text-emerald-600 mr-1"></i> All students processed';
                if (countEl) countEl.textContent = '0 students remaining';
            };

            for (const stopId in stopMarkers) {
                const stop = routeStops.find(s => String(s.id) === String(stopId));
                const stopInfo = window.liveTripData.stopGroups[stopId];
                const students = stopInfo ? stopInfo.students : [];
                const totalCount = students.length;
                const remainingCount = students.filter(s => s.status === 'pending').length;
                const isCompleted = totalCount > 0 && remainingCount === 0;
                const isNext = nextStop && String(stopId) === String(nextStop.id);
                const statusState = isCompleted ? 'completed' : (isNext ? 'current' : 'upcoming');

                if (stopMarkers[stopId] && stop) {
                    stopMarkers[stopId].setIcon(createStopMarkerIcon(stop, statusState, totalCount, remainingCount));
                    stopMarkers[stopId].setPopupContent(buildStopPopupContent(stop, stopInfo));
                };
            };

            const stopBlocks = document.querySelectorAll('.stop-block-wrapper');
            stopBlocks.forEach(blk => {
                if (activeTabState === 'current') {
                    if (nextStop && String(blk.dataset.stopId) === String(nextStop.id)) {
                        blk.style.display = 'block';
                    } else {
                        blk.style.display = 'none';
                    };
                } else {
                    blk.style.display = 'block';
                };
            });
        };

        window.refreshNextStopDisplay = updateNextStopHighlight;
        routeStops.forEach(stop => {
            const sLat = Number(stop.latitude);
            const sLng = Number(stop.longitude);
            if (!Number.isFinite(sLat) || !Number.isFinite(sLng)) return;

            const stopInfo = (window.liveTripData && window.liveTripData.stopGroups) ? window.liveTripData.stopGroups[stop.id] : null;
            const students = stopInfo ? stopInfo.students : [];
            const totalCount = students.length;
            const remainingCount = students.filter(s => s.status === 'pending').length;
            const isCompleted = totalCount > 0 && remainingCount === 0;
            const statusState = isCompleted ? 'completed' : 'upcoming';

            const initialIcon = createStopMarkerIcon(stop, statusState, totalCount, remainingCount);
            const initialPopup = buildStopPopupContent(stop, stopInfo);

            const marker = L.marker([sLat, sLng], { icon: initialIcon }).addTo(map).bindPopup(initialPopup);
            stopMarkers[stop.id] = marker;
        });

        updateNextStopHighlight();

        function moveBusMarker(lat, lng, heading) {
            currentLat = lat;
            currentLng = lng;

            if (!busMarker) {
                busMarker = L.marker([lat, lng], { icon: busIconForHeading(heading) }).addTo(map);
                busMarker.bindPopup(`<b>${activeTrip.routeName || 'School Bus'}</b><br>Driver GPS Location`);
            } else {
                busMarker.setLatLng([lat, lng]);
                if (Number.isFinite(heading)) {
                    busMarker.setIcon(busIconForHeading(heading));
                };
            };
            updateNextStopHighlight();
        };

        if (latestDriverLoc && Number.isFinite(Number(latestDriverLoc.latitude)) && Number.isFinite(Number(latestDriverLoc.longitude))) {
            moveBusMarker(Number(latestDriverLoc.latitude), Number(latestDriverLoc.longitude), null);
        } else {
            const validStop = routeStops.find(st => Number.isFinite(Number(st.latitude)) && Number.isFinite(Number(st.longitude)));
            if (validStop) {
                moveBusMarker(Number(validStop.latitude), Number(validStop.longitude), null);
            };
        };

        if (bounds.length) {
            map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
        };

        const btnCenterMap = document.getElementById('btnCenterMap');
        if (btnCenterMap) {
            btnCenterMap.addEventListener('click', () => {
                if (currentLat && currentLng) {
                    map.setView([currentLat, currentLng], 15, { animate: true });
                };
            });
        };

        if (typeof io !== 'undefined') {
            try {
                socketClient = io();
                socketClient.on('connect', () => {
                    socketClient.emit('join_trip', { trip_id: TRIP_ID });
                });
                socketClient.on('stop_reached', (data) => {
                    showToast(`📍 Reached Stop: ${data.stop_name || ''}`, 'success', 4000);
                    if (typeof updateNextStopHighlight === 'function') updateNextStopHighlight();
                });
                socketClient.on('trip_completed', (data) => {
                    showToast(`🏁 Trip completed (${data.auto_close_reason || 'SYSTEM'})`, 'info', 5000);
                    setTimeout(() => { window.location.href = '/driver/dashboard'; }, 2000);
                });
            } catch (e) {
                console.warn("Socket.io init issue:", e);
            };
        };

        let lastSentTime = 0;
        function sendGpsLocation(lat, lng, speed, heading, isSimulation = false) {
            const now = Date.now();
            const simInterval = (tripData && tripData.gpsSimulationIntervalMs) ? tripData.gpsSimulationIntervalMs : 3000;
            const minInterval = isSimulation ? Math.max(500, simInterval - 200) : 4500;
            if (now - lastSentTime < minInterval) return;
            lastSentTime = now;

            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || document.querySelector('input[name="_csrf"]')?.value || '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

            const payload = {
                trip_id: TRIP_ID,
                latitude: lat,
                longitude: lng,
                speed: speed || 0,
                heading: Number.isFinite(heading) ? heading : null,
                _csrf: csrfToken
            };

            if (socketClient && socketClient.connected) {
                socketClient.emit('update_location', payload);
            };

            fetch('/driver/transport/location', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify(payload)
            }).catch(err => console.warn('[GPS API Fail]:', err.message));

            moveBusMarker(lat, lng, heading);
        };

        let simulationTickCount = 0;
        async function startGpsSimulation(intervalMs, speedKmh) {
            stopGpsSimulation();
            gpsSimulationActive = true;
            simulationTickCount = 0;

            const routeId = (activeTrip && activeTrip.route_id) || (tripData && tripData.driver && (tripData.driver.route_id || tripData.driver.routeId));
            if (!routeId) {
                console.warn('[SIM] Error: No Route ID available');
                setGpsStatus('error', 'Simulation Error: No Route');
                return;
            };

            setGpsStatus('waiting', 'Loading Route Path…');
            try {
                const resp = await fetch(`/driver/api/route-path?routeId=${routeId}`);
                const data = await resp.json();
                if (!data.success || !Array.isArray(data.path) || data.path.length < 2) {
                    console.warn('[SIM] Error: Short or invalid route path returned', data);
                    setGpsStatus('error', 'Simulation Error: Short Path');
                    return;
                };

                const path = data.path;
                let currentTraveledMeters = 0;
                const metersPerTick = (speedKmh * 1000 / 3600) * (intervalMs / 1000);

                setGpsStatus('active', `Local GPS Simulation · ${speedKmh} km/h`);

                const initialPoint = getPointAtDistance(path, 0);
                if (initialPoint) {
                    simulatedCurrentLat = initialPoint.lat;
                    simulatedCurrentLng = initialPoint.lng;
                    simulatedCurrentHeading = initialPoint.bearing;
                    simulationTickCount++;
                    sendGpsLocation(initialPoint.lat, initialPoint.lng, speedKmh, initialPoint.bearing, true);
                };

                simulationTimer = setInterval(() => {
                    currentTraveledMeters += metersPerTick;
                    const pt = getPointAtDistance(path, currentTraveledMeters);
                    if (!pt) return;

                    simulatedCurrentLat = pt.lat;
                    simulatedCurrentLng = pt.lng;
                    simulatedCurrentHeading = pt.bearing;

                    simulationTickCount++;

                    sendGpsLocation(pt.lat, pt.lng, speedKmh, pt.bearing, true);

                    if (pt.isEnd) {
                        clearInterval(simulationTimer);
                        simulationTimer = null;
                        setGpsStatus('waiting', 'Simulation Route Completed');
                    };
                }, intervalMs);
            } catch (e) {
                console.error('[SIM] GPS Simulator Error:', e);
                setGpsStatus('error', 'Simulation Path Load Failed');
            };
        };

        if (tripData && (tripData.gpsSimulationEnabled === true || tripData.gpsSimulationEnabled === 'true' || tripData.gpsSimulationEnabled == 1)) {
            const intervalMs = tripData.gpsSimulationIntervalMs || 3000;
            const speedKmh = tripData.gpsSimulationSpeedKmh || 30;
            startGpsSimulation(intervalMs, speedKmh);
        } else if (navigator.geolocation) {
            setGpsStatus('active', 'GPS Active (લાઇવ GPS)');
            watchPositionId = navigator.geolocation.watchPosition(
                (pos) => {
                    const { latitude, longitude, speed, heading } = pos.coords;
                    const speedKmh = Number.isFinite(speed) && speed >= 0 ? Math.round(speed * 3.6) : 0;
                    setGpsStatus('active', `GPS Active · ${speedKmh} km/h`);
                    const notice = document.getElementById('mapPermissionNotice');
                    if (notice) notice.style.display = 'none';
                    sendGpsLocation(latitude, longitude, speedKmh, heading);
                },
                (err) => {
                    console.warn('GPS Error:', err.message);
                    setGpsStatus('error', 'GPS Signal Retrying…');
                    const notice = document.getElementById('mapPermissionNotice');
                    if (notice) notice.style.display = 'block';
                },
                { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 }
            );
        } else {
            setGpsStatus('error', 'GPS Not Supported');
        };

        window.addEventListener('beforeunload', stopGpsSimulation);
        window.addEventListener('pagehide', stopGpsSimulation);

        const btnRefreshGps = document.getElementById('btnRefreshGps');
        if (btnRefreshGps) {
            btnRefreshGps.addEventListener('click', () => {
                if (gpsSimulationActive) {
                    btnRefreshGps.disabled = true;
                    btnRefreshGps.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending…';
                    if (simulatedCurrentLat !== null && simulatedCurrentLng !== null) {
                        lastSentTime = 0;
                        const speedKmh = (tripData && tripData.gpsSimulationSpeedKmh) ? tripData.gpsSimulationSpeedKmh : 30;
                        sendGpsLocation(simulatedCurrentLat, simulatedCurrentLng, speedKmh, simulatedCurrentHeading, true);
                        showToast("Simulated GPS location sent!", "success");
                    } else {
                        showToast("Simulation starting…", "info");
                    };
                    setTimeout(() => {
                        btnRefreshGps.disabled = false;
                        btnRefreshGps.innerHTML = '<i class="fas fa-location-arrow"></i> Send Location Now';
                    }, 500);
                    return;
                };

                if (!navigator.geolocation) return;
                btnRefreshGps.disabled = true;
                btnRefreshGps.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending…';
                navigator.geolocation.getCurrentPosition(
                    (pos) => {
                        const { latitude, longitude, speed, heading } = pos.coords;
                        lastSentTime = 0;
                        const notice = document.getElementById('mapPermissionNotice');
                        if (notice) notice.style.display = 'none';
                        sendGpsLocation(latitude, longitude, speed ? speed * 3.6 : 0, heading);
                        showToast("GPS location sent!", "success");
                        btnRefreshGps.disabled = false;
                        btnRefreshGps.innerHTML = '<i class="fas fa-location-arrow"></i> Send Location Now';
                    },
                    () => {
                        showToast("Failed to fetch location", "error");
                        const notice = document.getElementById('mapPermissionNotice');
                        if (notice) notice.style.display = 'block';
                        btnRefreshGps.disabled = false;
                        btnRefreshGps.innerHTML = '<i class="fas fa-location-arrow"></i> Send Location Now';
                    },
                    { enableHighAccuracy: true, timeout: 8000 }
                );
            });
        };

        window.updateMarkerStatusLocal = function (studentId, newStatus) {
            for (const stopId in window.liveTripData.stopGroups) {
                const group = window.liveTripData.stopGroups[stopId];
                const student = group.students.find(s => String(s.id) === String(studentId));
                if (student) {
                    student.status = newStatus;
                    break;
                };
            };
            if (window.liveTripData.students) {
                const st = window.liveTripData.students.find(s => String(s.id) === String(studentId));
                if (st) st.status = newStatus;
            }
            renderStudentMarkers(window.liveTripData.students || [], TRIP_TYPE);
            updateNextStopHighlight();
        };
    };

    function getDistanceKm(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    };
</script>