<%
  const driverRouteShift = (typeof driver !== 'undefined' && driver && driver.routeShift) ? driver.routeShift : 'full_day';
  const driverShiftLabel = driverRouteShift === 'morning' ? 'Morning School' : (driverRouteShift === 'evening' ? 'Evening School' : 'Full Day School');
  const pickupTripLabel = driverRouteShift === 'evening' ? 'Evening Pickup' : 'Morning Pickup';
  const dropTripLabel = driverRouteShift === 'morning' ? 'Morning Drop' : 'Evening Drop';
  const labelTransportTrip = (trip) => {
    const shift = trip && (trip.trip_shift || trip.tripShift) ? (trip.trip_shift || trip.tripShift) : driverRouteShift;
    if (shift === 'morning') return trip && trip.trip_type === 'drop' ? 'Morning Drop' : 'Morning Pickup';
    if (shift === 'evening') return trip && trip.trip_type === 'drop' ? 'Evening Drop' : 'Evening Pickup';
    return trip && trip.trip_type === 'drop' ? 'Evening Drop' : 'Morning Pickup';
  };
%>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
  #driverLiveMap {
    height: 380px;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #f1f5f9;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(37,99,235,0.7); }
    70% { box-shadow: 0 0 0 10px rgba(37,99,235,0); }
    100% { box-shadow: 0 0 0 0 rgba(37,99,235,0); }
  }
  .map-permission-notice {
    text-align: center;
    padding: 12px;
    font-size: 13px;
    color: #64748b;
    background: #f8fafc;
    border-radius: 8px;
    margin-top: 8px;
    display: none;
  }
  .stop-group-header {
    background: #f8fafc;
    border-left: 4px solid #ea580c;
    padding: 8px 16px;
    font-weight: 700;
    font-size: 13px;
    color: #1e293b;
    margin-top: 16px;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  #gpsStatusBar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #64748b;
    transition: all 0.3s ease;
  }
  #gpsStatusBar.gps-active {
    background: #ecfdf5;
    border-color: #6ee7b7;
    color: #065f46;
  }
  #gpsStatusBar.gps-error {
    background: #fef2f2;
    border-color: #fca5a5;
    color: #991b1b;
  }
  #gpsStatusBar.gps-waiting {
    background: #fffbeb;
    border-color: #fcd34d;
    color: #92400e;
  }
  #gpsDot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }
  #gpsStatusBar.gps-active #gpsDot {
    animation: gpsPulse 1.5s ease-in-out infinite;
  }
  @keyframes gpsPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }
  .leaflet-marker-icon {
    transition: transform 0.3s ease;
  }
  .bus-marker-div {
    transition: left 0.5s ease, top 0.5s ease;
  }
  @media (max-width: 480px) {
    #driverLiveMap {
      height: 300px;
    }
    .driver > div:first-of-type > div {
      align-items: flex-start !important;
    }
    .driver > div:first-of-type > div > div:last-child {
      width: 100%;
      flex-direction: column;
      align-items: stretch !important;
    }
    #liveClock,
    .btn-sos {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
    .trip-counters-grid {
      grid-template-columns: 1fr !important;
    }
    #btnRefreshGps {
      width: 100%;
      justify-content: center;
    }
  }
  .boarding-status-badge.status-absent {
    background-color: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fca5a5;
  }
  .boarding-status-badge.status-missed {
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
  }
</style>
<script>
    window.liveTripData = {
        activeTrip: '<%- JSON.stringify(activeTrip) %>',
        routeStops: '<%- JSON.stringify(routeStops) %>',
        latestDriverLocation: '<%- JSON.stringify(latestDriverLocation) %>',
