                          <div><i class="fas fa-flag" style="color: #10b981; margin-right: 4px; width: 12px;"></i> <strong>Drop Stop:</strong> <%= student.dropStopName || '—' %> (<%= student.dropTime || '—' %>)</div>
                          <div><i class="fas fa-phone" style="margin-right: 4px; width: 12px;"></i> <strong>Parent:</strong> <a href="tel:<%= student.parentPhone %>" style="color: #3b82f6; text-decoration: none; font-weight: 600;"><%= student.parentPhone %></a></div>
