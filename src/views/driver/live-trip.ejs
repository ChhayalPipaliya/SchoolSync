<div class="driver">
  <div style="background:linear-gradient(135deg, #ea580c, #9a3412); border-radius:12px; padding:24px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(234,88,12,0.15);">
    <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
    <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <h1 style="font-size:24px; font-weight:700; margin:0; color:#fff;">Live Trip Operations</h1>
            <p style="font-size:13px; opacity:0.9; margin:4px 0 0;" id="currentDate"></p>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
            <span id="liveClock" style="font-size:16px; font-weight:700; color:#fff; font-family:monospace; background:rgba(255,255,255,0.15); padding:6px 12px; border-radius:8px; border:1px solid rgba(255,255,255,0.25);"></span>
            <button onclick="triggerSOS()" class="btn btn-sos" style="background:#ef4444; color:#fff; border:none; padding:8px 16px; border-radius:8px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:8px;">
              <i class="fas fa-phone-alt"></i> SOS
            </button>
        </div>
    </div>
  </div>

  <%- include('../partials/flashMessages') %>

  <!-- Live Trip Control Panel -->
  <div class="driver-dashboard-grid" style="display: grid; grid-template-columns: 1fr; gap: 24px;">
    
    <% if (activeTrip) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        
        <!-- Left: Map & Meta -->
        <div class="d-card reveal" style="display: flex; flex-direction: column;">
          <div class="d-card-head">
            <div class="d-card-title">
              <div class="d-section-icon"><i class="fas fa-map-location-dot"></i></div>
              <span>Live Route Progress Map</span>
            </div>
            <span class="trip-active-pill">
              <span class="pulse-dot"></span>
              <%= labelTransportTrip(activeTrip) %>
            </span>
          </div>
          <div class="d-card-body" style="padding: 12px; flex: 1;">
            <div id="driverLiveMap"></div>
            <div id="mapPermissionNotice" class="map-permission-notice">
              <i class="fas fa-location-slash" style="margin-bottom:4px;"></i><br>
              Location permission is required for live tracking.
            </div>
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; flex-wrap: wrap; gap: 8px;">
              <div style="font-size: 13px; color: #64748b;">
                <strong>Route:</strong> <%= activeTrip.routeName || driver.routeName %> &middot; 
                <strong>Vehicle:</strong> <%= driver.vehicleNumber %>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <div id="gpsStatusBar" class="gps-waiting">
                  <span id="gpsDot"></span>
                  <span id="gpsStatusText">GPS Initializing…</span>
                </div>
                <button id="btnRefreshGps" class="btn btn-secondary btn-sm"><i class="fas fa-location-arrow"></i> Share Location</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Stats & Controls -->
        <div class="d-card" style="display: flex; flex-direction: column;">
          <div class="d-card-head">
            <div class="d-card-title">
              <div class="d-section-icon"><i class="fas fa-tachometer-alt"></i></div>
              <span>Trip Statistics</span>
            </div>
            <span class="trip-active-pill" id="tripDuration" data-start="<%= activeTrip.start_at %>">00:00:00</span>
          </div>
          <div class="d-card-body" style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div class="trip-counters-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px;">
              <div class="counter-box box-boarded" style="text-align: center; padding: 12px; border-radius: 8px; background: #ecfdf5; border: 1px solid #a7f3d0;">
                <span class="counter-value" id="countBoarded" style="font-size: 24px; font-weight: 800; color: #065f46; display: block;"><%= pickedUpCount %></span>
                <span class="counter-label" style="font-size: 11px; color: #047857; font-weight: 600;">Onboarded</span>
              </div>
              <div class="counter-box box-total" style="text-align: center; padding: 12px; border-radius: 8px; background: #f8fafc; border: 1px solid #e2e8f0;">
                <span class="counter-value" id="countTotal" style="font-size: 24px; font-weight: 800; color: #334155; display: block;"><%= totalStudents %></span>
                <span class="counter-label" style="font-size: 11px; color: #475569; font-weight: 600;">Total</span>
              </div>
              <div class="counter-box box-dropped" style="text-align: center; padding: 12px; border-radius: 8px; background: #eff6ff; border: 1px solid #bfdbfe;">
                <span class="counter-value" id="countDropped" style="font-size: 24px; font-weight: 800; color: #1e40af; display: block;"><%= droppedCount %></span>
                <span class="counter-label" style="font-size: 11px; color: #1d4ed8; font-weight: 600;">Dropped Off</span>
              </div>
            </div>
            
            <div style="background: #f8fafc; border-radius: 8px; padding: 16px; margin-bottom: 20px; font-size: 13px; color: #475569;">
              <h4 style="font-weight: 700; color: #1e293b; margin-top: 0; margin-bottom: 8px;">Quick Actions</h4>
              <ul style="margin: 0; padding-left: 20px; line-height: 1.6;">
                <li>Search for students using the checklist search box.</li>
                <li>Mark students as Boarded/Dropped, Absent or Missed.</li>
                <li>When the route is complete, click <strong>End Current Trip</strong>.</li>
              </ul>
            </div>

            <button id="btnEndTrip"
                    class="btn btn-danger"
                    style="width: 100%; padding: 12px; font-size: 15px; font-weight: 700;"
                    data-trip-id="<%= activeTrip.id %>"
                    data-route-name="<%= driver.routeName || '' %>"
                    data-vehicle-number="<%= driver.vehicleNumber || '' %>"
                    data-driver-name="<%= (user.first_name || '') + ' ' + (user.last_name || '') %>">
              <i class="fas fa-flag-checkered mr-1"></i> End Current Trip
            </button>
          </div>
        </div>

      </div>

      <!-- Live Passenger Boarding Checklist -->
      <div class="d-card boarding-widget reveal reveal-delay-2" style="margin-top: 24px;">
        <div class="d-card-head">
          <div class="d-card-title">
            <div class="d-section-icon"><i class="fas fa-clipboard-user"></i></div>
            <span>Student Boarding Checklist</span>
          </div>
          <div class="boarding-search-wrap">
            <i class="fas fa-search"></i>
            <input type="text" id="studentSearch" placeholder="Search students…">
          </div>
        </div>

        <div class="d-card-body p-0">
          <% if (students && students.length > 0) { %>
            <div class="student-boarding-list" id="studentBoardingList">
              
              <% 
                const isDropTrip = activeTrip && activeTrip.trip_type === 'drop';
                
                // Group students by stop
                const studentsByStop = {};
                students.forEach(student => {
                  const stopName = isDropTrip ? (student.dropStopName || 'Unassigned Drop Stop') : (student.pickupStopName || 'Unassigned Pickup Stop');
                  if (!studentsByStop[stopName]) {
                    studentsByStop[stopName] = [];
                  }
                  studentsByStop[stopName].push(student);
                });
              %>

              <% Object.keys(studentsByStop).forEach(stopName => { %>
                <div class="stop-group-header">
                  <span><i class="fas fa-map-pin mr-1"></i> <%= stopName %></span>
                  <span style="font-size: 11px; background: rgba(234,88,12,0.1); color: #ea580c; padding: 2px 6px; border-radius: 4px;"><%= studentsByStop[stopName].length %> Students</span>
                </div>
                
                <% studentsByStop[stopName].forEach(student => { 
                  const state = eventMap && eventMap[student.id];
                  const status = state ? state.status : 'pending';
                  const preferredLat = isDropTrip ? student.dropLatitude : student.pickupLatitude;
                  const preferredLng = isDropTrip ? student.dropLongitude : student.pickupLongitude;
                  const stopLat = isDropTrip ? student.dropStopLatitude : student.pickupStopLatitude;
                  const stopLng = isDropTrip ? student.dropStopLongitude : student.pickupStopLongitude;
                  const hasAllocationLocation = preferredLat && preferredLng;
                  const hasStopFallbackLocation = !hasAllocationLocation && stopLat && stopLng;
                  const hasAnyLocation = hasAllocationLocation || hasStopFallbackLocation;
                  let statusClass = 'status-waiting';
                  let statusLabel = 'Waiting';
                  let statusStyle = '';
                  if (status === 'picked') {
                    statusClass = 'status-boarded';
                    statusLabel = 'Boarded';
                  } else if (status === 'dropped') {
                    statusClass = 'status-dropped';
                    statusLabel = 'Dropped';
                  } else if (status === 'absent') {
                    statusClass = 'status-absent';
                    statusLabel = 'Absent';
                    statusStyle = 'background-color: #fee2e2; color: #b91c1c; border-color: #fca5a5;';
                  } else if (status === 'missed') {
                    statusClass = 'status-absent';
                    statusLabel = 'Missed';
                    statusStyle = 'background-color: #fef3c7; color: #92400e; border-color: #fcd34d;';
                  }
                %>
                  <div class="student-boarding-card" data-student-id="<%= student.id %>" data-name="<%= student.first_name.toLowerCase() %> <%= student.last_name.toLowerCase() %>" style="border-bottom: 1px solid #f1f5f9; padding: 16px;">
                    <div class="student-card-main" style="width: 100%; display: flex; gap: 12px;">
                      <div class="student-card-avatar" style="background: #f1f5f9; color: #ea580c; font-weight: 700; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px;">
                        <%= (student.first_name || 'S').charAt(0).toUpperCase() %>
                      </div>
                      <div class="student-card-info" style="flex: 1;">
                        <div class="student-name" style="font-weight: 700; font-size: 14px; color: #1e293b;"><%= student.first_name %> <%= student.last_name %></div>
                        <div class="student-sub" style="font-size: 12px; color: #64748b; margin-top: 2px;">Roll: <%= student.roll_no || '—' %> &middot; Class: <%= student.className || '—' %></div>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 4px; margin-top: 6px; font-size: 12px; color: #64748b;">
                          <div><i class="fas fa-map-pin" style="color: var(--primary); margin-right: 4px; width: 12px;"></i> <strong>Pickup:</strong> <%= student.pickupStopName || '—' %> (<%= student.pickupTime || '—' %>)</div>
                          <div><i class="fas fa-flag" style="color: #10b981; margin-right: 4px; width: 12px;"></i> <strong>Drop:</strong> <%= student.dropStopName || '—' %> (<%= student.dropTime || '—' %>)</div>
                          <div><i class="fas fa-phone" style="margin-right: 4px; width: 12px;"></i> <strong>Parent:</strong> <a href="tel:<%= student.parentPhone %>" style="color: #3b82f6; text-decoration: none; font-weight: 600;"><%= student.parentPhone %></a></div>
                          <div>
                            <i class="fas fa-location-dot" style="margin-right: 4px; width: 12px;"></i>
                            <% if (hasAnyLocation) { %>
                              <a href="#driverLiveMap" style="color:#3b82f6;text-decoration:none;font-weight:600;">View on map</a>
                            <% } else { %>
                              <span style="color:#94a3b8;font-weight:600;">Location not set</span>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="student-card-actions" style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px;">
                      <div class="boarding-status-badge <%= statusClass %>" id="status-<%= student.id %>" style="<%= statusStyle %>">
                        <%= statusLabel %>
                      </div>
                      <% if (status === 'pending' || (activeTrip.trip_type === 'drop' && status === 'picked')) { %>
                        <div class="boarding-action-buttons" style="display: flex; gap: 4px; flex-wrap: wrap;">
                          <% if (activeTrip.trip_type === 'pickup') { %>
                            <button class="board-action-btn btn-board" onclick="markStudentBoarding(<%= student.id %>, 'pickup')" style="background: #10b981; color: white; border: none; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 700; cursor: pointer;">
                              <i class="fas fa-sign-in-alt"></i> Board
                            </button>
                          <% } else if (activeTrip.trip_type === 'drop') { %>
                            <button class="board-action-btn btn-drop" onclick="markStudentBoarding(<%= student.id %>, 'drop')" style="background: #3b82f6; color: white; border: none; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 700; cursor: pointer;">
