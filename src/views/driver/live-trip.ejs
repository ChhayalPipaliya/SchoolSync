                <div id="gpsStatusBar" class="gps-waiting">
                  <span id="gpsDot"></span>
                  <span id="gpsStatusText">GPS Initializing…</span>
                </div>
                <button id="btnRefreshGps" class="btn btn-secondary btn-sm"><i class="fas fa-location-arrow"></i> Share Location</button>
              </div>
            </div>
          </div>
        </div>
        <div class="d-card" style="display: flex; flex-direction: column;">
          <div class="d-card-head">
            <div class="d-card-title">
              <div class="d-section-icon"><i class="fas fa-tachometer-alt"></i></div>
              <span>Trip Statistics</span>
            </div>
            <span class="trip-active-pill" id="tripDuration" data-start="<%= activeTrip.start_at %>">00:00:00</span>
          </div>
          <div class="d-card-body" style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
