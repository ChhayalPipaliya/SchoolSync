<%
  const driverRouteShift = (typeof driver !== 'undefined' && driver && driver.routeShift) ? driver.routeShift : 'full_day';
  const driverShiftLabel = driverRouteShift === 'morning' ? 'Morning School' : (driverRouteShift === 'evening' ? 'Evening School' : 'Full Day School');
  const pickupTripLabel = driverRouteShift === 'evening' ? 'Evening Pickup' : 'Morning Pickup';
  const dropTripLabel = driverRouteShift === 'morning' ? 'Morning Drop' : 'Evening Drop';
  const labelTransportTrip = (trip) => {
    const shift = trip && (trip.trip_shift || trip.tripShift) ? (trip.trip_shift || trip.tripShift) : driverRouteShift;
    if (shift === 'morning') return trip && trip.trip_type === 'drop' ? 'Morning Drop' : 'Morning Pickup';
    if (shift === 'evening') return trip && trip.trip_type === 'drop' ? 'Evening Drop' : 'Evening Pickup';
    return trip && trip.trip_type === 'drop' ? 'Evening Drop' : 'Morning Pickup';
  };
%>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
