<!-- src/views/driver/meetings/my-meetings.ejs -->
<!-- Driver Video Meetings Page -->

<div style="background: linear-gradient(135deg, #ea580c, #9a3412); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(234,88,12,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1;">
        <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff; display: flex; align-items: center; gap: 10px;">
            <i class="fas fa-video"></i> My Video Meetings
        </h1>
        <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">View and join scheduled video conferences and staff meetings</p>
    </div>
</div>

<style>
  .meeting-badge {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .badge-scheduled {
    background: #fff7ed;
    color: #c2410c;
    border: 1px solid #ffedd5;
  }
  .badge-live {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #d1fae5;
  }
  .badge-completed {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
  }
  .badge-cancelled {
    background: #fff1f2;
    color: #be123c;
    border: 1px solid #fecdd3;
  }
  .badge-default {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
  }
</style>

<div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
    <% if (!meetings || meetings.length === 0) { %>
        <div style="padding: 48px 20px; text-align: center; color: #64748b;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: #fff7ed; color: #ea580c; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 16px;">
                <i class="fas fa-video-slash"></i>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 6px 0;">No meetings scheduled for you yet</h3>
            <p style="font-size: 13px; color: #64748b; margin: 0;">Any upcoming staff or transport meetings organized by school administration will appear here.</p>
        </div>
    <% } else { %>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; vertical-align: middle;">
                <thead>
                    <tr style="border-bottom: 1px solid #F1F5F9; background: #F8FAFC;">
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Meeting Info</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Host</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px;">Status</th>
                        <th style="padding: 12px 20px; color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 11px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% meetings.forEach(meeting => { %>
                        <%
                            const startMs = new Date(meeting.scheduled_at).getTime();
                            const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                            const now = Date.now();
                            const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);

                            let badgeStyleClass = 'badge-default';
                            if (meeting.status === 'scheduled') badgeStyleClass = 'badge-scheduled';
                            else if (meeting.status === 'live') badgeStyleClass = 'badge-live';
                            else if (meeting.status === 'completed') badgeStyleClass = 'badge-completed';
                            else if (meeting.status === 'cancelled') badgeStyleClass = 'badge-cancelled';
                        %>
                        <tr style="border-bottom: 1px solid #F1F5F9;">
                            <td style="padding: 14px 20px;">
                                <div style="font-weight: 700; color: #1e293b; font-size: 14px;"><%= meeting.title %></div>
                                <div style="font-size: 12px; color: #64748b; margin-top: 4px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <span><i class="fas fa-calendar-alt" style="margin-right: 4px; color: #ea580c;"></i><%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
                                    <span>•</span>
                                    <span><i class="fas fa-clock" style="margin-right: 4px; color: #ea580c;"></i><%= meeting.duration_minutes %> mins</span>
                                </div>
                            </td>
                            <td style="padding: 14px 20px; color: #475569; font-weight: 600;">
                                <%= meeting.creator_name || 'School Admin' %>
                            </td>
                            <td style="padding: 14px 20px;">
                                <span class="meeting-badge <%= badgeStyleClass %>">
                                    <%= meeting.status %>
                                </span>
                            </td>
                            <td style="padding: 14px 20px; text-align: right;">
                                <div style="display: inline-flex; gap: 8px; justify-content: flex-end; align-items: center; width: 100%;">
                                    <a href="/driver/meetings/<%= meeting.id %>" style="text-decoration: none; padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #475569; background: #F1F5F9; border: 1px solid #E2E8F0; display: inline-flex; align-items: center; gap: 6px;">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                    <% if (canJoin) { %>
                                        <a href="/driver/meetings/<%= meeting.id %>/join" style="text-decoration: none; padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #fff; background: #16a34a; border: 1px solid #15803d; display: inline-flex; align-items: center; gap: 6px;">
                                            <i class="fas fa-video"></i> Join
                                        </a>
                                    <% } else { %>
                                        <button style="padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #94A3B8; background: #F1F5F9; border: 1px solid #E2E8F0; display: inline-flex; align-items: center; gap: 6px; opacity: 0.6; cursor: not-allowed;" disabled>
                                            <i class="fas fa-video"></i> Join
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>