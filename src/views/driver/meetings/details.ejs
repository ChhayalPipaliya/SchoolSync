<style>
    .meeting-badge {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    }
    .badge-scheduled { background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5; }
    .badge-live { background: #ecfdf5; color: #047857; border: 1px solid #d1fae5; }
    .badge-completed { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .badge-cancelled { background: #fff1f2; color: #be123c; border: 1px solid #fecdd3; }
    .badge-default { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
</style>
<div style="background: linear-gradient(135deg, #ea580c, #9a3412); border-radius: 12px; padding: 24px; color: #fff; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: 0 4px 12px rgba(234,88,12,0.15);">
    <div style="position: absolute; right: -30px; top: -30px; width: 150px; height: 150px; background: rgba(255, 255, 255, 0.08); border-radius: 50%;"></div>
    <div style="position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 700; margin: 0; color: #fff; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-info-circle"></i> Meeting Details
            </h1>
            <p style="font-size: 13px; opacity: 0.9; margin: 4px 0 0;">Review meeting information, schedule, and join options</p>
        </div>
        <a href="/driver/meetings" style="text-decoration: none; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; color: #ea580c; background: #fff; border: none; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fas fa-arrow-left"></i> Back to Meetings
        </a>
    </div>
</div>
<div class="ss-card" style="background: #fff; border-radius: 16px; border: 1px solid #E2E8F0; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); max-width: 800px; margin: 0 auto 24px auto;">
    <%
        let badgeStyleClass = 'badge-default';
        if (meeting.status === 'scheduled') badgeStyleClass = 'badge-scheduled';
        else if (meeting.status === 'live') badgeStyleClass = 'badge-live';
        else if (meeting.status === 'completed') badgeStyleClass = 'badge-completed';
        else if (meeting.status === 'cancelled') badgeStyleClass = 'badge-cancelled';
    %>
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px;">
        <span class="meeting-badge <%= badgeStyleClass %>"><%= meeting.status %></span>
        <span style="font-size: 12px; color: #64748b;">Scheduled by <strong><%= creatorName %></strong></span>
    </div>
    <h2 style="font-size: 20px; font-weight: 700; color: #1e293b; margin: 0 0 12px 0;"><%= meeting.title %></h2>
    <% if (meeting.description) { %>
        <div style="padding: 14px 16px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; font-size: 13px; color: #475569; line-height: 1.6; margin-bottom: 20px;">
            <%= meeting.description %>
        </div>
    <% } %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="padding: 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; display: flex; align-items: center; gap: 12px;">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: #fff7ed; color: #ea580c; display: flex; align-items: center; justify-content: center; font-size: 16px;">
                <i class="far fa-calendar"></i>
            </div>
            <div>
                <div style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase;">Scheduled Time</div>
                <div style="font-size: 13px; font-weight: 700; color: #1e293b;"><%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %></div>
            </div>
        </div>
        <div style="padding: 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; display: flex; align-items: center; gap: 12px;">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: #f3e8ff; color: #9333ea; display: flex; align-items: center; justify-content: center; font-size: 16px;">
                <i class="far fa-clock"></i>
            </div>
            <div>
                <div style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase;">Duration</div>
                <div style="font-size: 13px; font-weight: 700; color: #1e293b;"><%= meeting.duration_minutes %> Minutes</div>
            </div>
        </div>
        <div style="padding: 14px; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; display: flex; align-items: center; gap: 12px;">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 16px;">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <div style="font-size: 10px; color: #64748b; font-weight: 700; text-transform: uppercase;">Audience</div>
                <div style="font-size: 13px; font-weight: 700; color: #1e293b; text-transform: capitalize;"><%= targetDisplay %></div>
            </div>
        </div>
    </div>
    <% if (attendance) { %>
        <div style="padding: 14px 16px; background: #ecfdf5; border: 1px solid #d1fae5; border-radius: 10px; margin-bottom: 24px;">
            <div style="font-size: 13px; font-weight: 700; color: #047857; margin-bottom: 4px;"><i class="fas fa-check-circle me-1"></i> Your Attendance Log</div>
            <div style="font-size: 12px; color: #065f46;">
                Joined at: <%= new Date(attendance.joined_at).toLocaleString('en-IN') %>
                <% if (attendance.left_at) { %>
                    · Left at: <%= new Date(attendance.left_at).toLocaleString('en-IN') %>
                <% } %>
                · Total duration: <strong><%= attendance.duration_minutes %> mins</strong>
            </div>
        </div>
    <% } %>
    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; border-top: 1px solid #F1F5F9; padding-top: 20px;">
        <%
            const startMs = new Date(meeting.scheduled_at).getTime();
            const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
            const now = Date.now();
            const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
        %>
        <% if (canJoin) { %>
            <p style="font-size: 13px; color: #64748b; margin-bottom: 12px;">The meeting room is currently open.</p>
            <a href="/driver/meetings/<%= meeting.id %>/join" style="text-decoration: none; padding: 10px 24px; border-radius: 8px; font-size: 13px; font-weight: 700; color: #fff; background: #16a34a; border: 1px solid #15803d; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fas fa-video"></i> Join Meeting Room
            </a>
        <% } else if (meeting.status === 'cancelled') { %>
            <p style="font-size: 13px; color: #be123c; font-weight: 600; margin-bottom: 12px;">This meeting has been cancelled.</p>
            <button style="padding: 10px 24px; border-radius: 8px; font-size: 13px; font-weight: 600; color: #94A3B8; background: #F1F5F9; border: 1px solid #E2E8F0; opacity: 0.6; cursor: not-allowed;" disabled>Join Unavailable</button>
        <% } else if (meeting.status === 'completed') { %>
            <p style="font-size: 13px; color: #64748b; margin-bottom: 12px;">This meeting has already completed.</p>
            <button style="padding: 10px 24px; border-radius: 8px; font-size: 13px; font-weight: 600; color: #94A3B8; background: #F1F5F9; border: 1px solid #E2E8F0; opacity: 0.6; cursor: not-allowed;" disabled>Meeting Completed</button>
        <% } else { %>
            <p style="font-size: 13px; color: #64748b; margin-bottom: 12px;">Join window opens 15 minutes before the scheduled start time.</p>
            <button style="padding: 10px 24px; border-radius: 8px; font-size: 13px; font-weight: 600; color: #94A3B8; background: #F1F5F9; border: 1px solid #E2E8F0; opacity: 0.6; cursor: not-allowed;" disabled>Join Not Open</button>
        <% } %>
    </div>
</div>