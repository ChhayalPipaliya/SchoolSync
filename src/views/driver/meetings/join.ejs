<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | SchoolSync</title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body,
        html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #f8fafc;
            font-family: 'Inter', sans-serif;
            color: #111827;
        }

        #container {
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
        }

        #header {
            height: 50px;
            background-color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            box-shadow: 0 1px 8px rgba(15, 23, 42, 0.12);
            border-bottom: 1px solid #e5e7eb;
            z-index: 10;
        }

        #title-area {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        #meeting-title {
            font-weight: 700;
            font-size: 14px;
        }

        #badge {
            background-color: #eab308;
            color: #000;
            font-size: 10px;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        #meet {
            flex: 1;
            width: 100%;
            height: 100%;
        }

        .btn-leave {
            background-color: #e11d48;
            color: #ffffff;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background-color 0.2s;
        }

        .btn-leave:hover {
            background-color: #be123c;
        }
    </style>
    <script src="https://<%= jitsiDomain %>/external_api.js"></script>
</head>
<body>
    <div id="container">
        <div id="header">
            <div id="title-area">
                <span id="badge">Driver</span>
                <span id="meeting-title"><%= meeting.title %></span>
            </div>
            <button class="btn-leave" onclick="confirmLeave()">
                <i class="fa-solid fa-phone-slash"></i> Leave Room
            </button>
        </div>
        <div id="meet"></div>
        <div class="mt-4 flex items-center gap-3 p-4 bg-white border-t border-slate-200" id="confirmAttendanceSection">
            <button id="confirmBtn" onclick="confirmMyAttendance()" class="btn btn-primary text-xs flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-3 rounded-lg transition-colors">
                <i class="fas fa-check-circle"></i> Confirm I'm Present
            </button>
            <span id="confirmStatus" class="text-xs text-gray-400 hidden"></span>
        </div>
    </div>
    <script>
        const meetingId = '<%= meeting.id %>';
        let api = null;
        let isLeaving = false;

        document.addEventListener("DOMContentLoaded", () => {
            const domain = '<%= jitsiDomain %>';
            const options = {
                roomName: '<%= meeting.room_name %>',
                width: '100%',
                height: '100%',
                parentNode: document.querySelector('#meet'),
                userInfo: {
                    displayName: '<%= user.name || (user.first_name + " " + (user.last_name || "")) %>'
                },
                configOverwrite: {
                    startWithAudioMuted: false,
                    startWithVideoMuted: false,
                    prejoinPageEnabled: false
                },
                interfaceConfigOverwrite: {
                    TOOLBAR_BUTTONS: [
                        'microphone', 'camera', 'closedcaptions', 'fullscreen',
                        'fodeviceselection', 'hangup', 'profile', 'chat', 'settings',
                        'videoquality', 'filmstrip', 'feedback', 'stats', 'shortcuts',
                        'tileview', 'videobackgroundblur', 'download', 'help'
                    ]
                }
            };

            api = new JitsiMeetExternalAPI(domain, options);
            api.addEventListener('readyToClose', () => {
                triggerLeaveAndExit();
            });

            startHeartbeat();
        });

        function startHeartbeat() {
            setInterval(() => {
                if (isLeaving) return;
                fetch(`/api/meetings/${meetingId}/heartbeat`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                }).catch(err => console.error('Heartbeat failed:', err));
            }, 60000);
        };

        function triggerLeaveAndExit() {
            if (isLeaving) return;
            isLeaving = true;

            fetch(`/api/meetings/${meetingId}/leave`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).finally(() => {
                window.location.href = '/driver/meetings/' + meetingId;
            });
        };

        function confirmLeave() {
            if (confirm("Are you sure you want to leave the meeting room?")) {
                triggerLeaveAndExit();
            };
        };

        window.addEventListener('beforeunload', () => {
            if (!isLeaving) {
                navigator.sendBeacon(`/api/meetings/${meetingId}/leave`);
            };
        });

        async function confirmMyAttendance() {
            const btn = document.getElementById('confirmBtn');
            const status = document.getElementById('confirmStatus');
            if (!btn || !status) return;

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Confirming...';

            try {
                const res = await fetch(`/api/meetings/<%= meeting.id %>/confirm-attendance`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                status.classList.remove('hidden');
                if (data.success) {
                    btn.innerHTML = '<i class="fas fa-check-circle mr-1"></i> Present';
                    btn.className = 'btn text-xs flex items-center gap-2 bg-emerald-100 text-emerald-700 border border-emerald-200 cursor-default py-1.5 px-3 rounded-lg';
                    btn.disabled = true;
                    status.textContent = 'Attendance confirmed successfully';
                    status.className = 'text-xs text-emerald-600';
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check-circle mr-1"></i> Confirm I\'m Present';
                    status.textContent = data.message || 'Failed to confirm';
                    status.className = 'text-xs text-red-500';
                }
            } catch {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle mr-1"></i> Confirm I\'m Present';
                status.textContent = 'Request failed. Try again.';
                status.classList.remove('hidden');
                status.className = 'text-xs text-red-500';
            };
        };
    </script>
</body>
</html>