<div style="background:linear-gradient(135deg, #ea580c, #9a3412); border-radius:12px; padding:24px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(234,88,12,0.15);">
    <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
    <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <h1 style="font-size:24px; font-weight:700; margin:0; color:#fff;"><%= driver.routeName || 'My Assigned Route' %></h1>
            <% if (driver.startPoint) { %>
              <div style="display:flex; align-items:center; gap:10px; color:rgba(255,255,255,0.9); font-weight:600; font-size: 14px; margin-top: 8px;">
                <span style="font-weight:700;"><%= driver.startPoint %></span>
                <i class="fa-solid fa-arrow-right-long" style="font-size:12px; opacity:0.8;"></i>
                <span><%= driver.endPoint %></span>
              </div>
            <% } %>
        </div>
        <% if (activeTrip) { %>
            <span style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.35); color: #dcfce7; font-weight: 700; border-radius: 100px; padding: 6px 14px; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 6px;"><span style="width: 7px; height: 7px; border-radius: 50%; background: #4ade80;"></span>Active Now</span>
        <% } %>
    </div>
</div>
<% if (!driver.routeName) { %>
    <div class="empty-state" style="text-align:center; padding:48px 0; color:#94A3B8;">
        <i class="fa-solid fa-route fa-3x" style="opacity: 0.3; color: var(--driver-muted); margin-bottom:16px; display:block;"></i>
        <div style="font-size:18px;font-weight:700;color:#1E293B;margin-bottom:8px;">No Route Assigned</div>
        <div style="font-size:14px;color:#64748B;">Please contact your school admin to assign a route for your vehicle.</div>
    </div>
<% } else { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        <div>
            <div class="card">
                <div class="card-title">
                    <i class="fa-solid fa-bus"></i> Vehicle Information
                </div>
                <div class="card-body" style="padding: 0;">
                    <% if (driver.vehicleNumber) { %>
                        <div style="margin-bottom: 16px;">
                            <div class="info-label">Vehicle Number</div>
                            <div class="info-value" style="color:var(--primary); font-size:18px;"><%= driver.vehicleNumber %></div>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div>
                                <div class="info-label">Model</div>
                                <div class="info-value"><%= driver.vehicleModel || 'N/A' %></div>
                            </div>
                            <div>
                                <div class="info-label">Capacity</div>
                                <div class="info-value"><%= driver.capacity || '0' %> Seats</div>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="empty-state small">
                            <i class="fas fa-car-crash"></i>
                            <p>No vehicle details found.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        <div>
            <div class="card">
                <div class="card-title">
                    <i class="fa-solid fa-clock"></i> Route Timeline
                </div>
                <div class="card-body" style="padding: 0;">
                    <div style="display:flex; flex-direction:column; gap:20px; position:relative;">
                        <div style="display:flex; gap:15px; position:relative;">
                            <div style="width:12px; height:12px; border-radius:50%; background:var(--primary); margin-top:5px; z-index:2; outline: 4px solid var(--primary-light);"></div>
                            <div style="position:absolute; left:5px; top:15px; bottom:-25px; width:2px; background:#E2E8F0; z-index:1;"></div>
                            <div>
                                <div class="info-label">Starting Point</div>
                                <div class="info-value"><%= driver.startPoint %></div>
                            </div>
                        </div>
                        <div style="display:flex; gap:15px; margin-top:10px;">
                            <div style="width:12px; height:12px; border-radius:50%; background:#94A3B8; margin-top:5px; z-index:2;"></div>
                            <div>
                                <div class="info-label">Destination</div>
                                <div class="info-value"><%= driver.endPoint %></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<% } %>