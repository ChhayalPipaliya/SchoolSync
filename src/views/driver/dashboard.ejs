<%
  const driverRouteShift = (typeof driver !== 'undefined' && driver && driver.routeShift) ? driver.routeShift : 'full_day';
  const driverShiftLabel = driverRouteShift === 'morning' ? 'Morning School' : (driverRouteShift === 'evening' ? 'Evening School' : 'Full Day School');
  const pickupTripLabel = driverRouteShift === 'evening' ? 'Evening Pickup' : 'Morning Pickup';
  const dropTripLabel = driverRouteShift === 'morning' ? 'Morning Drop' : 'Evening Drop';
  const labelTransportTrip = (trip) => {
    const shift = trip && (trip.trip_shift || trip.tripShift) ? (trip.trip_shift || trip.tripShift) : driverRouteShift;
    if (shift === 'morning') return trip && trip.trip_type === 'drop' ? 'Morning Drop' : 'Morning Pickup';
    if (shift === 'evening') return trip && trip.trip_type === 'drop' ? 'Evening Drop' : 'Evening Pickup';
    return trip && trip.trip_type === 'drop' ? 'Evening Drop' : 'Morning Pickup';
  };
%>

<div class="driver">
  <div style="background:linear-gradient(135deg, #ea580c, #9a3412); border-radius:12px; padding:24px; color:#fff; margin-bottom:24px; position:relative; overflow:hidden; box-shadow:0 4px 12px rgba(234,88,12,0.15);">
    <div style="position:absolute; right:-30px; top:-30px; width:150px; height:150px; background:rgba(255,255,255,0.08); border-radius:50%;"></div>
    <div style="position:relative; z-index:1; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div>
            <h1 style="font-size:24px; font-weight:700; margin:0; color:#fff;">Driver Control Center</h1>
            <p style="font-size:13px; opacity:0.9; margin:4px 0 0;" id="currentDate"></p>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
            <span id="liveClock" style="font-size:16px; font-weight:700; color:#fff; font-family:monospace; background:rgba(255,255,255,0.15); padding:6px 12px; border-radius:8px; border:1px solid rgba(255,255,255,0.25);"></span>
            <button onclick="triggerSOS()" class="btn btn-sos" style="background:#ef4444; color:#fff; border:none; padding:8px 16px; border-radius:8px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:8px;">
              <i class="fas fa-phone-alt"></i> SOS
            </button>
        </div>
    </div>
  </div>

  <%- include('../partials/flashMessages') %>

  <!-- Overview Stats Card -->
  <div class="d-card" style="margin-bottom: 24px;">
    <div class="d-card-body" style="padding: 20px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px;">
        <div>
          <div style="font-size: 11px; color: var(--driver-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;">Assigned Vehicle</div>
          <div style="font-weight: 700; color: var(--driver-text); font-size: 15px;"><%= driver.vehicleNumber || '—' %></div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--driver-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;">Assigned Route</div>
          <div style="font-weight: 700; color: var(--driver-text); font-size: 15px;"><%= driver.routeName || '—' %></div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--driver-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;">School Shift</div>
          <div style="font-weight: 700; color: var(--driver-primary); font-size: 15px;"><%= driverShiftLabel %></div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--driver-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;"><%= pickupTripLabel %> Status</div>
          <div style="font-weight: 700; font-size: 15px; color: <%= pickupTripStatus?.status === 'running' ? '#10B981' : 'var(--driver-text)' %>;"><%= pickupTripStatus?.status || 'not started' %></div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--driver-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;"><%= dropTripLabel %> Status</div>
          <div style="font-weight: 700; font-size: 15px; color: <%= dropTripStatus?.status === 'running' ? '#10B981' : 'var(--driver-text)' %>;"><%= dropTripStatus?.status || 'not started' %></div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--driver-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;">Total Students</div>
          <div style="font-weight: 700; color: var(--driver-text); font-size: 15px;"><%= totalStudents || 0 %></div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--driver-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;">Stops Count</div>
          <div style="font-weight: 700; color: var(--driver-text); font-size: 15px;"><%= routeStops?.length || 0 %></div>
        </div>
        <div>
          <div style="font-size: 11px; color: var(--driver-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;">Checklist Status</div>
          <div style="font-weight: 700; font-size: 15px; color: <%= checklistDone ? '#10B981' : '#F59E0B' %>;"><%= checklistDone ? 'done' : 'pending' %></div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; border-top: 1px solid #f1f5f9; padding-top: 16px;">
        <% if (!activeTrip) { %>
          <button class="btn btn-primary btn-sm start-trip-btn" data-trip-type="pickup"><i class="fas fa-sun"></i> Start <%= pickupTripLabel %></button>
          <button class="btn btn-primary btn-sm start-trip-btn" data-trip-type="drop"><i class="fas fa-moon"></i> Start <%= dropTripLabel %></button>
        <% } else { %>
          <a href="/driver/live-trip" class="btn btn-primary btn-sm"><i class="fas fa-route"></i> Go to Live Trip</a>
        <% } %>
        <a href="/driver/vehicle" class="btn btn-secondary btn-sm"><i class="fas fa-clipboard-check"></i> Vehicle Checklist</a>
        <a href="/driver/transport/report-issue" class="btn btn-secondary btn-sm"><i class="fas fa-triangle-exclamation"></i> Report Issue</a>
        <button id="btnShareLocation" class="btn btn-secondary btn-sm" data-active-trip-id="<%= activeTrip ? activeTrip.id : '' %>"><i class="fas fa-location-arrow"></i> Share Location</button>
      </div>
    </div>
  </div>

  <!-- Trip Summary (If trip is active) -->
  <% if (activeTrip) { %>
    <div class="d-card" style="margin-bottom: 24px;">
      <div class="d-card-head" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
        <div class="d-card-title">
          <div class="d-section-icon"><i class="fas fa-route" style="color:#ea580c;"></i></div>
          <span style="font-weight: 700;">Active Trip In Progress</span>
        </div>
        <span class="trip-active-pill" style="background:#d1fae5;color:#065f46;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:700;text-transform:uppercase;">Running</span>
      </div>
      <div class="d-card-body" style="padding: 20px;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
          <div>
            <div style="font-size: 14px; font-weight: 700; color: #1e293b;"><%= labelTransportTrip(activeTrip) %></div>
            <div style="font-size: 12px; color: #64748b; margin-top: 4px;">
              Route: <%= activeTrip.routeName || driver.routeName %> &middot; 
              Onboarded: <%= pickedUpCount %> &middot; 
              Dropped: <%= droppedCount %> &middot; 
              Total Assigned: <%= totalStudents %>
            </div>
          </div>
          <div>
            <a href="/driver/live-trip" class="btn btn-primary" style="padding: 10px 24px;"><i class="fas fa-eye mr-1"></i> Open Live Trip View</a>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Bottom section: Timeline Notices (if exists) -->
  <% if (typeof notices !== 'undefined' && notices.length > 0) { %>
    <div class="d-card notices-widget">
      <div class="d-card-head">
        <div class="d-card-title">
          <div class="d-section-icon"><i class="fas fa-bullhorn"></i></div>
          <span>Important Announcements</span>
        </div>
      </div>
      <div class="d-card-body p-0">
        <div class="notices-timeline">
          <% notices.slice(0, 3).forEach(n => { %>
            <div class="notice-timeline-item">
              <div class="notice-dot"></div>
              <div class="notice-item-content">
                <h4 class="notice-item-title"><%= n.title %></h4>
                <span class="notice-item-date"><%= n.created_at ? new Date(n.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) : '' %></span>
                <% if (n.message) { %>
                  <p class="notice-item-body"><%= n.message.substring(0,120) %><%= n.message.length > 120 ? '…' : '' %></p>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    updateClock();
    setInterval(updateClock, 1000);

    const dateDisplay = document.getElementById("currentDate");
    if (dateDisplay) {
      dateDisplay.textContent = new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    }

    // Start Trip Buttons
    document.querySelectorAll('.start-trip-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        startTrip(btn.dataset.tripType, btn);
      });
    });

    // Share Location button
    document.getElementById('btnShareLocation')?.addEventListener('click', function () {
      const activeTripId = this.dataset.activeTripId || '';
      if (!activeTripId) {
        showToast("Start a trip and open Live Trip to share live location.", "warning");
        return;
      }
      if (!navigator.geolocation) {
        showToast("Geolocation not supported by your browser.", "error");
        return;
      }
      const btn = this;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sharing...';
      
      navigator.geolocation.getCurrentPosition(
        async pos => {
          const speed = pos.coords.speed && pos.coords.speed > 0 ? pos.coords.speed * 3.6 : 0;
          try {
            const response = await fetch('/driver/transport/location', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({
                trip_id: activeTripId,
                latitude: pos.coords.latitude,
                longitude: pos.coords.longitude,
                speed,
                heading: pos.coords.heading || null,
                accuracy: pos.coords.accuracy || null
              })
            });
            const data = await response.json();
            if (data.success) {
              showToast("Location sharing successful", "success");
            } else {
              showToast(data.message || "Failed to share location", "error");
            }
          } catch (err) {
            console.error(err);
            showToast("Connection failure", "error");
          } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-location-arrow"></i> Share Location';
          }
        },
        err => {
          showToast("Location sharing failed: " + err.message, "error");
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-location-arrow"></i> Share Location';
        },
        { enableHighAccuracy: true, timeout: 8000 }
      );
    });
  });

  function updateClock() {
    const clockDisplay = document.getElementById("liveClock");
    if (clockDisplay) {
      clockDisplay.textContent = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
  }

  const DRIVER_ROUTE_SHIFT = '<%= driverRouteShift %>';

  async function startTrip(tripType, btn) {
    const originalHtml = btn ? btn.innerHTML : '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Starting…';
    }

    try {
      const response = await fetch("/driver/trips/start", {
        method: "POST",
        headers: { "Content-Type": "application/json", "Accept": "application/json" },
        body: JSON.stringify({ trip_type: tripType, trip_shift: DRIVER_ROUTE_SHIFT })
      });
      const data = await response.json();
      if (data.success) {
        showToast(data.message, "success");
        setTimeout(() => window.location.href = "/driver/live-trip", 1000);
      } else {
        showToast(data.message || "Failed to start trip", "error");
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      }
    } catch (err) {
      console.error(err);
      showToast("Server connection failure", "error");
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    }
  }

  function triggerSOS() {
    if (!confirm('EMERGENCY: Are you sure you want to broadcast an SOS alert? This will immediately notify school administrators and dispatch help to your location.')) return;

    const btn = document.querySelector('.btn-sos');
    const originalHtml = btn ? btn.innerHTML : '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending…';
    }

    const sendSOS = (lat, lng) => {
      fetch('/driver/sos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ lat, lng })
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          showToast('🚨 SOS Alert sent! Help is on the way. Stay calm.', 'error', 8000);
        } else {
          showToast(data.message || 'SOS failed to send.', 'error', 5000);
        }
      })
      .catch(() => showToast('SOS failed — check your internet connection.', 'error', 5000))
      .finally(() => {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalHtml;
        }
      });
    };

    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        pos => sendSOS(pos.coords.latitude, pos.coords.longitude),
        ()  => sendSOS(null, null),
        { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
      );
    } else {
      sendSOS(null, null);
    }
  }
</script>

<style>
  @media (max-width: 480px) {
    .driver > div:first-child > div {
      align-items: flex-start !important;
    }
    .driver > div:first-child > div > div:last-child {
      width: 100%;
      flex-direction: column;
      align-items: stretch !important;
    }
    #liveClock,
    .btn-sos {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
    .d-card-body > div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
    }
    .d-card-body > div[style*="border-top"] .btn,
    .d-card-body > div[style*="border-top"] button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
