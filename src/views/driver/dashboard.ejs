<%  const driverRouteShift=(typeof driver !=='undefined' && driver && driver.routeShift) ? driver.routeShift : 'full_day';
    const driverShiftLabel=driverRouteShift==='morning' ? (lan.Morning_School || 'Morning School') : (driverRouteShift==='evening'
    ? (lan.Evening_School || 'Evening School') : (lan.Full_Day_School || 'Full Day School') );
    const pickupTripLabel=driverRouteShift==='evening' ? (lan.Evening_Pickup || 'Evening Pickup')
    : (lan.Morning_Pickup || 'Morning Pickup') ;
    const dropTripLabel=driverRouteShift==='morning' ? (lan.Morning_Drop || 'Morning Drop') : (lan.Evening_Drop || 'Evening Drop') ;
    const labelTransportTrip=(trip)=> {
        const shift = trip && (trip.trip_shift || trip.tripShift) ? (trip.trip_shift || trip.tripShift) : driverRouteShift;
        if (shift === 'morning') return trip && trip.trip_type === 'drop' ? (lan.Morning_Drop || 'Morning Drop') : (lan.Morning_Pickup || 'Morning Pickup');
        if (shift === 'evening') return trip && trip.trip_type === 'drop' ? (lan.Evening_Drop || 'Evening Drop') : (lan.Evening_Pickup || 'Evening Pickup');
        return trip && trip.trip_type === 'drop' ? (lan.Evening_Drop || 'Evening Drop') : (lan.Morning_Pickup || 'Morning Pickup');
    };
