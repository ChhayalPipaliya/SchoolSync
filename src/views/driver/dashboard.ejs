                        <div style="font-size: 11px; color: var(--text-muted); font-weight: 700; margin-top: 4px;"><%- lan.On_Time_Rate %></div>
                    </div>
                    <div style="text-align: center; padding: 14px; background: #fef3c7; border-radius: 12px;">
                        <div class="stat-number" style="color: #92400e; font-size: 22px;">4.8<span style="font-size: 14px;">/5</span></div>
                        <div style="font-size: 11px; color: var(--text-muted); font-weight: 700; margin-top: 4px;"><%- lan.Safety_Score %></div>
                    </div>
                    <div style="text-align: center; padding: 14px; background: #eff6ff; border-radius: 12px;">
                        <div class="stat-number" style="color: #1d4ed8; font-size: 20px;"><%= totalStudents || 0 %></div>
                        <div style="font-size: 11px; color: var(--text-muted); font-weight: 700; margin-top: 4px;"><%- lan.Students_Assigned %></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="dash-card">
            <div class="dash-card-head">
                <div class="dash-card-title">
                    <div class="dash-card-icon" style="background: #f0fdf4; color: #16a34a;"><i class="fas fa-calendar-check"></i></div>
                    <%- lan.Todays_Schedule %>
                </div>
                <span style="font-size: 11px; font-weight: 700; color: var(--text-muted);" id="scheduleDate"></span>
            </div>
            <div class="dash-card-body" style="display: flex; flex-direction: column; gap: 10px;">
                <% 
                    const pickupStatusClass = pickupTripStatus?.status === 'running' ? 'status-running-pickup' : (pickupTripStatus?.status === 'completed' ? 'status-completed-pickup' : 'status-default-pickup');
                    const pickupBadgeClass = pickupTripStatus?.status === 'running' ? 'badge-success' : (pickupTripStatus?.status === 'completed' ? 'badge-completed' : 'badge-muted');
                %>
                <div class="trip-status-card <%= pickupStatusClass %>">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-sun" style="color: var(--warning); font-size: 18px;"></i>
                        <div>
                            <div style="font-size: 13px; font-weight: 800; color: var(--text);"><%= pickupTripLabel %></div>
                            <div style="font-size: 11px; color: var(--text-muted);"><%- lan.Route %>: <%= driver.routeName || '—' %></div>
                        </div>
                    </div>
                    <span class="trip-badge <%= pickupBadgeClass %>">
                        <%= (pickupTripStatus?.status || 'not started' ).toUpperCase() %>
                    </span>
                </div>
                <% 
                    const dropStatusClass = dropTripStatus?.status === 'running' ? 'status-running-drop' : 'status-default-drop';
                    const dropBadgeClass = dropTripStatus?.status === 'running' ? 'badge-purple' : 'badge-muted';
                %>
                <div class="trip-status-card <%= dropStatusClass %>">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-moon" style="color: #6366f1; font-size: 18px;"></i>
                        <div>
                            <div style="font-size: 13px; font-weight: 800; color: var(--text);"><%= dropTripLabel %></div>
                            <div style="font-size: 11px; color: var(--text-muted);"><%- lan.Route_Stops || 'Stops' %>: <%= routeStops.length || 0 %></div>
                        </div>
                    </div>
                    <span class="trip-badge <%= dropBadgeClass %>">
                        <%= (dropTripStatus?.status || 'not started' ).toUpperCase() %>
                    </span>
                </div>
                <div class="trip-status-card <%= checklistDone ? 'checklist-done' : 'checklist-pending' %>">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-clipboard-check checklist-icon-status <%= checklistDone ? 'done' : 'pending' %>" style="font-size: 18px;"></i>
                        <div>
                            <div style="font-size: 13px; font-weight: 800; color: var(--text);"><%- lan.Vehicle_Checklist %></div>
                            <div style="font-size: 11px; color: var(--text-muted);"><%= driver.vehicleNumber || 'Bus' %></div>
                        </div>
                    </div>
                    <a href="/driver/vehicle" class="trip-badge <%= checklistDone ? 'badge-completed' : 'badge-warning' %>" style="text-decoration: none;">
                        <%= checklistDone ? 'DONE ✓' : (lan.Pending).toUpperCase() %>
                    </a>
                </div>
                <% if (!activeTrip && !activeTransportTrip) { %>
                    <div style="display: flex; gap: 8px; margin-top: 4px;">
                        <button class="start-trip-btn" data-trip-type="pickup" style="flex: 1; background: linear-gradient(135deg, #ea580c, #c2410c); color: #fff; border: none; padding: 10px; border-radius: 12px; font-size: 13px; font-weight: 800; cursor: pointer;"><i class="fas fa-sun mr-1"></i> <%- lan.Start || 'Start' %> <%= pickupTripLabel %></button>
                        <button class="start-trip-btn" data-trip-type="drop" style="flex: 1; background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; border: none; padding: 10px; border-radius: 12px; font-size: 13px; font-weight: 800; cursor: pointer;"><i class="fas fa-moon mr-1"></i> <%- lan.Start || 'Start' %> <%= dropTripLabel %></button>
                    </div>
                <% } else { %>
                    <a href="/driver/live-trip" style="background: linear-gradient(135deg, #ea580c, #c2410c); color: #fff; border: none; padding: 12px; border-radius: 12px; font-size: 14px; font-weight: 800; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 4px;">
                        <i class="fas fa-route"></i> <%- lan.Open_Live_Trip_View %>
                    </a>
                <% } %>
            </div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-card-title">
                        <div class="dash-card-icon" style="background: #ede9fe; color: #7c3aed;"><i class="fas fa-calendar-alt"></i></div>
                        <%- lan.Last_30_Days_Trip_History %>
                    </div>
                </div>
                <div class="dash-card-body">
                    <div style="display: flex; gap: 8px; justify-content: flex-start; flex-wrap: wrap; max-height: 220px; overflow-y: auto; padding-right: 4px;">
                        <% 
                            const today30 = new Date();
                            const dayNames = [lan.Sun, lan.Mon, lan.Tue, lan.Wed, lan.Thu, lan.Fri, lan.Sat];
                            
                            function formatLocalDateStr(dObj) {
                                const y = dObj.getFullYear();
                                const m = String(dObj.getMonth() + 1).padStart(2, '0');
                                const d = String(dObj.getDate()).padStart(2, '0');
                                return `${y}-${m}-${d}`;
                            }

                            for (let i = 29; i >= 0; i--) {
                                const d = new Date(today30);
                                d.setDate(today30.getDate() - i);
                                const dayName = dayNames[d.getDay()];
                                const dayNum = d.getDate();
                                const isToday = (i === 0);
                                const dateStr = formatLocalDateStr(d);

                                const dayTrips = (typeof recentTrips !== 'undefined' && recentTrips) ?
                                    recentTrips.filter(t => {
                                        const tStr = t.trip_date_str || (t.trip_date ? String(t.trip_date).split('T')[0] : '');
                                        return tStr === dateStr;
                                    }) : [];

                                const pickupTrip = dayTrips.find(t => t.trip_type === 'pickup');
                                const dropTrip = dayTrips.find(t => t.trip_type === 'drop');
                                const pickupDone = pickupTrip && pickupTrip.status === 'completed';
                                const dropDone = dropTrip && dropTrip.status === 'completed';
                                const isRunning = dayTrips.some(t => t.status === 'running' || t.status === 'in_progress');
                                const hasIssue = dayTrips.some(t => ['cancelled','issue'].includes(t.status));
                                const hasDelayed = dayTrips.some(t => t.status === 'delayed');
                                let dotClass = isToday ? 'cal-dot-today' : 'cal-dot-gray';
                                let tooltip = isToday ? 'Today: Scheduled' : 'No trip';

                                if (pickupDone && dropDone) {
                                    dotClass = 'cal-dot-green';
                                    tooltip = 'Full Day Completed (Pickup & Drop)';
                                } else if (pickupDone && !dropDone) {
                                    dotClass = 'cal-dot-yellow';
                                    tooltip = 'Pickup Done (Drop Pending)';
                                } else if (dropDone && !pickupDone) {
                                    dotClass = 'cal-dot-yellow';
                                    tooltip = 'Drop Done (Pickup Pending)';
                                } else if (isRunning) {
                                    dotClass = 'cal-dot-yellow';
                                    tooltip = 'In Progress';
                                } else if (hasDelayed) {
                                    dotClass = 'cal-dot-yellow';
                                    tooltip = 'Delayed';
                                } else if (hasIssue) {
                                    dotClass = 'cal-dot-red';
                                    tooltip = 'Issue Reported';
                                } else if (dayTrips.length > 0) {
                                    if (dayTrips.every(t => t.status === 'completed')) {
                                        dotClass = 'cal-dot-green';
                                        tooltip = 'Completed';
                                    } else {
                                        dotClass = 'cal-dot-yellow';
                                        tooltip = 'In Progress';
                                    }
                                }
                        %>
                            <div class="cal-day-dot <%= dotClass %>" title="<%= dateStr %>: <%= tooltip %>" style="width: 38px; height: 38px;">
                                <span style="font-size: 9px; opacity: 0.75;"><%= dayName %></span>
                                <span style="font-size: 12px; font-weight: 900;"><%= dayNum %></span>
                            </div>
                        <% } %>
                    </div>
                    <div style="display: flex; gap: 12px; margin-top: 14px; flex-wrap: wrap;">
                        <span style="display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: #065f46;"><span style="width: 10px; height: 10px; background: #34d399; border-radius: 3px; display: inline-block;"></span> <%- lan.Full_Day_Completed %></span>
                        <span style="display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: #92400e;"><span style="width: 10px; height: 10px; background: #fbbf24; border-radius: 3px; display: inline-block;"></span> <%- lan.Pickup_Done_In_Progress %></span>
                        <span style="display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: #991b1b;"><span style="width: 10px; height: 10px; background: #f87171; border-radius: 3px; display: inline-block;"></span> <%- lan.Issue %></span>
                        <span style="display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: var(--text-muted);"><span style="width: 10px; height: 10px; background: var(--text-secondary); border-radius: 3px; display: inline-block;"></span> <%- lan.No_Trip %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <div class="dash-card">
            <div class="dash-card-head">
                <div class="dash-card-title">
                    <div class="dash-card-icon" style="background: #f0fdf4; color: #16a34a;"><i class="fas fa-bolt"></i></div>
                    <%- lan.Quick_Actions %>
                </div>
            </div>
            <div class="dash-card-body" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <a href="/driver/students" style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 10px; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; text-decoration: none; color: var(--text); font-size: 12px; font-weight: 700; transition: all 0.2s;">
                    <i class="fas fa-users" style="font-size: 22px; color: #ea580c;"></i><%- lan.Students %>
                </a>
                <a href="/driver/vehicle" style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 10px; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; text-decoration: none; color: var(--text); font-size: 12px; font-weight: 700; transition: all 0.2s;">
                    <i class="fas fa-clipboard-check" style="font-size: 22px; color: #16a34a;"></i><%- lan.Checklist %>
                </a>
                <a href="/driver/chat" style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 10px; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; text-decoration: none; color: var(--text); font-size: 12px; font-weight: 700; transition: all 0.2s;">
                    <i class="fas fa-comments" style="font-size: 22px; color: #6366f1;"></i><%- lan.Chat %>
                </a>
                <a href="/driver/leaves/apply" style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 10px; background: var(--bg); border: 1px solid var(--border); border-radius: 14px; text-decoration: none; color: var(--text); font-size: 12px; font-weight: 700; transition: all 0.2s;">
                    <i class="fas fa-calendar-xmark" style="font-size: 22px; color: var(--warning);"></i><%- lan.Apply_Leave %>
                </a>
                <a href="/driver/transport/report-issue" style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 10px; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 14px; text-decoration: none; color: #991b1b; font-size: 12px; font-weight: 700; transition: all 0.2s;">
                    <i class="fas fa-triangle-exclamation" style="font-size: 22px; color: var(--danger);"></i><%- lan.Report_Issue %>
                </a>
                <button id="btnShareLocation" data-active-trip-id="<%= activeTrip ? activeTrip.id : (activeTransportTrip ? activeTransportTrip.id : '') %>" style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 10px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 14px; color: #1d4ed8; font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s;">
                    <i class="fas fa-location-arrow" style="font-size: 22px;"></i><%- lan.Share_Location %>
                </button>
            </div>
        </div>
        <% if (routeStops && routeStops.length> 0) { %>
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-card-title">
                        <div class="dash-card-icon" style="background: #fff7ed; color: #ea580c;"><i class="fas fa-map-marked-alt"></i></div>
                        <%- lan.Route_Stops %> (<%= routeStops.length %>)
                    </div>
                    <a href="/driver/live-trip" style="font-size: 11px; font-weight: 700; color: #ea580c; text-decoration: none;"><%- lan.View_Map %> →</a>
                </div>
                <div style="max-height: 220px; overflow-y: auto;">
                    <% routeStops.slice(0, 8).forEach((stop, idx)=> { %>
                        <div style="display: flex; align-items: center; gap: 12px; padding: 10px 20px; border-bottom: 1px solid var(--bg);">
                            <div style="width: 26px; height: 26px; background: #fff7ed; color: #ea580c; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 900; flex-shrink: 0; border: 1.5px solid #ffedd5;">
                                <%= idx + 1 %>
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div style="font-size: 13px; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <%= stop.stop_name || stop.name || 'Stop ' + (idx+1) %>
                                </div>
                                <div style="font-size: 11px; color: var(--text-muted);">
                                    <%= stop.student_count || 0 %> student(s) · <%= stop.arrival_time || '' %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                    <% if (routeStops.length> 8) { %>
                        <div style="padding: 10px 20px; text-align: center; font-size: 12px; color: var(--text-muted); font-weight: 700;">
                            + <%= routeStops.length - 8 %> more stops
                        </div>
                    <% } %>
                </div>
            </div>
        <% } %>
        <% if (typeof recentTrips !=='undefined' && recentTrips && recentTrips.length> 0) { %>
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-card-title">
                        <div class="dash-card-icon" style="background: #ede9fe; color: #7c3aed;"><i class="fas fa-history"></i></div> <%- lan.Recent_Trips %>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column;">
                    <% recentTrips.slice(0, 5).forEach(t=> {
                        const st = t.status || 'completed';
                        const tripD = t.trip_date_formatted || (t.trip_date ? new Date(t.trip_date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '');
                        const badgeStatusClass = st === 'completed' ? 'completed' : (st === 'running' ? 'running' : 'default');
                    %>
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; border-bottom: 1px solid var(--bg);">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-<%= t.trip_type === 'drop' ? 'moon' : 'sun' %> trip-type-icon <%= t.trip_type === 'drop' ? 'drop' : 'pickup' %>"></i>
                                <div>
                                    <div style="font-size: 13px; font-weight: 700; color: var(--text);"><%= t.trip_type==='drop' ? (lan.Drop || 'Drop') : (lan.Pickup || 'Pickup') %> · <%= tripD %></div>
                                    <div style="font-size: 11px; color: var(--text-muted);"><%= t.route_name || driver.routeName || 'Route' %></div>
                                </div>
                            </div>
                            <span class="recent-trip-badge <%= badgeStatusClass %>"><%= st %></span>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>
    <% if (typeof notices !=='undefined' && notices.length> 0) { %>
        <div class="dash-card" style="margin-bottom: 22px;">
            <div class="dash-card-head">
                <div class="dash-card-title">
                    <div class="dash-card-icon" style="background: #fef3c7; color: #d97706;"><i class="fas fa-bullhorn"></i></div>
                    <%- lan.Announcements_Notices %>
                </div>
            </div>
            <div class="dash-card-body" style="display: flex; flex-direction: column; gap: 10px;">
                <% notices.slice(0, 3).forEach(n=> { %>
                    <div style="padding: 12px 14px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; border-left: 4px solid var(--warning);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; flex-wrap: wrap;">
                            <h4 style="font-size: 13px; font-weight: 800; color: var(--text); margin: 0;"><%= n.title %></h4>
                            <span style="font-size: 10px; color: var(--text-muted); font-weight: 600; flex-shrink: 0;">
                                <%= n.created_at ? new Date(n.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) : '' %>
                            </span>
                        </div>
                        <% if (n.message) { %>
                            <p style="font-size: 12px; color: var(--text-secondary); margin: 4px 0 0; line-height: 1.5;">
                                <%= n.message.substring(0, 120) %>
                                <%= n.message.length> 120 ? '…' : '' %>
                            </p>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>
</div>
<div id="dashSosCategoryModal" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.75); backdrop-filter: blur(4px); z-index: 99999; display: none; align-items: center; justify-content: center; padding: 16px;">
    <div style="background: var(--surface); border-radius: 24px; max-width: 500px; width: 100%; padding: 26px; box-shadow: 0 20px 40px rgba(220,38,38,0.3); text-align: center; border: 3px solid var(--danger);">
        <div style="background: #fef2f2; width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; border: 3px solid #fca5a5;">
            <i class="fas fa-exclamation-triangle" style="font-size: 28px; color: var(--danger);"></i>
        </div>
        <h2 style="font-size: 22px; font-weight: 900; color: var(--text); margin: 0 0 6px;"><%- lan.Select_Emergency_Type %></h2>
        <p style="font-size: 13px; color: var(--text-muted); margin: 0 0 20px;"><%- lan.Emergency_Category_Desc %></p>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px;">
            <button onclick="triggerDashSosCategory('accident')" style="background: #fef2f2; border: 2px solid #fca5a5; color: #991b1b; padding: 18px 12px; border-radius: 16px; font-weight: 800; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; min-height: 90px;">
                <i class="fas fa-car-crash" style="font-size: 26px; color: var(--danger);"></i>
                🚨 <%- lan.Accident %><br><small style="font-weight: 600; opacity: 0.8; font-size: 11px;"><%- lan.Vehicle_Collision %></small>
            </button>
            <button onclick="triggerDashSosCategory('breakdown')" style="background: #fff7ed; border: 2px solid #fed7aa; color: #9a3412; padding: 18px 12px; border-radius: 16px; font-weight: 800; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; min-height: 90px;">
                <i class="fas fa-wrench" style="font-size: 26px; color: #ea580c;"></i>
                🔧 <%- lan.Breakdown %><br><small style="font-weight: 600; opacity: 0.8; font-size: 11px;"><%- lan.Engine_Tire_Issue %></small>
            </button>
            <button onclick="triggerDashSosCategory('medical')" style="background: #eff6ff; border: 2px solid #bfdbfe; color: #1e40af; padding: 18px 12px; border-radius: 16px; font-weight: 800; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; min-height: 90px;">
                <i class="fas fa-notes-medical" style="font-size: 26px; color: #2563eb;"></i>
                🏥 <%- lan.Medical %><br><small style="font-weight: 600; opacity: 0.8; font-size: 11px;"><%- lan.Health_Emergency %></small>
            </button>
            <button onclick="triggerDashSosCategory('hazard')" style="background: var(--bg); border: 2px solid var(--text-secondary); color: var(--text-secondary); padding: 18px 12px; border-radius: 16px; font-weight: 800; font-size: 14px; display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; min-height: 90px;">
                <i class="fas fa-road-barrier" style="font-size: 26px; color: var(--text-secondary);"></i>
                🚧 <%- lan.Route_Hazard %><br><small style="font-weight: 600; opacity: 0.8; font-size: 11px;"><%- lan.Road_Blocked %></small>
            </button>
        </div>
        <button onclick="closeDashSosCategoryModal()" style="background: var(--surface-hover); border: none; color: var(--text-secondary); font-weight: 800; padding: 10px 20px; border-radius: 10px; cursor: pointer; width: 100%;">
            <%- lan.Cancel %>
        </button>
    </div>
</div>
<script>
    const DRIVER_ROUTE_SHIFT = '<%= driverRouteShift %>';

    document.addEventListener('DOMContentLoaded', () => {
        updateClock();
        setInterval(updateClock, 1000);
        const dateEl = document.getElementById('currentDate');
        if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        const schEl = document.getElementById('scheduleDate');
        if (schEl) schEl.textContent = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });

        const tripStartAt = '<%= activeTransportTrip && activeTransportTrip.start_at ? activeTransportTrip.start_at : (activeTrip && activeTrip.start_at ? activeTrip.start_at : "") %>';
        if (tripStartAt) {
            const startTs = new Date(tripStartAt).getTime();
            setInterval(() => {
                const elapsed = Math.floor((Date.now() - startTs) / 1000);
                const h = Math.floor(elapsed / 3600);
                const m = Math.floor((elapsed % 3600) / 60);
                const s = elapsed % 60;
                const dur = document.getElementById('tripDurationDisplay');
                if (dur) dur.textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
            }, 1000);
        };

        document.querySelectorAll('.start-trip-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                startTrip(btn.dataset.tripType, btn);
            });
        });

        document.getElementById('btnShareLocation')?.addEventListener('click', function () {
            const activeTripId = this.dataset.activeTripId || '';
            if (!activeTripId) { showToast('Start a trip first to share live location.', 'warning'); return; }
            if (!navigator.geolocation) { showToast('Geolocation not supported.', 'error'); return; }
            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            navigator.geolocation.getCurrentPosition(
                async pos => {
                    try {
                        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || document.querySelector('input[name="_csrf"]')?.value || '';
                        const r = await fetch('/driver/transport/location', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json', 
                                'Accept': 'application/json',
                                'X-CSRF-Token': csrfToken
                            },
                            body: JSON.stringify({ 
                                trip_id: activeTripId, 
                                latitude: pos.coords.latitude, 
                                longitude: pos.coords.longitude, 
                                speed: pos.coords.speed ? pos.coords.speed * 3.6 : 0,
                                _csrf: csrfToken
                            })
                        });
                        const d = await r.json();
                        showToast(d.success ? 'Location shared!' : (d.message || 'Failed'), d.success ? 'success' : 'error');
                    } catch (_) { 
                        showToast('Connection failure', 'error'); 
                    }
                    finally { btn.disabled = false; btn.innerHTML = '<i class="fas fa-location-arrow" style="font-size: 22px;"></i>Share Location'; };
                },
                err => { 
                    showToast('Location error: ' + err.message, 'error'); 
                    btn.disabled = false; 
                    btn.innerHTML = '<i class="fas fa-location-arrow" style="font-size: 22px;"></i>Share Location'; 
                },
                { enableHighAccuracy: true, timeout: 8000 }
            );
        });
        fetchWeather();
    });

    function updateClock() {
        const el = document.getElementById('liveClock');
        if (el) el.textContent = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    };

    async function startTrip(tripType, btn) {
        const origHtml = btn ? btn.innerHTML : '';
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Starting…'; }
        try {
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || document.querySelector('input[name="_csrf"]')?.value || '';
            const r = await fetch('/driver/trips/start', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'Accept': 'application/json',
                    'X-CSRF-Token': csrfToken
                },
                body: JSON.stringify({ trip_type: tripType, trip_shift: DRIVER_ROUTE_SHIFT, _csrf: csrfToken })
            });

            const d = await r.json();
            if (d.success) {
                showToast(d.message, 'success');
                setTimeout(() => window.location.href = '/driver/live-trip', 800);
            } else {
                if (d.checklistFailed) {
                    const modal = document.getElementById('checklistBlockedModal');
                    const msgEl = document.getElementById('checklistBlockedMsg');
                    if (modal && msgEl) {
                        msgEl.textContent = d.message;
                        modal.style.display = 'flex';
                    } else {
                        showToast(d.message || 'Checklist failed. Contact administration.', 'error');
                    };
                } else {
                    showToast(d.message || 'Failed to start trip', 'error');
                };
                if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
            };
        } catch (_) {
            showToast('Server connection failure', 'error');
            if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
        };
    };

    let dashSosHoldTimer = null, dashSosCount = 3;
    function startDashSosHold(e) {
        if (e && e.preventDefault && e.type === 'touchstart') e.preventDefault();
        dashSosCount = 3;
        const btn = document.getElementById('dashSosBtn');
        if (btn) btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> HOLD: 3s';
        dashSosHoldTimer = setInterval(() => {
            dashSosCount--;
            if (btn) btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> HOLD: ${dashSosCount}s`;
            if (dashSosCount <= 0) {
                clearInterval(dashSosHoldTimer);
                dashSosHoldTimer = null;
                if (btn) btn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> SOS';
                openDashSosCategoryModal();
            };
        }, 1000);
    };

    function cancelDashSosHold() {
        if (dashSosHoldTimer) {
            clearInterval(dashSosHoldTimer);
            dashSosHoldTimer = null;
            const btn = document.getElementById('dashSosBtn');
            if (btn) btn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> SOS';
        };
    };

    function openDashSosCategoryModal() { document.getElementById('dashSosCategoryModal').style.display = 'flex'; }
    function closeDashSosCategoryModal() { document.getElementById('dashSosCategoryModal').style.display = 'none'; }

    function triggerDashSosCategory(alertType) {
        closeDashSosCategoryModal();
        const tripId = '<%= (activeTransportTrip || activeTrip) ? ((activeTransportTrip || activeTrip).id) : "" %>';
        const send = (lat, lng) => {
        fetch('/driver/sos/trigger', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ alert_type: alertType, latitude: lat, longitude: lng, trip_id: tripId || null })
        })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    showToast('🚨 SOS Emergency Triggered! Help is on the way.', 'error', 5000);
                    if (d.redirectUrl) setTimeout(() => window.location.href = d.redirectUrl, 800);
                } else {
                    showToast(d.message || 'SOS activation failed', 'error');
                };
            })
            .catch(() => showToast('Server connection failure', 'error'));
        };
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                pos => send(pos.coords.latitude, pos.coords.longitude),
                () => send(null, null),
                { enableHighAccuracy: true, timeout: 5000 }
            );
        } else { send(null, null); }
    };

    async function fetchWeather() {
        try {
            if (!navigator.geolocation) return;
            navigator.geolocation.getCurrentPosition(async pos => {
                const { latitude: lat, longitude: lng } = pos.coords;
                const r = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current_weather=true`);
                const d = await r.json();
                const wc = d.current_weather;
                if (!wc) return;

                const tempEl = document.getElementById('weatherTemp');
                const descEl = document.getElementById('weatherDesc');
                const iconEl = document.getElementById('weatherIcon');
                const adviceEl = document.getElementById('weatherAdvice');
                const locEl = document.getElementById('weatherLocation');

                if (tempEl) tempEl.textContent = Math.round(wc.temperature) + '°C';

                const code = wc.weathercode;
                let icon = '☀️', desc = 'Clear Sky', advice = 'Great weather for driving! Stay alert.';
                if (code === 0) { icon = '☀️'; desc = 'Clear Sky'; advice = 'Great visibility. Safe driving!'; }
                else if (code <= 3) { icon = '⛅'; desc = 'Partly Cloudy'; advice = 'Good conditions. Stay alert.'; }
                else if (code <= 49) { icon = '🌫️'; desc = 'Foggy'; advice = '⚠️ Low visibility! Slow down and use headlights.'; }
                else if (code <= 67) { icon = '🌧️'; desc = 'Rainy'; advice = '⚠️ Wet roads! Reduce speed and increase following distance.'; }
                else if (code <= 77) { icon = '❄️'; desc = 'Snowfall'; advice = '🛑 Icy conditions! Drive extremely carefully.'; }
                else if (code <= 82) { icon = '🌦️'; desc = 'Rain Showers'; advice = '⚠️ Slippery roads! Drive cautiously.'; }
                else { icon = '⛈️'; desc = 'Thunderstorm'; advice = '🛑 Storm warning! Consider delaying the trip.'; }

                if (iconEl) iconEl.textContent = icon;
                if (descEl) descEl.textContent = desc;
                if (adviceEl) adviceEl.innerHTML = `<i class="fas fa-shield-alt mr-1"></i> ${advice}`;
                if (locEl) locEl.textContent = `${lat.toFixed(2)}°N, ${lng.toFixed(2)}°E · Windspeed: ${wc.windspeed} km/h`;
            }, () => { }, { enableHighAccuracy: false, timeout: 5000 });
        } catch (_) { }
    };
</script>

<div id="checklistBlockedModal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.75); z-index:9999; align-items:center; justify-content:center; padding:16px;">
  <div style="background:var(--surface); max-width:440px; width:100%; border-radius:16px; padding:24px; box-shadow:0 20px 25px -5px rgba(0,0,0,0.1); border:2px solid #ef4444; text-align:center;">
    <div style="width:56px; height:56px; background:#fef2f2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; color:var(--danger); font-size:24px;">
      <i class="fas fa-triangle-exclamation"></i>
    </div>
    <h3 style="font-size:18px; font-weight:800; color:var(--text); margin-bottom:8px;"><%- lan.Trip_Blocked_Checklist_Failure %></h3>
    <p id="checklistBlockedMsg" style="font-size:13px; color:var(--text-muted); line-height:1.5; margin-bottom:20px;"></p>
    <div style="background:#fff1f2; border:1px solid #fecdd3; border-radius:10px; padding:12px; font-size:12px; color:#9f1239; margin-bottom:20px; font-weight:600;">
      <i class="fas fa-headset mr-1"></i> <%- lan.Please_Contact_Admin_Vehicle_Inspection %>
    </div>
    <button onclick="document.getElementById('checklistBlockedModal').style.display='none'" style="width:100%; background:var(--text); color:var(--surface); font-weight:700; border:none; padding:12px; border-radius:10px; cursor:pointer;">
      <%- lan.Understood %>
    </button>
  </div>
</div>