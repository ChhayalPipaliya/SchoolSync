      <span class="tl-stat-icon tl-total"><i class="fas fa-file-lines"></i></span>
      <div>
        <p><%- lan.Total_Applied %></p>
        <strong><%= safeStats.total || 0 %></strong>
      </div>
    </div>
    <div class="tl-stat">
      <span class="tl-stat-icon tl-pending"><i class="fas fa-hourglass-half"></i></span>
      <div>
        <p><%- lan.Pending %></p>
        <strong><%= safeStats.pending || 0 %></strong>
      </div>
    </div>
    <div class="tl-stat">
      <span class="tl-stat-icon tl-approved"><i class="fas fa-check"></i></span>
      <div>
        <p><%- lan.Approved %></p>
        <strong><%= safeStats.approved || 0 %></strong>
      </div>
    </div>
    <div class="tl-stat">
      <span class="tl-stat-icon tl-days"><i class="fas fa-calendar-day"></i></span>
      <div>
        <p><%- lan.Approved_Days %></p>
        <strong><%= totalApprovedDays %></strong>
      </div>
    </div>
  </div>
  <div class="tl-panel">
    <div class="tl-panel-header">
      <div>
        <h5><%- lan.Leave_History %></h5>
        <p><%= (leaves || []).length %> <%- lan.Applications_Found %></p>
      </div>
      <button type="button" class="btn-new-request" onclick="openLeaveModal()">
        <i class="fas fa-paper-plane"></i>
        <%- lan.New_Request %>
      </button>
    </div>
    <% if (leaves && leaves.length > 0) { %>
      <div class="tl-leave-list">
        <% leaves.forEach(leave => {
          const status = statusMeta[leave.status] || statusMeta.pending;
          const type = typeMeta[leave.leave_type] || typeMeta.other;
        %>
          <article class="tl-leave-card">
            <div class="tl-leave-main">
              <div class="tl-type-icon">
                <i class="fas <%= type.icon %>"></i>
              </div>
              <div class="tl-leave-copy">
                <div class="tl-leave-topline">
                  <span class="tl-type"><%= type.label %></span>
                  <span class="tl-status <%= status.cls %>">
                    <i class="fas <%= status.icon %>"></i>
                    <%= status.label %>
                  </span>
                </div>
                <h6>
                  <%= new Date(leave.from_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  <span><%- lan.To %></span>
                  <%= new Date(leave.to_date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </h6>
                <p title="<%= leave.reason %>"><%= leave.reason %></p>
                <% if (leave.status === 'rejected' && leave.rejection_reason) { %>
                  <div class="tl-note tl-note-danger">
                    <i class="fas fa-circle-info"></i>
                    <%= leave.rejection_reason %>
                  </div>
                <% } else if ((leave.status === 'approved' || leave.status === 'rejected') && leave.approver_first_name) { %>
                  <div class="tl-note">
                    <i class="fas fa-user-check"></i>
                    <%- lan.Reviewed_By %> <%= leave.approver_first_name %> <%= leave.approver_last_name || '' %>
                  </div>
                <% } %>
              </div>
            </div>
            <div class="tl-leave-side">
              <strong><%= leave.days %></strong>
              <span><%= Number(leave.days) === 1 ? (lan.Day || 'Day') : (lan.Days || 'Days') %></span>
              <small><%- lan.Applied %> <%= new Date(leave.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %></small>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="tl-empty">
        <i class="fas fa-calendar-plus"></i>
        <h5><%- lan.No_Leave_Applications_Yet %></h5>
        <p><%- lan.No_Leave_Applications_Desc %></p>
        <button type="button" class="btn-empty-apply" onclick="openLeaveModal()">
          <i class="fas fa-plus"></i> <%- lan.Apply_Leave %>
        </button>
      </div>
    <% } %>
  </div>
  <div class="tl-leave-modal" id="applyLeaveModal">
    <div style="position: absolute; inset: 0;" onclick="closeLeaveModal()"></div>
    <div class="tl-modal">
      <div class="modal-header">
        <div>
          <span style="font-size: 11px; font-weight: 800; color: #ea580c; text-transform: uppercase; letter-spacing: 0.05em; display: block;"><%- lan.New_Request %></span>
          <h5 class="modal-title"><%- lan.Apply_For_Leave %></h5>
        </div>
        <button type="button" onclick="closeLeaveModal()" style="border: none; background: none; font-size: 22px; cursor: pointer; color: #94a3b8; line-height: 1;">&times;</button>
      </div>
      <form action="/<%= user.role %>/leaves/apply" method="POST" id="leaveApplyForm">
        <div class="modal-body">
          <label class="tl-field">
            <span><%- lan.Leave_Type %></span>
            <select id="leave_type" name="leave_type" required>
              <option value="casual"><%- lan.Casual_Leave %></option>
              <option value="sick"><%- lan.Sick_Leave %></option>
              <option value="emergency"><%- lan.Emergency_Leave %></option>
              <option value="other"><%- lan.Other_Special_Leave %></option>
            </select>
          </label>
          <div class="tl-date-grid">
            <label class="tl-field">
              <span><%- lan.From_Date %></span>
              <input type="date" id="from_date" name="from_date" required>
            </label>
            <label class="tl-field">
              <span><%- lan.To_Date %></span>
              <input type="date" id="to_date" name="to_date" required>
            </label>
          </div>
          <div class="tl-days-preview" id="leaveDaysPreview"><%- lan.Select_Dates_Calculate_Days %></div>
          <label class="tl-field">
            <span><%- lan.Reason %></span>
            <textarea id="reason" name="reason" rows="4" maxlength="500" placeholder="<%- lan.Leave_Reason_Placeholder %>" required></textarea>
          </label>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeLeaveModal()" style="background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-weight: 700; padding: 9px 18px; border-radius: 8px; cursor: pointer;"><%- lan.Cancel %></button>
          <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #ea580c, #c2410c); color: #fff; border: none; font-weight: 800; padding: 9px 20px; border-radius: 8px; cursor: pointer;"><%- lan.Submit_Application %></button>
        </div>
      </form>
    </div>
  </div>
</div>
<script>
  function openLeaveModal() {
    const modal = document.getElementById('applyLeaveModal');
    if (modal) modal.style.display = 'flex';
  }

  function closeLeaveModal() {
    const modal = document.getElementById('applyLeaveModal');
    if (modal) modal.style.display = 'none';
  }

  (function () {
    const modal = document.getElementById('applyLeaveModal');
    if (modal && modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const fromInput = document.getElementById('from_date');
    const toInput = document.getElementById('to_date');
    const preview = document.getElementById('leaveDaysPreview');
    const form = document.getElementById('leaveApplyForm');
    const limitDate = new Date();
    limitDate.setDate(limitDate.getDate() - 30);
    const limitStr = limitDate.getFullYear() + '-' +
      String(limitDate.getMonth() + 1).padStart(2, '0') + '-' +
      String(limitDate.getDate()).padStart(2, '0');

    if (fromInput) fromInput.min = limitStr;
    if (toInput) toInput.min = limitStr;

    function updatePreview() {
      if (!fromInput || !toInput || !preview) return;
      if (fromInput.value) toInput.min = fromInput.value;
      if (!fromInput.value || !toInput.value) {
        preview.textContent = 'Select dates to calculate total leave days.';
        return;
      }

      const from = new Date(fromInput.value + 'T00:00:00');
      const to = new Date(toInput.value + 'T00:00:00');
      const days = Math.round((to - from) / 86400000) + 1;
      if (days <= 0) {
        preview.textContent = 'To date must be same as or after from date.';
        return;
      }
      preview.textContent = days + ' leave day' + (days === 1 ? '' : 's') + ' selected.';
    }

    fromInput?.addEventListener('change', updatePreview);
    toInput?.addEventListener('change', updatePreview);
    form?.addEventListener('submit', function (event) {
      updatePreview();
      if (fromInput.value && toInput.value && toInput.value < fromInput.value) {
        event.preventDefault();
        alert('To date must be same as or after from date.');
      }
    });
  })();
</script>