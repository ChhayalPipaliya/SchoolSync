<div class="support-container">
  <div class="card">
    <div class="support-header">
      <h2><i class="fas fa-headset"></i> <%- lan.How_Can_We_Help %></h2>
      <p><%- lan.Support_Subtitle %></p>
    </div>
    <div class="support-grid">
      <div class="support-card">
        <div class="support-icon"><i class="fas fa-road"></i></div>
        <h4><%- lan.Route_Issues %></h4>
        <p><%- lan.Route_Issues_Desc %></p>
        <button class="btn btn-outline"><%- lan.Report_Hazard %></button>
      </div>
      <div class="support-card">
        <div class="support-icon"><i class="fas fa-mobile-alt"></i></div>
        <h4><%- lan.App_Support %></h4>
        <p><%- lan.App_Support_Desc %></p>
        <button class="btn btn-outline"><%- lan.Get_Tech_Help %></button>
      </div>
      <div class="support-card">
        <div class="support-icon"><i class="fas fa-user-shield"></i></div>
        <h4><%- lan.Student_Conduct %></h4>
        <p><%- lan.Student_Conduct_Desc %></p>
        <button class="btn btn-outline"><%- lan.Log_Incident %></button>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header">
      <h3><i class="fas fa-ticket-alt"></i> <%- lan.Submit_Support_Ticket %></h3>
    </div>
    <form class="support-form">
      <div class="form-row">
        <div class="form-group">
          <label><%- lan.Issue_Category %></label>
          <select class="form-input">
            <option><%- lan.Route_Problem %></option>
            <option><%- lan.Vehicle_Breakdown %></option>
            <option><%- lan.App_Login %></option>
            <option><%- lan.Student_Issue %></option>
            <option><%- lan.Other %></option>
          </select>
        </div>
        <div class="form-group">
          <label><%- lan.Priority %></label>
          <select class="form-input">
            <option><%- lan.Low %></option>
            <option><%- lan.Medium %></option>
            <option><%- lan.High %></option>
            <option><%- lan.Urgent %></option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label><%- lan.Subject %></label>
        <input type="text" class="form-input" placeholder="<%= lan.Brief_Subject_Placeholder %>">
      </div>
      <div class="form-group">
        <label><%- lan.Detailed_Description %></label>
        <textarea class="form-input" rows="4" placeholder="<%= lan.Describe_Issue_Placeholder %>"></textarea>
      </div>
      <button type="submit" class="btn btn-primary"><%- lan.Submit_Ticket %></button>
    </form>
  </div>
  <div class="card contact-card">
    <h4><i class="fas fa-phone-alt"></i> <%- lan.Direct_Contact %></h4>
    <p><%- lan.Direct_Contact_Desc %></p>
    <div class="contact-info">
      <p><strong><%- lan.Office_Hours %>:</strong> <%- lan.Office_Hours_Time %></p>
      <p><strong><%- lan.Emergency %>:</strong> +91 99999 99999</p>
    </div>
  </div>
</div>