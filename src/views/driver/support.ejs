<div class="support-container">
  <div class="card">
    <div class="support-header">
      <h2><i class="fas fa-headset"></i> How can we help?</h2>
      <p>Access instant support, report vehicle issues, or contact dispatch for immediate assistance during your route.</p>
    </div>
    <div class="support-grid">
      <div class="support-card">
        <div class="support-icon"><i class="fas fa-road"></i></div>
        <h4>Route Issues</h4>
        <p>Road closures, detours, or permanent route change requests.</p>
        <button class="btn btn-outline">Report Hazard</button>
      </div>
      <div class="support-card">
        <div class="support-icon"><i class="fas fa-mobile-alt"></i></div>
        <h4>App Support</h4>
        <p>Troubleshooting GPS, login issues, or attendance syncing.</p>
        <button class="btn btn-outline">Get Tech Help</button>
      </div>
      <div class="support-card">
        <div class="support-icon"><i class="fas fa-user-shield"></i></div>
        <h4>Student Conduct</h4>
        <p>Reporting behavioral incidents or seating chart guidelines.</p>
        <button class="btn btn-outline">Log Incident</button>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header">
      <h3><i class="fas fa-ticket-alt"></i> Submit a Support Ticket</h3>
    </div>
    <form class="support-form">
      <div class="form-row">
        <div class="form-group">
          <label>Issue Category</label>
          <select class="form-input">
            <option>Route Problem</option>
            <option>Vehicle Breakdown</option>
            <option>App / Login</option>
            <option>Student Issue</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label>Priority</label>
          <select class="form-input">
            <option>Low</option>
            <option>Medium</option>
            <option>High</option>
            <option>Urgent</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Subject</label>
        <input type="text" class="form-input" placeholder="Brief subject...">
      </div>
      <div class="form-group">
        <label>Detailed Description</label>
        <textarea class="form-input" rows="4" placeholder="Describe your issue..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Submit Ticket</button>
    </form>
  </div>
  <div class="card contact-card">
    <h4><i class="fas fa-phone-alt"></i> Direct Contact</h4>
    <p>Immediate help for breakdowns or emergencies.</p>
    <div class="contact-info">
      <p><strong>Office Hours:</strong> Mon-Sat: 8 AM - 6 PM</p>
      <p><strong>Emergency:</strong> +91 99999 99999</p>
    </div>
  </div>
</div>