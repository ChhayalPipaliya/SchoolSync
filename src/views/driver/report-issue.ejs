<style>
  .report-issue-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }

  .report-issue-label {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .report-issue-input,
  .report-issue-select,
  .report-issue-textarea {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    font-size: 13.5px;
    color: #1e293b;
    background: #fafbff;
    outline: none;
    transition: all 0.2s ease;
  }

  .report-issue-input:focus,
  .report-issue-select:focus,
  .report-issue-textarea:focus {
    border-color: #ea580c;
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
    background: #ffffff;
  }

  .report-issue-help {
    font-size: 12px;
    color: #64748b;
    margin-top: 4px;
    display: block;
  }

  .btn-report-cancel {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    font-weight: 700;
    padding: 10px 24px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s ease;
  }

  .btn-report-cancel:hover {
    background: #e2e8f0;
    color: #1e293b;
  }

  /* DARK MODE STYLES */
  [data-theme="dark"] .report-issue-card,
  .light-mode-disabled .report-issue-card {
    background: #151d30 !important;
    border-color: #242f4d !important;
    color: #f1f5f9 !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important;
  }

  [data-theme="dark"] .report-issue-label,
  .light-mode-disabled .report-issue-label {
    color: #94a3b8 !important;
  }

  [data-theme="dark"] .report-issue-input,
  [data-theme="dark"] .report-issue-select,
  [data-theme="dark"] .report-issue-textarea,
  .light-mode-disabled .report-issue-input,
  .light-mode-disabled .report-issue-select,
  .light-mode-disabled .report-issue-textarea {
    background: #101726 !important;
    border-color: #242f4d !important;
    color: #f1f5f9 !important;
    color-scheme: dark;
  }

  [data-theme="dark"] .report-issue-input:focus,
  [data-theme="dark"] .report-issue-select:focus,
  [data-theme="dark"] .report-issue-textarea:focus,
  .light-mode-disabled .report-issue-input:focus,
  .light-mode-disabled .report-issue-select:focus,
  .light-mode-disabled .report-issue-textarea:focus {
    border-color: #ea580c !important;
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.25) !important;
    background: #151d30 !important;
  }

  [data-theme="dark"] .report-issue-help,
  .light-mode-disabled .report-issue-help {
    color: #94a3b8 !important;
  }

  [data-theme="dark"] .btn-report-cancel,
  .light-mode-disabled .btn-report-cancel {
    background: #1e293b !important;
    border-color: #334155 !important;
    color: #cbd5e1 !important;
  }

  [data-theme="dark"] .btn-report-cancel:hover,
  .light-mode-disabled .btn-report-cancel:hover {
    background: #334155 !important;
    color: #f1f5f9 !important;
  }
</style>

<div class="driver-header-section mb-4">
  <div>
    <h1 class="driver-page-title text-2xl font-extrabold" style="color: var(--driver-text, #0f172a); margin: 0;">Report Transport Issue</h1>
    <p class="driver-page-subtitle text-sm" style="color: var(--driver-muted, #64748b); margin: 4px 0 0;">Send route, vehicle, student, or delay issues to transport admin</p>
  </div>
</div>
<div>
  <div class="report-issue-card">
    <div style="background: linear-gradient(135deg, #dc2626 0%, #ea580c 100%); padding: 20px 24px; color: #ffffff;">
      <div style="display: flex; align-items: center; gap: 14px;">
        <div style="width: 44px; height: 44px; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px;">⚠️</div>
        <div>
          <span style="font-size: 18px; font-weight: 800; display: block;">Issue Details</span>
          <p style="font-size: 13px; opacity: 0.88; margin: 2px 0 0;">Please provide complete information</p>
        </div>
      </div>
    </div>
    <div style="padding: 24px;">
      <form method="POST" action="/driver/transport/report-issue" class="space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-4">
          <div>
            <label class="report-issue-label">Issue Type *</label>
            <select class="report-issue-select" name="alertType" required>
              <option value="vehicle">🚗 Vehicle</option>
              <option value="route">🛣️ Route</option>
              <option value="student">👦 Student</option>
              <option value="delay">⏰ Delay</option>
              <option value="driver">👨‍✈️ Driver</option>
              <option value="other">📌 Other</option>
            </select>
          </div>
          <div>
            <label class="report-issue-label">Severity *</label>
            <select class="report-issue-select" name="severity" required>
              <option value="normal">🟡 Normal</option>
              <option value="high">🟠 High</option>
              <option value="urgent">🔴 Urgent</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-4">
          <div>
            <label class="report-issue-label">Related To</label>
            <select class="report-issue-select" name="relatedType">
              <option value="">None</option>
              <option value="vehicle">Vehicle</option>
              <option value="route">Route</option>
              <option value="student">Student</option>
              <option value="trip">Trip</option>
            </select>
          </div>
          <div>
            <label class="report-issue-label">Related ID</label>
            <input type="number" class="report-issue-input" name="relatedId" min="1" placeholder="e.g. 45678">
          </div>
        </div>
        <div class="mb-4">
          <label class="report-issue-label">Issue Title *</label>
          <input type="text" class="report-issue-input" name="title" maxlength="180" required placeholder="Short and clear title...">
        </div>
        <div class="mb-4">
          <label class="report-issue-label">Detailed Description *</label>
          <textarea class="report-issue-textarea" name="message" rows="5" required placeholder="Please explain the issue in detail..."></textarea>
        </div>
        <div class="mb-4">
          <label class="report-issue-label">Attachment (Optional)</label>
          <input type="file" class="report-issue-input" name="attachment" accept="image/*,video/*,.pdf">
          <small class="report-issue-help">You can attach photo, video or document</small>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 12px; padding-top: 16px; border-top: 1px solid var(--driver-border, #e2e8f0);" class="report-issue-footer">
          <a href="/driver/dashboard" class="btn-report-cancel">Cancel</a>
          <button type="submit" class="btn btn-danger" style="background: linear-gradient(135deg, #dc2626, #b91c1c); color: #fff; font-weight: 700; padding: 10px 24px; border-radius: 10px; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fas fa-paper-plane"></i>
            Submit Issue
          </button>
        </div>
      </form>
    </div>
  </div>
</div>