<div class="driver-page-body">
  <div class="driver-header-section">
    <div>
      <h1 class="driver-page-title">Report Transport Issue</h1>
      <p class="driver-page-subtitle">Send route, vehicle, student, or delay issues to transport admin</p>
    </div>
    <div class="driver-topbar-actions">
      <a href="/driver/dashboard" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Dashboard</a>
    </div>
  </div>

  <div class="d-card">
    <div class="d-card-head">
      <div class="d-card-title">
        <div class="d-section-icon"><i class="fas fa-triangle-exclamation"></i></div>
        <span>Issue Details</span>
      </div>
    </div>
    <div class="d-card-body">
      <form method="POST" action="/driver/transport/report-issue" class="row g-3">
        <div class="col-md-6">
          <label class="form-label small fw-bold text-muted text-uppercase">Issue Type</label>
          <select class="form-control" name="alertType" required>
            <option value="vehicle">Vehicle</option>
            <option value="route">Route</option>
            <option value="student">Student</option>
            <option value="delay">Delay</option>
            <option value="driver">Driver</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-bold text-muted text-uppercase">Severity</label>
          <select class="form-control" name="severity" required>
            <option value="normal">Normal</option>
            <option value="high">High</option>
            <option value="urgent">Urgent</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-bold text-muted text-uppercase">Related Type</label>
          <select class="form-control" name="relatedType">
            <option value="">None</option>
            <option value="vehicle">Vehicle</option>
            <option value="route">Route</option>
            <option value="student">Student</option>
            <option value="trip">Trip</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-bold text-muted text-uppercase">Related ID</label>
          <input class="form-control" type="number" name="relatedId" min="1" placeholder="Optional">
        </div>
        <div class="col-12">
          <label class="form-label small fw-bold text-muted text-uppercase">Title</label>
          <input class="form-control" name="title" maxlength="180" required placeholder="Short issue title">
        </div>
        <div class="col-12">
          <label class="form-label small fw-bold text-muted text-uppercase">Message</label>
          <textarea class="form-control" name="message" rows="5" required placeholder="Describe what happened"></textarea>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2">
          <a href="/driver/dashboard" class="btn btn-secondary">Cancel</a>
          <button class="btn btn-primary" type="submit"><i class="fas fa-paper-plane"></i> Submit Issue</button>
        </div>
      </form>
    </div>
  </div>
</div>
