<div class="driver-header-section">
  <div>
    <h1 class="driver-page-title">Report Transport Issue</h1>
    <p class="driver-page-subtitle">Send route, vehicle, student, or delay issues to transport admin</p>
  </div>
  <a href="/driver/dashboard" class="btn btn-secondary">
    <i class="fas fa-arrow-left"></i> Back to Dashboard
  </a>
</div>

<divww>
  <div class="d-card shadow-lg border-0 rounded-3 overflow-hidden">
    <!-- Card Header -->
    <div class="d-card-head bg-gradient-to-r from-red-600 to-orange-600 text-white p-4">
      <div class="d-card-title flex items-center gap-3">
        <div class="w-10 h-10 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center text-2xl">
          ⚠️
        </div>
        <div>
          <span class="text-xl font-semibold">Issue Details</span>
          <p class="text-sm text-white/80">Please provide complete information</p>
        </div>
      </div>
    </div>

    <!-- Card Body -->
    <div class="d-card-body p-5">
      <form method="POST" action="/driver/transport/report-issue" class="space-y-5">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Issue Type -->
          <div>
            <label class="form-label small fw-bold text-muted text-uppercase tracking-widest">Issue Type</label>
            <select class="form-control form-select" name="alertType" required>
              <option value="vehicle">🚗 Vehicle</option>
              <option value="route">🛣️ Route</option>
              <option value="student">👦 Student</option>
              <option value="delay">⏰ Delay</option>
              <option value="driver">👨‍✈️ Driver</option>
              <option value="other">📌 Other</option>
            </select>
          </div>

          <!-- Severity -->
          <div>
            <label class="form-label small fw-bold text-muted text-uppercase tracking-widest">Severity</label>
            <select class="form-control form-select" name="severity" required>
              <option value="normal">🟡 Normal</option>
              <option value="high">🟠 High</option>
              <option value="urgent">🔴 Urgent</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Related Type -->
          <div>
            <label class="form-label small fw-bold text-muted text-uppercase tracking-widest">Related To</label>
            <select class="form-control form-select" name="relatedType">
              <option value="">None</option>
              <option value="vehicle">Vehicle</option>
              <option value="route">Route</option>
              <option value="student">Student</option>
              <option value="trip">Trip</option>
            </select>
          </div>

          <!-- Related ID -->
          <div>
            <label class="form-label small fw-bold text-muted text-uppercase tracking-widest">Related ID</label>
            <input type="number" class="form-control" name="relatedId" min="1" placeholder="e.g. 45678">
          </div>
        </div>

        <!-- Title -->
        <div>
          <label class="form-label small fw-bold text-muted text-uppercase tracking-widest">Issue Title</label>
          <input type="text" class="form-control" name="title" maxlength="180" required 
                 placeholder="Short and clear title...">
        </div>

        <!-- Message -->
        <div>
          <label class="form-label small fw-bold text-muted text-uppercase tracking-widest">Detailed Description</label>
          <textarea class="form-control" name="message" rows="6" required 
                    placeholder="Please explain the issue in detail..."></textarea>
        </div>

        <!-- Optional Attachment -->
        <div>
          <label class="form-label small fw-bold text-muted text-uppercase tracking-widest">Attachment (Optional)</label>
          <input type="file" class="form-control" name="attachment" accept="image/*,video/*,.pdf">
          <small class="text-muted">You can attach photo, video or document</small>
        </div>

        <!-- Buttons -->
        <div class="flex justify-end gap-3 pt-4">
          <a href="/driver/dashboard" class="btn btn-secondary px-5">Cancel</a>
          <button type="submit" class="btn btn-danger px-6 flex items-center gap-2">
            <i class="fas fa-paper-plane"></i>
            Submit Issue
          </button>
        </div>
      </form>
    </div>
  </div>
</div>