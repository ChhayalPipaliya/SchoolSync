  --dp-border: #242F4D;
  --dp-orange-light: rgba(255, 107, 0, 0.15);
  --dp-orange-border: rgba(255, 107, 0, 0.3);
  --dp-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  --dp-shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.5);
}
</style>
<div class="dp-wrap">
  <div class="dp-hero">
    <div class="dp-hero-deco dp-hero-deco-1"></div>
    <div class="dp-hero-deco dp-hero-deco-2"></div>
    <div class="dp-hero-deco dp-hero-deco-3"></div>
    <div class="dp-hero-content">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; align-items: center;">
        <div class="dp-hero-user-block" style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
          <div class="dp-avatar-container">
            <% if (avatar) { %>
              <img src="<%= avatar %>" class="dp-profile-photo" alt="Driver Profile">
            <% } else { %>
              <div class="dp-photo-placeholder"><%= driverInitials %></div>
            <% } %>
            <div class="dp-upload-overlay" data-bs-toggle="modal" data-bs-target="#editPhotoModal" title="<%= typeof lan !== 'undefined' && lan.Upload_Photo ? lan.Upload_Photo : 'Upload Photo' %>">
              <i class="fas fa-camera"></i>
            </div>
          </div>
          <div>
            <div class="dp-hero-badges-block" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 8px;">
              <span class="dp-badge dp-role-badge"><%- lan.Senior_Driver %></span>
              <span class="dp-badge dp-status-badge <%= driver.status !== 'active' ? 'inactive' : '' %>">
                <span class="dot"></span><%= esc(driver.status).toUpperCase() %>
              </span>
            </div>
            <h2 class="dp-hero-name"><%= driver.first_name %> <%= driver.last_name %></h2>
            <div style="color: rgba(255, 255, 255, 0.75); font-size: 14px;">
              ID: #<%= driver.id %> <span style="margin: 0 4px;">•</span> <%- lan.Joined %>: <%= fmt(driver.created_at) %>
            </div>
          </div>
        </div>
        <div class="dp-hero-divider-col" style="border-left: 1px solid rgba(255, 255, 255, 0.2); padding-left: 24px;">
          <div class="dp-hero-info-grid">
            <div class="dp-hero-info-item">
              <div class="dp-hero-info-icon"><i class="fas fa-phone-alt"></i></div>
              <div>
                <div class="dp-hero-info-label"><%- lan.Phone %></div>
                <div class="dp-hero-info-val"><%= esc(driver.phone) %></div>
              </div>
            </div>
            <div class="dp-hero-info-item">
              <div class="dp-hero-info-icon"><i class="fas fa-envelope"></i></div>
              <div>
                <div class="dp-hero-info-label"><%- lan.Email %></div>
                <div class="dp-hero-info-val" style="word-break: break-all;"><%= esc(driver.email) %></div>
              </div>
            </div>
            <div class="dp-hero-info-item">
              <div class="dp-hero-info-icon"><i class="fas fa-map-marker-alt"></i></div>
              <div>
                <div class="dp-hero-info-label"><%- lan.Address %></div>
                <div class="dp-hero-info-val"><%= esc(driver.address) %></div>
              </div>
            </div>
          </div>
        </div>
        <div class="dp-hero-actions-col" style="display: flex; flex-direction: column; gap: 8px; align-items: stretch; max-width: 240px; justify-self: end;">
          <button class="dp-hero-btn dp-btn-white" data-bs-toggle="modal" data-bs-target="#editProfileModal">
            <i class="fas fa-user-edit"></i> <%- lan.Edit_Profile %>
          </button>
          <button class="dp-hero-btn dp-btn-glass" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
            <i class="fas fa-key"></i> <%- lan.Change_Password %>
          </button>
          <button class="dp-hero-btn dp-btn-glass" data-bs-toggle="modal" data-bs-target="#idCardModal">
            <i class="fas fa-id-card"></i> <%- lan.Download_ID_Card %>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="dp-stats-grid">
    <div class="dp-stat-card">
      <div class="dp-stat-icon dp-icon-orange"><i class="fas fa-id-badge"></i></div>
      <div>
        <div class="dp-stat-label"><%- lan.License_Number %></div>
        <div class="dp-stat-val" id="licNumCopy" style="cursor: pointer;" onclick="copyLicense('<%= driver.license_number || driver.licenseNumber %>')" title="Click to Copy"><%= esc(driver.license_number || driver.licenseNumber) %></div>
      </div>
    </div>
    <div class="dp-stat-card">
      <div class="dp-stat-icon dp-icon-blue"><i class="fas fa-calendar-alt"></i></div>
      <div>
        <div class="dp-stat-label"><%- lan.License_Expiry %></div>
        <div class="dp-stat-val"><%= licExpiry ? fmt(licExpiry) : '—' %></div>
      </div>
    </div>
    <div class="dp-stat-card">
      <div class="dp-stat-icon dp-icon-green"><i class="fas fa-bus"></i></div>
      <div>
        <div class="dp-stat-label"><%- lan.Vehicle_Model %></div>
        <div class="dp-stat-val"><%= esc(driver.vehicleModel) %></div>
      </div>
    </div>
    <div class="dp-stat-card">
      <div class="dp-stat-icon dp-icon-purple"><i class="fas fa-users"></i></div>
      <div>
        <div class="dp-stat-label"><%- lan.Vehicle_Capacity %></div>
        <div class="dp-stat-val"><%= driver.capacity ? driver.capacity + ' ' + (lan.Seats || 'Seats') : (lan.None || 'N/A') %></div>
      </div>
    </div>
    <div class="dp-stat-card">
      <div class="dp-stat-icon dp-icon-green"><i class="fas fa-toggle-on"></i></div>
      <div>
        <div class="dp-stat-label"><%- lan.Driver_Status %></div>
        <div class="dp-stat-val text-capitalize"><%= esc(driver.status) %></div>
      </div>
    </div>
  </div>
  <div class="dp-tabs-scroller">
    <div class="dp-tabs">
      <button class="dp-tab-btn dp-active" id="dpt-overview" onclick="dpSwitchTab('overview')">
        <i class="fas fa-th-large"></i> <%- lan.Overview %>
      </button>
      <button class="dp-tab-btn" id="dpt-license" onclick="dpSwitchTab('license')">
        <i class="fas fa-id-card"></i> <%- lan.License_Details %>
      </button>
      <button class="dp-tab-btn" id="dpt-vehicle" onclick="dpSwitchTab('vehicle')">
        <i class="fas fa-shuttle-van"></i> <%- lan.Vehicle_Details %>
      </button>
      <button class="dp-tab-btn" id="dpt-documents" onclick="dpSwitchTab('documents')">
        <i class="fas fa-folder-open"></i> <%- lan.Documents %>
      </button>
      <button class="dp-tab-btn" id="dpt-emergency" onclick="dpSwitchTab('emergency')">
        <i class="fas fa-shield-alt"></i> <%- lan.Emergency_Contact %>
      </button>
      <button class="dp-tab-btn" id="dpt-work" onclick="dpSwitchTab('work')">
        <i class="fas fa-business-time"></i> <%- lan.Work_Shift %>
      </button>
      <button class="dp-tab-btn" id="dpt-activity" onclick="dpSwitchTab('activity')">
        <i class="fas fa-history"></i> <%- lan.Activity_Log %>
      </button>
    </div>
  </div>
  <div class="dp-panel dp-show" id="dp-panel-overview">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
      <div class="dp-card">
        <div class="dp-card-title"><i class="fas fa-user-circle"></i> <%- lan.Personal_Information %></div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Full_Name || 'Full Name' %></div>
          <div class="dp-info-val"><%= driver.first_name %> <%= driver.last_name %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Mobile_Number %></div>
          <div class="dp-info-val"><%= esc(driver.phone) %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Email %></div>
          <div class="dp-info-val"><%= esc(driver.email) %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Date_of_Birth %></div>
          <div class="dp-info-val"><%= fmt(driver.dob) %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Aadhar_Number %></div>
          <div class="dp-info-val"><%= esc(driver.aadhar_number) %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Emergency_Contact %></div>
          <div class="dp-info-val"><%= esc(driver.emergency_contact) %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Address %></div>
          <div class="dp-info-val"><%= esc(driver.address) %></div>
        </div>
      </div>
      <div class="dp-card">
        <div class="dp-card-title"><i class="fas fa-address-card"></i> <%- lan.License_Details %></div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.License_Number %></div>
          <div class="dp-info-val"><%= esc(driver.license_number || driver.licenseNumber) %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Expiry_Date %></div>
          <div class="dp-info-val"><%= licExpiry ? fmt(licExpiry) : '—' %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Status %></div>
          <div class="dp-info-val text-capitalize"><%= esc(driver.status) %></div>
        </div>
        <div class="dp-info-row">
          <div class="dp-info-label"><%- lan.Joined %></div>
          <div class="dp-info-val"><%= fmt(driver.created_at) %></div>
        </div>
        <% if (licExpiry) { %>
          <% if (isExpired) { %>
            <div class="dp-alert-card expired">
              <i class="fas fa-exclamation-circle"></i>
              <div><%- lan.License_Expired_Alert %></div>
            </div>
          <% } else { %>
            <div class="dp-alert-card valid">
              <i class="fas fa-check-circle"></i>
              <div><%- lan.License_Valid_Alert %></div>
            </div>
          <% } %>
        <% } %>
      </div>
      <div class="dp-card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="dp-card-title"><i class="fas fa-shuttle-van"></i> <%- lan.Vehicle_Information %></div>
          <% if (driver.vehicleNumber) { %>
            <div class="dp-info-row">
              <div class="dp-info-label"><%- lan.Vehicle_Number %></div>
              <div class="dp-info-val"><%= esc(driver.vehicleNumber) %></div>
            </div>
            <div class="dp-info-row">
              <div class="dp-info-label"><%- lan.Vehicle_Model %></div>
              <div class="dp-info-val"><%= esc(driver.vehicleModel) %></div>
            </div>
            <div class="dp-info-row">
              <div class="dp-info-label"><%- lan.Vehicle_Type %></div>
              <div class="dp-info-val text-capitalize"><%= esc(driver.vehicleType || (driver.capacity > 20 ? (lan.Bus || 'Bus') : (driver.capacity ? 'Mini Bus' : null))) %></div>
            </div>
            <div class="dp-info-row">
              <div class="dp-info-label"><%- lan.Capacity %></div>
              <div class="dp-info-val"><%= driver.capacity ? driver.capacity + ' ' + (lan.Seats || 'Seats') : '—' %></div>
            </div>
            <div class="dp-info-row">
              <div class="dp-info-label"><%- lan.Fuel_Type %></div>
              <div class="dp-info-val"><%= esc(driver.fuelType) %></div>
            </div>
            <div class="dp-info-row">
              <div class="dp-info-label"><%- lan.Insurance_Valid_Till %></div>
              <div class="dp-info-val"><%= driver.insuranceExpiry ? fmt(driver.insuranceExpiry) : '—' %></div>
            </div>
            <div class="dp-info-row">
              <div class="dp-info-label"><%- lan.Pollution_Valid_Till %></div>
              <div class="dp-info-val"><%= driver.pucExpiry ? fmt(driver.pucExpiry) : '—' %></div>
            </div>
          <% } else { %>
            <div class="dp-empty-state">
              <i class="fas fa-ban"></i>
              <p><%- lan.No_Vehicle_Assigned %></p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="dp-panel" id="dp-panel-license">
    <div class="dp-card">
      <div class="dp-card-title"><i class="fas fa-id-card"></i> <%- lan.License_Details %></div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
        <div>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.License_Number %></div>
            <div class="dp-info-val"><%= esc(driver.license_number || driver.licenseNumber) %></div>
          </div>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.Expiry_Date %></div>
            <div class="dp-info-val" style="font-weight: 700;"><%= licExpiry ? fmt(licExpiry) : '—' %></div>
          </div>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.Aadhar_Number %></div>
            <div class="dp-info-val"><%= esc(driver.aadhar_number) %></div>
          </div>
        </div>
        <div>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.Status %></div>
            <div class="dp-info-val" style="color: var(--dp-success); font-weight: 700;">
              <i class="fas fa-shield-alt" style="margin-right: 4px;"></i> <%= esc(driver.status).toUpperCase() %>
            </div>
          </div>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.Joining_Date %></div>
            <div class="dp-info-val"><%= fmt(driver.created_at) %></div>
          </div>
        </div>
      </div>
      <div class="bg-light" style="padding: 16px; border-radius: 8px; border: 1px solid var(--dp-border); margin-top: 24px;">
        <h5 class="dp-title-font" style="margin: 0 0 8px; color: var(--dp-text); font-size: 15px;"><i class="fas fa-info-circle text-orange" style="margin-right: 8px;"></i><%- lan.School_Transport_Compliance_Info %></h5>
        <p style="font-size: 13px; color: var(--dp-muted); margin: 0; line-height: 1.6;">
          <%- lan.Transport_Compliance_Note %>
        </p>
      </div>
    </div>
  </div>
  <div class="dp-panel" id="dp-panel-vehicle">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
      <div class="dp-card">
        <div class="dp-card-title"><i class="fas fa-bus"></i> <%- lan.Vehicle_Details %></div>
        <% if (driver.vehicleNumber) { %>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
            <div>
              <div class="dp-info-row">
                <div class="dp-info-label"><%- lan.Vehicle_Number %></div>
                <div class="dp-info-val"><%= esc(driver.vehicleNumber) %></div>
              </div>
              <div class="dp-info-row">
                <div class="dp-info-label"><%- lan.Vehicle_Model %></div>
                <div class="dp-info-val"><%= esc(driver.vehicleModel) %></div>
              </div>
              <div class="dp-info-row">
                <div class="dp-info-label"><%- lan.Vehicle_Type %></div>
                <div class="dp-info-val text-capitalize"><%= esc(driver.vehicleType || (driver.capacity > 20 ? (lan.Bus || 'Standard Bus') : (driver.capacity ? 'Mini Transport Van' : null))) %></div>
              </div>
              <div class="dp-info-row">
                <div class="dp-info-label"><%- lan.Fuel_Type %></div>
                <div class="dp-info-val"><%= esc(driver.fuelType) %></div>
              </div>
            </div>
            <div>
              <div class="dp-info-row">
                <div class="dp-info-label"><%- lan.Vehicle_Capacity %></div>
                <div class="dp-info-val"><%= driver.capacity ? driver.capacity + ' ' + (lan.Seats || 'Seats') : '—' %></div>
              </div>
              <div class="dp-info-row">
                <div class="dp-info-label"><%- lan.Registration_Number %></div>
                <div class="dp-info-val"><%= esc(driver.registrationNumber || driver.vehicleNumber) %></div>
              </div>
              <div class="dp-info-row">
                <div class="dp-info-label"><%- lan.GPS_Device_ID %></div>
                <div class="dp-info-val"><%= esc(driver.gpsDeviceId) %></div>
              </div>
            </div>
          </div>
          <div style="margin-top: 24px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
              <span style="font-size: 13px; font-weight: 700; color: var(--dp-text);"><%- lan.Vehicle_Capacity %></span>
              <span style="font-size: 13px; color: var(--dp-muted);"><%= driver.capacity || 0 %> <%- lan.Seats || 'Seats' %></span>
            </div>
            <div class="progress" style="height: 10px; border-radius: 100px; background-color: var(--dp-border);">
              <div class="progress-bar" role="progressbar" style="width: 100%; border-radius: 100px; background: linear-gradient(90deg, var(--dp-orange), #FF8C00);" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
          </div>
        <% } else { %>
          <div class="dp-empty-state">
            <i class="fas fa-ban"></i>
            <p><%- lan.No_Vehicle_Assigned %></p>
          </div>
        <% } %>
      </div>
      <div class="dp-card">
        <div class="dp-card-title"><i class="fas fa-file-contract"></i> <%- lan.Vehicle_Certifications %></div>
        <% if (driver.vehicleNumber) { %>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.Insurance_Valid_Till %></div>
            <div class="dp-info-val"><%= driver.insuranceExpiry ? fmt(driver.insuranceExpiry) : '—' %></div>
          </div>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.Pollution_Valid_Till %></div>
            <div class="dp-info-val"><%= driver.pucExpiry ? fmt(driver.pucExpiry) : '—' %></div>
          </div>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.Fitness_Certificate %></div>
            <div class="dp-info-val"><%= driver.fitnessExpiry ? fmt(driver.fitnessExpiry) : '—' %></div>
          </div>
          <div class="dp-info-row">
            <div class="dp-info-label"><%- lan.Permit_Valid_Till %></div>
            <div class="dp-info-val"><%= driver.permitExpiry ? fmt(driver.permitExpiry) : '—' %></div>
          </div>
        <% } else { %>
          <div class="dp-empty-state">
            <i class="fas fa-ban"></i>
            <p><%- lan.No_Vehicle_Assigned %></p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="dp-panel" id="dp-panel-documents">
    <div class="dp-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
        <div class="dp-card-title" style="margin: 0; border: none; padding: 0;"><i class="fas fa-folder-open"></i> <%- lan.Document_Management %></div>
      </div>
      <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
        <div class="dp-doc-grid">
          <% documents.forEach(function(doc) { %>
            <div class="dp-doc-card">
              <div class="dp-doc-icon"><i class="fas fa-file-alt"></i></div>
              <div class="dp-doc-info">
                <div class="dp-doc-name"><%= esc(doc.document_name || doc.document_type || 'Document') %></div>
                <div class="dp-doc-meta"><%= doc.document_type || 'PDF' %> • <%= fmt(doc.uploaded_at || doc.created_at) %></div>
                <div class="dp-doc-actions">
                  <% if (doc.file_url || doc.file_path) { %>
                    <a href="<%= doc.file_url || ('/uploads/' + doc.file_path) %>" target="_blank" class="dp-doc-btn dp-doc-btn-view" title="View"><i class="fas fa-eye"></i></a>
                    <a href="<%= doc.file_url || ('/uploads/' + doc.file_path) %>" download class="dp-doc-btn dp-doc-btn-download" title="Download"><i class="fas fa-download"></i></a>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="dp-empty-state" style="text-align: center; padding: 36px 0; color: var(--dp-muted);">
          <i class="fas fa-folder-open fa-3x" style="opacity: 0.3; margin-bottom: 12px; display: block;"></i>
          <p style="margin: 0; font-weight: 600;"><%- lan.No_Documents_Found %></p>
        </div>
      <% } %>
    </div>
  </div>
  <div class="dp-panel" id="dp-panel-emergency">
    <div class="dp-card" style="max-width: 650px; margin: 0 auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <div class="dp-card-title" style="margin: 0; border: none; padding: 0;"><i class="fas fa-shield-alt"></i> <%- lan.Emergency_Contact_Information %></div>
        <button class="btn btn-sm" style="border: 1px solid var(--dp-orange); color: var(--dp-orange); background: transparent; border-radius: 20px; padding: 4px 12px; font-weight: 600; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#editEmergencyModal"><i class="fas fa-edit" style="margin-right: 4px;"></i> <%- lan.Edit || 'Edit' %></button>
      </div>
      <div style="padding: 24px; border-radius: 12px; border: 1px solid var(--dp-orange-border); background-color: var(--dp-orange-light);">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;">
          <div>
            <div style="font-size: 11px; color: var(--dp-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;"><%- lan.Mobile_Number %></div>
            <div style="font-weight: 700; color: var(--dp-text); font-size: 16px; margin-bottom: 16px;">
              <% if (driver.emergency_contact) { %>
                <a href="tel:<%= driver.emergency_contact %>" style="text-decoration: none; color: var(--dp-text); display: flex; align-items: center; gap: 8px;">
                  <i class="fas fa-phone-alt text-orange"></i> <%= esc(driver.emergency_contact) %>
                </a>
              <% } else { %>
                —
              <% } %>
            </div>
            <div style="font-size: 11px; color: var(--dp-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;"><%- lan.Address %></div>
            <div style="color: var(--dp-text); font-weight: 600;"><%= esc(driver.address) %></div>
          </div>
          <div style="border-left: 1px solid var(--dp-orange-border); padding-left: 24px;">
            <div style="font-size: 11px; color: var(--dp-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.05em;"><%- lan.Phone %></div>
            <div style="font-weight: 700; color: var(--dp-text); font-size: 16px;">
              <%= esc(driver.phone) %>
