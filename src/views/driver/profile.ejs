<script>
function dpSwitchTab(name) {
  document.querySelectorAll('.dp-tab-btn').forEach(btn => btn.classList.remove('dp-active'));
  document.querySelectorAll('.dp-panel').forEach(panel => panel.classList.remove('dp-show'));

  const activeBtn = document.getElementById('dpt-' + name);
  const activePanel = document.getElementById('dp-panel-' + name);

  if (activeBtn) activeBtn.classList.add('dp-active');
  if (activePanel) activePanel.classList.add('dp-show');
};

function copyLicense(num) {
  navigator.clipboard.writeText(num).then(() => {
    alert("<%- lan.License_Number %> '" + num + "' <%- lan.Copied_To_Clipboard %>");
  }).catch(() => {
    alert("<%- lan.Failed_To_Copy %>");
  });
};

function uploadNewDocAlert() {
  alert("<%- lan.Upload_Document %>");
};

function previewDoc(name) {
  alert("<%- lan.View || 'View' %>: " + name);
};
function downloadDoc(name) {
  alert("<%- lan.Download || 'Download' %>: " + name);
};
function deleteDoc(name) {
  if (confirm("<%- lan.Delete || 'Delete' %> " + name + "?")) {
    alert("<%- lan.Delete || 'Deleted' %>: " + name);
  };
};
function contactManagerAlert() {
  alert("<%- lan.Contact_Transport_Manager %>: +91 79 2394 8201");
};

function changePasswordAlert() {
  const currentPassword = document.getElementById('pwdCurrent').value;
  const newPassword = document.getElementById('pwdNew').value;
  const confirmPassword = document.getElementById('pwdConfirm').value;
  if(!currentPassword || !newPassword || !confirmPassword) {
    alert("<%- lan.Fill_All_Fields %>");
    return;
  };
  if (newPassword !== confirmPassword) {
    alert("<%- lan.Passwords_Not_Match %>");
    return;
  };

  fetch('/driver/profile/update', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
  })
  .then(res => res.json().then(data => ({ status: res.status, data })))
  .then(({ status, data }) => {
    if (status === 200 && data.success) {
      alert(data.message || "<%- lan.Password_Success_Change %>");
      const modalElement = document.getElementById('changePasswordModal');
      const modal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
      if (modal) modal.hide();
      window.location.reload();
    } else {
      alert(data.message || "<%- lan.Password_Update_Failed %>");
    };
  })
  .catch(err => {
    console.error(err);
    alert("<%- lan.Error_Occurred %>");
  });
};


function printBadge() {
  const card = document.getElementById('printableIdCard').innerHTML;
  const original = document.body.innerHTML;
  
  document.body.innerHTML = `
    <html>
      <head>
        <title><%- lan.Print_ID_Card %></title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        <style>
          body { background: white; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
          .dp-id-card-view {
            width: 320px; border: 1px solid #FF6B00; border-radius: 16px; background: #ffffff; overflow: hidden;
          }
          .dp-id-card-header {
            background: linear-gradient(135deg, #FF6B00 0%, #FF8C00 100%); padding: 16px; text-align: center; color: #ffffff;
          }
          .dp-id-card-body { padding: 20px; text-align: center; }
          .dp-id-card-photo { width: 90px; height: 90px; border-radius: 50%; border: 3px solid #FF6B00; object-fit: cover; margin-bottom: 12px; }
          .dp-id-card-initials {
            width: 90px; height: 90px; border-radius: 50%; background: linear-gradient(135deg, #FFA500, #FF4500); color: #fff;
            display: flex; align-items: center; justify-content: center; font-size: 1.85rem; font-weight: 800; margin: 0 auto 12px;
          }
          .dp-id-card-barcode {
            background-image: repeating-linear-gradient(90deg, #1e293b, #1e293b 2px, transparent 2px, transparent 6px); height: 35px; width: 160px; margin: 15px auto 5px;
          }
          @media print {
            body { margin: 0; padding: 0; }
            .no-print { display: none; }
          }
        </style>
      </head>
      <body>
        <div class="dp-id-card-view">${card}</div>
        <script>
          window.onload = function() {
            window.print();
            setTimeout(() => { window.location.reload(); }, 500);
          }
        <\/script>
      </body>
    </html>
  `;
  window.print();
  
  setTimeout(() => {
    window.location.reload();
  }, 1000);
};
</script>