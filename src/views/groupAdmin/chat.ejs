<%
    function getAvatarBgColor(name) {
        if (!name) return '#6b7280';
        const char = name.trim().charAt(0).toUpperCase();
        const colorMap = {
            'A': '#10b981', 'B': '#8b5cf6', 'C': '#06b6d4', 'D': '#f97316', 'E': '#ef4444', 'F': '#e11d48', 'G': '#6366f1', 'H': '#14b8a6',
            'I': '#3b82f6', 'J': '#f59e0b', 'K': '#8b5cf6', 'L': '#10b981', 'M': '#ec4899', 'N': '#6366f1', 'O': '#f97316', 'P': '#14b8a6',
            'Q': '#8b5cf6', 'R': '#06b6d4', 'S': '#10b981', 'T': '#f59e0b', 'U': '#6366f1', 'V': '#ec4899', 'W': '#3b82f6', 'X': '#8b5cf6',
            'Y': '#f97316', 'Z': '#14b8a6'
        };
        return colorMap[char] || '#6b7280';
    }
%>
<div class="chat-container bg-white border border-slate-200 shadow-sm rounded-2xl overflow-hidden" id="chatContainer" data-user-id="<%= user.id %>" data-user-role="<%= user.role %>">
    <div class="flex w-full h-full overflow-hidden">
        <div class="contacts-sidebar border-r border-slate-200 h-full flex flex-col" id="contactsSidebar">
            <div class="p-3.5 md:p-4 border-b border-slate-200 bg-slate-50">
                <div class="flex items-center justify-between mb-2 md:mb-3">
                    <h5 class="m-0 text-slate-800 font-bold flex items-center gap-2 text-sm md:text-base">
                        <i class="fas fa-comments text-emerald-600"></i>Branch Admins
                    </h5>
                    <a href="/groupadmin/chat/broadcast" class="btn btn-xs bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg px-2.5 py-1 text-[11px] font-bold border-0 flex items-center gap-1 shadow-sm transition">
                        <i class="fa-solid fa-bullhorn text-[10px]"></i> Broadcast
                    </a>
                </div>
                <p class="text-slate-500 text-xs mt-1 mb-0">Select a branch school admin to chat</p>
                <div class="mt-2.5 md:mt-3 relative">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" class="w-full pl-9 pr-4 py-2 text-xs bg-white border border-slate-200 rounded-full focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" id="searchContacts" placeholder="Search branches or admins..." aria-label="Search branches or admins" oninput="filterContacts()">
                </div>
            </div>
            <div class="flex-grow overflow-y-auto p-2 space-y-1" id="contactsList">
                <% if (contacts && contacts.length > 0) { %>
                    <% contacts.forEach(contact => { %>
                        <% if (contact.admin_id) { 
                            const adminName = contact.first_name + ' ' + contact.last_name;
                            const branchName = contact.school_name + ' (' + (contact.branch_name || 'Main') + ')';
                            const avatarBg = getAvatarBgColor(contact.first_name);
                        %>
                            <div class="contact-item contact-item-trigger p-2.5 md:p-3 border-b border-slate-100 flex items-center cursor-pointer hover:bg-slate-50 rounded-xl transition-colors"  id="contact-<%= contact.school_id %>-<%= contact.admin_id %>"  data-admin-id="<%= contact.admin_id %>"  data-school-id="<%= contact.school_id %>"  data-fullname="<%= adminName %>"  data-branchname="<%= branchName %>">
                                <div class="relative flex-shrink-0 mr-3">
                                    <% if (contact.image) { %>
                                        <img src="<%= contact.image %>" alt="<%= adminName %>" class="w-10 h-10 md:w-11 md:h-11 rounded-xl object-cover">
                                    <% } else { %>
                                        <div class="w-10 h-10 md:w-11 md:h-11 rounded-xl flex items-center justify-center text-white font-bold text-sm shadow-sm avatar-bg-element" data-avatar-bg="<%= avatarBg %>">
                                            <%= contact.first_name.charAt(0).toUpperCase() %>
                                        </div>
                                    <% } %>
                                    <span class="status-dot absolute bottom-0 right-0 w-3 h-3 rounded-full border-2 border-white bg-gray-400 transition-colors" id="dot-<%= contact.school_id %>-<%= contact.admin_id %>"></span>
                                </div>
                                <div class="flex-grow min-w-0">
                                    <div class="flex justify-between items-center mb-1">
                                        <h6 class="contact-name m-0 truncate text-slate-800 font-semibold text-xs"><%= branchName %></h6>
                                        <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-[9px] font-medium truncate max-w-[100px] ml-1 flex-shrink-0"><%= adminName %></span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <p class="last-message text-slate-500 truncate m-0 text-xs" id="lastMsg-<%= contact.school_id %>-<%= contact.admin_id %>" style="max-width: 180px;">
                                            <%= contact.last_message || 'No messages yet' %>
                                        </p>
                                        <span class="bg-emerald-600 text-white text-[10px] font-bold rounded-full w-5 h-5 items-center justify-center ml-2 <%= contact.unread_count > 0 ? 'flex' : 'hidden' %>" id="unread-<%= contact.school_id %>-<%= contact.admin_id %>"><%= contact.unread_count %></span>
                                    </div>
                                </div>
                            </div>
                        <% } else {  const branchName = contact.school_name + ' (' + (contact.branch_name || 'Main') + ')'; %>
                            <div class="contact-item p-2.5 md:p-3 border-b border-slate-100 flex items-center cursor-not-allowed opacity-60 bg-slate-50 rounded-xl"  id="contact-<%= contact.school_id %>-none" data-fullname="" data-branchname="<%= branchName %>">
                                <div class="relative flex-shrink-0 mr-3">
                                    <div class="w-10 h-10 md:w-11 md:h-11 rounded-xl flex items-center justify-center bg-slate-200 text-slate-400 text-sm">
                                        <i class="fa-solid fa-triangle-exclamation text-rose-500 text-xs"></i>
                                    </div>
                                </div>
                                <div class="flex-grow min-w-0">
                                    <div class="flex justify-between items-center mb-1">
                                        <h6 class="contact-name m-0 truncate text-slate-500 font-semibold text-xs"><%= branchName %></h6>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <p class="last-message text-rose-600 font-semibold truncate m-0 text-[10px]">
                                            No active School Admin assigned
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>
                <% } else { %>
                    <div class="p-6 text-center text-slate-400">
                        <i class="fas fa-users text-2xl mb-2 text-slate-200"></i>
                        <p class="text-xs m-0">No branches found</p>
                    </div>
                <% } %>
            </div>
        </div>
        <div class="chat-area h-full flex flex-col bg-slate-50 hidden md:flex" id="chatArea">
            <div class="flex flex-col h-full justify-center items-center p-8 text-center" id="chatPlaceholder">
                <div class="w-20 h-20 rounded-2xl bg-[#e0e7ff] text-indigo-600 flex items-center justify-center mb-4 shadow-sm">
                    <i class="fas fa-comments text-3xl"></i>
                </div>
                <h5 class="text-slate-800 font-bold text-lg">Branch Administrator Chats</h5>
                <p class="text-slate-500 text-sm mt-1 max-w-[320px]">Select a school admin from the branch list to start secure internal messages.</p>
            </div>
            <div class="flex flex-col h-full hidden" id="activeChat">
                <div class="p-3 md:p-3.5 border-b border-slate-200 flex items-center justify-between bg-white h-[64px] md:h-[72px]">
                    <div class="flex items-center min-w-0 flex-1 mr-2">
                        <button class="md:hidden text-slate-500 mr-2.5 p-1.5 hover:text-slate-800 focus:outline-none transition-colors flex-shrink-0" onclick="showContactsSidebar()" aria-label="Back to contacts">
                            <i class="fas fa-arrow-left text-base"></i>
                        </button>
                        <div class="w-9 h-9 md:w-10 md:h-10 rounded-xl flex items-center justify-center bg-emerald-600 text-white font-bold text-sm mr-2.5 flex-shrink-0 shadow-sm" id="activeAvatar">A</div>
                        <div class="min-w-0 flex-1">
                           <h6 class="m-0 text-slate-800 font-bold text-xs md:text-sm truncate" id="activeBranchName">Branch Name</h6>
                           <span class="text-slate-500 text-[10px] md:text-[11px] capitalize font-medium block truncate" id="activeAdminName">Admin Name</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 flex-shrink-0">
                        <button onclick="markAllReadFromActive()" class="w-8 h-8 md:w-9 md:h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-emerald-600 hover:border-emerald-200 transition-colors" aria-label="Mark all messages as read" title="Mark all as read">
                            <i class="fas fa-check-double text-xs"></i>
                        </button>
                        <button onclick="toggleMsgSearch()" class="w-8 h-8 md:w-9 md:h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:border-slate-300 transition-colors" aria-label="Search messages" title="Search messages">
                            <i class="fas fa-search text-xs"></i>
                        </button>
                    </div>
                </div>
                <div id="msgSearchBar" class="hidden px-4 py-2.5 border-b border-slate-100 bg-white">
                  <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="msgSearchInput" placeholder="Search messages..." aria-label="Search messages" class="w-full text-xs pl-8 py-2 rounded-lg border border-slate-200 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors" oninput="handleMsgSearch(event)" onkeyup="handleMsgSearch(event)">
                  </div>
                  <div id="searchResults" class="mt-2 space-y-1 max-h-48 overflow-y-auto hidden bg-slate-50 border border-slate-100 rounded-lg p-1.5"></div>
                </div>
                <div class="flex-grow p-3 md:p-4 overflow-y-auto bg-chat flex flex-col gap-2.5" id="messagesWindow"></div>
                <div class="p-2.5 md:p-3.5 border-t border-slate-200 bg-white relative">
                    <form id="messageForm" onsubmit="handleSendMessage(event)" class="m-0">
                        <div class="flex items-center gap-2">
                            <input type="text" class="flex-grow bg-slate-50 rounded-2xl border border-slate-200 px-3.5 py-2.5 text-sm focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-slate-800 placeholder-slate-400 transition-colors" id="messageInput" placeholder="Type a message..." aria-label="Message" autocomplete="off" maxlength="1000" required>
                            <button class="w-10 h-10 md:w-11 md:h-11 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white flex items-center justify-center shadow-sm transition-all focus:outline-none flex-shrink-0" type="submit" aria-label="Send message">
                                <i class="fas fa-paper-plane text-xs md:text-sm"></i>
                            </button>
                        </div>
                        <div class="flex justify-between items-center mt-1 px-2">
                            <span class="text-rose-600 text-xs font-medium" id="messageError" style="display: none;"></span>
                            <span class="text-slate-400 text-[10px] ml-auto" id="messageCounter">0/1000</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/socket.io/socket.io.js"></script>
<script>
    (function() {
        const container = document.getElementById('chatContainer');

        function applyAvatarBgColors() {
            document.querySelectorAll('.avatar-bg-element[data-avatar-bg]').forEach(el => {
                const bg = el.getAttribute('data-avatar-bg');
                if (bg) el.style.backgroundColor = bg;
            });
        };

        function escapeHtml(str) {
            if (typeof str !== 'string') return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#x27;');
        };

        function getAvatarColor(name) {
            if (!name) return '#6b7280';
            const char = name.trim().charAt(0).toUpperCase();
            const colorMap = { 'A': '#10b981', 'B': '#8b5cf6', 'C': '#06b6d4', 'D': '#f97316', 'E': '#ef4444', 'F': '#e11d48', 'G': '#6366f1',
                'H': '#14b8a6', 'I': '#3b82f6', 'J': '#f59e0b', 'K': '#8b5cf6', 'L': '#10b981', 'M': '#ec4899', 'N': '#6366f1', 'O': '#f97316',
                'P': '#14b8a6', 'Q': '#8b5cf6', 'R': '#06b6d4', 'S': '#10b981', 'T': '#f59e0b', 'U': '#6366f1', 'V': '#ec4899', 'W': '#3b82f6',
                'X': '#8b5cf6', 'Y': '#f97316', 'Z': '#14b8a6'
            };
            return colorMap[char] || '#6b7280';
        };

        const socket = io({ withCredentials: true });
        const currentUserId = Number(container.getAttribute('data-user-id'));
        let activeAdminId = null;
        let activeSchoolId = null;
        let lastDateString = null;

        function getMessageDateString(dateObj) {
            const today = new Date();
            const yesterday = new Date();
            yesterday.setDate(today.getDate() - 1);

            const d = new Date(dateObj);
            if (d.toDateString() === today.toDateString()) {
                return "Today";
            } else if (d.toDateString() === yesterday.toDateString()) {
                return "Yesterday";
            } else {
                return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
            };
        };

        document.getElementById('contactsList')?.addEventListener('click', function(e) {
            const item = e.target.closest('.contact-item-trigger');
            if (item) {
                const adminId = parseInt(item.getAttribute('data-admin-id'));
                const schoolId = parseInt(item.getAttribute('data-school-id'));
                const fullname = item.getAttribute('data-fullname');
                const branchname = item.getAttribute('data-branchname');
                selectContact(schoolId, adminId, fullname, branchname);
            };
        });

        function selectContact(schoolId, adminId, fullName, branchName) {
            activeAdminId = adminId;
            activeSchoolId = schoolId;
            
            localStorage.setItem('activeChatAdminId', adminId);
            localStorage.setItem('activeChatSchoolId', schoolId);
            localStorage.setItem('activeChatAdminName', fullName);
            localStorage.setItem('activeChatBranchName', branchName);

            document.querySelectorAll('.contact-item').forEach(item => item.classList.remove('bg-indigo-light'));
            const contactEl = document.getElementById(`contact-${schoolId}-${adminId}`);
            if (contactEl) contactEl.classList.add('bg-indigo-light');

            const badge = document.getElementById(`unread-${schoolId}-${adminId}`);
            if (badge) {
                badge.classList.add('hidden');
                badge.classList.remove('flex');
                badge.textContent = '0';
            };

            document.getElementById('activeBranchName').textContent = branchName;
            document.getElementById('activeAdminName').textContent = fullName;
            const avatarEl = document.getElementById('activeAvatar');
            
            if (avatarEl) {
                avatarEl.textContent = fullName.charAt(0).toUpperCase();
                avatarEl.style.backgroundColor = getAvatarColor(fullName);
            };

            document.getElementById('chatPlaceholder').classList.add('hidden');
            document.getElementById('activeChat').classList.remove('hidden');
            document.getElementById('msgSearchBar').classList.add('hidden');
            document.getElementById('msgSearchInput').value = '';
            document.getElementById('searchResults').classList.add('hidden');

            fetch(`/groupadmin/chat/history/${schoolId}/${adminId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        renderMessages(data.messages);
                    };
                })
                .catch(err => console.error('Failed to load chat history:', err));

            if (window.innerWidth < 768) {
                document.getElementById('contactsSidebar').classList.add('hidden');
                document.getElementById('chatArea').classList.remove('hidden');
            };
        };

        function renderMessages(messages) {
            const win = document.getElementById('messagesWindow');
            win.innerHTML = '';
            lastDateString = null;
            if (messages && messages.length > 0) {
                messages.forEach(msg => appendMessage(msg));
            } else {
                win.innerHTML = `
                    <div class="flex flex-col items-center justify-center my-auto py-12 text-center">
                        <div class="w-16 h-16 rounded-2xl bg-[#e0e7ff] text-indigo-600 flex items-center justify-center mb-3 shadow-sm">
                            <i class="fas fa-hand-sparkles text-2xl"></i>
                        </div>
                        <h6 class="text-slate-800 font-bold text-base mb-1">Say hello! Start your conversation.</h6>
                        <p class="text-slate-500 text-xs m-0">Send a message to begin chatting.</p>
                    </div>`;
            };
            scrollMessagesToBottom();
        };

        function appendMessage(msg) {
            const win = document.getElementById('messagesWindow');        
            const msgDateString = getMessageDateString(msg.created_at);
            if (msgDateString !== lastDateString) {
                lastDateString = msgDateString;
                const dateDivider = document.createElement('div');
                dateDivider.className = 'text-center my-3 w-full';
                dateDivider.innerHTML = `<span class="inline-block bg-white text-slate-500 px-3 py-1.5 border border-slate-200 rounded-full shadow-sm text-[10px] font-semibold tracking-wide">${msgDateString}</span>`;
                win.appendChild(dateDivider);
            };

            const isSelf = Number(msg.sender_id) === currentUserId;
            const msgWrapper = document.createElement('div');
            msgWrapper.className = `flex w-full mb-3 msg-bubble-wrapper group ${isSelf ? 'justify-end' : 'justify-start'}`;
            msgWrapper.setAttribute('data-message-id', msg.id);
            const time = new Date(msg.created_at).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit', hour12: true });
            const safeMsg = escapeHtml(msg.message);
            const safeMsgId = Number.isInteger(msg.id) ? msg.id : 0;

            msgWrapper.innerHTML = `
                <div class="max-w-[70%] rounded-2xl px-4 py-2.5 shadow-sm text-sm relative msg-bubble-container 
                            ${isSelf ? 'bg-whatsapp-sent rounded-br-none text-slate-800' : 'bg-whatsapp-received rounded-bl-none text-slate-800'}">
                    <p class="m-0 break-words leading-relaxed text-sm">${safeMsg}</p>
                    <div class="flex items-center justify-end gap-1 mt-1 text-[9px] text-slate-400 select-none font-medium">
                        <span>${time}</span>
                        ${isSelf ? `
                            <span class="read-receipt flex items-center ml-1" title="${msg.is_read ? 'Read' : 'Sent'}">
                                <i class="fas ${msg.is_read ? 'fa-check-double text-blue-400' : 'fa-check text-gray-300'}" style="font-size: 10px;"></i>
                            </span>
                            <button class="delete-btn absolute -top-2 -right-2 hidden group-hover:flex w-5 h-5 rounded-full bg-red-100 text-rose-600 items-center justify-center text-[10px] hover:bg-red-200 transition shadow-sm border-0" onclick="deleteMsg(${safeMsgId})" title="Delete message">
                                <i class="fa-solid fa-times text-[10px]"></i>
                            </button>
                        ` : ''}
                    </div>
                </div>
            `;
            win.appendChild(msgWrapper);
        };

        function scrollMessagesToBottom() {
            const win = document.getElementById('messagesWindow');
            if (win) win.scrollTop = win.scrollHeight;
        };

        function handleSendMessage(e) {
            e.preventDefault();
            const input = document.getElementById('messageInput');
            const text = input.value.trim();
            clearMessageError();
            if (!activeAdminId || !activeSchoolId) {
                showMessageError('Select a contact before sending.');
                return;
            };
            if (!text) {
                showMessageError('Message content is required.');
                return;
            };

            const payload = {
                schoolId: activeSchoolId,
                receiverId: activeAdminId,
                message: text
            };

            fetch('/groupadmin/chat/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    input.value = '';
                    document.getElementById('messageCounter').textContent = '0/1000';
                } else {
                    showMessageError(data.message || 'Failed to send message.');
                };
            })
            .catch(err => {
                console.error('[Chat] Send error:', err);
                showMessageError('Connection error. Failed to send message.');
            });
        };

        function showMessageError(msg) {
            const el = document.getElementById('messageError');
            if (el) {
                el.textContent = msg;
                el.style.display = 'block';
            };
        };

        function clearMessageError() {
            const el = document.getElementById('messageError');
            if (el) {
                el.textContent = '';
                el.style.display = 'none';
            };
        };

        document.getElementById('messageInput')?.addEventListener('input', function() {
            document.getElementById('messageCounter').textContent = `${this.value.length}/1000`;
        });

        function filterContacts() {
            const query = document.getElementById('searchContacts').value.toLowerCase();
            document.querySelectorAll('.contact-item').forEach(item => {
                const fullname = item.getAttribute('data-fullname').toLowerCase();
                const branchname = item.getAttribute('data-branchname').toLowerCase();
                if (fullname.includes(query) || branchname.includes(query)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                };
            });
        };

        function showContactsSidebar() {
            document.getElementById('chatArea').classList.add('hidden');
            document.getElementById('contactsSidebar').classList.remove('hidden');
        };

        function markAllReadFromActive() {
            if (!activeAdminId || !activeSchoolId) return;
            fetch('/groupadmin/chat/read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ schoolId: activeSchoolId, senderId: activeAdminId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const badge = document.getElementById(`unread-${activeSchoolId}-${activeAdminId}`);
                    if (badge) badge.classList.add('hidden');
                };
            })
            .catch(err => console.error('Failed to mark read:', err));
        };

        function toggleMsgSearch() {
            const bar = document.getElementById('msgSearchBar');
            if (bar) {
                bar.classList.toggle('hidden');
                if (!bar.classList.contains('hidden')) {
                    document.getElementById('msgSearchInput').focus();
                } else {
                    document.getElementById('msgSearchInput').value = '';
                    document.getElementById('searchResults').classList.add('hidden');
                    document.getElementById('searchResults').innerHTML = '';
                };
            };
        };

        function handleMsgSearch(e) {
            const query = e.target.value.trim();
            const resultsDiv = document.getElementById('searchResults');
            if (query.length < 2) {
                resultsDiv.classList.add('hidden');
                resultsDiv.innerHTML = '';
                return;
            };

            fetch(`/groupadmin/chat/search?schoolId=${activeSchoolId}&adminId=${activeAdminId}&q=${encodeURIComponent(query)}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.messages.length > 0) {
                        resultsDiv.innerHTML = data.messages.map(msg => {
                            const dateStr = escapeHtml(new Date(msg.created_at).toLocaleString());
                            const isSelf = Number(msg.sender_id) === currentUserId;
                            const safeMsgId = Number.isInteger(msg.id) ? msg.id : 0;
                            return `
                                <div class="p-2 border-b border-slate-100 hover:bg-slate-100 cursor-pointer text-xs flex flex-col gap-1 rounded-lg transition-colors" onclick="scrollToMessage(${safeMsgId})">
                                    <div class="flex justify-between items-center font-bold text-[10px]">
                                        <span class="${isSelf ? 'text-emerald-700' : 'text-slate-700'}">${isSelf ? 'You' : 'Admin'}</span>
                                        <span class="text-slate-400 font-normal">${dateStr}</span>
                                    </div>
                                    <div class="text-slate-600 truncate">${escapeHtml(msg.message)}</div>
                                </div>
                            `;
                        }).join('');
                        resultsDiv.classList.remove('hidden');
                    } else {
                        resultsDiv.innerHTML = '<div class="p-3 text-center text-slate-400 text-[10px]">No matches found</div>';
                        resultsDiv.classList.remove('hidden');
                    };
                })
                .catch(err => console.error('Search failed:', err));
        };

        function scrollToMessage(msgId) {
            const el = document.querySelector(`[data-message-id="${msgId}"]`);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                el.classList.add('ring-2', 'ring-yellow-300', 'rounded-lg');
                setTimeout(() => el.classList.remove('ring-2', 'ring-yellow-300', 'rounded-lg'), 2000);
                toggleMsgSearch();
            } else {
                alert('Message is not loaded in current conversation view.');
            };
        };

        function deleteMsg(msgId) {
            if (!confirm('Are you sure you want to delete this message?')) return;
            fetch(`/groupadmin/chat/message/${msgId}`, {
                method: 'DELETE'
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const el = document.querySelector(`[data-message-id="${msgId}"]`);
                    if (el) el.remove();
                } else {
                    alert(data.message || 'Failed to delete message.');
                };
            })
            .catch(err => {
                console.error('Delete failed:', err);
                alert('Request failed.');
            });
        };

        socket.on('connect', () => { });
        socket.on('chat_message', (msg) => {
            const isFromActiveContact = Number(msg.school_id) === activeSchoolId &&
                ((Number(msg.sender_id) === activeAdminId && Number(msg.receiver_id) === currentUserId) ||
                (Number(msg.sender_id) === currentUserId && Number(msg.receiver_id) === activeAdminId));

            if (isFromActiveContact) {
                appendMessage(msg);
                scrollMessagesToBottom();
                
                if (Number(msg.sender_id) === activeAdminId) {
                    fetch('/groupadmin/chat/read', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ schoolId: activeSchoolId, senderId: activeAdminId })
                    }).catch(err => console.error('Failed auto mark read:', err));
                }
            } else {
                const badge = document.getElementById(`unread-${msg.school_id}-${msg.sender_id}`);
                if (badge) {
                    const count = parseInt(badge.textContent || '0', 10) + 1;
                    badge.textContent = count;
                    badge.classList.remove('hidden');
                    badge.classList.add('flex');
                };
                const lastMsgEl = document.getElementById(`lastMsg-${msg.school_id}-${msg.sender_id}`);
                if (lastMsgEl) {
                    lastMsgEl.textContent = msg.message;
                };
            };
        });

        socket.on('chat_message_deleted', (data) => {
            const { message_id } = data;
            const msgEl = document.querySelector(`[data-message-id="${message_id}"]`);
            if (msgEl) {
                msgEl.remove();
            };
        });

        socket.on('messages_read', (data) => {
            const { receiver_id } = data;
            const rcvId = Number(receiver_id || data.sender_id);
            if (activeAdminId && rcvId === Number(activeAdminId)) {
                document.querySelectorAll('.message-bubble-wrapper[data-sender-self="true"] .read-receipt, .read-receipt')
                    .forEach(el => {
                        el.innerHTML = '<i class="fas fa-check-double text-blue-400" style="font-size: 10px;"></i>';
                        el.title = 'Read';
                    });
            };
        });

        const lastAdminId = localStorage.getItem('activeChatAdminId');
        const lastSchoolId = localStorage.getItem('activeChatSchoolId');
        const lastAdminName = localStorage.getItem('activeChatAdminName');
        const lastBranchName = localStorage.getItem('activeChatBranchName');

        if (lastAdminId && lastSchoolId && lastAdminName) {
            const targetEl = document.getElementById(`contact-${lastSchoolId}-${lastAdminId}`);
            if (targetEl) {
                selectContact(parseInt(lastSchoolId), parseInt(lastAdminId), lastAdminName, lastBranchName || '');
            } else {
                localStorage.removeItem('activeChatAdminId');
                localStorage.removeItem('activeChatSchoolId');
                localStorage.removeItem('activeChatAdminName');
                localStorage.removeItem('activeChatBranchName');
            };
        } else {
            applyAvatarBgColors();
        };

        window.handleSendMessage = handleSendMessage;
        window.filterContacts = filterContacts;
        window.showContactsSidebar = showContactsSidebar;
        window.markAllReadFromActive = markAllReadFromActive;
        window.toggleMsgSearch = toggleMsgSearch;
        window.handleMsgSearch = handleMsgSearch;
        window.scrollToMessage = scrollToMessage;
        window.deleteMsg = deleteMsg;
    })();
</script>
