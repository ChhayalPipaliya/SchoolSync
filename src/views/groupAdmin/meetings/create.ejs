<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Schedule_Video_Meeting %></h2>
        <p class="text-xs text-gray-500 mt-1"><%- lan.Schedule_Meeting_Subtitle %></p>
    </div>
    <div>
        <a href="/groupadmin/meetings" class="btn btn-secondary btn-sm border border-slate-200 hover:bg-slate-50 bg-white">
            <i class="fa-solid fa-arrow-left mr-1"></i> <%- lan.Back_To_Meetings %>
        </a>
    </div>
</div>
<div class="card p-6 bg-white shadow-sm border border-slate-200 rounded-2xl">
    <form method="POST" action="/groupadmin/meetings" class="space-y-6" id="meetingForm">
        <div class="grid grid-cols-1 gap-4">
            <div class="form-group">
                <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block"><%- lan.Target_Branch_Admin %> *</label>
                <select name="schoolAdminCombo" id="schoolAdminCombo" required class="form-select w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm">
                    <option value="" disabled selected><%- lan.Select_Branch_Admin_Placeholder %></option>
                    <% branches.forEach(branch => { %>
                        <% const hasAdmin = !!branch.admin_id; %>
                        <option value="<%= branch.id %>_<%= branch.admin_id || 'null' %>" <%= !hasAdmin ? 'disabled' : '' %>>
                            <%= branch.school_name %> (<%= branch.branch_name || 'Main' %>) <%= hasAdmin ? `· Admin: ${branch.admin_name}` : '· (No active School Admin assigned)' %>
                        </option>
                    <% }) %>
                </select>
                <p class="text-[10px] text-slate-400 mt-1.5"><%- lan.Meeting_Branch_Note %></p>
            </div>
            <div class="form-group">
                <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block"><%- lan.Meeting_Title %> *</label>
                <input type="text" name="title" required maxlength="255" class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm" placeholder="<%= lan.Meeting_Title_Placeholder %>">
            </div>
            <div class="form-group">
                <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block"><%- lan.Description %></label>
                <textarea name="description" class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm" rows="3" maxlength="2000" placeholder="<%= lan.Meeting_Description_Placeholder %>"></textarea>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="form-group">
                    <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block"><%- lan.Scheduled_At %> *</label>
                    <input type="datetime-local" name="scheduledAt" required class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm">
                </div>
                <div class="form-group">
                    <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block"><%- lan.Duration_Minutes %> *</label>
                    <input type="number" name="durationMinutes" required class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm" min="5" max="300" value="45">
                </div>
            </div>
        </div>
        <div class="flex gap-4 pt-4 border-t border-slate-100">
            <button type="submit" class="btn btn-primary flex-1 bg-emerald-600 hover:bg-emerald-700 border-0 py-2.5 text-white rounded-xl font-bold">
                <i class="fa-solid fa-calendar-check mr-1"></i> <%- lan.Schedule_Meeting %>
            </button>
            <a href="/groupadmin/meetings" class="btn btn-secondary flex-1 text-center py-2.5 border border-slate-200 rounded-xl font-bold text-slate-700 hover:bg-slate-50 bg-white"><%- lan.Cancel %></a>
        </div>
    </form>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const datetimeInput = document.querySelector('input[name="scheduledAt"]');
        if (datetimeInput) {
            const now = new Date();
            const localNow = new Date(now.getTime());
            localNow.setMinutes(localNow.getMinutes() - localNow.getTimezoneOffset());
            datetimeInput.min = localNow.toISOString().slice(0, 16);
            const defaultStart = new Date(localNow.getTime());
            defaultStart.setMinutes(defaultStart.getMinutes() + 30);
            datetimeInput.value = defaultStart.toISOString().slice(0, 16);
        }
    });
</script>