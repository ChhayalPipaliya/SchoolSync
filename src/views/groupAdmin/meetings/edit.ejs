<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Edit Video Meeting</h2>
        <p class="text-xs text-gray-500 mt-1">Update the meeting details for your Jitsi session</p>
    </div>
    <div>
        <a href="/groupadmin/meetings/<%= meeting.id %>" class="btn btn-secondary btn-sm border border-slate-200 hover:bg-slate-50 bg-white">
            <i class="fa-solid fa-arrow-left mr-1"></i> Back to Details
        </a>
    </div>
</div>
<div class="card p-6 bg-white shadow-sm border border-slate-200 rounded-2xl">
    <form method="POST" action="/groupadmin/meetings/<%= meeting.id %>/edit" class="space-y-6" id="editMeetingForm">
        <div class="grid grid-cols-1 gap-4">
            <div class="form-group">
                <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block">Target Branch (Fixed)</label>
                <input type="text" disabled class="form-input w-full p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-500 text-sm" value="<%= meeting.school_name %> (<%= meeting.branch_name || 'Main' %>) · Admin: <%= meeting.admin_name || 'N/A' %>">
            </div>
            <div class="form-group">
                <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block">Meeting Title *</label>
                <input type="text" name="title" required value="<%= meeting.title %>" maxlength="255" class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm">
            </div>
            <div class="form-group">
                <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block">Description</label>
                <textarea name="description" class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm" rows="3" maxlength="2000"><%= meeting.description %></textarea>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="form-group">
                    <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block">Scheduled At *</label>
                    <% 
                        // Format the date to fit datetime-local input (YYYY-MM-DDTHH:MM)
                        const d = new Date(meeting.scheduled_at);
                        const tzOffset = d.getTimezoneOffset() * 60000;
                        const localISOTime = new Date(d.getTime() - tzOffset).toISOString().slice(0, 16);
                    %>
                    <input type="datetime-local" name="scheduledAt" required value="<%= localISOTime %>" class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm">
                </div>
                <div class="form-group">
                    <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block">Duration (Minutes) *</label>
                    <input type="number" name="durationMinutes" required value="<%= meeting.duration_minutes %>" class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-sm" min="5" max="300">
                </div>
            </div>
        </div>
        <div class="flex gap-4 pt-4 border-t border-slate-100">
            <button type="submit" class="btn btn-primary flex-1 bg-emerald-600 hover:bg-emerald-700 border-0 py-2.5 text-white rounded-xl font-bold">
                <i class="fa-solid fa-save mr-1"></i> Save Changes
            </button>
            <a href="/groupadmin/meetings/<%= meeting.id %>" class="btn btn-secondary flex-1 text-center py-2.5 border border-slate-200 rounded-xl font-bold text-slate-700 hover:bg-slate-50 bg-white">Cancel</a>
        </div>
    </form>
</div>