<style>
    .meetings-page-header-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .meetings-desktop-table {
        width: 100%;
        min-width: 800px;
        border-collapse: collapse;
    }

    .meetings-mobile-cards {
        display: none;
        flex-direction: column;
        gap: 12px;
        padding: 14px;
    }

    .meeting-item-card-mobile {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 12px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    @media (max-width: 768px) {
        .meetings-page-header-card {
            padding: 16px 14px !important;
            margin-bottom: 14px !important;
        }

        .meetings-page-header-card h2 {
            font-size: 20px !important;
        }

        .meetings-page-header-card .header-action-btn {
            width: 100% !important;
            justify-content: center !important;
            padding: 10px !important;
        }

        .meetings-desktop-table {
            display: none !important;
        }

        .meetings-mobile-cards {
            display: flex !important;
        }
    }

    [data-theme="dark"] .meetings-page-header-card,
    [data-theme="dark"] .card,
    .light-mode-disabled .meetings-page-header-card,
    .light-mode-disabled .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
    }

    [data-theme="dark"] .meetings-page-header-card h2,
    [data-theme="dark"] .empty-state-title,
    .light-mode-disabled .meetings-page-header-card h2,
    .light-mode-disabled .empty-state-title {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] .empty-state-text,
    .light-mode-disabled .empty-state-text {
        color: #94A3B8 !important;
    }

    [data-theme="dark"] .meeting-item-card-mobile,
    .light-mode-disabled .meeting-item-card-mobile {
        background: #101726 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] .meeting-item-card-mobile .meeting-title,
    .light-mode-disabled .meeting-item-card-mobile .meeting-title {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] #cancelModal .bg-white,
    .light-mode-disabled #cancelModal .bg-white {
        background: #151D30 !important;
        border-color: #242F4D !important;
    }

    [data-theme="dark"] #cancelModal h3,
    .light-mode-disabled #cancelModal h3 {
        color: #F1F5F9 !important;
    }

    [data-theme="dark"] #cancelReason,
    .light-mode-disabled #cancelReason {
        background: #101726 !important;
        border-color: #334155 !important;
        color: #F1F5F9 !important;
    }
</style>

<div class="meetings-page-header-card flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider"><%- lan.Virtual_Sessions %></span>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight" style="margin: 2px 0 4px 0;"><%- lan.Video_Meetings
                %></h2>
        <p class="text-xs text-gray-500 mt-1" style="margin: 0;"><%- lan.Video_Meetings_Subtitle %></p>
    </div>
    <div>
        <a href="/groupadmin/meetings/create"
            class="btn btn-primary bg-emerald-600 border-emerald-600 hover:bg-emerald-700 header-action-btn flex items-center justify-center gap-2 text-xs font-bold"
            style="border-radius: 8px; padding: 9px 16px;">
            <i class="fa-solid fa-plus mr-1"></i> <%- lan.Schedule_Meeting %>
        </a>
    </div>
</div>

<% if (!meetings || meetings.length===0) { %>
    <div class="card text-center py-12 md:py-16 bg-white shadow-sm border border-slate-200 rounded-2xl">
        <div class="empty-state py-4 md:py-8">
            <div
                class="empty-state-icon mx-auto w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-3xl mb-3 shadow-sm">
                <i class="fa-solid fa-video-slash"></i>
            </div>
            <h3 class="empty-state-title text-lg font-bold text-slate-800 mb-1"><%- lan.No_Meetings_Scheduled %></h3>
            <p class="empty-state-text text-xs md:text-sm text-slate-500 max-w-sm mx-auto mb-3"><%- lan.No_Meetings_Desc
                    %></p>
            <a href="/groupadmin/meetings/create"
                class="btn btn-primary btn-sm bg-emerald-600 hover:bg-emerald-700 border-0 px-4 py-2 rounded-xl text-xs font-bold shadow-sm">
                <i class="fa-solid fa-plus mr-1"></i> <%- lan.Schedule_Meeting %>
            </a>
        </div>
    </div>
    <% } else { %>
        <div class="card p-0 overflow-hidden bg-white shadow-sm border border-slate-200 rounded-2xl">
            <div style="overflow-x: auto;">
                <table class="table meetings-desktop-table min-w-full divide-y divide-slate-100">
                    <thead>
                        <tr class="bg-slate-50" style="border-bottom: 1px solid #E2E8F0;">
                            <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase"><%-
                                    lan.Meeting_Info %></th>
                            <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase"><%-
                                    lan.Branch_School_Admin %></th>
                            <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase"><%-
                                    lan.Room_Name %></th>
                            <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase"><%- lan.Status
                                    %></th>
                            <th class="px-6 py-3.5 text-right text-xs font-bold text-gray-500 uppercase"><%- lan.Actions
                                    %></th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-slate-100">
                        <% meetings.forEach(meeting=> { %>
                            <% let statusClass='bg-slate-100 text-slate-700' ; if (meeting.status==='scheduled' )
                                statusClass='bg-blue-50 text-blue-700 border-blue-200' ; if (meeting.status==='live' )
                                statusClass='bg-emerald-50 text-emerald-700 border-emerald-200 animate-pulse' ; if
                                (meeting.status==='completed' || meeting.status==='ended' )
                                statusClass='bg-slate-100 text-slate-500' ; if (meeting.status==='cancelled' )
                                statusClass='bg-rose-50 text-rose-700 border-rose-200' ; const startMs=new
                                Date(meeting.scheduled_at).getTime(); const endMs=startMs + (meeting.duration_minutes *
                                60 * 1000); const now=Date.now(); const canJoin=meeting.status !=='cancelled' &&
                                meeting.status !=='completed' && meeting.status !=='ended' && now>= (startMs - 15 * 60 *
                                1000) && now <= (endMs + 15 * 60 * 1000); const isCreator=meeting.created_by===user.id;
                                    const statusLabel=meeting.status==='scheduled' ? lan.Scheduled :
                                    (meeting.status==='live' ? lan.Live : (meeting.status==='completed' ? lan.Completed
                                    : (meeting.status==='ended' ? lan.Ended : (meeting.status==='cancelled' ?
                                    lan.Cancelled : meeting.status)))); %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="font-bold text-gray-800 text-sm">
                                                <%= meeting.title %>
                                            </div>
                                            <div class="text-[11px] text-gray-400 mt-1">
                                                <i class="fa-regular fa-calendar-days mr-1"></i>
                                                <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', {
                                                    dateStyle: 'medium' , timeStyle: 'short' }) %>
                                                    · <i class="fa-regular fa-clock mr-1"></i>
                                                    <%= meeting.duration_minutes %> <%- lan.Mins_Lower %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm font-semibold text-slate-700">
                                                <%= meeting.school_name %> (<%= meeting.branch_name || 'Main' %>)
                                            </div>
                                            <div class="text-xs text-slate-500 mt-0.5">
                                                <%= meeting.admin_name || 'No admin assigned' %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 text-xs font-mono text-gray-500">
                                            <%= meeting.room_name %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span
                                                class="px-2.5 py-1 rounded-full text-xs font-bold capitalize border <%= statusClass %>">
                                                <%= statusLabel %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <a href="/groupadmin/meetings/<%= meeting.id %>"
                                                    class="btn btn-sm btn-light border border-slate-200 hover:bg-slate-50 text-xs"
                                                    title="<%= lan.Details %>">
                                                    <i class="fa-solid fa-eye"></i> <%- lan.Details %>
                                                </a>

                                                <% if (isCreator && meeting.status==='scheduled' ) { %>
                                                    <a href="/groupadmin/meetings/<%= meeting.id %>/edit"
                                                        class="btn btn-sm btn-light border border-amber-200 hover:bg-amber-50 text-amber-600 text-xs"
                                                        title="<%= lan.Edit %>">
                                                        <i class="fa-solid fa-pen"></i> <%- lan.Edit %>
                                                    </a>
                                                    <button type="button" data-meeting-id="<%= meeting.id %>"
                                                        data-meeting-title="<%= meeting.title %>"
                                                        onclick="openCancelModalFromButton(this)"
                                                        class="btn btn-sm btn-light border border-rose-200 hover:bg-rose-50 text-rose-600 text-xs"
                                                        title="<%= lan.Cancel %>">
                                                        <i class="fa-solid fa-ban"></i> <%- lan.Cancel %>
                                                    </button>
                                                    <% } %>

                                                        <% if (isCreator && (meeting.status==='completed' ||
                                                            meeting.status==='ended' )) { %>
                                                            <a href="/groupadmin/meetings/<%= meeting.id %>/attendance-report"
                                                                class="btn btn-sm btn-light border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs"
                                                                title="<%= lan.Attendance %>">
                                                                <i class="fa-solid fa-clipboard-user"></i> <%-
                                                                    lan.Attendance %>
                                                            </a>
                                                            <% } %>

                                                                <% if (canJoin) { %>
                                                                    <a href="/groupadmin/meetings/<%= meeting.id %>/join"
                                                                        class="btn btn-sm btn-success bg-emerald-600 hover:bg-emerald-700 border-0 text-xs font-bold"
                                                                        title="<%= lan.Join %>">
                                                                        <i class="fa-solid fa-video mr-1"></i> <%-
                                                                            lan.Join %>
                                                                    </a>
                                                                    <% } else if (meeting.status==='scheduled' ) { %>
                                                                        <button
                                                                            class="btn btn-sm btn-secondary opacity-50 cursor-not-allowed text-xs"
                                                                            disabled
                                                                            title="<%= lan.Join_Window_Desc %>">
                                                                            <i class="fa-solid fa-video mr-1"></i> <%-
                                                                                lan.Join %>
                                                                        </button>
                                                                        <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
                <div class="meetings-mobile-cards">
                    <% meetings.forEach(meeting=> { %>
                        <% let statusClass='bg-slate-100 text-slate-700' ; if (meeting.status==='scheduled' )
                            statusClass='bg-blue-50 text-blue-700 border-blue-200' ; if (meeting.status==='live' )
                            statusClass='bg-emerald-50 text-emerald-700 border-emerald-200 animate-pulse' ; if
                            (meeting.status==='completed' || meeting.status==='ended' )
                            statusClass='bg-slate-100 text-slate-500' ; if (meeting.status==='cancelled' )
                            statusClass='bg-rose-50 text-rose-700 border-rose-200' ; const startMs=new
                            Date(meeting.scheduled_at).getTime(); const endMs=startMs + (meeting.duration_minutes * 60 *
                            1000); const now=Date.now(); const canJoin=meeting.status !=='cancelled' && meeting.status
                            !=='completed' && meeting.status !=='ended' && now>= (startMs - 15 * 60 * 1000) && now <=
                                (endMs + 15 * 60 * 1000); const isCreator=meeting.created_by===user.id; const
                                statusLabel=meeting.status==='scheduled' ? lan.Scheduled : (meeting.status==='live' ?
                                lan.Live : (meeting.status==='completed' ? lan.Completed : (meeting.status==='ended' ?
                                lan.Ended : (meeting.status==='cancelled' ? lan.Cancelled : meeting.status)))); %>
                                <div class="meeting-item-card-mobile">
                                    <div
                                        style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                        <div class="meeting-title"
                                            style="font-size: 14px; font-weight: 800; color: #0F172A;">
                                            <%= meeting.title %>
                                        </div>
                                        <span
                                            class="px-2.5 py-0.5 rounded-full text-[10px] font-bold capitalize border <%= statusClass %>"
                                            style="flex-shrink: 0;">
                                            <%= statusLabel %>
                                        </span>
                                    </div>
                                    <div
                                        style="font-size: 12px; color: #475569; background: rgba(0,0,0,0.02); padding: 8px 10px; border-radius: 8px;">
                                        <div style="font-weight: 700; color: #0891B2;">
                                            <%= meeting.school_name %> (<%= meeting.branch_name || 'Main' %>)
                                        </div>
                                        <div style="font-size: 11px; color: #64748B; margin-top: 1px;"><i
                                                class="fas fa-user-shield text-[10px]"></i>
                                            <%= meeting.admin_name || 'No admin assigned' %>
                                        </div>
                                    </div>
                                    <div
                                        style="display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; font-size: 11px;">
                                        <div>
                                            <i class="fa-regular fa-calendar-days text-emerald-600 mr-1"></i>
                                            <strong>
                                                <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', {
                                                    dateStyle: 'medium' , timeStyle: 'short' }) %>
                                            </strong>
                                        </div>
                                        <div style="color: #64748B;">
                                            <i class="fa-regular fa-clock mr-1"></i>
                                            <%= meeting.duration_minutes %> <%- lan.Mins_Lower %>
                                        </div>
                                    </div>
                                    <div
                                        style="display: flex; align-items: center; justify-content: flex-end; gap: 6px; border-top: 1px solid #F1F5F9; padding-top: 10px; margin-top: 2px; flex-wrap: wrap;">
                                        <a href="/groupadmin/meetings/<%= meeting.id %>"
                                            class="btn btn-sm btn-light border border-slate-200 text-xs py-1.5 px-3 rounded-lg"
                                            title="<%= lan.Details %>">
                                            <i class="fa-solid fa-eye"></i> <%- lan.Details %>
                                        </a>
                                        <% if (isCreator && meeting.status==='scheduled' ) { %>
                                            <a href="/groupadmin/meetings/<%= meeting.id %>/edit"
                                                class="btn btn-sm btn-light border border-amber-200 text-amber-600 text-xs py-1.5 px-3 rounded-lg">
                                                <i class="fa-solid fa-pen"></i> <%- lan.Edit %>
                                            </a>
                                            <button type="button" data-meeting-id="<%= meeting.id %>"
                                                data-meeting-title="<%= meeting.title %>"
                                                onclick="openCancelModalFromButton(this)"
                                                class="btn btn-sm btn-light border border-rose-200 text-rose-600 text-xs py-1.5 px-3 rounded-lg">
                                                <i class="fa-solid fa-ban"></i> <%- lan.Cancel %>
                                            </button>
                                            <% } %>
                                                <% if (isCreator && (meeting.status==='completed' ||
                                                    meeting.status==='ended' )) { %>
                                                    <a href="/groupadmin/meetings/<%= meeting.id %>/attendance-report"
                                                        class="btn btn-sm btn-light border border-slate-200 text-slate-700 text-xs py-1.5 px-3 rounded-lg">
                                                        <i class="fa-solid fa-clipboard-user"></i> <%- lan.Attendance %>
                                                    </a>
                                                    <% } %>
                                                        <% if (canJoin) { %>
                                                            <a href="/groupadmin/meetings/<%= meeting.id %>/join"
                                                                class="btn btn-sm btn-success bg-emerald-600 hover:bg-emerald-700 border-0 text-xs font-bold py-1.5 px-3.5 rounded-lg text-white">
                                                                <i class="fa-solid fa-video mr-1"></i> <%- lan.Join_Call
                                                                    %>
                                                            </a>
                                                            <% } %>
                                    </div>
                                </div>
                                <% }) %>
                </div>
            </div>
        </div>
        <% } %>
            <div id="cancelModal"
                class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50">
                <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-xl border border-slate-200">
                    <h3 class="text-sm font-bold text-gray-800 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-circle-exclamation text-rose-500"></i> <%- lan.Cancel_Meeting %>
                    </h3>
                    <p class="text-xs text-gray-500 mb-3">Are you sure you want to cancel the meeting <strong
                            id="cancelMeetingTitle"></strong>? This will notify the branch school administrator.</p>
                    <form id="cancelForm" class="space-y-4" onsubmit="submitCancellation(event)">
                        <div class="form-group">
                            <label class="form-label text-xs font-bold text-slate-700"><%- lan.Reason_For_Cancellation
                                    %> *</label>
                            <textarea name="cancel_reason" id="cancelReason" required
                                class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-xs"
                                rows="3" placeholder="<%= lan.Cancel_Reason_Placeholder %>"></textarea>
                        </div>
                        <div class="flex gap-3 pt-2">
                            <button type="submit"
                                class="btn btn-danger bg-rose-600 hover:bg-rose-700 text-white border-0 py-2 text-xs flex-1 font-bold rounded-xl"><%-
                                    lan.Yes_Cancel_Meeting %></button>
                            <button type="button" onclick="closeCancelModal()"
                                class="btn btn-secondary border border-slate-200 hover:bg-slate-50 bg-white py-2 text-xs flex-1 font-bold rounded-xl"><%-
                                    lan.Close %></button>
                        </div>
                    </form>
                </div>
            </div>
            <script>
                let currentCancelId = null;

                function openCancelModal(id, title) {
                    currentCancelId = id;
                    document.getElementById('cancelMeetingTitle').textContent = title;
                    document.getElementById('cancelReason').value = '';
                    document.getElementById('cancelModal').classList.remove('hidden');
                };

                function openCancelModalFromButton(button) {
                    openCancelModal(button.dataset.meetingId, button.dataset.meetingTitle || '');
                };

                function closeCancelModal() {
                    document.getElementById('cancelModal').classList.add('hidden');
                };

                function submitCancellation(e) {
                    e.preventDefault();
                    const reason = document.getElementById('cancelReason').value;

                    fetch(`/groupadmin/meetings/${currentCancelId}/cancel`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ cancel_reason: reason })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                window.location.reload();
                            } else {
                                alert(data.message || '<%- lan.Failed_Cancel_Meeting %>');
                            };
                        })
                        .catch(err => {
                            console.error(err);
                            alert('<%- lan.Request_Failed %>');
                        });
                };

                document.getElementById('cancelModal').addEventListener('click', function (e) {
                    if (e.target === this) closeCancelModal();
                });
            </script>