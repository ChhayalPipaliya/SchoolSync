<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Video Meetings</h2>
        <p class="text-xs text-gray-500 mt-1">Schedule and join virtual sessions with your branch school administrators</p>
    </div>
    <div>
        <a href="/groupadmin/meetings/create" class="btn btn-primary bg-emerald-600 border-emerald-600 hover:bg-emerald-700">
            <i class="fa-solid fa-plus mr-1"></i> Schedule Meeting
        </a>
    </div>
</div>
<% if (!meetings || meetings.length === 0) { %>
    <div class="card text-center py-16 bg-white shadow-sm border border-slate-200 rounded-2xl">
        <div class="empty-state py-8">
            <div class="empty-state-icon text-emerald-600 text-4xl mb-3"><i class="fa-solid fa-video-slash"></i></div>
            <h3 class="empty-state-title text-lg font-bold text-slate-800">No meetings scheduled</h3>
            <p class="empty-state-text text-sm text-slate-500">Schedule your first video call with a branch administrator.</p>
            <a href="/groupadmin/meetings/create" class="btn btn-primary btn-sm mt-4 bg-emerald-600 hover:bg-emerald-700 border-0">
                <i class="fa-solid fa-plus mr-1"></i> Schedule Meeting
            </a>
        </div>
    </div>
<% } else { %>
    <div class="card p-0 overflow-hidden bg-white shadow-sm border border-slate-200 rounded-2xl">
        <div class="table-responsive">
            <table class="table min-w-full divide-y divide-slate-100">
                <thead>
                    <tr class="bg-slate-50">
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Meeting Info</th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Branch / school admin</th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Room Name</th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-100">
                    <% meetings.forEach(meeting => { %>
                        <%
                            let statusClass = 'bg-slate-100 text-slate-700';
                            if (meeting.status === 'scheduled') statusClass = 'bg-blue-50 text-blue-700 border-blue-200';
                            if (meeting.status === 'live') statusClass = 'bg-emerald-50 text-emerald-700 border-emerald-200 animate-pulse';
                            if (meeting.status === 'completed' || meeting.status === 'ended') statusClass = 'bg-slate-100 text-slate-500';
                            if (meeting.status === 'cancelled') statusClass = 'bg-rose-50 text-rose-700 border-rose-200';

                            const startMs = new Date(meeting.scheduled_at).getTime();
                            const endMs = startMs + (meeting.duration_minutes * 60 * 1000);
                            const now = Date.now();
                            const canJoin = meeting.status !== 'cancelled' && meeting.status !== 'completed' && meeting.status !== 'ended' && now >= (startMs - 15 * 60 * 1000) && now <= (endMs + 15 * 60 * 1000);
                            const isCreator = meeting.created_by === user.id;
                        %>
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-bold text-gray-800 text-sm"><%= meeting.title %></div>
                                <div class="text-[11px] text-gray-400 mt-1">
                                    <i class="fa-regular fa-calendar-days mr-1"></i>
                                    <%= new Date(meeting.scheduled_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                    · <i class="fa-regular fa-clock mr-1"></i><%= meeting.duration_minutes %> mins
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-semibold text-slate-700"><%= meeting.school_name %> (<%= meeting.branch_name || 'Main' %>)</div>
                                <div class="text-xs text-slate-500 mt-0.5"><%= meeting.admin_name || 'No admin assigned' %></div>
                            </td>
                            <td class="px-6 py-4 text-xs font-mono text-gray-500">
                                <%= meeting.room_name %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold capitalize border <%= statusClass %>">
                                    <%= meeting.status %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="/groupadmin/meetings/<%= meeting.id %>" class="btn btn-sm btn-light border border-slate-200 hover:bg-slate-50" title="View Details">
                                        <i class="fa-solid fa-eye"></i> Details
                                    </a>
                                    
                                    <% if (isCreator && meeting.status === 'scheduled') { %>
                                        <a href="/groupadmin/meetings/<%= meeting.id %>/edit" class="btn btn-sm btn-light border border-amber-200 hover:bg-amber-50 text-amber-600" title="Edit Meeting">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <button type="button" data-meeting-id="<%= meeting.id %>" data-meeting-title="<%= meeting.title %>" onclick="openCancelModalFromButton(this)" class="btn btn-sm btn-light border border-rose-200 hover:bg-rose-50 text-rose-600" title="Cancel Meeting">
                                            <i class="fa-solid fa-ban"></i> Cancel
                                        </button>
                                    <% } %>

                                    <% if (isCreator && (meeting.status === 'completed' || meeting.status === 'ended')) { %>
                                        <a href="/groupadmin/meetings/<%= meeting.id %>/attendance-report" class="btn btn-sm btn-light border border-slate-200 hover:bg-slate-50 text-slate-700" title="View Attendance">
                                            <i class="fa-solid fa-clipboard-user"></i> Attendance
                                        </a>
                                    <% } %>

                                    <% if (canJoin) { %>
                                        <a href="/groupadmin/meetings/<%= meeting.id %>/join" class="btn btn-sm btn-success bg-emerald-600 hover:bg-emerald-700 border-0" title="Join Jitsi Call">
                                            <i class="fa-solid fa-video mr-1"></i> Join
                                        </a>
                                    <% } else if (meeting.status === 'scheduled') { %>
                                        <button class="btn btn-sm btn-secondary opacity-50 cursor-not-allowed" disabled title="Join window opens 15 mins before start time">
                                            <i class="fa-solid fa-video mr-1"></i> Join
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>
<div id="cancelModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-xl border border-slate-200">
        <h3 class="text-sm font-bold text-gray-800 mb-2 flex items-center gap-2">
            <i class="fa-solid fa-circle-exclamation text-rose-500"></i> Cancel Meeting
        </h3>
        <p class="text-xs text-gray-500 mb-4">Are you sure you want to cancel the meeting <strong id="cancelMeetingTitle"></strong>? This will notify the branch school administrator.</p>
        <form id="cancelForm" class="space-y-4" onsubmit="submitCancellation(event)">
            <div class="form-group">
                <label class="form-label text-xs font-bold text-slate-700">Reason for Cancellation *</label>
                <textarea name="cancel_reason" id="cancelReason" required class="form-input w-full p-2.5 bg-white border border-slate-200 rounded-xl focus:border-emerald-500 focus:outline-none text-xs" rows="3" placeholder="e.g. Schedule conflict..."></textarea>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="submit" class="btn btn-danger bg-rose-600 hover:bg-rose-700 text-white border-0 py-2 text-xs flex-1 font-bold rounded-xl">Yes, Cancel Meeting</button>
                <button type="button" onclick="closeCancelModal()" class="btn btn-secondary border border-slate-200 hover:bg-slate-50 bg-white py-2 text-xs flex-1 font-bold rounded-xl">Close</button>
            </div>
        </form>
    </div>
</div>
<script>
    let currentCancelId = null;

    function openCancelModal(id, title) {
        currentCancelId = id;
        document.getElementById('cancelMeetingTitle').textContent = title;
        document.getElementById('cancelReason').value = '';
        document.getElementById('cancelModal').classList.remove('hidden');
    };

    function openCancelModalFromButton(button) {
        openCancelModal(button.dataset.meetingId, button.dataset.meetingTitle || '');
    };
    
    function closeCancelModal() {
        document.getElementById('cancelModal').classList.add('hidden');
    };

    function submitCancellation(e) {
        e.preventDefault();
        const reason = document.getElementById('cancelReason').value;
        
        fetch(`/groupadmin/meetings/${currentCancelId}/cancel`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cancel_reason: reason })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Failed to cancel meeting.');
            };
        })
        .catch(err => {
            console.error(err);
            alert('Request failed.');
        });
    };

    document.getElementById('cancelModal').addEventListener('click', function(e) {
        if (e.target === this) closeCancelModal();
    });
</script>