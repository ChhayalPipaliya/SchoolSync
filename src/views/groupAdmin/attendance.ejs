<%- include('../partials/head') %>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/attendance' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="group-page-header flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Attendance Logs</span>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Group Student Attendance</h2>
          <p class="text-xs text-gray-500 mt-1">
            Consolidated recent student attendance records across assigned branches
          </p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
          <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Filter Branch:</label>
          <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px;" onchange="window.location.href = '/groupadmin/attendance?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
          <a href="/groupadmin/attendance/export<%= activeBranchId ? '?branchId=' + activeBranchId : '' %>" class="btn btn-secondary flex items-center gap-2 text-xs font-semibold" style="white-space: nowrap;">
            <i class="fa-solid fa-file-csv"></i> Export CSV
          </a>
        </div>
      </div>
      <div class="card">
        <div class="card-header bg-slate-50/20">
          <h4 class="card-title flex items-center gap-2">
            <i class="fa-solid fa-calendar-check text-teal-600"></i> Attendance Log (Recent)
          </h4>
        </div>
        <div class="card-body p-0">
          <% if (attendance.length === 0) { %>
            <div class="p-6 text-center text-gray-400">No attendance logs found in this scope.</div>
          <% } else { %>
            <table class="table">
              <thead>
                <tr>
                  <th>Student Name</th>
                  <th>Branch / School</th>
                  <th>Roll No</th>
                  <th>Date</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% attendance.forEach(att => { %>
                  <tr>
                    <td>
                      <div class="font-semibold text-gray-800 text-sm">
                        <%= att.first_name %> <%= att.last_name || '' %>
                      </div>
                    </td>
                    <td>
                      <div class="text-sm font-medium text-gray-700"><%= att.school_name %></div>
                      <% if (att.branch_name) { %>
                        <div class="text-xs text-gray-400"><%= att.branch_name %></div>
                      <% } %>
                    </td>
                    <td><%= att.roll_no || '-' %></td>
                    <td><%= new Date(att.date).toLocaleDateString('en-IN') %></td>
                    <td>
                      <% if (att.att_status === 'present') { %>
                        <span class="badge badge-success">Present</span>
                      <% } else if (att.att_status === 'absent') { %>
                        <span class="badge badge-secondary" style="background:#fee2e2; color:#b91c1c;">Absent</span>
                      <% } else { %>
                        <span class="badge badge-secondary" style="background:#fef3c7; color:#d97706;">Late</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <%- include('../partials/pagination.ejs') %>
          <% } %>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>