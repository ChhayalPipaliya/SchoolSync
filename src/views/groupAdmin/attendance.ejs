<%- include('../partials/head') %>
<style>
  .group-page-header-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 18px 22px;
    margin-bottom: 20px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .attendance-desktop-table {
    width: 100%;
    min-width: 750px;
    border-collapse: collapse;
  }

  .attendance-mobile-cards {
    display: none;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
  }

  .attendance-item-card-mobile {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 768px) {
    .group-page-header-card {
      padding: 16px 14px !important;
      margin-bottom: 14px !important;
    }
    .group-page-header-card h2 {
      font-size: 20px !important;
    }
    .group-filter-panel {
      width: 100% !important;
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 10px !important;
    }
    .group-filter-panel select {
      width: 100% !important;
      min-width: 100% !important;
    }
    .group-filter-panel a {
      width: 100% !important;
      justify-content: center !important;
      padding: 10px !important;
    }
    .attendance-desktop-table {
      display: none !important;
    }
    .attendance-mobile-cards {
      display: flex !important;
    }
  }

  [data-theme="dark"] .group-page-header-card,
  [data-theme="dark"] .card,
  .light-mode-disabled .group-page-header-card,
  .light-mode-disabled .card {
    background: #151D30 !important;
    border-color: #242F4D !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
  }
  [data-theme="dark"] .group-page-header-card h2,
  [data-theme="dark"] .card-title,
  .light-mode-disabled .group-page-header-card h2,
  .light-mode-disabled .card-title {
    color: #F1F5F9 !important;
  }
  [data-theme="dark"] .card-header,
  .light-mode-disabled .card-header {
    background: #151D30 !important;
    border-bottom-color: #242F4D !important;
  }
  [data-theme="dark"] .attendance-item-card-mobile,
  .light-mode-disabled .attendance-item-card-mobile {
    background: #101726 !important;
    border-color: #242F4D !important;
  }
  [data-theme="dark"] .attendance-item-card-mobile .student-name,
  .light-mode-disabled .attendance-item-card-mobile .student-name {
    color: #F1F5F9 !important;
  }
  [data-theme="dark"] select.form-input,
  .light-mode-disabled select.form-input {
    background: #101726 !important;
    border-color: #334155 !important;
    color: #F1F5F9 !important;
  }
</style>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/attendance' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="group-page-header-card flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Attendance Logs</span>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight" style="margin: 2px 0 4px 0;">Group Student Attendance</h2>
          <p class="text-xs text-gray-500 mt-1" style="margin: 0;">
            Consolidated recent student attendance records across assigned branches
          </p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
          <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Filter Branch:</label>
          <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px; border-radius: 8px; padding: 8px 12px; font-size: 13px; font-weight: 600;" onchange="window.location.href = '/groupadmin/attendance?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
          <a href="/groupadmin/attendance/export<%= activeBranchId ? '?branchId=' + activeBranchId : '' %>" class="btn btn-secondary flex items-center gap-2 text-xs font-semibold" style="white-space: nowrap; border-radius: 8px; padding: 8px 14px;">
            <i class="fa-solid fa-file-csv"></i> Export CSV
          </a>
        </div>
      </div>
      <div class="card" style="border-radius: 14px; overflow: hidden; border: 1px solid #E2E8F0;">
        <div class="card-header bg-slate-50/20" style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9;">
          <h4 class="card-title flex items-center gap-2" style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0;">
            <i class="fa-solid fa-calendar-check text-teal-600"></i> Attendance Log (Recent)
          </h4>
        </div>
        <div class="card-body p-0">
          <% if (attendance.length === 0) { %>
            <div class="p-6 text-center text-gray-400" style="padding: 36px 20px; font-size: 13px;">No attendance logs found in this scope.</div>
          <% } else { %>
            <div style="overflow-x: auto;">
              <table class="table attendance-desktop-table">
                <thead>
                  <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Student Name</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Branch / School</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Roll No</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Date</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% attendance.forEach(att => { %>
                    <tr style="border-bottom: 1px solid #F1F5F9;">
                      <td style="padding: 12px 16px;">
                        <div class="font-semibold text-gray-800 text-sm">
                          <%= att.first_name %> <%= att.last_name || '' %>
                        </div>
                      </td>
                      <td style="padding: 12px 16px;">
                        <div class="text-sm font-medium text-gray-700"><%= att.school_name %></div>
                        <% if (att.branch_name) { %>
                          <div class="text-xs text-gray-400"><%= att.branch_name %></div>
                        <% } %>
                      </td>
                      <td style="padding: 12px 16px;"><%= att.roll_no || '-' %></td>
                      <td style="padding: 12px 16px;"><%= new Date(att.date).toLocaleDateString('en-IN') %></td>
                      <td style="padding: 12px 16px;">
                        <% if (att.att_status === 'present') { %>
                          <span class="badge badge-success">Present</span>
                        <% } else if (att.att_status === 'absent') { %>
                          <span class="badge badge-secondary" style="background:#fee2e2; color:#b91c1c;">Absent</span>
                        <% } else { %>
                          <span class="badge badge-secondary" style="background:#fef3c7; color:#d97706;">Late</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="attendance-mobile-cards">
                <% attendance.forEach(att => { %>
                  <div class="attendance-item-card-mobile">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                      <div class="student-name" style="font-size: 14px; font-weight: 800; color: #0F172A;">
                        <%= att.first_name %> <%= att.last_name || '' %>
                      </div>
                      <% if (att.att_status === 'present') { %>
                        <span class="badge badge-success" style="font-size: 10px; padding: 3px 8px;">Present</span>
                      <% } else if (att.att_status === 'absent') { %>
                        <span class="badge badge-secondary" style="background:#fee2e2; color:#b91c1c; font-size: 10px; padding: 3px 8px;">Absent</span>
                      <% } else { %>
                        <span class="badge badge-secondary" style="background:#fef3c7; color:#d97706; font-size: 10px; padding: 3px 8px;">Late</span>
                      <% } %>
                    </div>
                    <div style="font-size: 12px; color: #475569; background: rgba(0,0,0,0.02); padding: 8px 10px; border-radius: 8px;">
                      <div style="font-weight: 700; color: #0891B2;"><%= att.school_name %></div>
                      <% if (att.branch_name) { %>
                        <div style="font-size: 11px; color: #64748B;"><%= att.branch_name %></div>
                      <% } %>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #F1F5F9; padding-top: 8px; font-size: 11.5px;">
                      <div>
                        <span style="color: #64748B; font-size: 10px; text-transform: uppercase;">Roll No:</span>
                        <strong style="color: #0F172A; margin-left: 4px;"><%= att.roll_no || '-' %></strong>
                      </div>
                      <div>
                        <span style="color: #64748B; font-size: 10px; text-transform: uppercase;"><i class="far fa-calendar-alt"></i> Date:</span>
                        <strong style="color: #0F172A; margin-left: 4px;"><%= new Date(att.date).toLocaleDateString('en-IN') %></strong>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
            <%- include('../partials/pagination.ejs') %>
          <% } %>
        </div>
      </div>
    </div>
</div>
</div>
<%- include('../partials/footer') %>