<%- include('../partials/head') %>
<style>
  .group-page-header-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 18px 22px;
    margin-bottom: 20px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .alerts-desktop-table {
    width: 100%;
    min-width: 750px;
    border-collapse: collapse;
  }

  .alerts-mobile-cards {
    display: none;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
  }

  .alert-item-card-mobile {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 768px) {
    .group-page-header-card {
      padding: 16px 14px !important;
      margin-bottom: 14px !important;
    }
    .group-page-header-card h2 {
      font-size: 20px !important;
    }
    .group-filter-panel {
      width: 100% !important;
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 10px !important;
    }
    .group-filter-panel select {
      width: 100% !important;
      min-width: 100% !important;
    }
    .alerts-desktop-table {
      display: none !important;
    }
    .alerts-mobile-cards {
      display: flex !important;
    }
  }

  [data-theme="dark"] .group-page-header-card,
  [data-theme="dark"] .card,
  .light-mode-disabled .group-page-header-card,
  .light-mode-disabled .card {
    background: #151D30 !important;
    border-color: #242F4D !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
  }
  [data-theme="dark"] .group-page-header-card h2,
  [data-theme="dark"] .card-title,
  .light-mode-disabled .group-page-header-card h2,
  .light-mode-disabled .card-title {
    color: #F1F5F9 !important;
  }
  [data-theme="dark"] .card-header,
  .light-mode-disabled .card-header {
    background: #151D30 !important;
    border-bottom-color: #242F4D !important;
  }
  [data-theme="dark"] .alert-item-card-mobile,
  .light-mode-disabled .alert-item-card-mobile {
    background: #101726 !important;
    border-color: #242F4D !important;
  }
  [data-theme="dark"] select.form-input,
  .light-mode-disabled select.form-input {
    background: #101726 !important;
    border-color: #334155 !important;
    color: #F1F5F9 !important;
  }
</style>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/alerts' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="group-page-header-card flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Transport & SOS</span>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight" style="margin: 2px 0 4px 0;">Group Safety Alerts</h2>
          <p class="text-xs text-gray-500 mt-1" style="margin: 0;">
            Consolidated emergency SOS and transport alerts across assigned branches
          </p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
          <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Filter Branch:</label>
          <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px; border-radius: 8px; padding: 8px 12px; font-size: 13px; font-weight: 600;" onchange="window.location.href = '/groupadmin/alerts?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="card" style="border-radius: 14px; overflow: hidden; border: 1px solid #E2E8F0;">
        <div class="card-header bg-slate-50/20" style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9;">
          <h4 class="card-title flex items-center gap-2" style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0;">
            <i class="fa-solid fa-triangle-exclamation text-teal-600"></i> Safety Alerts Log
          </h4>
        </div>
        <div class="card-body p-0">
          <% if (alerts.length === 0) { %>
            <div class="p-6 text-center text-gray-400" style="padding: 36px 20px; font-size: 13px;">No safety alerts found in this scope.</div>
          <% } else { %>
            <div style="overflow-x: auto;">
              <table class="table alerts-desktop-table">
                <thead>
                  <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Date / Time</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Branch / School</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Driver Name</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Alert Type</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% alerts.forEach(alert => { %>
                    <tr style="border-bottom: 1px solid #F1F5F9;">
                      <td style="padding: 12px 16px;">
                        <div class="font-semibold text-gray-800 text-sm">
                          <%= new Date(alert.created_at).toLocaleDateString('en-IN') %>
                        </div>
                        <div class="text-xs text-gray-400">
                          <%= new Date(alert.created_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                        </div>
                      </td>
                      <td style="padding: 12px 16px;">
                        <div class="text-sm font-medium text-gray-700"><%= alert.school_name %></div>
                        <% if (alert.branch_name) { %>
                          <div class="text-xs text-gray-400"><%= alert.branch_name %></div>
                        <% } %>
                      </td>
                      <td style="padding: 12px 16px;">
                        <div class="font-medium text-gray-800 text-sm">
                          <%= (alert.driver_first_name || alert.driver_last_name) ? (alert.driver_first_name + ' ' + (alert.driver_last_name || '')).trim() : '-' %>
                        </div>
                      </td>
                      <td style="padding: 12px 16px;">
                        <span class="text-xs font-semibold uppercase px-2 py-1 rounded bg-slate-100 text-slate-700" style="padding: 3px 8px; border-radius: 4px;">
                          <%= alert.alert_type || 'general' %>
                        </span>
                      </td>
                      <td style="padding: 12px 16px;">
                        <% if (alert.status === 'active') { %>
                          <span class="badge badge-secondary" style="background:#fee2e2; color:#b91c1c; padding: 3px 8px; font-size: 11px;">Active</span>
                        <% } else if (alert.status === 'acknowledged') { %>
                          <span class="badge badge-secondary" style="background:#fef3c7; color:#d97706; padding: 3px 8px; font-size: 11px;">Acknowledged</span>
                        <% } else { %>
                          <span class="badge badge-success" style="padding: 3px 8px; font-size: 11px;">Resolved</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="alerts-mobile-cards">
                <% alerts.forEach(alert => { %>
                  <div class="alert-item-card-mobile">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                      <span class="text-xs font-semibold uppercase px-2 py-1 rounded bg-slate-100 text-slate-700" style="padding: 3px 8px; border-radius: 4px; font-size: 10.5px;">
                        <i class="fa-solid fa-bell text-rose-500 mr-1"></i> <%= alert.alert_type || 'general' %>
                      </span>
                      <% if (alert.status === 'active') { %>
                        <span class="badge badge-secondary" style="background:#fee2e2; color:#b91c1c; font-size: 10px; padding: 3px 8px;">Active</span>
                      <% } else if (alert.status === 'acknowledged') { %>
                        <span class="badge badge-secondary" style="background:#fef3c7; color:#d97706; font-size: 10px; padding: 3px 8px;">Acknowledged</span>
                      <% } else { %>
                        <span class="badge badge-success" style="font-size: 10px; padding: 3px 8px;">Resolved</span>
                      <% } %>
                    </div>
                    <div style="font-size: 12px; color: #475569; background: rgba(0,0,0,0.02); padding: 8px 10px; border-radius: 8px;">
                      <div style="font-weight: 700; color: #0891B2;"><%= alert.school_name %></div>
                      <% if (alert.branch_name) { %>
                        <div style="font-size: 11px; color: #64748B;"><%= alert.branch_name %></div>
                      <% } %>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #F1F5F9; padding-top: 8px; font-size: 11.5px;">
                      <div>
                        <span style="color: #64748B; font-size: 10px; text-transform: uppercase;">Driver:</span>
                        <strong style="color: #0F172A; margin-left: 4px;">
                          <%= (alert.driver_first_name || alert.driver_last_name) ? (alert.driver_first_name + ' ' + (alert.driver_last_name || '')).trim() : '-' %>
                        </strong>
                      </div>
                      <div>
                        <span style="color: #64748B; font-size: 10px;"><i class="far fa-clock"></i></span>
                        <strong style="color: #0F172A; margin-left: 4px;">
                          <%= new Date(alert.created_at).toLocaleDateString('en-IN') %> <%= new Date(alert.created_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                        </strong>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
            <%- include('../partials/pagination.ejs') %>
          <% } %>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>