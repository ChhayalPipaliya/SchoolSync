<%- include('../partials/head') %>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/students' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="group-page-header flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Academic Records</span>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Group Students Directory</h2>
          <p class="text-xs text-gray-500 mt-1">
            Consolidated active students list across assigned branches
          </p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
          <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Filter Branch:</label>
          <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px;" onchange="window.location.href = '/groupadmin/students?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="card">
        <div class="card-header bg-slate-50/20">
          <h4 class="card-title flex items-center gap-2">
            <i class="fa-solid fa-graduation-cap text-teal-600"></i> Students Directory
          </h4>
        </div>
        <div class="card-body p-0">
          <% if (students.length === 0) { %>
            <div class="p-6 text-center text-gray-400">No active students found in this scope.</div>
          <% } else { %>
            <table class="table">
              <thead>
                <tr>
                  <th>Student Name</th>
                  <th>Branch / School</th>
                  <th>Admission No</th>
                  <th>Roll No</th>
                  <th>Standard</th>
                  <th>Parent Contact</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% students.forEach(student => { %>
                  <tr>
                    <td>
                      <div class="font-semibold text-gray-800 text-sm">
                        <%= student.first_name %> <%= student.last_name || '' %>
                      </div>
                      <div class="text-xs text-gray-400"><%= student.email || '-' %></div>
                    </td>
                    <td>
                      <div class="text-sm font-medium text-gray-700"><%= student.school_name %></div>
                      <% if (student.branch_name) { %>
                        <div class="text-xs text-gray-400"><%= student.branch_name %></div>
                      <% } %>
                    </td>
                    <td><span class="text-xs font-mono bg-slate-100 px-2 py-1 rounded"><%= student.admission_no || '-' %></span></td>
                    <td><%= student.roll_no || '-' %></td>
                    <td><%= student.standard || '-' %></td>
                    <td><%= student.phone || '-' %></td>
                    <td>
                      <span class="badge <%= student.status === 'active' ? 'badge-success' : 'badge-secondary' %>">
                        <%= student.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>