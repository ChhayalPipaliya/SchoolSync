<%- include('../partials/head') %>
<style>
  .branches-page-header {
    background: linear-gradient(135deg, #ecfeff, #ffffff);
    border: 1px solid #bae6fd;
    border-radius: 14px;
    padding: 18px 22px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .branches-kicker {
    font-size: 12px;
    font-weight: 800;
    color: #0f766e;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .branches-title {
    font-size: 24px;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
  }

  .branches-subtitle {
    font-size: 13px;
    color: #64748b;
    margin: 6px 0 0;
  }

  .branches-filter-panel {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .branches-filter-panel label {
    font-size: 12px;
    font-weight: 800;
    color: #64748b;
    white-space: nowrap;
    margin: 0;
  }

  .branches-filter-panel select {
    min-width: 260px;
    height: 40px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0 12px;
    color: #0f172a;
    background: #ffffff;
    outline: none;
  }

  .branches-stats-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 16px !important;
    margin-bottom: 22px !important;
    width: 100% !important;
  }

  .branches-stat-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    min-height: 116px;
  }

  .branches-stat-body {
    height: 100%;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .branches-stat-label {
    font-size: 12px;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .branches-stat-value {
    font-size: 28px;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
    line-height: 1;
  }

  .branches-stat-value.money {
    font-size: 24px;
  }

  .branches-stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 18px;
  }

  .branches-table-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    overflow: hidden;
  }

  .branches-table-header {
    padding: 16px 18px;
    border-bottom: 1px solid #e5e7eb;
    background: #f8fafc;
  }

  .branches-table-title {
    font-size: 16px;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .branches-table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .branches-table {
    width: 100%;
    min-width: 1050px;
    border-collapse: collapse;
  }

  .branches-table th {
    padding: 12px 14px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-align: left;
  }

  .branches-table td {
    padding: 14px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    font-size: 13px;
    vertical-align: middle;
    white-space: nowrap;
  }

  .branches-table tbody tr:hover {
    background: #f8fafc;
  }

  .branch-name {
    font-weight: 900;
    color: #0f172a;
    font-size: 14px;
  }

  .branch-code {
    color: #94a3b8;
    font-size: 12px;
    margin-top: 3px;
  }

  .branch-status {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .branch-status.active {
    background: #dcfce7;
    color: #166534;
  }

  .branch-status.inactive {
    background: #f1f5f9;
    color: #475569;
  }

  .text-danger {
    color: #dc2626 !important;
  }

  .text-dark {
    color: #0f172a !important;
  }

  .branches-empty {
    padding: 36px 16px;
    text-align: center;
    color: #94a3b8;
    font-size: 14px;
  }

  @media (max-width: 1200px) {
    .branches-stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  @media (max-width: 768px) {
    .branches-page-header {
      padding: 16px 14px !important;
      margin-bottom: 14px !important;
    }

    .branches-title {
      font-size: 20px !important;
    }

    .branches-subtitle {
      font-size: 12px !important;
    }

    .branches-filter-panel {
      width: 100% !important;
      flex-direction: column !important;
      align-items: stretch !important;
    }

    .branches-filter-panel select {
      width: 100% !important;
      min-width: 100% !important;
    }

    .branches-stats-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 10px !important;
      margin-bottom: 14px !important;
    }

    .branches-stat-card {
      min-height: 88px !important;
      border-radius: 12px !important;
    }

    .branches-stat-body {
      padding: 10px 12px !important;
      gap: 8px !important;
    }

    .branches-stat-label {
      font-size: 10px !important;
      margin-bottom: 4px !important;
    }

    .branches-stat-value {
      font-size: 20px !important;
    }

    .branches-stat-value.money {
      font-size: 15px !important;
    }

    .branches-stat-icon {
      width: 38px !important;
      height: 38px !important;
      font-size: 15px !important;
      border-radius: 10px !important;
    }

    .branches-desktop-table {
      display: none !important;
    }

    .branches-mobile-cards {
      display: flex !important;
      flex-direction: column;
      gap: 12px;
      padding: 12px;
    }

    .branch-card-mobile {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 12px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
  }

  [data-theme="dark"] .branch-card-mobile,
  .light-mode-disabled .branch-card-mobile {
    background: #101726 !important;
    border-color: #242F4D !important;
  }
  [data-theme="dark"] .branch-card-mobile .branch-name,
  .light-mode-disabled .branch-card-mobile .branch-name {
    color: #F1F5F9 !important;
  }

  [data-theme="dark"] .branches-page-header,
  .light-mode-disabled .branches-page-header,
  [data-theme="dark"] .branches-stat-card,
  .light-mode-disabled .branches-stat-card,
  [data-theme="dark"] .branches-table-card,
  .light-mode-disabled .branches-table-card {
    background: #151D30 !important;
    background-image: none !important;
    border-color: #242F4D !important;
  }

  [data-theme="dark"] .branches-kicker,
  .light-mode-disabled .branches-kicker {
    color: #2DD4BF !important;
  }

  [data-theme="dark"] .branches-title,
  .light-mode-disabled .branches-title,
  [data-theme="dark"] .branches-stat-value,
  .light-mode-disabled .branches-stat-value,
  [data-theme="dark"] .branches-table-title,
  .light-mode-disabled .branches-table-title,
  [data-theme="dark"] .branch-name,
  .light-mode-disabled .branch-name,
  [data-theme="dark"] .branches-table td strong,
  .light-mode-disabled .branches-table td strong,
  [data-theme="dark"] .text-dark,
  .light-mode-disabled .text-dark {
    color: #F1F5F9 !important;
  }

  [data-theme="dark"] .branches-subtitle,
  .light-mode-disabled .branches-subtitle,
  [data-theme="dark"] .branches-stat-label,
  .light-mode-disabled .branches-stat-label,
  [data-theme="dark"] .branch-code,
  .light-mode-disabled .branch-code,
  [data-theme="dark"] .branches-table th,
  .light-mode-disabled .branches-table th {
    color: #94A3B8 !important;
  }

  [data-theme="dark"] .branches-subtitle strong,
  .light-mode-disabled .branches-subtitle strong {
    color: #CBD5E1 !important;
  }

  [data-theme="dark"] .branches-filter-panel,
  .light-mode-disabled .branches-filter-panel {
    background: #101726 !important;
    border-color: #242F4D !important;
  }

  [data-theme="dark"] .branches-filter-panel label,
  .light-mode-disabled .branches-filter-panel label {
    color: #94A3B8 !important;
  }

  [data-theme="dark"] .branches-filter-panel select,
  .light-mode-disabled .branches-filter-panel select {
    background: #101726 !important;
    border-color: #334155 !important;
    color: #F1F5F9 !important;
  }

  [data-theme="dark"] .branches-table-header,
  .light-mode-disabled .branches-table-header,
  [data-theme="dark"] .branches-table th,
  .light-mode-disabled .branches-table th {
    background: #101726 !important;
    border-bottom-color: #242F4D !important;
  }

  [data-theme="dark"] .branches-table td,
  .light-mode-disabled .branches-table td {
    border-bottom-color: #242F4D !important;
    color: #E2E8F0 !important;
  }

  [data-theme="dark"] .branches-table tbody tr:hover,
  .light-mode-disabled .branches-table tbody tr:hover {
    background: #1E293B !important;
  }

  [data-theme="dark"] .branches-stat-icon[style*="eff6ff"],
  .light-mode-disabled .branches-stat-icon[style*="eff6ff"] {
    background: rgba(59, 130, 246, 0.15) !important;
    color: #60A5FA !important;
  }

  [data-theme="dark"] .branches-stat-icon[style*="ecfdf5"],
  .light-mode-disabled .branches-stat-icon[style*="ecfdf5"] {
    background: rgba(16, 185, 129, 0.15) !important;
    color: #34D399 !important;
  }

  [data-theme="dark"] .branches-stat-icon[style*="fef2f2"],
  .light-mode-disabled .branches-stat-icon[style*="fef2f2"] {
    background: rgba(239, 68, 68, 0.15) !important;
    color: #F87171 !important;
  }

  [data-theme="dark"] .branch-status.active,
  .light-mode-disabled .branch-status.active {
    background: rgba(16, 185, 129, 0.15) !important;
    color: #34D399 !important;
  }

  [data-theme="dark"] .branch-status.inactive,
  .light-mode-disabled .branch-status.inactive {
    background: #1E293B !important;
    color: #94A3B8 !important;
  }
</style>
<%
  const safeBranches = Array.isArray(branches) ? branches : [];
  const safeBranchesList = Array.isArray(branchesList) ? branchesList : [];
  const safeStats = stats || {};
%>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/branches' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="branches-page-header">
        <div>
          <div class="branches-kicker">Assigned Schools</div>
          <h2 class="branches-title"> Assigned Branches</h2>
          <p class="branches-subtitle">
            <%= groupContext ? groupContext.group_name : 'School Group' %>
            <% if (groupContext && groupContext.owner_name) { %>
              · Owner:
              <strong style="color:#334155;"><%= groupContext.owner_name %></strong>
            <% } %>
          </p>
        </div>
        <div class="branches-filter-panel">
          <label for="branchFilterSelect">Filter Branch:</label>
          <select id="branchFilterSelect" onchange="window.location.href = '/groupadmin/branches?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% safeBranches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %><%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="branches-stats-grid">
        <div class="branches-stat-card">
          <div class="branches-stat-body">
            <div>
              <p class="branches-stat-label">Branches</p>
              <h3 class="branches-stat-value"><%= safeStats.total_branches || 0 %></h3>
            </div>
            <div class="branches-stat-icon" style="background-color: var(--role-primary-light); color: var(--role-primary-dark);">
              <i class="fa-solid fa-code-branch"></i>
            </div>
          </div>
        </div>
        <div class="branches-stat-card">
          <div class="branches-stat-body">
            <div>
              <p class="branches-stat-label">Students</p>
              <h3 class="branches-stat-value"><%= safeStats.total_students || 0 %></h3>
            </div>
            <div class="branches-stat-icon" style="background:#eff6ff;color:#2563eb;">
              <i class="fa-solid fa-user-graduate"></i>
            </div>
          </div>
        </div>
        <div class="branches-stat-card">
          <div class="branches-stat-body">
            <div>
              <p class="branches-stat-label">Teachers</p>
              <h3 class="branches-stat-value"><%= safeStats.total_teachers || 0 %></h3>
            </div>
            <div class="branches-stat-icon" style="background:#ecfdf5;color:#059669;">
              <i class="fa-solid fa-chalkboard-teacher"></i>
            </div>
          </div>
        </div>
        <div class="branches-stat-card">
          <div class="branches-stat-body">
            <div>
              <p class="branches-stat-label">Pending Fees</p>
              <h3 class="branches-stat-value money">
                ₹<%= Number(safeStats.pending_fees || 0).toLocaleString('en-IN') %>
              </h3>
            </div>
            <div class="branches-stat-icon" style="background:#fef2f2;color:#dc2626;">
              <i class="fa-solid fa-money-check-alt"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="branches-table-card">
        <div class="branches-table-header">
          <h4 class="branches-table-title">
            <i class="fa-solid fa-network-wired" style="color:#0f766e;"></i>
            Branches / Schools List
          </h4>
        </div>
        <% if (!safeBranchesList || safeBranchesList.length === 0) { %>
          <div class="branches-empty">
            No schools assigned.
          </div>
        <% } else { %>
          <div class="branches-table-wrap">
            <table class="branches-table branches-desktop-table">
              <thead>
                <tr>
                  <th>School / Branch</th>
                  <th>Area</th>
                  <th>Students</th>
                  <th>Teachers</th>
                  <th>Active Buses</th>
                  <th>Library Books</th>
                  <th>Pending Fees</th>
                  <th>Status</th>
                  <th style="text-align:center;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% safeBranchesList.forEach(branch => { %>
                  <tr>
                    <td>
                      <div class="branch-name">
                        <%= branch.school_name || '-' %>
                      </div>
                      <div class="branch-code">
                        <%= branch.branch_name || 'Main Branch' %>
                        <% if (branch.branch_code) { %>
                          · Code: <%= branch.branch_code %>
                        <% } %>
                      </div>
                    </td>
                    <td><%= branch.area || '-' %></td>
                    <td>
                      <strong style="color:#0f172a;">
                        <%= branch.student_count || 0 %>
                      </strong>
                    </td>
                    <td>
                      <strong style="color:#0f172a;">
                        <%= branch.teacher_count || 0 %>
                      </strong>
                    </td>
                    <td>
                      <strong style="color:#0f172a;">
                        <%= branch.active_buses || 0 %>
                      </strong>
                    </td>
                    <td>
                      <strong style="color:#0f172a;">
                        <%= branch.library_books || 0 %>
                      </strong>
                    </td>
                    <td>
                      <strong class="<%= Number(branch.pending_fees || 0) > 0 ? 'text-danger' : 'text-dark' %>">
                        ₹<%= Number(branch.pending_fees || 0).toLocaleString('en-IN') %>
                      </strong>
                    </td>
                    <td>
                      <span class="branch-status <%= branch.status === 'active' ? 'active' : 'inactive' %>">
                        <%= branch.status || '-' %>
                      </span>
                    </td>
                    <td style="text-align:center;">
                      <a href="/groupadmin/branch/<%= branch.id %>/overview" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-eye mr-1"></i>
                        View Overview
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <div class="branches-mobile-cards" style="display:none;">
              <% safeBranchesList.forEach(branch => { %>
                <div class="branch-card-mobile">
                  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
                    <div>
                      <div class="branch-name" style="font-size:15px; font-weight:800; color:#0F172A;">
                        <%= branch.school_name || '-' %>
                      </div>
                      <div class="branch-code" style="font-size:11.5px; color:#64748B; margin-top:2px;">
                        <%= branch.branch_name || 'Main Branch' %>
                        <% if (branch.branch_code) { %>
                          · Code: <%= branch.branch_code %>
                        <% } %>
                        <% if (branch.area) { %>
                          · <i class="fas fa-map-marker-alt" style="color:#0891B2;"></i> <%= branch.area %>
                        <% } %>
                      </div>
                    </div>
                    <span class="branch-status <%= branch.status === 'active' ? 'active' : 'inactive' %>">
                      <%= branch.status || '-' %>
                    </span>
                  </div>
                  <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:8px; background:rgba(0,0,0,0.03); padding:10px 12px; border-radius:10px; font-size:11.5px;">
                    <div>
                      <span style="color:#64748B; font-size:10px; text-transform:uppercase;">Students:</span>
                      <strong style="font-size:13px; color:#0F172A; margin-left:4px;"><%= branch.student_count || 0 %></strong>
                    </div>
                    <div>
                      <span style="color:#64748B; font-size:10px; text-transform:uppercase;">Teachers:</span>
                      <strong style="font-size:13px; color:#0F172A; margin-left:4px;"><%= branch.teacher_count || 0 %></strong>
                    </div>
                    <div>
                      <span style="color:#64748B; font-size:10px; text-transform:uppercase;">Buses:</span>
                      <strong style="font-size:13px; color:#0F172A; margin-left:4px;"><%= branch.active_buses || 0 %></strong>
                    </div>
                    <div>
                      <span style="color:#64748B; font-size:10px; text-transform:uppercase;">Books:</span>
                      <strong style="font-size:13px; color:#0F172A; margin-left:4px;"><%= branch.library_books || 0 %></strong>
                    </div>
                  </div>
                  <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid #F1F5F9; padding-top:8px;">
                    <div>
                      <span style="font-size:10.5px; color:#64748B; text-transform:uppercase; font-weight:700;">Pending Fees:</span>
                      <strong class="<%= Number(branch.pending_fees || 0) > 0 ? 'text-danger' : 'text-dark' %>" style="font-size:13px; margin-left:4px;">
                        ₹<%= Number(branch.pending_fees || 0).toLocaleString('en-IN') %>
                      </strong>
                    </div>
                    <a href="/groupadmin/branch/<%= branch.id %>/overview" class="btn btn-sm btn-primary" style="padding:6px 12px; font-size:11px; font-weight:700; border-radius:6px; display:inline-flex; align-items:center; gap:4px;">
                      <i class="fa-solid fa-eye"></i> Overview
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>