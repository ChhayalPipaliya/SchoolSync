<%- include('../partials/head') %>
<style>
  .branches-page-header {
    background: linear-gradient(135deg, #ecfeff, #ffffff);
    border: 1px solid #bae6fd;
    border-radius: 14px;
    padding: 18px 22px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .branches-kicker {
    font-size: 12px;
    font-weight: 800;
    color: #0f766e;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .branches-title {
    font-size: 24px;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
  }

  .branches-subtitle {
    font-size: 13px;
    color: #64748b;
    margin: 6px 0 0;
  }

  .branches-filter-panel {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .branches-filter-panel label {
    font-size: 12px;
    font-weight: 800;
    color: #64748b;
    white-space: nowrap;
    margin: 0;
  }

  .branches-filter-panel select {
    min-width: 260px;
    height: 40px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0 12px;
    color: #0f172a;
    background: #ffffff;
    outline: none;
  }

  .branches-stats-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 16px !important;
    margin-bottom: 22px !important;
    width: 100% !important;
  }

  .branches-stat-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    min-height: 116px;
  }

  .branches-stat-body {
    height: 100%;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .branches-stat-label {
    font-size: 12px;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .branches-stat-value {
    font-size: 28px;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
    line-height: 1;
  }

  .branches-stat-value.money {
    font-size: 24px;
  }

  .branches-stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 18px;
  }

  .branches-table-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    overflow: hidden;
  }

  .branches-table-header {
    padding: 16px 18px;
    border-bottom: 1px solid #e5e7eb;
    background: #f8fafc;
  }

  .branches-table-title {
    font-size: 16px;
    font-weight: 900;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .branches-table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  .branches-table {
    width: 100%;
    min-width: 1050px;
    border-collapse: collapse;
  }

  .branches-table th {
    padding: 12px 14px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-align: left;
  }

  .branches-table td {
    padding: 14px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    font-size: 13px;
    vertical-align: middle;
    white-space: nowrap;
  }

  .branches-table tbody tr:hover {
    background: #f8fafc;
  }

  .branch-name {
    font-weight: 900;
    color: #0f172a;
    font-size: 14px;
  }

  .branch-code {
    color: #94a3b8;
    font-size: 12px;
    margin-top: 3px;
  }

  .branch-status {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .branch-status.active {
    background: #dcfce7;
    color: #166534;
  }

  .branch-status.inactive {
    background: #f1f5f9;
    color: #475569;
  }

  .text-danger {
    color: #dc2626 !important;
  }

  .text-dark {
    color: #0f172a !important;
  }

  .branches-empty {
    padding: 36px 16px;
    text-align: center;
    color: #94a3b8;
    font-size: 14px;
  }

  @media (max-width: 1200px) {
    .branches-stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
  }

  @media (max-width: 640px) {
    .branches-stats-grid {
      grid-template-columns: 1fr !important;
    }

    .branches-page-header {
      align-items: stretch;
    }

    .branches-filter-panel {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .branches-filter-panel select {
      width: 100%;
      min-width: 100%;
    }
  }
</style>
<%
  const safeBranches = Array.isArray(branches) ? branches : [];
  const safeBranchesList = Array.isArray(branchesList) ? branchesList : [];
  const safeStats = stats || {};
%>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/branches' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="branches-page-header">
        <div>
          <div class="branches-kicker">Assigned Schools</div>
          <h2 class="branches-title"> Assigned Branches</h2>
          <p class="branches-subtitle">
            <%= groupContext ? groupContext.group_name : 'School Group' %>
            <% if (groupContext && groupContext.owner_name) { %>
              · Owner:
              <strong style="color:#334155;"><%= groupContext.owner_name %></strong>
            <% } %>
          </p>
        </div>
        <div class="branches-filter-panel">
          <label for="branchFilterSelect">Filter Branch:</label>
          <select id="branchFilterSelect" onchange="window.location.href = '/groupadmin/branches?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% safeBranches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %><%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="branches-stats-grid">
        <div class="branches-stat-card">
          <div class="branches-stat-body">
            <div>
              <p class="branches-stat-label">Branches</p>
              <h3 class="branches-stat-value"><%= safeStats.total_branches || 0 %></h3>
            </div>
            <div class="branches-stat-icon" style="background-color: var(--role-primary-light); color: var(--role-primary-dark);">
              <i class="fa-solid fa-code-branch"></i>
            </div>
          </div>
        </div>
        <div class="branches-stat-card">
          <div class="branches-stat-body">
            <div>
              <p class="branches-stat-label">Students</p>
              <h3 class="branches-stat-value"><%= safeStats.total_students || 0 %></h3>
            </div>
            <div class="branches-stat-icon" style="background:#eff6ff;color:#2563eb;">
              <i class="fa-solid fa-user-graduate"></i>
            </div>
          </div>
        </div>
        <div class="branches-stat-card">
          <div class="branches-stat-body">
            <div>
              <p class="branches-stat-label">Teachers</p>
              <h3 class="branches-stat-value"><%= safeStats.total_teachers || 0 %></h3>
            </div>
            <div class="branches-stat-icon" style="background:#ecfdf5;color:#059669;">
              <i class="fa-solid fa-chalkboard-teacher"></i>
            </div>
          </div>
        </div>
        <div class="branches-stat-card">
          <div class="branches-stat-body">
            <div>
              <p class="branches-stat-label">Pending Fees</p>
              <h3 class="branches-stat-value money">
                ₹<%= Number(safeStats.pending_fees || 0).toLocaleString('en-IN') %>
              </h3>
            </div>
            <div class="branches-stat-icon" style="background:#fef2f2;color:#dc2626;">
              <i class="fa-solid fa-money-check-alt"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="branches-table-card">
        <div class="branches-table-header">
          <h4 class="branches-table-title">
            <i class="fa-solid fa-network-wired" style="color:#0f766e;"></i>
            Branches / Schools List
          </h4>
        </div>
        <% if (!safeBranchesList || safeBranchesList.length === 0) { %>
          <div class="branches-empty">
            No schools assigned.
          </div>
        <% } else { %>
          <div class="branches-table-wrap">
            <table class="branches-table">
              <thead>
                <tr>
                  <th>School / Branch</th>
                  <th>Area</th>
                  <th>Students</th>
                  <th>Teachers</th>
                  <th>Active Buses</th>
                  <th>Library Books</th>
                  <th>Pending Fees</th>
                  <th>Status</th>
                  <th style="text-align:center;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% safeBranchesList.forEach(branch => { %>
                  <tr>
                    <td>
                      <div class="branch-name">
                        <%= branch.school_name || '-' %>
                      </div>
                      <div class="branch-code">
                        <%= branch.branch_name || 'Main Branch' %>
                        <% if (branch.branch_code) { %>
                          · Code: <%= branch.branch_code %>
                        <% } %>
                      </div>
                    </td>
                    <td><%= branch.area || '-' %></td>
                    <td>
                      <strong style="color:#0f172a;">
                        <%= branch.student_count || 0 %>
                      </strong>
                    </td>
                    <td>
                      <strong style="color:#0f172a;">
                        <%= branch.teacher_count || 0 %>
                      </strong>
                    </td>
                    <td>
                      <strong style="color:#0f172a;">
                        <%= branch.active_buses || 0 %>
                      </strong>
                    </td>
                    <td>
                      <strong style="color:#0f172a;">
                        <%= branch.library_books || 0 %>
                      </strong>
                    </td>
                    <td>
                      <strong class="<%= Number(branch.pending_fees || 0) > 0 ? 'text-danger' : 'text-dark' %>">
                        ₹<%= Number(branch.pending_fees || 0).toLocaleString('en-IN') %>
                      </strong>
                    </td>
                    <td>
                      <span class="branch-status <%= branch.status === 'active' ? 'active' : 'inactive' %>">
                        <%= branch.status || '-' %>
                      </span>
                    </td>
                    <td style="text-align:center;">
                      <a href="/groupadmin/branch/<%= branch.id %>/overview" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-eye mr-1"></i>
                        View Overview
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>