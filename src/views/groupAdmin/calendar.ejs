                    <label><%- lan.Description_Notes %></label>
                    <textarea id="eventDesc" placeholder="<%= lan.Event_Desc_Placeholder %>"></textarea>
                </div>
            </div>
            <div class="cal-modal-footer">
                <button id="deleteEventBtn" onclick="deleteEvent()" style="display:none;"
                    class="btn-cal btn-cal-danger">
                    <i class="fa-solid fa-trash me-1"></i> <%- lan.Delete %>
                </button>
                <button onclick="closeModal()" class="btn-cal btn-cal-ghost"><%- lan.Cancel %></button>
                <button onclick="saveEvent()" id="saveBtn" class="btn-cal btn-cal-primary" style="min-width:120px;">
                    <span id="saveBtnText"><i class="fa-solid fa-check me-1"></i> <%- lan.Save_Event %></span>
                    <span id="saveBtnLoading" style="display:none;"><i class="fa-solid fa-spinner fa-spin me-1"></i> <%-
                            lan.Saving %></span>
                </button>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script>
        const TYPE_COLORS = {
            Holiday: '#EF4444',
            Exam: '#F59E0B',
            Event: '#3B82F6',
            Meeting: '#8B5CF6',
            Note: '#06B6D4'
        };

        let calendar;
        let selectedColor = '#3B82F6';

        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar');
            calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next title today',
                    center: '',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
                },
                height: 'auto',
                contentHeight: 700,
                nowIndicator: true,
                editable: false,
                selectable: true,
                dayMaxEvents: 3,
                eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
                buttonText: { prev: '‹', next: '›', today: 'Today', month: 'Month', week: 'Week', day: 'Day', list: 'List' },

                events: function (fetchInfo, successCallback, failureCallback) {
                    const schoolId = document.getElementById('schoolFilter').value;
                    fetch(`/groupadmin/api/academic-events?school_id=${schoolId}&start=${fetchInfo.startStr}&end=${fetchInfo.endStr}`)
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                successCallback(data.events);
                                updateStats(data.events);
                            } else {
                                failureCallback(data.message);
                            }
                        })
                        .catch(err => failureCallback(err));
                },

                eventClick: function (info) {
                    const e = info.event;
                    openEditModal({
                        id: e.id,
                        title: e.title,
                        start: e.startStr,
                        end: e.endStr,
                        color: e.backgroundColor,
                        description: e.extendedProps.description,
                        event_type: e.extendedProps.event_type,
                        target_audience: e.extendedProps.target_audience,
                        school_id: e.extendedProps.school_id,
                        status: e.extendedProps.status
                    });
                },

                dateClick: function (info) {
                    openAddModal(info.dateStr);
                },

                eventDidMount: function (info) {
                    const ep = info.event.extendedProps || {};
                    const type = ep.event_type || 'Event';
                    const isPending = ep.status === 'pending';
                    info.el.classList.add(`fc-event-${type.toLowerCase()}`);
                    const typeBadges = {
                        Holiday: { bg: '#FEE2E2', color: '#991B1B', border: '#EF4444' },
                        Exam: { bg: '#FEF3C7', color: '#92400E', border: '#F59E0B' },
                        Event: { bg: '#E0F2FE', color: '#075985', border: '#0EA5E9' },
                        Meeting: { bg: '#EDE9FE', color: '#5B21B6', border: '#8B5CF6' },
                        Note: { bg: '#CFFAFE', color: '#155E75', border: '#06B6D4' }
                    };
                    const badge = isPending
                        ? { bg: '#F1F5F9', color: '#334155', border: '#94A3B8' }
                        : (typeBadges[type] || typeBadges.Event);

                    if (!info.event.backgroundColor || info.event.backgroundColor === '#0EA5E9' || info.event.backgroundColor === '#3B82F6') {
                        info.el.style.backgroundColor = badge.bg;
                        info.el.style.color = badge.color;
                        info.el.style.borderLeft = `${isPending ? '3px dashed' : '3.5px solid'} ${badge.border}`;
                    } else {
                        info.el.style.borderLeft = `3.5px solid ${badge.border}`;
                    }
                    info.el.style.borderRadius = '6px';
                    info.el.style.fontWeight = '600';
                    info.el.style.boxShadow = '0 1px 3px rgba(0,0,0,0.05)';
                },

                eventContent: function (arg) {
                    const ep = arg.event.extendedProps || {};
                    const type = ep.event_type || 'Event';
                    const isPending = ep.status === 'pending';
                    const typeIcons = {
                        Holiday: 'fa-umbrella-beach',
                        Exam: 'fa-file-pen',
                        Event: 'fa-sparkles',
                        Meeting: 'fa-comments'
                    };
                    const iconClass = isPending ? 'fa-lightbulb' : (typeIcons[type] || 'fa-calendar-day');
                    return {
                        html: `<div style="display:flex;align-items:center;gap:5px;padding:2px 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11.5px;">
                        <i class="fa-solid ${iconClass}" style="font-size:10.5px;opacity:0.85;"></i>
                        <span style="overflow:hidden;text-overflow:ellipsis;">${arg.event.title}</span>
                    </div>`
                    };
                }
            });
            calendar.render();
        });

        function updateStats(events) {
            const now = new Date();
            const thirtyDays = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);
            const thisMonth = now.getMonth();

            document.getElementById('statTotalEvents').textContent = events.length;

            const exams = events.filter(e => e.extendedProps?.event_type === 'Exam' && new Date(e.start) >= now && new Date(e.start) <= thirtyDays);
            document.getElementById('statUpcomingExams').textContent = exams.length;

            const holidays = events.filter(e => e.extendedProps?.event_type === 'Holiday' && new Date(e.start).getMonth() === thisMonth);
            document.getElementById('statHolidays').textContent = holidays.length;
        };

        function reloadCalendar() {
            if (calendar) calendar.refetchEvents();
        };

        function openAddModal(dateStr) {
            document.getElementById('modalTitleText').textContent = '<%= lan.Add_Event_Note %>';
            document.getElementById('modalIcon').style.background = 'linear-gradient(135deg,#0EA5E9,#0284C7)';
            document.getElementById('modalIcon').innerHTML = '<i class="fa-solid fa-calendar-plus"></i>';
            document.getElementById('eventId').value = '';
            document.getElementById('eventSchoolId').value = 'all';
            document.getElementById('eventTitle').value = '';
            document.getElementById('eventDesc').value = '';
            document.getElementById('eventType').value = 'Event';
            document.getElementById('eventAudience').value = 'All';
            document.getElementById('deleteEventBtn').style.display = 'none';

            const now = dateStr ? new Date(dateStr) : new Date();
            document.getElementById('eventStart').value = now.toISOString().slice(0, 16);
            document.getElementById('eventEnd').value = '';

            setColor('#3B82F6');
            document.getElementById('eventModal').classList.add('active');
            document.getElementById('eventTitle').focus();
        };

        function openEditModal(ev) {
            document.getElementById('eventId').value = ev.id;
            document.getElementById('modalTitleText').textContent = '<%= lan.Edit_Event_Note %>';
            document.getElementById('modalIcon').style.background = 'linear-gradient(135deg,#0EA5E9,#0284C7)';
            document.getElementById('modalIcon').innerHTML = '<i class="fa-solid fa-pen-to-square"></i>';
            document.getElementById('eventTitle').value = ev.title.replace(/^\[.*?\]\s*/, '');
            document.getElementById('eventDesc').value = ev.description || '';
            document.getElementById('eventType').value = ev.event_type || 'Event';
            document.getElementById('eventAudience').value = ev.target_audience || 'All';
            if (ev.school_id) document.getElementById('eventSchoolId').value = ev.school_id;
            document.getElementById('eventStart').value = ev.start ? ev.start.substring(0, 16) : '';
            document.getElementById('eventEnd').value = ev.end ? ev.end.substring(0, 16) : '';
            document.getElementById('deleteEventBtn').style.display = 'inline-flex';
            setColor(ev.color || '#3B82F6');
            document.getElementById('eventModal').classList.add('active');
        };

        function closeModal() {
            document.getElementById('eventModal').classList.remove('active');
        };

        document.getElementById('eventModal').addEventListener('click', function (e) {
            if (e.target === this) closeModal();
        });

        function setColor(color) {
            selectedColor = color;
            document.getElementById('eventColor').value = color;
            document.querySelectorAll('.color-swatch').forEach(s => {
                s.classList.toggle('active', s.dataset.color === color);
            });
        };

        function selectColor(el) {
            selectedColor = el.dataset.color;
            document.getElementById('eventColor').value = selectedColor;
            document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
            el.classList.add('active');
        };

        function customColorPick(input) {
            selectedColor = input.value;
            document.getElementById('eventColor').value = selectedColor;
            document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
        };

        function onTypeChange() {
            const type = document.getElementById('eventType').value;
            const defaultColor = TYPE_COLORS[type] || '#3B82F6';
            setColor(defaultColor);
        };

        function toggleFilter(chip) {
            chip.classList.toggle('active');
        };

        async function saveEvent() {
            const id = document.getElementById('eventId').value;
            const school_id = document.getElementById('eventSchoolId').value;
            const title = document.getElementById('eventTitle').value.trim();
            const start_date = document.getElementById('eventStart').value;

            if (!title) return showToast('Please enter an event title.', 'error');
            if (!start_date) return showToast('Please select a start date.', 'error');

            const payload = {
                school_id,
                title,
                description: document.getElementById('eventDesc').value,
                start_date,
                end_date: document.getElementById('eventEnd').value || null,
                event_type: document.getElementById('eventType').value,
                color: document.getElementById('eventColor').value,
                target_audience: document.getElementById('eventAudience').value
            };

            setSavingState(true);
            try {
                const url = id ? `/groupadmin/api/academic-events/${id}` : '/groupadmin/api/academic-events';
                const method = id ? 'PUT' : 'POST';

                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (data.success) {
                    closeModal();
                    reloadCalendar();
                    showToast(data.message || 'Event saved successfully!', 'success');
                } else {
                    showToast(data.message || 'Failed to save event', 'error');
                };
            } catch (err) {
                showToast('Network error. Please try again.', 'error');
            } finally {
                setSavingState(false);
            };
        };

        async function deleteEvent() {
            const id = document.getElementById('eventId').value;
            if (!id || !confirm('Are you sure you want to delete this event?')) return;

            try {
                const res = await fetch(`/groupadmin/api/academic-events/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    closeModal();
                    reloadCalendar();
                    showToast('Event deleted successfully', 'success');
                } else {
                    showToast(data.message || 'Failed to delete event', 'error');
                };
            } catch (err) {
                showToast('Network error. Please try again.', 'error');
            };
        };

        function setSavingState(saving) {
            document.getElementById('saveBtn').disabled = saving;
            document.getElementById('saveBtnText').style.display = saving ? 'none' : 'inline';
            document.getElementById('saveBtnLoading').style.display = saving ? 'inline' : 'none';
        };

        function showToast(msg, type) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `cal-toast cal-toast-${type}`;
            const icon = type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation';
            toast.innerHTML = `<i class="fa-solid ${icon}"></i>${msg}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(30px)';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        };

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeModal();
        });
    </script>