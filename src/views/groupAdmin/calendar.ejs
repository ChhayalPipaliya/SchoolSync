    <div class="cal-modal-backdrop" id="eventModal">
        <div class="cal-modal">
            <div class="cal-modal-header">
                <h5 id="modalTitle">
                    <span class="modal-header-icon" id="modalIcon"
                        style="background:linear-gradient(135deg,#0EA5E9,#0284C7);">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </span>
                    <span id="modalTitleText"><%- lan.Add_Event_Note %></span>
                </h5>
                <button class="modal-close" onclick="closeModal()" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="cal-modal-body">
                <input type="hidden" id="eventId">
                <div class="cal-form-group">
                    <label><%- lan.Target_School %> *</label>
                    <select id="eventSchoolId">
                        <option value="all">🌐 <%- lan.All_Schools_In_Group %></option>
                        <% schools.forEach(s=> { %>
                            <option value="<%= s.id %>">🏫 <%= s.school_name %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div class="cal-form-group">
                    <label><%- lan.Event_Note_Title %> *</label>
                    <input type="text" id="eventTitle" placeholder="<%= lan.Event_Title_Placeholder %>" maxlength="255">
                </div>
                <div class="form-row">
                    <div class="cal-form-group">
                        <label><%- lan.Start_Date_Time %> *</label>
                        <input type="datetime-local" id="eventStart">
                    </div>
                    <div class="cal-form-group">
                        <label><%- lan.End_Date_Time %></label>
                        <input type="datetime-local" id="eventEnd">
                    </div>
                </div>
                <div class="form-row">
                    <div class="cal-form-group">
                        <label><%- lan.Type %></label>
                        <select id="eventType" onchange="onTypeChange()">
                            <option value="Event">🎉 <%- lan.Event %></option>
                            <option value="Holiday">🏖️ <%- lan.Holiday %></option>
                            <option value="Exam">📝 <%- lan.Exam %></option>
                            <option value="Meeting">🤝 <%- lan.Meeting %></option>
                            <option value="Note">📌 <%- lan.Note_Announcement %></option>
                        </select>
                    </div>
                    <div class="cal-form-group">
                        <label><%- lan.Visible_To %></label>
                        <select id="eventAudience">
                            <option value="All">👥 <%- lan.Audience_All %></option>
                            <option value="Students">🎓 <%- lan.Audience_Students_Parents %></option>
                            <option value="Teachers">👨‍🏫 <%- lan.Audience_Teachers_Only %></option>
                            <option value="Staff">🏢 <%- lan.Audience_Staff_Only %></option>
                        </select>
                    </div>
                </div>
                <div class="cal-form-group">
                    <label><%- lan.Color_Tag %></label>
                    <div class="color-row" id="colorSwatches">
                        <div class="color-swatch active" style="background:#3B82F6;" data-color="#3B82F6"
                            onclick="selectColor(this)"></div>
                        <div class="color-swatch" style="background:#EF4444;" data-color="#EF4444"
                            onclick="selectColor(this)"></div>
                        <div class="color-swatch" style="background:#F59E0B;" data-color="#F59E0B"
                            onclick="selectColor(this)"></div>
                        <div class="color-swatch" style="background:#10B981;" data-color="#10B981"
                            onclick="selectColor(this)"></div>
                        <div class="color-swatch" style="background:#8B5CF6;" data-color="#8B5CF6"
                            onclick="selectColor(this)"></div>
                        <div class="color-swatch" style="background:#EC4899;" data-color="#EC4899"
                            onclick="selectColor(this)"></div>
                        <div class="color-swatch" style="background:#14B8A6;" data-color="#14B8A6"
                            onclick="selectColor(this)"></div>
                        <div class="color-swatch" style="background:#F97316;" data-color="#F97316"
                            onclick="selectColor(this)"></div>
                        <input type="color" class="custom-color-input" id="customColor" title="Custom color"
                            value="#3B82F6" onchange="customColorPick(this)">
