<%- include('../partials/head', { needsCharts: true }) %>
<style>
    .group-dashboard-grid {
        display: grid !important;
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        gap: 16px !important;
        margin-bottom: 16px !important;
        width: 100% !important;
    }

    [data-theme="dark"] .group-dashboard-card,
    [data-theme="dark"] .group-table-card,
    [data-theme="dark"] .group-filter-panel,
    [data-theme="dark"] .group-page-header,
    [data-theme="dark"] .card {
        background: #151D30 !important;
        border-color: #242F4D !important;
        color: #F1F5F9 !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
    }
    [data-theme="dark"] .group-dashboard-value,
    [data-theme="dark"] .group-dashboard-card strong,
    [data-theme="dark"] .group-page-header h2,
    [data-theme="dark"] .group-filter-panel label {
        color: #F1F5F9 !important;
    }
    [data-theme="dark"] .group-dashboard-label {
        color: #94A3B8 !important;
    }
    [data-theme="dark"] .sidebar {
        background: #151D30 !important;
        border-right-color: #242F4D !important;
    }

    .group-dashboard-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        min-height: 118px;
        width: 100%;
    }

    .group-dashboard-card-body {
        height: 100%;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .group-dashboard-label {
        font-size: 12px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin: 0 0 8px;
        line-height: 1.2;
    }

    .group-dashboard-value {
        font-size: 28px;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
        line-height: 1;
    }

    .group-dashboard-value.money {
        font-size: 24px;
    }

    .group-dashboard-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 18px;
    }

    .group-chart-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .group-table-card {
        overflow: hidden;
    }

    .group-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    @media (max-width: 1200px) {
        .group-dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }

    @media (max-width: 768px) {
        .group-chart-grid {
            grid-template-columns: 1fr;
        }
        .group-hero-banner {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 16px !important;
            padding: 18px 16px !important;
            border-radius: 16px !important;
        }
        .group-hero-right {
            width: 100% !important;
            align-items: stretch !important;
        }
        .group-hero-chips {
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 8px !important;
            width: 100% !important;
        }
        .group-hero-chip {
            min-width: 0 !important;
            padding: 8px 4px !important;
        }
        .group-hero-chip span:first-child {
            font-size: 16px !important;
        }
        .group-hero-chip span:last-child {
            font-size: 9px !important;
        }
        .group-hero-actions {
            display: flex !important;
            gap: 8px !important;
            width: 100% !important;
        }
        .group-hero-actions a {
            flex: 1 !important;
            justify-content: center !important;
            text-align: center !important;
            padding: 9px 12px !important;
        }
    }

    @media (max-width: 640px) {
        .group-dashboard-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
            margin-bottom: 12px !important;
        }

        .group-dashboard-card {
            min-height: 88px !important;
            border-radius: 12px !important;
        }

        .group-dashboard-card-body {
            padding: 10px 12px !important;
            gap: 8px !important;
        }

        .group-dashboard-label {
            font-size: 10px !important;
            margin-bottom: 4px !important;
        }

        .group-dashboard-value {
            font-size: 20px !important;
        }

        .group-dashboard-value.money {
            font-size: 15px !important;
        }

        .group-dashboard-icon {
            width: 38px !important;
            height: 38px !important;
            font-size: 15px !important;
            border-radius: 10px !important;
        }

        .group-page-header,
        .group-filter-panel {
            width: 100%;
        }

        .group-filter-panel {
            align-items: stretch;
        }

        #branchFilterSelect {
            width: 100%;
            min-width: 100% !important;
        }
    }
</style>

<div class="app-wrapper groupadmin-theme">
    <%- include('../partials/sidebar', { currentPath: '/groupadmin/dashboard' }) %>
    <div class="main-panel">
        <%- include('../partials/header') %>
        <div class="content">
            <%- include('../partials/flashMessages') %>
            <section class="group-hero-banner" style="background:linear-gradient(135deg,#0f766e 0%,#0d9488 50%,#14b8a6 100%);border-radius:20px;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:16px;position:relative;overflow:hidden;box-shadow:0 8px 28px rgba(15,118,110,0.25);" aria-label="Group Admin Welcome Banner">
                <div style="position:absolute;inset:0;background:radial-gradient(circle at 75% 50%,rgba(255,255,255,0.1),transparent 60%);pointer-events:none;"></div>
                <div style="flex:1;position:relative;z-index:2;">
                    <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.85);border-radius:999px;padding:5px 14px;font-size:12px;font-weight:600;margin-bottom:12px;border:1px solid rgba(255,255,255,0.2);">
                        <i class="fas fa-sitemap"></i>
                        <span><%- lan.SchoolSync_Group_Control_Panel %></span>
                    </div>
                    <h1 style="font-size:26px;font-weight:800;color:#fff;margin:0 0 8px;letter-spacing:-0.02em;">
                        <%- lan.Welcome %>, <%= (typeof user !== 'undefined' && user) ? user.first_name : (typeof lan !== 'undefined' && lan.Admin ? lan.Admin : 'Admin') %>! 🏫
                    </h1>
                    <p style="font-size:14px;color:rgba(255,255,255,0.8);margin:0 0 18px;line-height:1.5;">
                        <%= groupContext ? groupContext.group_name : lan.School_Group %> <%- lan.Group_Hero_Desc %>
                    </p>
                    <div class="group-hero-actions" style="display:flex;gap:10px;flex-wrap:wrap;">
                        <a href="/groupadmin/branches" style="background:#fff;color:#0f766e;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:7px;">
                            <i class="fas fa-school"></i> <%- lan.My_Branches %>
                        </a>
                        <a href="/groupadmin/reports" style="background:rgba(255,255,255,0.15);color:#fff;border:1px solid rgba(255,255,255,0.25);padding:9px 18px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:7px;">
                            <i class="fas fa-chart-bar"></i> <%- lan.Reports %>
                        </a>
                    </div>
                </div>
                <div class="group-hero-right" style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;position:relative;z-index:2;">
                    <%- include('../partials/hero-illustration', { illustrationSrc: '/illustrations/group_admin.png', illustrationAlt: 'Group Admin Dashboard' }) %>
                    <div class="group-hero-chips" style="display:flex;gap:10px;">
                        <div class="group-hero-chip" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);border-radius:12px;padding:10px 16px;text-align:center;min-width:72px;">
                            <span style="font-size:18px;font-weight:800;color:#fff;display:block;"><%= stats.total_branches || 0 %></span>
                            <span style="font-size:10px;color:rgba(255,255,255,0.75);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;"><%- lan.Branches %></span>
                        </div>
                        <div class="group-hero-chip" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);border-radius:12px;padding:10px 16px;text-align:center;min-width:72px;">
                            <span style="font-size:18px;font-weight:800;color:#fff;display:block;"><%= stats.total_students || 0 %></span>
                            <span style="font-size:10px;color:rgba(255,255,255,0.75);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;"><%- lan.Students %></span>
                        </div>
                        <div class="group-hero-chip" style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);border-radius:12px;padding:10px 16px;text-align:center;min-width:72px;">
                            <span style="font-size:18px;font-weight:800;color:#fff;display:block;"><%= stats.today_attendance_pct || 0 %>%</span>
                            <span style="font-size:10px;color:rgba(255,255,255,0.75);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;"><%- lan.Attendance %></span>
                        </div>
                    </div>
                </div>
            </section>
            <div class="group-page-header flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-3" style="background:#fff;border:1px solid #E2E8F0;border-radius:14px;padding:16px 20px;">
                <div>
                    <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">
                        <%- lan.Group_Control_Panel %>
                    </span>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight" style="font-size:20px;margin:2px 0 4px 0;">
                        <%= groupContext ? groupContext.group_name : lan.School_Group_Dashboard %>
                    </h2>
                    <p class="text-xs text-gray-500 mt-1" style="margin:0;">
                        <%- lan.Group_Owner %>:
                        <strong class="text-gray-700">
                            <%= groupContext ? groupContext.owner_name : 'N/A' %>
                        </strong>
                        |
                        <%- lan.Assigned_Branches %>:
                        <strong class="text-gray-700">
                            <%= stats.total_branches || 0 %>
                        </strong>
                    </p>
                </div>
                <div class="group-filter-panel flex items-center gap-3">
                    <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">
                        <%- lan.Filter_Branch %>
                    </label>
                    <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 240px; border-radius:8px; padding:8px 12px; font-size:13px; font-weight:600;" onchange="window.location.href = '/groupadmin/dashboard?branchId=' + this.value">
                        <option value=""><%- lan.All_Schools_Branches %></option>
                        <% branches.forEach(b => { %>
                            <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                                <%= b.school_name %><%= b.branch_name ? ' - ' + b.branch_name : '' %>
                            </option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="group-dashboard-grid">
                <div class="group-dashboard-card">
                    <div class="group-dashboard-card-body">
                        <div>
                            <p class="group-dashboard-label"><%- lan.Total_Schools %></p>
                            <h3 class="group-dashboard-value"><%= stats.total_branches || 0 %></h3>
                        </div>
                        <div class="group-dashboard-icon" style="background-color: var(--role-primary-light); color: var(--role-primary-dark);">
                            <i class="fa-solid fa-school"></i>
                        </div>
                    </div>
                </div>
                <div class="group-dashboard-card">
                    <div class="group-dashboard-card-body">
                        <div>
                            <p class="group-dashboard-label"><%- lan.Total_Students %></p>
                            <h3 class="group-dashboard-value"><%= stats.total_students || 0 %></h3>
                        </div>
                        <div class="group-dashboard-icon" style="background:#eff6ff; color:#2563eb;">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                    </div>
                </div>
                <div class="group-dashboard-card">
                    <div class="group-dashboard-card-body">
                        <div>
                            <p class="group-dashboard-label"><%- lan.Total_Teachers %></p>
                            <h3 class="group-dashboard-value"><%= stats.total_teachers || 0 %></h3>
                        </div>
                        <div class="group-dashboard-icon" style="background:#ecfdf5; color:#059669;">
                            <i class="fa-solid fa-chalkboard-teacher"></i>
                        </div>
                    </div>
                </div>
                <div class="group-dashboard-card">
                    <div class="group-dashboard-card-body">
                        <div>
                            <p class="group-dashboard-label"><%- lan.Today_Attendance %></p>
                            <h3 class="group-dashboard-value"><%= stats.today_attendance_pct || 0 %>%</h3>
                        </div>
                        <div class="group-dashboard-icon" style="background:#fffbeb; color:#d97706;">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="group-dashboard-grid">
                <div class="group-dashboard-card">
                    <div class="group-dashboard-card-body">
                        <div>
                            <p class="group-dashboard-label"><%- lan.Monthly_Fees_Collection %></p>
                            <h3 class="group-dashboard-value money">
                                ₹<%= Number(stats.monthly_fees || 0).toLocaleString('en-IN') %>
                            </h3>
                        </div>
                        <div class="group-dashboard-icon" style="background:#f5f3ff; color:#7c3aed;">
                            <i class="fa-solid fa-money-bill-wave"></i>
                        </div>
                    </div>
                </div>
                <div class="group-dashboard-card">
                    <div class="group-dashboard-card-body">
                        <div>
                            <p class="group-dashboard-label"><%- lan.Pending_Fees %></p>
                            <h3 class="group-dashboard-value money">
                                ₹<%= Number(stats.pending_fees || 0).toLocaleString('en-IN') %>
                            </h3>
                        </div>
                        <div class="group-dashboard-icon" style="background:#fef2f2; color:#dc2626;">
                            <i class="fa-solid fa-money-check-alt"></i>
                        </div>
                    </div>
                </div>
                <div class="group-dashboard-card">
                    <div class="group-dashboard-card-body">
                        <div>
                            <p class="group-dashboard-label"><%- lan.Active_Buses %></p>
                            <h3 class="group-dashboard-value"><%= stats.active_buses || 0 %></h3>
                        </div>
                        <div class="group-dashboard-icon" style="background:#fefce8; color:#ca8a04;">
                            <i class="fa-solid fa-bus"></i>
                        </div>
                    </div>
                </div>
                <div class="group-dashboard-card">
                    <div class="group-dashboard-card-body">
                        <div>
                            <p class="group-dashboard-label"><%- lan.Library_Books %></p>
                            <h3 class="group-dashboard-value"><%= stats.library_books || 0 %></h3>
                        </div>
                        <div class="group-dashboard-icon" style="background:#ecfeff; color:#0891b2;">
                            <i class="fa-solid fa-book"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="group-chart-grid">
                <div class="card">
                    <div class="card-header bg-slate-50/20 border-b-0 pb-2">
                        <h5 class="card-title flex items-center gap-2">
                            <i class="fa-solid fa-chart-pie text-teal-600"></i>
                            <%- lan.Students_Distribution %>
                        </h5>
                    </div>
                    <div class="card-body" style="height: 300px; position: relative;">
                        <canvas id="studentsDistChart" data-chart="doughnut" data-labels='<%= JSON.stringify(branchesList.map(b => b.school_name + (b.branch_name ? " (" + b.branch_name + ")" : ""))) %>' data-data='<%= JSON.stringify(branchesList.map(b => b.student_count || 0)) %>' ></canvas>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header bg-slate-50/20 border-b-0 pb-2">
                        <h5 class="card-title flex items-center gap-2">
                            <i class="fa-solid fa-chart-column text-teal-600"></i>
                            <%- lan.Financial_Overview %>
                        </h5>
                    </div>
                    <div class="card-body" style="height: 300px; position: relative;">
                        <canvas id="financialOverviewChart" data-chart="bar" data-labels='["Monthly Collected", "Total Pending"]' data-data='<%= JSON.stringify([stats.monthly_fees || 0, stats.pending_fees || 0]) %>' data-color="green" data-label="Amount (₹)" data-prefix="₹"></canvas>
                    </div>
                </div>
            </div>
            <div class="card group-table-card">
                <div class="card-header bg-slate-50/20">
                    <h4 class="card-title flex items-center gap-2">
                        <i class="fa-solid fa-network-wired text-teal-600"></i>
                        <%- lan.Assigned_Branches %>
                    </h4>
                </div>
                <div class="card-body p-0">
                    <% if (!branchesList || branchesList.length === 0) { %>
                        <div class="p-6 text-center text-gray-400">
                            <%- lan.No_Schools_Assigned %>
                        </div>
                    <% } else { %>
                        <div class="group-table-wrap">
                            <table class="table" style="min-width: 950px;">
                                <thead>
                                    <tr>
                                        <th><%- lan.Branch_School_Name %></th>
                                        <th><%- lan.Area %></th>
                                        <th><%- lan.Mediums %></th>
                                        <th><%- lan.Students %></th>
                                        <th><%- lan.Teachers %></th>
                                        <th><%- lan.Plan %></th>
                                        <th><%- lan.Status %></th>
                                        <th><%- lan.Action %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% branchesList.forEach(branch => { %>
                                        <tr>
                                            <td>
                                                <div class="font-semibold text-gray-800 text-sm">
                                                    <%= branch.school_name %>
                                                </div>

                                                <% if (branch.branch_name) { %>
                                                    <div class="text-xs text-gray-400 font-medium">
                                                        <%= branch.branch_name %>
                                                        (<%- lan.Code %>: <%= branch.branch_code || '-' %>)
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td><%= branch.area || '-' %></td>
                                            <td>
                                                <% if (branch.mediums) { %>
                                                    <span class="text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded">
                                                        <%= branch.mediums %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-gray-400">-</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <strong class="text-gray-800">
                                                    <%= branch.student_count || 0 %>
                                                </strong>
                                            </td>
                                            <td>
                                                <strong class="text-gray-800">
                                                    <%= branch.teacher_count || 0 %>
                                                </strong>
                                            </td>
                                            <td><%= branch.plan || '-' %></td>
                                            <td>
                                                <span class="badge <%= branch.status === 'active' ? 'badge-success' : 'badge-secondary' %>">
                                                    <%= branch.status || '-' %>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="/groupadmin/branch/<%= branch.id %>/overview" class="btn btn-sm btn-primary">
                                                    <i class="fa-solid fa-eye mr-1"></i>
                                                    <%- lan.View_Overview %>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
</div>
        <%- include('../partials/footer') %>
                </div>
        </div>

    </div>
</div>
<script src="/js/charts.js"></script>