<%- include('../partials/head') %>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/library' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="group-page-header flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Library Books</span>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Group Library Directory</h2>
          <p class="text-xs text-gray-500 mt-1">
            Consolidated library books inventory directory list across assigned branches
          </p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
          <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Filter Branch:</label>
          <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px;" onchange="window.location.href = '/groupadmin/library?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="card">
        <div class="card-header bg-slate-50/20">
          <h4 class="card-title flex items-center gap-2">
            <i class="fa-solid fa-book-open text-teal-600"></i> Library Inventory (Active)
          </h4>
        </div>
        <div class="card-body p-0">
          <% if (books.length === 0) { %>
            <div class="p-6 text-center text-gray-400">No active books found in this scope.</div>
          <% } else { %>
            <table class="table">
              <thead>
                <tr>
                  <th>Book Title</th>
                  <th>Branch / School</th>
                  <th>Author</th>
                  <th>Available Copies</th>
                  <th>Total Copies</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% books.forEach(book => { %>
                  <tr>
                    <td>
                      <div class="font-semibold text-gray-800 text-sm">
                        <%= book.title %>
                      </div>
                    </td>
                    <td>
                      <div class="text-sm font-medium text-gray-700"><%= book.school_name %></div>
                      <% if (book.branch_name) { %>
                        <div class="text-xs text-gray-400"><%= book.branch_name %></div>
                      <% } %>
                    </td>
                    <td><%= book.author || '-' %></td>
                    <td><strong class="text-emerald-600"><%= book.available_copies %></strong></td>
                    <td><strong class="text-gray-800"><%= book.total_copies %></strong></td>
                    <td>
                      <span class="badge <%= book.book_status === 'active' ? 'badge-success' : 'badge-secondary' %>">
                        <%= book.book_status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>