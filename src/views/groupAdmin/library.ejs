<%- include('../partials/head') %>
<style>
  .group-page-header-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 18px 22px;
    margin-bottom: 20px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .library-desktop-table {
    width: 100%;
    min-width: 800px;
    border-collapse: collapse;
  }

  .library-mobile-cards {
    display: none;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
  }

  .library-item-card-mobile {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 768px) {
    .group-page-header-card {
      padding: 16px 14px !important;
      margin-bottom: 14px !important;
    }
    .group-page-header-card h2 {
      font-size: 20px !important;
    }
    .group-filter-panel {
      width: 100% !important;
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 10px !important;
    }
    .group-filter-panel select {
      width: 100% !important;
      min-width: 100% !important;
    }
    .library-desktop-table {
      display: none !important;
    }
    .library-mobile-cards {
      display: flex !important;
    }
  }

  [data-theme="dark"] .group-page-header-card,
  [data-theme="dark"] .card,
  .light-mode-disabled .group-page-header-card,
  .light-mode-disabled .card {
    background: #151D30 !important;
    border-color: #242F4D !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
  }
  [data-theme="dark"] .group-page-header-card h2,
  [data-theme="dark"] .card-title,
  .light-mode-disabled .group-page-header-card h2,
  .light-mode-disabled .card-title {
    color: #F1F5F9 !important;
  }
  [data-theme="dark"] .card-header,
  .light-mode-disabled .card-header {
    background: #151D30 !important;
    border-bottom-color: #242F4D !important;
  }
  [data-theme="dark"] .library-item-card-mobile,
  .light-mode-disabled .library-item-card-mobile {
    background: #101726 !important;
    border-color: #242F4D !important;
  }
  [data-theme="dark"] .library-item-card-mobile .book-name,
  .light-mode-disabled .library-item-card-mobile .book-name {
    color: #F1F5F9 !important;
  }
  [data-theme="dark"] select.form-input,
  .light-mode-disabled select.form-input {
    background: #101726 !important;
    border-color: #334155 !important;
    color: #F1F5F9 !important;
  }
</style>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/library' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="group-page-header-card flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider"><%- lan.Library_Books %></span>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight" style="margin: 2px 0 4px 0;"><%- lan.Group_Library_Directory %></h2>
          <p class="text-xs text-gray-500 mt-1" style="margin: 0;">
            <%- lan.Group_Library_Subtitle %>
          </p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
          <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap"><%- lan.Filter_Branch %></label>
          <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px; border-radius: 8px; padding: 8px 12px; font-size: 13px; font-weight: 600;" onchange="window.location.href = '/groupadmin/library?branchId=' + this.value">
            <option value=""><%- lan.All_Schools_Branches %></option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="card" style="border-radius: 14px; overflow: hidden; border: 1px solid #E2E8F0;">
        <div class="card-header bg-slate-50/20" style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9;">
          <h4 class="card-title flex items-center gap-2" style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0;">
            <i class="fa-solid fa-book-open text-teal-600"></i> <%- lan.Library_Inventory_Active %>
          </h4>
        </div>
        <div class="card-body p-0">
          <% if (books.length === 0) { %>
            <div class="p-6 text-center text-gray-400" style="padding: 36px 20px; font-size: 13px;"><%- lan.No_Active_Books_Found %></div>
          <% } else { %>
            <div style="overflow-x: auto;">
              <table class="table library-desktop-table">
                <thead>
                  <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;"><%- lan.Book_Title %></th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;"><%- lan.Branch_School %></th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;"><%- lan.Author %></th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;"><%- lan.Available_Copies %></th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;"><%- lan.Total_Copies %></th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;"><%- lan.Status %></th>
                  </tr>
                </thead>
                <tbody>
                  <% books.forEach(book => { %>
                    <tr style="border-bottom: 1px solid #F1F5F9;">
                      <td style="padding: 12px 16px;">
                        <div class="font-semibold text-gray-800 text-sm">
                          <%= book.title %>
                        </div>
                      </td>
                      <td style="padding: 12px 16px;">
                        <div class="text-sm font-medium text-gray-700"><%= book.school_name %></div>
                        <% if (book.branch_name) { %>
                          <div class="text-xs text-gray-400"><%= book.branch_name %></div>
                        <% } %>
                      </td>
                      <td style="padding: 12px 16px;"><%= book.author || '-' %></td>
                      <td style="padding: 12px 16px;"><strong class="text-emerald-600"><%= book.available_copies %></strong></td>
                      <td style="padding: 12px 16px;"><strong class="text-gray-800"><%= book.total_copies %></strong></td>
                      <td style="padding: 12px 16px;">
                        <span class="badge <%= book.book_status === 'active' ? 'badge-success' : 'badge-secondary' %>">
                          <%= book.book_status %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="library-mobile-cards">
                <% books.forEach(book => { %>
                  <div class="library-item-card-mobile">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                      <div>
                        <div class="book-name" style="font-size: 14px; font-weight: 800; color: #0F172A;">
                          <%= book.title %>
                        </div>
                        <div style="font-size: 11.5px; color: #64748B; margin-top: 2px;">
                          <i class="fas fa-pen-nib" style="font-size: 10px;"></i> <%= book.author || lan.Unknown_Author %>
                        </div>
                      </div>
                      <span class="badge <%= book.book_status === 'active' ? 'badge-success' : 'badge-secondary' %>" style="font-size: 10px; padding: 3px 8px;">
                        <%= book.book_status %>
                      </span>
                    </div>
                    <div style="font-size: 12px; color: #475569; background: rgba(0,0,0,0.02); padding: 8px 10px; border-radius: 8px;">
                      <div style="font-weight: 700; color: #0891B2;"><%= book.school_name %></div>
                      <% if (book.branch_name) { %>
                        <div style="font-size: 11px; color: #64748B;"><%= book.branch_name %></div>
                      <% } %>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; background: rgba(0,0,0,0.03); padding: 10px 12px; border-radius: 10px; font-size: 11.5px;">
                      <div>
                        <div style="color: #64748B; font-size: 10px; text-transform: uppercase;"><%- lan.Available %></div>
                        <div style="font-size: 14px; font-weight: 800; color: #059669; margin-top: 2px;"><%= book.available_copies %> <%- lan.Copies %></div>
                      </div>
                      <div>
                        <div style="color: #64748B; font-size: 10px; text-transform: uppercase;"><%- lan.Total_Copies %></div>
                        <div style="font-size: 14px; font-weight: 800; color: #0F172A; margin-top: 2px;"><%= book.total_copies %> <%- lan.Copies %></div>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
            <%- include('../partials/pagination.ejs') %>
          <% } %>
        </div>
      </div>
</div>
        <%- include('../partials/footer') %>
    </div>
</div>
