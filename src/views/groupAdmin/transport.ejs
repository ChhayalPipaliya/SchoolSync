<%- include('../partials/head') %>
<style>
  .group-page-header-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 18px 22px;
    margin-bottom: 20px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .transport-desktop-table {
    width: 100%;
    min-width: 750px;
    border-collapse: collapse;
  }

  .transport-mobile-cards {
    display: none;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
  }

  .transport-item-card-mobile {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 768px) {
    .group-page-header-card {
      padding: 16px 14px !important;
      margin-bottom: 14px !important;
    }
    .group-page-header-card h2 {
      font-size: 20px !important;
    }
    .group-filter-panel {
      width: 100% !important;
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 10px !important;
    }
    .group-filter-panel select {
      width: 100% !important;
      min-width: 100% !important;
    }
    .transport-desktop-table {
      display: none !important;
    }
    .transport-mobile-cards {
      display: flex !important;
    }
  }

  [data-theme="dark"] .group-page-header-card,
  [data-theme="dark"] .card,
  .light-mode-disabled .group-page-header-card,
  .light-mode-disabled .card {
    background: #151D30 !important;
    border-color: #242F4D !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
  }
  [data-theme="dark"] .group-page-header-card h2,
  [data-theme="dark"] .card-title,
  .light-mode-disabled .group-page-header-card h2,
  .light-mode-disabled .card-title {
    color: #F1F5F9 !important;
  }
  [data-theme="dark"] .card-header,
  .light-mode-disabled .card-header {
    background: #151D30 !important;
    border-bottom-color: #242F4D !important;
  }
  [data-theme="dark"] .transport-item-card-mobile,
  .light-mode-disabled .transport-item-card-mobile {
    background: #101726 !important;
    border-color: #242F4D !important;
  }
  [data-theme="dark"] .transport-item-card-mobile .vehicle-title,
  .light-mode-disabled .transport-item-card-mobile .vehicle-title {
    color: #F1F5F9 !important;
  }
  [data-theme="dark"] select.form-input,
  .light-mode-disabled select.form-input {
    background: #101726 !important;
    border-color: #334155 !important;
    color: #F1F5F9 !important;
  }
</style>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/transport' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="group-page-header-card flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Transport Fleet</span>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight" style="margin: 2px 0 4px 0;">Group Transport Fleet</h2>
          <p class="text-xs text-gray-500 mt-1" style="margin: 0;">
            Consolidated active transport vehicles list across assigned branches
          </p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
          <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Filter Branch:</label>
          <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px; border-radius: 8px; padding: 8px 12px; font-size: 13px; font-weight: 600;" onchange="window.location.href = '/groupadmin/transport?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="card" style="border-radius: 14px; overflow: hidden; border: 1px solid #E2E8F0;">
        <div class="card-header bg-slate-50/20" style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9;">
          <h4 class="card-title flex items-center gap-2" style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0;">
            <i class="fa-solid fa-bus text-teal-600"></i> Transport Vehicles (Active)
          </h4>
        </div>
        <div class="card-body p-0">
          <% if (vehicles.length === 0) { %>
            <div class="p-6 text-center text-gray-400" style="padding: 36px 20px; font-size: 13px;">No active vehicles found in this scope.</div>
          <% } else { %>
            <div style="overflow-x: auto;">
              <table class="table transport-desktop-table">
                <thead>
                  <tr style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Vehicle Number</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Branch / School</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Model</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Type</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Capacity</th>
                    <th style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% vehicles.forEach(vehicle => { %>
                    <tr style="border-bottom: 1px solid #F1F5F9;">
                      <td style="padding: 12px 16px;">
                        <div class="font-semibold text-gray-800 text-sm">
                          <%= vehicle.vehicle_number %>
                        </div>
                      </td>
                      <td style="padding: 12px 16px;">
                        <div class="text-sm font-medium text-gray-700"><%= vehicle.school_name %></div>
                        <% if (vehicle.branch_name) { %>
                          <div class="text-xs text-gray-400"><%= vehicle.branch_name %></div>
                        <% } %>
                      </td>
                      <td style="padding: 12px 16px;"><%= vehicle.model || '-' %></td>
                      <td style="padding: 12px 16px;"><%= vehicle.type || '-' %></td>
                      <td style="padding: 12px 16px;"><%= vehicle.capacity || '-' %> seats</td>
                      <td style="padding: 12px 16px;">
                        <span class="badge <%= vehicle.vehicle_status === 'active' ? 'badge-success' : 'badge-secondary' %>">
                          <%= vehicle.vehicle_status %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
              <div class="transport-mobile-cards">
                <% vehicles.forEach(vehicle => { %>
                  <div class="transport-item-card-mobile">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                      <div class="vehicle-title" style="font-size: 15px; font-weight: 800; color: #0F172A; display: flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-bus text-teal-600" style="font-size: 13px;"></i> <%= vehicle.vehicle_number %>
                      </div>
                      <span class="badge <%= vehicle.vehicle_status === 'active' ? 'badge-success' : 'badge-secondary' %>" style="font-size: 10px; padding: 3px 8px;">
                        <%= vehicle.vehicle_status %>
                      </span>
                    </div>
                    <div style="font-size: 12px; color: #475569; background: rgba(0,0,0,0.02); padding: 8px 10px; border-radius: 8px;">
                      <div style="font-weight: 700; color: #0891B2;"><%= vehicle.school_name %></div>
                      <% if (vehicle.branch_name) { %>
                        <div style="font-size: 11px; color: #64748B;"><%= vehicle.branch_name %></div>
                      <% } %>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 8px; font-size: 11px; text-align: center;">
                      <div>
                        <div style="color: #64748B; font-size: 9.5px; text-transform: uppercase;">Model</div>
                        <div style="font-weight: 700; color: #0F172A; margin-top: 2px;"><%= vehicle.model || '-' %></div>
                      </div>
                      <div>
                        <div style="color: #64748B; font-size: 9.5px; text-transform: uppercase;">Type</div>
                        <div style="font-weight: 700; color: #0F172A; margin-top: 2px;"><%= vehicle.type || 'Bus' %></div>
                      </div>
                      <div>
                        <div style="color: #64748B; font-size: 9.5px; text-transform: uppercase;">Capacity</div>
                        <div style="font-weight: 700; color: #0F172A; margin-top: 2px;"><%= vehicle.capacity || '-' %> seats</div>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
            <%- include('../partials/pagination.ejs') %>
          <% } %>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>