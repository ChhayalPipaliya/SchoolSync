<%- include('../partials/head') %>
<div class="app-wrapper groupadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/groupadmin/transport' }) %>
  <div class="main-panel">
    <%- include('../partials/header') %>
    <div class="content">
      <%- include('../partials/flashMessages') %>
      <div class="group-page-header flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Transport Fleet</span>
          <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Group Transport Fleet</h2>
          <p class="text-xs text-gray-500 mt-1">
            Consolidated active transport vehicles list across assigned branches
          </p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
          <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Filter Branch:</label>
          <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px;" onchange="window.location.href = '/groupadmin/transport?branchId=' + this.value">
            <option value="">All Schools / Branches</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>>
                <%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="card">
        <div class="card-header bg-slate-50/20">
          <h4 class="card-title flex items-center gap-2">
            <i class="fa-solid fa-bus text-teal-600"></i> Transport Vehicles (Active)
          </h4>
        </div>
        <div class="card-body p-0">
          <% if (vehicles.length === 0) { %>
            <div class="p-6 text-center text-gray-400">No active vehicles found in this scope.</div>
          <% } else { %>
            <table class="table">
              <thead>
                <tr>
                  <th>Vehicle Number</th>
                  <th>Branch / School</th>
                  <th>Model</th>
                  <th>Type</th>
                  <th>Capacity</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% vehicles.forEach(vehicle => { %>
                  <tr>
                    <td>
                      <div class="font-semibold text-gray-800 text-sm">
                        <%= vehicle.vehicle_number %>
                      </div>
                    </td>
                    <td>
                      <div class="text-sm font-medium text-gray-700"><%= vehicle.school_name %></div>
                      <% if (vehicle.branch_name) { %>
                        <div class="text-xs text-gray-400"><%= vehicle.branch_name %></div>
                      <% } %>
                    </td>
                    <td><%= vehicle.model || '-' %></td>
                    <td><%= vehicle.type || '-' %></td>
                    <td><%= vehicle.capacity || '-' %> seats</td>
                    <td>
                      <span class="badge <%= vehicle.vehicle_status === 'active' ? 'badge-success' : 'badge-secondary' %>">
                        <%= vehicle.vehicle_status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <%- include('../partials/pagination.ejs') %>
          <% } %>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>