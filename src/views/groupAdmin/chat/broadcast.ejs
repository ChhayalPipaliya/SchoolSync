<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
    <div>
        <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%- lan.Broadcast_Announcement %></h2>
        <p class="text-xs text-gray-500 mt-1"><%- lan.Broadcast_Subtitle %></p>
    </div>
    <div>
        <a href="/groupadmin/chat" class="btn btn-secondary btn-sm border border-slate-200 hover:bg-slate-50 bg-white">
            <i class="fa-solid fa-arrow-left mr-1"></i> <%- lan.Back_To_Chat %>
        </a>
    </div>
</div>
<div class="card p-6 bg-white shadow-sm border border-slate-200 rounded-2xl">
    <form method="POST" action="/groupadmin/chat/broadcast" class="space-y-6" id="broadcastForm">
        <div class="form-group">
            <div class="flex items-center justify-between mb-3">
                <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider block m-0"><%-
                        lan.Target_Branches %> *</label>
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="selectAll"
                        class="w-4 h-4 rounded text-emerald-600 border-slate-300 focus:ring-emerald-500" checked
                        onclick="toggleSelectAll(this)">
                    <label for="selectAll" class="text-xs text-slate-500 font-semibold cursor-pointer select-none"><%-
                            lan.Select_All_Enabled %></label>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 bg-slate-50 border border-slate-200 rounded-2xl max-h-60 overflow-y-auto"
                id="branchesContainer">
                <% if (branches && branches.length> 0) { %>
                    <% branches.forEach(branch=> { %>
                        <% const hasAdmin=Number(branch.admin_count || 0)> 0; %>
                            <label
                                class="flex items-start gap-3 p-2 bg-white border border-slate-100 rounded-xl cursor-pointer hover:bg-slate-50 transition-colors select-none <%= !hasAdmin ? 'opacity-60 cursor-not-allowed' : '' %>">
                                <input type="checkbox" name="schoolIds" value="<%= branch.school_id %>"
                                    class="branch-checkbox mt-0.5 w-4 h-4 rounded text-emerald-600 border-slate-300 focus:ring-emerald-500"
                                    <%=hasAdmin ? 'checked' : 'disabled' %>
                                onchange="updateSelectAllState()">
                                <div class="text-xs">
                                    <div class="font-bold text-slate-800">
                                        <%= branch.school_name %> (<%= branch.branch_name || 'Main' %>)
                                    </div>
                                    <% if (hasAdmin) { %>
                                        <div class="text-[10px] text-slate-500 mt-0.5"><i
                                                class="fa-solid fa-user-tie text-[9px] mr-1 text-slate-400"></i>
                                            <%= branch.admin_names %>
                                        </div>
                                        <% } else { %>
                                            <div class="text-[10px] text-rose-600 font-bold mt-0.5"><i
                                                    class="fa-solid fa-triangle-exclamation text-[9px] mr-1"></i><%-
                                                    lan.No_School_Admin_Assigned %></div>
                                            <% } %>
                                </div>
                            </label>
                            <% }) %>
                                <% } else { %>
                                    <div class="col-span-2 py-6 text-center text-slate-400">
                                        <i class="fa-solid fa-circle-exclamation text-xl mb-1"></i>
                                        <p class="text-xs m-0"><%- lan.No_Assigned_Branches_Found %></p>
                                    </div>
                                    <% } %>
            </div>
            <p class="text-xs text-rose-600 mt-2 hidden" id="branchSelectionError"><%- lan.Select_Branch_Error %></p>
        </div>
        <div class="form-group">
            <label class="form-label font-bold text-slate-700 text-xs uppercase tracking-wider mb-2 block"><%-
                    lan.Announcement_Message %> *</label>
            <textarea name="message" id="broadcastMessage" required
                class="form-input w-full p-3 bg-white border border-slate-200 rounded-2xl focus:border-emerald-500 focus:outline-none text-sm"
                rows="6" maxlength="1000" placeholder="<%= lan.Announcement_Message_Placeholder %>"></textarea>
            <div class="flex justify-between items-center mt-1.5 px-2">
                <span class="text-slate-400 text-[10px] ml-auto" id="messageCounter">0/1000</span>
            </div>
        </div>
        <div class="flex gap-4 pt-4 border-t border-slate-100">
            <button type="submit"
                class="btn btn-primary flex-1 bg-emerald-600 hover:bg-emerald-700 border-0 py-2.5 text-white rounded-xl font-bold">
                <i class="fa-solid fa-bullhorn mr-1"></i> <%- lan.Send_Announcement %>
            </button>
            <a href="/groupadmin/chat"
                class="btn btn-secondary flex-1 text-center py-2.5 border border-slate-200 rounded-xl font-bold text-slate-700 hover:bg-slate-50 bg-white"><%-
                    lan.Cancel %></a>
        </div>
    </form>
</div>
<script>
    function toggleSelectAll(masterCheckbox) {
        const checkboxes = document.querySelectorAll('.branch-checkbox:not(:disabled)');
        checkboxes.forEach(cb => {
            cb.checked = masterCheckbox.checked;
        });
    }

    function updateSelectAllState() {
        const enabledCheckboxes = document.querySelectorAll('.branch-checkbox:not(:disabled)');
        const checkedCheckboxes = document.querySelectorAll('.branch-checkbox:not(:disabled):checked');
        const selectAll = document.getElementById('selectAll');

        if (selectAll) {
            selectAll.checked = (enabledCheckboxes.length > 0 && enabledCheckboxes.length === checkedCheckboxes.length);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const input = document.getElementById('broadcastMessage');
        const counter = document.getElementById('messageCounter');
        if (input && counter) {
            input.addEventListener('input', function () {
                counter.textContent = `${this.value.length}/1000`;
            });
        }

        const form = document.getElementById('broadcastForm');
        const selectionError = document.getElementById('branchSelectionError');
        if (form) {
            form.addEventListener('submit', function (e) {
                const checked = document.querySelectorAll('.branch-checkbox:not(:disabled):checked');
                if (checked.length === 0) {
                    e.preventDefault();
                    if (selectionError) selectionError.classList.remove('hidden');
                } else {
                    if (selectionError) selectionError.classList.add('hidden');
                }
            });
        }
    });
</script>