<%- include('../partials/head') %>
    <style>
        .group-page-header-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 18px 22px;
            margin-bottom: 16px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .academic-stats-grid {
            display: grid !important;
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
            gap: 14px !important;
            margin-bottom: 16px !important;
        }

        .academic-stat-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 16px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
        }

        .academic-desktop-table {
            width: 100%;
            min-width: 800px;
            border-collapse: collapse;
        }

        .academic-mobile-cards {
            display: none;
            flex-direction: column;
            gap: 12px;
            padding: 14px;
        }

        .academic-item-card-mobile {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        @media (max-width: 768px) {
            .group-page-header-card {
                padding: 16px 14px !important;
                margin-bottom: 14px !important;
            }

            .group-page-header-card h2 {
                font-size: 20px !important;
            }

            .group-filter-panel {
                width: 100% !important;
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 10px !important;
            }

            .group-filter-panel select {
                width: 100% !important;
                min-width: 100% !important;
            }

            .academic-stats-grid {
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 10px !important;
                margin-bottom: 14px !important;
            }

            .academic-stat-card {
                padding: 12px 14px !important;
                min-height: 80px !important;
                border-radius: 12px !important;
            }

            .academic-stat-card:last-child {
                grid-column: span 2 !important;
            }

            .academic-stat-card h3 {
                font-size: 20px !important;
            }

            .academic-stat-card .stat-icon {
                width: 36px !important;
                height: 36px !important;
                font-size: 15px !important;
            }

            .academic-desktop-table {
                display: none !important;
            }

            .academic-mobile-cards {
                display: flex !important;
            }
        }

        [data-theme="dark"] .group-page-header-card,
        [data-theme="dark"] .academic-stat-card,
        [data-theme="dark"] .card,
        .light-mode-disabled .group-page-header-card,
        .light-mode-disabled .academic-stat-card,
        .light-mode-disabled .card {
            background: #151D30 !important;
            border-color: #242F4D !important;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
        }

        [data-theme="dark"] .group-page-header-card h2,
        [data-theme="dark"] .academic-stat-card h3,
        [data-theme="dark"] .card-title,
        .light-mode-disabled .group-page-header-card h2,
        .light-mode-disabled .academic-stat-card h3,
        .light-mode-disabled .card-title {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .card-header,
        .light-mode-disabled .card-header {
            background: #151D30 !important;
            border-bottom-color: #242F4D !important;
        }

        [data-theme="dark"] .academic-item-card-mobile,
        [data-theme="dark"] .branch-summary-card,
        .light-mode-disabled .academic-item-card-mobile,
        .light-mode-disabled .branch-summary-card {
            background: #101726 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .academic-item-card-mobile .exam-name,
        [data-theme="dark"] .branch-summary-card .school-title,
        .light-mode-disabled .academic-item-card-mobile .exam-name,
        .light-mode-disabled .branch-summary-card .school-title {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] select.form-input,
        .light-mode-disabled select.form-input {
            background: #101726 !important;
            border-color: #334155 !important;
            color: #F1F5F9 !important;
        }
    </style>
    <div class="app-wrapper groupadmin-theme">
        <%- include('../partials/sidebar', { currentPath: '/groupadmin/academics' }) %>
            <div class="main-panel">
                <%- include('../partials/header') %>
                    <div class="content">
                        <%- include('../partials/flashMessages') %>
                            <div
                                class="group-page-header-card flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <div>
                                    <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider"><%-
                                            lan.Academic_Performance %></span>
                                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"
                                        style="margin: 2px 0 4px 0;"><%- lan.Group_Academic_Performance %></h2>
                                    <p class="text-xs text-gray-500 mt-1" style="margin: 0;"><%-
                                            lan.Academic_Performance_Subtitle %></p>
                                </div>
                                <div class="group-filter-panel flex items-center gap-3">
                                    <label for="branchFilterSelect"
                                        class="text-xs font-semibold text-gray-500 whitespace-nowrap"><%-
                                            lan.Filter_Branch %></label>
                                    <select id="branchFilterSelect" class="form-input custom-select"
                                        style="min-width: 200px; border-radius: 8px; padding: 8px 12px; font-size: 13px; font-weight: 600;"
                                        onchange="window.location.href = '/groupadmin/academics?branchId=' + this.value">
                                        <option value=""><%- lan.All_Schools_Branches %></option>
                                        <% branches.forEach(b=> { %>
                                            <option value="<%= b.id %>" <%=activeBranchId==b.id ? 'selected' : '' %>><%=
                                                    b.school_name %>
                                                    <%= b.branch_name ? ' - ' + b.branch_name : '' %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                            </div>
                            <div class="academic-stats-grid">
                                <div class="academic-stat-card">
                                    <div>
                                        <span
                                            class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1"
                                            style="font-size: 10px;"><%- lan.Published_Exams %></span>
                                        <h3 class="text-2xl font-extrabold text-gray-800" style="margin: 0;">
                                            <%= overallStats.publishedExamCount %>
                                        </h3>
                                    </div>
                                    <div
                                        class="stat-icon w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-lg font-bold">
                                        <i class="fa-solid fa-graduation-cap"></i>
                                    </div>
                                </div>
                                <div class="academic-stat-card">
                                    <div>
                                        <span
                                            class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1"
                                            style="font-size: 10px;"><%- lan.Avg_Pass_Rate %></span>
                                        <h3 class="text-2xl font-extrabold text-emerald-600" style="margin: 0;">
                                            <%= overallStats.avgPassPercent %>%
                                        </h3>
                                    </div>
                                    <div
                                        class="stat-icon w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg font-bold">
                                        <i class="fa-solid fa-chart-line"></i>
                                    </div>
                                </div>
                                <div class="academic-stat-card">
                                    <div>
                                        <span
                                            class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1"
                                            style="font-size: 10px;"><%- lan.Avg_Exam_Score %></span>
                                        <h3 class="text-2xl font-extrabold text-blue-600" style="margin: 0;">
                                            <%= overallStats.avgMarks %>
                                        </h3>
                                    </div>
                                    <div
                                        class="stat-icon w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg font-bold">
                                        <i class="fa-solid fa-award"></i>
                                    </div>
                                </div>
                            </div>
                            <% if (branchSummaries && branchSummaries.length> 0) { %>
                                <div class="card mb-3"
                                    style="border-radius: 14px; overflow: hidden; border: 1px solid #E2E8F0;">
                                    <div class="card-header bg-slate-50/20"
                                        style="padding: 14px 18px; border-bottom: 1px solid #F1F5F9;">
                                        <h4 class="card-title flex items-center gap-2 text-sm font-bold text-gray-800"
                                            style="margin: 0;">
                                            <i class="fa-solid fa-code-branch text-teal-600"></i> <%-
                                                lan.Branch_Performance_Summary %>
                                        </h4>
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                                            <% branchSummaries.forEach(bs=> { %>
                                                <div class="branch-summary-card p-3 bg-slate-50 rounded-lg border border-slate-200/80 flex flex-col justify-between"
                                                    style="border-radius: 10px; gap: 8px;">
                                                    <div>
                                                        <div class="school-title font-bold text-gray-800 text-sm">
                                                            <%= bs.school_name %>
                                                        </div>
                                                        <div class="text-xs text-gray-400">
                                                            <%= bs.branch_name || lan.Main_Branch %>
                                                        </div>
                                                    </div>
                                                    <div
                                                        class="flex items-center justify-between text-xs pt-2 border-t border-slate-200/60">
                                                        <span class="text-gray-500" style="font-size: 11px;">
                                                            <%= bs.published_exams_count %> <%- lan.Published_Exams %>
                                                        </span>
                                                        <span class="font-extrabold text-emerald-600"
                                                            style="font-size: 11px;">
                                                            <%= bs.avg_pass_percent %>% <%- lan.Pass_Label %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                                    <div class="card"
                                        style="border-radius: 14px; overflow: hidden; border: 1px solid #E2E8F0;">
                                        <div class="card-header bg-slate-50/20"
                                            style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9;">
                                            <h4 class="card-title flex items-center gap-2"
                                                style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0;">
                                                <i class="fa-solid fa-award text-teal-600"></i> <%-
                                                    lan.Exam_Performance_Rollup %>
                                            </h4>
                                        </div>
                                        <div class="card-body p-0">
                                            <% if (exams.length===0) { %>
                                                <div class="p-6 text-center text-gray-400"
                                                    style="padding: 36px 20px; font-size: 13px;"><%-
                                                        lan.No_Published_Exams_Found %></div>
                                                <% } else { %>
                                                    <div style="overflow-x: auto;">
                                                        <table class="table academic-desktop-table">
                                                            <thead>
                                                                <tr
                                                                    style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
                                                                    <th
                                                                        style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">
                                                                        <%- lan.Exam_Name %></th>
                                                                    <th
                                                                        style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">
                                                                        <%- lan.Branch_School %></th>
                                                                    <th
                                                                        style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">
                                                                        <%- lan.Date %></th>
                                                                    <th
                                                                        style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">
                                                                        <%- lan.Students_Marked %></th>
                                                                    <th
                                                                        style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">
                                                                        <%- lan.Pass_Percent %></th>
                                                                    <th
                                                                        style="padding: 12px 16px; font-size: 11px; font-weight: 700; color: #64748B; text-transform: uppercase;">
                                                                        <%- lan.Average_Marks %></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% exams.forEach(exam=> { %>
                                                                    <tr style="border-bottom: 1px solid #F1F5F9;">
                                                                        <td style="padding: 12px 16px;">
                                                                            <div
                                                                                class="font-semibold text-gray-800 text-sm">
                                                                                <%= exam.exam_name %>
                                                                            </div>
                                                                        </td>
                                                                        <td style="padding: 12px 16px;">
                                                                            <div
                                                                                class="text-sm font-medium text-gray-700">
                                                                                <%= exam.school_name %>
                                                                            </div>
                                                                            <% if (exam.branch_name) { %>
                                                                                <div class="text-xs text-gray-400">
                                                                                    <%= exam.branch_name %>
                                                                                </div>
                                                                                <% } %>
                                                                        </td>
                                                                        <td style="padding: 12px 16px;">
                                                                            <%= exam.start_date ? new
                                                                                Date(exam.start_date).toLocaleDateString('en-IN')
                                                                                : '-' %>
                                                                        </td>
                                                                        <td style="padding: 12px 16px;"><strong
                                                                                class="text-gray-800">
                                                                                <%= exam.total_marked %>
                                                                            </strong></td>
                                                                        <td style="padding: 12px 16px;">
                                                                            <% if (parseFloat(exam.pass_percent)>= 50) {
                                                                                %>
                                                                                <span class="badge badge-success"
                                                                                    style="background:#dcfce7;color:#15803d; padding: 3px 8px; font-size: 11px;">
                                                                                    <%= exam.pass_percent %>%
                                                                                </span>
                                                                                <% } else { %>
                                                                                    <span class="badge badge-secondary"
                                                                                        style="background:#fee2e2;color:#b91c1c; padding: 3px 8px; font-size: 11px;">
                                                                                        <%= exam.pass_percent %>%
                                                                                    </span>
                                                                                    <% } %>
                                                                        </td>
                                                                        <td style="padding: 12px 16px;"><strong
                                                                                class="text-blue-600">
                                                                                <%= exam.avg_marks %>
                                                                            </strong></td>
                                                                    </tr>
                                                                    <% }) %>
                                                            </tbody>
                                                        </table>
                                                        <div class="academic-mobile-cards">
                                                            <% exams.forEach(exam=> { %>
                                                                <div class="academic-item-card-mobile">
                                                                    <div
                                                                        style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                                                        <div>
                                                                            <div class="exam-name"
                                                                                style="font-size: 14px; font-weight: 800; color: #0F172A;">
                                                                                <%= exam.exam_name %>
                                                                            </div>
                                                                            <div
                                                                                style="font-size: 11px; color: #64748B; margin-top: 2px;">
                                                                                <i class="far fa-calendar-alt"></i>
                                                                                <%= exam.start_date ? new
                                                                                    Date(exam.start_date).toLocaleDateString('en-IN')
                                                                                    : '-' %>
                                                                            </div>
                                                                        </div>
                                                                        <% if (parseFloat(exam.pass_percent)>= 50) { %>
                                                                            <span class="badge badge-success"
                                                                                style="background:#dcfce7; color:#15803d; font-size: 11px; padding: 3px 8px;">
                                                                                <%= exam.pass_percent %>% <%-
                                                                                        lan.Pass_Label %>
                                                                            </span>
                                                                            <% } else { %>
                                                                                <span class="badge badge-secondary"
                                                                                    style="background:#fee2e2; color:#b91c1c; font-size: 11px; padding: 3px 8px;">
                                                                                    <%= exam.pass_percent %>% <%-
                                                                                            lan.Pass_Label %>
                                                                                </span>
                                                                                <% } %>
                                                                    </div>
                                                                    <div
                                                                        style="font-size: 12px; color: #475569; background: rgba(0,0,0,0.02); padding: 8px 10px; border-radius: 8px;">
                                                                        <div style="font-weight: 700; color: #0891B2;">
                                                                            <%= exam.school_name %>
                                                                        </div>
                                                                        <% if (exam.branch_name) { %>
                                                                            <div
                                                                                style="font-size: 11px; color: #64748B;">
                                                                                <%= exam.branch_name %>
                                                                            </div>
                                                                            <% } %>
                                                                    </div>
                                                                    <div
                                                                        style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #F1F5F9; padding-top: 8px; font-size: 11.5px;">
                                                                        <div>
                                                                            <span
                                                                                style="color: #64748B; font-size: 10px; text-transform: uppercase;"><%-
                                                                                    lan.Students %>:</span>
                                                                            <strong
                                                                                style="color: #0F172A; margin-left: 4px;">
                                                                                <%= exam.total_marked %>
                                                                            </strong>
                                                                        </div>
                                                                        <div>
                                                                            <span
                                                                                style="color: #64748B; font-size: 10px; text-transform: uppercase;"><%-
                                                                                    lan.Avg_Marks %>:</span>
                                                                            <strong
                                                                                style="color: #2563EB; margin-left: 4px; font-size: 13px;">
                                                                                <%= exam.avg_marks %>
                                                                            </strong>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <% }) %>
                                                        </div>
                                                    </div>
                                                    <%- include('../partials/pagination.ejs') %>
                                                        <% } %>
                                        </div>
                                    </div>
                    </div>
                    <%- include('../partials/footer') %>
            </div>
    </div>