<%- include('../partials/head') %>
<div class="app-wrapper groupadmin-theme">
    <%- include('../partials/sidebar', { currentPath: '/groupadmin/academics' }) %>
    <div class="main-panel">
        <%- include('../partials/header') %>
        <div class="content">
            <%- include('../partials/flashMessages') %>
            <div class="group-page-header flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6"><div>
            <span class="text-xs font-semibold text-teal-600 uppercase tracking-wider">Academic Performance</span>
            <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Group Academic Performance</h2>
            <p class="text-xs text-gray-500 mt-1">Consolidated aggregate exam pass percentages and averages across assigned branches</p>
        </div>
        <div class="group-filter-panel flex items-center gap-3">
            <label for="branchFilterSelect" class="text-xs font-semibold text-gray-500 whitespace-nowrap">Filter Branch:</label>
            <select id="branchFilterSelect" class="form-input custom-select" style="min-width: 200px;" onchange="window.location.href = '/groupadmin/academics?branchId=' + this.value">
                <option value="">All Schools / Branches</option>
                <% branches.forEach(b => { %>
                    <option value="<%= b.id %>" <%= activeBranchId == b.id ? 'selected' : '' %>><%= b.school_name %> <%= b.branch_name ? ' - ' + b.branch_name : '' %></option>
                <% }) %>
            </select>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="card p-4 flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Published Exams</span>
                <h3 class="text-2xl font-extrabold text-gray-800"><%= overallStats.publishedExamCount %></h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-lg font-bold">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
        </div>
        <div class="card p-4 flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Avg Pass Rate</span>
                <h3 class="text-2xl font-extrabold text-emerald-600"><%= overallStats.avgPassPercent %>%</h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg font-bold">
                <i class="fa-solid fa-chart-line"></i>
            </div>
        </div>
        <div class="card p-4 flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Avg Exam Score</span>
                <h3 class="text-2xl font-extrabold text-blue-600"><%= overallStats.avgMarks %></h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg font-bold">
                <i class="fa-solid fa-award"></i>
            </div>
        </div>
    </div>
    <% if (branchSummaries && branchSummaries.length > 0) { %>
        <div class="card mb-6">
            <div class="card-header bg-slate-50/20">
                <h4 class="card-title flex items-center gap-2 text-sm font-bold text-gray-800">
                    <i class="fa-solid fa-code-branch text-teal-600"></i> Branch Performance Summary
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <% branchSummaries.forEach(bs => { %>
                        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200/80 flex flex-col justify-between">
                            <div>
                                <div class="font-bold text-gray-800 text-sm"><%= bs.school_name %></div>
                                <div class="text-xs text-gray-400 mb-2"><%= bs.branch_name || 'Main Branch' %></div>
                            </div>
                            <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-200/60">
                                <span class="text-gray-500"><%= bs.published_exams_count %> Published Exams</span>
                                <span class="font-extrabold text-emerald-600"><%= bs.avg_pass_percent %>% Pass Rate</span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    <% } %>
    <div class="card">
        <div class="card-header bg-slate-50/20">
            <h4 class="card-title flex items-center gap-2">
                <i class="fa-solid fa-award text-teal-600"></i> Exam Performance Rollup (Published Exams)
            </h4>
        </div>
        <div class="card-body p-0">
            <% if (exams.length === 0) { %>
                <div class="p-6 text-center text-gray-400">No published exam performance records found in this scope.</div>
            <% } else { %>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Exam Name</th>
                            <th>Branch / School</th>
                            <th>Date</th>
                            <th>Students Marked</th>
                            <th>Pass %</th>
                            <th>Average Marks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% exams.forEach(exam => { %>
                            <tr>
                                <td>
                                    <div class="font-semibold text-gray-800 text-sm">
                                        <%= exam.exam_name %>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-sm font-medium text-gray-700"><%= exam.school_name %></div>
                                    <% if (exam.branch_name) { %>
                                        <div class="text-xs text-gray-400"><%= exam.branch_name %></div>
                                    <% } %>
                                </td>
                                <td><%= exam.start_date ? new Date(exam.start_date).toLocaleDateString('en-IN') : '-' %></td>
                                <td><strong class="text-gray-800"><%= exam.total_marked %></strong></td>
                                <td>
                                    <% if (parseFloat(exam.pass_percent) >= 50) { %>
                                        <span class="badge badge-success" style="background:#dcfce7;color:#15803d;">
                                            <%= exam.pass_percent %>%
                                        </span>
                                    <% } else { %>
                                        <span class="badge badge-secondary" style="background:#fee2e2;color:#b91c1c;">
                                            <%= exam.pass_percent %>%
                                        </span>
                                    <% } %>
                                </td>
                                <td><strong class="text-blue-600"><%= exam.avg_marks %></strong></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
                <%- include('../partials/pagination.ejs') %>
            <% } %>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
  </div>
</div>