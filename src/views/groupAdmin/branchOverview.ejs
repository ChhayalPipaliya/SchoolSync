<%- include('../partials/head') %>
<style>
    .branch-overview-header {
        background: linear-gradient(135deg, #ecfeff, #ffffff);
        border: 1px solid #bae6fd;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .branch-overview-kicker {
        font-size: 12px;
        font-weight: 800;
        color: #0f766e;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 4px;
    }

    .branch-overview-title {
        font-size: 24px;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
        line-height: 1.2;
    }

    .branch-overview-subtitle {
        font-size: 13px;
        color: #64748b;
        margin: 6px 0 0;
    }

    .branch-stat-grid {
        display: grid !important;
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        gap: 16px !important;
        margin-bottom: 24px !important;
        width: 100% !important;
    }

    .branch-stat-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        min-height: 112px;
    }

    .branch-stat-body {
        height: 100%;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .branch-stat-label {
        font-size: 12px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin: 0 0 8px;
        line-height: 1.2;
    }

    .branch-stat-value {
        font-size: 28px;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
        line-height: 1;
    }

    .branch-stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 18px;
    }

    .branch-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .branch-section-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
        overflow: hidden;
        margin-bottom: 16px;
    }

    .branch-section-header {
        padding: 14px 18px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .branch-section-title {
        font-size: 15px;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .branch-section-body {
        padding: 18px;
    }

    .branch-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .branch-info-grid.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .branch-info-label {
        font-size: 12px;
        color: #64748b;
        font-weight: 700;
        margin: 0 0 5px;
    }

    .branch-info-value {
        font-size: 14px;
        color: #0f172a;
        font-weight: 800;
        margin: 0;
        word-break: break-word;
    }

    .branch-info-value.big {
        font-size: 20px;
        font-weight: 900;
    }

    .branch-note-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 16px 18px;
        color: #64748b;
        font-size: 13px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 20px;
    }

    .branch-status-badge {
        display: inline-flex;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .branch-status-badge.active {
        background: #dcfce7;
        color: #166534;
    }

    .branch-status-badge.inactive {
        background: #f1f5f9;
        color: #475569;
    }

    @media (max-width: 1200px) {
        .branch-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }

    @media (max-width: 900px) {
        .branch-details-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .branch-stat-grid {
            grid-template-columns: 1fr !important;
        }

        .branch-info-grid,
        .branch-info-grid.three {
            grid-template-columns: 1fr;
        }

        .branch-overview-header {
            align-items: stretch;
        }

        .branch-overview-header .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>
<%
    const safeTodayTotal = Number(todayAtt && todayAtt.total ? todayAtt.total : 0);
    const safeTodayPresent = Number(todayAtt && todayAtt.present ? todayAtt.present : 0);
    const todayPct = safeTodayTotal > 0 ? ((safeTodayPresent / safeTodayTotal) * 100).toFixed(1) : '0.0';
    const safePendingFines = Number(libraryStats && libraryStats.pending_fines ? libraryStats.pending_fines : 0);
    const safeTotalAmount = Number(feeStats && feeStats.total_amount ? feeStats.total_amount : 0);
    const safePaidAmount = Number(feeStats && feeStats.paid_amount ? feeStats.paid_amount : 0);
    const safePendingFees = Math.max(safeTotalAmount - safePaidAmount, 0);
    const mediumNames = Array.isArray(mediums) && mediums.length ? mediums.map(m => m.name).join(', ') : '-';
%>
<div class="app-wrapper groupadmin-theme">
    <%- include('../partials/sidebar', { currentPath: '/groupadmin/branches' }) %>
    <div class="main-panel">
        <%- include('../partials/header') %>
        <div class="content">
            <%- include('../partials/flashMessages') %>
            <div class="branch-overview-header">
                <div>
                    <div class="branch-overview-kicker">Branch Overview</div>
                    <h2 class="branch-overview-title"><%= school.school_name %></h2>
                    <p class="branch-overview-subtitle">
                        <%= school.group_name || 'Standalone School' %>
                        <%= school.branch_name ? ' · ' + school.branch_name : '' %>
                        (Code: <%= school.branch_code || '-' %>)
                    </p>
                </div>
                <a href="/groupadmin/branches" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1"></i>
                    Back to Branches
                </a>
            </div>
            <div class="branch-stat-grid">
                <div class="branch-stat-card" style="border-left: 4px solid #3b82f6;">
                    <div class="branch-stat-body">
                        <div>
                            <p class="branch-stat-label">Students</p>
                            <h3 class="branch-stat-value"><%= studentCount || 0 %></h3>
                        </div>
                        <div class="branch-stat-icon" style="background:#eff6ff;color:#2563eb;">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                    </div>
                </div>
                <div class="branch-stat-card" style="border-left: 4px solid #10b981;">
                    <div class="branch-stat-body">
                        <div>
                            <p class="branch-stat-label">Teachers</p>
                            <h3 class="branch-stat-value"><%= teacherCount || 0 %></h3>
                        </div>
                        <div class="branch-stat-icon" style="background:#ecfdf5;color:#059669;">
                            <i class="fa-solid fa-chalkboard-teacher"></i>
                        </div>
                    </div>
                </div>
                <div class="branch-stat-card" style="border-left: 4px solid #f59e0b;">
                    <div class="branch-stat-body">
                        <div>
                            <p class="branch-stat-label">Today's Attendance</p>
                            <h3 class="branch-stat-value"><%= todayPct %>%</h3>
                        </div>
                        <div class="branch-stat-icon" style="background:#fffbeb;color:#d97706;">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>
                    </div>
                </div>
                <div class="branch-stat-card" style="border-left: 4px solid #ef4444;">
                    <div class="branch-stat-body">
                        <div>
                            <p class="branch-stat-label">Pending Fines</p>
                            <h3 class="branch-stat-value">
                                ₹<%= Math.round(safePendingFines).toLocaleString('en-IN') %>
                            </h3>
                        </div>
                        <div class="branch-stat-icon" style="background:#fef2f2;color:#dc2626;">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="branch-details-grid">
                <div>
                    <div class="branch-section-card">
                        <div class="branch-section-header">
                            <h5 class="branch-section-title">
                                <i class="fa-solid fa-address-card" style="color:#0f766e;"></i>
                                School Profile
                            </h5>
                        </div>
                        <div class="branch-section-body">
                            <div class="branch-info-grid">
                                <div>
                                    <p class="branch-info-label">School Name</p>
                                    <p class="branch-info-value"><%= school.school_name || '-' %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Branch Name</p>
                                    <p class="branch-info-value"><%= school.branch_name || '-' %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Area / Location</p>
                                    <p class="branch-info-value"><%= school.area || '-' %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Branch Code</p>
                                    <p class="branch-info-value"><%= school.branch_code || '-' %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">School Email</p>
                                    <p class="branch-info-value"><%= school.school_email || '-' %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">School Phone</p>
                                    <p class="branch-info-value"><%= school.school_phone || '-' %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Mediums</p>
                                    <p class="branch-info-value"><%= mediumNames %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Status</p>
                                    <span class="branch-status-badge <%= school.status === 'active' ? 'active' : 'inactive' %>">
                                        <%= school.status || '-' %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="branch-section-card">
                        <div class="branch-section-header">
                            <h5 class="branch-section-title">
                                <i class="fa-solid fa-graduation-cap" style="color:#2563eb;"></i>
                                Academic Summary
                            </h5>
                        </div>
                        <div class="branch-section-body">
                            <div class="branch-info-grid">
                                <div>
                                    <p class="branch-info-label">Total Classes</p>
                                    <p class="branch-info-value big"><%= classesCount || 0 %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Total Subjects</p>
                                    <p class="branch-info-value big"><%= subjectsCount || 0 %></p>
                                </div>
                                <div style="grid-column: 1 / -1;">
                                    <p class="branch-info-label">Today's Attendance Status</p>
                                    <p class="branch-info-value">
                                        <%= safeTodayPresent %> present out of <%= safeTodayTotal %> attendance record(s)
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="branch-section-card">
                        <div class="branch-section-header">
                            <h5 class="branch-section-title">
                                <i class="fa-solid fa-money-check-dollar" style="color:#7c3aed;"></i>
                                Fees Summary
                            </h5>
                        </div>
                        <div class="branch-section-body">
                            <div class="branch-info-grid">
                                <div>
                                    <p class="branch-info-label">Total Demanded Fees</p>
                                    <p class="branch-info-value">
                                        ₹<%= Math.round(safeTotalAmount).toLocaleString('en-IN') %>
                                    </p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Total Collected Fees</p>
                                    <p class="branch-info-value" style="color:#059669;">
                                        ₹<%= Math.round(safePaidAmount).toLocaleString('en-IN') %>
                                    </p>
                                </div>
                                <div style="grid-column: 1 / -1;">
                                    <p class="branch-info-label">Pending Fees Balance</p>
                                    <p class="branch-info-value big" style="color:#dc2626;">
                                        ₹<%= Math.round(safePendingFees).toLocaleString('en-IN') %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="branch-section-card">
                        <div class="branch-section-header">
                            <h5 class="branch-section-title">
                                <i class="fa-solid fa-bus" style="color:#ca8a04;"></i>
                                Transport Summary
                            </h5>
                        </div>
                        <div class="branch-section-body">
                            <div class="branch-info-grid three">
                                <div>
                                    <p class="branch-info-label">Active Vehicles</p>
                                    <p class="branch-info-value big"><%= transportStats.total_vehicles || 0 %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Active Routes</p>
                                    <p class="branch-info-value big"><%= transportStats.total_routes || 0 %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Active Drivers</p>
                                    <p class="branch-info-value big"><%= transportStats.total_drivers || 0 %></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="branch-section-card">
                        <div class="branch-section-header">
                            <h5 class="branch-section-title">
                                <i class="fa-solid fa-book-open" style="color:#0891b2;"></i>
                                Library Summary
                            </h5>
                        </div>
                        <div class="branch-section-body">
                            <div class="branch-info-grid">
                                <div>
                                    <p class="branch-info-label">Total Books Count</p>
                                    <p class="branch-info-value big"><%= libraryStats.total_books || 0 %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Issued Books</p>
                                    <p class="branch-info-value big"><%= libraryStats.issued_books || 0 %></p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Overdue Issues</p>
                                    <p class="branch-info-value big" style="color:#dc2626;">
                                        <%= libraryStats.overdue_books || 0 %>
                                    </p>
                                </div>
                                <div>
                                    <p class="branch-info-label">Library Outstanding Fines</p>
                                    <p class="branch-info-value big" style="color:#dc2626;">
                                        ₹<%= Math.round(safePendingFines).toLocaleString('en-IN') %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="branch-note-card">
                <i class="fa-solid fa-info-circle" style="color:#0f766e;margin-top:2px;"></i>
                <span>
                    This screen is a read-only consolidated overview for the Group Admin.
                    Dynamic changes in students, staff, fees, transport, or library must be done by the respective School Administrator.
                </span>
            </div>
        </div>
        <%- include('../partials/footer') %>
    </div>
</div>