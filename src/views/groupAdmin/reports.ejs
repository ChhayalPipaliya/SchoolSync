<%- include('../partials/head', { needsCharts: true }) %>
    <style>
        .reports-page-header {
            background: linear-gradient(135deg, #ecfeff, #ffffff);
            border: 1px solid #bae6fd;
            border-radius: 14px;
            padding: 18px 22px;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .reports-kicker {
            font-size: 12px;
            font-weight: 800;
            color: #0f766e;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 4px;
        }

        .reports-title {
            font-size: 24px;
            font-weight: 900;
            color: #0f172a;
            margin: 0;
        }

        .reports-subtitle {
            font-size: 13px;
            color: #64748b;
            margin: 6px 0 0;
        }

        .reports-filter-panel {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .reports-filter-panel label {
            font-size: 12px;
            font-weight: 800;
            color: #64748b;
            white-space: nowrap;
            margin: 0;
        }

        .reports-filter-panel select {
            min-width: 260px;
            height: 40px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 0 12px;
            color: #0f172a;
            background: #ffffff;
            outline: none;
        }

        .reports-grid {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            gap: 16px !important;
            width: 100% !important;
            margin-bottom: 24px;
        }

        .report-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
            overflow: hidden;
            min-height: 190px;
            display: flex;
            flex-direction: column;
        }

        .report-card-body {
            padding: 20px;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .report-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 14px;
        }

        .report-card-title {
            font-size: 16px;
            font-weight: 900;
            color: #0f172a;
            margin: 0;
            line-height: 1.35;
        }

        .report-card-desc {
            font-size: 13px;
            color: #64748b;
            line-height: 1.5;
            margin: 0 0 16px;
            flex: 1;
        }

        .report-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 18px;
        }

        .report-card-footer {
            border-top: 1px solid #e5e7eb;
            padding-top: 14px;
            margin-top: auto;
        }

        .report-value-label {
            font-size: 11px;
            font-weight: 800;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin: 0 0 6px;
        }

        .report-value {
            font-size: 24px;
            font-weight: 900;
            color: #0f172a;
            margin: 0;
            line-height: 1;
        }

        .report-value.green {
            color: #059669;
        }

        .report-value.red {
            color: #dc2626;
        }

        @media (max-width: 768px) {
            .reports-grid {
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 10px !important;
                margin-bottom: 14px !important;
            }

            .report-card {
                min-height: 110px !important;
                border-radius: 12px !important;
            }

            .report-card-body {
                padding: 12px 14px !important;
            }

            .report-card-top {
                margin-bottom: 6px !important;
                gap: 6px !important;
            }

            .report-card-title {
                font-size: 12px !important;
                font-weight: 800 !important;
            }

            .report-icon {
                width: 32px !important;
                height: 32px !important;
                font-size: 13px !important;
                border-radius: 8px !important;
            }

            .report-card-desc {
                display: none !important;
            }

            .report-card-footer {
                border-top: none !important;
                padding-top: 0 !important;
                margin-top: auto !important;
            }

            .report-value-label {
                font-size: 9.5px !important;
                margin-bottom: 2px !important;
            }

            .report-value {
                font-size: 18px !important;
            }

            .reports-page-header {
                padding: 16px 14px !important;
                margin-bottom: 14px !important;
                align-items: stretch;
            }

            .reports-title {
                font-size: 20px !important;
            }

            .reports-subtitle {
                font-size: 12px !important;
            }

            .reports-filter-panel {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
            }

            .reports-filter-panel select {
                width: 100%;
                min-width: 100%;
            }

            .reports-desktop-table {
                display: none !important;
            }

            .reports-mobile-cards {
                display: flex !important;
                flex-direction: column;
                gap: 12px;
                padding: 12px;
            }

            .report-breakdown-card-mobile {
                background: #F8FAFC;
                border: 1px solid #E2E8F0;
                border-radius: 12px;
                padding: 14px;
                display: flex;
                flex-direction: column;
                gap: 10px;
            }
        }

        [data-theme="dark"] .report-breakdown-card-mobile,
        .light-mode-disabled .report-breakdown-card-mobile {
            background: #101726 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .report-breakdown-card-mobile .school-name,
        .light-mode-disabled .report-breakdown-card-mobile .school-name {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .reports-page-header,
        .light-mode-disabled .reports-page-header {
            background: #151D30 !important;
            background-image: none !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .report-card,
        .light-mode-disabled .report-card,
        [data-theme="dark"] .card,
        .light-mode-disabled .card {
            background: #151D30 !important;
            background-color: #151D30 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .reports-kicker,
        .light-mode-disabled .reports-kicker {
            color: #2DD4BF !important;
        }

        [data-theme="dark"] .reports-title,
        .light-mode-disabled .reports-title,
        [data-theme="dark"] .report-card-title,
        .light-mode-disabled .report-card-title,
        [data-theme="dark"] .report-value:not(.green):not(.red),
        .light-mode-disabled .report-value:not(.green):not(.red),
        [data-theme="dark"] .card-title,
        .light-mode-disabled .card-title,
        [data-theme="dark"] .text-gray-800,
        .light-mode-disabled .text-gray-800 {
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .reports-subtitle,
        .light-mode-disabled .reports-subtitle,
        [data-theme="dark"] .report-card-desc,
        .light-mode-disabled .report-card-desc,
        [data-theme="dark"] .report-value-label,
        .light-mode-disabled .report-value-label,
        [data-theme="dark"] .text-gray-400,
        .light-mode-disabled .text-gray-400,
        [data-theme="dark"] .table thead th,
        .light-mode-disabled .table thead th {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .reports-filter-panel,
        .light-mode-disabled .reports-filter-panel {
            background: #101726 !important;
            border-color: #242F4D !important;
        }

        [data-theme="dark"] .reports-filter-panel label,
        .light-mode-disabled .reports-filter-panel label {
            color: #94A3B8 !important;
        }

        [data-theme="dark"] .reports-filter-panel select,
        .light-mode-disabled .reports-filter-panel select {
            background: #101726 !important;
            border-color: #334155 !important;
            color: #F1F5F9 !important;
        }

        [data-theme="dark"] .report-card-footer,
        .light-mode-disabled .report-card-footer {
            border-top-color: #242F4D !important;
        }

        [data-theme="dark"] .report-icon[style*="eff6ff"],
        .light-mode-disabled .report-icon[style*="eff6ff"] {
            background: rgba(59, 130, 246, 0.15) !important;
            color: #60A5FA !important;
        }

        [data-theme="dark"] .report-icon[style*="fffbeb"],
        .light-mode-disabled .report-icon[style*="fffbeb"] {
            background: rgba(245, 158, 11, 0.15) !important;
            color: #FCD34D !important;
        }

        [data-theme="dark"] .report-icon[style*="ecfdf5"],
        .light-mode-disabled .report-icon[style*="ecfdf5"] {
            background: rgba(16, 185, 129, 0.15) !important;
            color: #34D399 !important;
        }

        [data-theme="dark"] .report-icon[style*="fef2f2"],
        .light-mode-disabled .report-icon[style*="fef2f2"] {
            background: rgba(239, 68, 68, 0.15) !important;
            color: #F87171 !important;
        }

        [data-theme="dark"] .table thead th,
        .light-mode-disabled .table thead th {
            background-color: #101726 !important;
            border-bottom-color: #242F4D !important;
        }

        [data-theme="dark"] .table tbody td,
        .light-mode-disabled .table tbody td {
            border-bottom-color: #242F4D !important;
            color: #E2E8F0 !important;
        }

        [data-theme="dark"] .table tbody tr:hover,
        .light-mode-disabled .table tbody tr:hover {
            background-color: #1E293B !important;
        }
    </style>
    <% const safeBranches=Array.isArray(branches) ? branches : []; const safeStats=stats || {}; const
        safeBreakdown=Array.isArray(branchBreakdown) ? branchBreakdown : []; const
        studentStrength=Number(safeStats.studentStrength || 0); const attendancePct=safeStats.attendancePct || '0.0' ;
        const feesCollected=Number(safeStats.feesCollected || 0); const feesPending=Number(safeStats.feesPending || 0);
        %>
        <div class="app-wrapper groupadmin-theme">
            <%- include('../partials/sidebar', { currentPath: '/groupadmin/reports' }) %>
                <div class="main-panel">
                    <%- include('../partials/header') %>
                        <div class="content">
                            <%- include('../partials/flashMessages') %>
                                <div class="reports-page-header">
                                    <div>
                                        <div class="reports-kicker"><%- lan.Reports_Analytics %></div>
                                        <h2 class="reports-title"><%- lan.Group_Reports_Center %></h2>
                                        <p class="reports-subtitle"><%- lan.Group_Reports_Subtitle %></p>
                                    </div>
                                    <div class="reports-filter-panel">
                                        <label for="branchFilterSelect"><%- lan.Filter_Branch %></label>
                                        <select id="branchFilterSelect"
                                            onchange="window.location.href = '/groupadmin/reports?branchId=' + this.value">
                                            <option value=""><%- lan.All_Schools_Branches %></option>
                                            <% safeBranches.forEach(b=> { %>
                                                <option value="<%= b.id %>" <%=activeBranchId==b.id ? 'selected' : '' %>
                                                    >
                                                    <%= b.school_name %>
                                                        <%= b.branch_name ? ' - ' + b.branch_name : '' %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                </div>
                                <div class="reports-grid">
                                    <div class="report-card">
                                        <div class="report-card-body">
                                            <div class="report-card-top">
                                                <h5 class="report-card-title"><%- lan.Student_Strength_Report %></h5>
                                                <div class="report-icon" style="background:#eff6ff;color:#2563eb;">
                                                    <i class="fa-solid fa-graduation-cap"></i>
                                                </div>
                                            </div>
                                            <p class="report-card-desc"><%- lan.Student_Strength_Desc %></p>
                                            <div class="report-card-footer">
                                                <p class="report-value-label"><%- lan.Total_Registered_Students %></p>
                                                <h3 class="report-value">
                                                    <%= studentStrength.toLocaleString('en-IN') %>
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="report-card">
                                        <div class="report-card-body">
                                            <div class="report-card-top">
                                                <h5 class="report-card-title"><%- lan.Average_Attendance %></h5>
                                                <div class="report-icon" style="background:#fffbeb;color:#d97706;">
                                                    <i class="fa-solid fa-calendar-check"></i>
                                                </div>
                                            </div>
                                            <p class="report-card-desc"><%- lan.Average_Attendance_Desc %></p>
                                            <div class="report-card-footer">
                                                <p class="report-value-label"><%- lan.Average_Attendance_Rate %></p>
                                                <h3 class="report-value">
                                                    <%= attendancePct %>%
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="report-card">
                                        <div class="report-card-body">
                                            <div class="report-card-top">
                                                <h5 class="report-card-title"><%- lan.Fees_Collection_Report %></h5>
                                                <div class="report-icon" style="background:#ecfdf5;color:#059669;">
                                                    <i class="fa-solid fa-money-bill-wave"></i>
                                                </div>
                                            </div>
                                            <p class="report-card-desc"><%- lan.Fees_Collection_Desc %></p>
                                            <div class="report-card-footer">
                                                <p class="report-value-label"><%- lan.Total_Collected_Amount %></p>
                                                <h3 class="report-value green">₹<%=
                                                        Math.round(feesCollected).toLocaleString('en-IN') %>
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="report-card">
                                        <div class="report-card-body">
                                            <div class="report-card-top">
                                                <h5 class="report-card-title"><%- lan.Fees_Outstanding_Report %></h5>
                                                <div class="report-icon" style="background:#fef2f2;color:#dc2626;">
                                                    <i class="fa-solid fa-money-check-alt"></i>
                                                </div>
                                            </div>
                                            <p class="report-card-desc"><%- lan.Fees_Outstanding_Desc %></p>
                                            <div class="report-card-footer">
                                                <p class="report-value-label"><%- lan.Outstanding_Balance %></p>
                                                <h3 class="report-value red">₹<%=
                                                        Math.round(feesPending).toLocaleString('en-IN') %>
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% const chartLabels=safeBreakdown.map(b=> {
                                    const branchPart = b.branch_name ? b.branch_name : 'Main Campus';
                                    let schoolShort = b.school_name || '';
                                    if (schoolShort.length > 20) {
                                    schoolShort = schoolShort.substring(0, 18) + '..';
                                    }
                                    return [schoolShort, branchPart];
                                    });
                                    const fullTitles = safeBreakdown.map(b => b.school_name + (b.branch_name ? " (" +
                                    b.branch_name + ")" : ""));
                                    const chartData = safeBreakdown.map(b => Number(b.fees_collected || 0));
                                    %>
                                    <div class="card mb-3"
                                        style="border-radius: 14px; overflow: hidden; border: 1px solid #E2E8F0;">
                                        <div class="card-header bg-slate-50/20"
                                            style="padding: 16px 20px; border-bottom: 1px solid #F1F5F9;">
                                            <h5 class="card-title flex items-center gap-2"
                                                style="font-size: 15px; font-weight: 700; color: #0F172A; margin: 0;">
                                                <i class="fa-solid fa-chart-column text-teal-600"></i>
                                                <%- lan.Fees_Collected_Across_Branches %>
                                            </h5>
                                        </div>
                                        <div class="card-body" style="padding: 16px 14px; position: relative;">
                                            <div style="position: relative; height: 280px; width: 100%;">
                                                <canvas id="feesCollectedBranchChart"
                                                    data-titles='<%= JSON.stringify(fullTitles) %>'
                                                    data-labels='<%= JSON.stringify(chartLabels) %>'
                                                    data-values='<%= JSON.stringify(chartData) %>'></canvas>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card group-table-card">
                                        <div class="card-header bg-slate-50/20">
                                            <h4 class="card-title flex items-center gap-2">
                                                <i class="fa-solid fa-network-wired text-teal-600"></i>
                                                <%- lan.Branch_Performance_Breakdown %>
                                            </h4>
                                        </div>
                                        <div class="card-body p-0">
                                            <% if (safeBreakdown.length===0) { %>
                                                <div class="p-6 text-center text-gray-400">
                                                    <%- lan.No_Branch_Performance_Records %>
                                                </div>
                                                <% } else { %>
                                                    <div class="group-table-wrap"
                                                        style="width: 100%; overflow-x: auto;">
                                                        <table class="table reports-desktop-table"
                                                            style="width: 100%; min-width: 800px;">
                                                            <thead>
                                                                <tr>
                                                                    <th><%- lan.Branch_School_Name %></th>
                                                                    <th><%- lan.Student_Count %></th>
                                                                    <th><%- lan.Teacher_Count %></th>
                                                                    <th><%- lan.Attendance_30_Days %></th>
                                                                    <th><%- lan.Fees_Collected_Month %></th>
                                                                    <th><%- lan.Fees_Pending %></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% safeBreakdown.forEach(b=> { %>
                                                                    <tr>
                                                                        <td>
                                                                            <div
                                                                                class="font-bold text-gray-800 text-sm">
                                                                                <%= b.school_name %>
                                                                            </div>
                                                                            <% if (b.branch_name) { %>
                                                                                <div class="text-xs text-gray-400">
                                                                                    <%= b.branch_name %>
                                                                                </div>
                                                                                <% } %>
                                                                        </td>
                                                                        <td><strong class="text-gray-800">
                                                                                <%= Number(b.student_count ||
                                                                                    0).toLocaleString('en-IN') %>
                                                                            </strong></td>
                                                                        <td><strong class="text-gray-800">
                                                                                <%= Number(b.teacher_count ||
                                                                                    0).toLocaleString('en-IN') %>
                                                                            </strong></td>
                                                                        <td>
                                                                            <span class="badge badge-success"
                                                                                style="background:#ecfdf5; color:#059669; font-weight:700;">
                                                                                <%= Number(b.attendance_pct ||
                                                                                    0).toFixed(1) %>%
                                                                            </span>
                                                                        </td>
                                                                        <td><strong class="text-emerald-600">₹<%=
                                                                                    Math.round(Number(b.fees_collected
                                                                                    || 0)).toLocaleString('en-IN') %>
                                                                                    </strong></td>
                                                                        <td><strong class="text-rose-600">₹<%=
                                                                                    Math.round(Number(b.pending_fees ||
                                                                                    0)).toLocaleString('en-IN') %>
                                                                                    </strong></td>
                                                                    </tr>
                                                                    <% }) %>
                                                            </tbody>
                                                        </table>
                                                        <div class="reports-mobile-cards" style="display: none;">
                                                            <% safeBreakdown.forEach(b=> { %>
                                                                <div class="report-breakdown-card-mobile">
                                                                    <div
                                                                        style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                                                                        <div>
                                                                            <div class="school-name"
                                                                                style="font-size: 14px; font-weight: 800; color: #0F172A;">
                                                                                <%= b.school_name %>
                                                                            </div>
                                                                            <% if (b.branch_name) { %>
                                                                                <div
                                                                                    style="font-size: 11px; color: #64748B; margin-top: 1px;">
                                                                                    <%= b.branch_name %>
                                                                                </div>
                                                                                <% } %>
                                                                        </div>
                                                                        <span class="badge badge-success"
                                                                            style="background:#ecfdf5; color:#059669; font-weight:700; font-size: 11px; padding: 4px 8px;">
                                                                            <%= Number(b.attendance_pct || 0).toFixed(1)
                                                                                %>%
                                                                        </span>
                                                                    </div>
                                                                    <div
                                                                        style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; background: rgba(0,0,0,0.02); padding: 10px 12px; border-radius: 10px; font-size: 11.5px;">
                                                                        <div>
                                                                            <div
                                                                                style="color: #64748B; font-size: 10px; text-transform: uppercase;">
                                                                                <%- lan.Students %></div>
                                                                            <div
                                                                                style="font-size: 14px; font-weight: 800; color: #0F172A; margin-top: 2px;">
                                                                                <%= Number(b.student_count ||
                                                                                    0).toLocaleString('en-IN') %>
                                                                            </div>
                                                                        </div>
                                                                        <div>
                                                                            <div
                                                                                style="color: #64748B; font-size: 10px; text-transform: uppercase;">
                                                                                <%- lan.Teachers %></div>
                                                                            <div
                                                                                style="font-size: 14px; font-weight: 800; color: #0F172A; margin-top: 2px;">
                                                                                <%= Number(b.teacher_count ||
                                                                                    0).toLocaleString('en-IN') %>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div
                                                                        style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; background: rgba(0,0,0,0.03); padding: 10px 12px; border-radius: 10px; font-size: 11.5px;">
                                                                        <div>
                                                                            <div
                                                                                style="color: #64748B; font-size: 10px; text-transform: uppercase;">
                                                                                <%- lan.Fees_Collected %></div>
                                                                            <div
                                                                                style="font-size: 13.5px; font-weight: 800; color: #059669; margin-top: 2px;">
                                                                                ₹<%= Math.round(Number(b.fees_collected
                                                                                    || 0)).toLocaleString('en-IN') %>
                                                                            </div>
                                                                        </div>
                                                                        <div>
                                                                            <div
                                                                                style="color: #64748B; font-size: 10px; text-transform: uppercase;">
                                                                                <%- lan.Fees_Pending %></div>
                                                                            <div
                                                                                style="font-size: 13.5px; font-weight: 800; color: #DC2626; margin-top: 2px;">
                                                                                ₹<%= Math.round(Number(b.pending_fees ||
                                                                                    0)).toLocaleString('en-IN') %>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <% }) %>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                        </div>
                                    </div>
                        </div>
                        <%- include('../partials/footer') %>
                </div>
        </div>

        <script src="/js/charts.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const canvas = document.getElementById('feesCollectedBranchChart');
                if (!canvas || typeof Chart === 'undefined') return;

                const fullTitles = JSON.parse(canvas.getAttribute('data-titles') || '[]');
                const chartLabels = JSON.parse(canvas.getAttribute('data-labels') || '[]');
                const chartData = JSON.parse(canvas.getAttribute('data-values') || '[]');

                function renderFeesChart() {
                    const isDark = document.documentElement.getAttribute('data-theme') === 'dark' || document.body.classList.contains('light-mode-disabled');
                    const gridColor = isDark ? '#242F4D' : '#E2E8F0';
                    const tickColor = isDark ? '#94A3B8' : '#64748B';
                    const isMobile = window.innerWidth < 768;

                    if (window._feesBranchChartInstance) {
                        window._feesBranchChartInstance.destroy();
                    }

                    window._feesBranchChartInstance = new Chart(canvas, {
                        type: 'bar',
                        data: {
                            labels: chartLabels,
                            datasets: [{
                                label: 'Fees Collected',
                                data: chartData,
                                backgroundColor: 'rgba(16, 185, 129, 0.75)',
                                borderColor: '#10B981',
                                borderWidth: 1.5,
                                borderRadius: 6,
                                maxBarThickness: isMobile ? 38 : 56
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: false
                                },
                                tooltip: {
                                    backgroundColor: isDark ? '#101726' : '#0F172A',
                                    titleColor: '#F8FAFC',
                                    bodyColor: '#F8FAFC',
                                    borderColor: isDark ? '#242F4D' : '#E2E8F0',
                                    borderWidth: 1,
                                    padding: 10,
                                    callbacks: {
                                        title: function (items) {
                                            if (!items.length) return '';
                                            const idx = items[0].dataIndex;
                                            return fullTitles[idx] || '';
                                        },
                                        label: function (item) {
                                            return ' Fees Collected: ₹' + Number(item.raw).toLocaleString('en-IN');
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: {
                                        color: tickColor,
                                        font: { size: isMobile ? 9.5 : 11, weight: '600' },
                                        maxRotation: 0,
                                        minRotation: 0,
                                        autoSkip: false
                                    }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: gridColor },
                                    ticks: {
                                        color: tickColor,
                                        font: { size: isMobile ? 9.5 : 11 },
                                        callback: function (v) {
                                            if (v >= 100000) return '₹' + (v / 100000).toFixed(1) + 'L';
                                            if (v >= 1000) return '₹' + (v / 1000).toFixed(0) + 'k';
                                            return '₹' + v;
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                renderFeesChart();
                window.addEventListener('resize', renderFeesChart);
                window.addEventListener('themeChanged', renderFeesChart);
            });
        </script>