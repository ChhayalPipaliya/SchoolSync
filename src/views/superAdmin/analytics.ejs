<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Platform Analytics | SchoolSync', needsCharts: true }) %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <style>
    :root {
      --text-primary: #0F172A;
      --text-muted: #64748B;
      --accent-blue: #2563EB;
      --accent-blue-hover: #1D4ED8;
      --accent-blue-light: #EFF6FF;
      --border-color: #E2E8F0;
    }
    
    .superadmin-theme {
      background-color: #F8FAFC;
      font-family: 'Outfit', sans-serif;
    }

    
    .tab-nav {
      display: flex;
      gap: 8px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0px;
      margin-bottom: 24px;
      overflow-x: auto;
    }
    
    .tab-btn {
      padding: 12px 20px;
      font-size: 14px;
      font-weight: 700;
      color: var(--text-muted);
      background: none;
      border: none;
      border-bottom: 3px solid transparent;
      transition: all 0.2s;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }
    
    .tab-btn:hover {
      color: var(--text-primary);
    }
    
    .tab-btn.active {
      color: var(--accent-blue);
      border-bottom-color: var(--accent-blue);
    }
    
    .tab-pane {
      display: none;
    }
    
    .tab-pane.active {
      display: block;
      animation: fadeIn 0.3s ease-in-out;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .metric-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
      transition: transform 0.2s, box-shadow 0.2s;
      height: 100%;
    }
    
    .metric-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }
    
    .chart-container {
      position: relative;
      height: 300px;
      width: 100%;
    }
    
    .date-filter-bar {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    
    .flatpickr-input-custom {
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      width: 240px;
      background: #ffffff;
      cursor: pointer;
    }
  </style>
</head>
<body class="superadmin-theme">
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPath: '/superadmin/analytics' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header', { searchPlaceholder: 'Search analytics…' }) %>
    <%- include('../partials/flashMessages') %>
    <div class="analytics-container">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h1 style="font-size:26px; font-weight:800; color:var(--text-primary); margin:0;">Advanced Platform Analytics</h1>
          <p style="font-size:13px; color:var(--text-muted); margin:4px 0 0;">Track platform metrics, revenue trends, and support analytics</p>
        </div>
      </div>
      <div class="date-filter-bar">
        <div class="d-flex align-items-center gap-2">
          <i class="fas fa-calendar-alt text-muted"></i>
          <span style="font-size: 13px; font-weight: 700; color: var(--text-primary);">Date Range:</span>
          <input type="text" id="dateRangePicker" class="flatpickr-input-custom" placeholder="Select Date Range">
        </div>
        <button id="applyFilterBtn" class="btn btn-primary" style="font-size: 13px; font-weight: 700; padding: 8px 20px; border-radius: 8px; background: var(--accent-blue); border: none;">
          Apply Filters
        </button>
      </div>
      <div class="tab-nav">
        <button class="tab-btn active" data-tab="overview">
          <i class="fas fa-chart-pie"></i> Overview
        </button>
        <button class="tab-btn" data-tab="revenue">
          <i class="fas fa-rupee-sign"></i> Revenue
        </button>
        <button class="tab-btn" data-tab="schools">
          <i class="fas fa-school"></i> Schools
        </button>
        <button class="tab-btn" data-tab="platform">
          <i class="fas fa-server"></i> Platform Health
        </button>
        <button class="tab-btn" data-tab="support">
          <i class="fas fa-life-ring"></i> Support Tickets
        </button>
      </div>
      <div id="overview-tab" class="tab-pane active">
        <div class="row g-4 mb-4">
          <div class="col-md-3">
            <div class="metric-card">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Platform MRR</span>
              <h2 id="overview-mrr" style="font-size: 28px; font-weight: 800; margin: 8px 0 4px; color: var(--text-primary);">₹0</h2>
              <span style="font-size: 12px; color: #10B981; font-weight: 600;"><i class="fas fa-arrow-up"></i> Live tracking</span>
            </div>
          </div>
          <div class="col-md-3">
            <div class="metric-card">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Active Users</span>
              <h2 id="overview-users" style="font-size: 28px; font-weight: 800; margin: 8px 0 4px; color: var(--text-primary);">0</h2>
              <span id="overview-users-trend" style="font-size: 12px; color: var(--text-muted); font-weight: 600;">--</span>
            </div>
          </div>
          <div class="col-md-3">
            <div class="metric-card">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Avg Students / School</span>
              <h2 id="overview-avg-students" style="font-size: 28px; font-weight: 800; margin: 8px 0 4px; color: var(--text-primary);">0</h2>
              <span style="font-size: 12px; color: var(--text-muted); font-weight: 600;"><i class="fas fa-users"></i> Platform average</span>
            </div>
          </div>
          <div class="col-md-3">
            <div class="metric-card">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">SLA Resolution Rate</span>
              <h2 id="overview-resolution" style="font-size: 28px; font-weight: 800; margin: 8px 0 4px; color: var(--text-primary);">0 hrs</h2>
              <span style="font-size: 12px; color: #10B981; font-weight: 600;"><i class="fas fa-clock"></i> Average time</span>
            </div>
          </div>
        </div>
        <div class="row g-4">
          <div class="col-md-8">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Platform Monthly Revenue Trend</h3>
              <div class="chart-container">
                <canvas id="overviewRevenueChart"></canvas>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Schools Status Distribution</h3>
              <div class="chart-container">
                <canvas id="overviewSchoolsChart"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="revenue-tab" class="tab-pane">
        <div class="row g-4 mb-4">
          <div class="col-md-4">
            <div class="metric-card">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Avg Revenue per School</span>
              <h2 id="revenue-avg-school" style="font-size: 28px; font-weight: 800; margin: 8px 0 0; color: var(--text-primary);">₹0</h2>
            </div>
          </div>
        </div>
        <div class="row g-4 mb-4">
          <div class="col-md-8">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Monthly Recurring Revenue (MRR) Trend</h3>
              <div class="chart-container">
                <canvas id="mrrChart"></canvas>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Revenue by Subscription Plan</h3>
              <div class="chart-container">
                <canvas id="planRevenueChart"></canvas>
              </div>
            </div>
          </div>
        </div>
        <div class="row g-4 mb-4">
          <div class="col-md-6">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">MoM Subscription Churn Rate (%)</h3>
              <div class="chart-container">
                <canvas id="churnChart"></canvas>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Top 10 Revenue-Generating Schools</h3>
              <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table align-middle" id="topSchoolsTable" style="font-size: 13px;">
                  <thead>
                    <tr>
                      <th>Rank</th>
                      <th>School Name</th>
                      <th>Plan</th>
                      <th>Status</th>
                      <th>Revenue</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td colspan="5" class="text-center text-muted">Loading data...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="schools-tab" class="tab-pane">
        <div class="row g-4 mb-4">
          <div class="col-md-8">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Onboarding & Growth (New Registrations)</h3>
              <div class="chart-container">
                <canvas id="schoolRegistrationsChart"></canvas>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Schools by Plan Type</h3>
              <div class="chart-container">
                <canvas id="schoolPlansChart"></canvas>
              </div>
            </div>
          </div>
        </div>
        <div class="row g-4">
          <div class="col-md-12">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Geographic Distribution (State/City)</h3>
              <div class="table-responsive">
                <table class="table align-middle" id="geoTable" style="font-size: 13px;">
                  <thead>
                    <tr>
                      <th>State</th>
                      <th>City</th>
                      <th>Schools Count</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td colspan="3" class="text-center text-muted">Loading data...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="platform-tab" class="tab-pane">
        <div class="row g-4 mb-4">
          <div class="col-md-4">
            <div class="metric-card">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Renewal Rate</span>
              <h2 id="platform-renewal" style="font-size: 28px; font-weight: 800; margin: 8px 0 4px; color: var(--text-primary);">0%</h2>
              <span id="platform-renewal-indicator" style="font-size: 12px; font-weight: 600;">--</span>
            </div>
          </div>
        </div>
        <div class="row g-4 mb-4">
          <div class="col-md-8">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Daily Active Users (DAU) - Last 30 Days</h3>
              <div class="chart-container">
                <canvas id="dauChart"></canvas>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Expiring Subscriptions (Next 30 Days)</h3>
              <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table align-middle" id="expiringSchoolsTable" style="font-size: 13px;">
                  <thead>
                    <tr>
                      <th>School</th>
                      <th>Plan</th>
                      <th>Days Left</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td colspan="3" class="text-center text-muted">Loading data...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="support-tab" class="tab-pane">
        <div class="row g-4 mb-4">
          <div class="col-md-6">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Support Tickets Status</h3>
              <div class="chart-container">
                <canvas id="supportStatusChart"></canvas>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card p-4">
              <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px;">Tickets by Category</h3>
              <div class="chart-container">
                <canvas id="supportCategoryChart"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
</main>
</div>
<%- include('../partials/footer') %>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const datePicker = flatpickr("#dateRangePicker", {
      mode: "range",
      dateFormat: "Y-m-d",
      defaultDate: ["2026-04-01", "2027-03-31"], 
    });

    const chartRegistry = {};
    let activeTab = 'overview';

    const createChart = (id, config) => {
      if (chartRegistry[id]) {
        chartRegistry[id].destroy();
      }
      const ctx = document.getElementById(id).getContext('2d');
      chartRegistry[id] = new Chart(ctx, config);
    };

    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        tabBtns.forEach(b => b.classList.remove('active'));
        tabPanes.forEach(p => p.classList.remove('active'));
        
        btn.classList.add('active');
        document.getElementById(`${tab}-tab`).classList.add('active');
        activeTab = tab;
        
        loadTabData(tab);
      });
    });

    const loadTabData = (tab) => {
      const dates = datePicker.selectedDates;
      let from = '', to = '';
      if (dates.length === 2) {
        from = datePicker.formatDate(dates[0], "Y-m-d");
        to = datePicker.formatDate(dates[1], "Y-m-d");
      }

      const queryParams = `?from=${from}&to=${to}`;

      if (tab === 'overview') {
        fetch(`/superadmin/api/analytics/revenue${queryParams}`)
          .then(res => res.json())
          .then(res => {
            if (res.success && res.data) {
              const data = res.data;
              const totalMRR = data.mrrTrend.reduce((sum, item) => sum + parseFloat(item.value || 0), 0);
              document.getElementById('overview-mrr').textContent = `₹${totalMRR.toLocaleString('en-IN')}`;
              
              createChart('overviewRevenueChart', {
                type: 'line',
                data: {
                  labels: data.mrrTrend.map(item => item.label),
                  datasets: [{
                    label: 'MRR',
                    data: data.mrrTrend.map(item => item.value),
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(37, 99, 235, 0.1)',
                    fill: true,
                    tension: 0.3
                  }]
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: {
                    legend: { display: false }
                  }
                }
              });
            }
          });

        fetch(`/superadmin/api/analytics/platform${queryParams}`)
          .then(res => res.json())
          .then(res => {
            if (res.success && res.data) {
              const data = res.data;
              document.getElementById('overview-users').textContent = data.totalActiveUsers.toLocaleString();
              document.getElementById('overview-users-trend').textContent = `${data.userTrendPct >= 0 ? '+' : ''}${data.userTrendPct}% vs last month`;
              document.getElementById('overview-users-trend').className = data.userTrendPct >= 0 ? 'text-success font-semibold text-xs' : 'text-danger font-semibold text-xs';
              document.getElementById('overview-avg-students').textContent = data.avgStudents;
            }
          });

        fetch(`/superadmin/api/analytics/support${queryParams}`)
          .then(res => res.json())
          .then(res => {
            if (res.success && res.data) {
              const data = res.data;
              document.getElementById('overview-resolution').textContent = `${data.avgResolutionTime} hrs`;
            }
          });

        fetch(`/superadmin/api/analytics/schools${queryParams}`)
          .then(res => res.json())
          .then(res => {
            if (res.success && res.data) {
              const data = res.data;
              createChart('overviewSchoolsChart', {
                type: 'doughnut',
                data: {
                  labels: data.statusDist.map(item => item.label),
                  datasets: [{
                    data: data.statusDist.map(item => item.value),
                    backgroundColor: ['#3B82F6', '#10B981', '#F59E0B', '#EF4444']
                  }]
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false
                }
              });
            }
          });
      }

      else if (tab === 'revenue') {
        fetch(`/superadmin/api/analytics/revenue${queryParams}`)
          .then(res => res.json())
          .then(res => {
            if (res.success && res.data) {
              const data = res.data;
              document.getElementById('revenue-avg-school').textContent = `₹${Math.round(data.avgRevenue).toLocaleString('en-IN')}`;

              createChart('planRevenueChart', {
                type: 'doughnut',
                data: {
                  labels: data.revenueByPlan.map(item => item.label),
                  datasets: [{
                    data: data.revenueByPlan.map(item => item.value),
                    backgroundColor: ['#2563EB', '#3B82F6', '#93C5FD']
                  }]
                },
                options: { responsive: true, maintainAspectRatio: false }
              });

              createChart('mrrChart', {
                type: 'line',
                data: {
                  labels: data.mrrTrend.map(item => item.label),
                  datasets: [{
                    label: 'MRR',
                    data: data.mrrTrend.map(item => item.value),
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(37, 99, 235, 0.05)',
                    fill: true,
                    tension: 0.3
                  }]
                },
                options: { responsive: true, maintainAspectRatio: false }
              });

              createChart('churnChart', {
                type: 'bar',
                data: {
                  labels: data.churnMoM.map(item => item.label),
                  datasets: [{
                    label: 'Churn Rate %',
                    data: data.churnMoM.map(item => item.value),
                    backgroundColor: '#EF4444'
                  }]
                },
                options: { responsive: true, maintainAspectRatio: false }
              });

              const tableBody = document.querySelector('#topSchoolsTable tbody');
              tableBody.innerHTML = '';
              if (data.topSchools.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="5" class="text-center text-muted">No schools found</td></tr>`;
              } else {
                data.topSchools.forEach((school, index) => {
                  tableBody.innerHTML += `
                    <tr>
                      <td>#${index + 1}</td>
                      <td><strong>${school.name}</strong></td>
                      <td><span class="badge bg-light text-dark border">${school.plan}</span></td>
                      <td><span class="badge bg-${school.status === 'active' ? 'success' : 'danger'}-subtle text-${school.status === 'active' ? 'success' : 'danger'}">${school.status}</span></td>
                      <td><strong>₹${parseFloat(school.revenue).toLocaleString('en-IN')}</strong></td>
                    </tr>
                  `;
                });
              }
            }
          });
      }

      else if (tab === 'schools') {
        fetch(`/superadmin/api/analytics/schools${queryParams}`)
          .then(res => res.json())
          .then(res => {
            if (res.success && res.data) {
              const data = res.data;

              createChart('schoolRegistrationsChart', {
                type: 'line',
                data: {
                  labels: data.registrations.map(item => item.label),
                  datasets: [{
                    label: 'New Registrations',
                    data: data.registrations.map(item => item.value),
                    borderColor: '#10B981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.3
                  }]
                },
                options: { responsive: true, maintainAspectRatio: false }
              });

              createChart('schoolPlansChart', {
                type: 'bar',
                data: {
                  labels: data.planDist.map(item => item.label),
                  datasets: [{
                    label: 'Schools',
                    data: data.planDist.map(item => item.value),
                    backgroundColor: '#3B82F6'
                  }]
                },
                options: {
                  indexAxis: 'y',
                  responsive: true,
                  maintainAspectRatio: false
                }
              });

              const tableBody = document.querySelector('#geoTable tbody');
              tableBody.innerHTML = '';
              if (data.geoDist.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="3" class="text-center text-muted">No geographic data found</td></tr>`;
              } else {
                data.geoDist.forEach(item => {
                  tableBody.innerHTML += `
                    <tr>
                      <td>${item.state}</td>
                      <td>${item.city}</td>
                      <td><strong>${item.value}</strong></td>
                    </tr>
                  `;
                });
              }
            }
          });
      }

      else if (tab === 'platform') {
        fetch(`/superadmin/api/analytics/platform${queryParams}`)
          .then(res => res.json())
          .then(res => {
            if (res.success && res.data) {
              const data = res.data;
              document.getElementById('platform-renewal').textContent = `${data.renewalRate.toFixed(1)}%`;
              
              const renewalIndicator = document.getElementById('platform-renewal-indicator');
              renewalIndicator.textContent = data.renewalRate >= 80 ? 'Excellent' : (data.renewalRate >= 60 ? 'Satisfactory' : 'Needs attention');
              renewalIndicator.className = data.renewalRate >= 80 ? 'text-success font-semibold text-xs' : (data.renewalRate >= 60 ? 'text-warning font-semibold text-xs' : 'text-danger font-semibold text-xs');

              createChart('dauChart', {
                type: 'line',
                data: {
                  labels: data.dau30Days.map(item => item.label),
                  datasets: [{
                    label: 'DAU',
                    data: data.dau30Days.map(item => item.value),
                    borderColor: '#4F46E5',
                    backgroundColor: 'rgba(79, 70, 229, 0.05)',
                    fill: true,
                    tension: 0.2
                  }]
                },
                options: { responsive: true, maintainAspectRatio: false }
              });

              const tableBody = document.querySelector('#expiringSchoolsTable tbody');
              tableBody.innerHTML = '';
              if (data.expiringSchools.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="3" class="text-center text-muted">No subscriptions expiring in next 30 days</td></tr>`;
              } else {
                data.expiringSchools.forEach(item => {
                  tableBody.innerHTML += `
                    <tr>
                      <td><strong>${item.name}</strong></td>
                      <td><span class="badge bg-light text-dark border">${item.plan}</span></td>
                      <td><span class="badge bg-danger-subtle text-danger">${item.days_left} days left</span></td>
                    </tr>
                  `;
                });
              }
            }
          });
      }

      else if (tab === 'support') {
        fetch(`/superadmin/api/analytics/support${queryParams}`)
          .then(res => res.json())
          .then(res => {
            if (res.success && res.data) {
              const data = res.data;

              createChart('supportStatusChart', {
                type: 'bar',
                data: {
                  labels: data.ticketsStatus.map(item => item.label),
                  datasets: [{
                    label: 'Tickets',
                    data: data.ticketsStatus.map(item => item.value),
                    backgroundColor: ['#10B981', '#3B82F6', '#EF4444', '#F59E0B']
                  }]
                },
                options: { responsive: true, maintainAspectRatio: false }
              });

              createChart('supportCategoryChart', {
                type: 'doughnut',
                data: {
                  labels: data.ticketsCategory.map(item => item.label),
                  datasets: [{
                    data: data.ticketsCategory.map(item => item.value),
                    backgroundColor: ['#2563EB', '#3B82F6', '#93C5FD', '#A5B4FC', '#C7D2FE']
                  }]
                },
                options: { responsive: true, maintainAspectRatio: false }
              });
            }
          });
      }
    };

    document.getElementById('applyFilterBtn').addEventListener('click', () => {
      loadTabData(activeTab);
    });

    loadTabData('overview');
  });
</script>
</body>
</html>
