<%- include('../../partials/head', { title: `${lan.School_Types || 'School Types'} | SchoolSync` }) %>
<div class="app-wrapper superadmin-theme">
  <%- include('../../partials/sidebar', { currentPath: '/superadmin/school-types' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <%- include('../../partials/flashMessages') %>
<div class="page-header d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1 fw-bold text-dark dark:text-slate-100"><i class="fas fa-layer-group me-2 text-primary"></i><%- lan.School_Types || 'School Types' %></h1>
    <p class="text-muted mb-0"><%- lan.School_Types_Sub || 'Manage predefined school type configurations and their class mappings' %></p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTypeModal">
    <i class="fas fa-plus me-2"></i><%- lan.Add_School_Type || 'Add School Type' %>
  </button>
</div>
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="display-6 fw-bold text-primary"><%= schoolTypes.length %></div>
      <div class="text-muted small"><%- lan.Total_Types || 'Total Types' %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="display-6 fw-bold text-success"><%= schoolTypes.filter(t => t.is_active).length %></div>
      <div class="text-muted small"><%- lan.Active_Types || 'Active Types' %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="display-6 fw-bold text-info"><%= schoolTypes.reduce((s, t) => s + t.class_count, 0) %></div>
      <div class="text-muted small"><%- lan.Total_Class_Mappings || 'Total Class Mappings' %></div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="display-6 fw-bold text-warning"><%= schoolTypes.filter(t => !t.is_active).length %></div>
      <div class="text-muted small"><%- lan.Inactive_Types || 'Inactive Types' %></div>
    </div>
  </div>
</div>
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom d-flex align-items-center">
    <i class="fas fa-table me-2 text-primary"></i>
    <span class="fw-semibold"><%- lan.All_School_Types || 'All School Types' %></span>
  </div>
  <div class="card-body p-0">
    <% if (schoolTypes.length === 0) { %>
      <div class="text-center py-5 text-muted">
        <i class="fas fa-layer-group fa-3x mb-3 opacity-25"></i>
        <p><%- lan.No_School_Types_Configured || 'No school types configured yet.' %></p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th><%- lan.Type_Key || 'Type Key' %></th>
            <th><%- lan.Type_Name || 'Type Name' %></th>
            <th><%- lan.Description || 'Description' %></th>
            <th><%- lan.Classes || 'Classes' %></th>
            <th><%- lan.Status || 'Status' %></th>
            <th><%- lan.Actions || 'Actions' %></th>
          </tr>
        </thead>
        <tbody>
          <% schoolTypes.forEach((type, i) => { %>
          <tr>
            <td class="text-muted small"><%= i + 1 %></td>
            <td>
              <span class="badge bg-primary-subtle text-primary font-monospace"><%= type.type_key %></span>
            </td>
            <td class="fw-semibold"><%= type.type_name %></td>
            <td class="text-muted small"><%= type.description || '—' %></td>
            <td>
              <span class="badge bg-info-subtle text-info">
                <i class="fas fa-list me-1"></i><%= type.class_count %> <%- lan.Classes_Count || 'classes' %>
              </span>
            </td>
            <td>
              <% if (type.is_active) { %>
                <span class="badge bg-success-subtle text-success"><i class="fas fa-circle me-1" style="font-size:8px"></i><%- lan.Active || 'Active' %></span>
              <% } else { %>
                <span class="badge bg-danger-subtle text-danger"><i class="fas fa-circle me-1" style="font-size:8px"></i><%- lan.Inactive || 'Inactive' %></span>
              <% } %>
            </td>
            <td>
              <a href="/superadmin/school-types/<%= type.id %>" class="btn btn-sm btn-outline-primary me-1">
                <i class="fas fa-eye me-1"></i><%- lan.View || 'View' %>
              </a>
              <form action="/superadmin/school-types/<%= type.id %>/toggle" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-<%= type.is_active ? 'warning' : 'success' %>">
                  <i class="fas fa-<%= type.is_active ? 'pause' : 'play' %> me-1"></i><%= type.is_active ? (lan.Disable || 'Disable') : (lan.Enable || 'Enable') %>
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
<div class="modal fade" id="addTypeModal" tabindex="-1" aria-labelledby="addTypeModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-md">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="addTypeModalLabel"><i class="fas fa-plus me-2"></i><%- lan.Add_School_Type || 'Add School Type' %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/superadmin/school-types" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold"><%- lan.Type_Key || 'Type Key' %> <span class="text-danger">*</span></label>
            <input type="text" name="type_key" class="form-control" placeholder="<%- lan.Type_Key_Placeholder || 'e.g. pre_primary' %>" required
                   pattern="[a-z_]+" title="<%- lan.Type_Key_Pattern_Title || 'Lowercase letters and underscores only' %>">
            <div class="form-text"><%- lan.Type_Key_Hint || 'Unique identifier (lowercase, underscores). E.g. higher_secondary' %></div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold"><%- lan.Display_Name || 'Display Name' %> <span class="text-danger">*</span></label>
            <input type="text" name="type_name" class="form-control" placeholder="<%- lan.Display_Name_Placeholder || 'e.g. Higher Secondary' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold"><%- lan.Description || 'Description' %></label>
            <textarea name="description" class="form-control" rows="2" placeholder="<%- lan.Brief_Description_Placeholder || 'Brief description...' %>"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold"><%- lan.Sort_Order || 'Sort Order' %></label>
            <input type="number" name="sort_order" class="form-control" value="0" min="0">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%- lan.Cancel || 'Cancel' %></button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i><%- lan.Create || 'Create' %></button>
        </div>
      </form>
    </div>
  </div>
</div>
</div>
        <%- include('../../partials/footer') %>
    </div>
</div>
