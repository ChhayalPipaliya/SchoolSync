<%- include('../../partials/head', { title: `${schoolType.type_name} | SchoolSync` }) %>
<div class="app-wrapper superadmin-theme">
  <%- include('../../partials/sidebar', { currentPath: '/superadmin/school-types' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content">
      <%- include('../../partials/flashMessages') %>
<div class="page-header mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/superadmin/school-types"><%- lan.School_Types || 'School Types' %></a></li>
      <li class="breadcrumb-item active"><%= schoolType.type_name %></li>
    </ol>
  </nav>
  <div class="d-flex justify-content-between align-items-start">
    <div>
      <h1 class="h3 fw-bold mb-1">
        <i class="fas fa-layer-group me-2 text-primary"></i><%= schoolType.type_name %>
      </h1>
      <p class="text-muted mb-0">
        <code class="text-primary"><%= schoolType.type_key %></code>
        <% if (schoolType.description) { %> — <%= schoolType.description %><% } %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <span class="badge bg-<%= schoolType.is_active ? 'success' : 'danger' %>-subtle text-<%= schoolType.is_active ? 'success' : 'danger' %> fs-6 px-3 py-2">
        <%= schoolType.is_active ? (lan.Active || 'Active') : (lan.Inactive || 'Inactive') %>
      </span>
      <a href="/superadmin/school-types" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i><%- lan.Back || 'Back' %>
      </a>
    </div>
  </div>
</div>
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="display-5 fw-bold text-primary"><%= classMappings.length %></div>
      <div class="text-muted"><%- lan.Total_Classes_In_Type || 'Total Classes in Type' %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="display-5 fw-bold text-success"><%= schoolCount %></div>
      <div class="text-muted"><%- lan.Schools_Using_This_Type || 'Schools Using This Type' %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="display-5 fw-bold text-info"><%= schoolType.sort_order %></div>
      <div class="text-muted"><%- lan.Sort_Order || 'Sort Order' %></div>
    </div>
  </div>
</div>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
    <div>
      <i class="fas fa-list me-2 text-primary"></i>
      <span class="fw-semibold"><%- lan.Class_Mappings || 'Class Mappings' %></span>
      <span class="badge bg-primary ms-2"><%= classMappings.length %></span>
    </div>
    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addClassModal">
      <i class="fas fa-plus me-1"></i><%- lan.Add_Class || 'Add Class' %>
    </button>
  </div>
  <div class="card-body p-0">
    <% if (classMappings.length === 0) { %>
      <div class="text-center py-5 text-muted">
        <i class="fas fa-graduation-cap fa-3x mb-3 opacity-25"></i>
        <p class="mb-0"><%- lan.No_Class_Mappings_Yet || 'No class mappings defined yet.' %></p>
        <p class="small"><%- lan.Add_Classes_Define_Grades || 'Add classes to define which grades belong to this school type.' %></p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th><%- lan.Order || 'Order' %></th>
            <th><%- lan.Class_Name || 'Class Name' %></th>
            <th><%- lan.Class_Code || 'Class Code' %></th>
            <th><%- lan.Auto_Generate_Preview || 'Auto-Generate Preview' %></th>
          </tr>
        </thead>
        <tbody>
          <% classMappings.forEach((cls) => { %>
          <tr>
            <td>
              <span class="badge bg-secondary-subtle text-secondary"><%= cls.sort_order %></span>
            </td>
            <td class="fw-semibold"><%= cls.class_name %></td>
            <td>
              <span class="badge bg-primary-subtle text-primary font-monospace"><%= cls.class_code %></span>
            </td>
            <td>
              <span class="text-muted small">
                <% const previewCode = ['NUR','LKG','UKG'].includes(cls.class_code) ? cls.class_name : `Std ${cls.class_code}`; %>
                <%- (lan.Class_Preview_Example || 'Example: <strong>:gujCode-A (Gujarati)</strong>, <strong>:engCode-A (English)</strong>').replace(':gujCode', previewCode).replace(':engCode', previewCode) %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
<div class="card border-0 shadow-sm border-start border-4 border-info">
  <div class="card-body">
    <h6 class="fw-bold text-info mb-2"><i class="fas fa-info-circle me-2"></i><%- lan.How_School_Types_Work || 'How School Types Work' %></h6>
    <ul class="mb-0 small text-muted">
      <li><%- lan.School_Types_Expl_1 || 'School Admins set their school type in <strong>Settings → General</strong>' %></li>
      <li><%- lan.School_Types_Expl_2 || 'The class mappings here populate the <strong>Auto-Generate Classes</strong> feature' %></li>
      <li><%- lan.School_Types_Expl_3 || 'When a school type is set, the suggested classes for auto-generation are from this list' %></li>
      <li><%- lan.School_Types_Expl_4 || 'Schools can override the class list with custom classes at any time' %></li>
    </ul>
  </div>
</div>
<div class="modal fade" id="addClassModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="fas fa-plus me-2"></i><%- lan.Add_Class || 'Add Class' %> <%= schoolType.type_name %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/superadmin/school-types/<%= schoolType.id %>/mappings" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold"><%- lan.Class_Name || 'Class Name' %> <span class="text-danger">*</span></label>
            <input type="text" name="class_name" class="form-control" placeholder="<%- lan.Class_Name_Placeholder || 'e.g. Nursery, Std 1, Std 11' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold"><%- lan.Class_Code || 'Class Code' %> <span class="text-danger">*</span></label>
            <input type="text" name="class_code" class="form-control" placeholder="<%- lan.Class_Code_Placeholder || 'e.g. NUR, LKG, 1, 11' %>" required>
            <div class="form-text"><%- lan.Short_Code_Used_Hint || 'Short code used in display names and auto-generation' %></div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold"><%- lan.Sort_Order || 'Sort Order' %></label>
            <input type="number" name="sort_order" class="form-control" value="<%= classMappings.length + 1 %>" min="1">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%- lan.Cancel || 'Cancel' %></button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i><%- lan.Add || 'Add' %></button>
        </div>
      </form>
    </div>
  </div>
</div>
</div>
        <%- include('../../partials/footer') %>
    </div>
</div>
