<%- include('../../partials/head') %>

<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/settings' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Impersonation Audits</h2>
                    <p class="text-xs text-gray-500 mt-1">Audit superAdmin session takeovers on school administrator portals</p>
                </div>
                <a href="/superadmin/settings" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to Settings
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Impersonation Logs Table Card -->
            <div class="table-card mb-6">
                <div class="table-header-row bg-slate-50/20 flex items-center justify-between p-4">
                    <h4 class="table-heading uppercase tracking-wider mb-0">Impersonation Logs</h4>
                    <span class="text-xs text-gray-400 font-bold">Last 100 entries</span>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Super Admin Operator</th>
                                <th>Target School Location</th>
                                <th>Target School Admin</th>
                                <th class="text-center">Action type</th>
                                <th>IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (logs && logs.length > 0) { %>
                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td class="font-medium text-gray-500 text-xs">
                                            <%= log.started_at ? new Date(log.started_at).toLocaleString('en-IN') : 'N/A' %>
                                        </td>
                                        <td class="font-bold text-gray-800"><%= log.super_first_name %> <%= log.super_last_name %></td>
                                        <td class="font-semibold text-gray-700"><%= log.school_name %></td>
                                        <td class="font-semibold text-gray-700">
                                            <%= log.target_first_name %> <%= log.target_last_name %>
                                            <span class="inline-flex items-center px-1.5 py-0.25 rounded text-[9px] font-bold uppercase bg-blue-50 text-blue-700 border ml-1">Admin</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-amber-50 text-amber-700 border border-amber-100">
                                                <%= log.action.toUpperCase() %>
                                            </span>
                                        </td>
                                        <td><code class="text-xs"><%= log.ip_address || '—' %></code></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-12 text-gray-400">
                                        <div class="flex flex-col items-center justify-center gap-2">
                                            <i class="fa-solid fa-user-secret fa-2x text-gray-200"></i>
                                            <span>No impersonation logs recorded on the platform.</span>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>