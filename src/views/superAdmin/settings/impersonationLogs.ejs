<%- include('../../partials/head', { title: `${lan.Impersonation_Audits || 'Impersonation Audits' } | SchoolSync` }) %>
    <div class="app-wrapper superadmin-theme">
        <%- include('../../partials/sidebar', { currentPath: '/superadmin/settings' }) %>
            <div class="main-panel">
                <%- include('../../partials/header') %>
                    <div class="content">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                            <div>
                                <h2 class="text-2xl font-bold text-gray-800 dark:text-slate-100 tracking-tight"><%-
                                        lan.Impersonation_Audits || 'Impersonation Audits' %></h2>
                                <p class="text-xs text-gray-500 dark:text-slate-400 mt-1"><%-
                                        lan.Impersonation_Audits_Sub
                                        || 'Audit superAdmin session takeovers on school administrator portals' %></p>
                            </div>
                            <a href="/superadmin/settings" class="btn btn-secondary">
                                <i class="fa-solid fa-arrow-left mr-1"></i> <%- lan.Back_To_Settings
                                    || 'Back to Settings' %>
                            </a>
                        </div>
                        <%- include('../../partials/flashMessages') %>
                            <div class="table-card mb-3">
                                <div class="table-header-row bg-slate-50/20 flex items-center justify-between p-4">
                                    <h4 class="table-heading uppercase tracking-wider mb-0"><%- lan.Impersonation_Logs
                                            || 'Impersonation Logs' %></h4>
                                    <span class="text-xs text-gray-400 font-bold"><%- lan.Last_100_Entries
                                            || 'Last 100 entries' %></span>
                                </div>
                                <div class="table-container">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th><%- lan.Timestamp || 'Timestamp' %></th>
                                                <th><%- lan.Super_Admin_Operator || 'Super Admin Operator' %></th>
                                                <th><%- lan.Target_School_Location || 'Target School Location' %></th>
                                                <th><%- lan.Target_School_Admin || 'Target School Admin' %></th>
                                                <th class="text-center"><%- lan.Action_Type || 'Action type' %></th>
                                                <th><%- lan.IP_Address || 'IP Address' %></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (logs && logs.length> 0) { %>
                                                <% logs.forEach(log=> { %>
                                                    <tr>
                                                        <td class="font-medium text-gray-500 text-xs">
                                                            <%= log.started_at ? new
                                                                Date(log.started_at).toLocaleString('en-IN') : 'N/A' %>
                                                        </td>
                                                        <td class="font-bold text-gray-800 dark:text-slate-100">
                                                            <%= log.super_first_name %>
                                                                <%= log.super_last_name %>
                                                        </td>
                                                        <td class="font-semibold text-gray-700 dark:text-slate-300">
                                                            <%= log.school_name %>
                                                        </td>
                                                        <td class="font-semibold text-gray-700 dark:text-slate-300">
                                                            <%= log.target_first_name %>
                                                                <%= log.target_last_name %>
                                                                    <span
                                                                        class="inline-flex items-center px-1.5 py-0.25 rounded text-[9px] font-bold uppercase bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 border ml-1"><%-
                                                                            lan.Admin || 'Admin' %></span>
                                                        </td>
                                                        <td class="text-center">
                                                            <span
                                                                class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 border border-amber-100 dark:border-amber-900/50">
                                                                <%= (log.action || '' ).toUpperCase() %>
                                                            </span>
                                                        </td>
                                                        <td><code class="text-xs"><%= log.ip_address || '—' %></code>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="6" class="text-center py-12 text-gray-400">
                                                                    <div
                                                                        class="flex flex-col items-center justify-center gap-2">
                                                                        <i
                                                                            class="fa-solid fa-user-secret fa-2x text-gray-200 dark:text-slate-700"></i>
                                                                        <span><%- lan.No_Impersonation_Logs
                                                                                || 'No impersonation logs recorded on the platform.'
                                                                                %></span>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                    </div>
                    <%- include('../../partials/footer') %>
            </div>
    </div>