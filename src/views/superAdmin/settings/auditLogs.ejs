<%- include('../../partials/head') %>

<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/settings' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Security Audit Logs</h2>
                    <p class="text-xs text-gray-500 mt-1">Audit all admin and platform modifications with full timestamp accountability</p>
                </div>
                <a href="/superadmin/settings" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to Settings
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Filter Card -->
            <div class="card p-5 mb-6">
                <form method="GET" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-end">
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px] mb-2">School</label>
                        <select name="school_id" class="form-select">
                            <option value="">All Schools</option>
                            <% schools.forEach(s => { %>
                                <option value="<%= s.id %>" <%= filters.school_id == s.id ? 'selected' : '' %>><%= s.school_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px] mb-2">Action</label>
                        <select name="action" class="form-select">
                            <option value="">All Actions</option>
                            <% actions.forEach(act => { %>
                                <option value="<%= act %>" <%= filters.action === act ? 'selected' : '' %>><%= act %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px] mb-2">Entity Type</label>
                        <select name="entity_type" class="form-select">
                            <option value="">All Entity Types</option>
                            <% entityTypes.forEach(ent => { %>
                                <option value="<%= ent %>" <%= filters.entity_type === ent ? 'selected' : '' %>><%= ent %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px] mb-2">From Date</label>
                        <input type="date" name="from" class="form-input" value="<%= filters.from || '' %>">
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[10px] mb-2">To Date</label>
                        <input type="date" name="to" class="form-input" value="<%= filters.to || '' %>">
                    </div>
                    <div class="md:col-span-2 flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-1">Filter Logs</button>
                        <a href="/superadmin/settings/audit-logs" class="btn btn-secondary btn-sm flex-1 text-center">Reset</a>
                    </div>
                </form>
            </div>

            <!-- Activity Audit Logs Table Card -->
            <div class="table-card">
                <div class="table-header-row bg-slate-50/20 flex items-center justify-between p-4">
                    <h4 class="table-heading uppercase tracking-wider mb-0">Security Audit Trail</h4>
                    <span class="text-xs text-gray-400 font-bold">Total Logs: <%= pagination.total %></span>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>School Location</th>
                                <th>Actor</th>
                                <th>Action type</th>
                                <th>Target Entity</th>
                                <th>Description</th>
                                <th>IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (logs && logs.length > 0) { %>
                                <% logs.forEach(log => { %>
                                    <tr>
                                        <td class="font-medium text-gray-500 text-xs">
                                            <%= new Date(log.created_at).toLocaleString('en-IN') %>
                                        </td>
                                        <td class="font-bold text-gray-800"><%= log.school_name || 'System Platform' %></td>
                                        <td class="font-semibold text-gray-700">
                                            <%= log.actor_first_name ? `${log.actor_first_name} ${log.actor_last_name}` : 'System Agent' %>
                                            <span class="inline-flex items-center px-1.5 py-0.25 rounded text-[9px] font-bold uppercase bg-slate-100 text-slate-700 border ml-1">
                                                <%= log.actor_role || 'System' %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-blue-50 text-blue-700 border border-blue-100">
                                                <%= log.action %>
                                            </span>
                                        </td>
                                        <td class="font-medium text-gray-600 text-xs"><%= log.entity_type %> #<%= log.entity_id %></td>
                                        <td class="text-gray-600 text-xs font-medium"><%= log.description %></td>
                                        <td><code class="text-xs"><%= log.ip_address || '—' %></code></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-12 text-gray-400">
                                        <div class="flex flex-col items-center justify-center gap-2">
                                            <i class="fa-solid fa-clipboard-list fa-2x text-gray-200"></i>
                                            <span>No audit logs found matching your filters.</span>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <% if(pagination.totalPages > 1) { %>
                    <div class="pagination-wrapper">
                        <nav aria-label="Page navigation">
                            <div class="pagination">
                                <% if (pagination.hasPrev) { %>
                                    <a class="pagination-btn" href="?page=<%= pagination.page - 1 %>&school_id=<%= filters.school_id %>&action=<%= filters.action %>&entity_type=<%= filters.entity_type %>&from=<%= filters.from %>&to=<%= filters.to %>">
                                        <i class="fa-solid fa-angle-left"></i>
                                    </a>
                                <% } else { %>
                                    <span class="pagination-btn disabled"><i class="fa-solid fa-angle-left"></i></span>
                                <% } %>

                                <% for(let i=1; i <= pagination.totalPages; i++) { %>
                                    <% if (pagination.page === i) { %>
                                        <span class="pagination-btn active"><%= i %></span>
                                    <% } else { %>
                                        <a class="pagination-btn" href="?page=<%= i %>&school_id=<%= filters.school_id %>&action=<%= filters.action %>&entity_type=<%= filters.entity_type %>&from=<%= filters.from %>&to=<%= filters.to %>">
                                            <%= i %>
                                        </a>
                                    <% } %>
                                <% } %>

                                <% if (pagination.hasNext) { %>
                                    <a class="pagination-btn" href="?page=<%= pagination.page + 1 %>&school_id=<%= filters.school_id %>&action=<%= filters.action %>&entity_type=<%= filters.entity_type %>&from=<%= filters.from %>&to=<%= filters.to %>">
                                        <i class="fa-solid fa-angle-right"></i>
                                    </a>
                                <% } else { %>
                                    <span class="pagination-btn disabled"><i class="fa-solid fa-angle-right"></i></span>
                                <% } %>
                            </div>
                        </nav>
                    </div>
                <% } %>
            </div>
        </div>
        <%- include('../../partials/footer') %>
    </div>
</div>