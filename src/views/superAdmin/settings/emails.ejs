<%- include('../../partials/head', { title: `${lan.Email_Queue_Monitor || 'Email Queue Monitor'} | SchoolSync` }) %>
<style>
  :root {
    --text-primary: #0F172A;
    --text-muted: #64748B;
    --accent-indigo: #6366F1;
    --accent-emerald: #10B981;
    --accent-rose: #F43F5E;
    --accent-amber: #F59E0B;
    --bg-card: rgba(255, 255, 255, 0.85);
    --border-color: rgba(226, 232, 240, 0.8);
  }

  .emails-theme {
    background-color: #F8FAFC;
    font-family: 'Outfit', sans-serif;
  }

  .email-card {
    padding: 24px;
    border-radius: 16px;
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .email-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.04);
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .status-sent {
    background-color: #DCFCE7;
    color: #15803D;
  }

  .status-pending {
    background-color: #FEF9C3;
    color: #A16207;
  }

  .status-failed {
    background-color: #FEE2E2;
    color: #B91C1C;
  }

  .error-log-box {
    font-family: 'Fira Code', monospace, Courier;
    background: #0F172A;
    color: #F43F5E;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 11px;
    max-height: 90px;
    overflow-y: auto;
    border: 1px solid #1E293B;
  }

  .html-preview-box {
    font-family: monospace;
    background: #F8FAFC;
    color: #475569;
    padding: 10px;
    border-radius: 6px;
    font-size: 11px;
    max-height: 80px;
    overflow-y: auto;
    border: 1px solid #E2E8F0;
    white-space: pre-wrap;
  }
</style>
<div class="app-wrapper superadmin-theme emails-theme">
  <%- include('../../partials/sidebar', { currentPath: '/superadmin/settings' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <div class="content p-4">
      <div class="d-flex flex-col sm:flex-row align-items-sm-center justify-content-between gap-3 mb-4">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <a href="/superadmin/settings" class="text-decoration-none text-muted font-bold" style="font-size: 12px;">
              <i class="fas fa-arrow-left"></i> <%- lan.System_Settings || 'System Settings' %>
            </a>
          </div>
          <h2 class="text-2xl font-bold text-gray-800 dark:text-slate-100 tracking-tight" style="font-family:'Outfit', sans-serif;"><%- lan.Email_Queue_Monitor || 'Email Queue Monitor' %></h2>
          <p class="text-xs text-gray-500 dark:text-slate-400 mt-1"><%- lan.Email_Queue_Monitor_Sub || 'Track background delivery tasks, resend failed notifications, and maintain delivery health' %></p>
        </div>
        <div class="d-flex gap-2">
          <form action="/superadmin/settings/emails/retry" method="POST" id="retryFailedForm">
            <button type="submit" class="btn btn-primary btn-sm py-2 px-3 font-semibold shadow-sm transition">
              <i class="fa-solid fa-rotate-right me-1"></i> <%- lan.Retry_Failed || 'Retry Failed' %>
            </button>
          </form>
          <form action="/superadmin/settings/emails/clear" method="POST" id="purgeEmailsForm">
            <button type="submit" class="btn btn-outline-danger btn-sm py-2 px-3 font-semibold shadow-sm transition" style="background:#fff;">
              <i class="fa-solid fa-circle-minus me-1"></i> <%- lan.Purge_Logs || 'Purge Logs' %>
            </button>
          </form>
        </div>
      </div>
      <%- include('../../partials/flashMessages') %>
      <div class="row g-4 mb-4">
        <div class="col-md-4">
          <div class="email-card h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <span class="text-xs text-gray-400 font-bold uppercase tracking-wider"><%- lan.Pending_Tasks || 'Pending Tasks' %></span>
                <h3 class="text-3xl font-extrabold mt-1" style="color: var(--accent-amber);"><%= stats.pending_count %></h3>
              </div>
              <div style="width:40px;height:40px;border-radius:10px;background:rgba(245,158,11,0.1);color:var(--accent-amber);display:flex;align-items:center;justify-content:center;font-size:16px;">
                <i class="fas fa-clock"></i>
              </div>
            </div>
            <div style="font-size: 11px; color: var(--text-muted);">
              <%- lan.Emails_Awaiting_Cron || 'Emails awaiting cron job pickup' %>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="email-card h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <span class="text-xs text-gray-400 font-bold uppercase tracking-wider"><%- lan.Sent_Success || 'Sent (Success)' %></span>
                <h3 class="text-3xl font-extrabold mt-1" style="color: var(--accent-emerald);"><%= stats.sent_count %></h3>
              </div>
              <div style="width:40px;height:40px;border-radius:10px;background:rgba(16,185,129,0.1);color:var(--accent-emerald);display:flex;align-items:center;justify-content:center;font-size:16px;">
                <i class="fas fa-circle-check"></i>
              </div>
            </div>
            <div style="font-size: 11px; color: var(--text-muted);">
              <%- lan.Dispatched_SMTP_Msg || 'Successfully dispatched SMTP messages' %>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="email-card h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <span class="text-xs text-gray-400 font-bold uppercase tracking-wider"><%- lan.Failed_Delivery || 'Failed Delivery' %></span>
                <h3 class="text-3xl font-extrabold mt-1" style="color: var(--accent-rose);"><%= stats.failed_count %></h3>
              </div>
              <div style="width:40px;height:40px;border-radius:10px;background:rgba(244,63,94,0.1);color:var(--accent-rose);display:flex;align-items:center;justify-content:center;font-size:16px;">
                <i class="fas fa-circle-xmark"></i>
              </div>
            </div>
            <div style="font-size: 11px; color: var(--text-muted);">
              <%- lan.Delivery_Failures_Resolution || 'Delivery failures requiring resolution' %>
            </div>
          </div>
        </div>
      </div>
      <div class="email-card p-0" style="overflow: hidden;">
        <div class="p-4 border-bottom d-flex align-items-center justify-content-between" style="background: rgba(248,250,252,0.5);">
          <div>
            <h4 class="font-bold text-gray-800 mb-0" style="font-size: 14px;"><%- lan.Recent_Queue_Activity_Logs || 'Recent Queue Activity Logs' %></h4>
            <p class="text-xs text-gray-400 mb-0"><%- lan.Recent_Queue_Activity_Sub || 'Showing history and real-time status of outgoing communications' %></p>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table align-middle m-0" style="font-size: 12px;">
            <thead class="table-light">
              <tr>
                <th style="padding: 12px 16px; font-weight: 700; color: #475569; font-size: 10px; text-transform: uppercase;">ID</th>
                <th style="padding: 12px 16px; font-weight: 700; color: #475569; font-size: 10px; text-transform: uppercase;"><%- lan.Recipient || 'Recipient' %></th>
                <th style="padding: 12px 16px; font-weight: 700; color: #475569; font-size: 10px; text-transform: uppercase;"><%- lan.Subject_Body_Preview || 'Subject & Body Preview' %></th>
                <th style="padding: 12px 16px; font-weight: 700; color: #475569; font-size: 10px; text-transform: uppercase; text-align: center;"><%- lan.Attempts || 'Attempts' %></th>
                <th style="padding: 12px 16px; font-weight: 700; color: #475569; font-size: 10px; text-transform: uppercase;"><%- lan.Status || 'Status' %></th>
                <th style="padding: 12px 16px; font-weight: 700; color: #475569; font-size: 10px; text-transform: uppercase;"><%- lan.Log_Timestamp || 'Log Timestamp' %></th>
                <th style="padding: 12px 16px; font-weight: 700; color: #475569; font-size: 10px; text-transform: uppercase;"><%- lan.Error_Details || 'Error Details' %></th>
              </tr>
            </thead>
            <tbody>
              <% if (!emails || emails.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center py-5 text-gray-400 italic"><%- lan.No_Email_Tasks_Found || 'No email tasks found in the queue.' %></td>
                </tr>
              <% } else { %>
                <% emails.forEach(email => { %>
                  <% 
                    let statusClass = 'status-pending';
                    let statusText = email.status;
                    if (email.status === 'sent') {
                      statusClass = 'status-sent';
                      statusText = lan.Sent || 'Sent';
                    } else if (email.status === 'failed') {
                      statusClass = 'status-failed';
                      statusText = lan.Failed || 'Failed';
                    } else if (email.status === 'pending') {
                      statusText = lan.Pending || 'Pending';
                    }
                  %>
                  <tr>
                    <td style="padding: 12px 16px; font-weight: 700; color:#64748B;"><%= email.id %></td>
                    <td style="padding: 12px 16px; font-weight: 600; color:#1E293B;"><%= email.recipient_email %></td>
                    <td style="padding: 12px 16px; max-width: 300px;">
                      <div class="font-bold text-gray-800 mb-1" style="font-size:12px;"><%= email.subject %></div>
                      <div class="html-preview-box"><%= email.body_html %></div>
                    </td>
                    <td style="padding: 12px 16px; text-align: center; font-weight: 700; color:#475569;"><%= email.attempts %></td>
                    <td style="padding: 12px 16px;">
                      <span class="status-indicator <%= statusClass %>">
                        <%= statusText %>
                      </span>
                    </td>
                    <td style="padding: 12px 16px; color:#64748B; font-size: 11px;">
                      <div><%- lan.Created_Prefix || 'Created:' %> <%= new Date(email.created_at).toLocaleString('en-IN') %></div>
                      <% if (email.processed_at) { %>
                        <div class="mt-0.5 text-gray-400"><%- lan.Processed_Prefix || 'Processed:' %> <%= new Date(email.processed_at).toLocaleString('en-IN') %></div>
                      <% } %>
                    </td>
                    <td style="padding: 12px 16px; max-width: 250px;">
                      <% if (email.last_error) { %>
                        <div class="error-log-box">
                          <%= email.last_error %>
                        </div>
                      <% } else { %>
                        <span class="text-muted italic" style="font-size:11px;"><%- lan.No_Errors_Reported || 'No errors reported' %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
        <% if (pagination && pagination.totalPages > 1) { %>
          <div class="p-4 border-top d-flex justify-content-between align-items-center" style="background: rgba(248,250,252,0.5);">
            <div class="text-xs text-muted">
              <%- (lan.Showing_Queue_Page || 'Showing page :page of :total (Total :count queue items)').replace(':page', pagination.page).replace(':total', pagination.totalPages).replace(':count', pagination.total) %>
            </div>
            <nav aria-label="Page navigation">
              <ul class="pagination pagination-sm m-0">
                <li class="page-item <%= !pagination.hasPrev ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= pagination.page - 1 %>"><%- lan.Previous || 'Previous' %></a>
                </li>
                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                  <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                  </li>
                <% } %>
                <li class="page-item <%= !pagination.hasNext ? 'disabled' : '' %>">
                  <a class="page-link" href="?page=<%= pagination.page + 1 %>"><%- lan.Next || 'Next' %></a>
                </li>
              </ul>
            </nav>
          </div>
        <% } %>
      </div>
</div>
        <%- include('../../partials/footer') %>
    </div>
</div>


<script id="emailsLangData" type="application/json">
  <%- JSON.stringify({
    retryConfirm: lan.Retry_Failed_Confirm || 'Are you sure you want to retry all failed emails in the queue?',
    purgeConfirm: lan.Purge_Logs_Confirm || 'Are you sure you want to clear all processed (sent/failed) logs from the email queue?'
  }) %>
</script>

<script>
  const emailsLang = JSON.parse(document.getElementById('emailsLangData')?.textContent || '{}');

  const retryForm = document.getElementById('retryFailedForm');
  if (retryForm) {
    retryForm.addEventListener('submit', function (e) {
      if (!confirm(emailsLang.retryConfirm || 'Are you sure you want to retry all failed emails in the queue?')) {
        e.preventDefault();
      }
    });
  }

  const purgeForm = document.getElementById('purgeEmailsForm');
  if (purgeForm) {
    purgeForm.addEventListener('submit', function (e) {
      if (!confirm(emailsLang.purgeConfirm || 'Are you sure you want to clear all processed (sent/failed) logs from the email queue?')) {
        e.preventDefault();
      }
    });
  }
</script>