<%- include('../../partials/head') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/billing/reports' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Revenue Report — <%= year %></h2>
                    <p class="text-xs text-gray-500 mt-1">Audit platform revenue stats, plan distribution, and monthly breakdown</p>
                </div>
                <a href="/superadmin/reports/export?type=excel&report=revenue&year=<%= year %>" class="btn btn-primary text-xs font-bold shadow-sm transition">
                    <i class="fa-solid fa-file-excel mr-1"></i> Export Excel
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                <div class="card lg:col-span-2">
                    <div class="card-header bg-slate-50/20">
                        <h3 class="card-title"><i class="fa-solid fa-chart-bar text-blue-600 mr-1"></i> Monthly Breakdown Chart</h3>
                    </div>
                    <div class="card-body p-6">
                        <div class="chart-container" style="height: 300px;">
                            <canvas id="monthlyRevenueChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="table-card">
                    <div class="table-header-row bg-slate-50/20">
                        <h4 class="table-heading uppercase tracking-wider">Revenue by Plan</h4>
                    </div>
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Plan Tier</th>
                                    <th class="text-right">Revenue</th>
                                    <th class="text-center">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(!planRevenue || planRevenue.length === 0) { %>
                                    <tr>
                                        <td colspan="3" class="text-center py-6 text-gray-400 italic">No plan data available.</td>
                                    </tr>
                                <% } else { %>
                                    <% planRevenue.forEach(pr => { %>
                                        <tr>
                                            <td class="font-bold text-gray-800 capitalize"><%= pr.name %></td>
                                            <td class="text-right font-bold text-emerald-600">₹<%= pr.amount.toLocaleString('en-IN') %></td>
                                            <td class="text-center font-semibold text-gray-600"><%= pr.transactions %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="table-card mb-6">
                <div class="table-header-row bg-slate-50/20">
                    <h4 class="table-heading uppercase tracking-wider">Monthly Breakdown Ledger</h4>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Month</th>
                                <th class="text-right">Total Revenue</th>
                                <th class="text-center">Transactions Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(!monthlyRevenue || monthlyRevenue.length === 0) { %>
                                <tr>
                                    <td colspan="3" class="text-center py-6 text-gray-400 italic">No breakdown logs found.</td>
                                </tr>
                            <% } else { %>
                                <% monthlyRevenue.forEach(mr => { %>
                                    <tr>
                                        <td class="font-bold text-gray-800">
                                            <%= new Date(year, mr.month - 1).toLocaleString('en-IN', { month: 'long' }) %>
                                        </td>
                                        <td class="text-right font-bold text-emerald-600">₹<%= mr.amount.toLocaleString('en-IN') %></td>
                                        <td class="text-center font-semibold text-gray-600"><%= mr.transactions %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>

<script>
    new Chart(document.getElementById('monthlyRevenueChart'), {
        type: 'bar',
        data: {
            labels: '<%- JSON.stringify(monthlyRevenue.map(m => new Date(year, m.month - 1).toLocaleString("en-IN", { month: "short" }))) %>',
            datasets: [{
                label: 'Revenue (₹)',
                data: '<%- JSON.stringify(monthlyRevenue.map(m => m.amount)) %>',
                backgroundColor: '#2563EB',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { callback: v => '₹' + v.toLocaleString('en-IN'), font: { size: 11 } },
                    grid: { color: '#F1F5F9' }
                },
                x: { ticks: { font: { size: 11 } }, grid: { display: false } }
            }
        }
    });
</script>