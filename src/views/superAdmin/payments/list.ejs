<%- include('../../partials/head') %>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/payments' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        
        <div class="content">
            <!-- Header section -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Payments History</h2>
                    <p class="text-xs text-gray-500 mt-1">Monitor school subscription invoices, transaction logs, and process refunds</p>
                </div>
            </div>

            <%- include('../../partials/flashMessages') %>

            <!-- Summary metrics -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div class="card p-6 flex items-center justify-between border border-slate-100 shadow-sm">
                    <div>
                        <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1">Total Transactions</div>
                        <div class="text-3xl font-extrabold text-gray-800"><%= summary.total %></div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                </div>

                <div class="card p-6 flex items-center justify-between border border-slate-100 shadow-sm">
                    <div>
                        <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1">Total Collections</div>
                        <div class="text-3xl font-extrabold text-emerald-600">₹<%= parseFloat(summary.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-money-bill-trend-up"></i>
                    </div>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="card shadow-sm border border-slate-100 mb-6">
                <div class="card-header bg-slate-50/50">
                    <h3 class="card-title flex items-center gap-2 text-sm font-bold text-gray-700">
                        <i class="fa-solid fa-filter text-blue-600"></i> Filter Payments
                    </h3>
                </div>
                <div class="card-body">
                    <form action="/superadmin/payments" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                        <div class="form-group">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[9px]">School Tenant</label>
                            <select name="school_id" class="form-select text-xs">
                                <option value="">All Schools</option>
                                <% schools.forEach(school => { %>
                                    <option value="<%= school.id %>" <%= filters.school_id == school.id ? 'selected' : '' %>><%= school.school_name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[9px]">Status</label>
                            <select name="status" class="form-select text-xs">
                                <option value="">All Statuses</option>
                                <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
                                <option value="refunded" <%= filters.status === 'refunded' ? 'selected' : '' %>>Refunded</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[9px]">Method</label>
                            <select name="method" class="form-select text-xs">
                                <option value="">All Methods</option>
                                <option value="online" <%= filters.method === 'online' ? 'selected' : '' %>>Online</option>
                                <option value="bank_transfer" <%= filters.method === 'bank_transfer' ? 'selected' : '' %>>Bank Transfer</option>
                                <option value="cash" <%= filters.method === 'cash' ? 'selected' : '' %>>Cash</option>
                                <option value="cheque" <%= filters.method === 'cheque' ? 'selected' : '' %>>Cheque</option>
                                <option value="upi" <%= filters.method === 'upi' ? 'selected' : '' %>>UPI</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[9px]">From Date</label>
                            <input type="date" name="from" value="<%= filters.from || '' %>" class="form-input text-xs">
                        </div>

                        <div class="form-group">
                            <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[9px]">To Date</label>
                            <input type="date" name="to" value="<%= filters.to || '' %>" class="form-input text-xs">
                        </div>

                        <div class="lg:col-span-5 flex justify-end gap-2 mt-2">
                            <a href="/superadmin/payments" class="btn btn-secondary btn-sm flex items-center gap-1">
                                <i class="fa-solid fa-arrow-rotate-right"></i> Reset
                            </a>
                            <button type="submit" class="btn btn-primary btn-sm flex items-center gap-1">
                                <i class="fa-solid fa-magnifying-glass"></i> Apply Filters
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Payments List Table -->
            <div class="table-card border border-slate-100 shadow-sm">
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Receipt No</th>
                                <th>School Tenant</th>
                                <th>Plan Details</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th>Total Amount</th>
                                <th>Date</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (payments && payments.length > 0) { %>
                                <% payments.forEach(p => { 
                                    const methodColors = {
                                        online: 'bg-indigo-50 text-indigo-700 border-indigo-100',
                                        bank_transfer: 'bg-blue-50 text-blue-700 border-blue-100',
                                        cash: 'bg-amber-50 text-amber-700 border-amber-100',
                                        cheque: 'bg-slate-50 text-slate-700 border-slate-100',
                                        upi: 'bg-cyan-50 text-cyan-700 border-cyan-100'
                                    };
                                    const statusColors = {
                                        completed: 'bg-emerald-50 text-emerald-700 border-emerald-100',
                                        pending: 'bg-yellow-50 text-yellow-700 border-yellow-100',
                                        failed: 'bg-rose-50 text-rose-700 border-rose-100',
                                        refunded: 'bg-purple-50 text-purple-700 border-purple-100'
                                    };
                                %>
                                    <tr>
                                        <td>
                                            <div class="font-bold text-gray-800 text-xs">
                                                <a href="/superadmin/payments/<%= p.id %>" class="hover:text-blue-600">
                                                    <%= p.receipt_no %>
                                                </a>
                                            </div>
                                            <div class="text-[10px] text-gray-400 mt-0.5 font-mono"><%= p.transaction_id || '—' %></div>
                                        </td>
                                        <td>
                                            <div class="font-bold text-gray-800 text-xs"><%= p.school_name %></div>
                                            <div class="text-[10px] text-emerald-600 mt-0.5 font-semibold"><%= p.subdomain %>.schoolsync.com</div>
                                        </td>
                                        <td>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-700 border">
                                                <%= p.plan_name %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border <%= methodColors[p.payment_method] || 'bg-slate-50 text-slate-700 border-slate-100' %>">
                                                <%= p.payment_method.replace('_', ' ') %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border <%= statusColors[p.status] || 'bg-slate-50 text-slate-700 border-slate-100' %>">
                                                <%= p.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="font-bold text-gray-800 text-xs">₹<%= parseFloat(p.total_amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
                                        </td>
                                        <td>
                                            <span class="text-xs text-gray-500 font-medium"><%= p.paid_at ? new Date(p.paid_at).toLocaleDateString('en-IN', {day: 'numeric', month: 'short', year: 'numeric'}) : '—' %></span>
                                        </td>
                                        <td class="text-right">
                                            <a href="/superadmin/payments/<%= p.id %>" class="btn btn-secondary btn-sm inline-flex items-center gap-1 hover:border-blue-500 hover:text-blue-600 transition">
                                                <i class="fa-solid fa-eye"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center py-6 text-gray-400 italic">No transactions found matching current filters.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Panel -->
                <% if (pagination.totalPages > 1) { %>
                    <div class="pagination-wrapper border-t border-slate-100 bg-white">
                        <div class="flex items-center justify-between w-full">
                            <div class="text-xs text-slate-500">
                                Showing page <span class="font-bold"><%= pagination.page %></span> of <span class="font-bold"><%= pagination.totalPages %></span>
                            </div>
                            <div class="pagination">
                                <% if (pagination.page > 1) { %>
                                    <a href="/superadmin/payments?page=<%= pagination.page - 1 %>&school_id=<%= filters.school_id %>&status=<%= filters.status %>&method=<%= filters.method %>&from=<%= filters.from %>&to=<%= filters.to %>" class="pagination-btn">Prev</a>
                                <% } %>

                                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                    <a href="/superadmin/payments?page=<%= i %>&school_id=<%= filters.school_id %>&status=<%= filters.status %>&method=<%= filters.method %>&from=<%= filters.from %>&to=<%= filters.to %>" class="pagination-btn <%= pagination.page === i ? 'active' : '' %>"><%= i %></a>
                                <% } %>

                                <% if (pagination.page < pagination.totalPages) { %>
                                    <a href="/superadmin/payments?page=<%= pagination.page + 1 %>&school_id=<%= filters.school_id %>&status=<%= filters.status %>&method=<%= filters.method %>&from=<%= filters.from %>&to=<%= filters.to %>" class="pagination-btn">Next</a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <%- include('../../partials/footer') %>
    </div>
</div>
