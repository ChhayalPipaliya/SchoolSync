<%- include('../../partials/head') %>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/payments' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        
        <div class="content">
            <!-- Header section -->
            <div class="flex items-center gap-4 mb-6">
                <a href="/superadmin/payments" class="btn btn-secondary btn-icon">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Invoice Details</h2>
                    <p class="text-xs text-gray-500 mt-1">Transaction audit trail and ledger configuration for Receipt <%= payment.receipt_no %></p>
                </div>
            </div>

            <%- include('../../partials/flashMessages') %>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Main Invoice Ledger Card -->
                <div class="lg:col-span-2">
                    <div class="card shadow-sm border border-slate-100">
                        <div class="card-header bg-slate-50/50 flex justify-between items-center py-4 px-6">
                            <h3 class="card-title text-sm font-bold text-gray-700 flex items-center gap-2">
                                <i class="fa-solid fa-file-invoice-dollar text-emerald-600"></i> Statement Ledger
                            </h3>
                            <% 
                            const statusColors = {
                                completed: 'bg-emerald-50 text-emerald-700 border-emerald-100',
                                pending: 'bg-yellow-50 text-yellow-700 border-yellow-100',
                                failed: 'bg-rose-50 text-rose-700 border-rose-100',
                                refunded: 'bg-purple-50 text-purple-700 border-purple-100'
                            };
                            %>
                            <span class="inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold uppercase border <%= statusColors[payment.status] || 'bg-slate-50 text-slate-700 border-slate-100' %>">
                                <%= payment.status %>
                            </span>
                        </div>
                        <div class="card-body p-6 space-y-6">
                            
                            <!-- Invoice details -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1">Receipt Number</div>
                                    <div class="text-sm font-bold text-gray-800"><%= payment.receipt_no %></div>
                                </div>
                                <div>
                                    <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1">Transaction ID</div>
                                    <div class="text-sm font-mono text-gray-700"><%= payment.transaction_id || '—' %></div>
                                </div>
                                <div>
                                    <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1">School Tenant</div>
                                    <div class="text-sm font-bold text-gray-800"><%= payment.school_name %></div>
                                </div>
                                <div>
                                    <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1">SaaS Subscription Tier</div>
                                    <div class="text-sm font-bold text-blue-600 uppercase"><%= payment.plan_name %></div>
                                </div>
                            </div>

                            <hr class="border-slate-100">

                            <!-- Financial Breakdown -->
                            <div>
                                <h4 class="text-xs font-bold text-emerald-600 uppercase tracking-wider mb-3">Billing Breakdown</h4>
                                <div class="space-y-2 text-xs">
                                    <div class="flex justify-between text-slate-500">
                                        <span>Base Price</span>
                                        <span>₹<%= parseFloat(payment.amount).toFixed(2) %></span>
                                    </div>
                                    <div class="flex justify-between text-slate-500">
                                        <span>Tax / GST</span>
                                        <span>+ ₹<%= parseFloat(payment.tax_amount || 0).toFixed(2) %></span>
                                    </div>
                                    <div class="flex justify-between text-slate-500">
                                        <span>Discounts Applied</span>
                                        <span>- ₹<%= parseFloat(payment.discount_amount || 0).toFixed(2) %></span>
                                    </div>
                                    <div class="flex justify-between font-bold text-slate-800 text-sm border-t border-slate-100 pt-2 mt-2">
                                        <span>Total Amount Collected</span>
                                        <span>₹<%= parseFloat(payment.total_amount).toFixed(2) %></span>
                                    </div>
                                </div>
                            </div>

                            <hr class="border-slate-100">

                            <!-- Audit trail / notes -->
                            <div>
                                <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider mb-1.5">Administrative Notes</div>
                                <div class="p-3 bg-slate-50 rounded-lg border border-slate-100 text-xs text-slate-600 leading-relaxed font-medium">
                                    <%= payment.notes || 'No notes or exceptions recorded for this transaction.' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transaction Details / Refund Panel -->
                <div class="space-y-6">
                    <div class="card shadow-sm border border-slate-100">
                        <div class="card-header bg-slate-50/50 py-4 px-6">
                            <h3 class="card-title text-sm font-bold text-gray-700">
                                <i class="fa-solid fa-list-check text-emerald-600"></i> Transaction Meta
                            </h3>
                        </div>
                        <div class="card-body p-6 space-y-4">
                            <div class="p-3 bg-slate-50 rounded-lg border border-gray-100">
                                <div class="text-[9px] text-gray-400 font-bold uppercase tracking-wider mb-1">Payment Method</div>
                                <div class="text-xs font-bold text-gray-800 capitalize"><%= payment.payment_method.replace('_', ' ') %></div>
                            </div>
                            <div class="p-3 bg-slate-50 rounded-lg border border-gray-100">
                                <div class="text-[9px] text-gray-400 font-bold uppercase tracking-wider mb-1">Paid At Timestamp</div>
                                <div class="text-xs font-bold text-gray-800">
                                    <%= payment.paid_at ? new Date(payment.paid_at).toLocaleString('en-IN') : '—' %>
                                </div>
                            </div>
                            <% if (payment.bank_name) { %>
                                <div class="p-3 bg-slate-50 rounded-lg border border-gray-100">
                                    <div class="text-[9px] text-gray-400 font-bold uppercase tracking-wider mb-1">Associated Bank</div>
                                    <div class="text-xs font-bold text-gray-800"><%= payment.bank_name %></div>
                                </div>
                            <% } %>
                            <% if (payment.cheque_no) { %>
                                <div class="p-3 bg-slate-50 rounded-lg border border-gray-100">
                                    <div class="text-[9px] text-gray-400 font-bold uppercase tracking-wider mb-1">Cheque Number</div>
                                    <div class="text-xs font-bold text-gray-800"><%= payment.cheque_no %></div>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Refund Panel -->
                    <% if (payment.status === 'completed') { %>
                        <div class="card border border-rose-100 shadow-sm overflow-hidden">
                            <div class="card-header bg-rose-50/30 border-rose-100 py-4 px-6">
                                <h3 class="card-title text-sm font-bold text-rose-700 flex items-center gap-1.5">
                                    <i class="fa-solid fa-undo"></i> Issue Refund
                                </h3>
                            </div>
                            <div class="card-body p-6">
                                <form action="/superadmin/payments/<%= payment.id %>/refund" method="POST" class="space-y-4">
                                    <div class="form-group">
                                        <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[9px]">Refund Amount (INR) <span class="text-rose-500">*</span></label>
                                        <input type="number" name="amount" min="1" max="<%= payment.total_amount %>" step="0.01" value="<%= payment.total_amount %>" required class="form-input text-xs">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label font-bold text-gray-500 uppercase tracking-wider text-[9px]">Reason for Refund <span class="text-rose-500">*</span></label>
                                        <textarea name="reason" rows="3" required placeholder="Provide detail reason for compliance auditing..." class="form-textarea text-xs"></textarea>
                                    </div>
                                    <div class="bg-rose-50 border border-rose-100 text-rose-800 text-[10px] p-3 rounded-lg leading-relaxed font-semibold">
                                        <i class="fa-solid fa-triangle-exclamation mr-1 text-rose-600"></i> WARNING: This action cannot be undone. Marking this invoice as refunded will cancel the corresponding billing ledger line.
                                    </div>
                                    <button type="submit" class="btn btn-danger w-full text-xs font-bold py-2 justify-center" onclick="return confirm('Are you sure you want to process this refund?');">
                                        Process Compliance Refund
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <%- include('../../partials/footer') %>
    </div>
</div>
