<%- include('../../partials/head') %>
<style>
    .users-pagination {
        padding: 14px 16px;
        border-top: 1px solid #E2E8F0;
        background: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        overflow-x: auto;
        white-space: nowrap;
    }

    .users-pagination-inner {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .page-btn {
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        border: 1px solid #E2E8F0;
        border-radius: 8px;
        background: #FFFFFF;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .page-btn:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
        color: #1E293B;
    }

    .page-btn.active {
        background: #2563EB;
        border-color: #2563EB;
        color: #FFFFFF;
        font-weight: 700;
        box-shadow: 0 6px 14px rgba(37, 99, 235, 0.22);
    }

    .page-btn.disabled {
        opacity: 0.45;
        cursor: not-allowed;
        pointer-events: none;
    }

    .page-dots {
        min-width: 28px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #94A3B8;
        font-size: 13px;
        font-weight: 700;
    }

    @media (max-width: 768px) {
        .users-pagination {
            justify-content: flex-start;
        }
    }

    @media (max-width: 640px) {
        .users-filter-form {
            display: grid !important;
            grid-template-columns: 1fr !important;
            align-items: stretch !important;
        }

        .users-filter-form .form-group {
            width: 100% !important;
        }

        .users-filter-actions {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            width: 100%;
        }

        .users-filter-actions .btn {
            justify-content: center;
            width: 100%;
        }
    }
</style>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/users' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding:0;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; padding:24px 24px 0; flex-wrap:wrap; gap:12px;">
                <div>
                    <h1 style="font-size:20px; font-weight:700; color:#0F172A; margin:0;">Users Management</h1>
                    <p style="font-size:12px; color:#94A3B8; margin:4px 0 0;">Audit, activate, and configure platform user roles and statuses</p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div style="padding:0 24px 16px;">
                <div class="card" style="padding:16px; margin-bottom:0;">
                    <form method="GET" class="users-filter-form" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
                        <div class="form-group" style="margin-bottom:0; width:160px;">
                            <label class="form-label" style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">Role</label>
                            <select name="role" class="form-select" style="min-height:38px;">
                                <option value="">All Roles</option>
                                <option value="super_admin" <%= filters.role === 'super_admin' ? 'selected' : '' %>>Super Admin</option>
                                <option value="school_admin" <%= filters.role === 'school_admin' ? 'selected' : '' %>>School Admin</option>
                                <option value="teacher" <%= filters.role === 'teacher' ? 'selected' : '' %>>Teacher</option>
                                <option value="student" <%= filters.role === 'student' ? 'selected' : '' %>>Student</option>
                                <option value="driver" <%= filters.role === 'driver' ? 'selected' : '' %>>Driver</option>
                                <option value="librarian" <%= filters.role === 'librarian' ? 'selected' : '' %>>Librarian</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0; width:160px;">
                            <label class="form-label" style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">Status</label>
                            <select name="status" class="form-select" style="min-height:38px;">
                                <option value="">All Status</option>
                                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0; width:180px;">
                            <label class="form-label" style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">School</label>
                            <select name="school_id" class="form-select" style="min-height:38px;">
                                <option value="">All Schools</option>
                                <% schools.forEach(s => { %>
                                    <option value="<%= s.id %>" <%= filters.school_id == s.id ? 'selected' : '' %>><%= s.school_name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0; width:180px;">
                            <label class="form-label" style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">Search</label>
                            <input type="text" name="search" class="form-input" placeholder="Name, Email..." value="<%= filters.search || '' %>" style="min-height:38px;">
                        </div>
                        <div class="users-filter-actions" style="display:flex; gap:8px;">
                            <button type="submit" class="btn btn-primary" style="height:38px; padding:0 16px; font-size:13px;">Filter</button>
                            <a href="/superadmin/users" class="btn btn-secondary" style="height:38px; padding:0 16px; font-size:13px; text-decoration:none; display:inline-flex; align-items:center;">Reset</a>
                        </div>
                    </form>
                </div>
            </div>
            <div style="padding:0 24px 24px;">
                <div class="card">
                    <div class="card-body" style="padding:0; overflow-x:auto;">
                        <table class="table" style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Name</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Email</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Role</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">School Location</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center;">Status</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Last Login</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center; width:120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(!users || users.length === 0) { %>
                                    <tr>
                                        <td colspan="7" style="padding:10px 12px; font-size:13px; border-bottom:1px solid #F1F5F9; text-align:center; color:#94A3B8;">
                                            <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:24px 0;">
                                                <i class="fa-solid fa-users fa-2x" style="color:#CBD5E1;"></i>
                                                <span>No users found matching your search.</span>
                                            </div>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% users.forEach(u => {
                                        const roleStyle = u.role === 'super_admin' ? 'background:#FEE2E2; color:#991B1B;' : u.role === 'school_admin' ? 'background:#DBEAFE; color:#2563EB;' : 'background:#F1F5F9; color:#475569;';
                                        const statusStyle = u.status === 'active' ? 'background:#D1FAE5; color:#065F46; border-color:#A7F3D0;' : 'background:#FEE2E2; color:#991B1B; border-color:#FCA5A5;';
                                        const btnStyle = u.status === 'active' ? '' : 'color:#10b981; border:none;';
                                    %>
                                        <tr style="border-bottom:1px solid #F1F5F9; transition:background 0.15s;" onmouseover="this.style.background='#F8FAFC'" onmouseout="this.style.background=''">
                                            <td style="padding:10px 12px; font-size:13px; font-weight:600; color:#1E293B; vertical-align:middle;"><%= u.first_name %> <%= u.last_name %></td>
                                            <td style="padding:10px 12px; font-size:13px; color:#475569; font-family:monospace; vertical-align:middle;"><%= u.email %></td>
                                            <td style="padding:10px 12px; font-size:13px; vertical-align:middle;">
                                                <span <%= `style="display:inline-flex; align-items:center; padding:2px 8px; border-radius:99px; font-size:10px; font-weight:700; text-transform:uppercase; ${roleStyle}"` %>>
                                                    <%= u.role.replace('_', ' ') %>
                                                </span>
                                            </td>
                                            <td style="padding:10px 12px; font-size:13px; color:#334155; vertical-align:middle;"><%= u.school_name || 'Global Platform' %></td>
                                            <td style="padding:10px 12px; font-size:13px; text-align:center; vertical-align:middle;">
                                                <span <%= `style="display:inline-flex; align-items:center; padding:2px 8px; border-radius:99px; font-size:10px; font-weight:700; text-transform:uppercase; border:1px solid; ${statusStyle}"` %>>
                                                    <%= u.status %>
                                                </span>
                                            </td>
                                            <td style="padding:10px 12px; font-size:13px; color:#475569; vertical-align:middle;">
                                                <%= u.last_login ? new Date(u.last_login).toLocaleDateString('en-IN') : 'Never Logged In' %>
                                            </td>
                                            <td style="padding:10px 12px; font-size:13px; text-align:center; vertical-align:middle;">
                                                <div style="display:flex; align-items:center; justify-content:center; gap:6px;">
                                                    <a href="/superadmin/users/<%= u.id %>" class="btn-icon" title="View Details">
                                                        <i class="fa-solid fa-eye"></i>
                                                    </a>
                                                    <form action="/superadmin/users/<%= u.id %>/status" method="POST" style="margin:0; display:inline-block;">
                                                        <input type="hidden" name="status" value="<%= u.status === 'active' ? 'inactive' : 'active' %>">
                                                        <button type="submit" class="btn-icon <%= u.status === 'active' ? 'btn-danger-icon' : '' %>" 
                                                                <%= btnStyle ? `style="${btnStyle}"` : '' %>
                                                                title="<%= u.status === 'active' ? 'Deactivate' : 'Activate' %>">
                                                            <i class="fa-solid <%= u.status === 'active' ? 'fa-user-slash' : 'fa-user-check' %>"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <% if (pagination && pagination.totalPages > 1) { %>
                        <div class="users-pagination">
                            <div class="users-pagination-inner">
                                <%
                                    const roleQuery = encodeURIComponent(filters.role || '');
                                    const statusQuery = encodeURIComponent(filters.status || '');
                                    const schoolQuery = encodeURIComponent(filters.school_id || '');
                                    const searchQuery = encodeURIComponent(filters.search || '');

                                    const currentPage = Number(pagination.page) || 1;
                                    const totalPages = Number(pagination.totalPages) || 1;

                                    const makeUrl = (page) => {
                                        return `?page=${page}&role=${roleQuery}&status=${statusQuery}&school_id=${schoolQuery}&search=${searchQuery}`;
                                    };

                                    let startPage = Math.max(1, currentPage - 4);
                                    let endPage = Math.min(totalPages, startPage + 5);

                                    if ((endPage - startPage) < 5) {
                                        startPage = Math.max(1, endPage - 5);
                                    }
                                %>
                                <% if (pagination.hasPrev) { %>
                                    <a class="page-btn" href="<%= makeUrl(currentPage - 1) %>" aria-label="Previous page">
                                        <i class="fa-solid fa-angle-left"></i>
                                    </a>
                                <% } else { %>
                                    <span class="page-btn disabled" aria-label="Previous page">
                                        <i class="fa-solid fa-angle-left"></i>
                                    </span>
                                <% } %>
                                <% if (startPage > 1) { %>
                                    <a class="page-btn" href="<%= makeUrl(1) %>">1</a>

                                    <% if (startPage > 2) { %>
                                        <span class="page-dots">...</span>
                                    <% } %>
                                <% } %>
                                <% for (let i = startPage; i <= endPage; i++) { %>
                                    <% if (i === currentPage) { %>
                                        <span class="page-btn active"><%= i %></span>
                                    <% } else { %>
                                        <a class="page-btn" href="<%= makeUrl(i) %>"><%= i %></a>
                                    <% } %>
                                <% } %>
                                <% if (endPage < totalPages) { %>
                                    <% if (endPage < totalPages - 1) { %>
                                        <span class="page-dots">...</span>
                                    <% } %>

                                    <a class="page-btn" href="<%= makeUrl(totalPages) %>"><%= totalPages %></a>
                                <% } %>
                                <% if (pagination.hasNext) { %>
                                    <a class="page-btn" href="<%= makeUrl(currentPage + 1) %>" aria-label="Next page">
                                        <i class="fa-solid fa-angle-right"></i>
                                    </a>
                                <% } else { %>
                                    <span class="page-btn disabled" aria-label="Next page">
                                        <i class="fa-solid fa-angle-right"></i>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>