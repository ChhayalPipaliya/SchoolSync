<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Super Admin Command Center | SchoolSync', needsCharts: true }) %>
  <style>
    /* Premium styling for Super Admin Dashboard */
    .sa-body {
      background-color: #F8FAFC;
      transition: background-color 0.3s, color 0.3s;
    }
    .light-mode-disabled .sa-body {
      background-color: #0F172A;
      color: #F8FAFC;
    }
    
    /* Custom chip styles */
    .chip {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 9999px;
      text-transform: capitalize;
    }
    .chip-plan-premium { background: rgba(59, 130, 246, 0.12); color: #2563EB; }
    .chip-plan-standard { background: rgba(16, 185, 129, 0.12); color: #059669; }
    .chip-plan-basic { background: rgba(245, 158, 11, 0.12); color: #D97706; }
    
    .chip-status-active { background: rgba(16, 185, 129, 0.12); color: #059669; }
    .chip-status-trial { background: rgba(245, 158, 11, 0.12); color: #D97706; }
    .chip-status-expired { background: rgba(239, 68, 68, 0.12); color: #DC2626; }
    .chip-status-inactive { background: rgba(100, 116, 139, 0.12); color: #64748B; }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 4px;
    }
    .light-mode-disabled ::-webkit-scrollbar-thumb {
      background: #475569;
    }

    @media (max-width: 900px) {
      .sa-dashboard-split {
        grid-template-columns: 1fr !important;
      }
    }

    @media (max-width: 520px) {
      .sa-page-body {
        padding: 16px !important;
      }
    }
  </style>
</head>
<body class="sa-body superadmin-theme">
<div class="app-wrapper superadmin-theme">
  <%- include('../partials/sidebar', { currentPath: '/superadmin/dashboard' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header', { searchPlaceholder: 'Search schools, plans…' }) %>
    <%- include('../partials/flashMessages') %>
    <div class="sa-page-body p-6">
      <!-- Page Header -->
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px;">
        <div>
          <h1 style="font-size:22px; font-weight:700; color:#0F172A; margin:0;">Founder Command Center</h1>
          <p style="font-size:12px; color:#94A3B8; margin:4px 0 0;" id="currentDate"><%= date %></p>
        </div>
        <div style="display:flex; gap:10px;">
          <a href="/superadmin/schools/add" class="btn btn-primary" style="font-size:13px; padding:8px 18px;">
            <i class="fas fa-plus"></i> Add School
          </a>
          <a href="/superadmin/announcements/add" class="btn btn-secondary" style="font-size:13px; padding:8px 18px;">
            <i class="fas fa-bullhorn"></i> Announce
          </a>
        </div>
      </div>

      <!-- Canonical KPI Cards -->
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:20px; margin-bottom:20px;">
        <%- include('../components/kpi-card', {
            id: 'kpi-active-schools',
            value: metrics.schools.active,
            label: 'Active Schools',
            breakdown: `<span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> ${metrics.schools.active} Active</span>
                        <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> ${metrics.schools.trial} Trial</span>
                        <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> ${metrics.schools.expired} Expired</span>`,
            trendColor: 'bg-green-50 text-green-700',
            trendIcon: '▲',
            trendValue: '+12%',
            iconBg: 'bg-blue-50',
            iconColor: 'text-blue-600',
            icon: 'school',
            sparklineData: true,
            sparklinePath: 'M0,15 Q25,5 50,25 T100,10',
            sparklineColor: '#3B82F6'
        }) %>

        <%- include('../components/kpi-card', {
            id: 'kpi-total-students',
            value: metrics.students.toLocaleString('en-IN'),
            label: 'Total Students',
            breakdown: `<span class="text-slate-400">Total metrics pooled across active schools</span>`,
            trendColor: 'bg-green-50 text-green-600',
            trendIcon: '▲',
            trendValue: '+4%',
            iconBg: 'bg-violet-50',
            iconColor: 'text-violet-600',
            icon: 'users',
            sparklineData: true,
            sparklinePath: 'M0,20 Q25,25 50,15 T100,5',
            sparklineColor: '#8B5CF6'
        }) %>

        <%- include('../components/kpi-card', {
            id: 'kpi-total-teachers',
            value: metrics.teachers.toLocaleString('en-IN'),
            label: 'Total Teachers',
            breakdown: `<span class="text-slate-400">Educators on platform registries</span>`,
            trendColor: 'bg-green-50 text-green-600',
            trendIcon: '▲',
            trendValue: '+7%',
            iconBg: 'bg-emerald-50',
            iconColor: 'text-emerald-600',
            icon: 'user-cog',
            sparklineData: true,
            sparklinePath: 'M0,10 Q25,20 50,8 T100,18',
            sparklineColor: '#10B981'
        }) %>

        <%- include('../components/kpi-card', {
            id: 'kpi-mrr',
            value: '₹' + (metrics.revenue.mrr).toLocaleString('en-IN'),
            label: 'MRR',
            breakdown: `<span class="text-slate-400">Current monthly recurring revenue</span>`,
            trendColor: 'bg-green-50 text-green-600',
            trendIcon: '▲',
            trendValue: '+' + metrics.revenue.growth + '%',
            iconBg: 'bg-indigo-50',
            iconColor: 'text-indigo-600',
            icon: 'trending-up',
            sparklineData: true,
            sparklinePath: 'M0,25 Q25,22 50,12 T100,2',
            sparklineColor: '#6366F1'
        }) %>
      </div>

      <div class="sa-dashboard-split" style="display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:20px; margin-bottom:20px; align-items:stretch;">
        <div class="card" style="margin-bottom:0;">
          <div class="card-header">
            <h3 class="card-title">Trial Conversion</h3>
          </div>
          <div class="card-body" style="padding:20px;">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
              <div>
                <p style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.08em; margin:0;">Converted Trials</p>
                <h3 style="font-size:28px; font-weight:800; color:#0F172A; margin:6px 0 0;"><%= trialConversion.percentage %>%</h3>
              </div>
              <div style="width:42px; height:42px; border-radius:10px; background:var(--primary-light); color:var(--primary); display:flex; align-items:center; justify-content:center;">
                <i class="fas fa-arrow-trend-up"></i>
              </div>
            </div>
            <div style="height:6px; background:#E2E8F0; border-radius:999px; overflow:hidden; margin:18px 0 10px;">
              <div style="height:100%; width:<%= trialConversion.percentage %>%; background:var(--primary); border-radius:999px;"></div>
            </div>
            <p style="font-size:12px; color:#94A3B8; margin:0;"><%= trialConversion.converted %> of <%= trialConversion.total %> trials converted</p>
          </div>
        </div>

        <div class="card" style="margin-bottom:0;">
          <div class="card-header">
            <h3 class="card-title">Security Events</h3>
          </div>
          <div class="card-body" style="padding:20px;">
            <div style="display:flex; flex-direction:column; gap:14px;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                <span style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; color:#334155;"><span class="bg-danger-soft" style="width:28px; height:28px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center;"><i class="fas fa-lock"></i></span> Failed logins</span>
                <strong class="text-danger"><%= securityEvents.failedLogins.count %></strong>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                <span style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; color:#334155;"><span class="bg-danger-soft" style="width:28px; height:28px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center;"><i class="fas fa-gauge-high"></i></span> Rate-limit triggers</span>
                <strong class="text-danger"><%= securityEvents.rateLimitTriggers.isLogged ? securityEvents.rateLimitTriggers.count : 'Not logged' %></strong>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                <span style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; color:#334155;"><span class="bg-danger-soft" style="width:28px; height:28px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center;"><i class="fas fa-signature"></i></span> Webhook signatures</span>
                <strong class="text-danger"><%= securityEvents.webhookSignatureFailures.isLogged ? securityEvents.webhookSignatureFailures.count : 'Not logged' %></strong>
              </div>
            </div>
          </div>
        </div>

        <div class="card" style="margin-bottom:0;">
          <div class="card-header">
            <h3 class="card-title">Recent Activity</h3>
          </div>
          <div class="card-body" style="padding:20px;">
            <div style="display:flex; flex-direction:column; gap:12px; max-height:220px; overflow:auto;">
              <% if (recentActivity.length === 0) { %>
                <p style="font-size:12px; color:#94A3B8; margin:0;">No recent platform activity.</p>
              <% } %>
              <% recentActivity.forEach(item => { %>
                <div style="display:flex; align-items:flex-start; gap:10px;">
                  <span style="width:28px; height:28px; border-radius:8px; background:var(--primary-light); color:var(--primary); display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;"><i class="fas fa-circle-info"></i></span>
                  <div style="min-width:0;">
                    <p style="font-size:12px; font-weight:700; color:#334155; margin:0; line-height:1.35;"><%= item.description %></p>
                    <p style="font-size:11px; color:#94A3B8; margin:3px 0 0;"><%= item.relativeTime %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <div class="sa-dashboard-split" style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; margin-bottom:20px; align-items:start;">
        <!-- Q3 Revenue Forecast -->
        <div class="card" style="height:100%; margin-bottom:0;">
          <div class="card-header">
            <h3 class="card-title">Q3 Revenue Forecast</h3>
          </div>
          <div class="card-body">
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <div>
                <h3 style="font-size:28px; font-weight:800; color:#0F172A; margin:0;">₹ <%= (metrics.revenue.forecast).toLocaleString('en-IN') %></h3>
                <p style="font-size:12px; color:#94A3B8; margin:8px 0 0;">Targeted project expansion trajectory based on current school signup volumes.</p>
              </div>
              <div style="width:48px; height:48px; border-radius:12px; background:#2563EB; color:#fff; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <i class="fas fa-bullseye text-xl"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Plan Revenue Distribution -->
        <div class="card" style="height:100%; margin-bottom:0;">
          <div class="card-header">
            <h3 class="card-title">Plan Revenue Distribution</h3>
          </div>
          <div class="card-body" style="display:flex; flex-direction:column; justify-content:space-between; padding:20px;">
            <div style="position:relative; height:120px; margin:10px 0; display:flex; align-items:center; justify-content:center;">
              <canvas id="planChart" role="img" aria-label="Plan revenue distribution chart" data-labels='<%- JSON.stringify(charts.plans.labels) %>' data-data='<%- JSON.stringify(charts.plans.data) %>' data-colors='<%- JSON.stringify(charts.plans.colors) %>'></canvas>
            </div>
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:8px; font-size:10px; border-top:1px solid #E2E8F0; padding-top:12px;">
              <% charts.plans.labels.forEach((label, i) => { 
                const val = charts.plans.data[i];
                const color = charts.plans.colors[i];
              %>
                <div style="display:flex; flex-direction:column; margin-top:8px;">
                  <span style="display:inline-flex; align-items:center; gap:4px; font-weight:600; color:#475569;">
                    <span style="width:8px; height:8px; border-radius:50%; flex-shrink:0; background-color:<%= color %>;"></span>
                    <%= label %>
                  </span>
                  <span style="font-weight:700; color:#0F172A; padding-left:12px; margin-top:2px;">₹ <%= val.toLocaleString('en-IN') %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <!-- Plan Intelligence -->
      <div class="card" style="margin-bottom:20px;">
        <div class="card-header">
          <div>
            <h3 class="card-title">Plan Intelligence</h3>
            <p style="font-size:12px; color:#94A3B8; margin-top:4px;">Live plan adoption, billing cycle mix, renewals and pending registrations</p>
          </div>
        </div>
        <div class="card-body">
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:16px;">
            <% planIntelligence.rows.forEach(plan => {
                const activeCount = Number(plan.active_schools || 0);
                const trialCount = Number(plan.trial_schools || 0);
                const monthlyCount = Number(plan.monthly_subscriptions || 0);
                const yearlyCount = Number(plan.yearly_subscriptions || 0);
                const pendingCount = Number(plan.pending_requests || 0);
                const expiringCount = Number(plan.expiring_soon || 0);
                const revenue = Number(plan.paid_revenue || 0); 
                const accent = plan.color_code || '#2563EB';
            %>
              <div style="border-radius:12px; border:1px solid #F1F5F9; background:#F8FAFC; padding:16px;">
                <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:16px;">
                  <div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span style="width:10px; height:10px; border-radius:50%; background-color:<%= accent %>;"></span>
                        <h4 style="font-size:14px; font-weight:700; color:#0F172A; margin:0;"><%= plan.name %></h4>
                    </div>
                    <p style="font-size:11px; color:#94A3B8; margin:4px 0 0;">₹<%= Number(plan.monthly_price || 0).toLocaleString('en-IN') %>/mo · ₹<%= Number(plan.yearly_price || 0).toLocaleString('en-IN') %>/yr</p>
                  </div>
                  <span class="chip chip-plan-<%= plan.plan_key %>"><%= plan.plan_key %></span>
                </div>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; font-size:12px;">
                  <div>
                    <div style="font-size:9px; font-weight:700; text-transform:uppercase; color:#94A3B8; letter-spacing:0.05em;">Schools</div>
                    <div style="font-weight:600; color:#334155;"><%= activeCount %> active · <%= trialCount %> trial</div>
                  </div>
                  <div>
                    <div style="font-size:9px; font-weight:700; text-transform:uppercase; color:#94A3B8; letter-spacing:0.05em;">Billing</div>
                    <div style="font-weight:600; color:#334155;"><%= monthlyCount %> monthly · <%= yearlyCount %> yearly</div>
                  </div>
                  <div>
                    <div style="font-size:9px; font-weight:700; text-transform:uppercase; color:#94A3B8; letter-spacing:0.05em;">Pipeline</div>
                    <div style="font-weight:600; color:#334155;"><%= pendingCount %> pending</div>
                  </div>
                  <div>
                    <div style="font-size:9px; font-weight:700; text-transform:uppercase; color:#94A3B8; letter-spacing:0.05em;">Renewal Risk</div>
                    <div style="font-weight:600; color:#334155;"><%= expiringCount %> expiring</div>
                  </div>
                </div>
                <div style="margin-top:16px; padding-top:12px; border-top:1px solid #E2E8F0; display:flex; align-items:center; justify-content:space-between;">
                  <span style="font-size:10px; font-weight:700; text-transform:uppercase; color:#94A3B8; letter-spacing:0.05em;">Paid revenue</span>
                  <span style="font-size:14px; font-weight:700; color:#0F172A;">₹<%= revenue.toLocaleString('en-IN') %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- 12-Month Revenue Trend -->
      <div class="card" style="margin-bottom:20px;">
        <div class="card-header">
          <div>
            <h3 class="card-title">12-Month Revenue Trend</h3>
            <p style="font-size:12px; color:#94A3B8; margin-top:4px;">Aggregate platform performance</p>
          </div>
          <a href="/superadmin/billing/reports" style="font-size:12px; font-weight:600; color:#2563EB; text-decoration:none;">View Billing Reports →</a>
        </div>
        <div class="card-body">
          <div style="position:relative; height:240px;">
            <canvas id="revenueChart" role="img" aria-label="12-month revenue trend chart" data-data='<%- JSON.stringify(charts.revenue.data) %>' data-labels='<%- JSON.stringify(charts.revenue.labels) %>'></canvas>
          </div>
        </div>
      </div>

      <!-- Platform Health Center -->
      <div class="card" style="margin-bottom:20px;">
        <div class="card-header">
          <div>
            <h3 class="card-title">Platform Health Center</h3>
            <p style="font-size:12px; color:#94A3B8; margin-top:4px;">SaaS platform vitals & response monitors</p>
          </div>
          <div style="display:flex; align-items:center; gap:6px; font-size:12px; color:#94A3B8;">
            <span style="width:8px; height:8px; border-radius:50%; background:#10B981; display:inline-block;"></span>
            Last updated: <span id="health-update-time"><%= health.updatedAt %></span>
          </div>
        </div>
        <div class="card-body">
          <div style="display:flex; flex-direction:row; align-items:center; gap:32px; flex-wrap:wrap;">
            <!-- Health Ring -->
            <div style="position:relative; width:120px; height:120px; flex-shrink:0; margin:0 auto;">
              <svg style="width:100%; height:100%; transform:rotate(-90deg);" viewBox="0 0 120 120">
                <circle cx="60" cy="60" r="54" fill="none" stroke="#E2E8F0" stroke-width="8"/>
                <circle cx="60" cy="60" r="54" fill="none" stroke="<%= health.score >= 95 ? '#10B981' : health.score >= 80 ? '#F59E0B' : '#EF4444' %>" stroke-width="8" stroke-linecap="round" stroke-dasharray="339.292" stroke-dashoffset="<%= 339.292 - (health.score / 100) * 339.292 %>" id="health-svg-ring" style="transition: all 1s ease-out;"/>
              </svg>
              <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;">
                <span style="font-size:24px; font-weight:700; color:#0F172A;" id="health-score-val"><%= health.score %>%</span>
                <span style="font-size:9px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-top:2px;">Health Score</span>
              </div>
            </div>
            <!-- Status Grid -->
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:16px; flex:1; width:100%;" id="healthComponentsGrid">
              <div style="display:flex; align-items:start; gap:10px;">
                <span class="<%= health.components.database.colorClass %>" style="width:10px; height:10px; border-radius:50%; margin-top:4px; flex-shrink:0;" id="health-dot-database"></span>
                <div>
                  <p style="font-size:13px; font-weight:600; color:#334155; margin:0;">Database</p>
                  <p style="font-size:11px; color:#94A3B8; margin:2px 0 0;" id="health-desc-database"><%= health.components.database.detail %></p>
                </div>
              </div>
              <div style="display:flex; align-items:start; gap:10px;">
                <span class="<%= health.components.api.colorClass %>" style="width:10px; height:10px; border-radius:50%; margin-top:4px; flex-shrink:0;" id="health-dot-api"></span>
                <div>
                  <p style="font-size:13px; font-weight:600; color:#334155; margin:0;">API Latency</p>
                  <p style="font-size:11px; color:#94A3B8; margin:2px 0 0;" id="health-desc-api"><%= health.components.api.detail %></p>
                </div>
              </div>
              <div style="display:flex; align-items:start; gap:10px;">
                <span class="<%= health.components.email.colorClass %>" style="width:10px; height:10px; border-radius:50%; margin-top:4px; flex-shrink:0;" id="health-dot-email"></span>
                <div>
                  <p style="font-size:13px; font-weight:600; color:#334155; margin:0;">Email Queue</p>
                  <p style="font-size:11px; color:#94A3B8; margin:2px 0 0;" id="health-desc-email"><%= health.components.email.detail %></p>
                </div>
              </div>
              <div style="display:flex; align-items:start; gap:10px;">
                <span class="<%= health.components.payments.colorClass %>" style="width:10px; height:10px; border-radius:50%; margin-top:4px; flex-shrink:0;" id="health-dot-payments"></span>
                <div>
                  <p style="font-size:13px; font-weight:600; color:#334155; margin:0;">Payment Hook</p>
                  <p style="font-size:11px; color:#94A3B8; margin:2px 0 0;" id="health-desc-payments"><%= health.components.payments.detail %></p>
                </div>
              </div>
              <div style="display:flex; align-items:start; gap:10px;">
                <span class="<%= health.components.backup.colorClass %>" style="width:10px; height:10px; border-radius:50%; margin-top:4px; flex-shrink:0;" id="health-dot-backup"></span>
                <div>
                  <p style="font-size:13px; font-weight:600; color:#334155; margin:0;">Backups</p>
                  <p style="font-size:11px; color:#94A3B8; margin:2px 0 0;" id="health-desc-backup"><%= health.components.backup.detail %></p>
                </div>
              </div>
              <div style="display:flex; align-items:start; gap:10px;">
                <span class="<%= health.components.notifications.colorClass %>" style="width:10px; height:10px; border-radius:50%; margin-top:4px; flex-shrink:0;" id="health-dot-notifications"></span>
                <div>
                  <p style="font-size:13px; font-weight:600; color:#334155; margin:0;">System Alerts</p>
                  <p style="font-size:11px; color:#94A3B8; margin:2px 0 0;" id="health-desc-notifications"><%= health.components.notifications.detail %></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- School Directory & Leaderboard -->
      <div class="card" style="margin-bottom:20px;">
        <div class="card-header">
          <div>
            <h3 class="card-title">School Directory & Leaderboard</h3>
            <p style="font-size:12px; color:#94A3B8; margin-top:4px;">Complete analytics of registered schools</p>
          </div>
          <a href="/superadmin/schools" style="font-size:12px; font-weight:600; color:#2563EB; text-decoration:none;">Manage Schools Directory →</a>
        </div>
