<%- include('../../partials/head', { title: typeof title !== 'undefined' ? title : (lan.Subscription_Plans || 'Subscription Plans') }) %>
<style>
    .status-badge-active {
        background: rgba(16, 185, 129, 0.15) !important;
        color: #10B981 !important;
    }
    .status-badge-inactive {
        background: rgba(148, 163, 184, 0.15) !important;
        color: #64748B !important;
    }
</style>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding:0;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; padding:24px 24px 0; flex-wrap:wrap; gap:12px;">
                <div>
                    <h1 style="font-size:20px; font-weight:700; color:#0F172A; margin:0;"><%- lan.Subscription_Plans || 'Subscription Plans' %></h1>
                    <p style="font-size:12px; color:#94A3B8; margin:4px 0 0;"><%- lan.Subscription_Plans_Sub || 'Configure subscription tiers, pricing, and system limits' %></p>
                </div>
                <div style="display:flex; gap:10px;">
                    <a href="/superadmin/plans/add" class="btn btn-primary" style="font-size:13px; padding:8px 16px; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                        <i class="nc-icon nc-simple-add"></i> <%- lan.Add_Plan || 'Add Plan' %>
                    </a>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div style="padding:0 24px 24px;">
                <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap:24px;">
                    <% plans.forEach(plan=> { %>
                        <div class="card plan-card" data-color="<%= plan.color_code %>" style="padding:24px; margin-bottom:0; display:flex; flex-direction:column; justify-content:space-between; border-radius:12px;">
                            <div style="text-align:center;">
                                <h3 class="plan-title" style="font-size:20px; font-weight:700; margin:0 0 12px; text-transform:uppercase; letter-spacing:0.05em;">
                                    <%= plan.name %>
                                </h3>
                                <div style="font-size:36px; font-weight:800; color:#0F172A; line-height:1; margin-bottom:4px;">
                                    ₹<%= plan.price %>
                                </div>
                                <p style="font-size:12px; color:#94A3B8; margin:0 0 20px;"><%- lan.Per_Year || 'per year' %></p>
                                <hr style="border:0; border-top:1px solid #E2E8F0; margin:0 0 20px;">
                                <ul style="list-style:none; padding:0; margin:0 0 20px; text-align:left; display:flex; flex-direction:column; gap:12px;">
                                    <li style="display:flex; align-items:center; gap:8px; font-size:13px; color:#334155;">
                                        <i class="nc-icon nc-check-2" style="color:#10B981; font-weight:bold;"></i>
                                        <span><strong><%= plan.student_limit || (lan.Unlimited || 'Unlimited') %></strong> <%- lan.Students || 'Students' %></span>
                                    </li>
                                    <% const features=plan.features || {}; %>
                                    <% Object.entries(features).forEach(([key, value])=> { %>
                                        <li style="display:flex; align-items:center; gap:8px; font-size:13px; color:#334155;">
                                            <i class="nc-icon nc-check-2" style="color:#10B981; font-weight:bold;"></i>
                                            <span style="text-transform:capitalize;"><%= key %>:</span> <%= value %>
                                        </li>
                                    <% }) %>
                                </ul>
                            </div>
                            <div>
                                <hr style="border:0; border-top:1px solid #E2E8F0; margin:0 0 20px;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                                    <span class="badge <%= plan.is_active ? 'status-badge-active' : 'status-badge-inactive' %>" style="padding:4px 10px; border-radius:9999px; font-size:11px; font-weight:700;">
                                        <%= plan.is_active ? (lan.Active || 'Active') : (lan.Inactive || 'Inactive') %>
                                    </span>
                                    <span style="font-size:12px; color:#64748B; font-weight:500;">
                                        <%= plan.school_count %> <%- (plan.school_count === 1 ? (lan.School || 'school') : (lan.Schools || 'schools')) %>
                                    </span>
                                </div>
                                <div style="display:flex; gap:8px; justify-content:center;">
                                    <a href="/superadmin/plans/<%= plan.id %>/edit" class="btn btn-secondary" style="flex:1; padding:8px 0; font-size:12px; font-weight:600; text-align:center; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; height:36px;"><%- lan.Edit || 'Edit' %></a>
                                    <form action="/superadmin/plans/<%= plan.id %>/toggle" method="POST" style="flex:1; margin:0; display:inline-block;">
                                        <button type="submit" class="btn <%= plan.is_active ? 'btn-secondary' : 'btn-primary' %>" style="width:100%; padding:8px 0; font-size:12px; font-weight:600; height:36px;">
                                            <%= plan.is_active ? (lan.Disable || 'Disable') : (lan.Enable || 'Enable') %>
                                        </button>
                                    </form>
                                    <form action="/superadmin/plans/<%= plan.id %>?_method=DELETE" method="POST" style="margin:0; display:inline-block;" onsubmit="return confirmDeletePlanList();">
                                        <button type="submit" class="btn" style="background:#EF4444; color:#fff; border:none; padding:0 12px; font-size:12px; font-weight:600; border-radius:6px; cursor:pointer; height:36px; display:inline-flex; align-items:center; justify-content:center;">
                                            <i class="nc-icon nc-simple-remove"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>

<script id="plansListLangData" type="application/json">
  <%- JSON.stringify({
    deleteConfirm: lan.Delete_Plan_Confirm || 'Delete plan? This action cannot be undone.'
  }) %>
</script>
<script>
    const plansListLang = JSON.parse(document.getElementById('plansListLangData')?.textContent || '{}');
    function confirmDeletePlanList() {
        return confirm(plansListLang.deleteConfirm || 'Delete plan? This action cannot be undone.');
    }

    document.querySelectorAll('.plan-card').forEach(card => {
        const color = card.dataset.color;
        if (color) {
            card.style.borderTop = `4px solid ${color}`;
            const title = card.querySelector('.plan-title');
            if (title) title.style.color = color;
        }
    });
</script>