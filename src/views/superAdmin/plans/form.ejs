    border-color: #3B82F6 !important;
  }

  [data-theme="dark"] .feature-chip input:checked ~ .feature-chip-icon,
  [data-theme="dark"] .feature-chip.is-checked .feature-chip-icon,
  [data-theme="dark"] .feature-chip input:checked ~ .feature-chip-label,
  [data-theme="dark"] .feature-chip.is-checked .feature-chip-label,
  .light-mode-disabled .feature-chip input:checked ~ .feature-chip-icon,
  .light-mode-disabled .feature-chip.is-checked .feature-chip-icon,
  .light-mode-disabled .feature-chip input:checked ~ .feature-chip-label,
  .light-mode-disabled .feature-chip.is-checked .feature-chip-label {
    color: #60A5FA !important;
  }

  [data-theme="dark"] .feature-group-head:hover,
  .light-mode-disabled .feature-group-head:hover {
    background: #1E293B !important;
  }

  [data-theme="dark"] .feature-group-head h4,
  .light-mode-disabled .feature-group-head h4 {
    color: #F1F5F9 !important;
  }

  [data-theme="dark"] .feature-group-count,
  .light-mode-disabled .feature-group-count {
    background: rgba(37, 99, 235, 0.18) !important;
    border-color: rgba(37, 99, 235, 0.3) !important;
    color: #60A5FA !important;
  }

  [data-theme="dark"] .group-action-btn,
  .light-mode-disabled .group-action-btn {
    color: #94A3B8 !important;
  }

  [data-theme="dark"] .group-action-btn[data-action="select-all"],
  .light-mode-disabled .group-action-btn[data-action="select-all"] {
    color: #60A5FA !important;
  }

  [data-theme="dark"] .plan-btn-secondary,
  .light-mode-disabled .plan-btn-secondary {
    background: #1E293B !important;
    border-color: #242F4D !important;
    color: #F1F5F9 !important;
  }

  [data-theme="dark"] .plan-btn-secondary:hover,
  .light-mode-disabled .plan-btn-secondary:hover {
    background: #334155 !important;
    border-color: #475569 !important;
    color: #FFFFFF !important;
  }

  @media (max-width: 1100px) {
    .plan-grid,
    .plan-topbar {
      grid-template-columns: 1fr;
      flex-direction: column;
    }

    .plan-preview-card {
      width: 100%;
      min-width: 0;
    }
  }

  @media (max-width: 720px) {
    .plan-form-shell {
      padding: 20px 14px 32px;
    }

    .plan-fields-grid,
    .plan-switch-row {
      grid-template-columns: 1fr;
    }

    .plan-form-body,
    .plan-form-card-header,
    .plan-actions {
      padding-left: 16px;
      padding-right: 16px;
    }

    .plan-actions {
      flex-direction: column-reverse;
    }

    .plan-btn {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .plan-preview-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
<div class="app-wrapper superadmin-theme">
  <%- include('../../partials/sidebar', { currentPath: '/superadmin/plans' }) %>
  <div class="main-panel">
    <%- include('../../partials/header') %>
    <%- include('../../partials/flashMessages') %>
    <main class="plan-form-shell">
      <div class="plan-topbar d-flex space-between w-full">
        <div>
          <h1 class="plan-heading"><%= isEdit ? 'Edit Plan: ' + plan.name : 'Create New Plan' %></h1>
          <p class="plan-subtitle">Set pricing, resource limits, modules, and the public identity of this subscription plan.</p>
        </div>
        <button onclick="window.location.href='/superadmin/plans'" class="plans-add-btn"><i class="fas fa-arrow-left"></i>Back to Plans</button>
      </div>
      <section class="plan-form-card">
        <div class="plan-form-card-header">
          <div>
            <h2 class="plan-section-title"><%= isEdit ? 'Edit Plan Details' : 'New Plan Details' %></h2>
            <p class="plan-section-hint">Fields marked with * are required. Leave resource limits blank for unlimited access.</p>
          </div>
        </div>
        <form action="<%= isEdit ? '/superadmin/plans/edit/' + plan.id : '/superadmin/plans/add' %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div class="plan-form-body">
            <div class="plan-grid">
              <div>
                <div class="plan-panel">
                  <div class="plan-panel-heading">
                    <i class="fas fa-layer-group"></i>
                    <div>
                      <h3>Basic Information</h3>
                      <p>Name, unique key, description, icon, and theme.</p>
                    </div>
                  </div>
                  <div class="plan-fields-grid">
                    <div>
                      <label for="name" class="plan-label">Plan Name *</label>
                      <input type="text" class="plan-control" id="name" name="name" required placeholder="e.g. Premium" value="<%= isEdit ? plan.name : '' %>">
                    </div>
                    <div>
                      <label for="plan_key" class="plan-label">Plan Key *</label>
                      <input type="text" class="plan-control" id="plan_key" name="plan_key" required placeholder="e.g. premium" pattern="[a-z0-9_\\-]+" <%= isEdit ? 'readonly' : '' %> value="<%= isEdit ? plan.plan_key : '' %>">
                      <span class="plan-help">Lowercase letters, numbers, hyphen, or underscore.</span>
                    </div>
                    <div class="plan-field-full">
                      <label for="description" class="plan-label">Description</label>
                      <textarea class="plan-textarea" id="description" name="description" placeholder="Short internal summary for this plan."><%= isEdit ? (plan.description || '') : '' %></textarea>
                    </div>
                    <div>
                      <label for="icon" class="plan-label">Icon</label>
                      <input type="text" class="plan-control" id="icon" name="icon" placeholder="crown" value="<%= planIcon %>">
                      <span class="plan-help">Font Awesome name without the fa- prefix.</span>
                    </div>
                    <div>
                      <label for="color_code" class="plan-label">Color Theme</label>
                      <div class="color-field">
                        <input type="color" class="plan-color-input" id="color_code" name="color_code" value="<%= planColor %>">
                        <input type="text" class="plan-control" id="color_code_text" value="<%= planColor %>" aria-label="Selected color code" readonly>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="plan-panel">
                  <div class="plan-panel-heading">
                    <i class="fas fa-tags"></i>
                    <div>
                      <h3>Pricing & Availability</h3>
                      <p>Monthly, yearly, trial, active status, and popular badge.</p>
                    </div>
                  </div>
                  <div class="plan-fields-grid">
                    <div>
                      <label for="monthly_price" class="plan-label">Monthly Price *</label>
                      <div class="price-input">
                        <span class="price-prefix">₹</span>
                        <input type="number" min="0" step="0.01" class="plan-control" id="monthly_price" name="monthly_price" required placeholder="999.00" value="<%= isEdit ? plan.monthly_price : '' %>">
                      </div>
                    </div>
                    <div>
                      <label for="yearly_price" class="plan-label">Yearly Price *</label>
                      <div class="price-input">
                        <span class="price-prefix">₹</span>
                        <input type="number" min="0" step="0.01" class="plan-control" id="yearly_price" name="yearly_price" required placeholder="9990.00" value="<%= isEdit ? plan.yearly_price : '' %>">
                      </div>
                    </div>
                    <div>
                      <label for="trial_days" class="plan-label">Trial Period</label>
                      <input type="number" min="0" class="plan-control" id="trial_days" name="trial_days" placeholder="Add Trial Days" value="<%= isEdit ? plan.trial_days : '' %>">
                    </div>
                    <div class="plan-switch-row plan-field-full">
                      <label class="plan-switch" for="is_active">
                        <input type="checkbox" id="is_active" name="is_active" <%= (!plan || plan.is_active) ? 'checked' : '' %>>
                        <span>
                          <strong>Active plan</strong>
                          <span>Available for subscription selection immediately.</span>
                        </span>
                      </label>
                      <label class="plan-switch" for="is_popular">
                        <input type="checkbox" id="is_popular" name="is_popular" <%= (plan && plan.is_popular) ? 'checked' : '' %>>
                        <span>
                          <strong>Mark as popular</strong>
                          <span>Highlight this plan in plan comparisons.</span>
                        </span>
                      </label>
                    </div>
                  </div>
                </div>
              </div>
              <div>
                <div class="plan-panel">
                  <div class="plan-panel-heading">
                    <i class="fas fa-sliders"></i>
                    <div>
                      <h3>Resource Limits</h3>
                      <p>Blank values are treated as unlimited.</p>
                    </div>
                  </div>
                  <div class="plan-fields-grid">
                    <div class="plan-field-full">
                      <label for="max_students" class="plan-label">Max Students</label>
                      <input type="number" min="0" class="plan-control" id="max_students" name="max_students" placeholder="Unlimited" value="<%= isEdit ? (plan.max_students || '') : '' %>">
                    </div>
                    <div class="plan-field-full">
                      <label for="max_teachers" class="plan-label">Max Teachers</label>
                      <input type="number" min="0" class="plan-control" id="max_teachers" name="max_teachers" placeholder="Unlimited" value="<%= isEdit ? (plan.max_teachers || '') : '' %>">
                    </div>
                    <div class="plan-field-full">
                      <label for="max_classes" class="plan-label">Max Classes</label>
                      <input type="number" min="0" class="plan-control" id="max_classes" name="max_classes" placeholder="Unlimited" value="<%= isEdit ? (plan.max_classes || '') : '' %>">
                    </div>
                  </div>
                </div>
                <div class="plan-panel">
                  <div class="plan-panel-heading">
                    <i class="fas fa-list-check"></i>
                    <div>
                      <h3>Included Modules</h3>
                      <p>Select the product modules enabled for this plan.</p>
                    </div>
                  </div>
                  <div class="feature-toolbar">
                    <div class="feature-counter"><span id="selectedFeatureCount">0</span> modules selected</div>
                    <div class="feature-toolbar-actions">
                      <button type="button" class="feature-tool-btn" id="selectCoreFeatures">Core</button>
                      <button type="button" class="feature-tool-btn" id="selectAllFeatures">Select All</button>
                      <button type="button" class="feature-tool-btn" id="clearAllFeatures">Clear</button>
                    </div>
                  </div>
                  <% featureGroups.forEach((group, groupIndex) => { %>
                    <div class="feature-group" data-feature-group>
                      <div class="feature-group-head">
                        <div class="feature-group-title-wrap">
                          <i class="fas fa-chevron-right feature-group-chevron"></i>
                          <div>
                            <h4><%= group.title %></h4>
                            <p><%= group.text %></p>
                          </div>
                        </div>
                        <div class="feature-group-actions-wrap">
                          <button type="button" class="group-action-btn" data-action="select-all">Select all</button>
                          <span class="group-action-divider">|</span>
                          <button type="button" class="group-action-btn" data-action="clear-all">Clear</button>
                          <span class="feature-group-count" data-group-count>0/<%= group.items.length %></span>
                        </div>
                      </div>
                      <div class="feature-grid">
                        <% group.items.forEach(item => { %>
                          <label class="feature-chip" for="<%= item.name %>" title="<%= item.text %>">
                            <input type="checkbox" id="<%= item.name %>" name="<%= item.name %>" data-feature-checkbox data-feature-key="<%= item.key %>" <%= (features && features[item.key]) ? 'checked' : '' %>>
                            <span class="feature-chip-icon"><i class="fas <%= item.icon %>"></i></span>
                            <span class="feature-chip-label"><%= item.title %></span>
                          </label>
                        <% }) %>
                      </div>
                    </div>
                    <% }) %>
                </div>
              </div>
            </div>
          </div>
          <div class="plan-actions">
            <a href="/superadmin/plans" class="plan-btn plan-btn-secondary">Cancel</a>
            <button type="submit" class="plan-btn plan-btn-primary">
              <i class="fas fa-save"></i>
              <%= isEdit ? 'Save Changes' : 'Create Plan' %>
            </button>
          </div>
        </form>
      </section>
    </main>
</div>
</div>
<%- include('../../partials/footer') %>

<script>
    (function () {
        const nameInput = document.getElementById('name');
        const keyInput = document.getElementById('plan_key');
        const monthlyInput = document.getElementById('monthly_price');
        const maxStudentsInput = document.getElementById('max_students');
        const maxTeachersInput = document.getElementById('max_teachers');
        const colorInput = document.getElementById('color_code');
        const colorText = document.getElementById('color_code_text');
        const iconInput = document.getElementById('icon');
        const activeInput = document.getElementById('is_active');
        const previewName = document.getElementById('planPreviewName');
        const previewPrice = document.getElementById('planPreviewPrice');
        const previewStatus = document.getElementById('planPreviewStatus');
        const previewIcon = document.getElementById('planPreviewIcon');
        const previewStudents = document.getElementById('planPreviewStudents');
        const previewTeachers = document.getElementById('planPreviewTeachers');
        const previewModules = document.getElementById('planPreviewModules');
        const selectedFeatureCount = document.getElementById('selectedFeatureCount');
        const featureCheckboxes = Array.from(document.querySelectorAll('[data-feature-checkbox]'));
        const selectCoreFeatures = document.getElementById('selectCoreFeatures');
        const selectAllFeatures = document.getElementById('selectAllFeatures');
        const clearAllFeatures = document.getElementById('clearAllFeatures');
        const coreFeatureKeys = new Set(['dashboard', 'students', 'teachers', 'classes', 'subjects', 'attendance', 'fees', 'exams', 'homework', 'timetable']);

        function formatCurrency(value) {
            const num = Number(value || 0);
            return num.toLocaleString('en-IN', { maximumFractionDigits: 2 });
        };

        function formatLimit(value) {
            const num = Number(value || 0);
            return num > 0 ? num.toLocaleString('en-IN') : 'Unlimited';
        };

        function syncFeatureCounts() {
            const selected = featureCheckboxes.filter(input => input.checked).length;
            if (selectedFeatureCount) selectedFeatureCount.textContent = selected;
            if (previewModules) previewModules.textContent = selected;

            document.querySelectorAll('[data-feature-group]').forEach(group => {
                const inputs = Array.from(group.querySelectorAll('[data-feature-checkbox]'));
                const count = inputs.filter(input => input.checked).length;
                const badge = group.querySelector('[data-group-count]');
                if (badge) badge.textContent = count + '/' + inputs.length;
            });

            featureCheckboxes.forEach(input => {
                const chip = input.closest('.feature-chip');
                if (chip) {
                    chip.classList.toggle('is-checked', input.checked);
                }
            });
        };

        function syncPreview() {
            if (previewName) previewName.textContent = nameInput.value.trim() || 'New Plan';
            if (previewPrice) previewPrice.textContent = '₹' + formatCurrency(monthlyInput.value) + '/mo';
            if (previewStatus) previewStatus.textContent = activeInput.checked ? 'Active' : 'Inactive';
            if (previewStudents) previewStudents.textContent = formatLimit(maxStudentsInput.value);
            if (previewTeachers) previewTeachers.textContent = formatLimit(maxTeachersInput.value);
            if (previewIcon) {
                previewIcon.style.background = colorInput.value;
                previewIcon.innerHTML = '<i class="fas fa-' + (iconInput.value.trim() || 'box') + '"></i>';
            }
            if (colorText) colorText.value = colorInput.value;
        };

        function slugifyPlanKey() {
            if (!keyInput || keyInput.readOnly || keyInput.value.trim()) return;
            keyInput.value = nameInput.value
                .toLowerCase()
                .trim()
                .replace(/[^a-z0-9]+/g, '_')
                .replace(/^_+|_+$/g, '');
        };

        [nameInput, monthlyInput, maxStudentsInput, maxTeachersInput, colorInput, iconInput, activeInput].forEach((input) => {
            if (input) input.addEventListener('input', syncPreview);
            if (input) input.addEventListener('change', syncPreview);
        });

        if (nameInput) {
            nameInput.addEventListener('blur', slugifyPlanKey);
        };

        featureCheckboxes.forEach(input => {
            input.addEventListener('change', syncFeatureCounts);
        });

        if (selectCoreFeatures) {
            selectCoreFeatures.addEventListener('click', () => {
                featureCheckboxes.forEach(input => {
                    input.checked = coreFeatureKeys.has(input.dataset.featureKey);
                });
                syncFeatureCounts();
            });
        };

        if (selectAllFeatures) {
            selectAllFeatures.addEventListener('click', () => {
                featureCheckboxes.forEach(input => { input.checked = true; });
                syncFeatureCounts();
            });
        };

        if (clearAllFeatures) {
            clearAllFeatures.addEventListener('click', () => {
                featureCheckboxes.forEach(input => { input.checked = false; });
                syncFeatureCounts();
            });

            document.querySelectorAll('.feature-group-head').forEach(head => {
                head.addEventListener('click', (event) => {

                    if (event.target.closest('.group-action-btn')) return;
                    const group = head.closest('[data-feature-group]');
                    if (group) {
                        const isExpanded = group.getAttribute('data-expanded') === 'true';
                        group.setAttribute('data-expanded', isExpanded ? 'false' : 'true');
                    };
                });
            });

            document.querySelectorAll('.group-action-btn').forEach(btn => {
                btn.addEventListener('click', (event) => {
                    event.stopPropagation();
                    const action = btn.dataset.action;
                    const group = btn.closest('[data-feature-group]');
                    
                    if (group) {
                        const checkboxes = group.querySelectorAll('[data-feature-checkbox]');
                        checkboxes.forEach(cb => {
                            cb.checked = (action === 'select-all');
                        });
                        syncFeatureCounts();
                    };
                });
            });

            const groups = document.querySelectorAll('[data-feature-group]');
            let autoExpandIndex = -1;

            groups.forEach((group, index) => {
                const checkedBoxes = group.querySelectorAll('[data-feature-checkbox]:checked');
                if (checkedBoxes.length > 0 && autoExpandIndex === -1) {
                    autoExpandIndex = index;
                };
            });

            if (autoExpandIndex === -1 && groups.length > 0) {
                autoExpandIndex = 0;
            };

            groups.forEach((group, index) => {
                group.setAttribute('data-expanded', index === autoExpandIndex ? 'true' : 'false');
            });
        };
    
        syncPreview();
        syncFeatureCounts();
    })();
</script>