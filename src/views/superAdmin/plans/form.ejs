    const featureItems = featureGroups.flatMap(group => group.items);
%>
<style>
  .plan-form-shell {
    padding: 10px 12px;
  }

  .plan-topbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .plan-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #2563eb;
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    margin-bottom: 10px;
  }

  .plan-back-link:hover {
    color: #1d4ed8;
    text-decoration: none;
  }

  .plan-heading {
    margin: 0;
    color: #0f172a;
    font-size: 30px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: 0;
  }

  .plan-subtitle {
    margin: 8px 0 0;
    color: #64748b;
    font-size: 14px;
  }

  .plan-preview-card {
    min-width: 250px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    padding: 16px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  }

  .plan-preview-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: '<%= planColor %>';
    margin-bottom: 12px;
  }

  .plan-preview-name {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }

  .plan-preview-meta {
    color: #64748b;
    font-size: 12px;
    margin: 4px 0 0;
  }

  .plan-preview-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 14px;
  }

  .plan-preview-stat {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 9px;
    background: #f8fafc;
  }

  .plan-preview-stat strong {
    display: block;
    color: #0f172a;
    font-size: 13px;
    line-height: 1.2;
  }

  .plan-preview-stat span {
    display: block;
    color: #64748b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    margin-top: 3px;
    text-transform: uppercase;
  }

  .plan-form-card {
    border: 1px solid #dbe3ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    overflow: hidden;
  }

  .plan-form-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 22px;
    border-bottom: 1px solid #e2e8f0;
    background: linear-gradient(180deg, #fff, #f8fafc);
  }

  .plan-section-title {
    margin: 0;
    color: #0f172a;
    font-size: 15px;
    font-weight: 800;
  }

  .plan-section-hint {
    margin: 3px 0 0;
    color: #64748b;
    font-size: 12px;
  }

  .plan-form-body {
    padding: 22px;
  }

  .plan-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(340px, 0.88fr);
    gap: 22px;
    align-items: start;
  }

  .plan-panel {
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 18px;
    background: #fff;
  }

  .plan-panel + .plan-panel {
    margin-top: 18px;
  }

  .plan-panel-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .plan-panel-heading i {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #2563eb;
    background: #eff6ff;
  }

  .plan-panel-heading h3 {
    margin: 0;
    color: #0f172a;
    font-size: 15px;
    font-weight: 800;
  }

  .plan-panel-heading p {
    margin: 2px 0 0;
    color: #64748b;
    font-size: 12px;
  }

  .plan-fields-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .plan-field-full {
    grid-column: 1 / -1;
  }

  .plan-label {
    display: block;
    margin-bottom: 7px;
    color: #334155;
    font-size: 12px;
    font-weight: 800;
  }

  .plan-control,
  .plan-textarea {
    width: 100%;
    min-height: 46px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 12px;
    color: #0f172a;
    background: #fff;
    font-size: 14px;
    outline: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .plan-textarea {
    min-height: 92px;
    resize: vertical;
  }

  .plan-control:focus,
  .plan-textarea:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .plan-control[readonly] {
    background: #f8fafc;
    color: #64748b;
  }

  .plan-help {
    display: block;
    margin-top: 6px;
    color: #94a3b8;
    font-size: 12px;
  }

  .price-input {
    display: flex;
    align-items: stretch;
  }

  .price-prefix {
    min-width: 46px;
    border: 1px solid #cbd5e1;
    border-right: 0;
    border-radius: 10px 0 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    background: #f8fafc;
    font-weight: 800;
  }

  .price-input .plan-control {
    border-radius: 0 10px 10px 0;
  }

  .color-field {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 10px;
    align-items: center;
  }

  .plan-color-input {
    width: 64px;
    height: 46px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 5px;
    background: #fff;
  }

  .feature-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .feature-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    padding: 10px 12px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #f8fafc;
  }

  .feature-counter {
    color: #334155;
    font-size: 12px;
    font-weight: 800;
  }

  .feature-toolbar-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .feature-tool-btn {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #fff;
    color: #2563eb;
    cursor: pointer;
    font-size: 12px;
    font-weight: 800;
    min-height: 32px;
    padding: 0 10px;
  }

  .feature-group {
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 13px;
    background: #fff;
  }

  .feature-group + .feature-group {
    margin-top: 12px;
  }

  .feature-group-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 10px;
    transition: background 0.15s ease;
    user-select: none;
  }

  .feature-group-head:hover {
    background: #f8fafc;
  }

  .feature-group-title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .feature-group-head h4 {
    margin: 0;
    color: #0f172a;
    font-size: 13px;
    font-weight: 800;
  }

  .feature-group-head p {
    margin: 3px 0 0;
    color: #64748b;
    font-size: 11px;
  }

  .feature-group-actions-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .group-action-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .group-action-btn[data-action="select-all"] {
    color: #2563eb;
  }

  .group-action-btn[data-action="select-all"]:hover {
    color: #1d4ed8;
  }

  .group-action-btn[data-action="clear-all"]:hover {
    color: #475569;
  }

  .group-action-divider {
    color: #cbd5e1;
    font-size: 11px;
    user-select: none;
  }

  .feature-group-chevron {
    font-size: 13px;
    color: #64748b;
    transition: transform 0.15s ease;
    width: 14px;
    text-align: center;
  }

  .feature-group-count {
    align-self: center;
    border-radius: 999px;
    color: #2563eb;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 8px;
    white-space: nowrap;
  }

  .feature-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: #fff;
    border: 0.5px solid #cbd5e1;
    border-radius: 8px;
    cursor: pointer;
    user-select: none;
    transition: all 0.16s ease;
  }

  .feature-chip:hover {
    border-color: #94a3b8;
    background: #f8fafc;
  }

  .feature-chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .feature-chip-icon {
    font-size: 14px;
    color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 16px;
  }

  .feature-chip-label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
  }

  .plans-add-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 8px; font-size: 13px; font-weight: 500; background: #eff6ff; border: 1px solid #bfdbfe; color: #2563eb; text-decoration: none; white-space: nowrap; transition: background 0.15s; }
  .feature-chip:has(input:checked),
  .feature-chip.is-checked {
    background: #eff6ff;
    border-color: #2563eb;
  }

  .feature-chip input:checked ~ .feature-chip-icon,
  .feature-chip.is-checked .feature-chip-icon {
    color: #2563eb;
  }

  .feature-chip input:checked ~ .feature-chip-label,
  .feature-chip.is-checked .feature-chip-label {
    color: #2563eb;
  }

  .feature-group[data-expanded="false"] .feature-grid {
    display: none !important;
  }

  .feature-group[data-expanded="true"] .feature-group-chevron {
    transform: rotate(90deg);
  }

  .plan-switch-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .plan-switch {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 13px;
    cursor: pointer;
    margin: 0;
    background: #fff;
  }

  .plan-switch input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }

  .plan-switch strong {
    display: block;
    color: #0f172a;
    font-size: 13px;
  }

  .plan-switch span {
    display: block;
    color: #64748b;
    font-size: 12px;
    line-height: 1.35;
    margin-top: 3px;
  }

  .plan-actions {
    position: sticky;
    bottom: 0;
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding: 16px 22px;
    border-top: 1px solid #e2e8f0;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
  }

  .plan-btn {
    min-height: 44px;
    border-radius: 10px;
    padding: 0 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .plan-btn-secondary {
    color: #334155;
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  .plan-btn-primary {
    color: #fff;
    background: #2563eb;
    border-color: #2563eb;
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.22);
  }

  .plan-btn:hover {
    text-decoration: none;
  }

  [data-theme="dark"] .plan-heading,
  [data-theme="dark"] .plan-section-title,
  [data-theme="dark"] .plan-panel-heading h3,
  [data-theme="dark"] .plan-preview-name,
  [data-theme="dark"] .feature-copy strong,
  [data-theme="dark"] .plan-switch strong,
  .light-mode-disabled .plan-heading,
  .light-mode-disabled .plan-section-title,
  .light-mode-disabled .plan-panel-heading h3,
  .light-mode-disabled .plan-preview-name,
  .light-mode-disabled .feature-copy strong,
  .light-mode-disabled .plan-switch strong {
    color: #f8fafc !important;
  }

  [data-theme="dark"] .plan-subtitle,
  [data-theme="dark"] .plan-section-hint,
  [data-theme="dark"] .plan-preview-meta,
  [data-theme="dark"] .plan-panel-heading p,
  [data-theme="dark"] .plan-help,
  [data-theme="dark"] .feature-copy span,
  [data-theme="dark"] .plan-switch span,
  .light-mode-disabled .plan-subtitle,
  .light-mode-disabled .plan-section-hint,
  .light-mode-disabled .plan-preview-meta,
  .light-mode-disabled .plan-panel-heading p,
  .light-mode-disabled .plan-help,
  .light-mode-disabled .feature-copy span,
  .light-mode-disabled .plan-switch span {
    color: #94a3b8 !important;
  }

  [data-theme="dark"] .plan-preview-card,
  [data-theme="dark"] .plan-form-card,
  [data-theme="dark"] .plan-panel,
  [data-theme="dark"] .plan-preview-stat,
  [data-theme="dark"] .feature-toolbar,
  [data-theme="dark"] .feature-group,
  [data-theme="dark"] .feature-card,
  [data-theme="dark"] .plan-switch,
  .light-mode-disabled .plan-preview-card,
  .light-mode-disabled .plan-form-card,
  .light-mode-disabled .plan-panel,
  .light-mode-disabled .plan-preview-stat,
  .light-mode-disabled .feature-toolbar,
  .light-mode-disabled .feature-group,
  .light-mode-disabled .feature-card,
  .light-mode-disabled .plan-switch {
    background: #151D30 !important;
    border-color: #242F4D !important;
  }

  [data-theme="dark"] .plan-form-card-header,
  [data-theme="dark"] .plan-actions,
  .light-mode-disabled .plan-form-card-header,
  .light-mode-disabled .plan-actions {
    background: #1E293B !important;
    border-color: #242F4D !important;
  }

  [data-theme="dark"] .plan-control,
  [data-theme="dark"] .plan-textarea,
  [data-theme="dark"] .plan-color-input,
  .light-mode-disabled .plan-control,
  .light-mode-disabled .plan-textarea,
  .light-mode-disabled .plan-color-input {
    background: #0f172a !important;
    border-color: #242F4D !important;
    color: #f8fafc !important;
    color-scheme: dark;
  }

  [data-theme="dark"] .feature-tool-btn,
  .light-mode-disabled .feature-tool-btn {
    background: #0f172a !important;
    border-color: #242F4D !important;
    color: #93c5fd !important;
  }

  [data-theme="dark"] .price-prefix,
  .light-mode-disabled .price-prefix {
    background: #1e293b !important;
    border-color: #242F4D !important;
    color: #cbd5e1 !important;
  }

  [data-theme="dark"] .feature-chip,
  .light-mode-disabled .feature-chip {
    background: #0F172A !important;
    border-color: #242F4D !important;
  }

  [data-theme="dark"] .feature-chip:hover,
  .light-mode-disabled .feature-chip:hover {
    background: #1E293B !important;
    border-color: #3B82F6 !important;
  }

  [data-theme="dark"] .feature-chip-label,
  .light-mode-disabled .feature-chip-label {
    color: #CBD5E1 !important;
  }

  [data-theme="dark"] .feature-chip-icon,
  .light-mode-disabled .feature-chip-icon {
    color: #94A3B8 !important;
  }

  [data-theme="dark"] .feature-chip:has(input:checked),
  [data-theme="dark"] .feature-chip.is-checked,
  .light-mode-disabled .feature-chip:has(input:checked),
  .light-mode-disabled .feature-chip.is-checked {
