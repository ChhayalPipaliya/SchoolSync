<%- include('../../partials/head') %>
<title><%= title %></title>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar') %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <%- include('../../partials/flashMessages') %>
        <div class="content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0 text-gray-800">School Subscriptions</h1>
                    <p class="text-muted small mb-0">Monitor billing cycles, active subscriptions, and upcoming expirations.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/superadmin/subscriptions/expiring" class="btn btn-outline-warning mr-2">
                        <i class="fas fa-clock mr-1"></i> Expiring Soon
                    </a>
                    <a href="/superadmin/subscriptions/assign" class="btn btn-primary">
                        <i class="fas fa-plus mr-1"></i> Assign Subscription
                    </a>
                </div>
            </div>
            <div class="card shadow mb-4">
                <div class="card-body">
                    <form method="GET" action="<%= currentPath %>" class="row align-items-end gap-2 a">
                        <div class="col-md-2 mb-2">
                            <label class="small font-weight-bold text-gray-700">Search School Name</label>
                            <input type="text" name="search" class="form-control form-control-sm" placeholder="Search..." value="<%= filters.search || '' %>">
                        </div>
                        <div class="col-md-2 mb-2">
                            <label class="small font-weight-bold text-gray-700">Plan</label>
                            <select name="plan_id" class="form-control form-control-sm">
                                <option value="">All Plans</option>
                                <% plans.forEach(p => { %>
                                    <option value="<%= p.id %>" <%= filters.plan_id == p.id ? 'selected' : '' %>><%= p.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-1 mb-2">
                            <label class="small font-weight-bold text-gray-700">Status</label>
                            <select name="status" class="form-control form-control-sm">
                                <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="trial" <%= filters.status === 'trial' ? 'selected' : '' %>>Trial</option>
                                <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>Expired</option>
                                <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-1 mb-2">
                            <label class="small font-weight-bold text-gray-700">From Date</label>
                            <input type="date" name="start_date" class="form-control form-control-sm" value="<%= filters.start_date || '' %>">
                        </div>
                        <div class="col-md-1 mb-2">
                            <label class="small font-weight-bold text-gray-700">To Date</label>
                            <input type="date" name="end_date" class="form-control form-control-sm" value="<%= filters.end_date || '' %>">
                        </div>
                        <div class="col-md-2 mb-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm" style="height: 31px; display: inline-flex; align-items: center; justify-content: center; font-weight: 600; padding: 0 16px;">Filter</button>
                            <a href="/superadmin/subscriptions" class="btn btn-secondary btn-sm" title="Clear Filters" style="height: 31px; width: 31px; display: inline-flex; align-items: center; justify-content: center; padding: 0;"><i class="fas fa-times"></i></a>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card shadow mb-4">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>School Name</th>
                                <th>Plan</th>
                                <th>Billing Cycle</th>
                                <th>Price</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Days Left</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (subscriptions && subscriptions.length > 0) { %>
                                <% subscriptions.forEach(sub => { 
                                    let daysRemaining = 0;
                                    if (sub.end_date) {
                                        const end = new Date(sub.end_date);
                                        if (end.getHours() === 0 && end.getMinutes() === 0 && end.getSeconds() === 0 && end.getMilliseconds() === 0) {
                                            end.setHours(23, 59, 59, 999);
                                        }
                                        const now = new Date();
                                        daysRemaining = now > end ? 0 : Math.ceil((end - now) / (1000 * 60 * 60 * 24));
                                    }
                                    
                                    let daysClass = 'days-ok';
                                    if (sub.status !== 'active' && sub.status !== 'trial') {
                                        daysClass = 'text-muted';
                                    } else if (daysRemaining < 7) {
                                        daysClass = 'days-critical';
                                    } else if (daysRemaining < 30) {
                                        daysClass = 'days-warning';
                                    }
                                %>
                                    <tr>
                                        <td>
                                            <strong><%= sub.school_name %></strong>
                                            <div class="text-muted small"><%= sub.subdomain %>.schoolsync.com</div>
                                        </td>
                                        <td>
                                            <span class="badge badge-primary"><%= sub.plan_name || sub.plan %></span>
                                        </td>
                                        <td class="text-capitalize"><%= (sub.status === 'trial' || String(sub.plan || '').toLowerCase() === 'trial') ? 'trial' : (sub.billing_cycle || 'monthly') %></td>
                                        <td>₹<%= sub.price %></td>
                                        <td><%= new Date(sub.start_date).toLocaleDateString('en-IN') %></td>
                                        <td><%= new Date(sub.end_date).toLocaleDateString('en-IN') %></td>
                                        <td class="<%= daysClass %>">
                                            <% if (sub.status !== 'active' && sub.status !== 'trial') { %>
                                                —
                                            <% } else { %>
                                                <%= daysRemaining > 0 ? daysRemaining + ' days' : 'Expired' %>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (sub.status === 'active') { %>
                                                <span class="badge badge-success"><i class="fas fa-circle mr-1 text-xs"></i> Active</span>
                                            <% } else if (sub.status === 'trial') { %>
                                                <span class="badge badge-warning"><i class="fas fa-circle mr-1 text-xs"></i> Trial</span>
                                            <% } else if (sub.status === 'expired') { %>
                                                <span class="badge badge-danger"><i class="fas fa-circle mr-1 text-xs"></i> Expired</span>
                                            <% } else { %>
                                                <span class="badge badge-secondary"><i class="fas fa-circle mr-1 text-xs"></i> Cancelled</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="d-flex">
                                                <a href="/superadmin/subscriptions/<%= sub.id %>" class="btn btn-sm btn-outline-primary mr-1" title="View Details">
                                                    <i class="fas fa-eye mr-1"></i> View
                                                </a>
                                                <% if (sub.status === 'active' || sub.status === 'trial') { %>
                                                    <form action="/superadmin/subscriptions/<%= sub.id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Cancel this subscription? School status will set to inactive.')">
                                                        <input type="hidden" name="reason" value="Cancelled by admin">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel Subscription">
                                                            <i class="fas fa-ban"></i> Cancel
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="9" class="text-center py-4">No subscriptions found matching filters.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                <% if (pagination.totalPages > 1) { %>
                    <nav aria-label="Subscription Pagination" class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-muted small">Showing page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.total %> total records)</span>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= pagination.page - 1 %>&status=<%= filters.status %>&plan_id=<%= filters.plan_id %>&search=<%= filters.search %>">Previous</a>
                            </li>
                            <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                                <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>&status=<%= filters.status %>&plan_id=<%= filters.plan_id %>&search=<%= filters.search %>"><%= i %></a>
                                </li>
                            <% } %>
                            <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= pagination.page + 1 %>&status=<%= filters.status %>&plan_id=<%= filters.plan_id %>&search=<%= filters.search %>">Next</a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>