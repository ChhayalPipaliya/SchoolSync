<%- include('../../partials/head') %>
<title><%= title %></title>
<style>
    .sub-detail-wrap { padding: 1.5rem 2rem; display: flex; flex-direction: column; gap: 1.25rem; }
    .sub-top-bar { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .sub-back-link { font-size: 13px; color: var(--color-primary, #2563EB); display: flex; align-items: center; gap: 5px; text-decoration: none; margin-bottom: 4px; }
    .sub-back-link:hover { text-decoration: underline; }
    .sub-page-title { font-size: 22px; font-weight: 600; color: #1a1a2e; line-height: 1.2; }
    .sub-page-sub { font-size: 13px; color: #6b7280; margin-top: 3px; }
    .sub-action-group { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .sub-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 500; border: 1px solid #e5e7eb; background: #fff; color: #374151; cursor: pointer; white-space: nowrap; transition: all 0.15s; text-decoration: none; }
    .sub-btn:hover { background: #f9fafb; }
    .sub-btn-danger { background: #fef2f2; border-color: #fecaca; color: #dc2626; }
    .sub-btn-danger:hover { background: #fee2e2; }
    .sub-btn-accent { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; }
    .sub-btn-accent:hover { background: #dbeafe; }
    .sub-btn-success { background: #f0fdf4; border-color: #bbf7d0; color: #16a34a; }
    .sub-btn-success:hover { background: #dcfce7; }
    .sub-grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
    .sub-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .sub-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.25rem; }
    .sub-card-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #9ca3af; margin-bottom: 10px; display: flex; align-items: center; gap: 5px; }
    .sub-school-name { font-size: 17px; font-weight: 600; color: #111827; margin-bottom: 2px; }
    .sub-school-domain { font-size: 13px; color: #2563eb; margin-bottom: 1rem; }
    .sub-meta-row { display: flex; gap: 6px; align-items: baseline; font-size: 13px; margin-bottom: 5px; }
    .sub-meta-key { color: #9ca3af; min-width: 68px; flex-shrink: 0; }
    .sub-meta-val { color: #374151; }
    .sub-plan-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 99px; font-size: 12px; font-weight: 500; margin-bottom: 10px; }
    .sub-badge-active { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
    .sub-badge-trial { background: #fffbeb; color: #d97706; border: 1px solid #fde68a; }
    .sub-badge-expired { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .sub-badge-cancelled { background: #f3f4f6; color: #6b7280; border: 1px solid #e5e7eb; }
    .sub-plan-name { font-size: 15px; font-weight: 600; color: #111827; margin-bottom: 10px; }
    .sub-stat-mini { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .sub-stat-item { background: #f9fafb; border-radius: 8px; padding: 10px 12px; }
    .sub-stat-lbl { font-size: 11px; color: #9ca3af; margin-bottom: 3px; }
    .sub-stat-val { font-size: 14px; font-weight: 600; color: #111827; }
    .sub-resource-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.25rem; }
    .sub-rc-header { display: flex; align-items: center; gap: 8px; margin-bottom: 1.25rem; }
    .sub-rc-title { font-size: 13px; font-weight: 600; color: #374151; }
    .sub-r-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
    .sub-r-name { font-size: 13px; font-weight: 500; color: #374151; }
    .sub-r-count { font-size: 12px; color: #9ca3af; margin-top: 4px; }
    .sub-r-pct { font-size: 12px; font-weight: 600; }
    .sub-track { height: 6px; background: #f3f4f6; border-radius: 99px; overflow: hidden; }
    .sub-bar { height: 100%; border-radius: 99px; }
    .sub-bar-blue { background: #2563EB; }
    .sub-bar-green { background: #059669; }
    .sub-bar-amber { background: #D97706; }
    .sub-pct-blue { color: #2563EB; }
    .sub-pct-green { color: #059669; }
    .sub-pct-amber { color: #D97706; }
    .sub-bottom-grid { display: grid; grid-template-columns: 1fr 300px; gap: 1rem; align-items: start; }
    .sub-section-hdr { display: flex; align-items: center; gap: 7px; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid #f3f4f6; }
    .sub-section-title { font-size: 13px; font-weight: 600; color: #374151; }
    .sub-tbl { width: 100%; font-size: 13px; border-collapse: collapse; }
    .sub-tbl th { font-size: 11px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; padding: 0 0 10px; border-bottom: 1px solid #f3f4f6; text-align: left; }
    .sub-tbl td { padding: 11px 0; border-bottom: 1px solid #f3f4f6; color: #6b7280; vertical-align: middle; }
    .sub-tbl tr:last-child td { border-bottom: none; }
    .sub-tbl-badge { display: inline-block; padding: 2px 9px; border-radius: 99px; font-size: 11px; font-weight: 500; }
    .sub-tbl-badge-paid { background: #f0fdf4; color: #16a34a; }
    .sub-tbl-badge-unpaid { background: #fef2f2; color: #dc2626; }
    .sub-tbl-badge-completed { background: #f0fdf4; color: #16a34a; }
    .sub-tbl-badge-failed { background: #fef2f2; color: #dc2626; }
    .sub-empty { text-align: center; color: #9ca3af; padding: 1.5rem 0; font-size: 13px; }
    .sub-dl-btn { font-size: 12px; color: #2563eb; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #bfdbfe; padding: 3px 9px; border-radius: 6px; background: #eff6ff; }
    .sub-dl-btn:hover { background: #dbeafe; }
    .sub-tl { list-style: none; position: relative; padding-left: 1.5rem; }
    .sub-tl::before { content: ''; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 1px; background: #e5e7eb; }
    .sub-tl-item { position: relative; padding-bottom: 1.25rem; }
    .sub-tl-item:last-child { padding-bottom: 0; }
    .sub-tl-dot { position: absolute; left: -1.5rem; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: #2563eb; border: 2px solid #fff; box-shadow: 0 0 0 1px #bfdbfe; }
    .sub-tl-date { font-size: 11px; color: #9ca3af; margin-bottom: 2px; }
    .sub-tl-action { font-size: 13px; font-weight: 600; color: #111827; margin-bottom: 2px; }
    .sub-tl-desc { font-size: 12px; color: #6b7280; }
    .sub-tl-empty { color: #9ca3af; font-size: 13px; text-align: center; padding: 1.5rem 0; }
    @media (max-width: 768px) {
        .sub-detail-wrap { padding: 1rem; }
        .sub-grid-3 { grid-template-columns: 1fr; gap: 1rem; }
        .sub-bottom-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar') %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <%- include('../../partials/flashMessages') %>
        <div class="sub-detail-wrap">
            <% const isTrialSubscription = String(subscription.status || '').toLowerCase() === 'trial' || String(subscription.plan_name || '').toLowerCase() === 'trial'; %>
            <div class="sub-top-bar">
                <div>
                    <a href="/superadmin/subscriptions" class="sub-back-link">
                        <i class="fas fa-arrow-left"></i> Subscriptions
                    </a>
                    <div class="sub-page-title">School subscription status</div>
                    <div class="sub-page-sub"><%= subscription.school_name %> &middot; ID #<%= subscription.id %></div>
                </div>
                <div class="sub-action-group">
                    <% if (subscription.status === 'active' || subscription.status === 'trial') { %>
                        <button type="button" class="sub-btn sub-btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="fas fa-ban"></i> Cancel
                        </button>
                        <% if (!isTrialSubscription) { %>
                        <button type="button" class="sub-btn sub-btn-accent" data-bs-toggle="modal" data-bs-target="#changePlanModal">
                            <i class="fas fa-exchange-alt"></i> Change plan
                        </button>
                        <button type="button" class="sub-btn" data-bs-toggle="modal" data-bs-target="#renewModal">
                            <i class="fas fa-sync-alt"></i> Renew / extend
                        </button>
                        <% } %>
                    <% } %>
                    <button type="button" class="sub-btn sub-btn-success" data-bs-toggle="modal" data-bs-target="#generateInvoiceModal">
                        <i class="fas fa-file-invoice-dollar"></i> Generate invoice
                    </button>
                </div>
            </div>
            <div class="sub-grid-2">
                <div class="sub-card">
                    <div class="sub-card-label"><i class="fas fa-school"></i> School info</div>
                    <div class="sub-school-name"><%= subscription.school_name %></div>
                    <div class="sub-school-domain">
                        <a href="http://<%= subscription.subdomain %>.schoolsync.com" target="_blank" style="color:#2563eb;text-decoration:none;">
                            <%= subscription.subdomain %>.schoolsync.com
                        </a>
                    </div>
                    <div class="sub-meta-row"><span class="sub-meta-key">Email</span><span class="sub-meta-val"><%= subscription.school_email || '—' %></span></div>
                    <div class="sub-meta-row"><span class="sub-meta-key">Phone</span><span class="sub-meta-val"><%= subscription.school_phone || '—' %></span></div>
                    <div class="sub-meta-row"><span class="sub-meta-key">Location</span><span class="sub-meta-val"><%= subscription.city || '—' %>, <%= subscription.state || '—' %></span></div>
                </div>
                <div class="sub-card">
                    <div class="sub-card-label"><i class="fas fa-credit-card"></i> Subscription plan</div>
                    <% if (subscription.status === 'active') { %>
                        <span class="sub-plan-badge sub-badge-active"><i class="fas fa-check-circle"></i> Active</span>
                    <% } else if (subscription.status === 'trial') { %>
                        <span class="sub-plan-badge sub-badge-trial"><i class="fas fa-clock"></i> Trial</span>
                    <% } else if (subscription.status === 'expired') { %>
                        <span class="sub-plan-badge sub-badge-expired"><i class="fas fa-times-circle"></i> Expired</span>
                    <% } else { %>
                        <span class="sub-plan-badge sub-badge-cancelled"><i class="fas fa-ban"></i> Cancelled</span>
                    <% } %>
                    <div class="sub-plan-name"><%= subscription.plan_name %> <%= subscription.billing_cycle === 'yearly' ? 'yearly' : 'monthly' %> plan</div>
                    <div class="sub-stat-mini">
                        <div class="sub-stat-item">
                            <div class="sub-stat-lbl">Billing cycle</div>
                            <div class="sub-stat-val" style="text-transform:capitalize"><%= subscription.billing_cycle || 'Monthly' %></div>
                        </div>
                        <div class="sub-stat-item">
                            <div class="sub-stat-lbl">Billing price</div>
                            <div class="sub-stat-val">₹<%= Number(subscription.price).toLocaleString('en-IN') %></div>
                        </div>
                        <div class="sub-stat-item">
                            <div class="sub-stat-lbl">Start date</div>
                            <div class="sub-stat-val"><%= new Date(subscription.start_date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
                        </div>
                        <div class="sub-stat-item">
                            <div class="sub-stat-lbl">End date</div>
                            <div class="sub-stat-val"><%= new Date(subscription.end_date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
                        </div>
                    </div>
                </div>
            </div>
            <% 
                const getPercent = (used, max) => {
                    if (!max) return 0;
                    return Math.min(100, Math.ceil((used / max) * 100));
                };
                const sPct = subscription.max_students ? getPercent(usage.students, subscription.max_students) : 0;
                const tPct = subscription.max_teachers ? getPercent(usage.teachers, subscription.max_teachers) : 0;
                const cPct = subscription.max_classes ? getPercent(usage.classes, subscription.max_classes) : 0;
            %>
            <div class="sub-resource-card">
                <div class="sub-rc-header">
                    <i class="fas fa-chart-pie" style="color:#9ca3af;font-size:14px"></i>
                    <span class="sub-rc-title">Resource limits & usage</span>
                </div>
                <div class="sub-grid-3">
                    <div class="sub-resource-row">
                        <div class="sub-r-top">
                            <span class="sub-r-name">Students registered</span>
                            <span class="sub-r-pct sub-pct-blue"><%= sPct %>%</span>
                        </div>
                        <div class="sub-track">
                            <div class="sub-bar sub-bar-blue" style="width:'<%= sPct %>'"></div>
                        </div>
                        <div class="sub-r-count"><%= usage.students %> / <%= subscription.max_students ? subscription.max_students.toLocaleString('en-IN') : 'Unlimited' %></div>
                    </div>
                    <div class="sub-resource-row">
                        <div class="sub-r-top">
                            <span class="sub-r-name">Teachers employed</span>
                            <span class="sub-r-pct sub-pct-green"><%= tPct %>%</span>
                        </div>
                        <div class="sub-track">
                            <div class="sub-bar sub-bar-green" style="width:'<%= tPct %>'"></div>
                        </div>
                        <div class="sub-r-count"><%= usage.teachers %> / <%= subscription.max_teachers ? subscription.max_teachers.toLocaleString('en-IN') : 'Unlimited' %></div>
                    </div>
                    <div class="sub-resource-row">
                        <div class="sub-r-top">
                            <span class="sub-r-name">Active classes</span>
                            <span class="sub-r-pct sub-pct-amber"><%= cPct %>%</span>
                        </div>
                        <div class="sub-track">
                            <div class="sub-bar sub-bar-amber" style="width:'<%= cPct %>'"></div>
                        </div>
                        <div class="sub-r-count"><%= usage.classes %> / <%= subscription.max_classes ? subscription.max_classes.toLocaleString('en-IN') : 'Unlimited' %></div>
                    </div>
                </div>
            </div>
            <div class="sub-bottom-grid">
                <div style="display:flex;flex-direction:column;gap:1rem">
                    <div class="sub-card">
                        <div class="sub-section-hdr">
                            <i class="fas fa-file-invoice" style="color:#9ca3af;font-size:14px"></i>
                            <span class="sub-section-title">Invoices</span>
                        </div>
                        <table class="sub-tbl">
                            <thead>
                                <tr>
                                    <th>Invoice no</th>
                                    <th>Amount</th>
                                    <th>Due date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (invoices && invoices.length > 0) { %>
                                    <% invoices.forEach(inv => { %>
                                        <tr>
                                            <td style="color:#111827;font-weight:600"><%= inv.invoice_no %></td>
                                            <td style="color:#111827">₹<%= Number(inv.amount).toLocaleString('en-IN') %></td>
                                            <td><%= new Date(inv.due_date).toLocaleDateString('en-IN') %></td>
                                            <td>
                                                <span class="sub-tbl-badge <%= inv.status === 'paid' ? 'sub-tbl-badge-paid' : 'sub-tbl-badge-unpaid' %>">
                                                    <%= inv.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="/superadmin/billing/invoices/<%= inv.id %>/pdf" class="sub-dl-btn" target="_blank">
                                                    <i class="fas fa-download"></i> PDF
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="5" class="sub-empty">No invoices generated yet.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <div class="sub-card">
                        <div class="sub-section-hdr">
                            <i class="fas fa-history" style="color:#9ca3af;font-size:14px"></i>
                            <span class="sub-section-title">Payment history</span>
                        </div>
                        <table class="sub-tbl">
                            <thead>
                                <tr>
                                    <th>Amount</th>
                                    <th>Ref number</th>
                                    <th>Method</th>
                                    <th>Payment date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (payments && payments.length > 0) { %>
                                    <% payments.forEach(p => { %>
                                        <tr>
                                            <td style="color:#111827;font-weight:600">₹<%= Number(p.amount).toLocaleString('en-IN') %></td>
                                            <td><code style="font-size:12px;color:#6b7280"><%= p.payment_ref || '—' %></code></td>
                                            <td style="text-transform:uppercase;font-size:12px"><%= p.method || '—' %></td>
                                            <td><%= new Date(p.paid_at || p.created_at).toLocaleDateString('en-IN') %></td>
                                            <td>
                                                <span class="sub-tbl-badge sub-tbl-badge-<%= p.status === 'paid' || p.status === 'completed' ? 'completed' : 'failed' %>">
                                                    <%= p.status %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr><td colspan="5" class="sub-empty">No payments captured.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="sub-card">
                    <div class="sub-section-hdr">
                        <i class="fas fa-stream" style="color:#9ca3af;font-size:14px"></i>
                        <span class="sub-section-title">School log timeline</span>
                    </div>
                    <% if (activityLogs && activityLogs.length > 0) { %>
                        <ul class="sub-tl">
                            <% activityLogs.forEach(log => { %>
                                <li class="sub-tl-item">
                                    <div class="sub-tl-dot"></div>
                                    <div class="sub-tl-date"><%= new Date(log.created_at).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) %></div>
                                    <div class="sub-tl-action"><%= log.action %></div>
                                    <div class="sub-tl-desc"><%= log.description %></div>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <p class="sub-tl-empty">No activity logs recorded.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>

<div class="modal fade" id="renewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form action="/superadmin/subscriptions/<%= subscription.id %>/renew" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Renew / Extend Subscription</h5>
                    <button class="close" type="button" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Renewal Term</label>
                        <select name="months" class="form-control">
                            <option value="1">1 Month</option>
                            <option value="3">3 Months</option>
                            <option value="6">6 Months</option>
                            <option value="12" selected>12 Months (1 Year)</option>
                        </select>
                    </div>
                    <p class="text-muted small">This action will extend the subscription end date and set the billing state to active.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Renew Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="changePlanModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form action="/superadmin/subscriptions/<%= subscription.id %>/change-plan" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Change School Plan</h5>
                    <button class="close" type="button" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Select New Plan</label>
                        <select name="plan_id" class="form-control" required>
                            <% plans.filter(p => String(p.plan_key || p.slug || p.name || '').toLowerCase() !== 'trial').forEach(p => { %>
                                <option value="<%= p.id %>" <%= subscription.plan_id === p.id ? 'selected' : '' %>><%= p.name %> (₹<%= p.monthly_price %>/mo)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Billing Cycle</label>
                        <select name="billing_cycle" class="form-control">
                            <option value="monthly" <%= subscription.billing_cycle === 'monthly' ? 'selected' : '' %>>Monthly</option>
                            <option value="yearly" <%= subscription.billing_cycle === 'yearly' ? 'selected' : '' %>>Yearly</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Apply Change</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form action="/superadmin/subscriptions/<%= subscription.id %>/cancel" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Cancel Subscription</h5>
                    <button class="close" type="button" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Cancellation Reason</label>
                        <textarea class="form-control" name="reason" rows="3" required placeholder="Provide reason for cancellation..."></textarea>
                    </div>
                    <p class="text-danger small font-weight-bold"><i class="fas fa-exclamation-triangle mr-1"></i> Warning: This will immediately set the school portal status to inactive.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Back</button>
                    <button class="btn btn-danger" type="submit">Cancel Subscription</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="generateInvoiceModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form action="/superadmin/subscriptions/<%= subscription.id %>/generate-invoice" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Generate Manual Invoice</h5>
                    <button class="close" type="button" data-bs-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Invoice Amount</label>
                        <input type="number" step="0.01" class="form-control" name="amount" required value="<%= subscription.price %>">
                    </div>
                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Due Date</label>
                        <input type="date" class="form-control" name="due_date" required value="<%= new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0] %>">
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-success" type="submit">Create Invoice</button>
                </div>
            </form>
        </div>
    </div>
</div>