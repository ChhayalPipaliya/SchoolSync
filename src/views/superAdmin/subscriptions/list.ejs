<%- include('../../partials/head') %>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/subscriptions' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding:0;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; padding:24px 24px 0; flex-wrap:wrap; gap:12px;">
                <div>
                    <h1 style="font-size:20px; font-weight:700; color:#0F172A; margin:0;">Subscriptions</h1>
                    <p style="font-size:12px; color:#94A3B8; margin:4px 0 0;">Manage and track school platform subscriptions</p>
                </div>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div style="padding:0 24px 16px;">
                <div class="card" style="padding:16px; margin-bottom:0;">
                    <form method="GET" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
                        <div class="form-group" style="margin-bottom:0; width:200px;">
                            <label class="form-label" style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">Status</label>
                            <select name="status" class="form-select" style="min-height:38px;">
                                <option value="">All Status</option>
                                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="trial" <%= filters.status === 'trial' ? 'selected' : '' %>>Trial</option>
                                <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>Expired</option>
                                <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0; width:200px;">
                            <label class="form-label" style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">School</label>
                            <select name="school_id" class="form-select" style="min-height:38px;">
                                <option value="">All Schools</option>
                                <% schools.forEach(s => { %>
                                    <option value="<%= s.id %>" <%= filters.school_id == s.id ? 'selected' : '' %>><%= s.school_name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div style="display:flex; gap:8px;">
                            <button type="submit" class="btn btn-primary" style="height:38px; padding:0 16px; font-size:13px;">Filter</button>
                            <a href="/superadmin/subscriptions" class="btn btn-secondary" style="height:38px; padding:0 16px; font-size:13px; text-decoration:none; display:inline-flex; align-items:center;">Reset</a>
                        </div>
                    </form>
                </div>
            </div>
            <div style="padding:0 24px 24px;">
                <div class="card">
                    <div class="card-body" style="padding:0; overflow-x:auto;">
                        <table class="table" style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">School</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Plan</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:right;">Price</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Start Date</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">End Date</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center;">Status</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center;">Payment</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center; width:120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(!subscriptions || subscriptions.length === 0) { %>
                                    <tr>
                                        <td colspan="8" style="padding:14px 16px; font-size:13px; border-bottom:1px solid #F1F5F9; text-align:center; color:#94A3B8;">
                                            <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:24px 0;">
                                                <i class="fa-solid fa-credit-card fa-2x" style="color:#CBD5E1;"></i>
                                                <span>No subscriptions found matching your query.</span>
                                            </div>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% subscriptions.forEach(sub => {
                                        const planStyle = sub.plan === 'enterprise' || sub.plan === 'premium' ? 'background:#FEF3C7; color:#D97706;' : 'background:#DBEAFE; color:#2563EB;';
                                        const statusStyle = sub.status === 'active' ? 'background:#D1FAE5; color:#065F46; border-color:#A7F3D0;' : sub.status === 'expired' ? 'background:#FEE2E2; color:#991B1B; border-color:#FCA5A5;' : sub.status === 'cancelled' ? 'background:#F1F5F9; color:#475569; border-color:#E2E8F0;' : 'background:#FEF3C7; color:#92400E; border-color:#FDE68A;';
                                        const paymentStyle = sub.payment_status === 'paid' ? 'background:#D1FAE5; color:#065F46; border-color:#A7F3D0;' : 'background:#FEF3C7; color:#92400E; border-color:#FDE68A;';
                                    %>
                                        <tr style="border-bottom:1px solid #F1F5F9; transition:background 0.15s;" onmouseover="this.style.background='#F8FAFC'" onmouseout="this.style.background=''">
                                            <td style="padding:14px 16px; font-size:13px; font-weight:600; color:#1E293B; vertical-align:middle;"><%= sub.school_name %></td>
                                            <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                                <span <%= `style="display:inline-flex; align-items:center; padding:2px 8px; border-radius:99px; font-size:10px; font-weight:700; text-transform:uppercase; ${planStyle}"` %>>
                                                    <%= sub.plan_name %>
                                                </span>
                                            </td>
                                            <td style="padding:14px 16px; font-size:13px; font-weight:700; color:#334155; text-align:right; vertical-align:middle;">₹<%= sub.price %></td>
                                            <td style="padding:14px 16px; font-size:13px; color:#475569; vertical-align:middle;"><%= new Date(sub.start_date).toLocaleDateString('en-IN') %></td>
                                            <td style="padding:14px 16px; font-size:13px; color:#475569; vertical-align:middle;"><%= new Date(sub.end_date).toLocaleDateString('en-IN') %></td>
                                            <td style="padding:14px 16px; font-size:13px; text-align:center; vertical-align:middle;">
                                                <span <%= `style="display:inline-flex; align-items:center; padding:2px 8px; border-radius:99px; font-size:10px; font-weight:700; text-transform:uppercase; border:1px solid; ${statusStyle}"` %>>
                                                    <%= sub.status %>
                                                </span>
                                            </td>
                                            <td style="padding:14px 16px; font-size:13px; text-align:center; vertical-align:middle;">
                                                <span <%= `style="display:inline-flex; align-items:center; padding:2px 8px; border-radius:99px; font-size:10px; font-weight:700; text-transform:uppercase; border:1px solid; ${paymentStyle}"` %>>
                                                    <%= sub.payment_status %>
                                                </span>
                                            </td>
                                            <td style="padding:14px 16px; font-size:13px; text-align:center; vertical-align:middle;">
                                                <div style="display:flex; align-items:center; justify-content:center; gap:6px;">
                                                    <a href="/superadmin/subscriptions/<%= sub.id %>" class="btn-icon" title="View Details">
                                                        <i class="fa-solid fa-eye"></i>
                                                    </a>
                                                    <% if(sub.status === 'active' || sub.status === 'trial') { %>
                                                        <form action="/superadmin/subscriptions/<%= sub.id %>/renew" method="POST" style="margin:0; display:inline-block;">
                                                            <button type="submit" class="btn-icon" style="color: #10b981; border:none;" title="Renew">
                                                                <i class="fa-solid fa-arrows-rotate"></i>
                                                            </button>
                                                        </form>
                                                        <form action="/superadmin/subscriptions/<%= sub.id %>/cancel" method="POST" style="margin:0; display:inline-block;" onsubmit="return confirm('Cancel this subscription?');">
                                                            <button type="submit" class="btn-icon btn-danger-icon" title="Cancel" style="border:none;">
                                                                <i class="fa-solid fa-ban"></i>
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <% if(pagination.totalPages > 1) { %>
                        <div class="pagination-wrapper" style="padding:16px; border-top:1px solid #E2E8F0; display:flex; justify-content:flex-end;">
                            <nav aria-label="Page navigation">
                                <div class="pagination" style="display:flex; gap:4px;">
                                    <% if (pagination.hasPrev) { %>
                                        <a class="pagination-btn" href="?page=<%= pagination.page - 1 %>&status=<%= filters.status %>&school_id=<%= filters.school_id %>" style="padding:6px 12px; border:1px solid #E2E8F0; border-radius:6px; text-decoration:none;">
                                            <i class="fa-solid fa-angle-left"></i>
                                        </a>
                                    <% } else { %>
                                        <span class="pagination-btn disabled" style="padding:6px 12px; border:1px solid #E2E8F0; border-radius:6px; opacity:0.5;"><i class="fa-solid fa-angle-left"></i></span>
                                    <% } %>

                                    <% for(let i=1; i <= pagination.totalPages; i++) { %>
                                        <% if (pagination.page === i) { %>
                                            <span class="pagination-btn active" style="padding:6px 12px; background:#2563EB; color:#fff; border-radius:6px; font-weight:700;"><%= i %></span>
                                        <% } else { %>
                                            <a class="pagination-btn" href="?page=<%= i %>&status=<%= filters.status %>&school_id=<%= filters.school_id %>" style="padding:6px 12px; border:1px solid #E2E8F0; border-radius:6px; text-decoration:none;">
                                                <%= i %>
                                            </a>
                                        <% } %>
                                    <% } %>

                                    <% if (pagination.hasNext) { %>
                                        <a class="pagination-btn" href="?page=<%= pagination.page + 1 %>&status=<%= filters.status %>&school_id=<%= filters.school_id %>" style="padding:6px 12px; border:1px solid #E2E8F0; border-radius:6px; text-decoration:none;">
                                            <i class="fa-solid fa-angle-right"></i>
                                        </a>
                                    <% } else { %>
                                        <span class="pagination-btn disabled" style="padding:6px 12px; border:1px solid #E2E8F0; border-radius:6px; opacity:0.5;"><i class="fa-solid fa-angle-right"></i></span>
                                    <% } %>
                                </div>
                            </nav>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>