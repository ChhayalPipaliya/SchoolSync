<!DOCTYPE html>
<html lang="<%= (typeof currentLang !== 'undefined' && currentLang) ? currentLang : 'en' %>" data-theme="light">
<head>
  <%- include('../partials/head', {
    title: typeof title !== 'undefined' ? title + ' | SchoolSync' : `${lan.Super_Admin || 'Super Admin'} | SchoolSync`,
    needsCharts: typeof needsCharts !== 'undefined' ? needsCharts : false
  }) %>
</head>
<body class="superadmin-theme">
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../partials/header', { searchPlaceholder: lan.Search_Schools_Users_Placeholder || 'Search schools, users…' }) %>
    <%- include('../partials/flashMessages') %>
    <div class="page-body">
      <%- body %>
    </div>
    <%- include('../partials/footer') %>
  </main>
</div>
</body>
</html>