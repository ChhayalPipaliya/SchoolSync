<%- include('../../partials/head', { title: `${group ? (lan.Edit_School_Group || 'Edit School Group') : (lan.Add_School_Group || 'Add School Group')} | SchoolSync` }) %>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/school-groups' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 dark:text-slate-100 tracking-tight"><%= group ? (lan.Edit_School_Group || 'Edit School Group') : (lan.Add_School_Group || 'Add School Group') %></h2>
                    <p class="text-xs text-gray-500 dark:text-slate-400 mt-1"><%- lan.School_Group_Form_Sub || 'Configure group-level profile information for branch management' %></p>
                </div>
                <a href="/superadmin/school-groups" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1"></i> <%- lan.Back_To_List || 'Back to List' %>
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card">
                <div class="card-header bg-slate-50/20">
                    <h3 class="card-title flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-blue-600"></i> <%- lan.Group_Details || 'Group Details' %>
                    </h3>
                </div>
                <div class="card-body p-6">
                    <form action="<%= group ? `/superadmin/school-groups/${group.id}` : '/superadmin/school-groups' %>" method="POST" data-validate-form>
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <h5 class="text-sm font-bold text-gray-800 dark:text-slate-100 uppercase tracking-wider border-b border-gray-100 dark:border-slate-800 pb-2 mb-4">
                            <i class="fa-solid fa-address-card text-blue-600 mr-1"></i> <%- lan.Basic_Information || 'Basic Information' %>
                        </h5>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label><%- lan.Group_Name || 'Group Name' %> <span class="text-danger">*</span></label>
                                    <input type="text" name="group_name" class="form-input" value="<%= group ? group.group_name : '' %>" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label><%- lan.Owner_Name || 'Owner Name' %></label>
                                    <input type="text" name="owner_name" class="form-input" value="<%= group ? (group.owner_name || '') : '' %>">
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label><%- lan.Email || 'Email' %></label>
                                    <input type="email" name="email" class="form-input" value="<%= group ? (group.email || '') : '' %>">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label><%- lan.Phone || 'Phone' %></label>
                                    <input type="tel" name="phone" class="form-input" value="<%= group ? (group.phone || '') : '' %>">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label><%- lan.City || 'City' %></label>
                                    <input type="text" name="city" class="form-input" value="<%= group ? (group.city || '') : '' %>">
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label><%- lan.Address || 'Address' %></label>
                                    <textarea name="address" class="form-input" rows="3"><%= group ? (group.address || '') : '' %></textarea>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label><%- lan.Status || 'Status' %></label>
                                    <select name="status" class="form-input custom-select">
                                        <option value="active" <%= !group || group.status === 'active' ? 'selected' : '' %>><%- lan.Active || 'Active' %></option>
                                        <option value="inactive" <%= group && group.status === 'inactive' ? 'selected' : '' %>><%- lan.Inactive || 'Inactive' %></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 pt-2 d-flex justify-content-end align-items-center">
                            <a href="/superadmin/school-groups" class="btn btn-cancel mr-3"><%- lan.Cancel || 'Cancel' %></a>
                            <button type="submit" class="btn btn-primary btn-submit text-white">
                                <i class="fas fa-save mr-2"></i> <%= group ? (lan.Update_Group || 'Update Group') : (lan.Create_Group || 'Create Group') %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
</div>
        <%- include('../../partials/footer') %>
        </div>
</div>
