<%- include('../../partials/head') %>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/school-groups' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= group ? 'Edit School Group' : 'Add School Group' %></h2>
                    <p class="text-xs text-gray-500 mt-1">Configure group-level profile information for branch management</p>
                </div>
                <a href="/superadmin/school-groups" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to List
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card">
                <div class="card-header bg-slate-50/20">
                    <h3 class="card-title flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-blue-600"></i> Group Details
                    </h3>
                </div>
                <div class="card-body p-6">
                    <form action="<%= group ? `/superadmin/school-groups/${group.id}` : '/superadmin/school-groups' %>" method="POST" data-validate-form>
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <h5 class="text-sm font-bold text-gray-800 uppercase tracking-wider border-b border-gray-100 pb-2 mb-4">
                            <i class="fa-solid fa-address-card text-blue-600 mr-1"></i> Basic Information
                        </h5>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Group Name <span class="text-danger">*</span></label>
                                    <input type="text" name="group_name" class="form-input" value="<%= group ? group.group_name : '' %>" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Owner Name</label>
                                    <input type="text" name="owner_name" class="form-input" value="<%= group ? (group.owner_name || '') : '' %>">
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Email</label>
                                    <input type="email" name="email" class="form-input" value="<%= group ? (group.email || '') : '' %>">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Phone</label>
                                    <input type="tel" name="phone" class="form-input" value="<%= group ? (group.phone || '') : '' %>">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>City</label>
                                    <input type="text" name="city" class="form-input" value="<%= group ? (group.city || '') : '' %>">
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label>Address</label>
                                    <textarea name="address" class="form-input" rows="3"><%= group ? (group.address || '') : '' %></textarea>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Status</label>
                                    <select name="status" class="form-input custom-select">
                                        <option value="active" <%= !group || group.status === 'active' ? 'selected' : '' %>>Active</option>
                                        <option value="inactive" <%= group && group.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="mt-5 pt-4 border-top d-flex justify-content-end align-items-center">
                            <a href="/superadmin/school-groups" class="btn btn-cancel mr-3">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-submit text-white">
                                <i class="fas fa-save mr-2"></i> <%= group ? 'Update Group' : 'Create Group' %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>