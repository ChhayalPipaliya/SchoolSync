<%- include('../../partials/head') %>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/school-groups' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content" style="padding:0;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; padding:24px 24px 0; flex-wrap:wrap; gap:12px;">
                <div>
                    <h1 style="font-size:20px; font-weight:700; color:#0F172A; margin:0;">School Groups</h1>
                    <p style="font-size:12px; color:#94A3B8; margin:4px 0 0;">Manage brands, trusts, and branch ownership</p>
                </div>
                <div style="display:flex; gap:10px;">
                    <a href="/superadmin/school-groups/add" class="btn btn-primary" style="font-size:13px; padding:8px 16px;">
                        <i class="fa-solid fa-plus"></i> Add Group
                    </a>
                </div>
            </div>

            <%- include('../../partials/flashMessages') %>

            <div style="padding:0 24px 24px;">
                <div class="card">
                    <div class="card-body" style="padding:0; overflow-x:auto;">
                        <table class="table" style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Group Name</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Owner</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">City</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center;">Total Branches</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center;">Status</th>
                                    <th style="padding:10px 12px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!groups || groups.length === 0) { %>
                                    <tr>
                                        <td colspan="6" style="padding:10px 12px; font-size:13px; border-bottom:1px solid #F1F5F9; text-align:center; color:#94A3B8;">
                                            <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:24px 0;">
                                                <i class="fa-solid fa-layer-group fa-2x" style="color:#CBD5E1;"></i>
                                                <span>No school groups found.</span>
                                            </div>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% groups.forEach(group => { %>
                                        <tr style="border-bottom:1px solid #F1F5F9; transition:background 0.15s;" onmouseover="this.style.background='#F8FAFC'" onmouseout="this.style.background=''">
                                            <td style="padding:10px 12px; font-size:13px;">
                                                <div style="display:flex; align-items:center; gap:12px;">
                                                    <div style="width:36px; height:36px; background:#EFF6FF; color:#2563EB; border-radius:8px; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px; flex-shrink:0;">
                                                        <%= (group.group_name || 'G').charAt(0).toUpperCase() %>
                                                    </div>
                                                    <div style="min-width:0;">
                                                        <div style="font-weight:700; color:#1E293B; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= group.group_name %></div>
                                                        <div style="font-size:10px; color:#94A3B8; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px;"><%= group.email || '' %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td style="padding:10px 12px; font-size:13px; color:#475569; vertical-align:middle;"><%= group.owner_name || '-' %></td>
                                            <td style="padding:10px 12px; font-size:13px; color:#475569; vertical-align:middle;"><%= group.city || '-' %></td>
                                            <td style="padding:10px 12px; font-size:13px; font-weight:700; color:#1E293B; text-align:center; vertical-align:middle;"><%= group.branch_count || 0 %></td>
                                            <td style="padding:10px 12px; font-size:13px; text-align:center; vertical-align:middle;">
                                                <span style="display:inline-flex; align-items:center; padding:2px 8px; border-radius:99px; font-size:10px; font-weight:700; text-transform:uppercase; border:1px solid;
                                                    <%= group.status === 'active' ? 'background:#D1FAE5; color:#065F46; border-color:#A7F3D0;' : 'background:#F1F5F9; color:#475569; border-color:#CBD5E1;' %>">
                                                    <%= group.status %>
                                                </span>
                                            </td>
                                            <td style="padding:10px 12px; font-size:13px; text-align:center; vertical-align:middle;">
                                                <div style="display:flex; align-items:center; justify-content:center; gap:6px;">
                                                    <a href="/superadmin/school-groups/<%= group.id %>/edit" class="btn-icon btn-edit-icon" title="Edit">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </a>
                                                    <form action="/superadmin/school-groups/<%= group.id %>/status" method="POST" style="margin:0; display:inline-block;">
                                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                        <button type="submit" class="btn-icon" style="<%= group.status === 'active' ? 'color:#64748B;' : 'color:#059669;' %>" title="<%= group.status === 'active' ? 'Deactivate' : 'Activate' %>">
                                                            <i class="fa-solid <%= group.status === 'active' ? 'fa-toggle-on' : 'fa-toggle-off' %>"></i>
                                                        </button>
                                                    </form>
                                                    <form action="/superadmin/school-groups/<%= group.id %>?_method=DELETE" method="POST" style="margin:0; display:inline-block;" onsubmit="return confirm('Are you sure you want to delete this school group?');">
                                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                        <button type="submit" class="btn-icon btn-danger-icon" title="Delete">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../../partials/footer') %>
    </div>
</div>
