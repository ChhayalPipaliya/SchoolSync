<%- include('../../partials/head') %>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/schools' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Add New School</h2>
                    <p class="text-xs text-gray-500 mt-1">Register a new school on the SchoolSync platform</p>
                </div>
                <a href="/superadmin/schools" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to List
                </a>
            </div>

            <%- include('../../partials/flashMessages') %>

            <div class="card">
                <div class="card-header bg-slate-50/20">
                    <h3 class="card-title flex items-center gap-2">
                        <i class="fa-solid fa-school text-blue-600"></i> School Profile Details
                    </h3>
                </div>
                <div class="card-body p-6">
                    <form action="/superadmin/schools" method="POST" id="schoolForm" enctype="multipart/form-data" data-validate-form>
  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                        <!-- Branch / Group Info -->
                        <h5 class="text-sm font-bold text-gray-800 uppercase tracking-wider border-b border-gray-100 pb-2 mb-4">
                            <i class="fa-solid fa-layer-group text-blue-600 mr-1"></i> Branch / Group Info
                        </h5>
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>School Group <span class="text-muted text-xs">(Optional)</span></label>
                                    <select name="school_group_id" class="form-input">
                                        <option value="">No Group / Standalone School</option>
                                        <% groups.forEach(g => { %>
                                            <option value="<%= g.id %>"><%= g.group_name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Branch Name</label>
                                    <input type="text" name="branch_name" class="form-input" placeholder="e.g. Katargam Branch">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Area</label>
                                    <input type="text" name="area" class="form-input" placeholder="e.g. Katargam">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Branch Code</label>
                                    <input type="text" name="branch_code" class="form-input" placeholder="e.g. GAJ-KAT">
                                </div>
                            </div>
                        </div>
                        
                        <!-- SECTION 1: Basic Information -->
                        <h5 class="text-sm font-bold text-gray-800 uppercase tracking-wider border-b border-gray-100 pb-2 mb-4">
                            <i class="fa-solid fa-address-card text-blue-600 mr-1"></i> Basic Information
                        </h5>
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>School Name <span class="text-danger">*</span></label>
                                                <input type="text" name="school_name" class="form-input" placeholder="Enter official school name" required>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Subdomain <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <input type="text" name="subdomain" class="form-input" placeholder="e.g. dps-Surat" required>
                                                    <span class="input-group-text bg-light text-muted font-weight-normal">.schoolsync.in</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-4 mb-4">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Phone Number</label>
                                                <input type="tel" name="school_phone" class="form-input" placeholder="+91 XXXXX XXXXX">
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Official Email <span class="text-danger">*</span></label>
                                                <input type="email" name="school_email" class="form-input" placeholder="admin@school.com" required>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Portal Password</label>
                                                <input type="password" name="password" class="form-input" placeholder="Default: School@123">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-4 mb-5">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Website URL</label>
                                                <input type="url" name="website" class="form-input" placeholder="https://example.com" data-validate="url">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Establishment Year</label>
                                                <input type="number" name="establishment_year" class="form-input" min="1800" max="2100" placeholder="e.g. 2005">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 2: School Details -->
                                    <h5 class="section-title mb-4 mt-2">
                                        <i class="fas fa-sliders-h text-primary mr-2"></i> Configuration & Structure
                                    </h5>
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label font-weight-bold mb-2">School Type <span class="text-danger">*</span></label>
                                            <div class="custom-checkbox-card">
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" name="school_type" value="Pre-Primary" class="form-check-input" id="type_pre">
                                                    <label class="form-check-label" for="type_pre">Pre-Primary</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" name="school_type" value="Primary" class="form-check-input" id="type_pri">
                                                    <label class="form-check-label" for="type_pri">Primary</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" name="school_type" value="Secondary" class="form-check-input" id="type_sec">
                                                    <label class="form-check-label" for="type_sec">Secondary</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" name="school_type" value="Higher Secondary" class="form-check-input" id="type_high">
                                                    <label class="form-check-label" for="type_high">Higher Secondary</label>
                                                </div>
                                                <div class="form-check">
                                                    <input type="checkbox" name="school_type" value="KG to 12" class="form-check-input" id="type_all">
                                                    <label class="form-check-label" for="type_all">KG to 12 Format</label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label font-weight-bold mb-2">Medium of Instruction <span class="text-danger">*</span></label>
                                            <div class="custom-checkbox-card">
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" name="medium" value="Gujarati" class="form-check-input" id="med_guj">
                                                    <label class="form-check-label" for="med_guj">Gujarati Medium</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" name="medium" value="English" class="form-check-input" id="med_eng">
                                                    <label class="form-check-label" for="med_eng">English Medium</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" name="medium" value="Hindi" class="form-check-input" id="med_hin">
                                                    <label class="form-check-label" for="med_hin">Hindi Medium</label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group mb-3">
                                                <label>Education Board</label>
                                                <select name="board" class="form-input custom-select">
                                                    <option value="GSEB">GSEB (Gujarat Board)</option>
                                                    <option value="CBSE">CBSE Board</option>
                                                    <option value="ICSE">ICSE Board</option>
                                                    <option value="Other">Other Board</option>
                                                </select>
                                            </div>
                                            <div class="form-group pt-1">
                                                <label>Gender Category</label>
                                                <select name="gender_type" class="form-input custom-select">
                                                    <option value="co-ed">Co-Educational</option>
                                                    <option value="boys">Boys Only</option>
                                                    <option value="girls">Girls Only</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-4 mb-4">
                                        <div class="col-md-12">
                                            <label class="form-label font-weight-bold mb-2">School Way / Timing <span class="text-danger">*</span></label>
                                            <div class="custom-checkbox-card" style="border: 1px solid #E2E8F0; padding: 15px; border-radius: 8px; background: #fff;">
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="school_way" value="morning" class="form-check-input school-way-check" id="way_morning">
                                                            <label class="form-check-label" for="way_morning">Morning School</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="school_way" value="evening" class="form-check-input school-way-check" id="way_evening">
                                                            <label class="form-check-label" for="way_evening">Evening School</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="school_way" value="full_day" class="form-check-input school-way-check" id="way_full_day" checked>
                                                            <label class="form-check-label" for="way_full_day">Full Day School</label>
                                                        </div>
                                                    </div>
                                                </div>
                                                <p class="text-xs text-gray-500 mb-0 mt-2">Transport route shift will use this timing by default.</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 3: Address Details -->
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>Full Address Mapping</label>
                                                <textarea name="school_address" class="form-input" rows="3" placeholder="Enter complete physical address..."></textarea>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-4 mb-5">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>City</label>
                                                <input type="text" name="city" class="form-input" placeholder="e.g. Surat">
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>State</label>
                                                <input type="text" name="state" class="form-input" placeholder="e.g. Gujarat">
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Pincode</label>
                                                <input type="text" name="pincode" class="form-input" placeholder="380001">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 4: Principal Information -->
                                    <h5 class="section-title mb-4">
                                        <i class="fas fa-user-tie text-primary mr-2"></i> Principal Operations
                                    </h5>
                                    <div class="row g-4 mb-5">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Principal Name</label>
                                                <input type="text" name="school_principal_name" class="form-input" placeholder="Full Name">
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Direct Email Address</label>
                                                <input type="email" name="school_principal_email" class="form-input" placeholder="principal@school.com">
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Contact Number</label>
                                                <input type="tel" name="school_principal_phone" class="form-input" placeholder="Personal Mobile No.">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 5: Registration & Compliance -->
                                    <h5 class="section-title mb-4">
                                        <i class="fas fa-file-invoice text-primary mr-2"></i> Registration & Statutory Compliance
                                    </h5>
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>UDISE Code</label>
                                                <input type="text" name="udise_code" class="form-input" placeholder="11-digit code">
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Affiliation Board</label>
                                                <select name="affiliation_board" class="form-input custom-select">
                                                    <option value="">Select Board</option>
                                                    <option value="GSEB">GSEB</option>
                                                    <option value="CBSE">CBSE</option>
                                                    <option value="ICSE">ICSE</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Affiliation Number</label>
                                                <input type="text" name="affiliation_number" class="form-input" placeholder="Reg No.">
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>School Reg. Number</label>
                                                <input type="text" name="school_registration_number" class="form-input" placeholder="Govt. License ID">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row g-4 mb-5">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>PAN Number</label>
                                                <input type="text" name="pan_number" class="form-input" placeholder="ABCDE1234F" style="text-transform: uppercase;">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>GST Number</label>
                                                <input type="text" name="gst_number" class="form-input" placeholder="24XXXXXXXXXXXXX" style="text-transform: uppercase;">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 6: Bank Ledger Details -->
                                    <h5 class="section-title mb-4">
                                        <i class="fas fa-university text-primary mr-2"></i> Settlement Bank Account
                                    </h5>
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Account Holder Name <span class="text-danger">*</span></label>
                                                <input type="text" name="account_holder_name" class="form-input" placeholder="Exact trust/school name" required>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Bank Name <span class="text-danger">*</span></label>
                                                <input type="text" name="bank_name" class="form-input" placeholder="e.g. HDFC Bank" required>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Account Number <span class="text-danger">*</span></label>
                                                <input type="text" name="account_number" class="form-input" placeholder="000000000000" required data-validate="numeric">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row g-4 mb-5">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>IFSC Code <span class="text-danger">*</span></label>
                                                <input type="text" name="ifsc_code" class="form-input" placeholder="HDFC0001234" required data-validate="ifsc" style="text-transform: uppercase;">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Branch Name</label>
                                                <input type="text" name="bank_branch_name" class="form-input" placeholder="Branch Location">
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 7: Document Control -->
                                    <h5 class="section-title mb-4">
                                        <i class="fas fa-cloud-upload-alt text-primary mr-2"></i> KYC Document Repository
                                    </h5>
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>School Logo (Brand)</label>
                                                <div class="file-upload-box"><input type="file" name="logo" class="form-input-file" accept="image/*"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Registration Certificate</label>
                                                <div class="file-upload-box"><input type="file" name="registration_certificate" class="form-input-file" accept=".pdf,image/*"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Affiliation Document</label>
                                                <div class="file-upload-box"><input type="file" name="affiliation_certificate" class="form-input-file" accept=".pdf,image/*"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row g-4 mb-5">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>UDISE Copy</label>
                                                <div class="file-upload-box"><input type="file" name="udise" class="form-input-file" accept=".pdf,image/*"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Official Address Proof</label>
                                                <div class="file-upload-box"><input type="file" name="address_proof" class="form-input-file" accept=".pdf,image/*"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Other Supporting Dossiers</label>
                                                <div class="file-upload-box"><input type="file" name="other_document" class="form-input-file" accept=".pdf,image/*"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- SECTION 8: SaaS Subscription Management -->
                                    <h5 class="section-title mb-4">
                                        <i class="fas fa-credit-card text-primary mr-2"></i> Platform Subscription Plan
                                    </h5>
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>Subscription Mode <span class="text-danger">*</span></label>
                                                <select name="subscription_start_mode" id="subscription_start_mode" class="form-input custom-select" required>
                                                    <option value="trial" selected>Start with 7-Day Full Access Demo</option>
                                                    <option value="direct_paid">Start directly with paid plan</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Paid Plan Configuration Fields -->
                                    <div id="paidPlanFields" style="display:none;" class="space-y-4">
                                        <div class="row g-4 mb-4">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>SaaS Plan Tier <span class="text-danger">*</span></label>
                                                    <select name="plan_id" id="plan_id_select" class="form-input custom-select">
                                                        <option value="">Select Corporate Plan</option>
                                                        <% plans.forEach(plan=> { %>
                                                            <option value="<%= plan.id %>">
                                                                <%= plan.name %> (₹<%= Number(plan.monthly_price || plan.price || 0).toLocaleString('en-IN') %>/mo · ₹<%= Number(plan.yearly_price || 0).toLocaleString('en-IN') %>/yr)
                                                            </option>
                                                        <% }) %>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Billing Cycle <span class="text-danger">*</span></label>
                                                    <select name="billing_cycle" class="form-input custom-select">
                                                        <option value="monthly" selected>Monthly Billing</option>
                                                        <option value="yearly">Yearly Billing</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Payment Status <span class="text-danger">*</span></label>
                                                    <select name="payment_status" class="form-input custom-select">
                                                        <option value="paid" selected>Paid / Completed</option>
                                                        <option value="pending">Pending / Unpaid</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row g-4 mb-4">
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Payment Method <span class="text-danger">*</span></label>
                                                    <select name="payment_method" class="form-input custom-select">
                                                        <option value="cash" selected>Cash</option>
                                                        <option value="upi">UPI</option>
                                                        <option value="bank_transfer">Bank Transfer</option>
                                                        <option value="razorpay">Razorpay</option>
                                                        <option value="online">Online</option>
                                                        <option value="cheque">Cheque</option>
                                                        <option value="other">Other</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Amount Paid (₹)</label>
                                                    <input type="number" step="0.01" name="amount_paid" class="form-input" placeholder="0.00">
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label>Payment Reference / Txn ID</label>
                                                    <input type="text" name="payment_reference" class="form-input" placeholder="Txn Number / Cheque No">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row g-4 mb-4">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    <label>Payment Note</label>
                                                    <textarea name="payment_note" class="form-input" rows="2" placeholder="Add payment note or details..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Interface -->
                                    <div class="mt-5 pt-4 border-top d-flex justify-content-end align-items-center">
                                        <a href="/superadmin/schools" class="btn btn-cancel mr-3">
                                            Discard
                                        </a>
                                        <button type="submit" class="btn btn-primary btn-submit text-white">
                                            <i class="fas fa-plus-circle mr-2"></i> Onboard School
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../../partials/footer') %>
    </div>
</div>

<script>
    // Toggle SaaS subscription setup section
    document.addEventListener("DOMContentLoaded", () => {
        const startModeSelect = document.getElementById("subscription_start_mode");
        const paidPlanFields = document.getElementById("paidPlanFields");
        const planIdSelect = document.getElementById("plan_id_select");

        function toggleFields() {
            if (startModeSelect.value === "direct_paid") {
                paidPlanFields.style.display = "block";
                planIdSelect.setAttribute("required", "required");
            } else {
                paidPlanFields.style.display = "none";
                planIdSelect.removeAttribute("required");
            }
        }

        startModeSelect.addEventListener("change", toggleFields);
        toggleFields(); // Init on load
    });


    // School Way checkboxes behave as a single-choice checkbox group
    document.querySelectorAll('input[name="school_way"]').forEach((checkbox) => {
        checkbox.addEventListener('change', function () {
            if (this.checked) {
                document.querySelectorAll('input[name="school_way"]').forEach((other) => {
                    if (other !== this) other.checked = false;
                });
            }

            const selectedWay = document.querySelectorAll('input[name="school_way"]:checked');
            if (selectedWay.length === 0) {
                this.checked = true;
            }
        });
    });

    // Validation Engine for Checklist Architecture
    document.getElementById('schoolForm').addEventListener('submit', function (e) {
        const schoolTypes = document.querySelectorAll('input[name="school_type"]:checked');
        const mediums = document.querySelectorAll('input[name="medium"]:checked');
        const schoolWays = document.querySelectorAll('input[name="school_way"]:checked');

        if (schoolTypes.length === 0) {
            alert("Security Alert: Please configure at least one School Type architecture.");
            e.preventDefault();
            return false;
        }
        if (mediums.length === 0) {
            alert("Security Alert: System requires at least one Operational Medium selected.");
            e.preventDefault();
            return false;
        }
        if (schoolWays.length === 0) {
            alert("Please select School Way / Timing for transport planning.");
            e.preventDefault();
            return false;
        }
    });
</script>
