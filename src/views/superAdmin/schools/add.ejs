    <script id="schoolsAddLangData" type="application/json">
  <%- JSON.stringify({
    secAlertSchoolType: lan.Security_Alert_School_Type || 'Security Alert: Please configure at least one School Type architecture.',
    secAlertMedium: lan.Security_Alert_Medium || 'Security Alert: System requires at least one Operational Medium selected.',
    secAlertSchoolWay: lan.Select_School_Way_Alert || 'Please select School Way / Timing for transport planning.',
    branchSchoolBadge: lan.Branch_School || 'Branch School',
    standaloneSchoolBadge: lan.Standalone_School || 'Standalone School',
    latitudeLabel: lan.Latitude || 'Latitude',
    longitudeLabel: lan.Longitude || 'Longitude',
    optionalText: lan.Optional || 'Optional'
  }) %>
</script>

    <script>
        const trialHasTransport = '<%= trialHasTransport %>';
        const schAddLang = JSON.parse(document.getElementById('schoolsAddLangData')?.textContent || '{}');

        document.addEventListener("DOMContentLoaded", () => {
            const startModeSelect = document.getElementById("subscription_start_mode");
            const paidPlanFields = document.getElementById("paidPlanFields");
            const planIdSelect = document.getElementById("plan_id_select");
            const latInput = document.querySelector('input[name="latitude"]');
            const lngInput = document.querySelector('input[name="longitude"]');
            const latLabel = latInput?.closest('.form-group')?.querySelector('label');
            const lngLabel = lngInput?.closest('.form-group')?.querySelector('label');

            function updateCoordinatesRequirement() {
                let isRequired = false;
                if (startModeSelect && startModeSelect.value === "trial") {
                    isRequired = trialHasTransport === 'true';
                } else if (planIdSelect) {
                    const selectedOption = planIdSelect.options[planIdSelect.selectedIndex];
                    if (selectedOption && selectedOption.value) {
                        isRequired = selectedOption.getAttribute('data-has-transport') === 'true';
                    }
                }

                if (latInput && lngInput && latLabel && lngLabel) {
                    if (isRequired) {
                        latInput.setAttribute('required', 'required');
                        lngInput.setAttribute('required', 'required');
                        latLabel.innerHTML = (schAddLang.latitudeLabel || 'Latitude') + ' <span class="text-danger">*</span>';
                        lngLabel.innerHTML = (schAddLang.longitudeLabel || 'Longitude') + ' <span class="text-danger">*</span>';
                    } else {
                        latInput.removeAttribute('required');
                        lngInput.removeAttribute('required');
                        latLabel.innerHTML = (schAddLang.latitudeLabel || 'Latitude') + ' <span class="text-muted text-xs">(' + (schAddLang.optionalText || 'Optional') + ')</span>';
                        lngLabel.innerHTML = (schAddLang.longitudeLabel || 'Longitude') + ' <span class="text-muted text-xs">(' + (schAddLang.optionalText || 'Optional') + ')</span>';
                    }
                }
            }

            function toggleFields() {
                if (startModeSelect && startModeSelect.value === "direct_paid") {
                    if (paidPlanFields) paidPlanFields.style.display = "block";
                    if (planIdSelect) planIdSelect.setAttribute("required", "required");
                } else {
                    if (paidPlanFields) paidPlanFields.style.display = "none";
                    if (planIdSelect) planIdSelect.removeAttribute("required");
                }
                updateCoordinatesRequirement();
            }

            if (startModeSelect) startModeSelect.addEventListener("change", toggleFields);
            if (planIdSelect) planIdSelect.addEventListener("change", updateCoordinatesRequirement);

            toggleFields();
        });

        const schForm = document.getElementById('schoolForm');
        if (schForm) {
            schForm.addEventListener('submit', function (e) {
                const schoolTypes = document.querySelectorAll('input[name="school_type"]:checked');
                const mediums = document.querySelectorAll('input[name="medium"]:checked');
                const schoolWays = document.querySelectorAll('input[name="school_way"]:checked');

                if (schoolTypes.length === 0) {
                    alert(schAddLang.secAlertSchoolType || "Security Alert: Please configure at least one School Type architecture.");
                    e.preventDefault();
                    return false;
                }
                if (mediums.length === 0) {
                    alert(schAddLang.secAlertMedium || "Security Alert: System requires at least one Operational Medium selected.");
                    e.preventDefault();
                    return false;
                }
                if (schoolWays.length === 0) {
                    alert(schAddLang.secAlertSchoolWay || "Please select School Way / Timing for transport planning.");
                    e.preventDefault();
                    return false;
                }
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            const groupSection = document.getElementById("group_details_section");
            const chkAssignGroup = document.getElementById("chk_assign_group");
            const groupSelect = document.getElementById("school_group_select");
            const branchContainer = document.getElementById("branch_fields_container");
            const groupHelper = document.getElementById("group_helper_text");
            const branchNameInput = document.querySelector('input[name="branch_name"]');
            const branchCodeInput = document.querySelector('input[name="branch_code"]');
            const areaInput = document.querySelector('input[name="area"]');

            const schoolNameInput = document.querySelector('input[name="school_name"]');
            const subdomainInput = document.querySelector('input[name="subdomain"]');
            let subdomainManuallyEdited = false;
            let branchCodeManuallyEdited = false;

            if (subdomainInput && subdomainInput.value.trim() !== "") {
                subdomainManuallyEdited = true;
            }
            if (branchCodeInput && branchCodeInput.value.trim() !== "") {
                branchCodeManuallyEdited = true;
            }

            if (subdomainInput) {
                subdomainInput.addEventListener('input', () => {
                    subdomainManuallyEdited = true;
                });
            }

            if (branchCodeInput) {
                branchCodeInput.addEventListener('input', () => {
                    branchCodeManuallyEdited = true;
                });
            }

            if (schoolNameInput && subdomainInput) {
                schoolNameInput.addEventListener('input', () => {
                    if (!subdomainManuallyEdited || subdomainInput.value.trim() === '') {
                        const slug = schoolNameInput.value
                            .toLowerCase()
                            .trim()
                            .replace(/[^a-z0-9\s-]/g, '')
                            .replace(/\s+/g, '-');
                        subdomainInput.value = slug;
                    }
                });
            }

            if (chkAssignGroup) {
                chkAssignGroup.addEventListener('change', () => {
                    if (chkAssignGroup.checked) {
                        if (groupSection) groupSection.classList.remove("hidden");
                    } else {
                        if (groupSection) groupSection.classList.add("hidden");
                        if (groupSelect) groupSelect.value = "";
                        if (branchNameInput) branchNameInput.value = "";
                        if (branchCodeInput) branchCodeInput.value = "";
                        if (areaInput) areaInput.value = "";
                    }
                    toggleBranchFields();
                });
            }

            function toggleBranchFields() {
                if (!groupSection) return;
                const isSectionHidden = groupSection.classList.contains("hidden");
                if (isSectionHidden) {
                    if (groupSelect) groupSelect.disabled = true;
                    if (branchContainer) branchContainer.classList.add("hidden");
                    if (branchNameInput) { branchNameInput.required = false; branchNameInput.disabled = true; }
                    if (branchCodeInput) { branchCodeInput.required = false; branchCodeInput.disabled = true; }
                    if (areaInput) areaInput.disabled = true;
                    return;
                }

                if (groupSelect) groupSelect.disabled = false;
                const hasGroup = groupSelect && groupSelect.value !== "";
                if (hasGroup) {
                    if (branchContainer) branchContainer.classList.remove("hidden");
                    if (branchNameInput) { branchNameInput.required = true; branchNameInput.disabled = false; }
                    if (branchCodeInput) { branchCodeInput.required = true; branchCodeInput.disabled = false; }
                    if (areaInput) areaInput.disabled = false;
                    if (groupHelper) groupHelper.innerHTML = '<span class="badge bg-blue-100 text-blue-800 px-2.5 py-1 rounded text-xs font-semibold">' + (schAddLang.branchSchoolBadge || 'Branch School') + '</span>';
                } else {
                    if (branchContainer) branchContainer.classList.add("hidden");
                    if (branchNameInput) { branchNameInput.required = false; branchNameInput.disabled = true; }
                    if (branchCodeInput) { branchCodeInput.required = false; branchCodeInput.disabled = true; }
                    if (areaInput) areaInput.disabled = true;
                    if (groupHelper) groupHelper.innerHTML = '<span class="badge bg-slate-100 text-slate-700 px-2.5 py-1 rounded text-xs font-semibold">' + (schAddLang.standaloneSchoolBadge || 'Standalone School') + '</span>';
                }
            }

            function autoGenerateBranchCode() {
                if (branchCodeManuallyEdited && branchCodeInput && branchCodeInput.value.trim() !== '') return;
                if (!groupSelect) return;
                const selectedOpt = groupSelect.options[groupSelect.selectedIndex];
                const groupName = selectedOpt && selectedOpt.value ? selectedOpt.text : '';
                const area = areaInput ? areaInput.value.trim() : '';

                if (!groupName) {
                    if (branchCodeInput) branchCodeInput.value = '';
                    return;
                }

                let prefix = groupName
                    .split(/\s+/)
                    .map(word => word[0])
                    .join('')
                    .toUpperCase()
                    .replace(/[^A-Z0-9]/g, '')
                    .substring(0, 4);

                if (!prefix) prefix = 'BR';

                let suffix = area
                    .toUpperCase()
                    .replace(/[^A-Z0-9]/g, '')
                    .substring(0, 3);

                if (branchCodeInput) {
                    branchCodeInput.value = suffix ? `${prefix}-${suffix}` : prefix;
                }
            }

            if (groupSelect) {
                groupSelect.addEventListener('change', () => {
                    toggleBranchFields();
                    autoGenerateBranchCode();
                });
            }
            if (areaInput) areaInput.addEventListener('input', autoGenerateBranchCode);

            toggleBranchFields();
        });
    </script>