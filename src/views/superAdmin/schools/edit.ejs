\<%- include('../../partials/head') %>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/schools' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-slate-50/20">
                            <h3 class="card-title flex items-center gap-2">
                                <i class="fa-solid fa-school text-blue-600"></i> Edit School: <%= school.school_name %>
                            </h3>
                        </div>
                        <div class="card-body p-6">
                            <form action="/superadmin/schools/<%= school.id %>?_method=PUT" method="POST" id="schoolForm" enctype="multipart/form-data" data-validate-form>
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                            <!-- Block A — School Group & Branch Details -->
                                            <div id="group_details_section" class="<%= !school.school_group_id ? 'hidden' : '' %>">
                                                <h5 class="text-sm font-bold text-gray-800 uppercase tracking-wider border-b border-gray-100 pb-2 mb-4">
                                                    <i class="fa-solid fa-layer-group text-blue-600 mr-1"></i> School Group & Branch Details
                                                </h5>
                                                <div class="row mb-4">
                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <label>School Group <span class="text-muted text-xs">(Optional)</span></label>
                                                            <select name="school_group_id" class="form-input" id="school_group_select">
                                                                <option value="">No Group / Standalone School</option>
                                                                <% groups.forEach(g => { %>
                                                                    <option value="<%= g.id %>" <%= Number(school.school_group_id) === Number(g.id) ? 'selected' : '' %>><%= g.group_name %></option>
                                                                <% }) %>
                                                            </select>
                                                            <p class="text-xs text-gray-500 mt-2" id="group_helper_text">
                                                                <span class="badge bg-slate-100 text-slate-700 px-2.5 py-1 rounded text-xs font-semibold">Standalone School</span>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div id="branch_fields_container" class="hidden">
                                                    <div class="row mb-4">
                                                        <div class="col-md-4">
                                                            <div class="form-group">
                                                                <label>Branch Name <span class="text-danger" id="branch_name_asterisk">*</span></label>
                                                                <input type="text" name="branch_name" class="form-input" value="<%= school.branch_name || '' %>" placeholder="e.g. Katargam Branch">
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="form-group">
                                                                <label>Branch Code <span class="text-danger" id="branch_code_asterisk">*</span></label>
                                                                <input type="text" name="branch_code" class="form-input" value="<%= school.branch_code || '' %>" placeholder="e.g. GAJ-KAT">
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="form-group">
                                                                <label>Area</label>
                                                                <input type="text" name="area" class="form-input" value="<%= school.area || '' %>" placeholder="e.g. Katargam">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Block B — School Identity -->
                                            <div class="flex items-center justify-between border-b border-gray-100 pb-2 mb-4 mt-5">
                                                <h5 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-0">
                                                    <i class="fa-solid fa-address-card text-blue-600 mr-1"></i> School Identity
                                                </h5>
                                                <div id="standalone_badge_container" class="flex items-center gap-2 <%= school.school_group_id ? 'hidden' : '' %>">
                                                    <span class="badge bg-slate-100 text-slate-700 px-2.5 py-1 rounded text-xs font-semibold">Standalone School</span>
                                                    <button type="button" id="btn_assign_group" class="text-xs text-blue-600 hover:text-blue-800 font-semibold bg-transparent border-0 p-0 cursor-pointer">
                                                        <i class="fa-solid fa-link mr-1"></i> Assign to School Group
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="row mb-4">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>School Name <span class="text-danger">*</span></label>
                                                        <input type="text" name="school_name" class="form-input"
                                                            value="<%= school.school_name %>" required>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Subdomain <span class="text-danger">*</span></label>
                                                        <div class="input-group">
                                                            <input type="text" name="subdomain" class="form-input"
                                                                value="<%= school.subdomain %>" required>
                                                            <span class="input-group-text bg-light text-muted font-weight-normal">.schoolsync.in</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Website URL</label>
                                                        <input type="url" name="website" class="form-input"
                                                            value="<%= school.website %>" data-validate="url">
                                                    </div>
                                                </div>
                                            </div>

                                            <%
                                            let selectedTypes = [];
                                            try {
                                                if (school.school_type && school.school_type.startsWith('[')) {
                                                    selectedTypes = JSON.parse(school.school_type);
                                                } else if (school.school_type) {
                                                    selectedTypes = [school.school_type];
                                                }
                                            } catch (e) {
                                                selectedTypes = [school.school_type];
                                            }

                                            let selectedMediums = [];
                                            try {
                                                if (school.medium && school.medium.startsWith('[')) {
                                                    selectedMediums = JSON.parse(school.medium);
                                                } else if (school.medium) {
                                                    selectedMediums = [school.medium];
                                                }
                                            } catch (e) {
                                                selectedMediums = [school.medium];
                                            }

                                             const selectedSchoolWays = typeof school.school_way === 'string' ? school.school_way.split(',').map(s => s.trim()) : [school.school_way || 'full_day'];
                                             %>
                                            <div class="row g-4 mb-4">
                                                <div class="col-md-6">
                                                    <label class="form-label font-weight-bold mb-2">School Type <span class="text-danger">*</span></label>
                                                    <div class="custom-checkbox-card" style="border: 1px solid #E2E8F0; padding: 15px; border-radius: 8px; background: #fff;">
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="school_type" value="Pre-Primary" class="form-check-input" id="type_pre" <%= selectedTypes.includes('Pre-Primary') ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="type_pre">Pre-Primary</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="school_type" value="Primary" class="form-check-input" id="type_pri" <%= selectedTypes.includes('Primary') ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="type_pri">Primary</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="school_type" value="Secondary" class="form-check-input" id="type_sec" <%= selectedTypes.includes('Secondary') ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="type_sec">Secondary</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="school_type" value="Higher Secondary" class="form-check-input" id="type_high" <%= selectedTypes.includes('Higher Secondary') ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="type_high">Higher Secondary</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input type="checkbox" name="school_type" value="KG to 12" class="form-check-input" id="type_all" <%= selectedTypes.includes('KG to 12') ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="type_all">KG to 12 Format</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="form-label font-weight-bold mb-2">Medium of Instruction <span class="text-danger">*</span></label>
                                                    <div class="custom-checkbox-card" style="border: 1px solid #E2E8F0; padding: 15px; border-radius: 8px; background: #fff;">
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="medium" value="Gujarati" class="form-check-input" id="med_guj" <%= selectedMediums.includes('Gujarati') ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="med_guj">Gujarati Medium</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="medium" value="English" class="form-check-input" id="med_eng" <%= selectedMediums.includes('English') ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="med_eng">English Medium</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" name="medium" value="Hindi" class="form-check-input" id="med_hin" <%= selectedMediums.includes('Hindi') ? 'checked' : '' %>>
                                                            <label class="form-check-label" for="med_hin">Hindi Medium</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row g-4 mb-4">
                                                <div class="col-md-12">
                                                    <label class="form-label font-weight-bold mb-2">School Way / Timing <span class="text-danger">*</span></label>
                                                    <div class="custom-checkbox-card" style="border: 1px solid #E2E8F0; padding: 15px; border-radius: 8px; background: #fff;">
                                                        <div class="row">
                                                            <div class="col-md-4">
                                                                <div class="form-check mb-2">
                                                                    <input type="checkbox" name="school_way" value="morning" class="form-check-input school-way-check" id="way_morning" <%= selectedSchoolWays.includes('morning') ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="way_morning">Morning School</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check mb-2">
                                                                    <input type="checkbox" name="school_way" value="evening" class="form-check-input school-way-check" id="way_evening" <%= selectedSchoolWays.includes('evening') ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="way_evening">Evening School</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-check mb-2">
                                                                    <input type="checkbox" name="school_way" value="full_day" class="form-check-input school-way-check" id="way_full_day" <%= selectedSchoolWays.includes('full_day') ? 'checked' : '' %>>
                                                                    <label class="form-check-label" for="way_full_day">Full Day School</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <p class="text-xs text-gray-500 mb-0 mt-2">Transport route shift will use this timing by default.</p>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Board</label>
                                                        <select name="board" class="form-input">
                                                            <option value="GSEB" <%=school.board==='GSEB' ? 'selected'
                                                                : '' %>>GSEB</option>
                                                            <option value="CBSE" <%=school.board==='CBSE' ? 'selected'
                                                                : '' %>>CBSE</option>
                                                            <option value="ICSE" <%=school.board==='ICSE' ? 'selected'
                                                                : '' %>>ICSE</option>
                                                            <option value="Other" <%=school.board==='Other' ? 'selected'
                                                                : '' %>>Other</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Gender Type</label>
                                                        <select name="gender_type" class="form-input">
                                                            <option value="co-ed" <%=school.gender_type==='co-ed'
                                                                ? 'selected' : '' %>>Co-Ed</option>
                                                            <option value="boys" <%=school.gender_type==='boys'
                                                                ? 'selected' : '' %>>Boys Only</option>
                                                            <option value="girls" <%=school.gender_type==='girls'
                                                                ? 'selected' : '' %>>Girls Only</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Establishment Year</label>
                                                        <input type="number" name="establishment_year"
                                                            class="form-input"
                                                            value="<%= school.establishment_year %>" min="1800"
                                                            max="2100">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Principal Name</label>
                                                        <input type="text" name="school_principal_name"
                                                            class="form-input"
                                                            value="<%= school.school_principal_name %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Principal Email</label>
                                                        <input type="email" name="school_principal_email"
                                                            class="form-input"
                                                            value="<%= school.school_principal_email %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Principal Phone</label>
                                                        <input type="tel" name="school_principal_phone"
                                                            class="form-input"
                                                            value="<%= school.school_principal_phone %>">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label>UDISE Code</label>
                                                        <input type="text" name="udise_code" class="form-input"
                                                            value="<%= school.udise_code %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label>Affiliation Board</label>
                                                        <select name="affiliation_board" class="form-input">
                                                            <option value="">Select</option>
                                                            <option value="GSEB" <%=school.affiliation_board==='GSEB'
                                                                ? 'selected' : '' %>>GSEB</option>
                                                            <option value="CBSE" <%=school.affiliation_board==='CBSE'
                                                                ? 'selected' : '' %>>CBSE</option>
                                                            <option value="ICSE" <%=school.affiliation_board==='ICSE'
                                                                ? 'selected' : '' %>>ICSE</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label>Affiliation Number</label>
                                                        <input type="text" name="affiliation_number"
                                                            class="form-input"
                                                            value="<%= school.affiliation_number %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label>Registration Number</label>
                                                        <input type="text" name="school_registration_number"
                                                            class="form-input"
                                                            value="<%= school.school_registration_number %>">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>PAN Number</label>
                                                        <input type="text" name="pan_number" class="form-input"
                                                            value="<%= school.pan_number %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>GST Number</label>
                                                        <input type="text" name="gst_number" class="form-input"
                                                            value="<%= school.gst_number %>">
                                                    </div>
                                                </div>
                                            </div>

                                            <h5 class="text-primary mb-4 mt-5 border-bottom pb-2">
                                                <i class="fas fa-university"></i> Bank Details
                                            </h5>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Account Holder Name</label>
                                                        <input type="text" name="account_holder_name"
                                                            class="form-input"
                                                            value="<%= bankDetail ? bankDetail.account_holder_name : '' %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Bank Name</label>
                                                        <input type="text" name="bank_name" class="form-input"
                                                            value="<%= bankDetail ? bankDetail.bank_name : '' %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Account Number</label>
                                                        <input type="text" name="account_number" class="form-input"
                                                            value="<%= bankDetail ? bankDetail.account_number : '' %>"
                                                            data-validate="numeric">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>IFSC Code</label>
                                                        <input type="text" name="ifsc_code" class="form-input"
                                                            value="<%= bankDetail ? bankDetail.ifsc_code : '' %>"
                                                            data-validate="ifsc">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Branch Name</label>
                                                        <input type="text" name="bank_branch_name" class="form-input"
                                                            value="<%= bankDetail ? bankDetail.branch_name : '' %>">
                                                    </div>
                                                </div>
                                            </div>

                                            <h5 class="text-primary mb-4 mt-5 border-bottom pb-2">
                                                <i class="fas fa-file-upload"></i> Documents Upload
                                            </h5>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>School Logo</label>
                                                        <% if (school.logo) { %>
                                                            <div class="mb-2"><a href="<%= school.logo %>"
                                                                    target="_blank">View Current Logo</a></div>
                                                            <% } %>
                                                                <input type="file" name="logo" class="form-input"
                                                                    accept="image/*">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Registration Certificate</label>
                                                        <% const regDoc=documents.find(d=> d.document_type ===
                                                            'registration_certificate');
                                                            if (regDoc) { %>
                                                            <div class="mb-2"><a href="<%= regDoc.file_path %>"
                                                                    target="_blank">View Current</a></div>
                                                            <% } %>
                                                                <input type="file" name="registration_certificate"
                                                                    class="form-input" accept=".pdf,image/*">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Affiliation Certificate</label>
                                                        <% const affDoc=documents.find(d=> d.document_type ===
                                                            'affiliation_certificate');
                                                            if (affDoc) { %>
                                                            <div class="mb-2"><a href="<%= affDoc.file_path %>"
                                                                    target="_blank">View Current</a></div>
                                                            <% } %>
                                                                <input type="file" name="affiliation_certificate"
                                                                    class="form-input" accept=".pdf,image/*">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>UDISE Document</label>
                                                        <% const udiseDoc=documents.find(d=> d.document_type ===
                                                            'udise');
                                                            if (udiseDoc) { %>
                                                            <div class="mb-2"><a href="<%= udiseDoc.file_path %>"
                                                                    target="_blank">View Current</a></div>
                                                            <% } %>
                                                                <input type="file" name="udise" class="form-input"
                                                                    accept=".pdf,image/*">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Address Proof</label>
                                                        <% const addDoc=documents.find(d=> d.document_type ===
                                                            'address_proof');
                                                            if (addDoc) { %>
                                                            <div class="mb-2"><a href="<%= addDoc.file_path %>"
                                                                    target="_blank">View Current</a></div>
                                                            <% } %>
                                                                <input type="file" name="address_proof"
                                                                    class="form-input" accept=".pdf,image/*">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Other Document</label>
                                                        <% const othDoc=documents.find(d=> d.document_type === 'other');
                                                            if (othDoc) { %>
                                                            <div class="mb-2"><a href="<%= othDoc.file_path %>"
                                                                    target="_blank">View Current</a></div>
                                                            <% } %>
                                                                <input type="file" name="other_document"
                                                                    class="form-input" accept=".pdf,image/*">
                                                    </div>
                                                </div>
                                            </div>
                                            <h5 class="text-primary mb-4 mt-5 border-bottom pb-2">Contact & Status</h5>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Email</label>
                                                        <input type="email" name="school_email" class="form-input"
                                                            value="<%= school.school_email %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Phone</label>
                                                        <input type="tel" name="school_phone" class="form-input"
                                                            value="<%= school.school_phone %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Status</label>
                                                        <select name="status" class="form-input">
                                                            <option value="active" <%=school.status==='active'
                                                                ? 'selected' : '' %>>Active</option>
                                                            <option value="trial" <%=school.status==='trial'
                                                                ? 'selected' : '' %>>Trial</option>
                                                            <option value="inactive" <%=school.status==='inactive'
                                                                ? 'selected' : '' %>>Inactive</option>
                                                            <option value="expired" <%=school.status==='expired'
                                                                ? 'selected' : '' %>>Expired</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Plan</label>
                                                        <select name="plan_id" class="form-input">
                                                            <% plans.forEach(plan=> { %>
                                                                <option value="<%= plan.id %>"
                                                                    <%=school.plan_id===plan.id ? 'selected' : '' %>><%=
                                                                        plan.name %>
                                                                </option>
                                                                <% }) %>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Trial Ends At</label>
                                                        <input type="date" name="trial_ends_at" class="form-input"
                                                            value="<%= school.trial_ends_at ? school.trial_ends_at.toISOString().split('T')[0] : '' %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Subscription End</label>
                                                        <input type="date" name="subscription_end" class="form-input"
                                                            value="<%= school.subscription_end ? school.subscription_end.toISOString().split('T')[0] : '' %>">
                                                    </div>
                                                </div>
                                            </div> -->

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Portal Password (Change)</label>
                                                        <input type="password" name="password" class="form-input"
                                                            placeholder="Leave blank to keep current password">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <label>Address</label>
                                                        <textarea name="school_address" class="form-input"
                                                            rows="2"><%= school.school_address %></textarea>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>City</label>
                                                        <input type="text" name="city" class="form-input"
                                                            value="<%= school.city %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>State</label>
                                                        <input type="text" name="state" class="form-input"
                                                            value="<%= school.state %>">
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-group">
                                                        <label>Pincode</label>
                                                        <input type="text" name="pincode" class="form-input"
                                                            value="<%= school.pincode %>">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Latitude <span class="text-muted text-xs">(Optional)</span></label>
                                                        <input type="number" step="any" name="latitude"
                                                            value="<%= school.latitude || '' %>" class="form-input">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Longitude <span class="text-muted text-xs">(Optional)</span></label>
                                                        <input type="number" step="any" name="longitude"
                                                            value="<%= school.longitude || '' %>" class="form-input">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row mt-4">
                                                <div class="col-md-12">
                                                    <button type="submit" class="btn btn-primary">Update School</button>
                                                    <a href="/superadmin/schools/<%= school.id %>"
                                                        class="btn btn-info">View Details</a>
                                                    <a href="/superadmin/schools" class="btn btn-secondary">Cancel</a>
                                                </div>
                                            </div>
                                        </form>
                                        <script>


                                            document.getElementById('schoolForm').addEventListener('submit', function (e) {
                                                const schoolTypes = document.querySelectorAll('input[name="school_type"]:checked');
                                                const mediums = document.querySelectorAll('input[name="medium"]:checked');
                                                const schoolWays = document.querySelectorAll('input[name="school_way"]:checked');

                                                if (schoolTypes.length === 0) {
                                                    alert("Security Alert: Please configure at least one School Type architecture.");
                                                    e.preventDefault();
                                                    return false;
                                                }
                                                if (mediums.length === 0) {
                                                    alert("Security Alert: System requires at least one Operational Medium selected.");
                                                    e.preventDefault();
                                                    return false;
                                                }
                                                if (schoolWays.length === 0) {
                                                    alert("Please select School Way / Timing for transport planning.");
                                                    e.preventDefault();
                                                    return false;
                                                }
                                            });

                                            // School Group & Branch Details interactive logic
                                            document.addEventListener("DOMContentLoaded", () => {
                                                const groupSection = document.getElementById("group_details_section");
                                                const btnAssignGroup = document.getElementById("btn_assign_group");
                                                const badgeContainer = document.getElementById("standalone_badge_container");
                                                const groupSelect = document.getElementById("school_group_select");
                                                const branchContainer = document.getElementById("branch_fields_container");
                                                const groupHelper = document.getElementById("group_helper_text");
                                                const branchNameInput = document.querySelector('input[name="branch_name"]');
                                                const branchCodeInput = document.querySelector('input[name="branch_code"]');
                                                const areaInput = document.querySelector('input[name="area"]');

                                                const schoolNameInput = document.querySelector('input[name="school_name"]');
                                                const subdomainInput = document.querySelector('input[name="subdomain"]');
                                                let subdomainManuallyEdited = false;
                                                let branchCodeManuallyEdited = false;

                                                if (subdomainInput && subdomainInput.value.trim() !== "") {
                                                    subdomainManuallyEdited = true;
                                                }
                                                if (branchCodeInput && branchCodeInput.value.trim() !== "") {
                                                    branchCodeManuallyEdited = true;
                                                }

                                                subdomainInput.addEventListener('input', () => {
                                                    subdomainManuallyEdited = true;
                                                });

                                                branchCodeInput.addEventListener('input', () => {
                                                    branchCodeManuallyEdited = true;
                                                });

                                                schoolNameInput.addEventListener('input', () => {
                                                    if (!subdomainManuallyEdited || subdomainInput.value.trim() === '') {
                                                        const slug = schoolNameInput.value
                                                            .toLowerCase()
                                                            .trim()
                                                            .replace(/[^a-z0-9\s-]/g, '')
                                                            .replace(/\s+/g, '-');
                                                        subdomainInput.value = slug;
                                                    }
                                                });

                                                if (btnAssignGroup) {
                                                    btnAssignGroup.addEventListener('click', () => {
                                                        groupSection.classList.remove("hidden");
                                                        if (badgeContainer) badgeContainer.classList.add("hidden");
                                                        groupSelect.disabled = false;
                                                        toggleBranchFields();
                                                    });
                                                }

                                                function toggleBranchFields() {
                                                    // If the section is hidden, group is treated as standalone
                                                    const isSectionHidden = groupSection.classList.contains("hidden");
                                                    if (isSectionHidden) {
                                                        groupSelect.disabled = true;
                                                        branchContainer.classList.add("hidden");
                                                        branchNameInput.required = false;
                                                        branchCodeInput.required = false;
                                                        branchNameInput.disabled = true;
                                                        branchCodeInput.disabled = true;
                                                        areaInput.disabled = true;
                                                        return;
                                                    }

                                                    groupSelect.disabled = false;
                                                    const hasGroup = groupSelect.value !== "";
                                                    if (hasGroup) {
                                                        branchContainer.classList.remove("hidden");
                                                        branchNameInput.required = true;
                                                        branchCodeInput.required = true;
                                                        branchNameInput.disabled = false;
                                                        branchCodeInput.disabled = false;
                                                        areaInput.disabled = false;
                                                        groupHelper.innerHTML = '<span class="badge bg-blue-100 text-blue-800 px-2.5 py-1 rounded text-xs font-semibold">Branch School</span>';
                                                    } else {
                                                        branchContainer.classList.add("hidden");
                                                        branchNameInput.required = false;
                                                        branchCodeInput.required = false;
                                                        branchNameInput.disabled = true;
                                                        branchCodeInput.disabled = true;
                                                        areaInput.disabled = true;
                                                        groupHelper.innerHTML = '<span class="badge bg-slate-100 text-slate-700 px-2.5 py-1 rounded text-xs font-semibold">Standalone School</span>';
                                                    }
                                                }

                                                function autoGenerateBranchCode() {
                                                    if (branchCodeManuallyEdited && branchCodeInput.value.trim() !== '') return;
                                                    const selectedOpt = groupSelect.options[groupSelect.selectedIndex];
                                                    const groupName = selectedOpt && selectedOpt.value ? selectedOpt.text : '';
                                                    const area = areaInput.value.trim();
                                                    
                                                    if (!groupName) {
                                                        branchCodeInput.value = '';
                                                        return;
                                                    }
                                                    
                                                    let prefix = groupName
                                                        .split(/\s+/)
                                                        .map(word => word[0])
                                                        .join('')
                                                        .toUpperCase()
                                                        .replace(/[^A-Z0-9]/g, '')
                                                        .substring(0, 4);
                                                        
                                                    if (!prefix) prefix = 'BR';
                                                    
                                                    let suffix = area
                                                        .toUpperCase()
                                                        .replace(/[^A-Z0-9]/g, '')
                                                        .substring(0, 3);
                                                        
                                                    branchCodeInput.value = suffix ? `${prefix}-${suffix}` : prefix;
                                                }

                                                groupSelect.addEventListener('change', () => {
                                                    toggleBranchFields();
                                                    autoGenerateBranchCode();
                                                });
                                                areaInput.addEventListener('input', autoGenerateBranchCode);

                                                // Init on page load
                                                toggleBranchFields();
                                            });
                                        </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../../partials/footer') %>
    </div>
</div>
