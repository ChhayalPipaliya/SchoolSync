<%- include('../../partials/head', { title: `${lan.Schools || 'Schools'} | SchoolSync` }) %>
<div class="app-wrapper">
    <%- include('../../partials/flashMessages') %>
    <%- include('../../partials/sidebar') %>
    <div class="main-panel main-content" id="mainPanel">
        <%- include('../../partials/header') %>
        <div class="page-body" style="padding:0;">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; padding:24px 24px 0; flex-wrap:wrap; gap:12px;">
                <div>
                    <h1 style="font-size:20px; font-weight:700; color:#0F172A; margin:0;" class="dark:text-slate-100"><%- lan.Schools || 'Schools' %></h1>
                    <p style="font-size:12px; color:#94A3B8; margin:4px 0 0;" class="dark:text-slate-400"><%- (lan.Manage_Registered_Schools_Sub || 'Manage all registered schools (:count total)').replace(':count', schools.length) %></p>
                </div>
                <div style="display:flex; gap:10px;">
                    <a href="/superadmin/schools/add" class="btn btn-primary" style="font-size:13px; padding:8px 16px;">
                        <i class="fas fa-plus mr-1"></i> <%- lan.Add_School || 'Add School' %>
                    </a>
                </div>
            </div>
            <div style="padding:0 24px 16px;">
                <div class="card" style="padding:16px; margin-bottom:0;">
                    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
                        <input type="text" id="searchInput" placeholder="<%- lan.Search_Schools_Placeholder || 'Search schools...' %>" class="form-input" style="width:260px; min-height:38px;" oninput="searchTable()">
                    </div>
                </div>
            </div>
            <div style="padding:0 24px 24px;">
                <div class="card">
                    <div class="card-body" style="padding:0; overflow-x:auto;">
                        <table class="table" style="width:100%; border-collapse:collapse;" id="schoolTable">
                            <thead>
                                <tr>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; width:50px;">#</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;"><%- lan.School || 'School' %></th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;"><%- lan.Type_Medium || 'Type / Medium' %></th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;"><%- lan.For_Gender || 'For' %></th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;"><%- lan.Plan || 'Plan' %></th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;"><%- lan.Status || 'Status' %></th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; width:120px;"><%- lan.Actions || 'Actions' %></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(!schools || schools.length===0) { %>
                                    <tr>
                                        <td colspan="7" style="padding:14px 16px; font-size:13px; border-bottom:1px solid #F1F5F9; text-align:center; color:#94A3B8;">
                                            <i class="fa-solid fa-school fa-2x" style="color:#CBD5E1; margin-bottom:8px;"></i>
                                            <div><%- lan.No_Schools_Yet || 'No schools yet.' %></div>
                                            <a href="/superadmin/schools/add" style="color:#2563EB; font-weight:600; text-decoration:none;"><%- lan.Add_First_School || 'Add first school' %></a>
                                        </td>
                                    </tr>
                                <% } %>
                                <% (schools||[]).forEach((s, i) => {
                                    const medDict = { Gujarati: (lan.Gujarati || 'Gujarati'), English: (lan.English || 'English'), Hindi: (lan.Hindi || 'Hindi') };
                                    const genDict = { 'co-ed': (lan.Co_Ed || 'Co-Ed'), boys: (lan.Boys_Only || 'Boys Only'), girls: (lan.Girls_Only || 'Girls Only') };
                                    const getMediumLabel = (medium) => {
                                        if (!medium) return "-";
                                        return medium.split(",").map(m => {
                                            const key = m.trim();
                                            return medDict[key] || (typeof MEDIUM_LABEL !== 'undefined' && MEDIUM_LABEL[key]) || key;
                                        }).join(" + ");
                                    };
                                    const getGenderLabel = (gender) => {
                                        if (!gender) return "-";
                                        return gender.split(",").map(g => {
                                            const key = g.trim();
                                            return genDict[key] || (typeof GENDER_LABEL !== 'undefined' && GENDER_LABEL[key]) || key;
                                        }).join(" + ");
                                    };
                                    const gdrColor = {
                                        'co-ed':'#4F46E5',
                                        'boys':'#0891B2',
                                        'girls':'#DB2777'
                                    };
                                    const statusStyles = {
                                        'active': 'background:#D1FAE5; color:#065F46; border-color:#A7F3D0;',
                                        'trial': 'background:#FEF3C7; color:#92400E; border-color:#FDE68A;',
                                        'inactive': 'background:#FEE2E2; color:#991B1B; border-color:#FCA5A5;'
                                    };
                                %>
                                <tr style="border-bottom:1px solid #F1F5F9; transition:background 0.15s;" onmouseover="this.style.background='#F8FAFC'" onmouseout="this.style.background=''">
                                    <td style="padding:14px 16px; font-size:13px; color:#94A3B8; vertical-align:middle;"><%= i+1 %></td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <div style="font-weight:700;color:#1E293B;font-size:13px;" class="dark:text-slate-200"><%= s.school_name %></div>
                                        <div style="font-size:11px;color:#94A3B8;margin-top:2px;"><%= s.school_email || '' %></div>
                                        <div style="font-size:10px;color:#2563EB;margin-top:2px;"><%= s.subdomain %>.schoolsync.com</div>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <div style="font-size:12px;font-weight:600;color:#1E293B;margin-bottom:4px;" class="dark:text-slate-200"><%= s.school_type %></div>
                                        <span style="background:#ECFEFF;color:#0891B2;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600;">
                                            <%= getMediumLabel(s.medium) %>
                                        </span>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <% const currentGdrColor = gdrColor[s.gender_type?.split(',')[0]] || '#4F46E5'; %>
                                        <span <%= `style="background: ${currentGdrColor}18; color: ${currentGdrColor}; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700;"` %>>
                                            <%= getGenderLabel(s.gender_type) %>
                                        </span>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <span style="background:#EEF2FF;color:#4F46E5;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:capitalize;">
                                            <%= s.plan %>
                                        </span>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <span <%= `style="display:inline-flex; align-items:center; padding:2px 8px; border-radius:99px; font-size:10px; font-weight:700; text-transform:uppercase; border:1px solid; ${statusStyles[s.status] || statusStyles['inactive']}"` %>>
                                            <%= s.status === 'active' ? (lan.Active || 'Active') : (s.status === 'trial' ? (lan.Trial || 'Trial') : (s.status === 'inactive' ? (lan.Inactive || 'Inactive') : s.status)) %>
                                        </span>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <div style="display:flex; align-items:center; gap:6px;">
                                            <a href="/superadmin/schools/<%= s.id %>" class="btn-icon" title="<%- lan.View_Details || 'View Details' %>">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a href="/superadmin/schools/<%= s.id %>/edit" class="btn-icon btn-edit-icon" title="<%- lan.Edit_School || 'Edit School' %>">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form action="/superadmin/schools/<%= s.id %>/delete" method="POST" style="display:inline-block; margin:0;" data-delete-form data-school-name="<%= s.school_name %>">
                                                <button type="submit" class="btn-icon btn-danger-icon" style="border:none;">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
</div>
        <%- include('../../partials/footer') %>
            </div>
    </div>

    <script id="schoolsIndexLangData" type="application/json">
      <%- JSON.stringify({
        deleteConfirm: lan.Delete_School_Confirm || 'Delete :name?'
      }) %>
    </script>
    <script>
        const schIdxLang = JSON.parse(document.getElementById('schoolsIndexLangData')?.textContent || '{}');
        function searchTable() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('#schoolTable tbody tr').forEach(r => {
                r.style.display = r.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        };

        document.querySelectorAll('form[data-delete-form]').forEach(form => {
            form.addEventListener('submit', function (e) {
                const name = this.getAttribute('data-school-name') || '';
                const msg = (schIdxLang.deleteConfirm || 'Delete :name?').replace(':name', name);
                if (!confirm(msg)) {
                    e.preventDefault();
                };
            });
        });
    </script>
</div>