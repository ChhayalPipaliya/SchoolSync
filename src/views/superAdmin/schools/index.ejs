<div class="app-wrapper">
    <%- include('../../partials/flashMessages') %>
    <%- include('../../partials/sidebar') %>
    <div class="main-panel main-content" id="mainPanel">
        <%- include('../../partials/header') %>
        <div class="page-body" style="padding:0;">
            <!-- Page Header -->
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; padding:24px 24px 0; flex-wrap:wrap; gap:12px;">
                <div>
                    <h1 style="font-size:20px; font-weight:700; color:#0F172A; margin:0;">Schools</h1>
                    <p style="font-size:12px; color:#94A3B8; margin:4px 0 0;">Manage all registered schools (<%= schools.length %> total)</p>
                </div>
                <div style="display:flex; gap:10px;">
                    <a href="/superadmin/schools/add" class="btn btn-primary" style="font-size:13px; padding:8px 16px;">
                        <i class="fas fa-plus"></i> Add School
                    </a>
                </div>
            </div>

            <!-- Search Bar - wrap in card -->
            <div style="padding:0 24px 16px;">
                <div class="card" style="padding:16px; margin-bottom:0;">
                    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
                        <input type="text" id="searchInput" placeholder="Search schools..." class="form-input" style="width:260px; min-height:38px;" onkeyup="searchTable()">
                    </div>
                </div>
            </div>

            <!-- Table - wrap in card -->
            <div style="padding:0 24px 24px;">
                <div class="card">
                    <div class="card-body" style="padding:0; overflow-x:auto;">
                        <table class="table" style="width:100%; border-collapse:collapse;" id="schoolTable">
                            <thead>
                                <tr>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; width:50px;">#</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">School</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Type / Medium</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">For</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Plan</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">Status</th>
                                    <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; width:120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(!schools || schools.length===0) { %>
                                    <tr>
                                        <td colspan="7" style="padding:14px 16px; font-size:13px; border-bottom:1px solid #F1F5F9; text-align:center; color:#94A3B8;">
                                            <i class="fa-solid fa-school fa-2x" style="color:#CBD5E1; margin-bottom:8px;"></i>
                                            <div>No schools yet.</div>
                                            <a href="/superadmin/schools/add" style="color:#2563EB; font-weight:600; text-decoration:none;">Add first school</a>
                                        </td>
                                    </tr>
                                <% } %>
                                <% (schools||[]).forEach((s, i) => {
                                    const getMediumLabel = (medium) => {
                                        if (!medium) return "-";
                                        return medium.split(",").map(m => MEDIUM_LABEL[m.trim()] || m.trim()).join(" + ");
                                    };
                                    const getGenderLabel = (gender) => {
                                        if (!gender) return "-";
                                        return gender.split(",").map(g => GENDER_LABEL[g.trim()] || g.trim()).join(" + ");
                                    };
                                    const gdrColor = {
                                        'co-ed':'#4F46E5',
                                        'boys':'#0891B2',
                                        'girls':'#DB2777'
                                    };
                                %>
                                <tr style="border-bottom:1px solid #F1F5F9; transition:background 0.15s;" onmouseover="this.style.background='#F8FAFC'" onmouseout="this.style.background=''">
                                    <td style="padding:14px 16px; font-size:13px; color:#94A3B8; vertical-align:middle;"><%= i+1 %></td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <div style="font-weight:700;color:#1E293B;font-size:13px;"><%= s.school_name %></div>
                                        <div style="font-size:11px;color:#94A3B8;margin-top:2px;"><%= s.school_email || '' %></div>
                                        <div style="font-size:10px;color:#2563EB;margin-top:2px;"><%= s.subdomain %>.schoolsync.com</div>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <div style="font-size:12px;font-weight:600;color:#1E293B;margin-bottom:4px;"><%= s.school_type %></div>
                                        <span style="background:#ECFEFF;color:#0891B2;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600;">
                                            <%= getMediumLabel(s.medium) %>
                                        </span>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <span style="background:<%= (gdrColor[s.gender_type?.split(',')[0]] || '#4F46E5') + '18' %>; color:<%= gdrColor[s.gender_type?.split(',')[0]] || '#4F46E5' %>; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700;">
                                            <%= getGenderLabel(s.gender_type) %>
                                        </span>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <span style="background:#EEF2FF;color:#4F46E5;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:capitalize;">
                                            <%= s.plan %>
                                        </span>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <span style="display:inline-flex; align-items:center; padding:2px 8px; border-radius:99px; font-size:10px; font-weight:700; text-transform:uppercase; border:1px solid;
                                            <%= s.status === 'active' ? 'background:#D1FAE5; color:#065F46; border-color:#A7F3D0;' : s.status === 'trial' ? 'background:#FEF3C7; color:#92400E; border-color:#FDE68A;' : 'background:#FEE2E2; color:#991B1B; border-color:#FCA5A5;' %>">
                                            <%= s.status %>
                                        </span>
                                    </td>
                                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                                        <div style="display:flex; align-items:center; gap:6px;">
                                            <a href="/superadmin/schools/<%= s.id %>" class="btn-icon" title="View Details">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a href="/superadmin/schools/<%= s.id %>/edit" class="btn-icon btn-edit-icon">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form action="/superadmin/schools/<%= s.id %>/delete" method="POST" style="display:inline-block; margin:0;" onsubmit="return confirm('Delete <%= s.school_name %>?')">
                                                <button type="submit" class="btn-icon btn-danger-icon" style="border:none;">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function searchTable() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('#schoolTable tbody tr').forEach(r => {
                r.style.display = r.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
    <%- include('../../partials/footer') %>