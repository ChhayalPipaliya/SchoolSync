<%- include('../../partials/head', { title: 'Billing & Invoices | SchoolSync' }) %>
<div class="app-wrapper superadmin-theme">
  <%- include('../../partials/sidebar', { currentPath: '/superadmin/billing/invoices' }) %>
  <main class="main-panel" id="mainPanel">
    <%- include('../../partials/header', { searchPlaceholder: 'Search invoices…' }) %>
    <%- include('../../partials/flashMessages') %>
    <div class="sa-page-body" style="padding:24px;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; flex-wrap:wrap; gap:12px;">
        <div>
          <h1 style="font-size:20px; font-weight:700; color:#0F172A; margin:0;">
            Billing & Invoices Ledger
          </h1>
          <p style="font-size:12px; color:#94A3B8; margin:4px 0 0;">Manage tenant subscriptions, automated invoices, and payment tracking.</p>
        </div>
        <div style="display:flex; gap:10px;">
          <form action="/superadmin/billing/sweep" method="POST" style="margin:0;">
            <button type="submit" class="btn btn-secondary" style="font-size:13px; padding:8px 18px; color:#D97706; border-color:#FCD53F;">
              <i class="fas fa-sync-alt"></i> Trigger Billing Sweep
            </button>
          </form>
          <a href="/superadmin/billing/reports" class="btn btn-primary" style="font-size:13px; padding:8px 18px; text-decoration:none;">
            <i class="fas fa-chart-line"></i> Revenue Analytics
          </a>
        </div>
      </div>
      <div style="margin-bottom:16px;">
        <div class="card" style="padding:16px; margin-bottom:0;">
          <form method="GET" action="/superadmin/billing/invoices" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
            <div style="width:200px;">
              <label class="form-label" style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">Filter by School</label>
              <select name="school_id" class="form-select" style="min-height:38px;">
                <option value="">All Schools</option>
                <% schools.forEach(school => { %>
                  <option value="<%= school.id %>" <%= filters.school_id == school.id ? 'selected' : '' %>><%= school.school_name %></option>
                <% }) %>
              </select>
            </div>
            <div style="width:200px;">
              <label class="form-label" style="font-size:10px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">Payment Status</label>
              <select name="status" class="form-select" style="min-height:38px;">
                <option value="">All Statuses</option>
                <option value="unpaid" <%= filters.status === 'unpaid' ? 'selected' : '' %>>Unpaid / Overdue</option>
                <option value="paid" <%= filters.status === 'paid' ? 'selected' : '' %>>Paid</option>
                <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed / Suspended</option>
              </select>
            </div>
            <div>
              <button type="submit" class="btn btn-primary" style="height:38px; padding:0 16px; font-size:13px;">
                <i class="fas fa-filter"></i> Apply Filters
              </button>
            </div>
          </form>
        </div>
      </div>
      <div class="card" style="margin-bottom:20px;">
        <div class="card-header" style="background:#F8FAFC; padding:16px 24px; border-bottom:1px solid #E2E8F0;">
          <h3 class="card-title" style="font-size:14px; font-weight:700; color:#0F172A; text-transform:uppercase; letter-spacing:0.05em; margin:0;">Invoice History Logs</h3>
        </div>
        <div class="card-body" style="padding:0; overflow-x:auto;">
          <% if (invoices && invoices.length > 0) { %>
            <table class="table" style="width:100%; border-collapse:collapse; font-size:13px;">
              <thead>
                <tr>
                  <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:left;">Invoice No</th>
                  <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:left;">School Name</th>
                  <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:left;">Billing Date</th>
                  <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:left;">Due Date</th>
                  <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:right;">Total Amount</th>
                  <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center;">Retries</th>
                  <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center;">Status</th>
                  <th style="padding:12px 16px; font-size:12px; font-weight:600; color:#64748B; text-transform:uppercase; letter-spacing:0.05em; background:#F8FAFC; border-bottom:1px solid #E2E8F0; text-align:center; width:100px;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% invoices.forEach(inv => { %>
                  <tr style="border-bottom:1px solid #F1F5F9; transition:background 0.15s;" onmouseover="this.style.background='#F8FAFC'" onmouseout="this.style.background=''">
                    <td style="padding:14px 16px; font-size:13px; font-weight:700; color:#1E3A8A; vertical-align:middle;"><%= inv.invoice_no %></td>
                    <td style="padding:14px 16px; font-size:13px; vertical-align:middle;">
                      <div style="font-weight:600; color:#0F172A;"><%= inv.school_name %></div>
                      <span style="font-size:10px; background:#EFF6FF; color:#1E40AF; padding:2px 8px; border-radius:99px; font-weight:700; display:inline-block; margin-top:4px;"><%= inv.plan_name || 'Basic' %></span>
                    </td>
                    <td style="padding:14px 16px; font-size:13px; color:#475569; vertical-align:middle;"><%= new Date(inv.billing_date).toLocaleDateString('en-IN') %></td>
                    <td style="padding:14px 16px; font-size:13px; color:#475569; vertical-align:middle;"><%= new Date(inv.due_date).toLocaleDateString('en-IN') %></td>
                    <td style="padding:14px 16px; font-size:13px; text-align:right; font-weight:700; color:#0F172A; vertical-align:middle;">₹<%= Number(inv.total_amount).toLocaleString('en-IN') %></td>
                    <td style="padding:14px 16px; font-size:13px; text-align:center; font-weight:600; color:#EF4444; vertical-align:middle;"><%= inv.payment_retry_count %>/3</td>
                    <td style="padding:14px 16px; font-size:13px; text-align:center; vertical-align:middle;">
                      <% if (inv.status === 'paid') { %>
                        <span style="background:#D1FAE5; color:#065F46; padding:4px 10px; border-radius:99px; font-size:10px; font-weight:700; display:inline-flex; align-items:center; gap:4px;"><i class="fas fa-check-circle"></i> Paid</span>
                      <% } else if (inv.status === 'unpaid') { %>
                        <span style="background:#FEF3C7; color:#D97706; padding:4px 10px; border-radius:99px; font-size:10px; font-weight:700; display:inline-flex; align-items:center; gap:4px;"><i class="fas fa-clock"></i> Unpaid</span>
                      <% } else { %>
                        <span style="background:#FEE2E2; color:#991B1B; padding:4px 10px; border-radius:99px; font-size:10px; font-weight:700; display:inline-flex; align-items:center; gap:4px;"><i class="fas fa-times-circle"></i> Failed</span>
                      <% } %>
                    </td>
                    <td style="padding:14px 16px; font-size:13px; text-align:center; vertical-align:middle;">
                      <a href="/superadmin/billing/invoices/<%= inv.id %>/pdf" class="btn btn-secondary btn-sm" style="display:inline-flex; align-items:center; gap:6px; font-size:11px; padding:4px 8px; min-height:28px;">
                        <i class="fas fa-download"></i> PDF
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state-sa" style="padding:48px; text-align:center; color:#94A3B8;">
              <i class="fas fa-file-invoice" style="font-size:40px; color:#CBD5E1; margin-bottom:12px; display:block;"></i>
              <p style="margin:0; font-weight:600;">No e-invoices found matching current filters.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
</main>
</div>
<%- include('../../partials/footer') %>