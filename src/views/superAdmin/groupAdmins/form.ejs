<%- include('../../partials/head') %>
<%
  const grouped = {};
  branches.forEach(b => {
    const key = b.group_name || 'Standalone Schools';
    if (!grouped[key]) grouped[key] = [];
    grouped[key].push(b);
  });
%>
<div class="app-wrapper superadmin-theme">
    <%- include('../../partials/sidebar', { currentPath: '/superadmin/group-admins' }) %>
    <div class="main-panel">
        <%- include('../../partials/header') %>
        <div class="content">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800 tracking-tight"><%= admin ? 'Edit Group Admin' : 'Add Group Admin' %></h2>
                    <p class="text-xs text-gray-500 mt-1">Assign branch access for a group-level administrator</p>
                </div>
                <a href="/superadmin/group-admins" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Back to List
                </a>
            </div>
            <%- include('../../partials/flashMessages') %>
            <div class="card">
                <div class="card-header bg-slate-50/20">
                    <h3 class="card-title flex items-center gap-2">
                        <i class="fa-solid fa-user-shield text-blue-600"></i> Group Admin Details
                    </h3>
                </div>
                <div class="card-body p-6">
                    <form action="<%= admin ? `/superadmin/group-admins/${admin.id}` : '/superadmin/group-admins' %>" method="POST" data-validate-form>
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <h5 class="text-sm font-bold text-gray-800 uppercase tracking-wider border-b border-gray-100 pb-2 mb-4">
                            <i class="fa-solid fa-address-card text-blue-600 mr-1"></i> Personal Info
                        </h5>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>First Name <span class="text-danger">*</span></label>
                                    <input type="text" name="first_name" class="form-input" value="<%= admin ? (admin.first_name || '') : '' %>" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Last Name</label>
                                    <input type="text" name="last_name" class="form-input" value="<%= admin ? (admin.last_name || '') : '' %>">
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Email <span class="text-danger">*</span></label>
                                    <input type="email" name="email" class="form-input" value="<%= admin ? (admin.email || '') : '' %>" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Phone</label>
                                    <input type="tel" name="phone" class="form-input" value="<%= admin ? (admin.phone || '') : '' %>">
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Password <% if (admin) { %><span class="text-muted text-xs">(Leave blank to keep current)</span><% } else { %><span class="text-danger">*</span><% } %></label>
                                    <input type="password" name="password" class="form-input" <%= admin ? '' : 'required' %>>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>School Group <span class="text-danger">*</span></label>
                                    <select name="school_group_id" id="schoolGroupSelect" class="form-input custom-select" required>
                                        <option value="">Select Group</option>
                                        <% groups.forEach(g => { %>
                                            <option value="<%= g.id %>" <%= (admin && selectedGroupId == g.id) ? 'selected' : '' %>><%= g.group_name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Status</label>
                                    <select name="status" class="form-input custom-select">
                                        <option value="active" <%= !admin || admin.status === 'active' ? 'selected' : '' %>>Active</option>
                                        <option value="inactive" <%= admin && admin.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <h5 class="text-sm font-bold text-gray-800 uppercase tracking-wider border-b border-gray-100 pb-2 mb-4">
                            <i class="fa-solid fa-school text-blue-600 mr-1"></i> Branch Access
                        </h5>
                        <div class="custom-checkbox-card" style="border:1px solid #E2E8F0; padding:16px; border-radius:8px; background:#fff;">
                            <% if (!branches || branches.length === 0) { %>
                                <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:20px 0; color:#94A3B8;">
                                    <i class="fa-solid fa-school fa-2x" style="color:#CBD5E1;"></i>
                                    <span>No active branches available.</span>
                                </div>
                            <% } else { %>
                                <% Object.entries(grouped).forEach(([groupName, branchList]) => { %>
                                    <% const groupId = branchList[0]?.group_id || ''; %>
                                    <div class="mb-3 branch-group-container" data-group-id="<%= groupId %>" style="padding-bottom:12px; border-bottom:1px solid #F1F5F9;">
                                        <p class="font-semibold text-sm text-gray-700 mb-2"><%= groupName %></p>
                                        <% branchList.forEach(b => { %>
                                            <label class="flex items-center gap-2 mb-1 text-sm" style="cursor:pointer;">
                                                <input type="checkbox" name="branch_ids" value="<%= b.id %>" <%= selectedBranches.includes(b.id) ? 'checked' : '' %>>
                                                <span>
                                                    <%= b.school_name %><%= b.branch_name ? ' - ' + b.branch_name : '' %>
                                                    <% if (b.area) { %><span class="text-gray-400">(<%= b.area %>)</span><% } %>
                                                </span>
                                            </label>
                                        <% }) %>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                        <div class="mt-5 pt-4 border-top d-flex justify-content-end align-items-center">
                            <a href="/superadmin/group-admins" class="btn btn-cancel mr-3">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-submit text-white">
                                <i class="fas fa-save mr-2"></i> <%= admin ? 'Update Group Admin' : 'Create Group Admin' %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../../partials/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const groupSelect = document.getElementById('schoolGroupSelect');
        
        function filterBranches() {
            const selectedGroupId = groupSelect.value;
            document.querySelectorAll('.branch-group-container').forEach(el => {
                if (!selectedGroupId || el.dataset.groupId === selectedGroupId) {
                    el.style.display = 'block';
                } else {
                    el.style.display = 'none';
                    el.querySelectorAll('input[type="checkbox"]').forEach(input => {
                        input.checked = false;
                    });
                }
            });
        }

        if (groupSelect) {
            groupSelect.addEventListener('change', filterBranches);
            filterBranches();
        }
    });
</script>